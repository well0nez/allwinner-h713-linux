def keystone_limits(values):
    """How far each of the eight may still go: the vendor's clamp as h713-warp
    applies it (matrix.c) - x limited by the corner across the row, y by the
    one across the column.  The page draws value/max from it."""
    across = {"x": {"tl": "tr", "tr": "tl", "bl": "br", "br": "bl"},
              "y": {"tl": "bl", "bl": "tl", "tr": "br", "br": "tr"}}
    return dict((c + "_" + a, max(0, 1000 - values.get(across[a][c] + "_" + a,
                                                       0)))
                for c in CORNERS for a in AXES)


def _lround(x):
    """C's lround: halves away from zero."""
    whole = math.floor(abs(x))
    return int(math.copysign(whole + (abs(x) - whole >= 0.5), x))


def wb_gains(cool, magenta):
    """The red, green and blue gain the two white balance sliders make (positive: towards cool, towards magenta):
    h713-settings (rows.c, wb_gains) written once more.  Cool lowers red, warm lowers blue, magenta lowers green,
    green lowers red and blue; a gain is only ever lowered, so white never clips."""
    toward_cool, toward_warm = max(cool, 0), max(-cool, 0)
    toward_magenta, toward_green = max(magenta, 0), max(-magenta, 0)
    return [_lround(WB_NEUTRAL * k) for k in (
        (1 - WB_STEP * toward_cool) * (1 - WB_STEP * toward_green),
        1 - WB_STEP * toward_magenta,
        (1 - WB_STEP * toward_warm) * (1 - WB_STEP * toward_green))]


def wb_positions(gains):
    """The sliders (cool, magenta) a set of gains would have come from (rows.c, wb_positions); 0, 0 for gains the
    sliders cannot make."""
    if max(gains) > WB_NEUTRAL:
        return 0, 0
    red, green, blue = [g / float(WB_NEUTRAL) for g in gains]
    if green < 1:             # magenta: green is lowered, red and blue only by the warm/cool slider
        magenta = (1 - green) / WB_STEP
        cool = (1 - red) / WB_STEP if red < 1 else -(1 - blue) / WB_STEP if blue < 1 else 0
    else:                     # green or none: red and blue share the factor 1 - step * |slider|
        top = red if red > blue else blue
        magenta = -(1 - top) / WB_STEP
        cool = 0 if top <= 0 else (1 - red / top) / WB_STEP if red < blue else \
            -(1 - blue / top) / WB_STEP if blue < red else 0
    return (max(-50, min(50, _lround(cool))), max(-50, min(50, _lround(magenta))))


def wb_slider_positions(gains):
    """wb_positions on the page's grid (steps of 2): two positions at the ends of the range make the same gains
    (-8 and -9 of Warm - Cool at -50 of Green - Magenta), and the one that comes back may be the odd one."""
    cool, magenta = wb_positions(gains)
    if cool % 2 or magenta % 2:
        for near_c in (cool, cool - 1, cool + 1):
            for near_m in (magenta, magenta - 1, magenta + 1):
                if near_c % 2 == 0 and near_m % 2 == 0 and wb_gains(near_c, near_m) == list(gains):
                    return near_c, near_m
    return cool, magenta


class Panel(object):
    """The verbs, and the lock that keeps two browsers off one focus motor."""

    def __init__(self, tools=None, keystone_conf=KEYSTONE_CONF,
                 unit=KEYSTONE_UNIT, thermal=THERMAL_DIR, etc=ETC,
                 hosts=HOSTS_FILE, hostname_file=HOSTNAME_FILE,
                 password_file=None, selfpath=None):
        self.tools, self.keystone_conf = tools, keystone_conf
        self.unit, self.thermal = unit, thermal
        self.etc, self.hosts, self.hostname_file = etc, hosts, hostname_file
        self.password_file = password_file or self.p("panel.env")
        self.selfpath = selfpath or os.path.realpath(__file__)   # the fall-back timer runs this file
        self.lock, self.ranges, self.server = threading.Lock(), {}, None
        self._keystone = False                        # keystone_module(): not looked for yet

    def p(self, name):
        return os.path.join(self.etc, name)

    def execute(self, name, words, timeout):
        """One tool, one argument vector, no shell, ever: (exit code, output),
        the code None and a message when it did not run or did not answer."""
        argv = [os.path.join(self.tools, name) if self.tools else name]
        try:
            done = subprocess.run(argv + list(words), stdout=subprocess.PIPE,
                                  stderr=subprocess.STDOUT, timeout=timeout,
                                  universal_newlines=True)
        except subprocess.TimeoutExpired:
            return None, "error %s %s did not answer within %d s" % (
                name, " ".join(words), timeout)
        except OSError as problem:
            return None, "error %s: %s" % (name, problem)
        return done.returncode, done.stdout or ""

    def run(self, name, words, timeout):
        """`execute`, read the way every ctl of this project answers:
        (ok, the first ok/error line, the whole output)."""
        code, out = self.execute(name, words, timeout)
        if code is None:
            return False, out, ""
        return first_line(out, code) + (out,)

    def control_ranges(self, refresh=False):
        """`h713-tv ctl list` as {control: {value, min, max}}: what the
        sliders are drawn with and what picture_set checks against."""
        if self.ranges and not refresh:
            return self.ranges
        found = {}
        for line in self.run(TV, ("ctl", "list"), T)[2].splitlines():
            row = LIST_ROW.match(line)
            span = RANGE.search(row.group(3)) if row else None
            menu = MENU.search(row.group(3)) if row else None
            if span or menu:
                found[row.group(1)] = {
                    "value": first_int(row.group(2)), "menu": bool(menu),
                    "min": int(span.group(1)) if span else 0,
                    "max": int(span.group(2) if span else menu.group(1))}
        self.ranges = found or self.ranges
        return self.ranges

    def features(self):
        """{feature: present} out of `h713-features status`; empty when it
        does not answer (an image without it), and then every control stays
        on the page as before."""
        found = labelled(self.run("h713-features", ("status",), T)[2])
        return dict((n, found[n].split()[0] == "present")
                    for n in FEATURE_NAMES if found.get(n))

    def do_controls(self, args):
        """What the page needs to draw itself: the sliders, the lists, and
        which optional hardware this board has."""
        ranges = self.control_ranges(refresh=True)
        blank = {"min": 0, "max": 100}     # until ctl list has been read
        present = self.features()
        state = self.wb_state()[0]
        if state != "unknown":             # h713-tv did not answer: the tab stays, as with the hardware
            present["colour"] = state == "ok"
        state = self.look_state()[0]
        if state != "unknown":
            present["gamma"] = state == "ok"
        return {"ok": True, "line": "ok controls", "steps": NUDGE_STEPS,
                "controls": [dict(blank, name=n, **ranges.get(n, {}))
                             for n in PICTURE_CONTROLS],
                "quality": [dict(dict(blank, max=3), name=n, **ranges.get(QUALITY_LISTED[n], {}))
                            for n in QUALITY_CONTROLS],
                "conf": dict((n, dict((k, c.spec) for k, c in checks.items()))
                             for n, (_, checks) in CONF.items()),
                "presets": PRESETS, "aspects": ASPECTS, "modes": MODES,
                "after_move": [v for v in AFTER_MOVE if not lacking(v, present)],
                "corners": CORNERS, "features": present}

    def do_picture_set(self, args):
        """`h713-tv ctl set CONTROL VALUE`, the range out of `ctl list`."""
        if len(args) != 2:
            raise Refused("error a control and a value were expected")
        name = _choice(*PICTURE_CONTROLS, *QUALITY_CONTROLS)(args[0])
        span = self.control_ranges().get(QUALITY_LISTED.get(name, name)) or {}
        value = _number(span.get("min", 0),
                        span.get("max", 3 if name in QUALITY_CONTROLS else 100))(args[1])
        ok, line, _ = self.run(TV, ("ctl", "set", name, value), T)
        return {"ok": ok, "line": line}

    def wb_state(self):
        """`h713-tv ctl wb` as ("ok", the six numbers), ("absent", why) where the display firmware is not the one
        the registers were read from, or ("unknown", the tool's line) when h713-tv did not give them."""
        ok, line, out = self.run(TV, ("ctl", "wb"), T)
        found = WB_REPLY.search(out)
        if not found:
            return "unknown", line
        absent = WB_ABSENT.search(found.group(7))
        if absent:
            return "absent", absent.group(1)
        return "ok", [int(n) for n in found.groups()[:6]]

    def no_colour(self, state, why):
        return no("error the colour calibration is not available (%s)" % why if state == "absent"
                  else "error h713-tv did not say what the white balance is (%s)" % why[:120])

    def do_wb_tune(self, args):
        """The two white balance sliders as the six numbers `h713-tv ctl wb` takes: the gains out of wb_gains, the
        offsets as h713-tv holds them now (the sliders do not touch them)."""
        if len(args) != 2:
            raise Refused("error warm - cool and green - magenta were expected")
        cool, magenta = [int(WB_SLIDER(a)) for a in args]
        state, have = self.wb_state()
        if state != "ok":
            return self.no_colour(state, have)
        words = [str(n) for n in wb_gains(cool, magenta) + have[3:]]
        ok, line, _ = self.run(TV, ("ctl", "wb") + tuple(words), T)
        return {"ok": ok, "line": line}

    def do_cm_set(self, args):
        """The hue or the saturation of one primary: `h713-tv ctl set cm_AXIS_PART N`, a step on the value the
        picture mode itself puts there."""
        if len(args) != 3:
            raise Refused("error a colour, hue or sat, and a value were expected")
        axis, part = _choice(*PRIMARIES)(args[0]), _choice(*CM_PARTS)(args[1])
        ok, line, _ = self.run(TV, ("ctl", "set", "cm_%s_%s" % (axis, part), CM_SLIDER(args[2])), T)
        return {"ok": ok, "line": line}

    def do_colour(self, args):
        """What the Colour tab shows: the two white balance sliders the gains come from (and whether the gains are
        ones the sliders make at all), and the hue and saturation step of each primary."""
        state, have = self.wb_state()
        if state != "ok":
            return self.no_colour(state, have)
        ok, line, out = self.run(TV, ("ctl", "cm"), T)
        if not ok:
            return no(line)
        steps = dict((axis, {"hue": 0, "sat": 0}) for axis in PRIMARIES)
        for axis, part, value in CM_ENTRY.findall(out):
            if axis in steps and part in CM_PARTS:
                steps[axis][part] = int(value)
        cool, magenta = wb_slider_positions(have[:3])
        return {"ok": True, "line": "ok colour", "wb": {"cool": cool, "magenta": magenta},
                "wb_other": wb_gains(cool, magenta) != have[:3], "cm": steps}

    def look_state(self):
        """`h713-tv ctl get gamma` and `ctl get colour_temperature` as ("ok", gamma level, its name, the temperature set, the one it comes to),
        ("absent", why) for a board whose curves h713-tv could not read, or ("unknown", the tool's line) when h713-tv did not answer them."""
        _, line, out = self.run(TV, ("ctl", "get", "gamma"), T)
        absent, level = LOOK_ABSENT.search(out), GAMMA_REPLY.search(out)
        if absent:
            return "absent", absent.group(1)
        if not level:
            return "unknown", line
        _, line, out = self.run(TV, ("ctl", "get", "colour_temperature"), T)
        found = TEMPERATURE_REPLY.search(out)
        if not found:
            return "unknown", line
        return "ok", int(level.group(1)), level.group(2), found.group(1), found.group(2) or found.group(1)

    def do_look(self, args):
        """What the Picture and Colour tabs show of gamma and colour temperature: the gamma level, the colour temperature (auto or one of
        the three curves), the one it comes to now (auto follows the preset; a board without the curve uses the normal one), and the
        picture mode that is on.  Reads only."""
        state, *have = self.look_state()
        if state != "ok":
            return no("error gamma and colour temperature are not available (%s)" % have[0][:120] if state == "absent"
                      else "error h713-tv did not say what the gamma is (%s)" % have[0][:120])
        level, name, chosen, now = have
        mode = (labelled(self.run(TV, ("ctl", "status", "brief"), T)[2]).get("preset") or "").split()
        return {"ok": True, "line": "ok look", "gamma": level, "gamma_name": name, "ct": chosen, "ct_now": now,
                "preset": mode[0] if mode and mode[0] in PRESETS else ""}

    def do_screen_zoom(self, args):
        """`h713-warp ctl zoom PERCENT`, and below 100 the warp on with it.
        Only the GPU can make the picture smaller (the firmware's scaler only
        enlarges), so a zoom with the warp off did nothing; the vendor has no
        such switch at all (Marco, 06.10.2026).  100 leaves the warp as it is."""
        if len(args) != 1:
            raise Refused("error screen_zoom takes 1 argument(s), not %d"
                          % len(args))
        value = PERCENT(args[0])
        ok, line, _ = self.run(WARP, ("ctl", "zoom", value), T)
        if ok and int(value) < 100:
            warp = labelled(self.run(WARP, ("ctl", "status"), T)[2])
            if (warp.get("warp") or "").split()[:1] == ["off"]:
                on, said, _ = self.run(WARP, ("ctl", "on"), T)
                ok, line = on, (line + "; the warp is on for it") if on else said
        return {"ok": ok, "line": line}

    def do_after_move(self, args):
        """What the projector does after it has been moved.  The key goes into
        /etc/h713/keystone.conf and the unit that reads it is restarted."""
        if len(args) != 1:
            raise Refused("error one of %s was wanted" % " ".join(AFTER_MOVE))
        value = _choice(*AFTER_MOVE)(args[0])
        missing = lacking(value, self.features())
        if missing:
            return no("error after_move = %s needs the %s - not present on this "
                      "board" % (value, " and the ".join(missing)))
        try:
            set_conf_key(self.keystone_conf, "after_move", value)
        except OSError as problem:
            return no("error %s could not be written (%s)"
                      % (self.keystone_conf, problem))
        ok, line, _ = self.run("systemctl", ("restart", self.unit), TIMEOUT_S)
        if not ok:
            return no("error after_move = %s is written, but %s did not "
                      "restart (%s)" % (value, self.unit, line))
        return {"ok": True, "line": "ok after_move = %s, %s restarted"
                % (value, self.unit)}

    def tv_instance(self):
        """The h713-tv instance that runs (h713-tv@video3 ...): the number is
        whatever the receiver got, so it is asked for, never assumed."""
        for line in self.execute("systemctl", ("list-units", "--plain", "--no-legend",
                                               "h713-tv@*.service"), T)[1].splitlines():
            found = re.match(r"\s*(h713-tv@video\d+\.service)\b", line)
            if found:
                return found.group(1)
        return None

    def do_conf_set(self, args):
        """One `key = value` of keys.conf, osd.conf or tv.conf.  The first two
        are read again by their daemons when the file changes; h713-tv reads
        tv.conf once at its start, so its instance is restarted."""
        if len(args) != 3:
            raise Refused("error a file, a key and a value were expected")
        name = _choice(*CONF)(args[0])
        fname, checks = CONF[name]
        key = _choice(*checks)(args[1])
        value = checks[key](args[2])
        try:
            set_conf_key(self.p(fname), key, value)
        except OSError as problem:
            return no("error %s could not be written (%s)" % (self.p(fname), problem))
        said = "ok %s: %s = %s" % (fname, key, value)
        if name != "tv":
            return {"ok": True, "line": said}
        unit = self.tv_instance()
        if unit is None:
            return {"ok": True, "line": said + " (h713-tv is not running; it applies at its next start)"}
        ok, line, _ = self.run("systemctl", ("restart", unit), TIMEOUT_S)
        if not ok:
            return no("error %s is written, but %s did not restart (%s)" % (fname, unit, line))
        return {"ok": True, "line": said + ", " + unit + " restarted"}

    def do_report(self, args):
        """A read-only tool's own text (hdcp, features, keys, osd, power, logs, wifi)."""
        if len(args) != 1:
            raise Refused("error one of %s was wanted" % " ".join(REPORTS))
        tool, words = REPORTS[_choice(*REPORTS)(args[0])]
        code, out = self.execute(tool, words, T)
        if code is None:
            return no(out)
        return {"ok": code == 0, "line": first_line(out, code)[1], "text": out[:4000]}

    def do_remote(self, args):
        """`h713-remote-pair status`: "ADDR NAME connected|bonded, not
        connected" per bonded remote, or "no remote bonded" (exit 1).  The
        address stays here; the page gets the name."""
        code, out = self.execute(REMOTE, ("status",), TIMEOUT_S)
        if code is None or code > 1:
            return no(out if code is None else first_line(out, code)[1])
        found = re.findall(r"^[0-9A-Fa-f:]{17} (.+?) (connected|bonded, not connected)$",
                           out, re.M)
        state = ("connected" if any(w == "connected" for _, w in found)
                 else "bonded" if found else "none")
        return {"ok": True, "line": "ok remote " + state, "state": state,
                "name": found[0][0] if found else ""}

    def do_remote_repair(self, args):
        """Forget the bond, then show the hint on the projector.  The running
        h713-remote-pair.service scans while no remote is bonded and pairs the
        remote that is put into pairing mode (TODO 2.54); the page waits and
        asks `remote`.  Exit 1 without a word from forget: nothing was bonded."""
        code, out = self.execute(REMOTE, ("forget",), TIMEOUT_SLOW_S)
        if code is None or code > 1 or (code == 1 and out.strip()):
            return no(out if code is None else first_line(out, code)[1])
        said = ("ok no remote was paired, so there was nothing to forget"
                if code else "ok the paired remote is forgotten")
        shown, why, _ = self.run(OSD, ("ctl", "pair"), TIMEOUT_S)
        return {"ok": True, "forgot": code == 0, "hint": shown, "seconds": PAIR_WINDOW_S,
                "line": said + "; hold LEFT + RIGHT on the remote" +
                ("" if shown else " (no hint on the projector: %s)" % why)}

    def hostname(self):
        return (read_text(self.hostname_file) or "").strip()

    def wifi_pending(self):
        """Seconds left to keep the new Wi-Fi settings, None when none wait."""
        try:
            age = time.time() - os.stat(self.p("wifi.env.prev")).st_mtime
        except OSError:
            return None
        return max(0, int(ROLLBACK_S - age))

    def do_settings(self, args):
        """What the forms show: the three conf files over their defaults, the
        power policy, the soft edge, the host name and the Wi-Fi - without its
        password, which this page never sends back."""
        values = {}
        for name, (fname, checks) in CONF.items():
            have = read_conf(self.p(fname))
            values[name] = dict((k, have.get(k, CONF_DEFAULTS.get(name, {}).get(k)))
                                for k in checks)
        values["tv"]["start"] = OLD_WORDS.get(values["tv"]["start"], values["tv"]["start"])
        text = self.run(POWER, ("status",), T)[2]
        power = re.search(r"^config: (.*)$", text, re.M)
        edge = re.match(r"ok edge (\d+)", self.run(WARP, ("ctl", "edge"), T)[1])
        wifi = read_env(read_text(self.p("wifi.env")))
        return {"ok": True, "line": "ok settings", "conf": values, "power_text": text[:2000],
                "power": dict(re.findall(r"(\w+) = ([\w.]+)", power.group(1))) if power else {},
                "edge": int(edge.group(1)) if edge else None, "hostname": self.hostname(),
                "wifi": dict([(k, wifi.get(k, "")) for k in WIFI_KEYS if k != "password"]
                             + [("has_password", bool(wifi.get("password")))]),
                "wifi_pending": self.wifi_pending()}

    def do_wifi_set(self, args):
        """wifi.env from the form, with a way back.  The new file is checked by
        `h713-wifi check` before anything is touched; then the old one is kept
        as wifi.env.prev, a timer (systemd-run, outside this unit) is set that
        puts it back after ROLLBACK_S, and only then does h713-wifi restart.
        The page cannot be sure to hear the answer - on the access point the
        network goes away under it - so `wifi_confirm` is the only way to keep
        the change.  An empty password means: unchanged."""
        form = args[0] if len(args) == 1 and isinstance(args[0], dict) else None
        if form is None or not set(form) <= set(WIFI_KEYS):
            raise Refused("error the form is one object with the fields of wifi.env")
        if self.wifi_pending() is not None:
            return no("error an earlier change still waits for its confirmation")
        env = self.p("wifi.env")
        old = read_bytes(env)
        if old is None:
            return no("error %s is missing" % env)
        new = dict((k, WIFI_KEYS[k](v)) for k, v in form.items() if k != "password" or v != "")
        candidate, secret = env + ".next", new.get("password", "")
        write_file(candidate, env_with(old.decode("utf-8", "replace"), new).encode("utf-8"))
        code, out = self.execute(WIFI, ("check", candidate), T)
        if code != 0:
            os.remove(candidate)
            said = re.search(r"ERROR: (.*)", out or "")
            return no("error " + (said.group(1) if said else (out.strip() or "h713-wifi check failed"))
                      .replace(secret or "\0", "***"))
        write_file(env + ".prev", old)
        started, why, _ = self.run("systemd-run", (
            "--quiet", "--collect", "--unit=" + ROLLBACK_UNIT, "--on-active=%d" % ROLLBACK_S,
            self.selfpath, "--rollback-wifi", "--etc", self.etc), T)
        if not started:
            os.remove(candidate)
            os.remove(env + ".prev")
            return no("error the fall-back timer could not be set (%s) - nothing was changed" % why)
        os.replace(candidate, env)
        ok, line, _ = self.run("systemctl", ("restart", WIFI + ".service"), LONG)
        if not ok:
            self.run("systemctl", ("stop", ROLLBACK_UNIT + ".timer"), T)
            self.rollback_wifi()
            return no("error h713-wifi did not restart (%s) - the old settings are back"
                      % line.replace(secret or "\0", "***"))
        return {"ok": True, "pending": ROLLBACK_S,
                "line": "ok Wi-Fi settings applied - keep them within %d s or the old ones come back"
                        % ROLLBACK_S}

    def do_wifi_confirm(self, args):
        """Keep the new Wi-Fi settings: cancel the timer, drop the old file."""
        if self.wifi_pending() is None:
            return no("error no Wi-Fi change is waiting for its confirmation")
        ok, line, _ = self.run("systemctl", ("stop", ROLLBACK_UNIT + ".timer"), T)
        if not ok:
            return no("error the fall-back could not be cancelled (%s)" % line)
        os.remove(self.p("wifi.env.prev"))
        return {"ok": True, "line": "ok Wi-Fi settings kept"}

    def rollback_wifi(self):
        """The old wifi.env back and h713-wifi restarted: what the timer runs
        (`h713-panel --rollback-wifi`), and what a failed restart calls.  No
        wifi.env.prev means the change was confirmed: nothing to do."""
        if not os.path.exists(self.p("wifi.env.prev")):
            print("h713-panel: no Wi-Fi change is waiting")
            return 0
        os.replace(self.p("wifi.env.prev"), self.p("wifi.env"))
        ok, line, _ = self.run("systemctl", ("restart", WIFI + ".service"), LONG)
        print("h713-panel: the old Wi-Fi settings are back; %s" % line)
        return 0 if ok else 1

    def do_hostname_set(self, args):
        """`hostnamectl set-hostname` (systemd-hostnamed writes /etc/hostname,
        outside this unit's sandbox) and the 127.0.1.1 line of /etc/hosts."""
        if len(args) != 1:
            raise Refused("error a host name was expected")
        name = HOSTNAME(args[0]).lower()
        ok, line, _ = self.run("hostnamectl", ("set-hostname", name), T)
        if not ok:
            return no("error the host name was not set (%s)" % line)
        try:
            # in place: ReadWritePaths= can name this one file, not its directory,
            # and a file can only be renamed over where its directory is writable
            with open(self.hosts, "r+b") as handle:
                data = hosts_with(handle.read().decode("utf-8", "replace"), name).encode("utf-8")
                handle.seek(0)
                handle.write(data)
                handle.truncate()
                handle.flush()
                os.fsync(handle.fileno())
        except OSError as problem:
            return no("error the host name is %s, but %s could not be written (%s)"
                      % (name, self.hosts, problem))
        return {"ok": True, "line": "ok host name %s (a new login shows it)" % name}

    def do_panel_password(self, args):
        """The page's own password: the current one is asked for again, the new
        one replaces it in panel.env and in the running door at once."""
        if len(args) != 2 or not all(isinstance(a, str) for a in args):
            raise Refused("error the current and the new password were expected")
        want = getattr(self.server, "password", None)
        if want is None:
            return no("error this page runs without a password (--no-auth)")
        if not hmac.compare_digest(args[0].encode(), want.encode()):
            return no("error the current password is not right")
        new = args[1]
        if not 8 <= len(new) <= 64 or CTRL.search(new) or new != new.strip():
            raise Refused("error the new password needs 8..64 characters, no control "
                          "character and no space at either end")
        try:
            write_password(self.password_file, new)
        except OSError as problem:
            return no("error %s could not be written (%s)" % (self.password_file, problem))
        self.server.password = new
        return {"ok": True, "line": "ok password changed - the browser asks for the new one"}

    def keystone_module(self):
        """h713-keystone as a module, loaded once from the tool directory: a
        status every three seconds may not start a Python interpreter each
        time.  None when it is not a Python file there (the tests' /bin/sh
        fakes) or does not load; then the status runs it as a program."""
        if self._keystone is not False:
            return self._keystone
        self._keystone = None
        path = os.path.join(self.tools, "h713-keystone") if self.tools else shutil.which("h713-keystone")
        try:
            loader = importlib.machinery.SourceFileLoader("h713_keystone", path)
            spec = importlib.util.spec_from_loader("h713_keystone", loader)
            module = importlib.util.module_from_spec(spec)
            loader.exec_module(module)
            self._keystone = module
        except Exception:                                 # not Python, not there, not importable
            self._keystone = None
        return self._keystone

    def keystone_facts(self, warp_text):
        """The three lines of `h713-keystone status` the page shows -- "after a
        move", "reference", "keystone by" -- computed here, in this process,
        out of keystone.conf, the reference file, the last automatic set and
        the warp status already read.  Measured on the HY310 (16.10.2026): the
        program start of h713-keystone costs 0.27 s of CPU every three seconds
        while the page is open, and the projector's light follows the SoC's
        current -- the page itself made the picture pulse every three seconds.
        None when the module is not there: the caller runs the program."""
        ks = self.keystone_module()
        if ks is None:
            return None
        try:
            conf = ks.load_conf(self.keystone_conf)
        except Exception as exc:                          # ks.Error: a value the file cannot carry
            return {"after a move": "-", "reference": "refused (%s)" % exc, "keystone by": "unknown"}
        found = {}
        for corner, x, y in ks.WARP_PAIR.findall(warp_text):
            found[(corner, "x")], found[(corner, "y")] = int(x), int(y)
        for corner, axis, value in ks.WARP_VALUE.findall(warp_text):
            found.setdefault((corner, axis), int(value))
        warp_set = (tuple(found[slot] for slot in ks.WARP_SLOTS)
                    if len(found) >= len(ks.WARP_SLOTS) else None)
        facts = {"after a move": str(conf["after_move"])}
        for label, call in (("reference", lambda: ks._reference_text(ks.REF_PATH, conf)),
                            ("keystone by", lambda: ks.keystone_by(
                                warp_set, ks.read_last_auto(ks.LAST_AUTO_PATH)))):
            try:
                facts[label] = call()
            except Exception as exc:
                facts[label] = str(exc)
        return facts

    def do_status(self, args):
        """Two statuses, the keystone facts and the thermal zones, every three seconds."""
        warp_text = self.run("h713-warp", ("ctl", "status"), TIMEOUT_S)[2]
        warp = labelled(warp_text)
        tv = labelled(self.run("h713-tv", ("ctl", "status", "brief"), TIMEOUT_S)[2])
        keystone = self.keystone_facts(warp_text)
        if keystone is None:
            keystone = labelled(self.run("h713-keystone", ("status",), TIMEOUT_S)[2])
        values = dict((c + "_" + a, 0) for c in CORNERS for a in AXES)
        for corner, x, y in PAIR.findall(warp.get("keystone", "")):
            values[corner + "_x"], values[corner + "_y"] = int(x), int(y)
        frames = FPS.search(warp.get("frames", ""))
        # h713-keystone: "ideal (0, 0, 1 g) - ...", "file (DATE): PATH, counts
        # ...", or "refused (WHY)" for a file from another axis map.
        reference = (keystone.get("reference") or "-").split()[0]
        return {"ok": True, "line": "ok status",
                "temperatures": temperatures(self.thermal),
                "warp": (warp.get("warp") or "unknown").split()[0],
                "warp_why": warp.get("warp", "h713-warp did not answer"),
                "pattern": warp.get("pattern", "-"),
                "screen_zoom": first_int(warp.get("zoom", ""), 100),
                "mode": (warp.get("mode") or "-").split()[0],
                "fps": float(frames.group(1)) if frames else None,
                "keystone": values, "max": keystone_limits(values),
                "signal": tv.get("signal", "h713-tv did not answer"),
                "picture": tv.get("picture", "-"),
                "audio": tv.get("audio", "-"),
                "aspect": (tv.get("format") or "-").split()[0],
                "wifi_pending": self.wifi_pending(),
                "keystone_by": (keystone.get("keystone by") or "-").split()[0],
                "after_move": (keystone.get("after a move") or "-").split()[0],
                "reference": {"ideal": "ideal", "file": "set",
                              "-": "-"}.get(reference, "refused")}

    def call(self, request):
        """The one door: {"verb": ..., "args": [...]}, anything else refused
        before a single tool is started."""
        if not isinstance(request, dict):
            return no("error a request is a JSON object")
        verb, args = request.get("verb"), request.get("args", [])
        if not isinstance(args, list) or len(args) > 4:
            return no("error args is a list of at most four")
        if verb not in SPECIALS and verb not in COMMANDS:
            return no("error \"%s\" is not a verb of this page" % _tame(verb))
        # A status may never wait behind a running autofocus: it says "busy",
        # and the page keeps its numbers.  A command waits LOCK_WAIT_S.  What only
        # reads (READS) takes no lock: it may take seconds and moves nothing.
        locked = verb not in READS
        if locked and not (self.lock.acquire(True, LOCK_WAIT_S) if verb != "status"
                           else self.lock.acquire(False)):
            return no("error the projector is busy with the command before "
                      "this one", busy=True)
        try:
            if verb in SPECIALS:
                return getattr(self, "do_" + verb)(args)
            tool, words, checks, timeout = COMMANDS[verb]
            if len(args) != len(checks):
                raise Refused("error %s takes %d argument(s), not %d"
                              % (_tame(verb), len(checks), len(args)))
            ok, line, _ = self.run(tool, list(words) + [
                check(value) for check, value in zip(checks, args)], timeout)
            return {"ok": ok, "line": line}
        except Refused as refusal:
            return no(str(refusal))
        except OSError as problem:        # a disk that is full, a file that is gone
            return no("error %s" % problem)
        finally:
            if locked:
                self.lock.release()


class Handler(http.server.BaseHTTPRequestHandler):
    """GET / is the page, POST /api is every verb.  There is nothing else."""

    server_version, protocol_version = "h713-panel", "HTTP/1.1"
    PLAIN = "text/plain; charset=utf-8"
    JSON = "application/json; charset=utf-8"

    def _send(self, code, kind, body):
        self.send_response(code)
        self.send_header("Content-Type", kind)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _authorized(self):
        """HTTP Basic Auth against the one password; the user name is free.
        No password configured (--no-auth) means every request passes."""
        want = self.server.password
        if want is None:
            return True
        header = self.headers.get("Authorization", "")
        if header.startswith("Basic "):
            try:
                got = base64.b64decode(header[6:].strip(), validate=True).decode("utf-8")
            except (ValueError, UnicodeDecodeError):
                got = ""
            if hmac.compare_digest(got.partition(":")[2].encode(), want.encode()):
                return True
        self.send_response(401)
        self.send_header("WWW-Authenticate", 'Basic realm="%s", charset="UTF-8"' % REALM)
        self.send_header("Content-Type", self.PLAIN)
        self.send_header("Content-Length", "0")
        self.end_headers()
        self.verb = "(401)"
        return False

    def do_GET(self):
        if not self._authorized():
            return
        if self.path.split("?")[0] in ("/", "/index.html"):
            self._send(200, "text/html; charset=utf-8", self.server.page)
        else:
            self._send(404, self.PLAIN, b"not this page\n")

    def do_POST(self):
        if not self._authorized():
            return
        if self.path.split("?")[0] != "/api":
            self._send(404, self.PLAIN, b"not this page\n")
            return
        # The browser sends the password with a form posted from any other site
        # too; a header of our own cannot be set by one.
        if self.headers.get("X-Requested-With") != "h713-panel":
            self._send(200, self.JSON, json.dumps(
                no("error that is not a request this page makes")).encode("utf-8"))
            return
        try:
            length = int(self.headers.get("Content-Length") or 0)
            if length > MAX_BODY:
                raise ValueError("too long")
            request = json.loads(self.rfile.read(length).decode("utf-8"))
            self.verb = request.get("verb") if isinstance(request, dict) \
                else None
            answer = self.server.panel.call(request)
        except (ValueError, UnicodeDecodeError):
            answer = no("error that is not a request this page makes")
        self._send(200, self.JSON, json.dumps(answer).encode("utf-8"))

    verb = None

    def log_message(self, fmt, *args):
        """One line per request: who, what, and the verb - so the journal
        says which button was pressed (the focus stood outside its range on
        23.09.2026 and nobody could tell what had moved it). The browser's
        path stays out of it."""
        sys.stderr.write("%s %s%s\n" % (self.address_string(), self.command,
                                          " " + str(self.verb)[:40]
                                          if self.verb else ""))


def serve(panel, page, address=DEFAULT_ADDRESS, port=DEFAULT_PORT, password=None):
    server = http.server.ThreadingHTTPServer((address, port), Handler)
    server.panel, server.page, server.password = panel, page, password
    panel.server = server          # the password page changes the door's password
    return server


def read_password(path):
    """The `password=` line of the file, or None."""
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                if line.startswith("password="):
                    return line[9:].strip() or None
    except OSError:
        pass
    return None


def write_password(path, pw):
    write_file(path, ("# h713-panel: the settings page asks for this password (any user name).\n"
                      "# Shown once in the journal when it was made; `h713-panel --show-password` prints it.\n"
                      "password=%s\n" % pw).encode("utf-8"))


def make_password(path):
    """A fresh password into `path` (root, 0600), returned.  secrets.token_urlsafe(9)
    gives twelve characters, enough for a door on a home network and short
    enough to type from a photo of the console."""
    pw = secrets.token_urlsafe(9)
    write_password(path, pw)
    return pw


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="h713-panel",
        description="the projector's settings page: one HTML page and a verb "
                    "list, every verb one existing h713 command.",
        epilog="HTTP Basic Auth with the password in /etc/h713/panel.env (made at the "
               "first start); --no-auth for a test bench.")
    add = parser.add_argument
    add("--password-file", default=PASSWORD_FILE, metavar="PATH",
        help="where the password lives (default %s)" % PASSWORD_FILE)
    add("--no-auth", action="store_true", help="serve without a password (tests, a bench)")
    add("--show-password", action="store_true",
        help="print the password and exit (make one if there is none)")
    add("--port", type=int, default=DEFAULT_PORT)
    add("--address", default=DEFAULT_ADDRESS, metavar="ADDR",
        help="the default is every interface")
    add("--page", default=PAGE_PATH, metavar="PATH", help="the HTML page")
    add("--tools", metavar="DIR", help="the h713 tools; default $PATH")
    add("--keystone-conf", default=KEYSTONE_CONF, metavar="PATH")
    add("--etc", default=ETC, metavar="DIR", help="keys.conf osd.conf tv.conf wifi.env (default %s)" % ETC)
    add("--rollback-wifi", action="store_true",
        help="put wifi.env.prev back and restart h713-wifi (the fall-back timer runs this)")
    args = parser.parse_args(argv)
    if args.rollback_wifi:
        return Panel(args.tools, etc=args.etc).rollback_wifi()
    password = None
    if args.show_password:
        pw = read_password(args.password_file)
        if pw is None:
            try:
                pw = make_password(args.password_file)
            except OSError as e:
                sys.stderr.write("error %s: %s\n" % (args.password_file, e))
                return 2
        print(pw)
        return 0
    if not args.no_auth:
        password = read_password(args.password_file)
        if password is None:
            try:
                password = make_password(args.password_file)
            except OSError as e:
                sys.stderr.write("error no password and none can be made at %s: %s -- "
                                 "refusing to serve an open page; --no-auth says so on purpose\n"
                                 % (args.password_file, e))
                return 2
            sys.stderr.write("ok password for the settings page made and kept in %s -- "
                             "`h713-panel --show-password` prints it\n" % args.password_file)
    page = read_bytes(args.page)
    if page is None:
        sys.stderr.write("error %s is missing -- the page is one file beside "
                         "this one\n" % args.page)
        return 2
    server = serve(Panel(args.tools, args.keystone_conf, etc=args.etc,
                         password_file=args.password_file), page, args.address,
                   args.port, password)
    sys.stderr.write("ok h713-panel on http://%s:%d/ -- %s\n"
                     % (args.address, args.port,
                        "password from " + args.password_file if password else "NO authentication (--no-auth)"))
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        server.server_close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
