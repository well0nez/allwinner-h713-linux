class Refused(Exception):
    """An argument is outside its range, or the verb is not in the table."""


def no(line, **rest):
    """An answer the page shows as an error; nothing was started."""
    return dict(rest, ok=False, line=line)


def _tame(value):
    """The browser's word, shortened and stripped: it goes into a message."""
    return re.sub(r"[^\w.:+-]", "?", str(value))[:32]


def _choice(*names):
    def check(value):
        text = value if isinstance(value, str) else str(value)
        if text not in names:
            raise Refused("error \"%s\" is not one of %s"
                          % (_tame(text), " ".join(names)))
        return text
    check.spec = ("choice", list(names))      # what the page draws it with
    return check


def _number(low, high, step=1):
    def check(value):
        try:
            number = int(value)
            if isinstance(value, bool) or not low <= number <= high \
                    or (number - low) % step:
                raise ValueError("out of range")
        except (TypeError, ValueError):
            raise Refused("error \"%s\" is not a whole number %d..%d in "
                          "steps of %d" % (_tame(value), low, high, step))
        return str(number)
    check.spec = ("number", low, high, step)
    return check


def _decimal(low, high, step):
    """A number in steps of `step` (scale 0.1, seconds 0.5), written as %g."""
    def check(value):
        try:
            number = float(value)
            if isinstance(value, bool) or not low <= number <= high \
                    or abs(number / step - round(number / step)) > 1e-6:
                raise ValueError("out of range")
        except (TypeError, ValueError):
            raise Refused("error \"%s\" is not a number %g..%g in steps of %g"
                          % (_tame(value), low, high, step))
        return "%g" % number
    check.spec = ("number", low, high, step)
    return check


CTRL = re.compile(r"[\x00-\x1f\x7f]")


def _text(name, low, high):
    """A word for wifi.env: bytes low..high, no control character (a newline
    would be a second line of the file), no quote or backslash (h713-wifi
    refuses both).  The refusal never repeats the value: it may be the password."""
    def check(value):
        text = value if isinstance(value, str) else ""
        if not low <= len(text.encode("utf-8")) <= high or CTRL.search(text) \
                or '"' in text or "\\" in text:
            raise Refused("error %s needs %d..%d bytes, no control character, quote "
                          "or backslash" % (name, low, high))
        return text
    return check


def _pattern(name, regex, valid=lambda text: True):
    def check(value):
        text = value if isinstance(value, str) else ""
        if not re.fullmatch(regex, text) or not valid(text):
            raise Refused("error %s is not a valid %s" % (_tame(text), name))
        return text
    return check


