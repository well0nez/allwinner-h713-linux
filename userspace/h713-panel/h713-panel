def read_bytes(path):
    """A file or None: a status is a report and may not raise."""
    try:
        with open(path, "rb") as handle:
            return handle.read()
    except OSError:
        return None


def read_text(path):
    blob = read_bytes(path)
    return None if blob is None else blob.decode("utf-8", "replace")


def first_int(text, default=None):
    found = FIRST_INT.search(text or "")
    return int(found.group(0)) if found else default


def labelled(text):
    """The "label   value" lines of a status as a dictionary, first wins."""
    fields = {}
    for line in (text or "").splitlines():
        found = LABEL.match(line)
        if found and found.group(1) not in fields:
            fields[found.group(1)] = found.group(2).strip()
    return fields


def first_line(text, code):
    """The first line beginning with ok or error - how every ctl of this
    project answers - else the first line there is, or the exit code."""
    other = ""
    for line in (text or "").splitlines():
        word = line.strip()
        if word and word.split(None, 1)[0] in ("ok", "error"):
            return code == 0 and word.startswith("ok"), word
        other = other or word
    # A tool that speaks in sentences (h713-autofocus): its refusal is the
    # LAST line, not the first - the first is its metric line.
    last = ""
    for line in (text or "").splitlines():
        if line.strip():
            last = line.strip()
        if line.startswith("stopped"):      # the autofocus verdict line
            return code == 0, line.strip()
    fallback = "ok" if code == 0 else "error exit code %d" % code
    return code == 0, (last if code else other) or fallback


def temperatures(root=THERMAL_DIR):
    """Every thermal zone as degrees, under the name the zone gives itself."""
    found = []
    try:
        names = [n for n in sorted(os.listdir(root)) if "thermal_zone" in n]
    except OSError:
        return found
    for name in names:
        milli = first_int(read_text(os.path.join(root, name, "temp")))
        kind = read_text(os.path.join(root, name, "type")) or name
        if milli is not None:
            found.append({"name": kind.strip(), "c": round(milli / 1000.0, 1)})
    return found


def set_conf_key(path, key, value):
    """One `key = value` line rewritten, every other line kept as it is:
    comments, order, and the keys this page knows nothing about.  Written into
    a .new file, fsynced and renamed over as h713-warp writes warp.conf."""
    lines, written = (read_text(path) or "").splitlines(), False
    for index, line in enumerate(lines):
        found = CONF_KEY.match(line)
        if found and found.group(2) == key:
            rest = found.group(3)
            lines[index] = "%s%s = %s%s" % (
                found.group(1), key, value,
                "   #" + rest.split("#", 1)[1] if "#" in rest else "")
            written = True
    if not written:
        lines.append("%s = %s" % (key, value))
    with open(path + ".new", "wb") as handle:
        handle.write(("\n".join(lines) + "\n").encode("utf-8"))
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(path + ".new", path)


def write_file(path, data, mode=0o600):
    """`data` into a .new file (fsynced), renamed over `path`: after a power
    cut the old file or the new one stands there, never half of one."""
    fd = os.open(path + ".new", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    with os.fdopen(fd, "wb") as handle:
        handle.write(data)
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(path + ".new", path)


def read_conf(path):
    """`key = value` of a configuration file as a dictionary: comments cut,
    the last line of a key wins - as the daemons read them."""
    found = {}
    for line in (read_text(path) or "").splitlines():
        key, equals, value = line.split("#", 1)[0].partition("=")
        if key.strip() and equals:
            found[key.strip()] = value.strip()
    return found


def read_env(text):
    """wifi.env: `key=value`, only a line that BEGINS with # is a comment
    (a password may hold one), nothing is trimmed - h713-wifi parses it so."""
    found = {}
    for line in (text or "").splitlines():
        if line and not line.startswith("#") and "=" in line:
            key, _, value = line.partition("=")
            found[key] = value.rstrip("\r")
    return found


def env_with(text, updates):
    """wifi.env with `key=value` lines replaced, comments and order kept, a
    missing key appended.  No spaces around the = : h713-wifi takes them for
    part of the key, which is what set_conf_key's `key = value` would do."""
    lines, left = (text or "").splitlines(), dict(updates)
    for index, line in enumerate(lines):
        key = line.partition("=")[0]
        if "=" in line and not line.startswith("#") and key in left:
            lines[index] = "%s=%s" % (key, left.pop(key))
    return "\n".join(lines + ["%s=%s" % kv for kv in left.items()]) + "\n"


def hosts_with(text, name):
    """/etc/hosts with its 127.0.1.1 line (Debian's own name for this host)
    pointing at `name`; appended when there is none."""
    lines, done = (text or "").splitlines(), False
    for index, line in enumerate(lines):
        if re.match(r"127\.0\.1\.1\s", line):
            lines[index], done = "127.0.1.1\t" + name, True
    return "\n".join(lines + ([] if done else ["127.0.1.1\t" + name])) + "\n"


def lacking(after_move, present):
