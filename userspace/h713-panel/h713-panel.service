# SPDX-License-Identifier: GPL-2.0
#
# h713-panel: the settings page on port 8080. One instance; the page itself
# talks to no device, it only runs the other h713 tools as child processes.
#
# ORDERING. network-online.target is wanted, not required: the socket is bound
# to 0.0.0.0, so the page comes up whether or not an address is there yet and
# answers as soon as one is. There is deliberately no ordering against
# h713-tv@videoN (a template, started by udev - see h713-warp.service for the
# same reasoning) or h713-warp: a tool that is not running answers "error ..."
# and that error is what the page shows.
[Unit]
Description=HY310: the projector's settings page for a phone or a browser
Documentation=file:/usr/local/share/doc/h713-panel/docs-h713-panel.md
Wants=network-online.target
After=network-online.target

StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/local/lib/h713-panel/h713-panel --port 8080
Restart=on-failure
RestartSec=5s

# It runs h713-keystone reference, h713-focus and the ctl clients, and it
# writes the settings pages' files (keystone.conf, keys.conf, osd.conf, tv.conf,
# wifi.env and its fall-back copy, power.conf through h713-power, panel.env), so
# /etc/h713 is writable. It opens no device node of its own.
# The rest is the narrowest set the other verbs need; each line says whose write it is:
#  /etc/hosts      the host name page rewrites the 127.0.1.1 line in place. The file
#                  alone, not /etc: a rename needs the directory, an in-place write
#                  does not. /etc/hostname is NOT here: `hostnamectl set-hostname`
#                  asks systemd-hostnamed, which writes it outside this unit.
#  the other three h713-logs (volatile|persistent): it writes the journald drop-in
#                  and var-log.mount, `systemctl enable` links the mount into
#                  /etc/systemd/system, and /data/log is the persistent journal.
#                  "-" lets the unit start where one is missing; h713-logs then
#                  fails by itself, with a message, instead of this unit not starting.
# The Wi-Fi fall-back (systemd-run, a timer that restores wifi.env) runs in the
# manager, not in this sandbox, so it needs no path of its own.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc/h713 /etc/hosts
ReadWritePaths=-/etc/systemd/journald.conf.d -/etc/systemd/system -/data
ProtectHome=yes
PrivateTmp=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
