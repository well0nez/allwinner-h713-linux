#!/usr/bin/env python3
"""h713-focus -- drive the focus motor of the HY310 by hand.

Replaces legacy/tools/focus (63 lines of sh) and keeps its subcommands
up/down/flush/status. New is that the range watcher is read before and after
every move instead of writing blind.

What PH14 is -- and what it is not
----------------------------------
PH14 is a RANGE WATCHER, not a limit switch. It reads active_level (here HIGH)
*while* the mechanism stands inside the permitted range; the edge is recognized
when that level DROPS. Measured on the device, 12.09.2026
(analyse/boot/motor-bereichswaechter-20260912.txt):

    raw=1 ... step=-204
    raw=0 ... step=-206            <== edge
    raw=1 ... edge_dn=1 step=-207  (the driver reverses, latches the edge, holds)

Reversing and latching the edge is done by the driver itself
(motor_run_dn_control). This tool does not rebuild that -- it recognizes that it
happened and then stops. Above all it recognizes the cases in which the driver
CANNOT reverse at all: num=0 or motor_ctrl_no_limit=1.

Four safeguards
---------------
1. Never blind: read and check motor_limit before every chunk, and again after.
2. A hard cap per run (RUN_MAX), even when the watcher stays silent. A watcher
   that reports nothing is no proof that there is still room.
3. Ctrl-C is caught: drain the queue, end in an orderly way.
4. Stop at every doubt -- edge, level gone, command dropped, deadline over.

motor_ctrl_no_limit is NEVER written, and the module is not loaded by this tool
(see LOAD_HINT -- without homing=0 the loading itself starts moving).
"""

from __future__ import annotations

import argparse
import glob
import os
import signal
import sys
import time
from pathlib import Path

# --- driver and protocol -------------------------------------------------
# What is specific to the device keeps "hy310": the tool is called h713-focus,
# the driver is not renamed (doku/60-offen.md, "tool names").
DRIVER = "hy310-focus-motor"
MODULE = "hy310_focus_motor"

ATTR_CTRL = "motor_ctrl"
ATTR_LIMIT = "motor_limit"
ATTR_NO_LIMIT = "motor_ctrl_no_limit"

#: motor_ctrl_store: (cmd << 8) | (steps & 0x7f). 8/9 are the "manual"
#: commands -- they clear m->autofocus, the driver sleeps per phase. 1/2 would
#: be the same movement with autofocus timing (mdelay, busy wait); the old
#: focus script took 1/2, which is wrong for manual operation.
CMD_UP, CMD_DOWN, CMD_FLUSH = 8, 9, 3

#: The driver silently clamps msteps per write to MOVE_CLAMP_MAX = 18
#: (motor_run_up_dn). Whoever writes 30 gets 18 and does not notice.
MSTEPS_PER_COMMAND_MAX = 18

#: How many msteps the driver drives back at most to get into the range again
#: (RECOVERY_MAX). It stands in no sysfs attribute.
RECOVERY_MAX = 40

#: Absolute cap for a single run. The only measured way to an edge is 206
#: msteps; the device tree claims 800 in total (NOT checked on the device). 400
#: is twice the measured and half the claimed value. If no edge is found within
#: it, that is a finding.
RUN_MAX = 400

#: Chunk size: the grid in which the measurement of 12.09. found the edge.
CHUNK_DEFAULT = 2

POLL_MS = 25              # polling interval while looking
MSTEP_MS = 16.0           # cycle(2) * step_num(8) * ctrl_time(1); measured ~14.4
BACK_STEP = 5             # DEFAULT_BACK_STEP, only for the deadline computation

LOAD_HINT = f"""\
The driver is not there. Normally udev loads it at boot by itself (=m, node
active since patch 0157). If not, by hand:

    modprobe {MODULE}

Since patch 0156 homing is OFF by default, so loading moves nothing. On an
older kernel it is on by default -- there 'homing=0' is mandatory, otherwise
the loading alone drives up to 100 msteps UPWARDS, towards the mechanical stop
(HOMING_UP_MAX).

h713-focus does not load the module itself. A tool that picks parameters
unasked which set mechanics in motion is exactly the mistake to be avoided
here."""


class Error(Exception):
    """Something is wrong -- message out, return value != 0, drive nothing."""


# --- find the node, do not type it in -------------------------------------
# Here it is called motor-ctr, on stock motor_ctr, in future perhaps something
# else. The only reliable thing is the driver name. On 11./12.09. two mistakes
# in this project came from taking a number out of a foreign context.

def find_base(given: str | None) -> tuple[Path, str]:
    """Returns (directory, how it was found)."""
    given = given or os.environ.get("H713_FOCUS_SYSFS")
    if given:
        p = Path(given)
        missing = [a for a in (ATTR_CTRL, ATTR_LIMIT) if not (p / a).exists()]
        if missing:
            raise Error(f"{p}: {', '.join(missing)} is missing there")
        return p, "given"

    # The reliable way: what is bound to the driver?
    root = Path("/sys/bus/platform/drivers") / DRIVER
    if root.is_dir():
        for e in sorted(root.iterdir()):
            if e.name in ("bind", "unbind", "uevent", "module"):
                continue
            target = e.resolve()
            if all((target / a).exists() for a in (ATTR_CTRL, ATTR_LIMIT)):
                return target, f"bound to {DRIVER}"

    # Fallback in case the driver is not (any longer) registered.
    for pattern in ("/sys/bus/platform/devices/*motor*",
                    "/sys/devices/platform/*/" + ATTR_LIMIT):
        for raw in sorted(glob.glob(pattern)):
            p = Path(raw)
            if p.name == ATTR_LIMIT:
                p = p.parent
            p = p.resolve()
            if all((p / a).exists() for a in (ATTR_CTRL, ATTR_LIMIT)):
                return p, "found over the name"

    if not root.is_dir():
        raise Error("No motor node found.\n\n" + LOAD_HINT)
    raise Error(f"The driver {DRIVER} is registered, but no device is bound to "
                f"it -- the node in the device tree is probably 'disabled'.")


class Motor:
    """The only seam to the file system."""

    def __init__(self, base: Path, dry: bool = False):
        self.base, self.dry = base, dry

    def read(self, attr: str) -> str:
        return (self.base / attr).read_text().strip()

    def no_limit(self) -> int:
        try:
            return int(self.read(ATTR_NO_LIMIT))
        except (OSError, ValueError):
            return 0        # attribute missing -> the driver does not know it

    def command(self, cmd: int, msteps: int = 0) -> int:
        """One word into motor_ctrl. In a dry run nothing is written."""
        if msteps > MSTEPS_PER_COMMAND_MAX:
            raise Error(f"{msteps} msteps per command -- the driver silently "
                        f"clamps to {MSTEPS_PER_COMMAND_MAX}.")
        word = (cmd << 8) | (msteps & 0x7F)
        if not self.dry:
            (self.base / ATTR_CTRL).write_text(str(word))
        return word

    def flush(self) -> None:
        self.command(CMD_FLUSH)


# --- reading motor_limit --------------------------------------------------
#
#   1 up=1 dn=1 num=1 raw=1 act=1 edge_up=0 edge_dn=1 step=-207
#   ^ stock field: motor_limiter_status(0), that is "in range" 1/0
#
# The first field is stock compatible, the rest came with patch 0154.

REQUIRED = ("num", "act", "edge_up", "edge_dn", "step")


class Limit:
    """One parsed line of motor_limit."""

    def __init__(self, line: str):
        self.raw_line = (line or "").strip()
        if not self.raw_line:
            raise Error("motor_limit was empty")
        parts = self.raw_line.split()
        try:
            self.in_range = bool(int(parts[0]))
        except ValueError:
            raise Error(f"the first field of motor_limit is not a number: "
                        f"{parts[0]!r}") from None
        p = {}
        for t in parts[1:]:
            if "=" in t:
                k, v = t.split("=", 1)
                try:
                    p[k] = int(v)
                except ValueError:
                    pass
        # Before patch 0154 motor_limit printed only "%d up=%d dn=%d num=%d".
        # Neither the position nor the level can be derived from that -- and
        # nothing is guessed here.
        missing = [n for n in REQUIRED if n not in p]
        if missing:
            raise Error(
                f"motor_limit without the fields {', '.join(missing)} -- what "
                f"was read: {self.raw_line!r}. Expected is the format from "
                f"patch 0154 on; before that the driver printed only "
                f"'N up=N dn=N num=N'.")
        self.num, self.act = p["num"], p["act"]
        self.edge_up, self.edge_dn = bool(p["edge_up"]), bool(p["edge_dn"])
        self.step = p["step"]
        self.raw = p.get("raw")

    def edge(self, up: bool) -> bool:
        return self.edge_up if up else self.edge_dn


def read_limit(m: Motor) -> Limit:
    return Limit(m.read(ATTR_LIMIT))


# --- the safety rules -----------------------------------------------------
# One rule per paragraph, each with its evidence. Whoever loosens one should be
# able to read here what it prevented.

def check(g: Limit, up: bool, no_limit: int) -> str | None:
    """May this direction be driven? None = yes, otherwise the reason."""
    # 1. Without a requested watcher there is no protection.
    #    motor_limiter_status() returns 1 ("in range") unconditionally when
    #    limiter_num == 0, and motor_run_*_control then NEVER reverses. The
    #    first field looks like the healthy case while it does -- so it is
    #    worthless exactly when it would matter.
    if g.num < 1:
        return ("num=0 -- the driver has not requested a range watcher. Then it "
                "reports 'in range' permanently and does not reverse at the "
                "edge; every run goes unbraked into the stop.")

    # 2. motor_ctrl_no_limit switches the check off explicitly
    #    (`if (!m->no_limit && !motor_limiter_status(...))`). This tool never
    #    writes the attribute -- but somebody else may have set it.
    if no_limit:
        return (f"{ATTR_NO_LIMIT} = 1 -- the range check is switched off, the "
                f"driver does not reverse at the edge. First by hand "
                f"'echo 0 > {ATTR_NO_LIMIT}', then carry on here.")

    # 3. The raw level is the only quantity that really comes from the pin.
    #    On the NTC exactly this gap produced an invented temperature out of an
    #    open input (analyse/boot/ntc-gpadc-messung-20260911.txt).
    if g.raw is None:
        return ("motor_limit names no raw level (raw=) -- driver older than "
                "patch 0154 or changed. Showing yes, driving no.")
    if g.raw < 0:
        return ("raw=-1 -- the driver could not read the level of the watcher. "
                "With that, 'in range' says nothing either.")

    # 4. The edge itself: in-range is act (here HIGH).
    if g.raw != g.act:
        return (f"raw={g.raw}, expected is act={g.act} -- the mechanism stands "
                f"outside the permitted range. The driver walks it back in at "
                f"boot (homing): reboot, or 'modprobe -r hy310_focus_motor && "
                f"modprobe hy310_focus_motor'.")

    # 5. And what the driver has seen itself already.
    if not g.in_range:
        return ("motor_limit reports 'outside' (first field 0) although the raw "
                "level fits -- contradictory. Look, do not drive.")

    # 6. The latched edge in the direction of travel. The driver drops such
    #    commands silently (motor_run_up_dn checks edge_up/edge_dn before
    #    queueing) -- silently is the wrong thing here.
    if g.edge(up):
        return (f"edge_{'up' if up else 'dn'}=1 -- the edge in this direction is "
                f"latched, the driver drops every further command towards it. "
                f"One mstep the other way clears the edge.")
    return None


# --- the watched run ------------------------------------------------------

def _line(g: Limit, extra: str = "") -> str:
    return (f"step={g.step:<6d} raw={'?' if g.raw is None else g.raw} "
            f"act={g.act} edge_up={int(g.edge_up)} edge_dn={int(g.edge_dn)}"
            f"{extra}")


def _deadline_s(n: int) -> float:
    """How long may a chunk of n msteps take at most?

    Computed is the worst case the driver itself provides for: the n msteps
    plus a full recovery run plus back_step, times 1.5. A deadline that is too
    tight would abort in the middle of a movement -- worse than waiting a
    second too long.
    """
    return (n + RECOVERY_MAX + BACK_STEP) * MSTEP_MS * 1.5 / 1000.0 + 0.3


def _wait(m: Motor, up: bool, before: Limit, expected: int,
          deadline: float, aborted: list) -> tuple[Limit, str]:
    """Wait for the end of a chunk. Returns (state, reason).

    Why waiting is necessary at all: motor_ctrl only queues and kicks a
    workqueue handler. The write call returns at once, the mechanism runs on
    afterwards. Whoever writes again immediately drives into a movement he has
    not seen.
    """
    end = time.monotonic() + deadline
    now = before
    while True:
        if aborted:
            return now, "abort"
        try:
            now = read_limit(m)
        except (OSError, Error):
            return now, "timeout"   # a failed read is no reason to drive on
        # Order: the edge first. If the last mstep hits the edge, the counter
        # happens to be at the target as well -- then "edge" is the right
        # message, not "done".
        if now.edge(up) and not before.edge(up):
            return now, "edge"
        if now.raw is not None and now.raw != now.act:
            return now, "outside"
        if now.step == expected:
            return now, "done"
        if time.monotonic() >= end:
            return now, "timeout"
        time.sleep(POLL_MS / 1000.0)


def _wait_for_rest(m: Motor, aborted: list) -> Limit | None:
    """Wait until the driver has finished its recovery run.

    Whoever has seen raw=0 has seen an INTERMEDIATE state: the level is gone,
    the driver is driving back, the counter has not moved on yet and the edge is
    not set yet. Whoever reports that as a result describes something that is
    gone a tenth of a second later.
    """
    end = time.monotonic() + _deadline_s(2)
    while True:
        if aborted:
            return None
        try:
            now = read_limit(m)
        except (OSError, Error):
            return None
        if now.raw is not None and now.raw == now.act:
            return now
        if time.monotonic() >= end:
            return None
        time.sleep(POLL_MS / 1000.0)


def run(m: Motor, up: bool, count: int, chunk: int) -> int:
    """Drive count msteps -- watched, in chunks. Returns the exit code."""
    direction = "up" if up else "down"
    if count > RUN_MAX:
        print(f"Note: {count} msteps cut to {RUN_MAX} "
              f"(hard cap for one run).")
        count = RUN_MAX

    no_limit = m.no_limit()
    start = read_limit(m)
    print(f"before:  {_line(start)}")

    reason = check(start, up, no_limit)
    if reason:
        print(f"\nBlocked: {reason}", file=sys.stderr)
        return 3

    if m.dry:
        n = min(chunk, count)
        word = (CMD_UP if up else CMD_DOWN) << 8 | n
        print(f"\nDry run: it would drive {count} msteps '{direction}', in "
              f"chunks of {chunk}. The first write would be '{word}' "
              f"into {ATTR_CTRL} (= ({CMD_UP if up else CMD_DOWN} << 8) | {n}). "
              f"Nothing was written.")
        return 0

    # Catch Ctrl-C instead of leaving the process in the middle of a chunk.
    aborted: list = []
    old = signal.signal(signal.SIGINT, lambda *_: aborted.append(True))
    cmd = CMD_UP if up else CMD_DOWN
    sign = 1 if up else -1
    moved, left, result = 0, count, 0
    try:
        while left > 0 and not aborted:
            before = read_limit(m)
            reason = check(before, up, no_limit)
            if reason:
                print(f"\nStopped: {reason}", file=sys.stderr)
                result = 3
                break

            n = min(chunk, left)
            expected = before.step + sign * n
            m.command(cmd, n)
            after, how = _wait(m, up, before, expected, _deadline_s(n), aborted)
            moved += abs(after.step - before.step)
            left -= n
            print(f"  {direction:>4} {n:2d} -> {_line(after)}"
                  f"{'' if how == 'done' else '   [' + how + ']'}")

            if how == "edge":
                print(f"\nEdge in direction '{direction}' reached: the driver has "
                      f"reversed and latched the edge.")
                break
            if how == "outside":
                print(f"\nThe raw level has dropped (raw={after.raw}, "
                      f"act={after.act}) -- the mechanism stands at the edge of "
                      f"the range. Stopped before the driver itself follows.")
                print("The driver is driving back; waiting for it to settle ...")
                rest = _wait_for_rest(m, aborted)
                if rest is not None:
                    print(f"Settled: {_line(rest)}")
                else:
                    print("The driver has NOT come back into the range -- look "
                          "before anything here drives on.",
                          file=sys.stderr)
                    result = 3
                break
            if how == "timeout":
                if abs(after.step - before.step) == 0:
                    print("\nThe counter has not moved -- the driver dropped the "
                          "command. Most frequent reason: an edge in the "
                          "direction of travel, latched between the check and "
                          "the write.", file=sys.stderr)
                else:
                    print(f"\nThe deadline for this chunk has run out "
                          f"({abs(after.step - before.step)} of {n} msteps in "
                          f"the counter). Stopped.", file=sys.stderr)
                result = 4
                break

        if aborted:
            print("\nAborted (Ctrl-C).")
            try:
                m.flush()
                print("Queue drained. The mstep that was running runs to its end "
                      "-- the driver cannot abort it.")
            except OSError as e:
                print(f"Queue could not be drained: {e}", file=sys.stderr)
            result = 130
    finally:
        signal.signal(signal.SIGINT, old)

    print(f"after:   {_line(read_limit(m))}   ({moved} msteps driven)")
    return result


# --- subcommands ----------------------------------------------------------

def show_status(m: Motor, how: str) -> int:
    g = read_limit(m)
    print(f"Node:        {m.base}  ({how})")
    print(f"{ATTR_LIMIT}: {g.raw_line}")
    try:
        print(f"{ATTR_CTRL}:  {m.read(ATTR_CTRL)}"
              f"   (step_cur step_inc%10 in_range)")
    except OSError:
        pass
    no_limit = m.no_limit()
    print()
    print(f"  Counter        {g.step}   -- a counter, NOT a position: after an "
          f"edge event the two drift apart by about {1 + BACK_STEP} msteps")
    print(f"  Watcher        raw={g.raw} act={g.act} -> "
          f"{'in range' if g.raw == g.act else 'OUTSIDE'}"
          f"   (num={g.num})")
    print(f"  Edges          edge_up={int(g.edge_up)} edge_dn={int(g.edge_dn)}")
    if no_limit:
        print(f"  {ATTR_NO_LIMIT} = 1 -- range check SWITCHED OFF")
    print()
    for up, name in ((True, "up"), (False, "down")):
        reason = check(g, up, no_limit)
        print(f"  {name:<5} {'free' if reason is None else 'blocked: ' + reason}")
    return 0


def unlatch(m: Motor) -> int:
    """Clear latched edges (write to motor_limit).

    Normally unnecessary: the driver clears the opposite edge itself as soon as
    the other direction is driven. Meant for the case that both edges stand --
    then the driver otherwise takes no command at all any more.
    """
    g = read_limit(m)
    if g.raw is not None and g.raw != g.act:
        raise Error(f"raw={g.raw}, act={g.act} -- the mechanism stands outside "
                    f"the permitted range. A cleared edge would take away the "
                    f"only brake here. Drive back first.")
    if not (g.edge_up or g.edge_dn):
        print("No edge latched, nothing to do.")
        return 0
    if m.dry:
        print(f"Dry run: it would clear edge_up={int(g.edge_up)} "
              f"edge_dn={int(g.edge_dn)}. Nothing was written.")
        return 0
    (m.base / ATTR_LIMIT).write_text("0")
    print(f"Edges cleared.  {_line(read_limit(m))}")
    return 0


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(
        prog="h713-focus",
        description="drive the focus motor of the HY310 by hand -- watched.",
        epilog="msteps are microsteps. The only measured way to an edge is "
               "206; there is no more than %d per run. The switches --trocken "
               "and --schritt keep their German names on purpose: a device in "
               "the field may be driven from an older note."
               % RUN_MAX)
    p.add_argument("--sysfs", metavar="PATH",
                   help="give the motor node instead of searching ($H713_FOCUS_SYSFS)")
    p.add_argument("-n", "--trocken", action="store_true", dest="dry",
                   help="only check and show, write nothing")
    p.add_argument("--schritt", type=int, default=CHUNK_DEFAULT, dest="chunk",
                   metavar="N",
                   help=f"msteps per write (default {CHUNK_DEFAULT}, "
                        f"at most {MSTEPS_PER_COMMAND_MAX})")
    sub = p.add_subparsers(dest="command", required=True)

    sub.add_parser("status", help="watcher, edges, counter and what is free")
    for name, helptext in (("up", "drive upwards"), ("down", "drive downwards")):
        s = sub.add_parser(name, help=helptext + " (watched, in chunks)")
        s.add_argument("msteps", type=int)
    sub.add_parser("flush", help="drain the queue (emergency stop)")
    sub.add_parser("unlatch", help="clear latched edges")

    a = p.parse_args(argv)
    # Messages go partly to stdout, partly to stderr. Without this line they
    # stand in a pipe in the wrong order -- and it is exactly on an abort that
    # what was seen when has to stay traceable.
    sys.stdout.reconfigure(line_buffering=True)
    if not 1 <= a.chunk <= MSTEPS_PER_COMMAND_MAX:
        p.error(f"--schritt {a.chunk} outside 1..{MSTEPS_PER_COMMAND_MAX} "
                f"(the driver silently clamps everything above)")

    base, how = find_base(a.sysfs)
    m = Motor(base, a.dry)

    if a.command == "status":
        return show_status(m, how)
    if a.command == "flush":
        if a.dry:
            print(f"Dry run: it would write {CMD_FLUSH << 8} into {ATTR_CTRL}. "
                  f"Nothing was written.")
            return 0
        m.flush()
        print(f"Queue drained.  {_line(read_limit(m))}")
        return 0
    if a.command == "unlatch":
        return unlatch(m)

    if a.msteps < 1:
        p.error("msteps must be at least 1")
    return run(m, a.command == "up", a.msteps, a.chunk)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Error as e:
        print(f"h713-focus: {e}", file=sys.stderr)
        sys.exit(2)
    except PermissionError as e:
        print(f"h713-focus: {e}\nthe motor's sysfs belongs to root.", file=sys.stderr)
        sys.exit(2)
    except KeyboardInterrupt:
        sys.exit(130)
