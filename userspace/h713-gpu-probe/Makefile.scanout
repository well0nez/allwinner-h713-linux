# SPDX-License-Identifier: GPL-2.0
#
# h713-gpu-probe scanout -- the keystone S3/S4 tool (umbau/plan/keystone/PLAN.md).
# The recipe is the one of the h713-gpu-probe Makefile next door, plus libdrm.
#
#   make -f Makefile.scanout cross     cross-build with clang against the board
#                                      root (SYSROOT, which carries libdrm-dev)
#                                      and the S0 mesa stage (MESA_PREFIX:
#                                      headers in $(MESA_PREFIX)/include,
#                                      libraries in $(MESA_PREFIX)/lib). The
#                                      binary carries rpath /usr/local/lib,
#                                      where that tree lives on the device.
#   make -f Makefile.scanout host      syntax check only: the host has no arm64
#                                      mesa to link against, and the board has
#                                      no compiler. Point HOST_CPPFLAGS at
#                                      headers when the host has no -dev files:
#                                        make -f Makefile.scanout host \
#                                          HOST_CPPFLAGS="-I../tmp/hostinc \
#                                          -isystem $(SYSROOT)/usr/include/libdrm"
#   make -f Makefile.scanout install-cross   DESTDIR=... install the arm64 binary
#   make -f Makefile.scanout clean

CFLAGS      ?= -O2 -g
CFLAGS      += -std=c11 -Wall -Wextra -Wshadow -Wvla
LIBS         = -ldrm -lgbm -lEGL -lGLESv2

PREFIX      ?= /usr/local
BINDIR      ?= $(PREFIX)/bin

SYSROOT     ?= /srv/h713-rootfs
MESA_PREFIX ?= $(CURDIR)/../../../src/mainline/build/mesa-stage/usr/local
TARGET      ?= aarch64-linux-gnu
CROSS_CC    ?= clang

HOST_CC       ?= cc
HOST_CPPFLAGS ?= $(shell pkg-config --cflags libdrm gbm egl glesv2 2>/dev/null)

cross: h713-gpu-probe-scanout.$(TARGET)

h713-gpu-probe-scanout.$(TARGET): scanout.c
	$(CROSS_CC) --target=$(TARGET) --sysroot=$(SYSROOT) -fuse-ld=lld \
	    $(CFLAGS) $(LDFLAGS) -I$(MESA_PREFIX)/include \
	    -isystem $(SYSROOT)/usr/include/libdrm \
	    -L$(MESA_PREFIX)/lib -L$(SYSROOT)/usr/lib/$(TARGET) \
	    -Wl,-rpath,/usr/local/lib -o $@ $< $(LIBS)

host: scanout.c
	$(HOST_CC) -fsyntax-only $(HOST_CPPFLAGS) $(CFLAGS) $<

install-cross: h713-gpu-probe-scanout.$(TARGET)
	install -D -m 0755 h713-gpu-probe-scanout.$(TARGET) \
	    $(DESTDIR)$(BINDIR)/h713-gpu-probe-scanout

clean:
	rm -f h713-gpu-probe-scanout.$(TARGET)

.PHONY: cross host install-cross clean
