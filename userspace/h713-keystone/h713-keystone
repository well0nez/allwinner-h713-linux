    ("settle_degrees", "1.0", _above_zero(float, "degrees above zero")),
    ("focus_command", "h713-autofocus run", str),
)


def load_conf(path):
    """/etc/h713/keystone.conf in the house format: "key = value" with #
    comments.  An unknown key or an unreadable value is named and dropped, as
    in tv.conf; a typo does not silently become a default."""
    text = dict((name, default) for name, default, _ in DEFAULTS)
    for number, key, value in _pairs(_read(path)):
        if value is None:
            _stderr("warning: %s:%d: \"%s\" is not \"key = value\" -- dropped"
                    % (path, number, key))
        elif key not in text:
            _stderr("warning: %s:%d: %s is not a key of this file -- dropped"
                    % (path, number, key))
        else:
            text[key] = value
    conf = {"_text": text, "_path": path}
    for name, _, parse in DEFAULTS:
        try:
            conf[name] = parse(text[name])
        except ValueError as exc:
            raise Error("%s: %s = \"%s\": %s" % (path, name, text[name], exc))
    return conf


def implied_ratio(ini):
    """Throw ratio = distance / image width = 1 / (2 tan of the half field)."""
    opt = kge.reset_tou_she_bi(ini, kge.itrunc(kge.f32(ini["fdd"])))
    return 1.0 / (2.0 * opt["tan_lr_v"])


def optics(conf):
    """The ini dict AP2c's model takes, with the throw ratio honoured.

    Whalf and Hhalf scale the two half-field tangents and enter nothing else
    (not v, not u, not CELIANF_D), so one factor on both moves the throw ratio
    and leaves the panel aspect where it is.  `throw_ratio = ini` is the
    default because 0.82 is a rounding of the 0.8176 camprjspe.ini implies,
    and writing the rounding back would move the vendor optics by 0.3 % for
    nothing.  A tape measure at the wall replaces it with a real number.
    """
    ini = dict(kge.HY310_INI)
    if conf["throw_ratio"] is not None:
        factor = implied_ratio(ini) / conf["throw_ratio"]
        ini["Whalf"] = ini["Whalf"] * factor
        ini["Hhalf"] = ini["Hhalf"] * factor
    return ini


# --- the sensor -----------------------------------------------------------

class Sensor(object):
    """One IIO accelerometer, read through its IIO buffer when the kernel has
    one and through sysfs when not, and averaged."""

    def __init__(self, path, rate=None, quiet=False):
        self.path, self.quiet, self.said = path, quiet, None
        self.dev_dir, self.configfs = DEV_DIR, CONFIGFS     # the tests point these at a directory
        self.name = _read(os.path.join(path, "name")) or "?"
        self.files = tuple(os.path.join(path, "in_accel_%s_raw" % a)
                           for a in ("x", "y", "z"))
        # Display only: every angle of the chain is a ratio of counts, so the
        # scale cancels exactly (AP2g 5) and a wrong one costs no accuracy.
        try:
            self.counts_per_g = G_M_S2 / float(
                _read(os.path.join(path, "in_accel_x_scale")))
        except (TypeError, ValueError, ZeroDivisionError):
            self.counts_per_g = FALLBACK_COUNTS_PER_G
        self.rate = self.set_rate(rate) if rate else \
            float(_read(os.path.join(path, "sampling_frequency")) or 0.0)

    @staticmethod
    def find(name, given=None, directory=IIO_DIR):
        """The device whose `name` is the configured one.  The N in
        iio:deviceN is the probe order and not ours to assume."""
        if given:
            return given
        others = []
        for entry in sorted(os.listdir(directory)
                            if os.path.isdir(directory) else []):
            path = os.path.join(directory, entry)
            if entry.startswith("iio:device") \
                    and _read(os.path.join(path, "name")) == name:
                return path
            if os.path.exists(os.path.join(path, "in_accel_x_raw")):
                others.append(entry)
        if not others:
            raise Error("accelerometer: not present on this board - no IIO device "
                        "under %s reads an acceleration (h713-features says whether "
                        "the board should have one)" % directory, EXIT_NOT_PRESENT)
        raise Error("no IIO device called \"%s\" under %s -- is the "
                    "accelerometer in the device tree and st_accel loaded?"
                    % (name, directory), EXIT_NO_SENSOR)

    def set_rate(self, rate):
        """Write sampling_frequency.  At the driver's default of 1 Hz every
        read of in_accel_*_raw blocks for a second, so this is not a nicety.
        A device that refuses the value says which ones it has."""
        path = os.path.join(self.path, "sampling_frequency")
        try:
            if float(_read(path)) == rate:      # nothing to write; a write is refused while a burst has the buffer on
                return rate
        except (TypeError, ValueError, Error):
            pass
        try:
            with open(path, "wb") as fh:
                fh.write(("%g\n" % rate).encode("ascii"))
        except (OSError, IOError) as exc:
            _stderr("warning: %s = %g: %s -- the device offers %s, and until "
                    "one of those is set every reading comes at the rate it "
                    "already has"
                    % (path, rate, exc, _read(path + "_available")))
        return float(_read(path) or rate)

    def sample(self, count):
        """`count` triples, averaged.  Through the IIO buffer when the kernel
        has one: the sensor is switched on for the burst and off again, and a
        triple comes every 1/rate seconds.  Else, or when the buffer fails,
        through sysfs, where every value switches the sensor on and waits for
        it; said once per cause."""
        why = self.buffer_problem()
        if why is None:
            try:
                return self._buffer_sample(count)
            except BufferUnavailable as exc:
                why = str(exc)
        if why != self.said and not self.quiet:
            _stderr("warning: no IIO buffer (%s) - reading through sysfs, about %.1f s a reading"
                    % (why, 3 * count * SYSFS_VALUE_S))
        self.said = why
        return self._sysfs_sample(count)

    def _sysfs_sample(self, count):
        """Each read waits for the device's next sample and, in st_accel,
        switches the sensor on and off: about 60 ms a value."""
        total = [0.0, 0.0, 0.0]
        for _ in range(count):
            for index, path in enumerate(self.files):
                text = _read(path)
                if text is None:
                    raise Error("%s: cannot be read" % path, EXIT_NO_SENSOR)
                total[index] += float(int(text))
        return tuple(value / count for value in total)

    def buffer_problem(self):
        """Why the buffer cannot be used, or None.  A kernel without
        CONFIG_IIO_BUFFER has no buffer/ and no scan_elements/ under the
        device and no node in /dev."""
        node = os.path.join(self.dev_dir, os.path.basename(self.path))
        for what in (os.path.join(self.path, "buffer"), os.path.join(self.path, "scan_elements"), node):
            if not os.path.exists(what):
                return "%s is not there" % what
        return None

    def cadence(self, count, pause):
        """(seconds from one reading to the next, how they are taken), for
        the start line of watch."""
        if self.buffer_problem() is None:
            return (count + SETTLE_SAMPLES) / max(self.rate, 1.0) + BURST_SETUP_S + pause, "through the IIO buffer"
        return 3 * count * SYSFS_VALUE_S + pause, "through sysfs, this kernel has no IIO buffer"

    def _put(self, relative, text, base=None):
        path = os.path.join(base or self.path, relative)
        try:
            with open(path, "wb") as fh:
                fh.write((text + "\n").encode("ascii"))
        except OSError as exc:
            raise BufferUnavailable("%s: %s" % (path, exc.strerror or exc))

    def _get(self, relative):
        try:
            text = _read(os.path.join(self.path, relative))
        except Error as exc:
            raise BufferUnavailable(str(exc))
        if text is None:
            raise BufferUnavailable("%s is not there" % os.path.join(self.path, relative))
        return text

    def _trigger(self):
        """The sysfs node of our timer trigger; made through configfs the
        first time (it stays: nothing needs it removed)."""
        def find():
            for entry in sorted(os.listdir(os.path.dirname(self.path))):
                node = os.path.join(os.path.dirname(self.path), entry)
                if entry.startswith("trigger") and _read(os.path.join(node, "name")) == TRIGGER:
                    return node
        node = find()
        if node:
            return node
        base = os.path.join(self.configfs, "iio", "triggers", "hrtimer")
        if not os.path.isdir(base) and os.path.isdir(self.configfs):
            subprocess.run(["mount", "-t", "configfs", "configfs", self.configfs], capture_output=True)
        try:
            os.makedirs(os.path.join(base, TRIGGER), exist_ok=True)
        except OSError as exc:
            raise BufferUnavailable("no timer trigger (%s: %s) - CONFIG_IIO_HRTIMER_TRIGGER and configfs?"
                                    % (base, exc.strerror or exc))
        return find() or self._fail("the timer trigger %s did not appear" % TRIGGER)

    @staticmethod
    def _fail(why):
        raise BufferUnavailable(why)

    def _layout(self):
        """(bytes of one scan, {axis: (offset, size, big endian, signed,
        bits, shift)}) as the kernel packs the enabled channels: in index
        order, each aligned to its own size."""
        found = []
        for axis in "xyz":
            kind = SCAN_TYPE.match(self._get("scan_elements/in_accel_%s_type" % axis))
            if not kind:
                raise BufferUnavailable("the scan format of in_accel_%s is not one this tool reads" % axis)
            found.append((int(self._get("scan_elements/in_accel_%s_index" % axis)), axis) + kind.groups())
        layout, offset = {}, 0
        for _, axis, order, sign, bits, store, shift in sorted(found):
            size = int(store) // 8
            offset = -(-offset // size) * size
            layout[axis] = (offset, size, order == "be", sign == "s", int(bits), int(shift))
            offset += size
        widest = max(spec[1] for spec in layout.values())
        return -(-offset // widest) * widest, layout

    def _buffer_sample(self, count):
        node = os.path.join(self.dev_dir, os.path.basename(self.path))
        give_up = time.monotonic() + BUSY_WAIT_S
        while True:         # the kernel lets one reader open the node: its burst is over before ours starts
            try:
                fd = os.open(node, os.O_RDONLY | os.O_NONBLOCK)
                break
            except OSError as exc:
                if exc.errno != errno.EBUSY or time.monotonic() > give_up:
                    raise BufferUnavailable("%s: %s" % (node, exc.strerror or exc))
                time.sleep(0.01)
        try:
            trigger = self._trigger()
            self._put("buffer/enable", "0")                   # one a killed run left on
            self._put("sampling_frequency", "%g" % self.rate, trigger)
            if self._get("trigger/current_trigger") != TRIGGER:
                self._put("trigger/current_trigger", TRIGGER)
            for axis in "xyz":
                self._put("scan_elements/in_accel_%s_en" % axis, "1")
            self._put("buffer/length", str(BUFFER_TRIPLES))
            size, layout = self._layout()
            self._put("buffer/enable", "1")
            try:
                rows = self._collect(fd, size, layout, count + SETTLE_SAMPLES)
            finally:
                try:
                    self._put("buffer/enable", "0")           # the sensor is on only while it is read
                except BufferUnavailable as exc:
                    _stderr("warning: the accelerometer could not be switched off again: %s" % exc)
        finally:
            os.close(fd)
        rows = rows[SETTLE_SAMPLES:]
        return tuple(sum(row[i] for row in rows) / len(rows) for i in range(3))

    def _collect(self, fd, size, layout, want):
        data, rows = b"", []
        end = time.monotonic() + want / max(self.rate, 1.0) + BURST_MARGIN_S
        while len(rows) < want:
            wait = end - time.monotonic()
            if wait <= 0 or not select.select([fd], [], [], wait)[0]:
                raise BufferUnavailable("%d of %d triples came - is the timer trigger running?" % (len(rows), want))
            try:
                chunk = os.read(fd, size * BUFFER_TRIPLES)
            except BlockingIOError:
                continue
            except OSError as exc:
                raise BufferUnavailable("the buffer: %s" % (exc.strerror or exc))
            if not chunk:
                raise BufferUnavailable("the buffer returned nothing")
            data += chunk
            while len(data) >= size and len(rows) < want:
                rows.append(tuple(scan_value(data, layout[axis]) for axis in "xyz"))
                data = data[size:]
        return rows


def scan_value(data, spec):
    """One channel out of one scan, as the sysfs raw value would show it:
    `le:s12/16>>4` is a 16 bit word, shifted right by 4, 12 bits, signed."""
    offset, size, big, signed, bits, shift = spec
    value = (int.from_bytes(data[offset:offset + size], "big" if big else "little") >> shift) & ((1 << bits) - 1)
    return value - (1 << bits) if signed and value >> (bits - 1) else value


def model_triple(raw, conf):
    """The averaged raw triple in the order the models want, which is the one
    AP2g's iio_to_vendor_counts() reads: index 0 the PITCH source (the
    vendor's Y, GsY), index 1 the ROLL source (its X, GsX), index 2 the
    vertical one.  Rounding to whole digits loses nothing here: the averaged
    noise is 11 to 16 digits, not a fraction of one."""
    out = []
    for key in ("axis_pitch", "axis_roll", "axis_vertical"):
        index, sign = conf[key]
        out.append(int(round(sign * raw[index])))
    return tuple(out)


# --- the reference pose ---------------------------------------------------

def write_reference(path, counts, raw, conf):
    """counts are the vendor's units (the IIO digit times 16, AP2g 5).  The
    axis map is written with them, because a reference taken under another
    map is silently about a different pose."""
    _write_atomic(path, "\n".join(
        ["# h713-keystone reference: the level pose this device corrects",
         "# against.  Measure it again after the projector has been moved.",
         "counts = %d %d %d" % tuple(counts),
         "raw = %.2f %.2f %.2f" % raw]
        + ["%s = %s" % (key, axis_text(conf[key])) for key in
           ("axis_pitch", "axis_roll", "axis_vertical")]
        + ["taken = %s" % time.strftime("%Y-%m-%dT%H:%M:%S"), ""]))


def read_reference_file(path, conf):
    """(counts, taken) out of the stored file, or None when there is no file
    yet.  A reference from another axis map is refused rather than used."""
    text = _read(path)
    if text is None:
        return None
    values = dict((key, value) for _, key, value in _pairs(text) if value)
    for key in ("axis_pitch", "axis_roll", "axis_vertical"):
        if values.get(key) != axis_text(conf[key]):
            raise Error("%s was taken with %s = %s, the configuration says %s "
                        "-- run `h713-keystone reference` again"
                        % (path, key, values.get(key), axis_text(conf[key])))
    counts = tuple(int(v) for v in values.get("counts", "").split()
                   if re.fullmatch(r"-?\d+", v))
    if len(counts) != 3:
        raise Error("%s needs a \"counts = X Y Z\" line" % path)
    return counts, values.get("taken", "undated")


def read_reference(path, conf):
    """The stored counts alone, or None: what the model is fed."""
    found = read_reference_file(path, conf)
    return found[0] if found else None


def load_reference(path, conf, quiet=False):
    """What the automatic corrects against, and the words for the result
    line: the stored pose when the file is there, else the ideal level pose.
    The ideal is not a guess: on a unit without a factory GsInitXYZ the
    vendor's chain computes against all zeros, and for GsX and GsY that is
    the same number (only the unused GsZ differs).  A refused file (another
    axis map, no counts) is said once on stderr - the journal under the unit
    - and the ideal applies meanwhile; the note and `status` say `refused`,
    so nothing is replaced behind the user's back and the unit does not
    exit over it (v0.95-beta did, and systemd restarted it every 5 s)."""
    try:
        found = read_reference_file(path, conf)
    except Error as exc:
        if not quiet:
            _stderr("warning: reference refused (%s) - correcting against "
                    "the ideal (0, 0, 1 g) meanwhile" % exc)
        return ak.LEVEL_REFERENCE, "reference " + REFUSED_TEXT
    if found is None:
        return ak.LEVEL_REFERENCE, "reference " + IDEAL_TEXT
    return found[0], "reference file (%s)" % found[1]


# --- h713-warp ------------------------------------------------------------

def warp_call(tool, args):
    """One `h713-warp ctl ...` call; its answer starts with ok or error."""
    try:
        proc = subprocess.Popen([tool, "ctl"] + list(args),
                                stdout=subprocess.PIPE,
                                stderr=subprocess.STDOUT)
        out = proc.communicate()[0].decode("utf-8", "replace")
    except (OSError, IOError) as exc:
        raise Error("%s: %s -- is the warp daemon installed and running?"
                    % (tool, exc), EXIT_WARP)
    if proc.returncode or out.startswith("error"):
        raise Error("%s ctl %s: %s" % (tool, " ".join(args), out.strip()
                                       or "exit %d" % proc.returncode),
                    EXIT_WARP)
    return out


def warp_read_set(tool):
    """The eight values `h713-warp ctl status` reports, in APP order, or None
    when its answer does not carry all eight."""
    found = {}
    status = warp_call(tool, ["status"])
    for corner, x, y in WARP_PAIR.findall(status):
        found[(corner, "x")] = int(x)
        found[(corner, "y")] = int(y)
    for corner, axis, value in WARP_VALUE.findall(status):
        found.setdefault((corner, axis), int(value))
    if len(found) < len(WARP_SLOTS):
        return None
    return tuple(found[slot] for slot in WARP_SLOTS)


def warp_apply(tool, permille):
    """One corner and one axis per call, as KS4 specifies the verb."""
    for (corner, axis), value in zip(WARP_SLOTS, permille):
        warp_call(tool, ["keystone", "set", corner, axis, str(int(value))])


# The mount. The vendor permutes the eight values by the projection mode
# before they reach the warp (LocalService.optKeystoneFun 1154-1200), whose
# flip acts on the output; without it a rear mount doubles the roll and a
# ceiling mount puts the pitch on the wrong edge (deep review 27.09.2026,
# working journal `_deepreview/geometry` B1).  No sign flip: the model negates the
# angles itself when the unit hangs upside down.
MODE_PERM = {"front": (0, 1, 2, 3), "rear": (1, 0, 3, 2),
             "ceiling": (3, 2, 1, 0), "rear-ceiling": (2, 3, 0, 1)}


# The turn to the wall is said by the viewer: positive when the RIGHT side of
# the picture is the higher one (the farther one: the projector stands turned
# to that side).  The vendor's du_r is a yaw of the projector in its OWN frame,
# so it takes the sign of the mount: the model's du_r < 0 pulls in the panel's
# right side.  Where the viewer's right is the panel's right (front, and
# rear-ceiling, which flips the picture twice) that is -turn; where it is the
# panel's left (rear, and ceiling, which turns the unit over) it is +turn.
# MODE_PERM then carries the pulled corners to the viewer's side.  Settled
# against a ray model of the wall in tests/test_turn.py: the corrected picture
# is a rectangle on the wall only with these four signs.
TURN_SIGN = {"front": -1.0, "rear": 1.0, "ceiling": 1.0, "rear-ceiling": -1.0}


def turn_to_du_r(turn, mode):
    """du_r, in degrees, for a turn to the wall in the viewer's words.  An
    unknown mode counts as front here; for_the_mount refuses it."""
    return TURN_SIGN.get(mode, -1.0) * float(turn)


def mount_mode(tool):
    """The projection mode h713-warp reports; front when it says nothing or
    cannot be asked (the older h713-warp has no mode)."""
    try:
        found = re.search(r"^mode\s{2,}(\S+)", warp_call(tool, ["status"]), re.M)
    except Error:
        return "front"
    return found.group(1) if found else "front"


def for_the_mount(tool, permille, mode=None):
    """The eight corner values permuted for the mount h713-warp is set to
    (`mode` when the caller has asked for it already)."""
    mode = mode or mount_mode(tool)
    order = MODE_PERM.get(mode)
    if order is None:
        raise Error("h713-warp reports the mode %s, which this tool does not know" % mode, EXIT_WARP)
    return tuple(permille[2 * c + i] for c in order for i in (0, 1))


def reference_for_mount(tool, reference, note, mode=None):
    """Upside down the vendor refuses a stored pose (its check wants z >= 0),
    and a pose stored upright doubles the sensor's offset once the model has
    negated the angles: a ceiling mount corrects against the ideal."""
    if (mode or mount_mode(tool)) in ("ceiling", "rear-ceiling") and reference is not ak.LEVEL_REFERENCE:
        return ak.LEVEL_REFERENCE, "reference ideal (ceiling mount, the stored pose is upright)"
    return reference, note


def write_last_auto(path, permille):
    """What the automatic applied last, so that status can say whether the
    warp still carries it or a hand has changed it since (the gate)."""
    try:
        os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
        _write_atomic(path, " ".join(str(int(v)) for v in permille) + "\n")
    except OSError as exc:
        _stderr("warning: %s: %s" % (path, exc))


def read_last_auto(path):
    text = _read(path)
    if not text:
        return None
    try:
        values = tuple(int(v) for v in text.split())
    except ValueError:
        return None
    return values if len(values) == len(WARP_SLOTS) else None


def read_turn(path, default):
    """turn_to_wall as the file says it now.  The settings page changes it
    while the unit runs, and a move must be corrected with the value the user
    has set, not with the one the unit started with; what cannot be read or
    parsed leaves the value the unit has."""
    try:
        pairs = _pairs(_read(path))
    except Error:
        return default
    value = default
    for number, key, raw in pairs:
        if key == "turn_to_wall" and raw is not None:   # the last line wins
            try:
                value = parse_turn(raw)
            except ValueError as exc:
                _stderr("warning: %s:%d: turn_to_wall = \"%s\": %s -- kept %g"
                        % (path, number, raw, exc, value))
    return value


def turn_suffix(conf):
    """The words a result line gets while the picture is turned: nothing at
    0, so that the lines of a unit that has never been turned stay as they were."""
    return "  wall turn %+g degrees" % conf["turn_to_wall"] if conf["turn_to_wall"] else ""


def turn_text(turn):
    if not turn:
        return "0 degrees (straight to the wall)"
    return "%g degrees to the %s (the %s side of the picture is the higher one)" % (
        abs(turn), "right" if turn > 0 else "left", "right" if turn > 0 else "left")


def keystone_by(warp_set, last_auto):
    """The gate, as a word: whose values the warp carries."""
    if warp_set is None:
        return "unknown (the warp reports no values)"
    if last_auto is None:
        return "manual (the automatic has never applied anything)"
    if tuple(warp_set) == tuple(last_auto):
        return "auto (the last automatic set, untouched since)"
    return "manual (changed by hand since the last automatic set %s)" % inset_text(last_auto)


def inset_text(permille):
    if permille is None:
        return "no eight values in its status"
    return "tl %d,%d  tr %d,%d  bl %d,%d  br %d,%d" % tuple(permille)


# --- the loop -------------------------------------------------------------

class Hysteresis(object):
    """Apply when the tilt has moved by `degrees` and stayed there for `hold`
    seconds.  The first reading of a run is applied at once: a projector that
    waits a second before it corrects anything looks broken."""

    def __init__(self, degrees, hold):
        self.degrees, self.hold = degrees, hold
        self.applied = None       # the (GsX, GsY) the warp currently carries
        self.since = None         # when the reading first left the band

    def update(self, angles, now):
        if self.applied is None:
            self.applied, self.since = angles, None
            return True
        moved = max(abs(angles[0] - self.applied[0]),
                    abs(angles[1] - self.applied[1]))
        if moved < self.degrees:
            self.since = None
            return False
        if self.since is None:
            self.since = now
        if now - self.since < self.hold:
            return False
        self.applied, self.since = angles, None
        return True


def open_sensor(args, conf, rate=True):
    """`rate` False leaves sampling_frequency alone, which is what a status
    that only reports wants."""
    return Sensor(Sensor.find(conf["iio_name"], args.device),
                  conf["sampling_rate"] if rate else None, args.quiet)


def implausible(raw, sensor):
    """Why an averaged triple is not a pose, or None.  A dead or loose sensor
    reads (0, 0, 0) or no 1 g at all, and nothing else would notice now that
    no reference is asked for (the device reads |g| 1.07 at rest)."""
    g = sum(v * v for v in raw) ** 0.5 / sensor.counts_per_g
    if 0.7 <= g <= 1.3:
        return None
    return "the accelerometer reads |g| = %.2f (raw %.0f %.0f %.0f), not about 1 g" % ((g,) + tuple(raw))


def chain(raw, conf, reference, ini, mode="front"):
    """The whole AP2h chain for one averaged triple.  The turn to the wall
    goes in as du_r, with the sign the mount gives it."""
    row = ak.auto_keystone(model_triple(raw, conf), reference=reference,
                           zoom_scale=conf["zoom_scale"], ini=ini,
                           du_r=turn_to_du_r(conf["turn_to_wall"], mode))
    row["raw"] = raw
    return row


def reading(sensor, conf, reference, ini, mode="front"):
    """One averaged sample through the whole AP2h chain."""
    raw = sensor.sample(conf["average_samples"])
    why = implausible(raw, sensor)
    if why:
        raise Error(why + " -- nothing computed", EXIT_NO_SENSOR)
    return chain(raw, conf, reference, ini, mode)


# --- the commands ---------------------------------------------------------

def do_read(args, conf, ini):
    sensor = open_sensor(args, conf)
    reference, note = load_reference(args.reference, conf, args.quiet)
    reference, note = reference_for_mount(args.warp, reference, note)
    row = reading(sensor, conf, reference, ini)
    g_vector = tuple(v / sensor.counts_per_g for v in row["raw"])
    print("ok read  raw %7.1f %7.1f %7.1f  g %6.3f %6.3f %6.3f  pitch %7.3f  "
          "roll %7.3f  %s" % (row["raw"] + g_vector
                              + (row["gs_y"], row["gs_x"], note)))
    return 0


def do_reference(args, conf, ini):
    raw = open_sensor(args, conf).sample(conf["average_samples"])
    try:
        counts = ak.reference_from_iio(model_triple(raw, conf))
    except ValueError:
        raise Error("this pose is more than 45 degrees off flat (raw %.0f "
                    "%.0f %.0f) -- checkGsensorDataOk refuses it as a "
                    "reference.  Stand the projector level and try again."
                    % raw, EXIT_NOT_LEVEL)
    write_reference(args.reference, counts, raw, conf)
    print("ok reference  raw %.1f %.1f %.1f  counts %d %d %d  -> %s"
          % (raw + tuple(counts) + (args.reference,)))
    # This pose against the ideal.  On a surface a spirit level has passed it
    # is the sensor's mounting offset - the number that decides whether the
    # ideal is good enough as the shipped default (FB-KSREF).
    offset = gsa.get_gsensor_du(counts[0], counts[1], counts[2],
                                list(ak.LEVEL_REFERENCE))
    print("ok offset  pitch %.2f  roll %.2f degrees, this pose against the "
          "ideal (0, 0, 1 g)" % (offset[1], offset[0]))
    return 0


def do_once(args, conf, ini):
    sensor = open_sensor(args, conf)
    reference, note = load_reference(args.reference, conf, args.quiet)
    mode = mount_mode(args.warp)
    reference, note = reference_for_mount(args.warp, reference, note, mode)
    row = reading(sensor, conf, reference, ini, mode)
    print("ok once  pitch %.3f  roll %.3f  %s  %s%s"
          % (row["gs_y"], row["gs_x"], inset_text(row["permille"]), note,
             turn_suffix(conf)))
    if args.apply:
        applied = for_the_mount(args.warp, row["permille"], mode)
        warp_apply(args.warp, applied)
        write_last_auto(args.last_auto, applied)
        print("ok applied through %s" % args.warp)
    return 0


def angle_distance(a, b):
    return max(abs(a[0] - b[0]), abs(a[1] - b[1]))


def stop_code(stopped):
    """The exit code after a signal: SIGTERM is how systemd stops the unit, so
    it is a clean 0 (until 03.10.2026 it was 130 and every `systemctl stop`
    left h713-keystone-auto "failed"); Ctrl-C keeps the shell's 130."""
    if not stopped:
        return 0
    return 130 if signal.SIGINT in stopped else 0


def do_watch(args, conf, ini):
    """The vendor's behaviour, not a control loop: nothing happens while the
    projector stands still, whatever a hand has set. When it is moved by more
    than move_degrees and has then been still for settle_seconds, the
    automatic runs ONCE (after_move = keystone), and the autofocus after it
    (keystone+focus); after_move = off only logs the move. The values a hand
    set are therefore kept until the next move - that is the gate."""
    stopped = []
    for sig in (signal.SIGINT, signal.SIGTERM):
        signal.signal(sig, lambda signum, _: stopped.append(signum))
    sensor = open_sensor(args, conf)
    # A fresh image has no reference file and the unit runs from the first
    # boot; until 26.09.2026 this waited for the file (and until 23.09. it
    # exited, and systemd restarted it every five seconds).  Now it watches
    # against the ideal and the ok line says which reference it has - a
    # refused file included: said once, never an exit.
    reference, note = load_reference(args.reference, conf, args.quiet)
    reference, note = reference_for_mount(args.warp, reference, note)
    rest = None          # the angles the projector rests at
    moving_since = None  # when the move began
    still_since = None   # when the readings became still again
    last = None
    every, how = sensor.cadence(conf["average_samples"], POLL_S)
    print("ok watch  after_move = %s, move %.1f degrees, settle %.1f s within %.1f degrees, a reading every ~%.2f s %s  %s"
          % (conf["after_move"], conf["move_degrees"], conf["settle_seconds"],
             conf["settle_degrees"], every, how, note))
    until = time.monotonic() + args.for_seconds if args.for_seconds else None
    bad = None
    while not stopped and (until is None or time.monotonic() < until):
        # the two angles alone (microseconds); the whole chain, whose search
        # takes seconds near 60 degrees, only when something is applied
        raw = sensor.sample(conf["average_samples"])
        why = implausible(raw, sensor)
        if why or bad:
            if why != bad:
                _stderr("warning: %s -- no move is watched meanwhile" % why if why
                        else "the accelerometer reads 1 g again, watching")
            bad = why
            if why:
                time.sleep(POLL_S)
                continue
        row = dict(zip(("gs_x", "gs_y"), gsa.opt_keystone_angles(
            gsa.iio_to_vendor_counts(*model_triple(raw, conf)), list(reference))))
        angles = (row["gs_x"], row["gs_y"])
        now = time.monotonic()
        if rest is None:
            rest = angles
        elif moving_since is None:
            if angle_distance(angles, rest) > conf["move_degrees"]:
                moving_since = now
                still_since = None
                print("ok moved  pitch %.2f roll %.2f, waiting for it to settle"
                      % (row["gs_y"], row["gs_x"]))
        else:
            if last is not None and angle_distance(angles, last) <= conf["settle_degrees"]:
                still_since = still_since or now
            else:
                still_since = None
            if still_since is not None and now - still_since >= conf["settle_seconds"]:
                rest = angles
                took = now - moving_since
                moving_since = None
                still_since = None
                print("ok settled  after %.1f s" % took)
                if conf["after_move"] == "off":
                    print("ok settled  pitch %.2f roll %.2f, after_move = off: nothing applied"
                          % (row["gs_y"], row["gs_x"]))
                else:
                    # a reference taken since the start (the page's button)
                    # counts from this apply on; the start said a refusal once
                    reference, note = load_reference(args.reference, conf, True)
                    mode = mount_mode(args.warp)
                    reference, note = reference_for_mount(args.warp, reference, note, mode)
                    # the turn as the page has set it since the unit started
                    now_conf = dict(conf, turn_to_wall=read_turn(args.config, conf["turn_to_wall"]))
                    row = chain(raw, now_conf, reference, ini, mode)
                    rest = angles = (row["gs_x"], row["gs_y"])   # re-based on it
                    if not args.dry_run:
                        applied = for_the_mount(args.warp, row["permille"], mode)
                        warp_apply(args.warp, applied)
                        write_last_auto(args.last_auto, applied)
                    print("ok apply  pitch %.3f  roll %.3f  %s%s  %s%s"
                          % (row["gs_y"], row["gs_x"], inset_text(row["permille"]),
                             "  (dry run)" if args.dry_run else "", note,
                             turn_suffix(now_conf)))
                    if conf["after_move"] == "keystone+focus" and not args.dry_run:
                        try:
                            proc = subprocess.run(conf["focus_command"].split(),
                                                  capture_output=True, text=True,
                                                  timeout=120)
                            print("ok focus  %s -> exit %d %s"
                                  % (conf["focus_command"], proc.returncode,
                                     (proc.stdout or proc.stderr).strip().splitlines()[-1:]
                                     and (proc.stdout or proc.stderr).strip().splitlines()[-1]
                                     or ""))
                        except (OSError, subprocess.TimeoutExpired) as exc:
                            _stderr("warning: the focus command failed: %s" % exc)
        last = angles
        deadline = time.monotonic() + POLL_S
        while not stopped and time.monotonic() < deadline:
            time.sleep(0.02)
    return stop_code(stopped)


def do_run(args, conf, ini):
    sensor = open_sensor(args, conf)
    reference, note = load_reference(args.reference, conf, args.quiet)
    mode = mount_mode(args.warp)      # asked once: `run` is for experiments
    reference, note = reference_for_mount(args.warp, reference, note, mode)
    saved = None if args.dry_run else warp_read_set(args.warp)
    if saved is None and not args.dry_run and not args.quiet:
        _stderr("warning: %s ctl status did not report eight values -- there "
                "is nothing to put back at the end" % args.warp)
    stopped = []
    for sig in (signal.SIGINT, signal.SIGTERM):
        signal.signal(sig, lambda signum, _: stopped.append(signum))
    gate = Hysteresis(conf["hysteresis_degrees"], conf["hold_seconds"])
    try:
        while not stopped:
            row = reading(sensor, conf, reference, ini, mode)
            if gate.update((row["gs_x"], row["gs_y"]), time.monotonic()):
                if not args.dry_run:
                    warp_apply(args.warp, for_the_mount(args.warp, row["permille"], mode))
                print("ok apply  pitch %.3f  roll %.3f  %s%s  %s%s"
                      % (row["gs_y"], row["gs_x"], inset_text(row["permille"]),
                         "  (dry run)" if args.dry_run else "", note,
                         turn_suffix(conf)))
            deadline = time.monotonic() + POLL_S
            while not stopped and time.monotonic() < deadline:
                time.sleep(0.02)
    finally:
        if saved is not None:
            try:
                warp_apply(args.warp, saved)
                print("ok stopped  the manual set %s is back"
                      % inset_text(saved))
            except Error as exc:
                _stderr("the manual set could not be put back: %s" % exc)
    return stop_code(stopped)


def _sensor_text(sensor, conf):
    return "%s \"%s\", %g Hz, %d samples averaged, %.0f counts per g" % (
        sensor.path, sensor.name, sensor.rate, conf["average_samples"],
        sensor.counts_per_g)


def _reference_text(path, conf):
    """`ideal ...`, `file (date): path, counts X Y Z` or `refused (why)` -
    the settings page reads the first word."""
    try:
        found = read_reference_file(path, conf)
    except Error as exc:
        return "refused (%s)" % exc
    if found is None:
        return IDEAL_TEXT
    return "file (%s): %s, counts %d %d %d" % ((found[1], path) + found[0])


def do_status(args, conf, ini):
    """A status is a report, not a probe: what cannot be read is said and not
    raised, and sampling_frequency is left as the device has it."""
    print("ok status")
    print("config          %s%s"
          % (conf["_path"], "" if _read(conf["_path"]) is not None
             else " (missing, the defaults apply)"))
    print("                "
          + ", ".join("%s = %s" % (name, conf["_text"][name])
                      for name, _, _ in DEFAULTS))
    print("optics          throw ratio %.4f (%s), zoom_scale %d -> target "
          "width %d" % (implied_ratio(ini),
                        "camprjspe.ini" if conf["throw_ratio"] is None
                        else "measured, from the configuration",
                        conf["zoom_scale"], ZOOM_WIDTH[conf["zoom_scale"]]))
    print("wall turn       %s" % turn_text(conf["turn_to_wall"]))
    print("loop            %.2f degrees held for %.2f s, poll %.2f s"
          % (conf["hysteresis_degrees"], conf["hold_seconds"], POLL_S))
    print("after a move    %s (more than %.1f degrees, then %.1f s still)"
          % (conf["after_move"], conf["move_degrees"], conf["settle_seconds"]))
    for label, call in (
            ("sensor", lambda: _sensor_text(open_sensor(args, conf, False),
                                            conf)),
            ("reference", lambda: _reference_text(args.reference, conf)),
            ("warp", lambda: inset_text(warp_read_set(args.warp))),
            ("keystone by", lambda: keystone_by(warp_read_set(args.warp),
                                                 read_last_auto(args.last_auto)))):
        try:
            print("%-16s%s" % (label, call()))
        except Error as exc:
            print("%-16s%s" % (label, exc))
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="h713-keystone",
        description="the projector's auto keystone: accelerometer, the "
                    "vendor's geometry, h713-warp.",
        epilog="The automatic corrects against the ideal level pose until "
               "`reference`, taken on a level surface, has stored a better "
               "one; look at it with `read` and `once`; `watch` runs the "
               "automatic once after every move, as the vendor does, and "
               "`once --apply` runs it now.")
    parser.add_argument("-C", "--config", default=CONF_PATH, metavar="PATH")
    parser.add_argument("--reference", default=REF_PATH, metavar="PATH")
    parser.add_argument("--device", metavar="PATH",
                        help="this IIO device instead of the one whose name "
                             "is iio_name")
    parser.add_argument("--warp", default=WARP_TOOL, metavar="PATH")
    parser.add_argument("--last-auto", default=LAST_AUTO_PATH, metavar="PATH",
                        help="where the automatic notes what it applied last")
    parser.add_argument("-q", "--quiet", action="store_true",
                        help="no warnings, only the ok and error lines")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("read", help="one reading: raw, g vector, pitch and roll")
    sub.add_parser("reference", help="store this pose as the level reference "
                                     "(optional; it refines the ideal)")
    once = sub.add_parser("once", help="the eight insets for the current tilt")
    once.add_argument("--apply", action="store_true",
                      help="push them through `h713-warp ctl keystone set`")
    run = sub.add_parser("run", help="the control loop (not the vendor's way; "
                                     "see watch), until SIGTERM")
    run.add_argument("--dry-run", action="store_true",
                     help="compute and log, never touch the warp")
    watch = sub.add_parser("watch", help="the vendor's way: after a move, once "
                                         "(after_move in the configuration)")
    watch.add_argument("--dry-run", action="store_true",
                       help="log what would be applied, never touch the warp")
    watch.add_argument("--for", dest="for_seconds", type=float, default=None,
                       metavar="SECONDS", help="stop after SECONDS (a try, the tests)")
    sub.add_parser("status", help="configuration, sensor, reference, warp")
    args = parser.parse_args(argv)
    # getattr: under a test that captures stdout it is not a real stream.
    getattr(sys.stdout, "reconfigure", lambda **_: None)(line_buffering=True)
    conf = load_conf(args.config)
    return {"read": do_read, "reference": do_reference, "once": do_once,
            "run": do_run, "watch": do_watch, "status": do_status}[args.command](
                args, conf, optics(conf))


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Error as exc:
        _stderr("h713-keystone: %s" % exc)
        sys.exit(exc.code)
    except PermissionError as exc:
        _stderr("h713-keystone: %s\n/etc/h713 and the IIO node belong to root."
                % exc)
        sys.exit(EXIT_ERROR)
    except KeyboardInterrupt:
        sys.exit(130)
