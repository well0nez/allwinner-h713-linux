CONF_PATH, REF_PATH = "/etc/h713/keystone.conf", "/etc/h713/keystone-ref"
# What the automatic corrects against while there is no reference file: the
# ideal level pose ak.LEVEL_REFERENCE, said in the words of every result line.
IDEAL_TEXT = "ideal (0, 0, 1 g) - h713-keystone reference refines it"
REFUSED_TEXT = "refused - ideal (0, 0, 1 g) applies, h713-keystone status says why"
LAST_AUTO_PATH = "/var/lib/h713-keystone/last-auto"   # the set the automatic last applied
# $H713_SYS replaces /sys, $H713_DEV /dev (the tests run the not-present path end to end)
SYS = os.environ.get("H713_SYS", "/sys")
IIO_DIR = SYS + "/bus/iio/devices"
DEV_DIR = os.environ.get("H713_DEV", "/dev")
CONFIGFS = SYS + "/kernel/config"
WARP_TOOL, G_M_S2 = "h713-warp", 9.80665
FALLBACK_COUNTS_PER_G = 1000.0    # measured: in_accel_x_scale 0.009806 m/s2
EXIT_ERROR, EXIT_NO_SENSOR, EXIT_NOT_LEVEL, EXIT_WARP = 2, 3, 4, 5
# No accelerometer on this board at all (boards/README.md, FEATURES): the
# same 7 as h713-autofocus, h713-focus and h713-cam, and no failure for the
# unit (h713-keystone-auto.service, SuccessExitStatus=7).
EXIT_NOT_PRESENT = 7
EXIT_CONFIG = EXIT_ERROR        # a configuration value out of its choices (the docs: 2)
AXES = {"x": 0, "y": 1, "z": 2}
ZOOM_WIDTH = {0: 1920, 1: 1728, 2: 1440}          # AP2c 3, the aspect selector
TURN_LIMIT = 30.0     # degrees to either side; the vendor chain is sound to 45, the picture is a third smaller by 30
# The IIO buffer.  A sysfs read of in_accel_*_raw makes st_accel switch the
# sensor on, wait for it to boot (bootime/odr) and switch it off again: about
# 60 ms a value on the HY310, 1.8 s for the thirty values of one averaged
# reading (19.10.2026).  With the buffer enabled the sensor stays on for the
# burst and a timer trigger, made here through configfs, delivers a triple
# every 1/rate seconds.  The sensor has no interrupt line to clock it.
TRIGGER = "h713-keystone"      # the name of our hrtimer trigger
SETTLE_SAMPLES = 3             # triples thrown away after the switch-on, they are not a pose yet
BUFFER_TRIPLES = 32            # what the kernel keeps for us between two reads
BUSY_WAIT_S = 3.0              # another reader has the node: wait for its burst this long
BURST_MARGIN_S = 1.0           # a burst gets this much more than its samples need
BURST_SETUP_S = 0.03           # what switching the buffer on and off costs, for the start line of watch
SYSFS_VALUE_S = 0.06           # one sysfs value, measured: 1.8 s for thirty
SCAN_TYPE = re.compile(r"(le|be):([su])(\d+)/(\d+)(?:X\d+)?>>(\d+)$")   # le:s12/16>>4
# The loop's own pause.  One averaged reading already costs about 0.3 s at
# 100 Hz, so this is a floor and not the sampling rate.
POLL_S = 0.1
# The eight insets in the APP order of AP2h (LT.x LT.y RT.x RT.y LB.x LB.y
# RB.x RB.y) against the words h713-warp takes (KS4): `ctl keystone set CORNER
# AXIS VALUE`, CORNER in tl tr bl br, AXIS in x y, per-mille inward.
WARP_SLOTS = (("tl", "x"), ("tl", "y"), ("tr", "x"), ("tr", "y"),
              ("bl", "x"), ("bl", "y"), ("br", "x"), ("br", "y"))
# Tolerant on purpose: the daemon is being written in parallel, so any of
# "tl_x = 12", "tl x 12" or "tl-x: 12" in its status counts as that value.
WARP_VALUE = re.compile(r"\b(tl|tr|bl|br)[ _-]?([xy])\b\s*[=:]?\s*(-?\d+)")
# What the daemon really prints (KS4): "keystone  tl 1,0 tr 0,0 bl 0,0 br 0,0".
WARP_PAIR = re.compile(r"\b(tl|tr|bl|br)\s+(-?\d+),(-?\d+)")


class Error(Exception):
    """Something is wrong: message out, this exit code, drive nothing."""

    def __init__(self, message, code=EXIT_ERROR):
        Exception.__init__(self, message)
        self.code = code


class BufferUnavailable(Exception):
    """The IIO buffer cannot deliver (this time): the reader says why and takes sysfs."""


def _stderr(line):
    print(line, file=sys.stderr)


def _read(path):
    """One file as text, or None when it is not there."""
    try:
        with open(path, "rb") as fh:
            return fh.read().decode("ascii", "replace").strip()
    except FileNotFoundError:
        return None
    except (OSError, IOError) as exc:   # there, but not readable: say so, do not fall back
        raise Error("%s: %s" % (path, exc.strerror or exc))


def _write_atomic(path, text):
    """Sibling, fsync, rename: after a power cut the old file or the new one
    stands there, never half a line."""
    with open(path + ".new", "wb") as fh:
        fh.write(text.encode("utf-8"))
        fh.flush()
        os.fsync(fh.fileno())
    os.replace(path + ".new", path)


def _pairs(text):
    """The (line number, key, value) triples of a "key = value" file; value is
    None where a line carries no "=" at all.  Comments and blanks drop out."""
    out = []
    for number, line in enumerate((text or "").splitlines(), 1):
        line = line.split("#", 1)[0].strip()
        if line:
            key, sign, value = [p.strip() for p in line.partition("=")]
            out.append((number, key, value if sign else None))
    return out


# --- configuration --------------------------------------------------------

def parse_axis(text):
    """"+y", "-x", "z": which raw axis, with which sign, plays a role."""
    t = text.strip().lower()
    sign = -1 if t[:1] == "-" else 1
    t = t[1:] if t[:1] in "+-" else t
    if t not in AXES:
        raise ValueError("expected +x -x +y -y +z or -z")
    return (AXES[t], sign)


def axis_text(pair):
    return ("+" if pair[1] > 0 else "-") + "xyz"[pair[0]]


def parse_throw(text):
    """A measured throw ratio, or "ini" for the vendor optics untouched."""
    if text.strip().lower() == "ini":
        return None
    if not 0.1 <= float(text) <= 10.0:
        raise ValueError("a small positive number, or \"ini\"")
    return float(text)


def parse_zoom(text):
    if int(text) not in ZOOM_WIDTH:
        raise ValueError("0, 1 or 2 (target width 1920, 1728, 1440)")
    return int(text)


def parse_turn(text):
    """The turn to the wall in degrees: positive when the RIGHT side of the
    picture is the higher one, negative for the left, as the viewer sees it."""
    value = float(text)
    if not -TURN_LIMIT <= value <= TURN_LIMIT:
        raise ValueError("degrees from -%g to %g" % (TURN_LIMIT, TURN_LIMIT))
    return value


def _one_of(*choices):
    def parse(text):
        if text not in choices:
            raise Error("one of %s" % " ".join(choices), EXIT_CONFIG)
        return text
    return parse


def _above_zero(cast, what):
    def parse(text):
        value = cast(text)
        if value <= 0:
            raise ValueError(what)
        return value
    return parse


DEFAULTS = (
    ("iio_name", "sc7a20", str),
    ("axis_pitch", "+y", parse_axis),
    ("axis_roll", "-x", parse_axis),
    ("axis_vertical", "+z", parse_axis),
    ("throw_ratio", "ini", parse_throw),
    ("zoom_scale", "0", parse_zoom),
