#!/usr/bin/env python3
"""h713-cam -- talk to the internal camera of the projector.

Realtek 0bda:5803 "Generic HD camera", UVC, on USB port 1. One format:
YUYV 4:2:2, 640x480. Stock uses it for the autofocus (doku/94).

    h713-cam probe                 driver, formats, frame sizes
    h713-cam controls              every control with range and current value
    h713-cam get NAME|ID           read one control
    h713-cam set NAME|ID VALUE     write one control
    h713-cam grab [FILE]           one still image (PNG, or PPM by extension)

Runs with a bare python3 -- no v4l2-ctl, no ffmpeg, no PIL. That is on purpose:
the release rootfs carries none of them (packages.txt), and a tool that fails on
a missing package never shows a picture.

Merged on 12.09.2026 out of analyse/beamer-cam/{camprobe,camset,camgrab}.py.
The device node is searched for, not guessed: /dev/video2 is it only because
Cedrus and the HDMI receiver were loaded before it.

Quirk of the camera, measured 11.09.: freshly loaded it delivers BLACK (Y about
5), even after 90 discarded frames -- until any control has been written once.
After that the automatic exposure runs by itself (Y about 187). That is why
'grab' writes the exposure back unchanged once before it streams.
"""

from __future__ import annotations

import argparse
import fcntl
import glob
import mmap
import os
import struct
import sys
import time
import zlib

# --- V4L2 -----------------------------------------------------------------
VIDIOC_QUERYCAP        = 0x80685600
VIDIOC_ENUM_FMT        = 0xc0405602
VIDIOC_S_FMT           = 0xc0d05605
VIDIOC_REQBUFS         = 0xc0145608
VIDIOC_QUERYBUF        = 0xc0585609
VIDIOC_QBUF            = 0xc058560f
VIDIOC_DQBUF           = 0xc0585611
VIDIOC_STREAMON        = 0x40045612
VIDIOC_STREAMOFF       = 0x40045613
VIDIOC_G_CTRL          = 0xc008561b
VIDIOC_S_CTRL          = 0xc008561c
VIDIOC_QUERYCTRL       = 0xc0445624
VIDIOC_ENUM_FRAMESIZES = 0xc02c564a

BUF_TYPE_CAPTURE = 1
MEMORY_MMAP      = 1
FMT_YUYV         = 0x56595559          # 'YUYV'
CID_EXPOSURE_ABS = 0x009a0902
CTRL_FLAG_DISABLED = 0x0001

#: How the camera is recognized -- the name uvcvideo takes over from the USB
#: descriptor. Not the number of the node.
CAMERA_NAME = "HD camera"


class Error(Exception):
    pass


def fourcc(v: int) -> str:
    return "".join(chr((v >> (8 * i)) & 0xff) for i in range(4))


def cstr(b: bytes) -> str:
    return bytes(b).split(b"\0")[0].decode("utf-8", "replace")


# --- find the device ------------------------------------------------------

def find_camera(given: str | None) -> str:
    if given:
        return given
    hits = []
    for path in sorted(glob.glob("/sys/class/video4linux/video*/name")):
        try:
            name = open(path).read().strip()
        except OSError:
            continue
        if CAMERA_NAME not in name:
            continue
        dev = "/dev/" + path.split("/")[-2]
        # uvcvideo creates two nodes: the picture and the metadata. Only the
        # one with VIDEO_CAPTURE is the right one; the other has the same name.
        try:
            fd = os.open(dev, os.O_RDWR | os.O_NONBLOCK)
        except OSError:
            continue
        try:
            buf = bytearray(104)
            fcntl.ioctl(fd, VIDIOC_QUERYCAP, buf, True)
            dcaps = struct.unpack_from("<I", buf, 88)[0]
            if dcaps & 0x1:
                hits.append(dev)
        except OSError:
            pass
        finally:
            os.close(fd)
    if not hits:
        raise Error(
            f"no camera with '{CAMERA_NAME}' in its name under /sys/class/video4linux/.\n"
            "  Is uvcvideo loaded? (lsmod | grep uvcvideo; without the module: modprobe uvcvideo)\n"
            "  Is it on the bus?   (lsusb | grep 0bda:5803)")
    return hits[0]


# --- controls -------------------------------------------------------------

def list_controls(fd: int) -> list[dict]:
    """VIDIOC_QUERYCTRL over the user and camera classes."""
    out = []
    for base, n in ((0x00980900, 64), (0x009a0900, 32)):
        for cid in range(base, base + n):
            q = bytearray(68)
            struct.pack_into("<I", q, 0, cid)
            try:
                fcntl.ioctl(fd, VIDIOC_QUERYCTRL, q, True)
            except OSError:
                continue
            kind, = struct.unpack_from("<I", q, 4)
            name = cstr(q[8:40])
            lo, hi, step, default = struct.unpack_from("<iiii", q, 40)
            flags, = struct.unpack_from("<I", q, 56)
            if flags & CTRL_FLAG_DISABLED:
                continue
            out.append(dict(id=cid, kind=kind, name=name, min=lo, max=hi,
                            step=step, default=default, flags=flags))
    return out


def find_control(fd: int, what: str) -> int:
    """'0x009a0902', '10094594' or a name ('Exposure Time, Absolute',
    abbreviated as well: 'exposure', 'brightness')."""
    try:
        return int(what, 0)
    except ValueError:
        pass
    wanted = what.lower().replace("_", " ")
    candidates = [s for s in list_controls(fd) if wanted in s["name"].lower()]
    if len(candidates) == 1:
        return candidates[0]["id"]
    if not candidates:
        raise Error(f"no control matches '{what}' -- 'h713-cam controls' shows them all")
    names = ", ".join(repr(k["name"]) for k in candidates)
    raise Error(f"'{what}' is not unambiguous: {names}")


def read_control(fd: int, cid: int) -> int:
    b = bytearray(8)
    struct.pack_into("<Ii", b, 0, cid, 0)
    fcntl.ioctl(fd, VIDIOC_G_CTRL, b, True)
    return struct.unpack_from("<Ii", b, 0)[1]


def write_control(fd: int, cid: int, value: int) -> None:
    b = bytearray(8)
    struct.pack_into("<Ii", b, 0, cid, value)
    fcntl.ioctl(fd, VIDIOC_S_CTRL, b, True)


# --- grab a frame ---------------------------------------------------------

def grab_frame(fd: int, width: int, height: int, warmup: int, report) -> tuple[bytes, int, int, int]:
    """One YUYV frame over MMAP streaming. Returns (raw data, W, H, bytesperline)."""
    # The quirk: write the exposure back unchanged once before the stream.
    try:
        write_control(fd, CID_EXPOSURE_ABS, read_control(fd, CID_EXPOSURE_ABS))
    except OSError:
        pass                    # another camera without that control: never mind

    f = bytearray(208)
    struct.pack_into("<I", f, 0, BUF_TYPE_CAPTURE)
    struct.pack_into("<IIII", f, 8, width, height, FMT_YUYV, 1)
    fcntl.ioctl(fd, VIDIOC_S_FMT, f, True)
    width, height, pf = struct.unpack_from("<III", f, 8)
    bpl, size = struct.unpack_from("<II", f, 24)
    if pf != FMT_YUYV:
        raise Error(f"the camera delivers {fourcc(pf)}, this tool can only do YUYV")
    report(f"format {width}x{height} {fourcc(pf)}, {bpl} byte per line")

    r = bytearray(20)
    struct.pack_into("<III", r, 0, 4, BUF_TYPE_CAPTURE, MEMORY_MMAP)
    fcntl.ioctl(fd, VIDIOC_REQBUFS, r, True)
    n_buffers, = struct.unpack_from("<I", r, 0)

    maps = []
    for i in range(n_buffers):
        b = bytearray(88)
        struct.pack_into("<III", b, 0, i, BUF_TYPE_CAPTURE, 0)
        struct.pack_into("<I", b, 60, MEMORY_MMAP)
        fcntl.ioctl(fd, VIDIOC_QUERYBUF, b, True)
        offset, = struct.unpack_from("<I", b, 64)
        length, = struct.unpack_from("<I", b, 72)
        maps.append(mmap.mmap(fd, length, mmap.MAP_SHARED,
                              mmap.PROT_READ | mmap.PROT_WRITE, offset=offset))
        fcntl.ioctl(fd, VIDIOC_QBUF, b, True)

    fcntl.ioctl(fd, VIDIOC_STREAMON, struct.pack("<I", BUF_TYPE_CAPTURE))
    frame = None
    try:
        for n in range(warmup + 1):
            b = bytearray(88)
            struct.pack_into("<II", b, 0, 0, BUF_TYPE_CAPTURE)
            struct.pack_into("<I", b, 60, MEMORY_MMAP)
            for _ in range(200):
                try:
                    fcntl.ioctl(fd, VIDIOC_DQBUF, b, True)
                    break
                except OSError as e:
                    if e.errno != 11:           # EAGAIN
                        raise
                    time.sleep(0.01)
            else:
                raise Error("timeout while waiting for a frame")
            idx, = struct.unpack_from("<I", b, 0)
            used, = struct.unpack_from("<I", b, 8)
            if n == warmup:
                frame = bytes(maps[idx][:used or size])
            fcntl.ioctl(fd, VIDIOC_QBUF, b, True)
    finally:
        fcntl.ioctl(fd, VIDIOC_STREAMOFF, struct.pack("<I", BUF_TYPE_CAPTURE))
        for k in maps:
            k.close()
    return frame, width, height, bpl


def yuyv_to_rgb(frame: bytes, width: int, height: int, bpl: int) -> bytes:
    """BT.601, limited range -- the way the camera delivers it."""
    def clamp(v):
        return 0 if v < 0 else (255 if v > 255 else v)
    out = bytearray()
    for y in range(height):
        line = frame[y * bpl: y * bpl + width * 2]
        for x in range(0, len(line) - 3, 4):
            y0, u, y1, v = line[x], line[x + 1], line[x + 2], line[x + 3]
            cu, cv = u - 128, v - 128
            for yy in (y0, y1):
                c = yy - 16
                out += bytes((clamp((298 * c + 409 * cv + 128) >> 8),
                              clamp((298 * c - 100 * cu - 208 * cv + 128) >> 8),
                              clamp((298 * c + 516 * cu + 128) >> 8)))
    return bytes(out)


def write_png(path: str, rgb: bytes, width: int, height: int) -> None:
    """PNG without PIL: zlib from the standard library is enough."""
    def chunk(kind: bytes, data: bytes) -> bytes:
        return (struct.pack(">I", len(data)) + kind + data
                + struct.pack(">I", zlib.crc32(kind + data) & 0xffffffff))
    raw = b"".join(b"\0" + rgb[z * width * 3:(z + 1) * width * 3] for z in range(height))
    with open(path, "wb") as fh:
        fh.write(b"\x89PNG\r\n\x1a\n")
        fh.write(chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0)))
        fh.write(chunk(b"IDAT", zlib.compress(raw, 6)))
        fh.write(chunk(b"IEND", b""))


def write_ppm(path: str, rgb: bytes, width: int, height: int) -> None:
    with open(path, "wb") as fh:
        fh.write(b"P6\n%d %d\n255\n" % (width, height))
        fh.write(rgb)


# --- subcommands ----------------------------------------------------------

def cmd_probe(fd: int, dev: str) -> int:
    buf = bytearray(104)
    fcntl.ioctl(fd, VIDIOC_QUERYCAP, buf, True)
    version, caps, dcaps = struct.unpack_from("<III", buf, 80)
    print(f"Device   {dev}")
    print(f"Driver   {cstr(buf[0:16])}   Card: {cstr(buf[16:48])}   Bus: {cstr(buf[48:80])}")
    print(f"Version  {version >> 16}.{(version >> 8) & 0xff}.{version & 0xff}   "
          f"Caps 0x{dcaps:08x} (Capture {bool(dcaps & 0x1)}, Streaming {bool(dcaps & 0x04000000)})")
    print("Formats:")
    for i in range(32):
        f = bytearray(64)
        struct.pack_into("<II", f, 0, i, BUF_TYPE_CAPTURE)
        try:
            fcntl.ioctl(fd, VIDIOC_ENUM_FMT, f, True)
        except OSError:
            break
        pf, = struct.unpack_from("<I", f, 44)
        sizes = []
        for j in range(24):
            s = bytearray(44)
            struct.pack_into("<II", s, 0, j, pf)
            try:
                fcntl.ioctl(fd, VIDIOC_ENUM_FRAMESIZES, s, True)
            except OSError:
                break
            kind, = struct.unpack_from("<I", s, 8)
            if kind == 1:
                w, h = struct.unpack_from("<II", s, 12)
                sizes.append(f"{w}x{h}")
            else:
                w0, h0, w1, h1 = struct.unpack_from("<IIII", s, 12)
                sizes.append(f"{w0}x{h0}..{w1}x{h1}")
                break
        print(f"  {fourcc(pf):<6} {cstr(f[12:44]):<24} {', '.join(sizes)}")
    return 0


def cmd_controls(fd: int) -> int:
    for s in list_controls(fd):
        try:
            now = str(read_control(fd, s["id"]))
        except OSError as e:
            now = f"({e.strerror})"
        print(f"0x{s['id']:08x}  {s['name']:<32} {s['min']:>6}..{s['max']:<6} "
              f"step {s['step']:<4} default {s['default']:<6} is {now}")
    return 0


def cmd_get(fd: int, what: str) -> int:
    cid = find_control(fd, what)
    print(f"0x{cid:08x} = {read_control(fd, cid)}")
    return 0


def cmd_set(fd: int, what: str, value: int) -> int:
    cid = find_control(fd, what)
    try:
        write_control(fd, cid, value)
    except OSError as e:
        raise Error(f"0x{cid:08x} := {value}: {e.strerror} -- 'controls' shows the allowed range")
    print(f"0x{cid:08x} = {read_control(fd, cid)}")
    return 0


def cmd_grab(fd: int, path: str, size: str, warmup: int, quiet: bool) -> int:
    report = (lambda *_: None) if quiet else (lambda *a: print(*a, file=sys.stderr))
    try:
        w, h = (int(x) for x in size.lower().split("x"))
    except ValueError:
        raise Error(f"--size expects WxH, not '{size}'")
    frame, w, h, bpl = grab_frame(fd, w, h, warmup, report)
    mean_y = sum(frame[0::2]) / (len(frame) / 2)
    report(f"{warmup} frames discarded, mean brightness Y = {mean_y:.1f}"
           + ("  -- BLACK: has the camera seen no control yet?" if mean_y < 16 else ""))
    rgb = yuyv_to_rgb(frame, w, h, bpl)
    if path.lower().endswith(".ppm"):
        write_ppm(path, rgb, w, h)
    else:
        write_png(path, rgb, w, h)
    print(f"{path}  {w}x{h}  Y={mean_y:.0f}")
    return 0


def main(argv=None) -> int:
    p = argparse.ArgumentParser(prog="h713-cam",
                                description="Talk to the internal camera of the projector.")
    p.add_argument("--dev", metavar="NODE",
                   help=f"give the device node instead of searching for '{CAMERA_NAME}'")
    u = p.add_subparsers(dest="command", required=True)
    u.add_parser("probe", help="driver, formats, frame sizes")
    u.add_parser("controls", help="every control with range and current value")
    g = u.add_parser("get", help="read one control"); g.add_argument("control")
    s = u.add_parser("set", help="write one control")
    s.add_argument("control"); s.add_argument("value", type=lambda x: int(x, 0))
    r = u.add_parser("grab", help="grab one still image (PNG; .ppm by extension)")
    r.add_argument("file", nargs="?", default="/data/cam.png")
    r.add_argument("--size", default="640x480", metavar="WxH")
    r.add_argument("--warm", type=int, default=10, metavar="N",
                   help="discard frames until the exposure has settled (default 10)")
    r.add_argument("-q", "--quiet", action="store_true")
    a = p.parse_args(argv)

    dev = find_camera(a.dev)
    fd = os.open(dev, os.O_RDWR)
    try:
        if a.command == "probe":
            return cmd_probe(fd, dev)
        if a.command == "controls":
            return cmd_controls(fd)
        if a.command == "get":
            return cmd_get(fd, a.control)
        if a.command == "set":
            return cmd_set(fd, a.control, a.value)
        return cmd_grab(fd, a.file, a.size, a.warm, a.quiet)
    finally:
        os.close(fd)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Error as e:
        print(f"h713-cam: {e}", file=sys.stderr)
        sys.exit(2)
    except PermissionError as e:
        print(f"h713-cam: {e} -- the node belongs to root:video", file=sys.stderr)
        sys.exit(2)
    except KeyboardInterrupt:
        sys.exit(130)
