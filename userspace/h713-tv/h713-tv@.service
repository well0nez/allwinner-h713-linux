#
# Template-Unit: eine Instanz je Aufnahmegeraet, Instanzname = Kernelname des
# Geraets (h713-tv@video1.service fuer /dev/video1). Gestartet wird sie von
# der udev-Regel 99-h713-tv.rules (SYSTEMD_WANTS+="h713-tv@%k.service"),
# sobald der HDMI-Empfaenger sein /dev/videoN anlegt -- nicht von
# multi-user.target. Grund: der Probe von sun50i-h713-hdmirx laeuft asynchron
# und haelt allein fuer die EDID/HPD-Sequenz ueber zehn Sekunden an; ein Start
# "beim Booten" waere ein Wettlauf, den man nur mit einer Warteschleife
# gewinnt, und die soll es hier nicht geben. Deshalb hat die Unit auch keinen
# [Install]-Abschnitt: `systemctl enable` ist nicht der Weg, die udev-Regel
# ist es.
[Unit]
Description=HY310: HDMI-Eingang (%I) auf der Video-Plane
Documentation=file:/usr/local/share/doc/h713-tv/README.md

# Die Unit haengt am Geraet in beide Richtungen: BindsTo stoppt sie, sobald
# dev-videoN.device verschwindet (Treiber entladen oder unbind), statt sie
# gegen ein fehlendes Geraet in die Neustartgrenze laufen zu lassen; kommt
# das Geraet wieder, startet udev sie neu. After sorgt dafuer, dass der Start
# nicht vor dem Geraet eingereiht wird.
BindsTo=dev-%i.device
After=dev-%i.device

# Nach drei Fehlstarts in einer Minute bleibt die Unit im Zustand "failed"
# stehen, statt endlos zu starten. Was fehlgeschlagen ist, steht dann im
# Journal -- das ist die Absicht.
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=exec
ExecStart=/usr/local/sbin/h713-tv -d /dev/%I
Restart=on-failure
RestartSec=5s

# Der Steuerkanal (h713-tv ctl ...) liegt unter /run/h713-tv/ctl; das
# Verzeichnis legt systemd an und raeumt es beim Stopp weg. Es gibt nur einen
# HDMI-Empfaenger, also nur eine Instanz; eine zweite scheiterte an der
# Sperre /run/h713-tv/lock, bevor sie das Geraet anfasst.
RuntimeDirectory=h713-tv
RuntimeDirectoryMode=0755

# Der zuletzt per `h713-tv ctl auto|off` gesetzte Modus liegt in
# /var/lib/h713-tv/modus (Konfiguration dazu: /etc/h713/tv.conf, Schluessel
# start und zustand). StateDirectory legt das Verzeichnis an und macht genau
# dieses eine unter ProtectSystem=strict beschreibbar; ohne die Zeile bliebe
# der Modus stumm ungemerkt. Geschrieben wird nur, wenn sich der Modus aendert.
StateDirectory=h713-tv
StateDirectoryMode=0755

# SIGTERM ist der regulaere Weg hinaus: das Programm schaltet die Plane ab
# und gibt die Konsole zurueck, bevor es endet. `systemctl stop` laesst also
# kein Standbild auf der Wand stehen. SIGHUP bewertet den Zustand neu
# (`systemctl reload`), ohne die Plane anzufassen.
KillSignal=SIGTERM
TimeoutStopSec=10s
ExecReload=/bin/kill -HUP $MAINPID

# Das Programm braucht DRM-Master, das Aufnahmegeraet, /dev/tty0 und
# /sys/class/graphics/fb0/blank (Konsole entblanken) und -- fuer
# "h713-tv ctl rpc" -- den debugfs-Knoten von cpu_comm. ProtectSystem=strict
# laesst /dev, /proc und /sys beschreibbar, alles andere ist nur lesbar;
# ProtectKernelTunables darf deshalb NICHT dazu (es wuerde /sys sperren).
# Keine neuen Privilegien.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes
