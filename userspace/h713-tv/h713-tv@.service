#
# Template unit: one instance per capture device, the instance name being the
# kernel name of the device (h713-tv@video1.service for /dev/video1). It is
# started by the udev rule 99-h713-tv.rules (SYSTEMD_WANTS+="h713-tv@%k.service")
# as soon as the HDMI receiver creates its /dev/videoN -- not by
# multi-user.target. The reason: the probe of sun50i-h713-hdmirx runs
# asynchronously and takes over ten seconds for the EDID/HPD sequence alone; a
# start "at boot" would be a race that can only be won with a wait loop, and
# there is not going to be one here. That is also why the unit has no
# [Install] section: `systemctl enable` is not the way, the udev rule is.
[Unit]
Description=HY310: HDMI input (%I) on the video plane
Documentation=file:/usr/local/share/doc/h713-tv/README.md

# The unit hangs on the device in both directions: BindsTo stops it as soon as
# dev-videoN.device goes away (driver unloaded or unbound), instead of letting
# it run into the restart limit against a missing device; when the device
# comes back, udev starts it again. After makes sure the start is not queued
# ahead of the device.
BindsTo=dev-%i.device
After=dev-%i.device

# After three failed starts within a minute the unit stays in the "failed"
# state instead of starting for ever. What failed is then in the journal --
# that is the intention.
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=exec
ExecStart=/usr/local/sbin/h713-tv -d /dev/%I
Restart=on-failure
RestartSec=5s

# The control channel (h713-tv ctl ...) lives under /run/h713-tv/ctl; systemd
# creates the directory and clears it away on stop. There is only one HDMI
# receiver, so only one instance; a second one failed on the lock
# /run/h713-tv/lock before it touched the device.
RuntimeDirectory=h713-tv
RuntimeDirectoryMode=0755

# The mode last set with `h713-tv ctl auto|off` lives in
# /var/lib/h713-tv/modus (its configuration: /etc/h713/tv.conf, keys start and
# zustand). StateDirectory creates the directory and makes exactly this one
# writable under ProtectSystem=strict; without the line the mode would
# silently not be kept. It is written only when the mode changes.
StateDirectory=h713-tv
StateDirectoryMode=0755

# SIGTERM is the regular way out: the program switches the plane off and hands
# the console back before it ends. So `systemctl stop` leaves no still frame
# standing on the wall. SIGHUP evaluates the state again (`systemctl reload`)
# without touching the plane.
KillSignal=SIGTERM
TimeoutStopSec=10s
ExecReload=/bin/kill -HUP $MAINPID

# The program needs DRM master, the capture device, /dev/tty0 and
# /sys/class/graphics/fb0/blank (to unblank the console) and -- for
# "h713-tv ctl rpc" -- the debugfs node of cpu_comm. ProtectSystem=strict
# leaves /dev, /proc and /sys writable and everything else read-only;
# ProtectKernelTunables must therefore NOT be added (it would lock /sys away).
# No new privileges.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes
