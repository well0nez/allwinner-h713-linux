#!/usr/bin/env python3
"""h713-remote-pair - pair the projector's stock Bluetooth remote through bluez.

The stock remote is a BLE HID device (HID over GATT, service 0x1812) that advertises
under several names. Hold LEFT + RIGHT to pair (the stock remote of the HY310 and the
HY300PRO-G-EU, the same remote); other remotes may use a different combination. Stock Android scans for its name
whenever no remote is connected and bonds without a dialog (FB-REMOTE). This does the
same with bluez: bluetoothctl (bluez's D-Bus client) runs with a NoInputNoOutput agent,
the remote is bonded, trusted and connected, and from then on bluez reconnects it.
A remote keeps one bond: paired with another box since, it has lost the key this box keeps, and
Left + Right here gave a connection that fails while bluez kept the stale bond. watch therefore also
listens to the HCI monitor channel (as btmon does, no scanning of its own): a bonded remote that
advertises in pairing mode (LE Limited Discoverable) asks for a new bond, so the old one is forgotten
and the remote paired afresh.
Commands: pair [--timeout 60], reconnect [--timeout 30], status, forget [ADDR],
watch (reconnect a known remote; pair when none is bonded or when the bonded one is in pairing mode).
Exit: 0 done, 1 no remote seen, 2 bluez refused, 3 usage or no bluetoothctl.
"""

import argparse
import ctypes
import os
import queue
import re
import shlex
import socket
import struct
import subprocess
import sys
import threading
import time

#: The names stock accepts (product/etc/bt_list.ini, ASCII part) - substring match.
NAMES = ("BLE_X_RMC", "Great Wall", "RGE_A_CE1504", "Bt_Remote", "Bluetooth remote", "blueRemote", "JVIN")
HOG_UUID = "00001812-0000-1000-8000-00805f9b34fb"
EXIT_OK, EXIT_NOT_FOUND, EXIT_REFUSED, EXIT_USAGE = 0, 1, 2, 3
ANSI = re.compile(r"\x1b\[[0-9;]*[A-Za-z]|[\x01\x02]")
#: Advertising data flag of a remote in pairing mode: the stock remote sends ADV_IND with flags 0x05
#: (LE Limited Discoverable, no BR/EDR) only after Left + Right (btmon, 20.10.2026); a bonded remote wakes
#: with a directed advert, which carries no flags.
LIMITED_DISCOVERABLE = 0x01
MONITOR_HEADER = struct.Struct("<HHH")      # opcode, controller index, length (the HCI monitor channel)
MONITOR_EVENT = 3                           # an HCI event from the controller
#: Pairing adverts until this many seconds after a pairing of our own are the ones that led to it.
OFFER_GRACE = 5.0
DEVICE_LINE = re.compile(r"(?:\[NEW\] )?Device ([0-9A-Fa-f]{2}(?::[0-9A-Fa-f]{2}){5}) (?:Name: )?(.+)$")


def clean(line: str) -> str:
    return ANSI.sub("", line).strip()


def name_matches(name: str, names) -> bool:
    return any(n in name for n in names)


class ControllerUnavailable(RuntimeError):
    pass


class Ctl:
    """One bluetoothctl process: commands in, cleaned lines out through a queue."""

    def __init__(self, command: str):
        self.p = subprocess.Popen(shlex.split(command) + ["--agent", "NoInputNoOutput"], stdin=subprocess.PIPE,
                                  stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
        self.q: "queue.Queue[str]" = queue.Queue()
        threading.Thread(target=self._pump, daemon=True).start()

    def _pump(self):
        for raw in self.p.stdout:
            for piece in raw.split("\r"):       # the prompt is redrawn with CR
                if clean(piece):
                    self.q.put(clean(piece))
        self.q.put("")                          # end marker

    def send(self, *cmds: str):
        for cmd in cmds:
            self.p.stdin.write(cmd + "\n")
        self.p.stdin.flush()

    def lines(self, timeout: float, stop=None):     # the lines of the next timeout seconds, or until stop is set
        end = time.monotonic() + timeout
        while end > time.monotonic() and not (stop and stop.is_set()):
            try:
                line = self.q.get(timeout=min(end - time.monotonic(), 0.2) if stop else end - time.monotonic())
            except queue.Empty:
                continue
            if line == "":
                return
            yield line

    def wait(self, ok: str, bad: str, timeout: float, stop=None):   # (True|False, line) or (None, "")
        for line in self.lines(timeout, stop):
            if re.search(ok, line):
                return True, line
            if re.search(bad, line):
                return False, line
        return None, ""

    def close(self):
        try:
            self.send("quit")
            self.p.wait(timeout=5)
        except (OSError, ValueError, subprocess.TimeoutExpired):
            self.p.kill()


def pairing_adverts(event: bytes):
    """Addresses of the connectable undirected adverts with the LE Limited Discoverable flag in one HCI
    event (LE Advertising Report and LE Extended Advertising Report). bluez's AdvertisingFlags property
    cannot tell: it keeps the flags of the last pairing (05 on a remote that is bonded and connected)."""
    if len(event) < 4 or event[0] != 0x3E or event[2] not in (0x02, 0x0D):
        return
    extended, pos = event[2] == 0x0D, 4
    head = 24 if extended else 9                        # a report's fields up to its data length
    for _ in range(event[3]):
        if pos + head > len(event) or pos + head + event[pos + head - 1] > len(event):
            return
        if extended:                                    # connectable, not directed, not a scan response
            undirected = (struct.unpack_from("<H", event, pos)[0] & 0x0D) == 0x01
            addr = event[pos + 3:pos + 9]
        else:
            undirected = event[pos] == 0x00             # ADV_IND
            addr = event[pos + 2:pos + 8]
        data = event[pos + head:pos + head + event[pos + head - 1]]
        pos += head + len(data) + (0 if extended else 1)    # legacy: the RSSI follows the data
        flags = ad_field(data, 0x01)
        if undirected and flags and flags[0] & LIMITED_DISCOVERABLE:
            yield ":".join("%02X" % b for b in reversed(addr))


def ad_field(data: bytes, kind: int) -> bytes:
    pos = 0
    while pos + 1 < len(data) and data[pos]:
        if data[pos + 1] == kind:
            return data[pos + 2:pos + 1 + data[pos]]
        pos += data[pos] + 1
    return b""


def monitor_frames(source: str):
    """(opcode, payload) of the kernel's HCI monitor channel, or of a file of such frames (tests)."""
    if source:
        with open(source, "rb") as f:
            while True:
                head = f.read(MONITOR_HEADER.size)
                if len(head) < MONITOR_HEADER.size:
                    return
                op, _, size = MONITOR_HEADER.unpack(head)
                yield op, f.read(size)
    sock = socket.socket(socket.AF_BLUETOOTH, socket.SOCK_RAW, socket.BTPROTO_HCI)
    # Python's bind() knows no HCI channel: sockaddr_hci {family, HCI_DEV_NONE, HCI_CHANNEL_MONITOR}
    addr = struct.pack("<HHH", socket.AF_BLUETOOTH, 0xFFFF, 2)
    libc = ctypes.CDLL(None, use_errno=True)
    if libc.bind(sock.fileno(), addr, len(addr)) != 0:
        err = ctypes.get_errno()
        sock.close()
        raise OSError(err, os.strerror(err))
    with sock:
        while True:
            frame = sock.recv(65536)
            if len(frame) < MONITOR_HEADER.size:
                continue
            op, _, size = MONITOR_HEADER.unpack_from(frame)
            yield op, frame[MONITOR_HEADER.size:MONITOR_HEADER.size + size]


class PairingOffers:
    """Pairing adverts per address, read in a thread. A bonded remote is connected by the kernel as soon
    as it advertises; with a stale bond that connection fails and bluez keeps the bond without a word on
    D-Bus, so the advert is the one sign that the remote asks for a new bond. event wakes watch."""

    def __init__(self, source: str):
        self.seen, self.quiet, self.watched = {}, 0.0, set()
        self.lock, self.event = threading.Lock(), threading.Event()
        threading.Thread(target=self._read, args=(source,), daemon=True).start()

    def _read(self, source: str):
        try:
            for op, payload in monitor_frames(source):
                for addr in pairing_adverts(payload) if op == MONITOR_EVENT else ():
                    with self.lock:
                        self.seen[addr] = time.monotonic()
                        if addr in self.watched:
                            self.event.set()
        except (OSError, AttributeError) as e:
            print("note: no HCI monitor channel (%s): Left + Right cannot replace a stale bond, "
                  "use h713-remote-pair forget" % e, file=sys.stderr)

    def asking(self, addrs):       # the first of addrs that advertised in pairing mode since our last pairing
        with self.lock:
            self.watched = set(addrs)
            return next((a for a in self.watched if self.seen.get(a, 0.0) > self.quiet), None)

    def paired(self):              # the adverts until now and a little after led to this pairing
        with self.lock:
            self.quiet = time.monotonic() + OFFER_GRACE


def device_info(ctl: Ctl, addr: str):
    """Only use fields belonging to the requested info block, not other events."""
    ctl.send("info " + addr)
    block, active, connected = [], False, False
    for line in ctl.lines(1.5):
        change = re.search(r"\[CHG\] Device ([0-9A-Fa-f:]{17}) Connected: (yes|no)$", line)
        if change and change.group(1).upper() == addr.upper():
            connected = change.group(2) == "yes"
            continue
        header = re.fullmatch(r"Device ([0-9A-Fa-f:]{17})(?: .*|$)", line)
        if header:
            active = header.group(1).upper() == addr.upper()
        elif active and not line.startswith(("[", "Controller ")):
            block.append(line)
            if line in ("Connected: yes", "Connected: no"):
                connected = line == "Connected: yes"
    return {"hog": any(line.startswith("UUID:") and HOG_UUID in line for line in block),
            "connected": connected, "name": next((line[6:] for line in block if line.startswith("Name: ")), "")}


def known_remotes(ctl: Ctl, names):     # {addr: name} of the objects bluez already keeps with a stock name
    ctl.send("devices", "show")
    out = {}
    for line in ctl.lines(5):
        m = DEVICE_LINE.search(line)
        if m and line.startswith("Device ") and name_matches(m.group(2), names):
            out[m.group(1).upper()] = m.group(2).strip()
        if line.startswith(("Controller ", "No default controller")):
            break
    return out


def scan_for(ctl: Ctl, names, timeout: float, addr=None):
    """LE scan for HoG advertisers until a name matches, or until the remote addr shows -> (addr, name) or None.
    A remote whose bluez object already exists shows in a scan only as "[CHG] ... RSSI" lines, never "[NEW]"
    or its name: the kernel's last connect to a stale bond makes it again after the forget, and bluez keeps
    an unpaired object while the remote advertises (HY300PRO-G-EU 20.10.2026: 40 s in pairing mode, four
    scans missed it). So the remote that asked is followed by its address, and known objects by theirs."""
    ctl.send("power on")
    done, line = ctl.wait(r"Changing power on succeeded|Powered: yes", r"No default controller", 5)
    if done is False and "No default controller" in line:
        print("error: no Bluetooth controller -- is h713-bluetooth.service up (hciattach on UART1)?", file=sys.stderr)
        return None
    known = {} if addr else known_remotes(ctl, names)
    ctl.send("scan le")
    for line in ctl.lines(timeout):
        m = DEVICE_LINE.search(line)
        if not m:
            continue
        seen = m.group(1).upper()
        name = m.group(2).strip() if not addr and name_matches(m.group(2).strip(), names) else known.pop(seen, None)
        if (seen != addr) if addr else name is None:
            continue
        info = device_info(ctl, seen)
        if info["hog"]:
            ctl.send("scan off")
            return seen, name or info["name"]
    ctl.send("scan off")


def pair(ctl: Ctl, addr: str, timeout: float) -> int:
    steps = (("pair", r"Pairing successful|Already paired", r"Failed to pair|Authentication(Failed|Canceled)", timeout),
             ("trust", r"trust succeeded|Trusted: yes", r"Failed to set trust", 10),
             ("connect", r"Connection successful", r"Failed to connect", timeout))
    for verb, ok, bad, t in steps:
        ctl.send(verb + " " + addr)
        done, line = ctl.wait(ok, bad, t)
        if not done:
            print("error: %s %s: %s" % (verb, addr, line or "no answer"), file=sys.stderr)
            return EXIT_REFUSED
    return EXIT_OK


def bonded(ctl: Ctl, names):                     # [(addr, name, connected)] of the bonded remotes
    ctl.send("devices Paired", "show")          # "show" prints a line that ends the listing
    out = []
    for line in ctl.lines(5):
        if "No default controller" in line:
            raise ControllerUnavailable("no Bluetooth controller -- start h713-bluetooth.service before using the remote")
        m = DEVICE_LINE.search(line)
        if m and name_matches(m.group(2), names):
            out.append([m.group(1).upper(), m.group(2).strip(), False])
        if line.startswith(("Controller ", "No default controller")):
            break
    for dev in out:
        info = device_info(ctl, dev[0])
        dev[2] = info["connected"]
        dev.append(info["hog"])
    return [tuple(d[:3]) for d in out if d[3]]


def run_pair(ctl: Ctl, names, timeout: float, addr=None) -> int:
    found = scan_for(ctl, names, timeout, addr)
    if found is None:
        print("no remote in pairing mode within %ds (hold LEFT + RIGHT on the stock remote)" % timeout)
        return EXIT_NOT_FOUND
    print("found %s %s" % found)
    rc = pair(ctl, found[0], timeout)
    if rc == EXIT_OK:
        print("ok paired %s %s (trusted, bluez reconnects it)" % found)
    return rc


def cmd_status(ctl: Ctl, a) -> int:
    devs = bonded(ctl, a.name)
    for addr, name, connected in devs:
        print("%s %s %s" % (addr, name, "connected" if connected else "bonded, not connected"))
    print("" if devs else "no remote bonded", end="" if devs else "\n")
    return EXIT_OK if devs else EXIT_NOT_FOUND


def forget(ctl: Ctl, addr: str) -> int:
    ctl.send("remove " + addr)
    ok, line = ctl.wait(r"Device has been removed", r"not available|Failed to remove", 10)
    if not ok:
        print("error: forget %s: %s" % (addr, line or "no answer"), file=sys.stderr)
        return EXIT_REFUSED
    print("ok forgot " + addr)
    return EXIT_OK


def cmd_forget(ctl: Ctl, a) -> int:
    addrs = [a.addr] if a.addr else [d[0] for d in bonded(ctl, a.name)]
    for addr in addrs:
        if forget(ctl, addr) != EXIT_OK:
            return EXIT_REFUSED
    return EXIT_OK if addrs else EXIT_NOT_FOUND


def reconnect(ctl: Ctl, addr: str, timeout: float, stop=None) -> int:
    deadline = time.monotonic() + timeout
    line = "no answer"
    while time.monotonic() < deadline:
        ctl.send("connect " + addr)
        done, line = ctl.wait(r"Connection successful", r"Failed to connect|not available",
                              max(0, deadline - time.monotonic()), stop)
        if stop and stop.is_set():
            return EXIT_REFUSED
        info = device_info(ctl, addr)
        if info["hog"] and info["connected"]:
            print("ok connected " + addr)
            return EXIT_OK
        # BlueZ can abort an attempt before the user wakes a sleeping remote.
        # Retry only these temporary failures, never erase or re-pair the bond.
        if done is None or not any(reason in (line or "") for reason in
                                   ("le-connection-abort-by-local", "InProgress", "AlreadyConnected")):
            break
        time.sleep(min(2, max(0, deadline - time.monotonic())))
    print("error: reconnect %s: %s; wake the remote with one key, without pairing mode" %
          (addr, line or "no answer"), file=sys.stderr)
    return EXIT_REFUSED


def cmd_reconnect(ctl: Ctl, a) -> int:
    devs = bonded(ctl, a.name)
    if not devs:
        print("no remote bonded; use pair for first-time setup")
        return EXIT_NOT_FOUND
    if any(connected for _, _, connected in devs):
        print("ok remote already connected")
        return EXIT_OK
    return reconnect(ctl, devs[0][0], a.timeout)


def cmd_watch(ctl: Ctl, a) -> int:
    offers = PairingOffers(a.monitor)
    devs = []
    while True:
        offers.event.clear()
        # The bonded remotes of the last round first: until the bond is gone the kernel keeps connecting the
        # remote with the stale key, and a round of bluetoothctl costs 1.5 s - on the G-EU the remote once
        # ended its pairing mode 0.3 s after a forget that came 1.5 s late (20.10.2026).
        stale = offers.asking(d[0] for d in devs)
        rc = EXIT_OK
        if not stale:
            devs = bonded(ctl, a.name)
            if not devs:
                rc = run_pair(ctl, a.name, a.timeout)
                offers.paired()
            elif not offers.asking(d[0] for d in devs) and not any(connected for _, _, connected in devs):
                rc = reconnect(ctl, devs[0][0], a.timeout, offers.event)
            stale = devs and offers.asking(d[0] for d in devs)
        if stale:
            print("%s asks to be paired (Left + Right) while bonded here: forgetting the old bond, "
                  "pairing afresh" % stale)
            rc = forget(ctl, stale)
            if rc == EXIT_OK:
                rc = run_pair(ctl, a.name, a.timeout, stale)
            offers.paired()
            devs = []
        if a.once:
            return rc
        offers.event.wait(a.interval)


def main(argv=None) -> int:
    # Under systemd stdout is a pipe and Python buffers it in blocks: "found" and "ok paired" of the
    # unit's watch reached the journal late or never, only stderr did (11.10., G-EU). One line, one record.
    sys.stdout.reconfigure(line_buffering=True)
    p = argparse.ArgumentParser(prog="h713-remote-pair", description=__doc__.split("\n\n")[1])
    p.add_argument("--ctl", default=os.environ.get("H713_BLUETOOTHCTL", "bluetoothctl"),
                   help="the bluetoothctl command (env H713_BLUETOOTHCTL)")
    p.add_argument("--name", action="append", help="accepted name (substring), repeatable; default: the stock list")
    sub = p.add_subparsers(dest="command", required=True)
    s = sub.add_parser("pair", help="scan for a remote in pairing mode, bond, trust, connect")
    s.add_argument("--timeout", type=int, default=60, help="seconds to wait for the remote (60)")
    s = sub.add_parser("reconnect", help="connect a known remote without re-pairing or forgetting")
    s.add_argument("--timeout", type=int, default=30)
    sub.add_parser("status", help="bonded remotes and whether they are connected")
    sub.add_parser("forget", help="remove the bond of ADDR, or of every bonded remote").add_argument("addr", nargs="?")
    s = sub.add_parser("watch", help="reconnect a bonded remote; pair only if none is known")
    s.add_argument("--interval", type=float, default=3.0)
    s.add_argument("--timeout", type=int, default=20)
    s.add_argument("--once", action="store_true", help="one round, then exit")
    s.add_argument("--monitor", default=os.environ.get("H713_HCI_MONITOR", ""),
                   help="read HCI monitor frames from this file instead of the kernel (tests; env H713_HCI_MONITOR)")
    a = p.parse_args(argv)
    a.name = tuple(a.name) if a.name else NAMES
    try:
        ctl = Ctl(a.ctl)
    except OSError as e:
        print("error: cannot run %s: %s" % (a.ctl, e), file=sys.stderr)
        return EXIT_USAGE
    try:
        if a.command == "pair":
            return run_pair(ctl, a.name, a.timeout)
        return {"status": cmd_status, "forget": cmd_forget, "watch": cmd_watch, "reconnect": cmd_reconnect}[a.command](ctl, a)
    except ControllerUnavailable as e:
        print("error: " + str(e), file=sys.stderr)
        return EXIT_REFUSED
    finally:
        ctl.close()


if __name__ == "__main__":
    sys.exit(main())
