# --- the metric -----------------------------------------------------------

def _strip(p, w, y, x0, x1, s):
    """The vendor's per-pixel sum over one row (detect_yuvY_buffer_Auto).

    Two 3-tap gradients, each halved, cubed and shifted right by two --
    separately, which is not the same as cubing, adding and shifting once.
    The vendor's "/ 3" is (21846 * v) >> 16, exactly v // 3 for every sum a
    byte triple can make, so this is the arithmetic and not an estimate of it.
    """
    n = x1 - x0 + 1
    if n < 1:
        return 0
    ra, rb, rc = (y - 1) * w + x0, y * w + x0, (y + 1) * w + x0
    total = 0
    for a_i, a_1, b_m, b_i, b_1, c_m, c_i, c_1 in zip(
            p[ra:ra + n:s], p[ra + 1:ra + n + 1:s],
            p[rb - 1:rb + n - 1:s], p[rb:rb + n:s], p[rb + 1:rb + n + 1:s],
            p[rc - 1:rc + n - 1:s], p[rc:rc + n:s], p[rc + 1:rc + n + 1:s]):
        dx = abs(((b_m + b_i) >> 1) - (a_1 + b_1 + c_1) // 3) >> 1
        dy = abs(((a_i + b_i) >> 1) - (c_m + c_i + c_1) // 3) >> 1
        total += ((dx * dx * dx) >> 2) + ((dy * dy * dy) >> 2)
    return total


def sharpness_sum(frame, window="full", stride=1, w=FRAME_W):
    """The raw, un-normalised sum over one of the four windows."""
    y0, y1, x0, x1 = WINDOWS[window]
    return sum(_strip(frame, w, y, x0, x1, stride)
               for y in range(y0, y1 + 1, stride))


def pick_divisor(total):
    """The divisor the first measurement of a run fixes (AP1 2.7)."""
    return 10 if total < 12001 else total // ((total & 0xFB) + 5012)


class Metric:
    """The metric plus the divisor it keeps for the length of one run."""

    def __init__(self, window="full", stride=1, sums=None):
        self.window, self.stride, self.lev = window, stride, 0
        self.sums = sums or sharpness_sum

    def __call__(self, frame):
        total = self.sums(frame, self.window, self.stride)
        if not self.lev:
            self.lev = pick_divisor(total)
        return total // self.lev

    def close(self):
        if hasattr(self.sums, "close"):
            self.sums.close()


HELPER = "h713-afmetric"


def find_helper(given=None):
    """The C metric: the given path, one beside this file, or one on PATH."""
    here = os.path.join(os.path.dirname(os.path.abspath(__file__)), HELPER)
    for path in [given] if given else [here, shutil.which(HELPER)]:
        if path and os.access(path, os.X_OK):
            return path
    if given:
        raise Error("%s: not an executable" % given)
    return None


class Helper:
    """The C metric as ONE long-lived process: a frame in, its raw sum out.

    One process per run, not per frame: a fork and an exec per frame would
    cost more than the metric they save. `yuyv` feeds the camera's buffer in
    unchanged and lets C read the even bytes (Q11 3).
    """

    def __init__(self, path, window, stride, yuyv=False):
        self.path = path
        self.proc = subprocess.Popen(
            [path, "--window", window, "--stride", str(stride)]
            + (["--yuyv"] if yuyv else []),
            stdin=subprocess.PIPE, stdout=subprocess.PIPE)

    def __call__(self, frame, window=None, stride=None):
        try:
            self.proc.stdin.write(frame)
            self.proc.stdin.flush()
            line = self.proc.stdout.readline()
        except (OSError, ValueError) as exc:
            raise Error("%s stopped answering: %s" % (self.path, exc))
        if not line.strip():
            raise Error("%s gave no sum (exit %s) -- try --no-helper"
                        % (self.path, self.proc.poll()))
        return int(line)

    def close(self):
        try:
            self.proc.stdin.close()
            self.proc.wait(timeout=2)
        except (OSError, ValueError, subprocess.TimeoutExpired):
            self.proc.kill()
        finally:
            self.proc.stdout.close()


def picture_present(frame):
    """The vendor's "is there a picture at all" gate (AP1 2.7, cha_sum).

    Squared differences of neighbouring bytes over frame[6402 .. 281599], each
    shifted right by two, divided by 100; below 100 the run gives up. Only the
    scalar tail of the vendor's NEON loop was reconstructed, so this is the
    same quantity computed plainly: it tells black from not-black, no finer.
    """
    a, b = 6402, min(281600, len(frame))
    return sum(((x - y) * (x - y)) >> 2
               for x, y in zip(frame[a:b], frame[a - 1:b - 1])) // 100


# --- the motor ------------------------------------------------------------

State = namedtuple("State", "step edge_up edge_dn in_range num raw act")
DRIVER = "hy310-focus-motor"
ATTR_CTRL, ATTR_LIMIT, ATTR_NO_LIMIT = ("motor_ctrl", "motor_limit",
                                        "motor_ctrl_no_limit")


class Motor:
    """What the search may ask of a motor, real or replayed."""

    direction = moved = reversals = 0

    def state(self):
        raise NotImplementedError

    def blocked(self, st):
        """None = the motor may be driven at all, else the reason it may not.

        Direction-independent. A latched edge is deliberately NOT a reason
        here: it is a reason to turn round, not to give up (`loop`).
        """
        return None

    @staticmethod
    def edge_ahead(st, up):
        """Is the edge that this direction would run into latched?"""
        return st.edge_up if up else st.edge_dn

    def guard(self, st, up):
        """Everything that stops a move in this direction -- pre-flight."""
        return self.blocked(st) or (
            "edge_%s=1 -- that edge is latched and every command towards it "
            "is dropped" % ("up" if up else "dn")
            if self.edge_ahead(st, up) else None)

    def flush(self):
        pass

    def change_direct(self):
        self.direction ^= 1
        self.flush()

    def loop(self, steps):
        """One watched move in the current search direction.

        Port of the vendor's motor_ctrl_loop (0x00030144 in libduRYXtp.so,
        AP1c excerpts/lib-edge-path.c section 4): when the edge in the
        direction of travel is latched, flip the direction and write the same
        number of steps the other way, in the same call. An edge does not end
        a vendor run -- vafo10_HY260, the HY310's own search, never even
        reads the two flags. What ends a run is the peak, the budget or the
        clock.

        Ours adds two limits the vendor does not have: both edges latched at
        once, and EDGE_REVERSE_CAP turn-arounds in one run. Without them a
        flat or black picture could bounce between the two stops until the
        budget runs out.
        """
        up = self.direction == 0
        state = self.state()                # the guard's read-back is also
        reason = self.blocked(state)        # the move's "before": one read
        if reason:
            raise Edge(reason)
        if self.edge_ahead(state, up):
            if self.edge_ahead(state, not up):
                raise Edge("both edges are latched at once -- the range "
                           "watcher has nothing left to give")
            self.reversals += 1
            if self.reversals > EDGE_REVERSE_CAP:
                raise Edge("turned round at an edge more than %d times in "
                           "one run" % EDGE_REVERSE_CAP)
            self.direction ^= 1
            up = not up
        if self.moved + steps > RUN_MSTEP_CAP:
            raise Edge("the hard cap of %d msteps per run" % RUN_MSTEP_CAP)
        self.moved += steps
        self._move(min(steps, MSTEPS_PER_COMMAND_MAX), up, state)


def find_base(given):
    """The motor node, found the way h713-focus finds it: over the driver."""
    given = given or os.environ.get("H713_FOCUS_SYSFS")
    if given:
        if not os.path.exists(os.path.join(given, ATTR_LIMIT)):
            raise Error("%s: no %s there" % (given, ATTR_LIMIT))
        return given
    root = os.path.join(SYS, "bus/platform/drivers", DRIVER)
    for entry in sorted(os.listdir(root)) if os.path.isdir(root) else []:
        target = os.path.realpath(os.path.join(root, entry))
        if os.path.exists(os.path.join(target, ATTR_LIMIT)):
            return target
    for found in sorted(glob.glob(os.path.join(SYS, "devices/platform/*", ATTR_LIMIT))):
        return os.path.dirname(found)
    raise NotPresent("focus motor: not present on this board - no %s node "
                     "(h713-features says whether the board should have one, "
                     "`h713-focus status` says more)" % ATTR_LIMIT)


class SysfsMotor(Motor):
    """The real motor: our own motor_limit is read, stock commands written."""

    def __init__(self, base):
        self.base = base

    def _read(self, attr):
        with open(os.path.join(self.base, attr), "rb") as fh:
            return fh.read().decode("ascii", "replace").strip()

    def _command(self, word):
        with open(os.path.join(self.base, ATTR_CTRL), "wb") as fh:
            fh.write(str(word).encode("ascii"))

    def state(self):
        """motor_limit as patch 0154 prints it: in_range plus named fields."""
        parts = self._read(ATTR_LIMIT).split()
        fields = {}
        for token in parts[1:]:
            key, sep, value = token.partition("=")
            if sep and value.lstrip("-").isdigit():
                fields[key] = int(value)
        missing = [k for k in ("num", "act", "edge_up", "edge_dn", "step")
                   if k not in fields]
        if missing:
            raise Error("motor_limit without %s -- a driver older than patch "
                        "0154. Read: %r" % (", ".join(missing), parts))
        return State(fields["step"], bool(fields["edge_up"]),
                     bool(fields["edge_dn"]), bool(int(parts[0])),
                     fields["num"], fields.get("raw"), fields["act"])

    def no_limit(self):
        try:
            return int(self._read(ATTR_NO_LIMIT))
        except (OSError, ValueError):
            return 0

    def blocked(self, st):
        if st.num < 1:
            return ("num=0 -- no range watcher requested, so the driver says "
                    "'in range' for ever and never reverses at an edge")
        if self.no_limit():
            return "%s=1 -- the range check is off, set it to 0 first" \
                % ATTR_NO_LIMIT
        if st.raw is None or st.raw < 0:
            return ("motor_limit gives no usable raw level -- a driver older "
                    "than patch 0154, or the level could not be read")
        if st.raw != st.act:
            return ("raw=%d, act=%d -- the mechanism stands outside its range; "
                    "the driver walks it back in at boot (homing): reboot, or "
                    "'modprobe -r hy310_focus_motor && modprobe hy310_focus_motor'"
                    % (st.raw, st.act))
        if not st.in_range:
            return "motor_limit says 'outside' while the level fits -- look"
        return None

    def _move(self, steps, up, before=None):
        before = self.state() if before is None else before
        self._command(((CMD_UP if up else CMD_DOWN) << 8) | (steps & 0x7F))
        target = before.step + (steps if up else -steps)
        deadline = time.monotonic() + (steps + 45) * 0.024 + 0.3
        time.sleep(max(steps * MSTEP_S - POLL_S, 0))    # the move's own time
        while time.monotonic() < deadline:
            now = self.state()
            if (now.edge_up and not before.edge_up) or \
                    (now.edge_dn and not before.edge_dn):
                # The driver has already handled it: reversed back into the
                # range, added back_step and latched the flag
                # (motor_run_up_control 0xc05d6ea0, patch 0111). What is left
                # of this command will be refused mstep by mstep, so the
                # counter never reaches the target -- stop waiting for it.
                # The next loop() turns the search round, as stock does.
                return
            if now.step == target:
                return
            time.sleep(POLL_S)

    def flush(self):
        try:
            self._command(CMD_FLUSH << 8)
        except OSError:
            pass


def _focus_tool():
    """h713-focus as a module, for its experimental counted range (focus.conf):
    beside this file on the board, beside its directory in the repository."""
    here = os.path.dirname(os.path.realpath(__file__))
    for path in (os.path.join(here, "h713-focus"),
                 os.path.join(here, "..", "h713-focus", "h713-focus")):
        if os.path.exists(path):
            import importlib.machinery
            import importlib.util
            loader = importlib.machinery.SourceFileLoader("h713_focus_tool", path)
            module = importlib.util.module_from_spec(
                importlib.util.spec_from_loader("h713_focus_tool", loader))
            loader.exec_module(module)
            return module
    return None


class SoftMotor(SysfsMotor):
    """A unit whose end switch says nothing (h713-focus, "the experimental
    mode"; the L018 of 25.10.2026): the switch is ignored, the counted range of
    focus.conf takes its place, its ends are the edges the search turns at, and
    the position h713-focus keeps is kept on after every move."""

    def __init__(self, base, tool, soft):
        SysfsMotor.__init__(self, base)
        self.tool, self.soft = tool, soft
        if not self.no_limit():
            self._write_no_limit()

    def _write_no_limit(self):
        with open(os.path.join(self.base, ATTR_NO_LIMIT), "wb") as fh:
            fh.write(b"1")

    def position(self, st):
        return self.tool.load_position(st)

    def blocked(self, st):
        if self.position(st) is None:
            return ("no focus position kept (%s) - 'h713-focus home' sets it "
                    "against the upper stop first" % self.tool.FOCUS_STATE)
        return None

    def edge_ahead(self, st, up):
        pos = self.position(st)
        if pos is None:
            return True
        return pos >= self.soft.high if up else pos <= self.soft.low

    def _move(self, steps, up, before=None):
        before = self.state() if before is None else before
        pos = self.position(before)
        room = (self.soft.high - pos) if up else (pos - self.soft.low)
        steps = min(steps, max(room, 0))
        if steps <= 0:
            return
        self._command(((CMD_UP if up else CMD_DOWN) << 8) | (steps & 0x7F))
        target = before.step + (steps if up else -steps)
        deadline = time.monotonic() + (steps + 5) * 0.03 + 0.3
        time.sleep(max(steps * MSTEP_S - POLL_S, 0))
        now = before
        while time.monotonic() < deadline:
            now = self.state()
            if now.step == target:
                break
            time.sleep(POLL_S)
        self.tool.save_position(pos + now.step - before.step, now)


class ReplayMotor(Motor):
    """A motor made of recorded frames: the position indexes the directory."""

    def __init__(self, frames, start=None, direction=0):
        self.frames, self.direction = frames, direction
        steps = [s for s, _ in frames]
        if start is None:
            start = steps[len(steps) // 10]
        self.index = min(range(len(steps)), key=lambda i: abs(steps[i] - start))
        self.edge_up = self.edge_dn = False

    def state(self):
        return State(self.frames[self.index][0], self.edge_up, self.edge_dn,
                     True, 1, 1, 1)

    def _move(self, steps, up, before=None):
        new = self.index + (steps if up else -steps)
        if new >= len(self.frames):
            new, self.edge_up = len(self.frames) - 1, True
        elif new < 0:
            new, self.edge_dn = 0, True
        if new != self.index:       # the driver clears the OTHER edge on the
            if up:                  # first mstep the other way -- stock
                self.edge_dn = False        # motor_run_up_control 0xc05d6ea0
            else:                           # ends with g_motor_edge_Dn = 0,
                self.edge_up = False        # ours in patch 0009 line 269
        self.index = new

    def grab(self):
        with open(self.frames[self.index][1], "rb") as fh:
            return fh.read()


def step_of(name):
    """The step counter in a frame's file name, or None.

    The last run of digits before the extension, with a leading minus only
    when a letter or digit does not come first -- so "step-0012.gray" is 12
    and "step_-0012.gray" and "-0012.gray" are -12. The counter really does
    go negative on this motor, which is why the rule needs saying at all.
    """
    stem = os.path.basename(name).split(".")[0]
    digits = ""
    for i in range(len(stem) - 1, -1, -1):
        if stem[i].isdigit():
            digits = stem[i] + digits
        elif digits:
            if stem[i] == "-" and (i == 0 or not stem[i - 1].isalnum()):
                digits = "-" + digits
            break
    return int(digits) if digits else None


def read_frames(directory):
    """Recorded luma frames, ordered by the step number in the file name."""
    found = [(step_of(path), path)
             for path in sorted(glob.glob(os.path.join(directory, "*")))
             if step_of(path) is not None]
    if not found:
        raise Error("%s holds no file whose name carries a step number "
                    "(expected one raw 640x480 luma frame per position)"
                    % directory)
    return sorted(found)


# --- the camera -----------------------------------------------------------

VIDIOC_QUERYCAP, VIDIOC_S_FMT, VIDIOC_REQBUFS = (0x80685600, 0xC0D05605,
                                                 0xC0145608)
VIDIOC_QUERYBUF, VIDIOC_QBUF, VIDIOC_DQBUF = 0xC0585609, 0xC058560F, 0xC0585611
VIDIOC_STREAMON, VIDIOC_STREAMOFF, VIDIOC_S_CTRL = (0x40045612, 0x40045613,
                                                    0xC008561C)
BUF_TYPE_CAPTURE, MEMORY_MMAP, FMT_YUYV = 1, 1, 0x56595559
CID_EXPOSURE_AUTO, CID_EXPOSURE_ABS = 0x009A0901, 0x009A0902
# the name uvcvideo takes over from the USB descriptor: the HY310's Realtek "Generic HD camera", the L018's "HYSD-VAF02-ZH04"
CAMERA_NAMES = ("HD camera", "HYSD-VAF02")
CAMERA_SAID = " or ".join("'%s'" % n for n in CAMERA_NAMES)


def _is_capture(node):
    """uvcvideo makes two nodes with one name; only one of them captures."""
    try:
        fd = os.open(node, os.O_RDWR | os.O_NONBLOCK)
    except OSError:
        return False
    try:
        buf = bytearray(104)
        fcntl.ioctl(fd, VIDIOC_QUERYCAP, buf, True)
        return bool(struct.unpack_from("<I", buf, 88)[0] & 0x1)
    except OSError:
        return False
    finally:
        os.close(fd)


def find_camera(given, ids):
    """h713-cam's search: the node whose name uvcvideo took from the device.

    The vendor instead reads idProduct/idVendor of the USB port behind the
    node and matches the ini's pair (get_vafocus_cam_id, AP1 4). That is the
    stricter route and it is not built here: these boards carry one camera,
    and the pair is in the profile, so it can be added without moving code.
    """
    if given:
        return given
    named = False
    for path in sorted(glob.glob(os.path.join(SYS, "class/video4linux/video*/name"))):
        node = "/dev/" + path.split("/")[-2]
        try:
            with open(path, "rb") as fh:
                name = fh.read().decode("utf-8", "replace")
        except OSError:
            continue
        ours = any(n in name for n in CAMERA_NAMES)
        named = named or ours
        if ours and _is_capture(node):
            return node
    if not named:
        raise NotPresent("camera: not present on this board - no video4linux "
                         "device named %s (h713-features says whether the "
                         "board should have one)" % CAMERA_SAID)
    raise Error("no capture node with %s in its name (the ini's pair is "
                "%04x:%04x). Is uvcvideo loaded, is the camera on the bus?"
                % (CAMERA_SAID, ids[0], ids[1]))


class Camera:
    """YUYV 640x480 over MMAP streaming; one frame is the luma plane.

    With `raw` set, grab() hands the buffer over as it came and leaves the even
    bytes to whoever measures it - the C helper's --yuyv mode does that for
    free, so the search stops copying 614 KB down to 307 KB per frame (Q11 3).
    """

    def __init__(self, node):
        self.fd, self.maps, self.streaming = os.open(node, os.O_RDWR), [], False
        self.bpl, self.raw = FRAME_W * 2, False

    def _control(self, cid, value):
        buf = bytearray(8)
        struct.pack_into("<Ii", buf, 0, cid, value)
        try:
            fcntl.ioctl(self.fd, VIDIOC_S_CTRL, buf, True)
        except OSError:
            pass                # a camera without that control: never mind

    def expose(self, value):
        """EXPOSURE_AUTO = 1 (manual), then the absolute value (AP1 2.5)."""
        self._control(CID_EXPOSURE_AUTO, 1)
        self._control(CID_EXPOSURE_ABS, value)

    def start(self, nbuf=2):
        fmt = bytearray(208)
        struct.pack_into("<I", fmt, 0, BUF_TYPE_CAPTURE)
        struct.pack_into("<IIII", fmt, 8, FRAME_W, FRAME_H, FMT_YUYV, 1)
        fcntl.ioctl(self.fd, VIDIOC_S_FMT, fmt, True)
        got = struct.unpack_from("<III", fmt, 8)
        if got != (FRAME_W, FRAME_H, FMT_YUYV):
            raise Error("the camera gave %dx%d 0x%08x, not YUYV 640x480" % got)
        self.bpl = struct.unpack_from("<I", fmt, 24)[0]
        req = bytearray(20)
        struct.pack_into("<III", req, 0, nbuf, BUF_TYPE_CAPTURE, MEMORY_MMAP)
        fcntl.ioctl(self.fd, VIDIOC_REQBUFS, req, True)
        for i in range(struct.unpack_from("<I", req, 0)[0]):
            buf = bytearray(88)
            struct.pack_into("<III", buf, 0, i, BUF_TYPE_CAPTURE, 0)
            struct.pack_into("<I", buf, 60, MEMORY_MMAP)
            fcntl.ioctl(self.fd, VIDIOC_QUERYBUF, buf, True)
            offset, length = (struct.unpack_from("<I", buf, 64)[0],
                              struct.unpack_from("<I", buf, 72)[0])
            self.maps.append(mmap.mmap(self.fd, length, mmap.MAP_SHARED,
                                       mmap.PROT_READ | mmap.PROT_WRITE,
                                       offset=offset))
            fcntl.ioctl(self.fd, VIDIOC_QBUF, buf, True)
        fcntl.ioctl(self.fd, VIDIOC_STREAMON,
                    struct.pack("<I", BUF_TYPE_CAPTURE))
        self.streaming = True

    def grab(self, deadline=None):
        """One luma plane: the even bytes of the YUYV buffer (AP1 2.4).
        With a deadline (time.monotonic()) the wait ends there instead of
        after SELECT_TIMEOUT_S per select - a camera that answers every
        select with EAGAIN kept `measure` running until 03.10.2026."""
        buf = bytearray(88)
        struct.pack_into("<II", buf, 0, 0, BUF_TYPE_CAPTURE)
        struct.pack_into("<I", buf, 60, MEMORY_MMAP)
        while True:
            wait = SELECT_TIMEOUT_S
            if deadline is not None:
                wait = min(wait, deadline - time.monotonic())
                if wait <= 0:
                    raise Error("no frame before the deadline -- the camera "
                                "stopped (--timeout)")
            if not select.select([self.fd], [], [], wait)[0]:
                if deadline is not None and time.monotonic() >= deadline:
                    raise Error("no frame before the deadline -- the camera "
                                "stopped (--timeout)")
                raise Error("no frame within %.0f s -- the camera stopped"
                            % SELECT_TIMEOUT_S)
            try:
                fcntl.ioctl(self.fd, VIDIOC_DQBUF, buf, True)
                break
            except OSError as exc:
                if exc.errno != errno.EAGAIN:
                    raise
        index = struct.unpack_from("<I", buf, 0)[0]
        used = struct.unpack_from("<I", buf, 8)[0] or self.bpl * FRAME_H
        data = bytes(self.maps[index][:used])
        fcntl.ioctl(self.fd, VIDIOC_QBUF, buf, True)
        return data if self.raw else data[0::2]

    def close(self):
        if self.streaming:
            try:
                fcntl.ioctl(self.fd, VIDIOC_STREAMOFF,
                            struct.pack("<I", BUF_TYPE_CAPTURE))
            except OSError:
                pass
        for region in self.maps:
            region.close()
        os.close(self.fd)


# --- the pattern ----------------------------------------------------------

FB_DEV, FBIOGET_VSCREENINFO, FBIOGET_FSCREENINFO = "/dev/fb0", 0x4600, 0x4602


def chessboard(xres, yres, bpp, line_length, cell=PATTERN_CELL, origin=None):
    """The pattern, generated -- the vendor ships a PNG, we carry none.

    Its bg_auto_focus.png is a 69 px chessboard from (97, 92), 26 by 14 cells,
    with some cells left white so the black squares form a centre block and
    four corner blocks (AP1 2.2). Which cells those are is only in that file,
    which is vendor material, so this draws the plain board: more edges than
    the vendor's, which the metric can only like.

    Whole cells, centred, white all round. Drawn from the vendor's origin the
    board had a 97 px white band on the left and a doubled top row, and looked
    shifted on the wall (Marco, 23.09.2026). `origin` pins the top left corner
    instead and lets the cells run to the edges - the tests use it.
    """
    pixel = max(bpp // 8, 1)
    white = b"\xff" * pixel
    black = b"\x00\x00\x00\xff" if pixel == 4 else b"\x00" * pixel
    if origin is None:
        ox, oy = (xres % cell) // 2, (yres % cell) // 2
        x_end, y_end = ox + xres // cell * cell, oy + yres // cell * cell
    else:
        (ox, oy), x_end, y_end = origin, xres, yres
    rows = []
    for parity in (0, 1):
        row = bytearray()
        for x in range(xres):
            row += black if (ox <= x < x_end and
                             ((x - ox) // cell + parity) % 2 == 0) else white
        rows.append(bytes(row) + b"\x00" * max(line_length - len(row), 0))
    blank = white * xres + b"\x00" * max(line_length - xres * pixel, 0)
    return b"".join(rows[((y - oy) // cell) % 2] if oy <= y < y_end else blank
                    for y in range(yres))


def bare_seconds(timeout):
    """The net of `h713-tv ctl bare` for a run with this deadline (0: none)."""
    if not timeout:
        return BARE_MAX_S
    return min(BARE_MAX_S, int(timeout) + BARE_MARGIN_S)


class Handover:
    """The wall for the pattern, and the picture back afterwards.

    The chessboard goes through the console's framebuffer, which is on the
    wall only while h713-tv shows the console: with the HDMI picture up the
    video plane covers it, and with h713-warp drawing, the GPU's buffers do.
    So this takes the panel over - `h713-warp ctl off` when the warp is on,
    then `h713-tv ctl off` - and gives it back the same way in reverse.
    "off" leaves an opaque page of h713-osd's standing over black (the
    launcher, the settings, "No signal"), and the camera saw the page, not
    the pattern (L018, 25.10.2026: "no picture"); so `h713-tv ctl bare
    SECONDS` follows: nothing of h713-osd's on the wall, the console has
    the panel. On the way back `bare 0` comes first and puts the page up
    again before the picture returns under it. A tool that is not
    installed, or one that answers error, is noted and skipped: the run
    still happens, the pattern may then not be seen (Marco, 23.09.:
    an autofocus that does not put its picture up is worth nothing). Nothing
    sleeps here: `ctl off` replies after its blocking commit and the console
    unblank (h713-tv, display_hide), and warm_up() waits on the picture.
    """

    def __init__(self, tv="h713-tv", warp="h713-warp", log=None,
                 bare_s=BARE_MAX_S):
        self.tv, self.warp, self.log = tv, warp, log or (lambda _: None)
        self.bare_s = bare_s
        self.warp_was_on = False
        self.tv_was_auto = False
        self.bare = False
        self.taken = False

    def _run(self, argv, timeout=15):
        try:
            done = subprocess.run(argv, stdout=subprocess.PIPE,
                                  stderr=subprocess.STDOUT, timeout=timeout,
                                  text=True)
        except (OSError, subprocess.TimeoutExpired) as exc:
            self.log("%s: %s" % (" ".join(argv), exc))
            return None
        return done.stdout

    def take(self):
        out = self._run([self.warp, "ctl", "status"])
        if out and "\nwarp            on" in "\n" + out:
            self.warp_was_on = True
            self._run([self.warp, "ctl", "off"])
            self.log("the warp is off for the pattern")
        out = self._run([self.tv, "ctl", "status"])
        if out and "mode            automatic" in out:
            self.tv_was_auto = True
        if out is not None:
            self._run([self.tv, "ctl", "off"])
            self.log("the console has the panel for the pattern")
            out = self._run([self.tv, "ctl", "bare", str(self.bare_s)])
            if out is not None and out.startswith("ok"):
                self.bare = True
                self.log("no page of h713-osd's over the pattern (h713-tv "
                         "ctl bare %d)" % self.bare_s)
            else:
                self.log("h713-tv ctl bare: %s -- an open page stays over "
                         "the pattern" % ((out or "").strip().split("\n")[0]
                                          or "no answer"))
        self.taken = True

    def give_back(self):
        if not self.taken:
            return
        if self.bare:
            self._run([self.tv, "ctl", "bare", "0"])
            self.log("h713-osd's page may come back")
            self.bare = False
        if self.tv_was_auto:
            self._run([self.tv, "ctl", "auto"])
            self.log("h713-tv is on automatic again")
        if self.warp_was_on:
            time.sleep(0.5)
            self._run([self.warp, "ctl", "on"])
            self.log("the warp is on again")
        self.taken = False


class Panel:
    """/dev/fb0 -- the console's surface, and the pattern's way to the wall."""

    def __init__(self):
        try:
            self.fd = os.open(FB_DEV, os.O_RDWR)
        except OSError as exc:
            raise Error("%s: %s. The pattern goes through the console's "
                        "framebuffer; `h713-tv ctl off` hands the panel back."
                        % (FB_DEV, exc.strerror))
        var, fix = bytearray(160), bytearray(80)
        fcntl.ioctl(self.fd, FBIOGET_VSCREENINFO, var, True)
        fcntl.ioctl(self.fd, FBIOGET_FSCREENINFO, fix, True)
        self.xres, self.yres = struct.unpack_from("<II", var, 0)
        self.bpp = struct.unpack_from("<I", var, 24)[0]
        self.line = struct.unpack_from("<I", fix, 48)[0] or \
            self.xres * max(self.bpp // 8, 1)
        self.saved = None

    def _write(self, data):
        os.lseek(self.fd, 0, os.SEEK_SET)
        os.write(self.fd, data)

    def save(self):
        os.lseek(self.fd, 0, os.SEEK_SET)
        self.saved = os.read(self.fd, self.line * self.yres)

    def draw(self, cell=PATTERN_CELL):
        self._write(chessboard(self.xres, self.yres, self.bpp, self.line, cell))

    def restore(self):
        self._write(self.saved if self.saved is not None
                    else b"\x00" * (self.line * self.yres))

    def close(self):
        os.close(self.fd)


# --- the search -----------------------------------------------------------

class Search:
    """The five-state search of AP1 tables/focus-loop.txt section 3.

    0 settle with the motor standing still, 1 wait until the picture is quiet,
    2 coarse hill climb, 3 confirm the peak, 4 fine return onto it. Only state
    4 ends a run normally; the other two ways out are the pass budget and the
    deadline -- the vendor has no clock in the loop either, its 22 s watchdog
    sits on the Java side.

    State 2 is the vendor's thread_fun_LCD_vafo10_HY260 (0x0002EA90 in
    libduRYXtp.so, AP1 ida/libduRYXtp-arm64.so.i64) branch for branch, since
    FB-AFSEARCH: the AP1 table it was first ported from missed three things,
    and on 26.09.2026 the first run after a boot fell 350 msteps from its
    maximum without turning round (device/af-run1.log). The debounce counts
    down in EVERY pass that does not turn (lines 321 and 384 there), not only
    in the rising ones; a fall-back from state 3 zeroes it (line 463); and the
    drop-from-max rule is armed once per run (v73: line 118, cleared by every
    turn, never set again) - after the first turn a run is below its max by
    definition, and the rule would only flip it back.

    One rule is ours: a turn-around at an edge in state 3, or in the pass that
    enters it, cuts the confirmation to one pass. There is nothing beyond the
    edge to climb to, so the two falls that follow are the peak and not a
    false one. The vendor's search cannot know (motor_ctrl_loop hides the
    edge from it) and cycles at a peak on the edge - state 3, fall-back, five
    falls, five rises, the edge again - which on run 1's curve is four edge
    turns, one short of EDGE_REVERSE_CAP.
    """

    def __init__(self, motor, grab, metric, profile, log=None, deadline=None):
        self.motor, self.grab, self.metric = motor, grab, metric
        self.profile, self.log = profile, log or _stderr
        self.deadline = deadline
        self.coarse, self.middle, self.fine = profile.steps
        self.thresholds = (11, 5, -11) if profile.gain else (31, 10, -31)
        self.best_step = self.passes = 0

    def run(self):                                  # noqa: C901 - one loop
        state, move, step = 0, 0, self.fine
        budget, scale_thr = self.profile.budget, SCALE_CEILING
        total = prev = best = prev_delta = 0
        settle, settle_cnt = SETTLE_PASSES, 0
        rise = fall = flat = debounce = 0
        armed = True                    # the drop-from-max rule, once per run
        confirm = fine_cap = best_delta = up_run = pos_run = 0
        reason, edge_turns = "budget", self.motor.reversals
        while True:
            if move:
                self.motor.loop(step)
            at_edge = self.motor.reversals != edge_turns  # loop() turned round
            edge_turns = self.motor.reversals
            if state <= 3:              # two frames per pass, averaged
                one, two = self.metric(self.grab()), self.metric(self.grab())
                if (one + two) // 2 <= scale_thr:
                    prev, total = total, (one + two) // 2
                else:                   # overflow: halve everything, keep room
                    prev, best = prev // 2, best // 2
                    total, scale_thr = (one + two) // 4, scale_thr + SCALE_STEP
                    self.metric.lev *= 2
            else:
                prev, total = total, self.metric(self.grab())
            delta = total - prev
            position = self.motor.state().step
            self.passes += 1
            keep_going = True

            if state == 0:                                      # settle
                if prev and abs(delta) > SETTLE_JUMP:
                    settle = SETTLE_PASSES_LONG
                delta, move, best = 0, 0, total
                if settle_cnt <= settle:
                    if settle_cnt + 2 == settle:
                        self.metric.lev = 0         # re-pick the divisor once
                    settle_cnt += 1
                else:
                    state = 1
            elif state == 1:                                    # quiet picture
                if abs(delta) > STABLE_DELTA:
                    move = 0
                else:
                    state, step, move = 2, self.coarse, 1
                    rise = fall = debounce = 0
            elif state == 2:                                    # coarse climb
                rise_thr, dead, fall_thr = self.thresholds
                move, turned = 1, False
                if delta >= rise_thr:                           # a clear rise
                    if rise >= RISE_RUN:
                        state, confirm = 3, 1 if at_edge else CONFIRM_PASSES
                        step, best = self.middle, total
                        rise = fall = flat = 0
                    else:
                        rise, fall, flat = rise + 1, 0, 0
                elif delta < -dead or delta <= DRIFT_FLOOR:     # a fall, or a
                    rise = 0 if delta < -dead else rise         # drift down
                    if delta <= fall_thr and fall >= FALL_RUN and debounce <= 1:
                        self.motor.change_direct()              # a fall run
                        turned, fall, flat = True, 0, 1
                    elif flat >= FLAT_RUN and debounce <= 1:
                        self.motor.change_direct()              # a flat run
                        turned, fall, flat = True, 0, 0
                    else:
                        fall += 1 if delta <= fall_thr else 0
                        flat += 1
                    step = self.middle if turned else step
                else:                                           # the dead zone
                    fall, flat = (0 if delta > dead else fall), 0
                if turned:
                    debounce, armed = DEBOUNCE, False
                elif armed and best - total >= DROP_FROM_MAX and debounce <= 1:
                    self.motor.change_direct()      # walked away from the max
                    fall = flat = 0
                    debounce, step, armed = DEBOUNCE, self.coarse, False
                else:
                    debounce = max(debounce - 1, 0)
            elif state == 3:                                    # confirm
                move, step = 1, self.middle
                if at_edge:                 # nothing beyond it: one pass does
                    confirm = min(confirm, 1)
                if not (delta < 0 and prev_delta < 0):
                    confirm = max(confirm - 1, 0)
                elif confirm - 1 <= 0:
                    self.motor.change_direct()
                    state, step, fine_cap = 4, self.middle, FINE_PASS_CAP
                    best_delta = up_run = pos_run = 0
                else:
                    state, confirm, debounce = 2, confirm - 1, 0
            else:                                               # fine return
                step, fine_cap = self.fine, max(fine_cap - 1, 0)
                if delta >= 21 and prev_delta >= 21 and best_delta > delta:
                    up_run += 1
                elif delta > prev_delta or delta < 0:
                    up_run = 0
                pos_run = 0 if delta < 0 else pos_run
                if delta > 30:
                    pos_run += 1
                best_delta = max(best_delta, delta)
                move = self._fine_move(total, best, delta, best_delta,
                                       fine_cap, up_run, pos_run)
                keep_going = bool(move)
                if not move:
                    reason = "peak"
                    self._closing_correction(delta, best_delta)

            if total >= best:
                self.best_step = position
            best = max(best, total)
            self.log("%3d state:%d step:%2d dir:%d pos:%-6s sum:%6d d:%7d "
                     "max:%6d lev:%8d R:%d W:%d fine:%2d"
                     % (budget, state, step, self.motor.direction, position,
                        total, delta, best, self.metric.lev, rise, fall,
                        fine_cap))
            if budget < 1 or not keep_going:
                break
            if self.deadline and time.monotonic() >= self.deadline:
                reason = "deadline"
                break
            budget, prev_delta = budget - 1, delta
        return reason, best

    @staticmethod
    def _fine_move(total, best, delta, best_delta, fine_cap, up_run, pos_run):
        """State 4's six stop rules; any one of them ends the run."""
        return 0 if (fine_cap == 0
                     or abs(best - total) < PEAK_WINDOW or best < total
                     or (fine_cap < 3 and delta < 0)
                     or up_run >= 3
                     or (best_delta >= DROP_FROM_MAX and delta < best_delta // 5)
                     or (pos_run > 3 and delta < 20)) else 1

    def _closing_correction(self, delta, best_delta):
        """Stopping while still falling: turn round, give 2 to 4 steps back."""
        if delta >= 0 or best_delta < OVERSHOOT_TRIGGER:
            return
        self.motor.change_direct()
        for fraction, back in ((-0.6, 4), (-0.2, 3), (-0.1, 2)):
            if delta < fraction * best_delta:
                self.motor.loop(back)
                return


