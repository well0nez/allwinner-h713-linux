def warm_up(camera, profile, metric):
    """The wait for the pattern, then the brightness probe and the picture
    gate (AP1 2.6: 28 frames; ours are two probes of a quiet, lit picture).

    Every failed probe re-writes the exposure: a control write is what ends
    this camera's black-frame state (h713-cam), and the one before the stream
    did not on the first run after a boot. The wait is bounded by
    WAIT_LIMIT_S; a picture that never reaches the floor is EXIT_NO_PICTURE,
    with the motor untouched.
    """
    started, frames, levels = time.monotonic(), 0, []
    while True:
        frame = camera.grab()
        frames += 1
        if frames % LEVEL_EVERY:
            continue
        levels.append(picture_present(frame))
        if len(levels) > 1 and min(levels[-2:]) >= PATTERN_FLOOR and \
                abs(levels[-1] - levels[-2]) * 10 <= levels[-1]:
            break
        spent = time.monotonic() - started
        if spent >= WAIT_LIMIT_S:
            _stderr("waited %.1f s (%d frames) for the pattern: picture level "
                    "%s, floor %d -- a lit chessboard reads about %d here"
                    % (spent, frames, "/".join(map(str, levels[-3:])),
                       PATTERN_FLOOR, PATTERN_LEVEL))
            return EXIT_NO_PICTURE
        camera.expose(profile.exposure[0])
    _stderr("the pattern is on the wall: picture level %d after %d frames "
            "(%.2f s, %d probes)" % (levels[-1], frames,
                                     time.monotonic() - started, len(levels)))
    dark = sum(1 for y in range(FRAME_H)
               if frame[y * FRAME_W + FRAME_W // 2] < 160)
    if dark < EXPOSURE_PROBE_LIMIT:
        _stderr("only %d dark pixels in the centre column -- shortening the "
                "exposure to %d" % (dark, profile.exposure[1]))
        camera.expose(profile.exposure[1])
        for _ in range(4):
            frame = camera.grab()
    level = picture_present(frame)
    # The warm-up frames are luma planes, the search's are whole buffers, so
    # this one measurement goes through Python and not through a --yuyv
    # helper. Same number: it is what metric(frame) does with lev still 0.
    total = sharpness_sum(frame, metric.window, metric.stride)
    metric.lev = pick_divisor(total)
    _stderr("picture level %d (floor %d), first metric %d"
            % (level, PATTERN_FLOOR, total // metric.lev))
    return 0 if level >= PATTERN_FLOOR else EXIT_NO_PICTURE


def build_metric(args, profile, yuyv=False):
    """The metric, measured by the C helper when there is one (Q11 2)."""
    path = None if args.no_helper else find_helper(args.helper)
    if not args.quiet:
        _stderr("metric: %s" % (path or "python (%s)"
                                % ("--no-helper" if args.no_helper
                                   else "no %s found" % HELPER)))
    return Metric(profile.window, profile.stride,
                  Helper(path, profile.window, profile.stride, yuyv)
                  if path else None)


def return_to_best(search, log):
    """A run that ends without a peak leaves the focus where the search
    stopped - at an edge after the fourth turn-around, or wherever the cap
    fell - which is the blurriest place there is (Marco, 23.09.2026: "extrem
    unscharf"). Go back to the best position the run has seen: guarded moves
    as in the run, outside its cap and its turn-arounds. Returns the msteps
    moved, signed.

    The way back is not a search, so it never turns round: a latched edge
    ahead ends it where it stands. The driver drops every command towards a
    latched edge (motor_run_up_dn, patch 0111), so nothing is pushed; and a
    run whose best lay at an edge has arrived when the flag comes up, however
    far the counter says it still is - the counter gains one per edge event
    while the mechanism is walked back out of it (AP1c 2.5, doku 94: about
    six msteps each), so after a run's turn-arounds the best position's
    counter value can lie beyond the edge (26.09.2026, af-run1.log).
    """
    if search is None or not search.passes:
        return 0
    motor = search.motor
    start = motor.state().step
    delta = search.best_step - start
    if abs(delta) < search.fine:
        return 0
    motor.moved = motor.reversals = 0   # the run's cap and its turn-arounds
    up = delta > 0                      # are spent; this is the way back
    motor.direction = 0 if up else 1
    left = abs(delta)
    while left > 0:
        if motor.edge_ahead(motor.state(), up):
            log("the %s edge is latched %d msteps short of the best position "
                "seen (%s): that is where the run's best was, or the counter "
                "has drifted -- the way back ends here"
                % ("upper" if up else "lower",
                   abs(search.best_step - motor.state().step), search.best_step))
            break
        n = min(left, MSTEPS_PER_COMMAND_MAX)
        motor.loop(n)
        left -= n
    else:
        log("back at the best position seen: %s (%d msteps)"
            % (search.best_step, abs(delta)))
    # what the motor reports, not what was commanded: a command towards a
    # latched edge is dropped by the driver (deep review 27.09.2026, F9)
    return motor.state().step - start


def do_run(args, profile):
    """Pattern, camera, warm-up, search -- the whole procedure (AP1 2)."""
    metric = build_metric(args, profile, yuyv=not args.dry_run)
    panel = camera = handover = search = None
    if args.dry_run:
        motor = ReplayMotor(read_frames(args.dry_run), args.start,
                            args.direction)
        grab = motor.grab
    else:
        tool = _focus_tool()
        soft = tool.read_soft() if tool else None
        if soft:
            motor = SoftMotor(find_base(args.sysfs), tool, soft)
            _stderr("experimental: the end switch is ignored on this unit, the "
                    "counted range %d..%d of %s bounds the search"
                    % (soft.low, soft.high, tool.FOCUS_CONF))
        else:
            motor = SysfsMotor(find_base(args.sysfs))
        motor.direction = args.direction
        st = motor.state()
        up = motor.direction == 0
        if motor.edge_ahead(st, up) and not motor.edge_ahead(st, not up):
            # The last run ended at this edge and the driver latched it: every
            # command towards it is dropped, away from it is fine. Start the
            # other way round -- that is what vafo4_L010 (0x0002b6c8) does
            # before its loop, and what motor_ctrl_loop would do on the first
            # move anyway. No msteps are spent on it.
            _stderr("the %s edge is latched from the last run -- starting in "
                    "the other direction" % ("upper" if up else "lower"))
            motor.direction ^= 1
            up = not up
        reason = motor.guard(st, up)
        if reason:
            _stderr("the motor cannot start: " + reason)
            return EXIT_BLOCKED
        camera = Camera(find_camera(args.dev, profile.camera))
        camera.expose(profile.exposure[0])
        camera.start()
        grab = camera.grab
        if not args.no_pattern:
            if not args.no_handover:
                handover = Handover(log=(lambda _: None) if args.quiet
                                    else _stderr,
                                    bare_s=bare_seconds(args.timeout))
                handover.take()
            panel = Panel()
            panel.save()
            panel.draw(args.cell)
    stopped = []
    for sig in (signal.SIGINT, signal.SIGTERM):
        signal.signal(sig, lambda *_: stopped.append(True))
    code = 0
    search = None
    try:
        if camera is not None:
            code = warm_up(camera, profile, metric)
            if code:
                _stderr("no picture: the camera streams but the frame is flat."
                        " Is the lamp on, is the pattern on the wall?")
                return code
            camera.raw = isinstance(metric.sums, Helper)
        deadline = time.monotonic() + args.timeout if args.timeout else None
        search = Search(motor, grab, metric, profile,
                        (lambda _: None) if args.quiet else _stderr, deadline)
        reason, best = search.run()
        print("stopped: %s   position %s   best %d   %d passes, %d msteps"
              % (reason, search.best_step, best, search.passes, motor.moved))
        code = 0 if reason == "peak" else EXIT_NO_PEAK
        if reason != "peak":
            return_to_best(search, _stderr)
    except Edge as exc:
        _stderr("stopped: %s" % exc)		# a guard, both edges, or a cap
        code = EXIT_EDGE
        try:
            return_to_best(search, _stderr)
        except Edge as back:
            _stderr("not back at the best position: %s" % back)
    finally:
        motor.flush()
        metric.close()
        if panel is not None:
            panel.restore()
            panel.close()
        if handover is not None:
            handover.give_back()
        if camera is not None:
            camera.close()
    return 130 if stopped else code


def do_measure(args, profile):
    """One metric value: from the camera, or from a recorded frame."""
    if args.metric_only:
        with open(args.metric_only, "rb") as fh:
            frame = fh.read()
        if len(frame) < FRAME_BYTES:
            raise Error("%s holds %d bytes; a 640x480 luma frame has %d"
                        % (args.metric_only, len(frame), FRAME_BYTES))
        metric = build_metric(args, profile)
        started = time.perf_counter()
        total = metric.sums(frame, profile.window, profile.stride)
        spent = time.perf_counter() - started
        metric.close()
        print("window %-5s stride %d   sum %d   normalised %d   %.4f s"
              % (profile.window, profile.stride, total,
                 total // pick_divisor(total), spent))
        return 0
    metric = build_metric(args, profile)
    camera = Camera(find_camera(args.dev, profile.camera))
    deadline = time.monotonic() + args.timeout if args.timeout else None
    try:
        camera.expose(profile.exposure[0])
        camera.start()
        frame = camera.grab(deadline)
        print("%d   (picture level %d)" % (metric(frame),
                                           picture_present(frame)))
    finally:
        camera.close()
        metric.close()
    return 0


def do_pattern(args):
    panel = Panel()
    try:
        if args.state == "on":
            panel.draw(args.cell)
            print("chessboard on %s (%dx%d, %d bpp, %d px cells). If the wall "
                  "stays dark, `h713-tv ctl off` first, and `h713-tv ctl bare "
                  "600` over an open page of h713-osd's."
                  % (FB_DEV, panel.xres, panel.yres, panel.bpp, args.cell))
        else:
            panel.restore()
            print("%s cleared -- `h713-tv ctl console` draws the console back."
                  % FB_DEV)
    finally:
        panel.close()
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="h713-autofocus",
        description="the projector's autofocus: chessboard, camera, motor.",
        epilog="Without a device: `run --dry-run DIR` replays recorded luma "
               "frames, `measure --metric-only FILE` times the metric.")
    parser.add_argument("--profile", default="hy310", choices=sorted(PROFILES))
    parser.add_argument("--window", choices=sorted(WINDOWS),
                        help="measuring window (default crect, from the "
                             "profile)")
    parser.add_argument("--stride", type=int, metavar="N",
                        help="measure every Nth pixel in both directions "
                             "(default 3, from the profile)")
    parser.add_argument("--sysfs", metavar="PATH")
    parser.add_argument("--dev", metavar="NODE")
    parser.add_argument("--cell", type=int, default=PATTERN_CELL, metavar="PX")
    parser.add_argument("--helper", metavar="PATH",
                        help="use this C metric instead of searching for it")
    parser.add_argument("--no-helper", action="store_true",
                        help="measure in Python even when %s is there" % HELPER)
    parser.add_argument("-q", "--quiet", action="store_true")
    sub = parser.add_subparsers(dest="command", required=True)
    run = sub.add_parser("run", help="the whole search")
    run.add_argument("--dry-run", metavar="DIR",
                     help="replay recorded frames instead of using a device")
    run.add_argument("--start", type=int, metavar="STEP",
                     help="replay only: the position to start from")
    run.add_argument("--direction", type=int, default=0, choices=(0, 1),
                     help="0 = up, 1 = down (default 0)")
    run.add_argument("--timeout", type=float, default=22.0, metavar="S",
                     help="deadline in seconds, 0 = none (default 22, the "
                          "vendor's own watchdog)")
    run.add_argument("--no-handover", action="store_true",
                     help="do not take the panel over from h713-tv and "
                          "h713-warp for the pattern (you did it yourself)")
    run.add_argument("--no-pattern", action="store_true",
                     help="leave the framebuffer alone")
    measure = sub.add_parser("measure", help="one metric value")
    measure.add_argument("--metric-only", metavar="FRAME",
                         help="measure a recorded luma frame and time it")
    measure.add_argument("--timeout", type=float, default=10.0, metavar="S",
                         help="give up on the camera after S seconds, 0 = "
                              "never (default 10)")
    pattern = sub.add_parser("pattern", help="draw or clear the chessboard")
    pattern.add_argument("state", choices=("on", "off"))
    args = parser.parse_args(argv)
    sys.stdout.reconfigure(line_buffering=True)

    profile = PROFILES[args.profile]._replace()
    profile = profile._replace(window=args.window or profile.window,
                               stride=args.stride or profile.stride)
    if not profile.verified and not args.quiet:
        _stderr("profile %s is not verified: %s" % (profile.name, profile.note))
    if args.command == "pattern":
        return do_pattern(args)
    if args.command == "measure":
        return do_measure(args, profile)
    return do_run(args, profile)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except NotPresent as exc:
        _stderr("h713-autofocus: %s" % exc)
        sys.exit(EXIT_NOT_PRESENT)
    except Error as exc:
        _stderr("h713-autofocus: %s" % exc)
        sys.exit(EXIT_ERROR)
    except PermissionError as exc:
        _stderr("h713-autofocus: %s\nthe motor's sysfs and %s belong to root."
                % (exc, FB_DEV))
        sys.exit(EXIT_BLOCKED)
    except KeyboardInterrupt:
        sys.exit(130)
