class Error(Exception):
    """Something is wrong: message out, non-zero exit, drive nothing."""


class NotPresent(Error):
    """The board has no such hardware at all (boards/README.md, FEATURES):
    said as the last line, exit 7, nothing touched."""


class Edge(Exception):
    """A guard refused, or the travel range is used up: stop, do not unlatch.

    Reaching ONE edge is not this: the driver reverses out of it by itself and
    the search turns round (Motor.loop). Only both edges at once, too many
    turn-arounds or a guard that is not about direction end a run here.
    """


