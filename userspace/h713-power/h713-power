#!/usr/bin/env python3
"""h713-power - the power key's policy.

logind's default turns KEY_POWER into a power-off. The unit runs this tool under systemd-inhibit with logind's
handle-power-key and handle-suspend-key locks, so the key is decided here. A short press shows a countdown of
15 s in the middle of the picture (h713-osd, TODO 2.38): standby on the left, off on the right; Left and Right
choose, OK or a second press acts at once, Back cancels, and when the time is up the choice is carried out.
It starts on `default` of /etc/h713/power.conf (poweroff). Standby is offered only where it can happen: the
image allows suspend (built with --standby), the kernel offers deep sleep (/sys/power/mem_sleep shows [deep])
and crust says ready=1 (the arisc driver's state file); elsewhere the countdown shows the ring alone and ends
in a power-off. Without a picture (no signal, no h713-osd) nobody sees a countdown: the default is carried out
at once, as before. A press of
long_s seconds (3) powers off whatever short says. A KEY_POWER whose timestamp lies within ignore_s (2 s)
after a resume the key itself woke is that same press and is ignored. If this service dies, logind's own
power-off is back (docs/subsystems/standby.md).
A standby parks the display MIPS and nothing in the kernel starts it again: the picture and the mode from before
(HDMI or Kodi) come back through systemd, for every way into the sleep - this key, the launcher, Kodi's own menu,
`systemctl suspend`: h713-sleep-pre.service and h713-sleep-post.service run `h713-mode` around sleep.target.
While the post unit runs a short press does nothing, a long one still powers off.
The launcher (h713-keys) and a page of h713-settings hand a Power press on as a datagram "down" to the socket of
H713_POWER_CTL (they let the devices go first, so this loop did not see the press): it starts the press here on the device
that has the key down, and the release or the 3 s decide as ever - a long hold still powers off. The datagram "short" is a
short press at once. The 15 s of the countdown hold the remote's devices (EVIOCGRAB), so that Kodi does not move with the
arrows and OK.
The power-off itself is crust's on a board whose crust says it can (the arisc driver's build2 bit 24): the
rails off, about 0.3 W, the key or the remote wakes into a fresh boot (doku/188); else the power-on gate.
`h713-power set default standby|poweroff` (and the other keys of power.conf) changes the policy for the next
press, no restart needed; `short`, the key's name before the countdown, still works and means `default`.
Commands: run [--once], status, set KEY VALUE, can-standby. Exit: 0, 1 power.conf not written (can-standby: no
standby now), 2 usage.
"""

import argparse
import errno
import fcntl
import glob
import os
import select
import shlex
import socket
import struct
import subprocess
import sys
import time

ROOT = os.environ.get("H713_POWER_ROOT", "/")
SYSTEMCTL = shlex.split(os.environ.get("H713_SYSTEMCTL", "systemctl"))
CTL = os.environ.get("H713_POWER_CTL", "/run/h713-power.sock")   # datagrams: "down" = Power went down, "short" = a short press (h713-keys)
EVIOCGRAB = 0x40044590                       # _IOW('E', 0x90, int)
EVENT = struct.Struct("qqHHi")               # struct input_event on a 64-bit kernel
EV_KEY, KEY_POWER = 1, 116
KEY_LEFT, KEY_RIGHT, KEY_BACK, KEY_OK, KEY_SELECT, KEY_ENTER = 105, 106, 158, 352, 353, 28
OSD = os.environ.get("H713_POWER_OSD", "/run/h713-osd/ctl")
COUNTDOWN_S = 15                             # libh713osd's ring is full at 15 s
EVIOCSCLOCKID = 0x400445a0                   # _IOW('E', 0xa0, int)
CLOCK_BOOTTIME = 7
BUS_BLUETOOTH = 0x05
DEFAULTS = {"default": "poweroff", "long_s": "3", "ignore_s": "2", "remote": "on", "refused": "poweroff"}
ALIASES = {"short": "default"}               # the name before the countdown (power.conf of 09.10.)
BUILD2_POWER_OFF = 1 << 24                   # crust takes SYSTEM_OFF: rails off (doku/188)
CHOICES = {"default": ("standby", "poweroff"), "remote": ("on", "off"), "refused": ("poweroff", "log")}


def path(*parts):
    return os.path.join(ROOT, *parts)


def log(msg, level=""):
    """One line for the journal; level "<4>" makes it a warning there (systemd reads the prefix on stdout)."""
    print(level + "h713-power: " + msg, flush=True)


def read(p, default=""):
    try:
        with open(p) as f:
            return f.read().strip()
    except OSError:
        return default


def valid(key, value):
    key = ALIASES.get(key, key)
    return key in DEFAULTS and (value in CHOICES[key] if key in CHOICES else value.replace(".", "", 1).isdigit())


def config():
    """power.conf over the defaults; a bad line is named and its default kept."""
    conf, bad = dict(DEFAULTS), []
    for n, line in enumerate(read(path("etc/h713/power.conf")).splitlines(), 1):
        line = line.split("#", 1)[0].strip()
        if not line:
            continue
        key, _, value = (x.strip() for x in line.partition("="))
        if valid(key, value):
            conf[ALIASES.get(key, key)] = value
        else:
            bad.append("power.conf:%d: %r ignored" % (n, line))
    return conf, bad


def arisc_state():
    """The arisc driver's state file as a dict ({} when the driver is not bound)."""
    for p in sorted(glob.glob(path("sys/bus/platform/drivers/sun50i-h713-arisc/*/state"))):
        return dict(line.split("=", 1) for line in read(p).splitlines() if "=" in line)
    return {}


def image_allows_suspend():
    """An image built without --standby forbids every suspend in sleep.conf.d (install-projekt.sh 5h)."""
    conf = read(path("etc/systemd/sleep.conf.d/10-h713.conf"))
    return "AllowSuspend=no" not in conf.replace(" ", "")


def standby_unavailable():
    """None when a standby can happen now, else the reason it cannot."""
    if not image_allows_suspend():
        return "this image allows no suspend (built without --standby)"
    mem_sleep = read(path("sys/power/mem_sleep"))
    if "[deep]" not in mem_sleep:
        return "mem_sleep is '%s', not [deep]" % mem_sleep
    state = arisc_state()
    if state.get("ready") != "1":
        return "crust is not ready (%s)" % ("ready=%s" % state["ready"] if "ready" in state else "no arisc state")
    return None


def standby_refusal(conf):
    """None when the default (no countdown seen, or its time up untouched) is a standby that can happen."""
    if conf["default"] != "standby":
        return "power.conf says default = %s" % conf["default"]
    return standby_unavailable()


def has_power_key(caps):
    """capabilities/key: hex words of the kernel's long, highest first."""
    bits = 0
    for word in caps.split():
        bits = (bits << 64) | int(word, 16)
    return bool(bits >> KEY_POWER & 1)


def power_key_devices(conf):
    found = []
    for d in sorted(glob.glob(path("sys/class/input/event*"))):
        if not has_power_key(read(os.path.join(d, "device/capabilities/key"), "0")):
            continue
        if conf["remote"] == "off" and int(read(os.path.join(d, "device/id/bustype"), "0"), 16) == BUS_BLUETOOTH:
            continue
        found.append(path("dev/input", os.path.basename(d)))
    return found


def key_down(fd):
    """True when the device's KEY_POWER is down right now (EVIOCGKEY: the kernel's key state, also under somebody else's grab);
    False when it is up, or when the device cannot say."""
    buf = bytearray(KEY_POWER // 8 + 1)
    try:
        fcntl.ioctl(fd, (2 << 30) | (len(buf) << 16) | (ord("E") << 8) | 0x18, buf)    # _IOR('E', 0x18, len)
    except OSError:
        return False
    return bool(buf[KEY_POWER // 8] >> (KEY_POWER % 8) & 1)


class Key:
    """One device's KEY_POWER: 'short' on a release before long_ns, 'long' once at long_ns."""

    def __init__(self):
        self.down = None
        self.fired = False

    def event(self, ts, value, long_ns, ignore_ns, state):
        if value == 1:
            since = ts - int(state.get("resume_ns", "0") or 0)
            if state.get("wake") == "key" and 0 <= since <= ignore_ns:
                log("KEY_POWER %.2f s after a wake by the key: the same press, ignored" % (since / 1e9))
                self.down = None
                return None
            self.down, self.fired = ts, False
        elif value == 0 and self.down is not None:
            short = ts - self.down < long_ns and not self.fired
            self.down = None
            return "short" if short else None
        return None                              # value 2: autorepeat

    def tick(self, now, long_ns):
        if self.down is not None and not self.fired and now - self.down >= long_ns:
            self.fired = True
            return "long"
        return None


def suspend_counts():
    return tuple(int(read(path("sys/power/suspend_stats", n), "0") or 0) for n in ("success", "fail"))


# The kernel's counters of the steps a standby fails in from the freezer on (kernel/power/main.c). The freezer
# clears pm_wakeup_irq first (pm_wakeup_clear), so only when one of these moved does that file speak of this try.
STEPS = ("failed_freeze", "failed_prepare", "failed_suspend", "failed_suspend_late", "failed_suspend_noirq")


def suspend_steps():
    return tuple(int(read(path("sys/power/suspend_stats", n), "0") or 0) for n in STEPS)


def wake_abort(steps_before):
    """The IRQ whose wake-up aborted the standby that just failed, or None (TODO 5.14 U2, review 09.10.).

    A press while the box goes to sleep (or any interrupt armed for wake-up) aborts it in its last phases, and
    the kernel answers -EBUSY - but so do two real refusals of ours (afbd's scanout that does not stop, crust's
    RTC alarm that is due), so the errno does not tell them apart. /sys/power/pm_wakeup_irq does: the first
    wake-up interrupt of the try, cleared when the freezer starts. It exists with CONFIG_PM_DEBUG only; without
    it, or when the try failed before the freezer, this is None and the failure counts as a refusal, as before."""
    if suspend_steps() == steps_before:
        return None
    irq = read(path("sys/power/pm_wakeup_irq"))
    return irq if irq.isdigit() else None


def suspend(clock=None, sleep=None):
    """systemctl suspend, then wait for the kernel's verdict in suspend_stats.

    systemd freezes this process for the standby. Freezing, the devices' suspend and their resume are awake
    time and may take longer than the 30 s: a wait that comes back from the freezer starts its 30 s again,
    and the counters are always read before the time is judged - a standby that happened never ends in a
    power-off. False only when 30 s pass with neither counter moving. clock and sleep: for the tests."""
    clock, sleep = clock or time.monotonic, sleep or time.sleep
    before = suspend_counts()
    if subprocess.call(SYSTEMCTL + ["suspend"]) != 0:
        return False
    end = clock() + 30
    while True:
        now = suspend_counts()
        if now[0] > before[0] or now[1] > before[1]:
            return now[0] > before[0]
        t = clock()
        if t >= end:
            return False
        sleep(0.2)
        if clock() - t > 2:                      # frozen meanwhile: the standby came, its verdict follows
            end = clock() + 30


def mips_state():
    """First word of the display MIPS driver's state file ('' when sun50i-h713-mips is not bound)."""
    for p in sorted(glob.glob(path("sys/bus/platform/drivers/sun50i-h713-mips/*/state"))):
        return (read(p).split() or ["?"])[0]
    return ""


def resuming():
    """True while h713-sleep-post.service runs: the picture path and the mode are coming back after a sleep."""
    r = subprocess.run(SYSTEMCTL + ["is-active", "h713-sleep-post.service"], capture_output=True, text=True)
    return r.stdout.strip() == "activating"


def sleep_undone():
    """A standby that did not happen (a wake-up aborted it, or it was refused and the projector stays on) may have left
    h713-sleep-pre's work undone: the post unit runs once more. It does nothing twice (it finds nothing remembered)."""
    subprocess.call(SYSTEMCTL + ["start", "--no-block", "h713-sleep-post.service"])


def act(what, conf, choice=None):
    """what: "short" (the default, or `choice` from the countdown) or "long" (power-off). True when it went
    through a standby (or a refused one): the caller drops what the keys sent meanwhile."""
    if what == "short" and resuming():
        log("short press ignored: the picture is still coming back (h713-sleep-post); a long press powers off")
        return False
    if what == "short":
        why = standby_refusal(conf) if choice is None else (
            standby_unavailable() if choice == "standby" else "the countdown ended on off")
        if why is None:
            log("short press: standby")
            steps = suspend_steps()
            if suspend():
                return True
            irq = wake_abort(steps)
            if irq:
                # not a refusal: the user (or a wake source) asked for the projector before it slept
                log("the standby was aborted by a wake-up (IRQ %s): the projector stays on" % irq, "<4>")
                sleep_undone()
                return True
            if conf["refused"] == "log":
                log("the standby was refused, the projector stays on", "<4>")
                sleep_undone()
                return True
            log("the standby was refused: power-off", "<4>")
        else:
            log("short press: power-off, because %s" % why, "<4>")
    else:
        log("long press: power-off")
    subprocess.call(SYSTEMCTL + ["poweroff"])
    return False


def osd(line):
    """One line to h713-osd; its answer, or "" when it is not there."""
    import socket
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as c:
            c.settimeout(0.5)
            c.connect(OSD)
            c.sendall((line + "\n").encode())
            return c.recv(256).decode(errors="replace").strip()
    except OSError:
        return ""


class Countdown:
    """The 15 s after a short press (TODO 2.38): what is chosen, how long is left, what h713-osd is told.

    frame() sends the picture about ten times a second; each line keeps it a second in h713-osd, so if this
    process dies the countdown vanishes and logind's own power-off is back. The first frames fade in."""

    FADE_S = 0.3

    def __init__(self, conf, clock=time.monotonic, say=None, hold=None):
        self.clock, self.say, self.hold = clock, say or osd, hold or (lambda on: None)
        self.only = standby_unavailable() is not None
        self.choice = "standby" if conf["default"] == "standby" and not self.only else "poweroff"
        self.t0 = self.clock()
        self.end = self.t0 + COUNTDOWN_S
        self.sent = 0.0

    def left(self):
        return max(0.0, self.end - self.clock())

    def line(self, alpha=None):
        if alpha is None:
            alpha = min(1.0, (self.clock() - self.t0) / self.FADE_S + 0.25)
        return "power %d %s%s %d%%" % (int(self.left() * 10 + 0.999), "standby" if self.choice == "standby" else "off",
                                       " only" if self.only else "", round(alpha * 100))

    def start(self):
        """True when h713-osd shows it; false: nobody would see a countdown."""
        answer = self.say(self.line())
        self.sent = self.clock()
        if answer == "ok":
            self.hold(True)                  # the remote's keys are the countdown's: Kodi gets none of them
        return answer == "ok"

    def frame(self):
        if self.clock() - self.sent >= 0.1:
            self.say(self.line())
            self.sent = self.clock()

    def key(self, code):
        """A key press during the countdown: "act", "cancel" or None (a choice moved, or nothing)."""
        if code == KEY_LEFT and not self.only:
            self.choice = "standby"
        elif code == KEY_RIGHT:
            self.choice = "poweroff"
        elif code in (KEY_OK, KEY_SELECT, KEY_ENTER):
            return "act"
        elif code == KEY_BACK:
            return "cancel"
        else:
            return None
        self.say(self.line())
        self.sent = self.clock()
        return None

    def close(self, fade):
        self.hold(False)
        if fade:
            for a in (0.6, 0.3):
                self.say(self.line(a))
                time.sleep(0.06)
        self.say("hide")


def drop_queued(devices, buf):
    """After a standby: what the keys sent while this process waited in suspend() - a second press while the box
    fell asleep, a press held across the sleep, the press that woke it - is read off and forgotten. Judged after
    the wake it would start a second standby or, held, a power-off (review U1, 09.10.2026)."""
    dropped = 0
    for p, (fd, stamped, key) in devices.items():
        while True:
            try:
                chunk = os.read(fd, EVENT.size * 64)
            except OSError:
                break
            if not chunk:
                break
            dropped += len(chunk) // EVENT.size
        buf.pop(p, None)
        key.down, key.fired = None, False
    if dropped:
        log("%d key event(s) from the time of the standby dropped" % dropped)


def open_device(p):
    """(fd, True) when the events carry CLOCK_BOOTTIME stamps; False: the read time stands in.

    The kernel's evdev takes CLOCK_BOOTTIME, so the fallback is for an odd device only. With it the press
    that woke the box can miss the ignore window: its events are read after the thaw, not stamped when the
    key went down."""
    fd = os.open(p, os.O_RDONLY | os.O_NONBLOCK)
    try:
        fcntl.ioctl(fd, EVIOCSCLOCKID, struct.pack("i", CLOCK_BOOTTIME))
        return fd, True
    except OSError as e:
        log("%s: no CLOCK_BOOTTIME stamps (%s), the read time stands in" % (p, e.strerror))
        return fd, False


def run(once):
    devices, buf, rescan, cd = {}, {}, 0.0, None
    for line in config()[1]:
        log(line)

    def hold(on):                                # EVIOCGRAB on the devices read here; one that is held elsewhere stays as it is
        for fd, _, _ in devices.values():
            try:
                fcntl.ioctl(fd, EVIOCGRAB, 1 if on else 0)
            except OSError:
                pass

    ctl = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    try:
        if os.path.exists(CTL):
            os.unlink(CTL)
        ctl.bind(CTL)
    except OSError as e:
        log("%s: %s -- the launcher cannot hand the power key on" % (CTL, e.strerror), "<4>")
    while True:
        conf, _ = config()
        if time.monotonic() >= rescan:
            want = power_key_devices(conf)
            for p in set(devices) - set(want):
                os.close(devices.pop(p)[0])
            for p in want:
                if p not in devices:
                    try:
                        devices[p] = open_device(p) + (Key(),)
                        log("listening on %s" % p)
                    except OSError as e:
                        log("%s: %s" % (p, e.strerror))
            rescan = time.monotonic() + 5
        long_ns, ignore_ns = int(float(conf["long_s"]) * 1e9), int(float(conf["ignore_s"]) * 1e9)
        ready = select.select([d[0] for d in devices.values()] + [ctl], [], [], 0.1 if cd else 0.25)[0]
        actions = []
        word = ctl.recv(64).strip() if ctl in ready else b""
        if word == b"short":
            actions.append("short")              # the launcher took the press (h713-keys)
        elif word == b"down":
            # The launcher or a page of h713-settings took the press and let the devices go: this loop never saw Power go down, so
            # the 3 s of a long press could not run. Start it here on the device that has the key down; the release (or the
            # 3 s) then decides, as for any press. A key that is up already, or a device that cannot say, is a short press.
            t = time.clock_gettime_ns(CLOCK_BOOTTIME)
            pressed = [key for fd, _, key in devices.values() if key_down(fd)]
            for key in pressed:
                key.down, key.fired = t, False
            if not pressed:
                actions.append("short")
        for p, (fd, stamped, key) in list(devices.items()):
            now = time.clock_gettime_ns(time.CLOCK_BOOTTIME)
            if fd in ready:
                try:
                    chunk = os.read(fd, EVENT.size * 64)
                except OSError as e:
                    if e.errno == errno.EAGAIN:
                        continue
                    chunk = b""
                if not chunk:                    # the device went away (a remote disconnected)
                    os.close(fd)
                    del devices[p]
                    rescan = time.monotonic() + 1
                    continue
                data = buf.pop(p, b"") + chunk
                n = len(data) - len(data) % EVENT.size
                buf[p] = data[n:]
                for sec, usec, typ, code, value in EVENT.iter_unpack(data[:n]):
                    if typ == EV_KEY and code == KEY_POWER:
                        ts = sec * 10**9 + usec * 1000 if stamped else now
                        actions.append(key.event(ts, value, long_ns, ignore_ns, arisc_state()))
                    elif typ == EV_KEY and value == 1 and cd is not None:
                        actions.append({"act": "now", "cancel": "cancel"}.get(cd.key(code)))
            actions.append(key.tick(now, long_ns))
        if cd is not None:
            if "long" in actions:
                cd.close(False)
                cd = None
            elif "cancel" in actions:
                log("countdown cancelled (Back): the projector stays on")
                cd.close(True)
                cd, actions = None, []
            elif "now" in actions or "short" in actions or cd.left() <= 0:
                choice = cd.choice
                log("countdown: %s (%s)" % (choice, "time up" if cd.left() <= 0 else "chosen"))
                cd.close(False)
                cd = None
                actions = [("short", choice)]
            else:
                cd.frame()
                actions = []
        elif "short" in actions and not resuming():
            cd = Countdown(conf, hold=hold)
            if cd.start():
                log("short press: countdown of %d s, %s chosen%s" % (COUNTDOWN_S, cd.choice,
                    ", no standby on this image or board" if cd.only else ""))
                actions = [a for a in actions if a == "long"]
                if not actions:
                    continue
                cd.close(False)
            cd = None
        for what in filter(None, actions):
            choice = None
            if isinstance(what, tuple):
                what, choice = what
            if what not in ("short", "long"):
                continue
            slept = act(what, conf, choice)
            if once:
                ctl.close()
                return 0
            if slept:
                drop_queued(devices, buf)        # and the rest of this round's actions with it
                break


def set_value(key, value):
    """power.conf with KEY = VALUE: the key's first line replaced, a later one dropped (it would win), comments
    kept; appended when the key is missing. Written to a new file and renamed over the old one. An old `short`
    line is the same key as `default` and is replaced by it."""
    key = ALIASES.get(key, key)
    if not valid(key, value):
        if key in DEFAULTS:
            hint = "|".join(CHOICES[key]) if key in CHOICES else "seconds"
            print("h713-power: %s = %s: not valid, %s takes %s" % (key, value, key, hint), file=sys.stderr)
        else:
            print("h713-power: no key %r, power.conf has %s" % (key, ", ".join(DEFAULTS)), file=sys.stderr)
        return 2
    p = path("etc/h713/power.conf")
    out, done = [], False
    for line in read(p).splitlines():
        k = line.split("#", 1)[0].partition("=")[0].strip()
        if ALIASES.get(k, k) != key:
            out.append(line)
        elif not done:
            out.append("%s = %s" % (key, value))
            done = True
    if not done:
        out.append("%s = %s" % (key, value))
    try:
        os.makedirs(os.path.dirname(p), exist_ok=True)
        with open(p + ".new", "w") as f:
            f.write("\n".join(out) + "\n")
            f.flush()
            os.fsync(f.fileno())
        os.replace(p + ".new", p)
    except OSError as e:
        print("h713-power: %s not written: %s" % (p, e.strerror), file=sys.stderr)
        return 1
    print("%s = %s (from the next press on, no restart needed)" % (key, value))
    return 0


def power_off_path(state):
    """What a power-off does on this board: crust's, when its build says it can, else U-Boot's gate."""
    try:
        able = int(state.get("build2", "0"), 16) & BUILD2_POWER_OFF
    except ValueError:
        able = 0
    if able:
        return "crust (rails off, about 0.3 W; the key or the remote wakes into a fresh boot)"
    return "the power-on gate (U-Boot waits for the key)"


def status():
    conf, bad = config()
    for line in bad:
        print(line)
    print("config: " + ", ".join("%s = %s" % kv for kv in conf.items()))
    print("mem_sleep: %s" % (read(path("sys/power/mem_sleep")) or "-"))
    state = arisc_state()
    print("crust: ready=%s wake=%s" % (state.get("ready", "-"), state.get("wake", "-")))
    print("display MIPS: %s" % (mips_state() or "- (no sun50i-h713-mips driver)"))
    why = standby_unavailable()
    print("standby: %s" % ("offered in the countdown" if why is None else "not offered (%s)" % why))
    print("a short press now: a %d s countdown on %s (at once without a picture)" % (
        COUNTDOWN_S, conf["default"] if why is None else "poweroff"))
    print("a power-off: %s" % power_off_path(state))
    print("power key devices: %s" % (" ".join(power_key_devices(conf)) or "none"))
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(prog="h713-power", description=__doc__.split("\n\n")[1])
    sub = p.add_subparsers(dest="command", required=True)
    sub.add_parser("run", help="decide every KEY_POWER (the unit runs this)").add_argument(
        "--once", action="store_true", help="exit after the first action")
    sub.add_parser("status", help="what a short press would do now, and why")
    sub.add_parser("can-standby", help="exit 0 when a standby can happen now (the launcher's Standby entry asks)")
    s = sub.add_parser("set", help="change one key of power.conf, e.g. 'set default standby'")
    s.add_argument("key", help=", ".join(DEFAULTS))
    s.add_argument("value")
    a = p.parse_args(argv)
    if a.command == "run":
        return run(a.once)
    if a.command == "can-standby":
        why = standby_unavailable()
        print("a standby can happen" if why is None else "no standby: %s" % why)
        return 0 if why is None else 1
    return set_value(a.key, a.value) if a.command == "set" else status()


if __name__ == "__main__":
    sys.exit(main())
