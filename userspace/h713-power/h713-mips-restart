#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
#
# h713-mips-restart [FIRMWARE] - start the display MIPS again and bring the HDMI picture back.
# A standby parks the MIPS (cpu_comm suspend_late); h713-power runs this after a standby when sun50i-h713-mips
# says "parked" (docs/tools/h713-power.md), by hand it also reloads a running MIPS. Measured at the HY310 from a
# running MIPS and the park (08.10.2026) and after real standbys (09.10.2026): stop h713-warp and h713-tv@*,
# unbind the HDMI receiver, write FIRMWARE (default /boot/mips/display.bin) to the driver's restart file
# (running: halt, load, start like the vendor; parked: load, start like U-Boot), bind the receiver, wait up to
# 60 s for its video node, start h713-tv@ on it and h713-warp again, then rebuild the audio DSP, which the
# standby powered off (msp "error"; up to three attempts, five of five within two, 09.10.2026). Before the stop
# the unit h713-wall-hold runs h713-tv --hold-wall, and h713-tv goes first: the wall stays black, not the console,
# until h713-tv's next picture or page (TODO 2.96); a run that brings no picture back stops it, the console is back.
# The receiver is unbound only when no process holds its node (an unbind under an open node frees memory the
# close still uses) and bound again only on a running MIPS, through h713-hdcp-key --bind where it can (a plain
# bind loses the HDCP 2.2 key). Whatever ends the run, warp and tv come back as far as the MIPS allows; the
# sysfs writes ignore signals, and whether the receiver is bound is read from sysfs each time.
# Exit (each with a journal line): 0 picture path back; 1 the driver did not bring the MIPS up;
# 2 refused, MIPS untouched; 3 the MIPS runs, but receiver, node or a service did not; 4 a signal.
# Tests only: H713_ROOT goes before /sys, /proc, /run, FIRMWARE and KEY; H713_WAIT replaces 60 s.
set -u
R=${H713_ROOT:-} FW=${1:-/boot/mips/display.bin} WAIT=${H713_WAIT:-60} RX=hdmi-rx KEY=/usr/local/sbin/h713-hdcp-key
RXD=$R/sys/bus/platform/drivers/sun50i-h713-hdmirx HOLD=h713-wall-hold.service warp=0 n=

say() {	# LEVEL TEXT - a journal line (-t h713-mips-restart); run by hand also on stderr
	[ -n "${JOURNAL_STREAM:-}" ] || echo "h713-mips-restart: $2" >&2
	logger -t h713-mips-restart -p "user.$1" -- "$2" 2>/dev/null || :
}
state() { set -- $(cat "$ST" 2>/dev/null); echo "$*"; }
ms() { echo $(( $(date +%s%N) / 1000000 )); }
put() { out=$(trap '' INT TERM HUP; env printf '%s\n' "$1" 2>&1 > "$2"); }	# VALUE FILE; error text in $out
bind() {	# the receiver, through h713-hdcp-key --bind with the HDCP 2.2 key; if it fails, a plain bind (TODO 5.14 U5)
	grep -qs -e --bind "$R$KEY" || { put "$RX" "$RXD/bind"; return; }
	(trap '' INT TERM HUP; exec "$R$KEY" --bind "$RX") >&2; out="h713-hdcp-key --bind: exit $?"
	case $out in *" 0") ;; *" 3") say warning "$RX bound without the HDCP 2.2 key" ;;
	*) k=$out; [ -e "$RXD/$RX" ] || put "$RX" "$RXD/bind" || return 1; say warning "$k: $RX bound without the HDCP 2.2 key" ;; esac
}
node() {	# the receiver's videoN, by the name 99-h713-tv.rules matches
	for f in "$R"/sys/class/video4linux/video*/name; do
		[ "$(cat "$f" 2>/dev/null)" = sun50i-h713-hdmirx ] && { f=${f%/name}; echo "${f##*/}"; return; }
	done
}
holders() {	# the PIDs that hold /dev/$1 open
	for f in "$R"/proc/[0-9]*/fd/*; do
		[ "$(readlink "$f" 2>/dev/null)" = "/dev/$1" ] && { f=${f#"$R"/proc/}; echo "${f%%/*}"; }
	done | sort -u | tr '\n' ' '
}
dsp() {	# the audio DSP after a standby: msp "error" -> rebuild, up to three times; a warning, never the exit code
	for m in "$R"/sys/bus/platform/drivers/sun50i-h713-msp/*/state; do [ "$(head -n1 "$m" 2>/dev/null)" = error ] || return 0; done
	[ -e "$m" ] || return 0
	for i in 1 2 3; do put 1 "${m%/state}/reset" && [ "$(head -n1 "$m")" = running ] && { say notice "audio DSP rebuilt (attempt $i)"; return 0; }; done
	say warning "the audio DSP did not come back in 3 attempts: no HDMI audio until a reboot"
}
fin() {	# on every exit: the receiver back on a running MIPS, the services back
	rc=$?
	trap '' INT TERM HUP
	s=$(state)
	if [ ! -e "$RXD/$RX" ]; then
		if [ "${s%% *}" != running ]; then say warning "$RX stays unbound: the MIPS is ${s:-not known}"
		elif ! bind; then say warning "bind of $RX failed ($out)"; [ "$rc" != 0 ] || rc=3; fi
	fi
	n=$(node)
	systemctl reset-failed h713-warp.service 'h713-tv@*.service' 2>/dev/null	# StartLimitBurst=3 in 60 s
	[ -z "$n" ] || systemctl start "h713-tv@$n.service" || { say warning "h713-tv@$n did not start"; [ "$rc" != 0 ] || rc=3; }
	[ "$warp" = 0 ] || systemctl start h713-warp.service || { say warning "h713-warp did not start"; [ "$rc" != 0 ] || rc=3; }
	[ "$rc" != 0 ] || { say notice "picture path back after $(( $(ms) - t0 )) ms: MIPS $s, /dev/$n"; dsp; }
	[ "$rc" = 0 ] || systemctl stop --no-block "$HOLD" 2>/dev/null	# no picture to come: the console now, not after its wait
	exit "$rc"
}

case $FW in /*) ;; *) say err "refused: FIRMWARE must be an absolute path, not '$FW'"; exit 2 ;; esac
for ST in "$R"/sys/bus/platform/drivers/sun50i-h713-mips/*/state; do break; done
[ -e "$ST" ] || { say err "refused: no sun50i-h713-mips driver bound (no state file)"; exit 2; }
[ -r "$R$FW" ] || { say err "refused: $FW is not readable"; exit 2; }
exec 9> "$R/run/h713-mips-restart.lock"
flock -n 9 || { say err "refused: another h713-mips-restart runs"; exit 2; }
t0=$(ms)
if systemctl is-active --quiet h713-warp.service; then warp=1; fi
trap fin EXIT
trap 'say warning "ended by a signal"; exit 4' INT TERM HUP
say notice "MIPS $(state); firmware $FW"
systemd-run -q --collect -u "$HOLD" -p Type=notify -p TimeoutStartSec=5 /usr/local/sbin/h713-tv --hold-wall || say warning "the wall is not held"
systemctl stop 'h713-tv@*.service' || say warning "systemctl stop h713-tv@* failed"	# first: a warp's release gave the console
systemctl stop h713-warp.service || say warning "systemctl stop h713-warp failed"
n=$(node)
if [ -n "$n" ]; then
	p=$(holders "$n")
	[ -z "$p" ] || { say err "refused: PID ${p% } holds /dev/$n open, an unbind would free memory in use"; exit 2; }
fi
[ ! -e "$RXD/$RX" ] || put "$RX" "$RXD/unbind" || { say err "refused: unbind of $RX failed ($out)"; exit 2; }
put "$FW" "${ST%/state}/restart" || { say err "the driver refused the restart ($out); MIPS $(state)"; exit 1; }
s=$(state)
[ "${s%% *}" = running ] || { say err "the MIPS did not come up: ${s:-no state}"; exit 1; }
bind || { say err "the MIPS runs, but binding $RX failed ($out)"; exit 3; }
end=$(( $(ms) + WAIT * 1000 ))
until n=$(node); [ -n "$n" ]; do
	[ "$(ms)" -lt "$end" ] || { say err "the MIPS runs, but $RX shows no video node within $WAIT s"; exit 3; }
	sleep 0.2
done
exit 0
