<?xml version="1.0" encoding="UTF-8"?>
<!-- The power key is h713-power's (profile desktop). Kodi under cage reads
     the same key through libinput while h713-power reads it from evdev, and Kodi's own keyboard.xml maps it to
     ActivateWindow(ShutdownMenu): Kodi opened its power menu while h713-power was already taking the projector into standby
     (Marco, 15.10.2026). noop leaves the key to h713-power. Kodi reads every file in userdata/keymaps/ over its defaults.
     The volume keys are h713-keys' as well: h713-tv runs under Kodi, h713-keys sets the DSP volume with h713-osd's
     overlay over Kodi's picture, and Kodi stays at 100 - one place for the volume. -->
<keymap>
  <global>
    <keyboard>
      <power>noop</power>
      <volume_up>noop</volume_up>
      <volume_down>noop</volume_down>
      <volume_mute>noop</volume_mute>
    </keyboard>
  </global>
</keymap>
