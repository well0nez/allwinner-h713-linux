#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
#
# h713-kodi-switch quit PID - leaving Kodi cleanly (h713-kodi.service ExecStop=; profile desktop, media side project,
# packages F-opt, G): ask Kodi to quit over its JSON-RPC (TCP 127.0.0.1:9090, guisettings.xml) and wait up to 15 s for
# cage (PID) to end with it. Kodi then quits like from its own menu and keeps its state; whatever is left gets systemd's
# SIGTERM afterwards, as before. Since package G the way back to the HDMI input is `h713-tv ctl source hdmi` in the unit:
# h713-tv and h713-warp keep running under Kodi, there is nothing to start again.
case ${1:-} in
quit)
	printf '{"jsonrpc":"2.0","id":1,"method":"Application.Quit"}' | nc -N -w 2 127.0.0.1 9090 >/dev/null 2>&1
	i=0
	while kill -0 "${2:-0}" 2>/dev/null && [ "$i" -lt 75 ]; do sleep 0.2; i=$((i + 1)); done ;;
*)
	echo "usage: h713-kodi-switch quit PID" >&2; exit 2 ;;
esac
