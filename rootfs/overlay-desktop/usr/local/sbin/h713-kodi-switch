#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
#
# h713-kodi-switch quit PID | back - the two halves of leaving Kodi (h713-kodi.service; profile desktop, media side project,
# package F-opt).
#   quit PID  ExecStop=: ask Kodi to quit over its JSON-RPC (TCP 127.0.0.1:9090, guisettings.xml) and wait up to 15 s for
#             cage (PID) to end with it. Kodi then quits like from its own menu and keeps its state; whatever is left gets
#             systemd's SIGTERM afterwards, as before.
#   back      ExecStopPost=: the HDMI side back on the panel, h713-tv@<node> on the HDMI receiver's video node and h713-warp.
#             --no-block: when Kodi ended because one of them was being started (Conflicts=, e.g. h713-mips-restart after a
#             standby), the jobs merge with that start; during a shutdown systemd refuses them, which is right (the unit
#             ignores the exit status). Without a receiver node (MIPS down) only h713-warp, as at boot.
case ${1:-} in
quit)
	printf '{"jsonrpc":"2.0","id":1,"method":"Application.Quit"}' | nc -N -w 2 127.0.0.1 9090 >/dev/null 2>&1
	i=0
	while kill -0 "${2:-0}" 2>/dev/null && [ "$i" -lt 75 ]; do sleep 0.2; i=$((i + 1)); done ;;
back)
	for d in /sys/class/video4linux/video*; do
		[ "$(cat "$d/name" 2>/dev/null)" = sun50i-h713-hdmirx ] || continue
		exec systemctl start --no-block "h713-tv@${d##*/}.service" h713-warp.service
	done
	echo "h713-kodi-switch: no HDMI receiver node, starting h713-warp only" >&2
	exec systemctl start --no-block h713-warp.service ;;
*)
	echo "usage: h713-kodi-switch quit PID | back" >&2; exit 2 ;;
esac
