#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
#
# h713-kodi-switch quit PID - leaving Kodi cleanly (h713-kodi.service ExecStop=; profile desktop): ask Kodi to quit over
# its JSON-RPC (TCP 127.0.0.1:9090, appliance.xml) and wait up to 15 s for
# cage (PID) to end with it. Kodi then quits like from its own menu and keeps its state; whatever is left gets systemd's
# SIGTERM afterwards, as before. h713-tv and h713-warp keep running under Kodi, so there is nothing to start
# again: once cage is gone and no other program says it starts, h713-warp puts h713-tv's source back to `auto` and the ring
# comes back by itself.
#
# h713-kodi-switch source - the start of a mode unit (Kodi, the browser, the desktop; ExecStartPre=+, as root: h713-tv's socket
# is root's): `h713-tv ctl source client` - a program is the mode now. Its picture only, never the HDMI ring: h713-warp keeps the
# last picture on the panel while the program starts and between two programs (said again by the next one's start), until the
# program's first picture. Without h713-tv's socket there is nothing to tell: it has not started yet (the first seconds
# after the boot, the 5 s after a crash) and comes up on `auto` by the desktop profile's tv.conf. A socket that is there and
# an h713-tv that does not answer is an error of the start.
# h713-kodi-switch ready - exit 0 once Kodi answers its JSON-RPC, which it does when its home screen is up, AND h713-warp holds a
# picture of Kodi's that came after that answer (the launcher's "Starting Kodi...": launcher.d/20-kodi.conf, `wait`): cage's own
# first picture is black and comes 0.8 s after the start, so a picture alone is not Kodi's; the answer alone came before Kodi's
# picture was on the panel. The launcher's page then goes, and its end rides on that picture (h713-warp draws it at the page's end).
# Tests only: H713_ROOT goes before /run, H713_TV and H713_WARP replace the tools, H713_KODI_PORT the JSON-RPC port.
R=${H713_ROOT:-}
P=${H713_KODI_PORT:-9090}      # Kodi's JSON-RPC; tests only
WARP=${H713_WARP:-/usr/local/bin/h713-warp}
pictures() { "$WARP" ctl picture 2>/dev/null | sed -n 's/^ok \([0-9][0-9]*\) .*/\1/p'; }
case ${1:-} in
source)
	[ -S "$R/run/h713-tv/ctl" ] || exit 0
	exec "${H713_TV:-/usr/local/sbin/h713-tv}" ctl source client ;;
ready)
	printf '{"jsonrpc":"2.0","id":1,"method":"JSONRPC.Ping"}' | nc -N -w 2 127.0.0.1 $P 2>/dev/null | grep -q pong || exit 1
	n=$(pictures)
	[ -n "$n" ] || exit 1
	# a picture after the answer: Kodi's home screen draws on (its menu ~20 a second); 0.5 s at most, within h713-keys' 3 s
	i=0
	while [ "$i" -lt 10 ]; do
		m=$(pictures)
		[ -n "$m" ] && [ "$m" -gt "$n" ] && exit 0
		sleep 0.05
		i=$((i + 1))
	done
	exit 1 ;;
quit)
	# Kodi gone already (its own Exit): systemd runs ExecStop anyway, with MAINPID unset - "kill -0 0" would hold the
	# way back to the HDMI input 15 s (measured 15.10.2026)
	[ -n "${2:-}" ] || exit 0
	printf '{"jsonrpc":"2.0","id":1,"method":"Application.Quit"}' | nc -N -w 2 127.0.0.1 $P >/dev/null 2>&1
	i=0
	while kill -0 "${2:-0}" 2>/dev/null && [ "$i" -lt 75 ]; do sleep 0.2; i=$((i + 1)); done ;;
*)
	echo "usage: h713-kodi-switch quit PID | source | ready" >&2; exit 2 ;;
esac
