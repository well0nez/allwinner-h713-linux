# h713-kodi.service - Kodi under cage on the panel (profile desktop; media side project, package F).
#
# Not wanted by anything, on purpose: the panel belongs to the HDMI input (h713-tv, h713-warp) until somebody stops them and
# starts this unit; cage becomes the DRM master of the display card for as long as it runs. The caller does the switching
# (F8: systemctl stop h713-kodi; systemctl start h713-tv@<node> h713-warp), nothing here knows the node number.
#
# * The VA-API wiring comes from the drop-in h713-kodi.service.d/10-h713-media-env.conf, a symlink to
#   /usr/local/share/h713/systemd/h713-media-env.conf (AU-32, M2 Auflage 4): LIBVA_DRIVER_NAME and LIBVA_DRIVERS_PATH reach
#   kodi.bin; check with /proc/<pid of kodi.bin>/environ.
# * Sound: Debian's /usr/bin/kodi turns KODI_AE_SINK=ALSA into --audio-backend=alsa (deprecated spelling, still honoured), so
#   Kodi never talks to PipeWire or PulseAudio even though it links both (M2 Auflage 5). The device is ALSA `default` (the DSP
#   bridge, /etc/asound.conf), set in userdata/guisettings.xml.
# * No V4L2_REQUEST_SCALE here (M2 Auflage 6): Kodi has no patch that reads the shrunken export size, "panel" would show black.
# * --windowing=wayland: Kodi talks to cage and never opens the display card itself, which would take the DRM master from it.
[Unit]
Description=Kodi under cage on the panel (the display card's DRM master while it runs)
Documentation=file:/usr/local/share/h713/systemd/h713-media-env.conf
Requires=seatd.service
After=seatd.service

[Service]
Type=simple
RuntimeDirectory=h713-kodi
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/h713-kodi
Environment=HOME=/var/lib/h713-kodi
Environment=KODI_TEMP=/tmp/h713-kodi
Environment=KODI_AE_SINK=ALSA
Environment=LIBSEAT_BACKEND=seatd
Environment=WLR_DRM_DEVICES=/dev/dri/by-path/platform-5600000.display-card
Environment=WLR_RENDER_DRM_DEVICE=/dev/dri/by-path/platform-1800000.gpu-render
Environment=WLR_RENDERER=gles2
Environment=WLR_NO_HARDWARE_CURSORS=1
ExecStartPre=/bin/mkdir -p /tmp/h713-kodi
ExecStart=/usr/bin/cage -- /usr/bin/kodi-standalone --windowing=wayland
KillSignal=SIGTERM
TimeoutStopSec=20s
