# h713-kodi.service - Kodi under cage, drawn by h713-warp (profile desktop).
#
# Not wanted by anything, on purpose: the panel shows the HDMI input until somebody starts this unit. Cage is not
# the display card's DRM master: it runs as a Wayland client of
# h713-warp's server (WAYLAND_DISPLAY=/run/h713-warp/wayland, WLR_BACKENDS=wayland,libinput), passes Kodi's pictures
# through, and h713-warp draws them through the keystone onto the video plane while h713-tv stays the master and the
# only one that commits. So the keystone, the overlays (h713-osd) and the volume keys stay as they are with HDMI.
# * The start sets h713-tv's source to `auto` (h713-kodi-switch source): the client before the ring. The ring stays on
#   the panel while Kodi starts, h713-warp swaps it for cage's first picture, and however Kodi ends - Quit, a crash, a
#   SIGKILL of the whole unit - h713-warp gives the panel back two seconds after cage is gone and the ring is there
#   again. No ExecStopPost: `auto` needs no way back (a SIGKILL of the cgroup skipped ExecStopPost, measured).
#   h713-tv does not keep the source across its own restart, so the desktop profile's tv.conf starts it on `auto` as well
#   (rootfs/build-rootfs.sh): a `systemctl restart h713-tv@...` under a running Kodi leaves Kodi on the panel (h713-warp asks
#   again once a second), and a start of this unit before h713-tv is up needs no command at all. (A crash of h713-tv ends
#   Kodi instead: OnFailure=h713-tv-rescue.service restarts the display MIPS and h713-warp, and BindsTo= below ends this
#   unit.) h713-tv is not ordered before this unit, for the reason h713-warp.service gives (a template instance has no
#   name to order after); the unit tolerates its absence instead. `h713-mode hdmi` leaves the source on `hdmi`; the next
#   start of this unit sets `auto`.
# * BindsTo=h713-warp.service: without the server cage has nothing to draw on; a stop or restart of h713-warp ends Kodi.
# * A stop asks Kodi to quit first (JSON-RPC Application.Quit, ExecStop=) and waits for cage to end with it: a SIGTERM
#   to the whole group lets cage close the socket under a running Kodi, which then aborts without saving its state
#   (measured 15.10.2026).
# * A standby ends Kodi before the sleep and starts it again after the wake: h713-sleep-pre.service remembers that
#   this unit ran (/run/h713-mode.resume) and stops it, h713-sleep-post.service restarts h713-tv and h713-warp (h713-mips-restart)
#   and then this unit - for every way into the sleep, Kodi's own Suspend menu included. Before h713-sleep-pre this unit ended
#   itself with Conflicts=sleep.target, which lost the fact that it had been running.
# * The power key is h713-power's, the volume keys and Home are h713-keys' (with h713-osd's overlay over Kodi, Home opens the
#   launcher): userdata/keymaps/h713-power.xml maps them to nothing in Kodi. While the launcher is open h713-keys holds the
#   remote's devices, so Kodi gets no key at all. The remote's OK and Menu reach Kodi as KEY_ENTER and KEY_COMPOSE
#   (/etc/udev/rules.d/70-h713-remote.rules): xkb gives a client no evdev code above 247, which KEY_OK and KEY_SELECT are.
# * cage reads the remote and the keys itself through libinput and seatd; the warp's server has no wl_seat.
# * Not root: cage and Kodi parse media from outside, load add-ons and answer JSON-RPC on 127.0.0.1:9090, so they run as the
#   system user h713-kodi (usr/lib/sysusers.d/h713-kodi.conf) with the groups the devices ask for: video (seatd's socket,
#   h713-warp's Wayland socket, the decoders' /dev/video* and /dev/media*), render (renderD128), audio (ALSA, the DSP bridge).
#   HOME is the StateDirectory, chowned to the user at the first start; /tmp is private. The hardening is h713-warp.service's
#   without MemoryDenyWriteExecute (Kodi runs Python add-ons). The source command is the one thing that needs root (h713-tv's
#   socket is root's): "+" runs it outside the user and the sandbox. Kodi's own Suspend, Shut down and Restart entries call
#   logind, which lets a caller that is not root do that only when polkit says yes: polkitd is in the profile and
#   /etc/polkit-1/rules.d/50-h713-kodi.rules says yes to this user for those three actions and nothing else. The power key
#   (h713-power) and the launcher's Standby entry stay the other ways in.
#
# * The VA-API wiring comes from the drop-in h713-kodi.service.d/10-h713-media-env.conf, a symlink to
#   /usr/local/share/h713/systemd/h713-media-env.conf.
# * Sound: KODI_AE_SINK=ALSA, the DSP bridge (ALSA `default`, guisettings.xml); h713-tv keeps the HDMI input's sound
#   silent while the client is on the panel (not measured with a client running), the bridge plays on.
# * No V4L2_REQUEST_SCALE here: Kodi gets the full-size picture.
[Unit]
Description=Kodi under cage on the panel (a Wayland client of h713-warp)
Documentation=file:/usr/local/share/h713/systemd/h713-media-env.conf
Requires=seatd.service
After=seatd.service
BindsTo=h713-warp.service
After=h713-warp.service

[Service]
Type=simple
User=h713-kodi
Group=h713-kodi
SupplementaryGroups=video render audio
StateDirectory=h713-kodi
RuntimeDirectory=h713-kodi
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictSUIDSGID=yes
Environment=XDG_RUNTIME_DIR=/run/h713-kodi
Environment=HOME=/var/lib/h713-kodi
Environment=KODI_TEMP=/tmp/h713-kodi
Environment=KODI_AE_SINK=ALSA
Environment=LIBSEAT_BACKEND=seatd
Environment=WAYLAND_DISPLAY=/run/h713-warp/wayland
Environment=WLR_BACKENDS=wayland,libinput
Environment=WLR_RENDER_DRM_DEVICE=/dev/dri/by-path/platform-1800000.gpu-render
Environment=WLR_RENDERER=gles2
ExecStartPre=/bin/mkdir -p /tmp/h713-kodi
ExecStartPre=+/usr/local/sbin/h713-kodi-switch source
ExecStart=/usr/bin/cage -- /usr/bin/kodi-standalone --windowing=wayland
ExecStop=/usr/local/sbin/h713-kodi-switch quit $MAINPID
KillSignal=SIGTERM
TimeoutStopSec=20s
