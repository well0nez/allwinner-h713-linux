# h713-kodi.service - Kodi under cage, drawn by h713-warp (profile desktop; media side project, packages F, F-opt, G).
#
# Not wanted by anything, on purpose: the panel shows the HDMI input until somebody starts this unit. Since package G
# (Weg B'', mythos/PRUEFUNG-M3 Nr. 10) cage is no longer the display card's DRM master: it runs as a Wayland client of
# h713-warp's server (WAYLAND_DISPLAY=/run/h713-warp/wayland, WLR_BACKENDS=wayland,libinput), passes Kodi's pictures
# through, and h713-warp draws them through the keystone onto the video plane while h713-tv stays the master and the
# only one that commits. So the keystone, the overlays (h713-osd) and the volume keys stay as they are with HDMI.
# * The start sets h713-tv's source to `auto` (`h713-tv ctl source auto`): the client before the ring. The ring stays on
#   the panel while Kodi starts, h713-warp swaps it for cage's first picture, and however Kodi ends - Quit, a crash, a
#   SIGKILL of the whole unit - h713-warp gives the panel back two seconds after cage is gone and the ring is there
#   again. No ExecStopPost: `auto` needs no way back (M4 A1; a SIGKILL of the cgroup skipped ExecStopPost, G6 Befund 1).
#   tv.conf keeps `source = hdmi` as the start value. h713-tv and h713-warp keep running throughout.
# * BindsTo=h713-warp.service: without the server cage has nothing to draw on; a stop or restart of h713-warp ends Kodi.
# * A stop asks Kodi to quit first (JSON-RPC Application.Quit, ExecStop=) and waits for cage to end with it: a SIGTERM
#   to the whole group lets cage close the socket under a running Kodi, which then aborts without saving its state
#   (F-opt O5).
# * A standby ends Kodi before the sleep and starts it again after the wake (package H): h713-sleep-pre.service remembers that
#   this unit ran (/run/h713-mode.resume) and stops it, h713-sleep-post.service restarts h713-tv and h713-warp (h713-mips-restart)
#   and then this unit - for every way into the sleep, Kodi's own Suspend menu included. Before package H this unit ended
#   itself with Conflicts=sleep.target, which lost the fact that it had been running (AU-74, M3 Nr. 9).
# * The power key is h713-power's, the volume keys and Home are h713-keys' (with h713-osd's overlay over Kodi, Home opens the
#   launcher): userdata/keymaps/h713-power.xml maps them to nothing in Kodi (AU-74, M3 Nr. 8, package H). While the launcher is
#   open h713-keys holds the remote's devices, so Kodi gets no key at all.
# * cage reads the remote and the keys itself through libinput and seatd (F9); the warp's server has no wl_seat.
#
# * The VA-API wiring comes from the drop-in h713-kodi.service.d/10-h713-media-env.conf, a symlink to
#   /usr/local/share/h713/systemd/h713-media-env.conf (AU-32, M2 Auflage 4).
# * Sound: KODI_AE_SINK=ALSA, the DSP bridge (ALSA `default`, guisettings.xml); h713-tv keeps the HDMI input's sound
#   silent while the client is on the panel (M3 Nr. 6), the bridge plays on.
# * No V4L2_REQUEST_SCALE here (M2 Auflage 6).
[Unit]
Description=Kodi under cage on the panel (a Wayland client of h713-warp)
Documentation=file:/usr/local/share/h713/systemd/h713-media-env.conf
Requires=seatd.service
After=seatd.service
BindsTo=h713-warp.service
After=h713-warp.service

[Service]
Type=simple
RuntimeDirectory=h713-kodi
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/h713-kodi
Environment=HOME=/var/lib/h713-kodi
Environment=KODI_TEMP=/tmp/h713-kodi
Environment=KODI_AE_SINK=ALSA
Environment=LIBSEAT_BACKEND=seatd
Environment=WAYLAND_DISPLAY=/run/h713-warp/wayland
Environment=WLR_BACKENDS=wayland,libinput
Environment=WLR_RENDER_DRM_DEVICE=/dev/dri/by-path/platform-1800000.gpu-render
Environment=WLR_RENDERER=gles2
ExecStartPre=/bin/mkdir -p /tmp/h713-kodi
ExecStartPre=/usr/local/sbin/h713-tv ctl source auto
ExecStart=/usr/bin/cage -- /usr/bin/kodi-standalone --windowing=wayland
ExecStop=/usr/local/sbin/h713-kodi-switch quit $MAINPID
KillSignal=SIGTERM
TimeoutStopSec=20s
