#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
#
# zram swap on/off. Called by hy310-zram-swap.service (doku/107, section 4.2).
#
# Three values, nothing more:
#   Algorithm  zstd       best ratio of compression to CPU on this A53
#   Size       half RAM   zram itself takes RAM; offering more than half
#                         as swap is self-defeating
#   Priority   100        higher than any later swap on block devices,
#                         so that pages go out to RAM first
#
# vm.swappiness and vm.page-cluster are in /etc/sysctl.d/99-hy310-zram.conf
# and are not set here - one value, one place.
set -eu

DEV_NODE=/dev/zram0
SYS=/sys/block/zram0
ALGO=zstd
PRIO=100

fail_soft() {
	# No swap is unpleasant, but no reason to make the boot fail: the
	# device should come up completely even with a kernel without
	# CONFIG_ZRAM.
	echo "hy310-zram-swap: $1 - continuing without zram" >&2
	exit 0
}

start() {
	[ -e "$SYS" ] || modprobe zram num_devices=1 2>/dev/null \
		|| fail_soft "zram module cannot be loaded (CONFIG_ZRAM missing?)"
	[ -e "$SYS" ] || fail_soft "$SYS does not appear"

	# Already active? Then do nothing (the unit is RemainAfterExit, but a
	# restart by hand must not run into an error).
	if grep -q "^$DEV_NODE " /proc/swaps 2>/dev/null; then
		echo "hy310-zram-swap: $DEV_NODE is already swap"
		return 0
	fi

	# Half the RAM, in bytes. MemTotal is in kB.
	mem_kb=$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo)
	[ -n "${mem_kb:-}" ] || fail_soft "MemTotal not readable"
	size=$(( mem_kb / 2 * 1024 ))

	# Order matters: comp_algorithm can only be set while disksize is 0.
	echo "$ALGO" > "$SYS/comp_algorithm" 2>/dev/null \
		|| echo "hy310-zram-swap: $ALGO not available, the kernel default stays" >&2
	echo "$size" > "$SYS/disksize"

	mkswap -U clear "$DEV_NODE" >/dev/null
	swapon --priority "$PRIO" --discard "$DEV_NODE"
	echo "hy310-zram-swap: $DEV_NODE, $(( size / 1024 / 1024 )) MiB, $(cat "$SYS/comp_algorithm" 2>/dev/null || echo '?')"
}

stop() {
	grep -q "^$DEV_NODE " /proc/swaps 2>/dev/null && swapoff "$DEV_NODE" || true
	[ -e "$SYS/reset" ] && echo 1 > "$SYS/reset" 2>/dev/null || true
	return 0
}

case "${1:-}" in
	start) start ;;
	stop)  stop ;;
	*) echo "usage: ${0##*/} start|stop" >&2; exit 2 ;;
esac
