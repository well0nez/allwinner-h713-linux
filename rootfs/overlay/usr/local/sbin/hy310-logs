#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
#
# hy310-logs -- der Schalter fuer die Fehlersuche (doku/107-plan-rootfs.md §4.3).
#
#   hy310-logs volatile     Journal in /run/log/journal (tmpfs). Vorgabe.
#                           Die eMMC sieht von den Logs nichts.
#   hy310-logs persistent   Journal nach /data/log, ueber einen Bind-Mount
#                           von /var/log. Logs ueberleben Neustarts.
#   hy310-logs status       was gerade gilt, ohne etwas zu aendern.
#
# Warum ueberhaupt ein Schalter: Storage=volatile ist richtig fuer den
# Dauerbetrieb (jedes vermiedene Schreiben auf diese eMMC ist gewonnen --
# 107 §4), aber es macht die Fehlersuche nach einem Absturz unmoeglich, weil
# genau die letzten Zeilen weg sind. Der Schalter kostet nichts, solange er
# aus ist, und ist genau dann da, wenn man ihn braucht.
#
# Warum /data und nicht direkt /var/log: /data ist das Verzeichnis im Rootfs
# fuer alles Wachsende (107 §4.4). Seit Layout v3 (109 §2.2) ist es KEINE
# eigene Partition mehr -- der Bind-Mount bleibt trotzdem der richtige Weg,
# weil er den Ort der Logs an einer Stelle festlegt und `hy310-logs volatile`
# ihn in einem Schritt wieder aufloest, ohne dass /var/log wandern muss.
#
# Nach jeder Umschaltung ist ein Neustart faellig: journald liest seine
# Konfiguration beim Start, und der Bind-Mount kann nicht unter einem
# laufenden journald aufgezogen werden, ohne dass offene Dateien ins Leere
# zeigen.
set -eu

DROPIN=/etc/systemd/journald.conf.d/10-hy310.conf
MOUNT_UNIT=/etc/systemd/system/var-log.mount
DATA_LOG=/data/log

usage() {
	cat >&2 <<'EOF'
Aufruf: hy310-logs persistent|volatile|status

  persistent  Journal nach /data/log (Bind-Mount auf /var/log), Storage=persistent
  volatile    Journal in /run/log/journal (tmpfs), Storage=volatile  [Vorgabe]
  status      aktuellen Zustand zeigen

Nach persistent/volatile: `reboot`.
EOF
	exit 2
}

need_root() {
	[ "$(id -u)" = 0 ] || { echo "hy310-logs: braucht root" >&2; exit 1; }
}

write_dropin() {
	# $1 = volatile|persistent, $2 = RuntimeMaxUse-Zeile oder SystemMaxUse-Zeile
	mkdir -p "$(dirname "$DROPIN")"
	cat > "$DROPIN" <<EOF
# Erzeugt von hy310-logs ($(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || echo unbekannt)).
# Vorgabe des Abbilds ist Storage=volatile; siehe doku/107-plan-rootfs.md §4.
[Journal]
Storage=$1
$2
EOF
}

write_mount_unit() {
	cat > "$MOUNT_UNIT" <<EOF
# Erzeugt von hy310-logs persistent.
# /var/log liegt dann auf /data -- also im Rootfs, aber nicht im
# Systembereich, und mit einem Handgriff wieder weg.
[Unit]
Description=HY310: /var/log auf $DATA_LOG (hy310-logs persistent)
Before=systemd-journald.service
RequiresMountsFor=/data

[Mount]
What=$DATA_LOG
Where=/var/log
Type=none
Options=bind

[Install]
WantedBy=local-fs.target
EOF
}

state() {
	if [ -r "$DROPIN" ] && grep -qi '^Storage=persistent' "$DROPIN"; then
		echo persistent
	else
		echo volatile
	fi
}

case "${1:-}" in
persistent)
	need_root
	mkdir -p "$DATA_LOG"
	chmod 0755 /data
	# Bestehende Logs mitnehmen, damit der Bind-Mount sie nicht verdeckt.
	# -n: nichts ueberschreiben, was drueben schon liegt.
	if [ -d /var/log ] && ! mountpoint -q /var/log 2>/dev/null; then
		cp -a -n /var/log/. "$DATA_LOG"/ 2>/dev/null || true
	fi
	write_mount_unit
	# SystemMaxUse statt RuntimeMaxUse: das Journal liegt jetzt auf einem
	# Dateisystem, nicht in tmpfs. 128 MiB ist reichlich fuer eine
	# Fehlersuche und weit von den 840 MiB entfernt, die ein unbegrenztes
	# Journal im Netboot-Root in drei Wochen angesammelt hat.
	write_dropin persistent 'SystemMaxUse=128M'
	systemctl daemon-reload
	systemctl enable var-log.mount >/dev/null
	echo "hy310-logs: persistent -- Logs nach $DATA_LOG. Jetzt: reboot"
	;;
volatile)
	need_root
	systemctl disable var-log.mount >/dev/null 2>&1 || true
	rm -f "$MOUNT_UNIT"
	write_dropin volatile 'RuntimeMaxUse=32M'
	systemctl daemon-reload
	echo "hy310-logs: volatile -- Journal in /run/log/journal."
	echo "hy310-logs: $DATA_LOG bleibt liegen; loeschen mit: rm -rf $DATA_LOG"
	echo "hy310-logs: jetzt: reboot"
	;;
status)
	printf 'Modus:        %s\n' "$(state)"
	printf 'Drop-in:      %s\n' "$DROPIN"
	if mountpoint -q /var/log 2>/dev/null; then
		printf '/var/log:     Bind-Mount aktiv (%s)\n' "$DATA_LOG"
	else
		printf '/var/log:     kein Bind-Mount\n'
	fi
	if [ -d /run/log/journal ]; then
		printf 'Journal jetzt: /run/log/journal (%s)\n' \
			"$(du -sh /run/log/journal 2>/dev/null | cut -f1)"
	elif [ -d /var/log/journal ]; then
		printf 'Journal jetzt: /var/log/journal (%s)\n' \
			"$(du -sh /var/log/journal 2>/dev/null | cut -f1)"
	else
		printf 'Journal jetzt: kein Verzeichnis gefunden\n'
	fi
	;;
*)
	usage
	;;
esac
