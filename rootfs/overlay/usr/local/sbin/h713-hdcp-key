#!/usr/bin/env python3
"""h713-hdcp-key - hand the HDCP 2.2 key from the device itself to the driver.

The key lies in the sunxi Secure Storage on the eMMC (partition hy310-keys,
raw at 0x600000 on a stock device). It never leaves the device: the tool reads
it into memory, puts it briefly into a tmpfs, loads the hdmirx driver, which
fetches it with request_firmware() and passes it to the MIPS, and deletes the
file again.

Layout (doku/68): slots of 4 KiB, every item twice (original + copy).
  store_object_t: magic u32 (0x17253948) | id u32 | name[64] | 6 x u32 |
                  actual_len u32 | data[3072] | crc u32          = 3176 bytes
  data:           name[64] | len u32 | 0x10000001 | 1 | payload[len]

  h713-hdcp-key            set the key and load the driver
  h713-hdcp-key --check    only search and check, write nothing
  h713-hdcp-key --bind DEV the driver is loaded and DEV unbound (h713-mips-restart
                           after a new start of the MIPS): bind DEV while the key
                           lies there. Exit 0 bound with the key, 3 bound without
                           it (none found), 1 not bound, 2 no DEV
"""
import os
import signal
import struct
import subprocess
import sys
import zlib

MAGIC = 0x17253948
SLOT = 4096
OBJ = 3176
KOPF = 4 + 4 + 64 + 24 + 4              # up to data[]
DATA = 3072
ITEM = "hdcpkeyV22"
ERWARTET = 912
MODUL = "sun50i-h713-hdmirx"
FW_NAME = "hy310-hdcp22.bin"
FW_DIR = "/run/hy310/firmware"
FW_PATH_PARAM = "/sys/module/firmware_class/parameters/path"
BIND = "/sys/bus/platform/drivers/" + MODUL + "/bind"
PARTLABEL = "/dev/disk/by-partlabel/hy310-keys"
ROH = "/dev/mmcblk0"
ROH_SUCHE = 16 << 20                    # stock device: the block lies in the first 16 MiB


def sag(s):
    print("h713-hdcp-key: " + s, flush=True)


def slots(quelle, laenge):
    """Yield all 4 KiB slots with a valid magic: (offset, object)."""
    with open(quelle, "rb") as fh:
        pos = 0
        while pos < laenge:
            fh.seek(pos)
            b = fh.read(SLOT)
            if len(b) < OBJ:
                break
            if struct.unpack_from("<I", b, 0)[0] == MAGIC:
                yield pos, b[:OBJ]
            pos += SLOT


def objekt_lesen(obj):
    """(name, actual_len, crc_ok, data) from one store_object_t."""
    name = obj[8:72].split(b"\0")[0].decode("ascii", "replace")
    actual_len = struct.unpack_from("<I", obj, KOPF - 4)[0]
    crc_da = struct.unpack_from("<I", obj, OBJ - 4)[0]
    crc_ist = zlib.crc32(obj[:OBJ - 4]) & 0xffffffff
    return name, actual_len, crc_da == crc_ist, obj[KOPF:KOPF + DATA]


def nutzdaten(data, actual_len):
    """Check the inner header and return the payload, else None."""
    innen_name = data[0:64].split(b"\0")[0].decode("ascii", "replace")
    laenge, k1, k2 = struct.unpack_from("<III", data, 64)
    if innen_name != ITEM or k1 != 0x10000001 or k2 != 1:
        return None, "inner header does not match (%r, 0x%x, %d)" % (innen_name, k1, k2)
    if laenge != ERWARTET or 76 + laenge != actual_len:
        return None, "length %d, expected %d (actual_len %d)" % (laenge, ERWARTET, actual_len)
    return data[76:76 + laenge], "ok"


def finden():
    """Find the key. The named partition first, else search the raw device."""
    if os.path.exists(PARTLABEL):
        quelle, laenge = PARTLABEL, os.path.getsize(PARTLABEL) or (1 << 20)
        with open(PARTLABEL, "rb") as fh:
            fh.seek(0, 2)
            laenge = fh.tell()
        sag("Secure Storage: %s (%d KiB)" % (PARTLABEL, laenge // 1024))
    else:
        quelle, laenge = ROH, ROH_SUCHE
        sag("no hy310-keys partition - searching raw in the first %d MiB of %s"
            % (ROH_SUCHE >> 20, ROH))
    treffer = []
    for off, obj in slots(quelle, laenge):
        name, actual_len, crc_ok, data = objekt_lesen(obj)
        if name != ITEM:
            continue
        nutz, grund = nutzdaten(data, actual_len)
        treffer.append((off, crc_ok, nutz, grund))
    if not treffer:
        return None, "item %r not found" % ITEM
    # First a slot whose CRC is good; the copy is the fallback.
    for off, crc_ok, nutz, grund in treffer:
        if crc_ok and nutz is not None:
            sag("item %s at offset 0x%x, CRC good, %d bytes" % (ITEM, off, len(nutz)))
            return nutz, "ok"
    for off, crc_ok, nutz, grund in treffer:
        if nutz is not None:
            sag("WARNING: item %s at 0x%x only with a bad CRC - using it anyway"
                % (ITEM, off))
            return nutz, "crc"
    return None, "; ".join(g for _, _, _, g in treffer)


def modul_geladen():
    with open("/proc/modules") as fh:
        return any(z.split()[0] == MODUL.replace("-", "_") for z in fh)


def binden(geraet):
    """Bind the receiver: its probe runs the init sequence, request_firmware() takes the key."""
    try:
        with open(BIND, "w") as fh:
            fh.write(geraet)
    except OSError as e:
        sag("ERROR: binding %s: %s" % (geraet, e.strerror))
        return False
    return True


def main():
    nur_pruefen = "--check" in sys.argv
    geraet = None
    if "--bind" in sys.argv:
        i = sys.argv.index("--bind")
        if i + 1 >= len(sys.argv):
            sag("usage: h713-hdcp-key --bind DEVICE")
            return 2
        geraet = sys.argv[i + 1]
    try:
        nutz, grund = finden()
    except OSError as e:                # a read error on the eMMC is "no key", not a crash (TODO 5.14 U5)
        nutz, grund = None, "Secure Storage not readable: %s" % (e.strerror or e)
    if nutz is None:
        sag("ERROR: " + grund)
        if geraet:                      # the picture without the 2.2 key rather than none
            return 3 if binden(geraet) else 1
        return 1
    if nur_pruefen:
        sag("check passed - nothing written")
        return 0

    os.makedirs(FW_DIR, mode=0o700, exist_ok=True)
    os.chmod(FW_DIR, 0o700)
    ziel = os.path.join(FW_DIR, FW_NAME)
    # From the moment the file exists, every way out goes through the finally below that deletes it (TODO 5.14,
    # review U3): the write is inside it, and SIGTERM/SIGHUP end the run through it. A signal the caller
    # ignores stays ignored - h713-mips-restart starts this with INT, TERM and HUP ignored on purpose.
    for sig in (signal.SIGTERM, signal.SIGHUP):
        if signal.getsignal(sig) is not signal.SIG_IGN:
            signal.signal(sig, lambda num, frame: sys.exit(128 + num))
    try:
        fd = os.open(ziel, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        try:
            os.write(fd, nutz)
        finally:
            os.close(fd)
        with open(FW_PATH_PARAM, "w") as fh:
            fh.write(FW_DIR)
        if geraet:
            if not binden(geraet):
                return 1
            sag("%s bound, key handed over" % geraet)
            return 0
        if modul_geladen():
            # Only when reloading by hand: at boot h713-tv is not running
            # yet, and the driver is loaded here for the first time.
            sag("driver is already running - stopping h713-tv and reloading it")
            subprocess.run(["systemctl", "stop", "h713-tv@video1.service"],
                           check=False)
            subprocess.run(["modprobe", "-r", MODUL], check=True)
        subprocess.run(["modprobe", MODUL], check=True)
        sag("driver loaded, key handed over")
    finally:
        # The key does not belong in the file system, not even in a tmpfs.
        try:
            os.unlink(ziel)
        except OSError:
            pass
        try:
            with open(FW_PATH_PARAM, "w") as fh:
                fh.write("\n")
        except OSError:
            pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
