[Unit]
Description=H713 clean display stack: h713_drm after sun50i-h713-arisc (h713-display load)
Documentation=file:/usr/local/share/doc/h713-linux/README
# Only on a clean boot: U-Boot's bootcmd puts h713.display=clean on the command line when h713_display=clean
# (docs/subsystems/display-stacks.md). On the vendor stack this unit is skipped and nothing of it runs.
# h713_drm is loaded here, not by udev: the HY320's device tree has its node disabled (bench=1 registers the device),
# and it has to come after the ARISC driver, its EDID/hot-plug provider. Its receiver node h713-hdmirx-clean then
# starts h713-tv@ through 99-h713-tv.rules, as the vendor receiver does.
# When h713_drm cannot load on this kernel, the step sets h713_display back to vendor (the next boot has a picture)
# and the unit fails, so that `systemctl --failed` names it.
ConditionKernelCommandLine=h713.display=clean
DefaultDependencies=no
# The owner's display files are read through /lib/firmware/h713-mips -> /boot/mips (h713-drm.conf); /boot is nofail,
# so local-fs.target does not wait for it. systemd-tmpfiles-setup: /run/lock, where fw_setenv takes its lock when the
# step falls back to vendor.
Wants=boot.mount
After=local-fs.target boot.mount systemd-tmpfiles-setup.service systemd-modules-load.service systemd-udevd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/h713-display load

[Install]
WantedBy=sysinit.target
