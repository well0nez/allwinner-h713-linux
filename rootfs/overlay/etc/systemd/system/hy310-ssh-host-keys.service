# Create the SSH host keys at the first boot.
#
# Without this ALL devices flashed from the same image would have the same
# SSH host keys: the postinst of openssh-server creates them in the chroot,
# that is, at build time. build-rootfs.sh deletes them again; this unit
# creates them at the first boot on the device. The model is
# h713-ssh-host-keys.service from today's netboot root.

[Unit]
Description=HY310: create missing SSH host keys
Before=ssh.service
ConditionPathExists=|!/etc/ssh/ssh_host_ed25519_key

[Service]
Type=oneshot
ExecStart=/usr/bin/ssh-keygen -A
RemainAfterExit=yes

[Install]
WantedBy=ssh.service
