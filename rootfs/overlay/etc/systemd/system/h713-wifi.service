[Unit]
Description=H713 Wi-Fi from /etc/h713/wifi.env (access point, station or off)
Documentation=file:/etc/h713/wifi.env
# The firmware is on the rootfs, the module in the module tree - both need the
# file system. Before network.target, so that "network-online" does not wait
# for eth0 alone when the device runs as a station.
After=local-fs.target systemd-modules-load.service
Before=network.target
Wants=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/h713-wifi up
ExecStop=/usr/local/sbin/h713-wifi down
# A faulty wifi.env is an error of this service, no reason for a loop: the
# message is in the journal, the user fixes the file and restarts. No Restart.

[Install]
WantedBy=multi-user.target
