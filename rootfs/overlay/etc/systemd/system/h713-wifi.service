[Unit]
Description=H713 Wi-Fi from /etc/h713/wifi.env (access point, station or off)
Documentation=file:/etc/h713/wifi.env
# The firmware is on the rootfs, the module in the module tree - both need the
# file system. Before network.target, so that "network-online" does not wait
# for eth0 alone when the device runs as a station.
After=local-fs.target systemd-modules-load.service
Before=network.target
Wants=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/h713-wifi up
ExecStop=/usr/local/sbin/h713-wifi down
# A faulty wifi.env is an error of this service, no reason for a loop: the
# message is in the journal, the user fixes the file and restarts. No Restart.
#
# Type=oneshot defaults to TimeoutStartSec=infinity, and this unit sits before
# network.target: a radio that hangs in the kernel then holds the whole network
# path for ever, so the box has no address and no ssh (measured 05.10., the
# AIC8800 wedged its SDIO after repeated hard resets and the unit was still
# "running (3min 58s / no limit)"). The script's own waits are bounded; this
# bounds the ones below it. A box without Wi-Fi must still finish booting.
TimeoutStartSec=60
# And the stop after a failed start: a modprobe the script's "timeout 30" gave up on
# stays in this unit's cgroup, and systemd waited the default 90 s for it before the
# boot went on - network.target, ssh and the login came 120 s late (measured
# 12.10.2026 with a simulated hang, arbeit/remote-reihe-20261012 H). One stuck in the
# kernel does not die on SIGKILL either; waiting longer does not help it.
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
