# doku/107, section 4.2 - zram as SWAP, not for logs.
#
# Armbian's way (zram block device, ext4 on it, /var/log there, saved to
# /var/log.hdd at shutdown) solves the same problem but is a construction of
# three moving parts. We solve the logs with Storage=volatile (10-h713.conf)
# and use zram only for what it is really needed for here: absorbing tmpfs
# pressure and making the device sluggish instead of dead when memory is
# short.
#
# Why a unit of our own instead of zram-tools (doku/107, section 6): zram-tools
# brings an init script, a configuration file and a chain of dependencies to
# set three values. The three values are here.

[Unit]
Description=HY310: zram swap (zstd, half the RAM)
Documentation=file:/usr/local/share/doc/hy310/rootfs.md
DefaultDependencies=no
Before=swap.target
After=systemd-modules-load.service
# Without CONFIG_ZRAM there is no /sys/class/zram-control. Then the unit does
# not start at all instead of failing - the kernel cannot do that yet today
# (see modules-load.d/hy310-zram.conf).
ConditionPathExists=/sys/class/zram-control

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/hy310-zram-swap start
ExecStop=/usr/local/sbin/hy310-zram-swap stop

[Install]
WantedBy=swap.target
