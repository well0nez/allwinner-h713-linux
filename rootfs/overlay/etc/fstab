# /etc/fstab - HY310, layout v3 (doku/109-plan-layout-v3.md, section 2.2)
#
# Exactly two entries. Addressing is by PARTLABEL, not by
# /dev/mmcblk0pN: the number depends on how many partitions the GPT happens
# to hold, the label does not. The kernel can do this for the root too
# (block/early-lookup.c: strncmp(name, "PARTLABEL=", 10)), the command line
# carries root=PARTLABEL=hy310-rootfs.
#
# /data is a DIRECTORY in the rootfs, no partition of its own any more
# (doku/109 section 2.2: hy310-data was dropped without replacement, the
# rootfs has 7.15 GiB). That is why there is no third line here.
#
# x-systemd.growfs: the image is built small (default 1 GiB) and grows to the
# full partition at the first boot. Building and transferring a 7.15 GiB
# image would be a pure waste.

PARTLABEL=hy310-rootfs  /      ext4  defaults,noatime,x-systemd.growfs        0  1

# hy310-boot carries mips/, h713-kernel.fit - U-Boot reads them itself, Linux
# only needs them for updating. nofail + short timeout: a device that was
# started over NFS or has an empty boot partition should still come up and
# not fall into the emergency shell.
PARTLABEL=hy310-boot    /boot  ext4  defaults,noatime,nofail,x-systemd.device-timeout=10s  0  2

# /tmp and /var/tmp are tmpfs (doku/107 section 4.4). No line is needed for
# that: systemd brings tmp.mount, and /var/tmp hangs off systemd-tmpfiles. A
# line of its own here would only describe both twice. What counts is that
# the eMMC sees none of it.
