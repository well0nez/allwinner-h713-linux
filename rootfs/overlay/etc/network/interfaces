# Network as today (S41 section 1: the move to the eMMC changes nothing here).
# ifupdown + isc-dhcp-client, no NetworkManager, no systemd-networkd.
#
# allow-hotplug instead of auto: eth0 only appears via sun8i-emac with the
# PHY probe, an "auto" would find nothing at boot.

auto lo
iface lo inet loopback

allow-hotplug eth0
iface eth0 inet dhcp
