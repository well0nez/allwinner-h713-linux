# apt bleibt benutzbar (107 §8). Signed-By zeigt auf das Keyring aus
# debian-archive-keyring; kein trusted=yes, keine unsignierte Quelle.
#
# Die Paketlisten sind NICHT eingebacken: `apt update` beim Bau wuerde rund
# 40 MiB Listen mitliefern, die am ersten Tag veraltet sind. Der erste
# `apt update` am Geraet holt sie -- und braucht dafuer eine gestellte Uhr,
# also entweder Netz (systemd-timesyncd) oder `date -u -s`.

Types: deb
URIs: http://deb.debian.org/debian
Suites: trixie trixie-updates
Components: main
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg

Types: deb
URIs: http://security.debian.org/debian-security
Suites: trixie-security
Components: main
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg
