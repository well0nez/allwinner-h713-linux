# apt stays usable (doku/107 section 8). Signed-By points to the keyring from
# debian-archive-keyring; no trusted=yes, no unsigned source.
#
# The package lists are NOT baked in: `apt update` at build time would ship
# about 40 MiB of lists that are out of date on the first day. The first
# `apt update` on the device fetches them - and needs a clock that is set for
# that, so either network (systemd-timesyncd) or `date -u -s`.

Types: deb
URIs: http://deb.debian.org/debian
Suites: trixie trixie-updates
Components: main
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg

Types: deb
URIs: http://security.debian.org/debian-security
Suites: trixie-security
Components: main
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg
