# /etc/h713/wifi.env -- das WLAN dieses Geraets.
#
# Gelesen von h713-wifi.service beim Start. Nach einer Aenderung:
#
#     systemctl restart h713-wifi
#
# Wer das Rootfs selbst baut, legt seine Fassung vorher als
# rootfs/wifi.env (neben build-rootfs.sh) ab oder gibt --wifi-env DATEI an;
# sie landet dann statt dieser hier im Abbild.
#
# Format: SCHLUESSEL=wert, ein Eintrag je Zeile, keine Leerzeichen um das '='.
# Anfuehrungszeichen und Rueckstriche sind in ssid und password nicht erlaubt.

# ==========================================================================
#  ACHTUNG: Diese Vorgabe ist oeffentlich bekannt.
#
#  Jedes Geraet mit diesem Abbild startet als Zugangspunkt mit derselben SSID
#  und demselben Passwort. Wer das Passwort nicht aendert, laesst jeden in
#  Funkreichweite per SSH auf das Geraet. AENDERN, bevor das Geraet irgendwo
#  steht, wo es nicht nur einen selbst gibt.
# ==========================================================================

# ap   Zugangspunkt: das Geraet spannt ein eigenes Netz auf (Vorgabe).
# sta  Station: das Geraet meldet sich an einem fremden Netz an.
# off  Funk bleibt aus -- der Chip wird dann gar nicht erst eingeschaltet.
mode=ap

# ap:  Name des aufgespannten Netzes (1..32 Zeichen).
# sta: Name des Netzes, an dem sich das Geraet anmeldet.
ssid=h713

# ap:  WPA2-Passwort, 8..63 Zeichen, Pflicht -- ein offener Zugangspunkt wird
#      nicht aufgespannt.
# sta: Passwort des fremden Netzes; leer lassen fuer ein offenes Netz.
password=magcubic

# Nur ap. Frequenzband und Kanal.
#   band=2.4  Kanal 1..13   -- groessere Reichweite, jedes Endgeraet kann es
#   band=5    Kanal 36..48  -- rund dreimal schneller (am Geraet gemessen:
#             13 MB/s statt 5), kuerzere Reichweite, nicht jedes Endgeraet
#             kann es. Nur die radarfreien Kanaele 36-48 sind erlaubt.
band=2.4
channel=6

# Regulierungsdomaene, ISO-3166-Laenderkuerzel (DE, US, GB, ...). Bestimmt,
# welche Kanaele und Sendeleistungen das Funkteil benutzt. Fuer das Land
# eintragen, in dem das Geraet steht -- das ist keine Formsache.
country=DE

# Nur ap. Adresse des Geraets im eigenen Netz und der Bereich, den es an
# Clients vergibt. Muss nur geaendert werden, wenn 192.168.4.0/24 kollidiert.
ap_ip=192.168.4.1
ap_dhcp_start=192.168.4.10
ap_dhcp_end=192.168.4.100
