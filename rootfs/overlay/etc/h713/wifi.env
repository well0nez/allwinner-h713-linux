# /etc/h713/wifi.env - the Wi-Fi of this device.
#
# Read by h713-wifi.service at start. After a change:
#
#     systemctl restart h713-wifi
#
# If you build the rootfs yourself, put your version beforehand at
# rootfs/wifi.env (next to build-rootfs.sh) or give --wifi-env FILE;
# it then lands in the image instead of this one.
#
# Format: KEY=value, one entry per line, no spaces around the '='.
# Quotes and backslashes are not allowed in ssid and password.

# ==========================================================================
#  WARNING: This default is public.
#
#  Every device with this image starts as an access point with the same SSID
#  and the same password. Anyone who does not change the password lets
#  everybody in radio range into the device by SSH. CHANGE IT before the
#  device stands anywhere it isn't only you.
# ==========================================================================

# ap   access point: the device opens a network of its own (the default).
# sta  station: the device joins somebody else's network.
# off  the radio stays off - the chip is then not even switched on.
mode=ap

# ap:  name of the network it opens (1..32 characters).
# sta: name of the network the device joins.
ssid=h713

# ap:  WPA2 password, 8..63 characters, required - an open access point is
#      not started.
# sta: password of the other network; leave empty for an open network.
password=magcubic

# ap only. Frequency band and channel.
#   band=2.4  channel 1..13   - longer range, every client can do it
#   band=5    channel 36..48  - about three times as fast (measured on the
#             device: 13 MB/s instead of 5), shorter range, not every client
#             can do it. Only the radar-free channels 36-48 are allowed.
band=2.4
channel=6

# Regulatory domain, ISO 3166 country code (DE, US, GB, ...). It decides
# which channels and transmit powers the radio uses. Enter the country the
# device stands in - this is not a formality. If left empty, the driver's own
# default 00 (world) is used and a warning is logged.
country=DE

# ap only. The device's own address on its network and the range it hands out
# to clients. Only needs changing if 192.168.4.0/24 collides.
ap_ip=192.168.4.1
ap_dhcp_start=192.168.4.10
ap_dhcp_end=192.168.4.100
