-				   uint32_t mem_type, uint32_t flags,
-				   void *descriptor)
+static VAStatus export_surface_handle(VADriverContextP va_ctx,
+				      VASurfaceID surface_id,
+				      uint32_t mem_type, uint32_t flags,
+				      void *descriptor)
 {
 	struct v4l2r_driver *drv = v4l2r_driver(va_ctx);
 	struct v4l2r_surface *surface;
@@ -790,6 +838,21 @@ VAStatus v4l2r_ExportSurfaceHandle(VADriverContextP va_ctx, VASurfaceID surface_
 	return fill_prime_descriptor(&view, flags, descriptor);
 }
 
+VAStatus v4l2r_ExportSurfaceHandle(VADriverContextP va_ctx, VASurfaceID surface_id,
+				   uint32_t mem_type, uint32_t flags,
+				   void *descriptor)
+{
+	struct v4l2r_driver *drv = v4l2r_driver(va_ctx);
+	VAStatus status;
+
+	pthread_rwlock_rdlock(&drv->view_lock);
+	status = export_surface_handle(va_ctx, surface_id, mem_type, flags,
+				       descriptor);
+	pthread_rwlock_unlock(&drv->view_lock);
+
+	return status;
+}
