diff --git a/src/context.c b/src/context.c
index 26162ea..47c7d0b 100644
--- a/src/context.c
+++ b/src/context.c
@@ -889,6 +889,18 @@ VAStatus v4l2r_DestroyContext(VADriverContextP va_ctx, VAContextID context_id)
 	if (!ctx)
 		return VA_STATUS_ERROR_INVALID_CONTEXT;
 
+	/* Finish what was submitted, so frames a client still holds are
+	 * complete when DestroyContext hands them to their surfaces below;
+	 * STREAMOFF would discard them. A held-back frame is submitted first. */
+	if (ctx->codec && ctx->codec->flush) {
+		pthread_mutex_lock(&ctx->codec_lock);
+		ctx->codec->flush(ctx, NULL);
+		pthread_mutex_unlock(&ctx->codec_lock);
+	}
+	for (unsigned int i = 0; i < ctx->nb_captures; i++)
+		if (ctx->captures[i].surface)
+			v4l2r_sync_capture(ctx, i);
+
 	if (ctx->video_fd >= 0 && ctx->streaming) {
 		type = ctx->output_format.type;
 		ioctl(ctx->video_fd, VIDIOC_STREAMOFF, &type);
@@ -902,8 +914,20 @@ VAStatus v4l2r_DestroyContext(VADriverContextP va_ctx, VAContextID context_id)
 	for (unsigned int i = 0; i < V4L2R_OUTPUT_BUFFERS; i++)
 		output_buffer_cleanup(ctx, &ctx->output[i]);
 
-	for (unsigned int i = 0; i < ctx->nb_captures; i++)
-		capture_buffer_cleanup(ctx, &ctx->captures[i]);
+	pthread_rwlock_wrlock(&drv->view_lock);
+
+	/* Decoded frames outlive their context (see
+	 * v4l2r_surface_adopt_capture); a frame mid-decode has no content
+	 * worth keeping. */
+	for (unsigned int i = 0; i < ctx->nb_captures; i++) {
+		struct v4l2r_capture_buffer *capture = &ctx->captures[i];
+
+		if (capture->surface &&
+		    capture->surface->status == VASurfaceReady)
+			v4l2r_surface_adopt_capture(capture->surface, ctx,
+						    capture);
+		capture_buffer_cleanup(ctx, capture);
+	}
 
 	/* Detach surfaces that were attached but never bound. */
 	pthread_mutex_lock(&drv->mutex);
@@ -915,6 +939,8 @@ VAStatus v4l2r_DestroyContext(VADriverContextP va_ctx, VAContextID context_id)
 	}
 	pthread_mutex_unlock(&drv->mutex);
 
+	pthread_rwlock_unlock(&drv->view_lock);
+
 	if (ctx->video_fd >= 0)
 		close(ctx->video_fd);
 	if (ctx->media_fd >= 0)
