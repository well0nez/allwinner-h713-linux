diff --git a/src/surface.c b/src/surface.c
index f7fe03d..afa38a5 100644
--- a/src/surface.c
+++ b/src/surface.c
@@ -278,6 +278,53 @@ void v4l2r_surface_free_backing(struct v4l2r_surface *surface)
 	surface->backing = NULL;
 }
 
+/*
+ * The context that decoded into this surface is going away, but the surface
+ * is not: FFmpeg destroys the old context on a resolution change while frames
+ * from it still sit in its filter queue. Keep the frame by turning the CAPTURE
+ * buffer into the surface's standalone backing. Its dma-buf fds and mapping
+ * move over instead of being closed, and they keep the vb2 memory alive after
+ * the queue is freed. Returns false (and takes nothing) if the surface already
+ * has backing of its own, as the converter's destination does.
+ */
+bool v4l2r_surface_adopt_capture(struct v4l2r_surface *surface,
+				 struct v4l2r_context *ctx,
+				 struct v4l2r_capture_buffer *capture)
+{
+	struct v4l2r_surface_backing *backing;
+	const struct v4l2_format *format = &ctx->capture_format;
+	int index = capture - ctx->captures;
+
+	if (surface->backing)
+		return false;
+
+	if (v4l2r_export_capture_dmabufs(ctx, capture, index) < 0)
+		return false;
+
+	backing = calloc(1, sizeof(*backing));
+	if (!backing)
+		return false;
+
+	backing->pixelformat = v4l2r_format_pixelformat(format);
+	backing->width = v4l2r_format_width(format);
+	backing->height = v4l2r_format_height(format);
+	backing->pitch = v4l2r_format_bytesperline(format);
+	backing->nb_planes = capture->nb_planes;
+	for (unsigned int i = 0; i < VIDEO_MAX_PLANES; i++) {
+		backing->dmabuf_fd[i] = -1;
+		if (i >= capture->nb_planes)
+			continue;
+		backing->plane_size[i] = capture->plane_size[i];
+		backing->dmabuf_fd[i] = capture->dmabuf_fd[i];
+		backing->map[i] = capture->map[i];
+		capture->dmabuf_fd[i] = -1;
+		capture->map[i] = NULL;
+	}
+
+	surface->backing = backing;
+	return true;
+}
+
