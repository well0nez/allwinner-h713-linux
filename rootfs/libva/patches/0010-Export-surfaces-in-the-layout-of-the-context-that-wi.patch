+/*
+ * The CAPTURE format @ctx will decode into, worked out on @fd: a throwaway
+ * open of the same device whose OUTPUT format the caller has set to the
+ * context's. The same selection the first decode makes, so a buffer
+ * allocated in it has exactly the layout the decoder will write. Used for
+ * surfaces a client exports before that first decode (surface.c).
+ */
+int v4l2r_context_probe_capture_format(struct v4l2r_context *ctx, int fd,
+				       struct v4l2_format *format)
+{
+	return select_capture_format(ctx, fd, format, true);
 }
 
