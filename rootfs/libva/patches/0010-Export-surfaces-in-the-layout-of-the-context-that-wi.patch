 	enum v4l2_memory capture_memory;
+	/* Creation order (drv->context_serial), and whether the decoder is
+	 * open with its OUTPUT queue set up: surfaces exported before their
+	 * first decode take the layout of the newest such context of their
+	 * size (surface.c, export_context). Both under drv->mutex. */
+	unsigned int serial;
+	bool output_ready;
 
 	struct v4l2r_output_buffer output[V4L2R_OUTPUT_BUFFERS];
 	uint8_t next_output;
@@ -406,6 +412,9 @@ struct v4l2r_driver {
 	struct v4l2r_decoder decoders[V4L2R_MAX_DECODERS];
 	unsigned int nb_decoders;
 
+	/* Last v4l2r_context.serial handed out. */
+	unsigned int context_serial;
+
 	/* Converter detection is deferred until something can actually use
 	 * one (see v4l2r_converter_available). */
 	struct v4l2r_converter converter;
@@ -584,6 +593,12 @@ void v4l2r_reap_capture(struct v4l2r_context *ctx);
 VAStatus v4l2r_context_bind_surface(struct v4l2r_context *ctx,
 				    struct v4l2r_surface *surface);
 
+/* The CAPTURE format the context's first decode will select, worked out on
+ * @fd, a throwaway open of the same device set to the context's OUTPUT
+ * format. Leaves the context itself untouched. */
+int v4l2r_context_probe_capture_format(struct v4l2r_context *ctx, int fd,
+				       struct v4l2_format *format);
+
 /* Return a destroyed surface's CAPTURE buffer to the orphan free list. */
 void v4l2r_context_release_capture(struct v4l2r_context *ctx, int index);
 
