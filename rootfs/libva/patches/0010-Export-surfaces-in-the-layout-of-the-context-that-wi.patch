+	pthread_mutex_lock(&drv->mutex);
+	ctx->output_ready = true;
+	pthread_mutex_unlock(&drv->mutex);
+
 	*context_id = id;
 	return VA_STATUS_SUCCESS;
 
@@ -1044,7 +1080,11 @@ VAStatus v4l2r_DestroyContext(VADriverContextP va_ctx, VAContextID context_id)
 	unsigned int iter = 0;
 	struct v4l2r_surface *surface;
 
