diff --git a/src/surface.c b/src/surface.c
index b05a104..88c2a00 100644
--- a/src/surface.c
+++ b/src/surface.c
@@ -522,6 +522,44 @@ next:
 	return VA_STATUS_ERROR_OPERATION_FAILED;
 }
 
+static VAStatus backing_alloc_for_context(struct v4l2r_context *ctx,
+					  struct v4l2r_surface *surface);
+
+/*
+ * The decode context a surface exported before its first decode is going to
+ * be decoded with, when one can be told: GStreamer va opens its context
+ * first, then creates and exports every surface of its pool (and more as the
+ * pool grows) and keeps those dma-bufs for the buffers' lives. Candidates: a
+ * codec context of the surface's size (the render target's own, if it was
+ * given one) whose CAPTURE memory is still undecided or already imports
+ * client dma-bufs; the newest wins. Not a context that decodes into its own
+ * buffers (MMAP, FFmpeg) and not one behind a format converter, whose
+ * backing is the converter's destination.
+ */
+static struct v4l2r_context *export_context(struct v4l2r_driver *drv,
+					    const struct v4l2r_surface *surface)
+{
+	struct v4l2r_context *ctx, *best = NULL;
+	unsigned int iter = 0;
+
+	pthread_mutex_lock(&drv->mutex);
+	while ((ctx = v4l2r_handles_next(&drv->contexts, &iter, NULL))) {
+		if (!ctx->output_ready || !ctx->codec || ctx->conv ||
+		    ctx->capture_memory == V4L2_MEMORY_MMAP)
+			continue;
+		if (surface->ctx && surface->ctx != ctx)
+			continue;
+		if (ctx->picture_width != surface->width ||
+		    ctx->picture_height != surface->height)
+			continue;
+		if (!best || ctx->serial > best->serial)
+			best = ctx;
+	}
+	pthread_mutex_unlock(&drv->mutex);
+
+	return best;
+}
+
 /* Backing for a bare (unbound) surface, sized like the surface itself. */
 static VAStatus backing_alloc_default(struct v4l2r_driver *drv,
 				      struct v4l2r_surface *surface)
@@ -536,6 +574,38 @@ static VAStatus backing_alloc_default(struct v4l2r_driver *drv,
 	     !v4l2r_converter_available(drv)))
 		pixelformat = V4L2_PIX_FMT_P010;
 
+	/*
+	 * A client that exports before decoding keeps what it is given now,
+	 * so give it the buffer the decoder will write: allocated by the very
+	 * decoder, in the format the context's first decode selects. A
+	 * generic buffer from whichever decoder enumerates first is NV12 of
+	 * the right pitch, but the AV1 core appends its motion vectors to
+	 * every CAPTURE buffer (3 525 632 instead of 3 133 440 bytes at
+	 * 1920x1088), so that export never fitted: the context decoded into
+	 * buffers of its own and GStreamer showed the empty export (green).
+	 */
+	if (pixelformat == V4L2_PIX_FMT_NV12) {
+		struct v4l2r_context *ctx = export_context(drv, surface);
+
+		if (ctx && backing_alloc_for_context(ctx, surface) ==
+			   VA_STATUS_SUCCESS) {
+			if (surface->backing->pixelformat == pixelformat) {
+				v4l2r_trace("surface 0x%08x: pre-decode backing "
+					    "in the layout of its context "
+					    "(%ux%u pitch %u, %u bytes)\n",
+					    surface->id,
+					    surface->backing->width,
+					    surface->backing->height,
+					    surface->backing->pitch,
+					    surface->backing->plane_size[0]);
+				return VA_STATUS_SUCCESS;
+			}
+			/* That context will not decode to NV12 (a 10-bit
+			 * stream, a converter): the generic buffer below. */
+			v4l2r_surface_free_backing(surface);
+		}
+	}
+
 	uint32_t width = surface->width, height = surface->height;
 
 	/* H713 decode-time scaler: the surface will hold the scaled picture,
@@ -597,7 +667,7 @@ static VAStatus backing_alloc_for_context(struct v4l2r_context *ctx,
 	struct v4l2_format capture = ctx->capture_format;
 	struct v4l2r_surface_backing *backing;
 	char path[64];
-	int fd;
+	int fd, ret;
 
 	snprintf(path, sizeof(path), "/proc/self/fd/%d", ctx->video_fd);
 	fd = open(path, O_RDWR | O_CLOEXEC);
@@ -612,9 +682,17 @@ static VAStatus backing_alloc_for_context(struct v4l2r_context *ctx,
 	for (unsigned int i = 0; i < VIDEO_MAX_PLANES; i++)
 		backing->dmabuf_fd[i] = -1;
 
-	if (ioctl(fd, VIDIOC_S_FMT, &output) < 0 ||
-	    ioctl(fd, VIDIOC_S_FMT, &capture) < 0 ||
-	    backing_export_one(fd, &capture, backing) < 0) {
+	/* Before the first decode (a surface exported up front) the context
+	 * has no CAPTURE format yet: work out the one it will select. */
+	if (ioctl(fd, VIDIOC_S_FMT, &output) < 0)
+		ret = -errno;
+	else if (ctx->capture_memory)
+		ret = ioctl(fd, VIDIOC_S_FMT, &capture) < 0 ? -errno : 0;
+	else
+		ret = v4l2r_context_probe_capture_format(ctx, fd, &capture);
+	if (ret >= 0)
+		ret = backing_export_one(fd, &capture, backing);
+	if (ret < 0) {
 		close(fd);
 		free(backing);
 		return VA_STATUS_ERROR_OPERATION_FAILED;
diff --git a/src/v4l2_request.h b/src/v4l2_request.h
index 7728e03..a34218f 100644
--- a/src/v4l2_request.h
+++ b/src/v4l2_request.h
@@ -297,6 +297,12 @@ struct v4l2r_context {
 	/* MMAP, or DMABUF when the first surface decoded into had already
