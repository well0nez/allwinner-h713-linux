@@ -268,7 +279,7 @@ static int select_capture_format(struct v4l2r_context *ctx)
 
 	/* Prefer the driver default over other non-linear candidates. */
 	if (best_score < 6 &&
-	    ioctl(ctx->video_fd, VIDIOC_G_FMT, &format) >= 0) {
