 }
 
+static void hevc_parse_entry_points(struct hevc_context *codec,
+				    struct v4l2r_bits *b, bool dependent,
+				    bool temporal_mvp,
+				    struct hevc_slice_info *info);
+
 /*
  * Parse the slice segment header far enough to measure the reference
  * picture set sections. The short term RPS length is cross-checked with
@@ -142,11 +167,12 @@ static void hevc_parse_slice_header(struct hevc_context *codec,
 	if (dependent_slice) {
 		/* RPS syntax only lives in independent slice segments. */
 		info->valid = !b.error;
+		hevc_parse_entry_points(codec, &b, true, false, info);
 		return;
 	}
 
 	v4l2r_bits_skip(&b, pic->num_extra_slice_header_bits);
-	v4l2r_bits_ue(&b);				/* slice_type */
+	info->slice_type = v4l2r_bits_ue(&b);
 
 	if (pic->slice_parsing_fields.bits.output_flag_present_flag)
 		v4l2r_bits_bit(&b);
@@ -156,6 +182,7 @@ static void hevc_parse_slice_header(struct hevc_context *codec,
 
 	if (idr) {
 		info->valid = !b.error;
+		hevc_parse_entry_points(codec, &b, false, false, info);
 		return;
 	}
 
@@ -242,10 +269,228 @@ static void hevc_parse_slice_header(struct hevc_context *codec,
 	info->long_term_ref_pic_set_size = b.pos - mark;
 
 	info->valid = !b.error;
+
+	hevc_parse_entry_points(codec, &b, false,
+		pic->slice_parsing_fields.bits.sps_temporal_mvp_enabled_flag &&
+		v4l2r_bits_bit(&b),		/* slice_temporal_mvp_enabled_flag */
+		info);
+}
+
+/* NumPicTotalCurr (7-55) from the VA reference flags: the pictures of the
+ * current RPS that the current picture may use. */
+static unsigned int hevc_num_pic_total_curr(const VAPictureParameterBufferHEVC *pic)
+{
+	unsigned int total = 0;
+
+	for (int i = 0; i < 15; i++) {
+		const VAPictureHEVC *ref = &pic->ReferenceFrames[i];
+
+		if (ref->flags & VA_PICTURE_HEVC_INVALID)
+			continue;
+		if (ref->flags & (VA_PICTURE_HEVC_RPS_ST_CURR_BEFORE |
+				  VA_PICTURE_HEVC_RPS_ST_CURR_AFTER |
+				  VA_PICTURE_HEVC_RPS_LT_CURR))
+			total++;
+	}
+
+	return total;
+}
+
+/* pred_weight_table() (7.3.6.3), skipped. */
+static void hevc_skip_pred_weight_table(struct v4l2r_bits *b, bool chroma,
+					unsigned int lists,
+					const uint32_t num_minus1[2])
+{
+	v4l2r_bits_ue(b);			/* luma_log2_weight_denom */
+	if (chroma)
+		v4l2r_bits_se(b);		/* delta_chroma_log2_weight_denom */
+
+	for (unsigned int l = 0; l < lists && !b->error; l++) {
+		bool luma_flag[15], chroma_flag[15] = { false };
+		unsigned int n = num_minus1[l] + 1;
+
+		for (unsigned int i = 0; i < n; i++)
+			luma_flag[i] = v4l2r_bits_bit(b);
+		if (chroma)
+			for (unsigned int i = 0; i < n; i++)
+				chroma_flag[i] = v4l2r_bits_bit(b);
+
+		for (unsigned int i = 0; i < n && !b->error; i++) {
+			if (luma_flag[i]) {
+				v4l2r_bits_se(b);	/* delta_luma_weight */
+				v4l2r_bits_se(b);	/* luma_offset */
+			}
+			if (chroma_flag[i]) {
+				for (int j = 0; j < 4; j++)
+					v4l2r_bits_se(b);	/* weight, offset x2 */
+			}
+		}
+	}
+}
+
+/*
+ * The rest of the slice segment header up to the entry points (7.3.6.1), for
+ * a picture with tiles. cedrus decodes the tiles of a slice only with the
+ * offsets of their substreams (the HEVC_ENTRY_POINT_OFFSETS control); VA-API
+ * passes their number but not the offsets themselves (the subset buffer is
+ * optional), so read them where they are. Only the Main and Main 10
+ * syntax: no range or screen content extension fields.
+ */
+static void hevc_parse_entry_points(struct hevc_context *codec,
+				    struct v4l2r_bits *b, bool dependent,
+				    bool temporal_mvp,
+				    struct hevc_slice_info *info)
+{
+	const VAPictureParameterBufferHEVC *pic = &codec->va_pic;
+	bool chroma = !pic->pic_fields.bits.separate_colour_plane_flag &&
+		      pic->pic_fields.bits.chroma_format_idc;
+	uint32_t count, offset_bits;
+
+	if (!pic->pic_fields.bits.tiles_enabled_flag || !codec->max_entry_points)
+		return;
+
+	if (!dependent) {
+		bool p_or_b = info->slice_type < 2;	/* 0 B, 1 P, 2 I */
+		bool is_b = info->slice_type == 0;
+		bool sao_luma = false, sao_chroma = false, deblocking_disabled;
+		uint32_t num[2] = {
+			pic->num_ref_idx_l0_default_active_minus1,
+			pic->num_ref_idx_l1_default_active_minus1,
+		};
+
+		if (info->slice_type > 2)
+			return;
+
+		if (pic->slice_parsing_fields.bits.sample_adaptive_offset_enabled_flag) {
+			sao_luma = v4l2r_bits_bit(b);
+			if (chroma)
+				sao_chroma = v4l2r_bits_bit(b);
+		}
+
+		if (p_or_b) {
+			unsigned int total = hevc_num_pic_total_curr(pic);
+
+			if (v4l2r_bits_bit(b)) {	/* num_ref_idx_active_override_flag */
+				num[0] = v4l2r_bits_ue(b);
+				if (is_b)
+					num[1] = v4l2r_bits_ue(b);
+			}
+			if (num[0] > 14 || num[1] > 14)
+				return;
+
+			if (pic->slice_parsing_fields.bits.lists_modification_present_flag &&
+			    total > 1) {
+				unsigned int bits = ceil_log2(total);
+
+				if (v4l2r_bits_bit(b))	/* ref_pic_list_modification_flag_l0 */
+					v4l2r_bits_skip(b, (num[0] + 1) * bits);
+				if (is_b && v4l2r_bits_bit(b))
+					v4l2r_bits_skip(b, (num[1] + 1) * bits);
+			}
+
+			if (is_b)
+				v4l2r_bits_bit(b);	/* mvd_l1_zero_flag */
+			if (pic->slice_parsing_fields.bits.cabac_init_present_flag)
+				v4l2r_bits_bit(b);	/* cabac_init_flag */
+
+			if (temporal_mvp) {
+				bool from_l0 = true;
+
+				if (is_b)
+					from_l0 = v4l2r_bits_bit(b);
+				if ((from_l0 && num[0] > 0) || (!from_l0 && num[1] > 0))
+					v4l2r_bits_ue(b);	/* collocated_ref_idx */
+			}
+
+			if ((pic->pic_fields.bits.weighted_pred_flag && !is_b) ||
+			    (pic->pic_fields.bits.weighted_bipred_flag && is_b))
+				hevc_skip_pred_weight_table(b, chroma, is_b ? 2 : 1,
+							    num);
+
+			v4l2r_bits_ue(b);	/* five_minus_max_num_merge_cand */
+		}
+		info->num_ref_idx_l0_active_minus1 = num[0];
+		info->num_ref_idx_l1_active_minus1 = num[1];
+
+		info->slice_qp_delta = v4l2r_bits_se(b);
+		if (pic->slice_parsing_fields.bits.pps_slice_chroma_qp_offsets_present_flag) {
+			v4l2r_bits_se(b);	/* slice_cb_qp_offset */
+			v4l2r_bits_se(b);	/* slice_cr_qp_offset */
+		}
+
+		deblocking_disabled =
+			pic->slice_parsing_fields.bits.pps_disable_deblocking_filter_flag;
+		if (pic->slice_parsing_fields.bits.deblocking_filter_override_enabled_flag &&
+		    v4l2r_bits_bit(b)) {	/* deblocking_filter_override_flag */
+			deblocking_disabled = v4l2r_bits_bit(b);
+			if (!deblocking_disabled) {
+				v4l2r_bits_se(b);	/* slice_beta_offset_div2 */
+				v4l2r_bits_se(b);	/* slice_tc_offset_div2 */
+			}
+		}
+
+		if (pic->pic_fields.bits.pps_loop_filter_across_slices_enabled_flag &&
+		    (sao_luma || sao_chroma || !deblocking_disabled))
+			v4l2r_bits_bit(b);	/* slice_loop_filter_across_slices_enabled_flag */
+	}
+
+	count = v4l2r_bits_ue(b);
+	if (b->error || count > codec->max_entry_points)
+		return;
+	if (count) {
+		offset_bits = v4l2r_bits_ue(b) + 1;	/* offset_len_minus1 */
+		if (offset_bits > 32)
+			return;
+		if (v4l2r_array_reserve((void **)&codec->entry_points,
+					&codec->alloc_entry_points,
+					codec->num_entry_points + count,
+					sizeof(*codec->entry_points)) < 0)
+			return;
+		for (uint32_t i = 0; i < count; i++)
+			codec->entry_points[codec->num_entry_points + i] =
+				v4l2r_bits_read(b, offset_bits) + 1;
+	}
+
+	info->num_entry_point_offsets = count;
+	info->entry_points_valid = !b->error;
 }
 
 /* --- control fill --- */
 
+/*
+ * The last tile column and row are what is left of the picture (6-3, 6-4).
+ * VA-API has room for every size but the last (19 columns, 21 rows of at
+ * most 20 and 22), and a client may leave that one out; cedrus programs the
+ * end of a tile from it.
+ */
+static void hevc_last_tile_size(const VAPictureParameterBufferHEVC *pic,
+				struct v4l2_ctrl_hevc_pps *pps)
+{
+	unsigned int ctb_log2 = pic->log2_min_luma_coding_block_size_minus3 + 3 +
+				pic->log2_diff_max_min_luma_coding_block_size;
+	unsigned int ctb = 1u << ctb_log2;
+	unsigned int width = (pic->pic_width_in_luma_samples + ctb - 1) >> ctb_log2;
+	unsigned int height = (pic->pic_height_in_luma_samples + ctb - 1) >> ctb_log2;
+	unsigned int cols = pic->num_tile_columns_minus1;
+	unsigned int rows = pic->num_tile_rows_minus1;
+	unsigned int used = 0;
+
+	if (cols < 20) {
+		for (unsigned int i = 0; i < cols; i++)
+			used += pps->column_width_minus1[i] + 1;
+		if (used < width)
+			pps->column_width_minus1[cols] = width - used - 1;
+	}
+
+	used = 0;
+	if (rows < 22) {
+		for (unsigned int i = 0; i < rows; i++)
+			used += pps->row_height_minus1[i] + 1;
+		if (used < height)
+			pps->row_height_minus1[rows] = height - used - 1;
+	}
+}
+
 static void hevc_fill_sps_pps(struct v4l2r_context *ctx,
 			      const VAPictureParameterBufferHEVC *pic)
 {
@@ -383,6 +628,8 @@ static void hevc_fill_sps_pps(struct v4l2r_context *ctx,
 		for (int i = 0; i <= pic->num_tile_rows_minus1 && i < 21; i++)
 			pps->row_height_minus1[i] = pic->row_height_minus1[i];
 
+		hevc_last_tile_size(pic, pps);
+
 		/* Uniform spacing is not signalled by VA-API; tile sizes are
 		 * explicit above so leave the flag cleared. */
 	}
@@ -530,7 +777,8 @@ static void hevc_fill_slice_params(struct v4l2r_context *ctx,
 				   struct v4l2_ctrl_hevc_slice_params *params,
 				   const VASliceParameterBufferHEVC *slice,
 				   const struct hevc_slice_info *info,
-				   uint32_t data_byte_offset)
+				   uint32_t data_byte_offset,
+				   uint32_t num_entry_point_offsets)
 {
 	struct hevc_context *codec = ctx->codec_priv;
 	const VAPictureParameterBufferHEVC *pic = &codec->va_pic;
@@ -542,7 +790,7 @@ static void hevc_fill_slice_params(struct v4l2r_context *ctx,
 	*params = (struct v4l2_ctrl_hevc_slice_params) {
 		.bit_size = payload_bytes * 8,
 		.data_byte_offset = data_byte_offset + slice->slice_data_byte_offset,
-		.num_entry_point_offsets = 0,
+		.num_entry_point_offsets = num_entry_point_offsets,
 
 		.nal_unit_type = info->nal_unit_type,
 		.nuh_temporal_id_plus1 = info->temporal_id_plus1,
@@ -606,12 +854,65 @@ static void hevc_fill_slice_params(struct v4l2r_context *ctx,
 	hevc_fill_pred_weights(&params->pred_weight_table, slice);
 }
 
+/*
+ * How many entry point offsets of this slice to hand to the decoder: those
+ * hevc_parse_entry_points() read, if the header agrees with what VA-API says
+ * about the slice (a misread header would send the decoder to wrong
+ * offsets), the offsets stay inside the slice and the control has room.
+ * Otherwise none, as before: the decoder then gets the first tile right.
+ */
+static uint32_t hevc_entry_points_usable(struct hevc_context *codec,
+					 const VASliceParameterBufferHEVC *slice,
+					 const struct hevc_slice_info *info)
+{
+	bool dependent = slice->LongSliceFlags.fields.dependent_slice_segment_flag;
+	uint32_t type = slice->LongSliceFlags.fields.slice_type;
+	uint64_t sum = 0;
+
+	/* Only pictures with tiles; WPP decodes right without them. */
+	if (!codec->va_pic.pic_fields.bits.tiles_enabled_flag ||
+	    !codec->max_entry_points ||
+	    (!info->num_entry_point_offsets && !slice->num_entry_point_offsets))
+		return 0;
+
+	if (!info->entry_points_valid ||
+	    info->num_entry_point_offsets != slice->num_entry_point_offsets ||
+	    (!dependent &&
+	     (info->slice_type != type ||
+	      info->slice_qp_delta != slice->slice_qp_delta ||
+	      (type < 2 && info->num_ref_idx_l0_active_minus1 !=
+			   slice->num_ref_idx_l0_active_minus1) ||
+	      (type == 0 && info->num_ref_idx_l1_active_minus1 !=
+			    slice->num_ref_idx_l1_active_minus1))) ||
+	    codec->num_entry_points + info->num_entry_point_offsets >
+	    codec->max_entry_points)
+		goto unusable;
+
+	for (uint32_t i = 0; i < info->num_entry_point_offsets; i++)
+		sum += codec->entry_points[codec->num_entry_points + i];
+	if (sum >= slice->slice_data_size)
+		goto unusable;
+
+	return info->num_entry_point_offsets;
+
+unusable:
+	if (!codec->entry_points_warned)
+		v4l2r_log("hevc: entry points of a slice with tiles not passed "
+			  "(header %s, %u read, VA says %u); its tiles after "
+			  "the first will be wrong\n",
+			  info->entry_points_valid ? "differs from VA" :
+			  "unreadable", info->num_entry_point_offsets,
+			  slice->num_entry_point_offsets);
+	codec->entry_points_warned = true;
+	return 0;
+}
+
 /* --- submission --- */
 
 static VAStatus hevc_submit(struct v4l2r_context *ctx, bool last_slice)
 {
 	struct hevc_context *codec = ctx->codec_priv;
-	struct v4l2_ext_control controls[5];
+	struct v4l2_ext_control controls[6];
 	unsigned int count = 0;
 
 	controls[count++] = (struct v4l2_ext_control) {
@@ -651,6 +952,15 @@ static VAStatus hevc_submit(struct v4l2r_context *ctx, bool last_slice)
 		};
 	}
 
+	if (codec->num_entry_points) {
+		controls[count++] = (struct v4l2_ext_control) {
+			.id = V4L2_CID_STATELESS_HEVC_ENTRY_POINT_OFFSETS,
+			.ptr = codec->entry_points,
+			.size = sizeof(*codec->entry_points) *
+				codec->num_entry_points,
+		};
+	}
+
 	if (codec->decode_mode == V4L2_STATELESS_HEVC_DECODE_MODE_SLICE_BASED)
 		return v4l2r_decode(ctx, controls, count,
 				    codec->first_slice, last_slice);
@@ -666,6 +976,7 @@ static VAStatus hevc_process_slice(struct v4l2r_context *ctx,
 	const uint8_t *slice_data = data + va_slice->slice_data_offset;
 	struct hevc_slice_info info;
 	uint32_t data_byte_offset;
+	uint32_t num_entry_points;
 	VAStatus status;
 
 	if (!codec->have_pic)
@@ -690,11 +1001,13 @@ static VAStatus hevc_process_slice(struct v4l2r_context *ctx,
 			return status;
 
 		codec->num_slice_params = 0;
+		codec->num_entry_points = 0;
 		codec->first_slice = false;
 	}
 
 	hevc_parse_slice_header(codec, slice_data, va_slice->slice_data_size,
 				&info);
+	num_entry_points = hevc_entry_points_usable(codec, va_slice, &info);
 
 	if (codec->num_slices == 0 && info.valid) {
 		codec->decode_params.short_term_ref_pic_set_size =
@@ -731,8 +1044,10 @@ static VAStatus hevc_process_slice(struct v4l2r_context *ctx,
 
 		hevc_fill_slice_params(ctx,
 				       &codec->slice_params[codec->num_slice_params],
-				       va_slice, &info, data_byte_offset);
+				       va_slice, &info, data_byte_offset,
+				       num_entry_points);
 		codec->num_slice_params++;
+		codec->num_entry_points += num_entry_points;
 	}
 
 	codec->num_slices++;
@@ -753,6 +1068,9 @@ static VAStatus hevc_init(struct v4l2r_context *ctx)
 	struct v4l2_query_ext_ctrl ext_sps_st_rps = {
 		.id = V4L2_CID_STATELESS_HEVC_EXT_SPS_ST_RPS,
 	};
+	struct v4l2_query_ext_ctrl entry_points = {
+		.id = V4L2_CID_STATELESS_HEVC_ENTRY_POINT_OFFSETS,
+	};
 	struct v4l2_ext_control controls[2];
 	int ret;
 
@@ -796,6 +1114,11 @@ static VAStatus hevc_init(struct v4l2r_context *ctx)
 	else
 		codec->max_slice_params = 0;
 
+	/* A dynamic array of the offsets of all slices in a request (cedrus:
+	 * up to 256); without slice parameters there is nowhere to count them. */
+	if (codec->max_slice_params && !v4l2r_query_control(ctx, &entry_points))
+		codec->max_entry_points = entry_points.dims[0];
+
 	controls[0] = (struct v4l2_ext_control) {
 		.id = V4L2_CID_STATELESS_HEVC_DECODE_MODE,
 		.value = codec->decode_mode,
@@ -817,10 +1140,13 @@ static void hevc_uninit(struct v4l2r_context *ctx)
 
 	free(codec->slice_params);
 	free(codec->va_slices);
+	free(codec->entry_points);
 	codec->slice_params = NULL;
 	codec->va_slices = NULL;
+	codec->entry_points = NULL;
 	codec->alloc_slice_params = 0;
 	codec->alloc_va_slices = 0;
+	codec->alloc_entry_points = 0;
 }
 
