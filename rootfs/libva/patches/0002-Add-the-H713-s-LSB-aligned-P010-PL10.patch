diff --git a/src/image.c b/src/image.c
index 6d5b0ef..923d923 100644
--- a/src/image.c
+++ b/src/image.c
@@ -118,6 +118,19 @@ fail:
 	return status;
 }
 
+/* Move 16-bit samples between their memory and VA positions: left for a
+ * positive shift (readback), right for a negative one (upload). */
+static void shift_samples(uint8_t *base, unsigned int pitch,
+			  unsigned int row_bytes, unsigned int rows, int shift)
+{
+	for (unsigned int y = 0; y < rows; y++) {
+		uint16_t *p = (uint16_t *)(base + (size_t)y * pitch);
+
+		for (unsigned int x = 0; x < row_bytes / 2; x++)
+			p[x] = shift > 0 ? p[x] << shift : p[x] >> -shift;
+	}
+}
+
 VAStatus v4l2r_DeriveImage(VADriverContextP va_ctx, VASurfaceID surface_id,
 			   VAImage *image)
 {
@@ -146,8 +159,9 @@ VAStatus v4l2r_DeriveImage(VADriverContextP va_ctx, VASurfaceID surface_id,
 	if (!view.info->linear || !view.info->va_fourcc)
 		return VA_STATUS_ERROR_OPERATION_FAILED;
 
-	/* Zero-copy is only possible when luma and chroma share one plane. */
-	if (view.nb_planes != 1)
+	/* Zero-copy is only possible when luma and chroma share one plane,
+	 * and the samples are where VA expects them. */
+	if (view.nb_planes != 1 || view.info->lsb_shift)
 		return VA_STATUS_ERROR_OPERATION_FAILED;
 
 	pthread_mutex_lock(&drv->mutex);
@@ -312,16 +326,22 @@ VAStatus v4l2r_GetImage(VADriverContextP va_ctx, VASurfaceID surface_id,
 		       (size_t)view.pitch * height);
 		memcpy(dst + image->offsets[1], src_chroma,
 		       (size_t)view.pitch * ((height + 1) / 2));
-		return VA_STATUS_SUCCESS;
+	} else {
+		for (unsigned int i = 0; i < height; i++)
+			memcpy(dst + image->offsets[0] + i * image->pitches[0],
+			       src_luma + i * view.pitch, row_size);
+
+		for (unsigned int i = 0; i < (height + 1) / 2; i++)
+			memcpy(dst + image->offsets[1] + i * image->pitches[1],
+			       src_chroma + i * view.pitch, row_size);
 	}
 
-	for (unsigned int i = 0; i < height; i++)
-		memcpy(dst + image->offsets[0] + i * image->pitches[0],
-		       src_luma + i * view.pitch, row_size);
-
-	for (unsigned int i = 0; i < (height + 1) / 2; i++)
-		memcpy(dst + image->offsets[1] + i * image->pitches[1],
-		       src_chroma + i * view.pitch, row_size);
+	if (view.info->lsb_shift) {
+		shift_samples(dst + image->offsets[0], image->pitches[0],
+			      row_size, height, view.info->lsb_shift);
+		shift_samples(dst + image->offsets[1], image->pitches[1],
+			      row_size, (height + 1) / 2, view.info->lsb_shift);
+	}
 
 	return VA_STATUS_SUCCESS;
 }
@@ -408,7 +428,7 @@ VAStatus v4l2r_PutImage(VADriverContextP va_ctx, VASurfaceID surface_id,
 		       (size_t)view.pitch * height);
 		memcpy(dst_chroma, src + image->offsets[1],
 		       (size_t)view.pitch * ((height + 1) / 2));
-		return VA_STATUS_SUCCESS;
+		goto shift;
 	}
 
 	for (unsigned int i = 0; i < height; i++)
@@ -421,6 +441,14 @@ VAStatus v4l2r_PutImage(VADriverContextP va_ctx, VASurfaceID surface_id,
 		       src + image->offsets[1] + i * image->pitches[1],
 		       row_size);
 
+shift:
+	if (view.info->lsb_shift) {
+		shift_samples(dst_luma, view.pitch, row_size, height,
+			      -(int)view.info->lsb_shift);
+		shift_samples(dst_chroma, view.pitch, row_size,
+			      (height + 1) / 2, -(int)view.info->lsb_shift);
+	}
+
 	return VA_STATUS_SUCCESS;
 }
 
diff --git a/src/v4l2_request.h b/src/v4l2_request.h
index 35a1877..71843fb 100644
--- a/src/v4l2_request.h
+++ b/src/v4l2_request.h
@@ -478,8 +478,21 @@ struct v4l2r_format_info {
 	unsigned int rt_format;
 	unsigned int bit_depth;
 	bool linear;			/* mappable for DeriveImage/GetImage */
+	/* Samples sit this many bits below their VA position (P010 with the
+	 * value in bits 9:0): no zero-copy DeriveImage, and the copying
+	 * paths shift them into place. */
+	unsigned int lsb_shift;
 };
 
+/* H713 (local kernel patch): P010's layout with each sample LSB-aligned,
+ * as the AV1 core writes it; scanned out as P010 + the LSB10 modifier. */
+#ifndef V4L2_PIX_FMT_P010_LSB
+#define V4L2_PIX_FMT_P010_LSB		v4l2_fourcc('P', 'L', '1', '0')
+#endif
+#ifndef DRM_FORMAT_MOD_ALLWINNER_LSB10
+#define DRM_FORMAT_MOD_ALLWINNER_LSB10	fourcc_mod_code(ALLWINNER, 2)
+#endif
+
 const struct v4l2r_format_info *v4l2r_format_by_pixelformat(uint32_t pixelformat);
 const struct v4l2r_format_info *v4l2r_capture_format_info(struct v4l2r_context *ctx);
 
