 		.count = 1,
-		.memory = V4L2_MEMORY_MMAP,
+		.memory = ctx->capture_memory,
 		.format = ctx->capture_format,
 	};
 	struct v4l2_plane planes[VIDEO_MAX_PLANES] = {0};
@@ -612,6 +612,32 @@ static int capture_buffer_bind(struct v4l2r_context *ctx,
 	/* Refresh the completion counter with anything already finished. */
 	v4l2r_reap_capture(ctx);
 
+	/*
+	 * The queue's memory type is fixed by its first buffer. A client that
+	 * exported its surfaces before decoding into them (GStreamer va, whose
+	 * dma-buf allocator creates and exports each surface in one step and
+	 * keeps the fds) holds dma-bufs of standalone backing; decode into
+	 * those by importing them. Everyone else (FFmpeg exports after
+	 * decoding) keeps the decoder's own MMAP buffers. Not with a
+	 * conversion chain, whose backing is the converter's destination.
+	 */
+	if (!ctx->capture_memory) {
+		/* Only a buffer the decoder can write as is: FFmpeg probes
+		 * one surface by exporting it before any decode, at the
+		 * surface size, and must not flip the queue for that. */
+		bool fits = !ctx->conv &&
+			    v4l2r_surface_backing_fits(surface,
+						       &ctx->capture_format);
+
+		ctx->capture_memory = fits ? V4L2_MEMORY_DMABUF :
+				      V4L2_MEMORY_MMAP;
+		v4l2r_log("CAPTURE memory: %s\n",
+			  fits ? "client-exported dma-bufs" :
+			  surface->backing ? "decoder buffers (the pre-decode "
+			  "export does not fit the decode format)" :
+			  "decoder buffers");
+	}
+
 	if (index < 0) {
 		/* First decode into this surface: recycle a buffer orphaned by
 		 * a destroyed surface, or grow the pool. */
@@ -625,6 +651,28 @@ static int capture_buffer_bind(struct v4l2r_context *ctx,
 				return index;
 		}
 
+		if (ctx->capture_memory == V4L2_MEMORY_DMABUF) {
+			struct v4l2r_capture_buffer *capture =
+				&ctx->captures[index];
+
+			/* A recycled buffer still holds the memory of the
+			 * surface that was destroyed; it goes with it. */
+			for (unsigned int i = 0; i < VIDEO_MAX_PLANES; i++) {
+				if (capture->map[i])
+					munmap(capture->map[i],
+					       capture->plane_size[i]);
+				if (capture->dmabuf_fd[i] >= 0)
+					close(capture->dmabuf_fd[i]);
+				capture->map[i] = NULL;
+				capture->dmabuf_fd[i] = -1;
+			}
+
+			if (!v4l2r_surface_give_backing(surface, ctx, capture)) {
+				free_list_push(ctx, index);
+				return -ENOMEM;
+			}
+		}
+
 		ctx->captures[index].surface = surface;
 		surface->ctx = ctx;
 		surface->capture_index = index;
