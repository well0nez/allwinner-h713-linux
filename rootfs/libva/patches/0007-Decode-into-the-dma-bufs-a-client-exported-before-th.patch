+/*
+ * Allocate one CAPTURE buffer in @format on @fd (a throwaway open of a
+ * decoder) and export its planes into @backing: plane count, sizes and
+ * dma-buf fds. The fds keep the memory alive after @fd is closed.
+ */
+static int backing_export_one(int fd, struct v4l2_format *format,
+			      struct v4l2r_surface_backing *backing)
+{
+	struct v4l2_create_buffers buffers = {
+		.count = 1,
+		.memory = V4L2_MEMORY_MMAP,
+		.format = *format,
+	};
+	struct v4l2_plane planes[VIDEO_MAX_PLANES] = {0};
+	struct v4l2_buffer buffer = {0};
+	bool mplane = V4L2_TYPE_IS_MULTIPLANAR(format->type);
+
+	if (ioctl(fd, VIDIOC_CREATE_BUFS, &buffers) < 0)
+		return -errno;
+
+	buffer.type = format->type;
+	buffer.index = buffers.index;
+	if (mplane) {
+		buffer.length = VIDEO_MAX_PLANES;
+		buffer.m.planes = planes;
+	}
+	if (ioctl(fd, VIDIOC_QUERYBUF, &buffer) < 0)
+		return -errno;
+
+	if (mplane) {
+		backing->nb_planes = buffer.length;
+		for (unsigned int i = 0; i < buffer.length; i++)
+			backing->plane_size[i] = buffer.m.planes[i].length;
+	} else {
+		backing->nb_planes = 1;
+		backing->plane_size[0] = buffer.length;
+	}
+
+	for (unsigned int i = 0; i < backing->nb_planes; i++) {
+		struct v4l2_exportbuffer exportbuffer = {
+			.type = format->type,
+			.index = buffer.index,
+			.plane = i,
+			.flags = O_RDWR | O_CLOEXEC,
+		};
+
+		if (ioctl(fd, VIDIOC_EXPBUF, &exportbuffer) < 0) {
+			int ret = -errno;
+
+			for (unsigned int j = 0; j < i; j++) {
+				close(backing->dmabuf_fd[j]);
+				backing->dmabuf_fd[j] = -1;
+			}
+			return ret;
+		}
+
+		backing->dmabuf_fd[i] = exportbuffer.fd;
+	}
+
+	return 0;
+}
+
 /*
  * Allocate dma-buf backing for a surface that is not bound to a decode
  * context, using the CAPTURE queue of one of the enumerated decoders on
@@ -347,9 +410,6 @@ static VAStatus backing_alloc(struct v4l2r_driver *drv,
 	/* Try each enumerated decoder until one produces the layout. */
 	for (unsigned int n = 0; n < drv->nb_decoders; n++) {
 		struct v4l2_capability capability = {0};
-		struct v4l2_create_buffers buffers;
-		struct v4l2_plane planes[VIDEO_MAX_PLANES] = {0};
-		struct v4l2_buffer buffer = {0};
 		struct v4l2_format format = {0};
 		unsigned int capabilities;
 		bool mplane;
@@ -409,6 +469,18 @@ static VAStatus backing_alloc(struct v4l2r_driver *drv,
 			format.fmt.pix.pixelformat = pixelformat;
 		}
 
+		/* The same 64-byte NV12 pitch the decode CAPTURE format asks
+		 * for (context.c), so a buffer exported before the first
+		 * decode has the layout the decoder will write. */
+		if (pixelformat == V4L2_PIX_FMT_NV12) {
+			uint32_t pitch = (width + 63) & ~63u;
+
+			if (mplane)
+				format.fmt.pix_mp.plane_fmt[0].bytesperline = pitch;
+			else
+				format.fmt.pix.bytesperline = pitch;
+		}
+
 		if (ioctl(fd, VIDIOC_S_FMT, &format) < 0)
 			goto next;
 
@@ -433,51 +505,9 @@ static VAStatus backing_alloc(struct v4l2r_driver *drv,
 			backing->nb_planes = 1;
 		}
 
-		buffers = (struct v4l2_create_buffers) {
-			.count = 1,
-			.memory = V4L2_MEMORY_MMAP,
-			.format = format,
-		};
-		if (ioctl(fd, VIDIOC_CREATE_BUFS, &buffers) < 0)
-			goto next;
-
-		buffer.type = format.type;
-		buffer.index = buffers.index;
-		if (mplane) {
-			buffer.length = VIDEO_MAX_PLANES;
-			buffer.m.planes = planes;
-		}
-		if (ioctl(fd, VIDIOC_QUERYBUF, &buffer) < 0)
+		if (backing_export_one(fd, &format, backing) < 0)
 			goto next;
 
-		if (mplane) {
-			backing->nb_planes = buffer.length;
-			for (unsigned int i = 0; i < buffer.length; i++)
-				backing->plane_size[i] = buffer.m.planes[i].length;
-		} else {
-			backing->nb_planes = 1;
-			backing->plane_size[0] = buffer.length;
-		}
-
-		for (unsigned int i = 0; i < backing->nb_planes; i++) {
-			struct v4l2_exportbuffer exportbuffer = {
-				.type = format.type,
-				.index = buffer.index,
-				.plane = i,
-				.flags = O_RDWR | O_CLOEXEC,
-			};
-
-			if (ioctl(fd, VIDIOC_EXPBUF, &exportbuffer) < 0) {
-				for (unsigned int j = 0; j < i; j++) {
-					close(backing->dmabuf_fd[j]);
-					backing->dmabuf_fd[j] = -1;
-				}
-				goto next;
-			}
-
-			backing->dmabuf_fd[i] = exportbuffer.fd;
-		}
-
 		backing->pixelformat = pixelformat;
 		close(fd);
 
@@ -506,8 +536,149 @@ static VAStatus backing_alloc_default(struct v4l2r_driver *drv,
 	     !v4l2r_converter_available(drv)))
 		pixelformat = V4L2_PIX_FMT_P010;
 
-	return backing_alloc(drv, surface, surface->width, surface->height,
-			     pixelformat);
+	uint32_t width = surface->width, height = surface->height;
+
+	/* H713 decode-time scaler: the surface will hold the scaled picture,
+	 * and a client that exports before decoding (GStreamer va) keeps the
+	 * layout it is given now for the buffer's whole life. */
+	if (pixelformat == V4L2_PIX_FMT_NV12)
+		v4l2r_parse_size_env("V4L2_REQUEST_SCALE", &width, &height);
+
+	return backing_alloc(drv, surface, width, height, pixelformat);
+}
+
+static bool backing_matches(const struct v4l2r_surface_backing *backing,
+			    const struct v4l2_format *format)
+{
+	if (backing->pixelformat != v4l2r_format_pixelformat(format) ||
+	    backing->pitch != v4l2r_format_bytesperline(format))
+		return false;
+
+	if (V4L2_TYPE_IS_MULTIPLANAR(format->type)) {
+		if (backing->nb_planes != format->fmt.pix_mp.num_planes)
+			return false;
+		for (unsigned int i = 0; i < backing->nb_planes; i++)
+			if (backing->plane_size[i] <
+			    format->fmt.pix_mp.plane_fmt[i].sizeimage)
+				return false;
+		return true;
+	}
+
+	return backing->nb_planes == 1 &&
+	       backing->plane_size[0] >= format->fmt.pix.sizeimage;
+}
+
+bool v4l2r_surface_backing_fits(const struct v4l2r_surface *surface,
+				const struct v4l2_format *format)
+{
+	return surface->backing && backing_matches(surface->backing, format);
+}
+
+/*
+ * Backing in exactly the layout @ctx decodes into: a throwaway open of the
+ * same device (through /proc, which opens a new mem2mem instance) set to
+ * the context's own OUTPUT and CAPTURE formats. A generic allocation from
+ * whichever decoder enumerates first does not do: the AV1 core pads the
+ * height and appends its own data to every CAPTURE buffer.
+ */
+static VAStatus backing_alloc_for_context(struct v4l2r_context *ctx,
+					  struct v4l2r_surface *surface)
+{
+	struct v4l2_format output = ctx->output_format;
+	struct v4l2_format capture = ctx->capture_format;
+	struct v4l2r_surface_backing *backing;
+	char path[64];
+	int fd;
+
+	snprintf(path, sizeof(path), "/proc/self/fd/%d", ctx->video_fd);
+	fd = open(path, O_RDWR | O_CLOEXEC);
+	if (fd < 0)
+		return VA_STATUS_ERROR_OPERATION_FAILED;
+
+	backing = calloc(1, sizeof(*backing));
+	if (!backing) {
+		close(fd);
+		return VA_STATUS_ERROR_ALLOCATION_FAILED;
+	}
+	for (unsigned int i = 0; i < VIDEO_MAX_PLANES; i++)
+		backing->dmabuf_fd[i] = -1;
+
+	if (ioctl(fd, VIDIOC_S_FMT, &output) < 0 ||
+	    ioctl(fd, VIDIOC_S_FMT, &capture) < 0 ||
+	    backing_export_one(fd, &capture, backing) < 0) {
+		close(fd);
+		free(backing);
+		return VA_STATUS_ERROR_OPERATION_FAILED;
+	}
+	close(fd);
+
+	backing->pixelformat = v4l2r_format_pixelformat(&capture);
+	backing->width = v4l2r_format_width(&capture);
+	backing->height = v4l2r_format_height(&capture);
+	backing->pitch = v4l2r_format_bytesperline(&capture);
+	surface->backing = backing;
+	return VA_STATUS_SUCCESS;
+}
+
+/*
+ * The other direction of v4l2r_surface_adopt_capture(), for a context whose
+ * CAPTURE queue imports dma-bufs: the surface's backing becomes the memory
+ * of its CAPTURE buffer. GStreamer va creates and exports every surface
+ * before the first decode and keeps those fds for the buffer's life, so the
+ * decoder has to write into exactly that memory. A surface with no backing,
+ * or with one that does not fit the negotiated format, gets a new one; a
+ * client that exported the old one will not see these frames, so say so.
+ * The fds and mapping move over; the backing itself is freed.
+ */
+bool v4l2r_surface_give_backing(struct v4l2r_surface *surface,
+				struct v4l2r_context *ctx,
+				struct v4l2r_capture_buffer *capture)
+{
+	const struct v4l2_format *format = &ctx->capture_format;
+	struct v4l2r_surface_backing *backing = surface->backing;
+
+	if (backing && !backing_matches(backing, format)) {
+		v4l2r_log("surface 0x%08x was exported as %.4s %ux%u pitch %u, "
+			  "but decodes as %.4s %ux%u pitch %u: its exported "
+			  "dma-buf will not show the picture\n", surface->id,
+			  (const char *)&backing->pixelformat, backing->width,
+			  backing->height, backing->pitch,
+			  (const char *)&(uint32_t){v4l2r_format_pixelformat(format)},
+			  v4l2r_format_width(format), v4l2r_format_height(format),
+			  v4l2r_format_bytesperline(format));
+		v4l2r_surface_free_backing(surface);
+		backing = NULL;
+	}
+
+	if (!backing) {
+		if (backing_alloc_for_context(ctx, surface) != VA_STATUS_SUCCESS) {
+			v4l2r_log("cannot allocate a buffer to decode into\n");
+			return false;
+		}
+		backing = surface->backing;
+		if (!backing_matches(backing, format)) {
+			v4l2r_log("cannot allocate a %ux%u pitch %u buffer to "
+				  "decode into (got pitch %u)\n",
+				  v4l2r_format_width(format),
+				  v4l2r_format_height(format),
+				  v4l2r_format_bytesperline(format),
+				  backing->pitch);
+			v4l2r_surface_free_backing(surface);
+			return false;
+		}
+	}
+
+	capture->nb_planes = backing->nb_planes;
+	for (unsigned int i = 0; i < VIDEO_MAX_PLANES; i++) {
+		capture->plane_size[i] = backing->plane_size[i];
+		capture->dmabuf_fd[i] = backing->dmabuf_fd[i];
+		capture->map[i] = backing->map[i];
+		backing->dmabuf_fd[i] = -1;
+		backing->map[i] = NULL;
+	}
+
+	v4l2r_surface_free_backing(surface);
+	return true;
 }
 
 /*
@@ -628,8 +799,10 @@ VAStatus v4l2r_surface_capture_view(struct v4l2r_surface *surface,
 					capture->plane_size[i],
 					PROT_READ | PROT_WRITE,
 					MAP_SHARED,
-					ctx->video_fd,
-					capture->plane_mem_offset[i]);
+					ctx->capture_memory == V4L2_MEMORY_DMABUF ?
+					capture->dmabuf_fd[i] : ctx->video_fd,
+					ctx->capture_memory == V4L2_MEMORY_DMABUF ?
+					0 : capture->plane_mem_offset[i]);
 				if (addr == MAP_FAILED)
 					return VA_STATUS_ERROR_OPERATION_FAILED;
 				capture->map[i] = addr;
