 src/surface.c      |   3 +-
 src/v4l2_request.h |   4 ++
 3 files changed, 143 insertions(+), 3 deletions(-)

diff --git a/src/context.c b/src/context.c
index 3ae5ef9..29b7ab0 100644
--- a/src/context.c
+++ b/src/context.c
@@ -11,6 +11,7 @@
