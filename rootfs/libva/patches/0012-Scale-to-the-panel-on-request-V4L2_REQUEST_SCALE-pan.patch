 bool v4l2r_parse_size_env(const char *name, uint32_t *width,
 			  uint32_t *height);
+/* The decode-time scaler's output size for a frame of this coded size
+ * (V4L2_REQUEST_SCALE=WxH or =panel), false for none (context.c). */
+bool v4l2r_scale_target(uint32_t coded_width, uint32_t coded_height,
+			uint32_t *width, uint32_t *height, bool quiet);
 
