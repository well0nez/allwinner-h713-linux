# mainline/config/versions.env - the pins mainline/build/build.sh builds from. It is read as a shell file, so only
# plain assignments here; a value may name a key above it.
#
# TF-A, U-Boot and sunxi-tools are the submodules under mainline/external/: their exact state is the gitlink. crust
# is no submodule yet: release/build-all.sh takes CRUST_SRC=<checkout>, and crust-h713/ mirrors its series. The
# *_UPSTREAM_BASE lines only record which upstream commit each of those series sits on; nothing reads them.
#
# Every line that starts with KERNEL_ counts, word for word, into the digest that names the kernel tree: a changed
# comment on such a line would build the kernel again. So their explanations stand on lines of their own.

TFA_UPSTREAM_BASE=347d1c164
UBOOT_UPSTREAM_BASE=f605dcee103
CRUST_UPSTREAM_BASE=499a362645e
SUNXI_TOOLS_UPSTREAM_BASE=7540cb2

# TF-A's platform; BL31 runs from DRAM at 0x40000000 (BL31_IN_DRAM), the kernel is loaded above it.
ATF_PLAT=sun50i_h713

# What a release crust may carry beyond the self-refresh image (release/check-crust.py reads this line). Empty
# until the R_WDOG behind the sleep net is measured (stage S0 of the crust standby); then H713_SLEEP_NET, and
# DEBUG_VERIFY_DRAM (the DRAM checksum of the test image) only once the device stages show that the ARISC reads
# this DRAM without false alarms. Deep sleep, its stages and test builds never.
CRUST_RELEASE_ALLOW=""

# The kernel: Linux 6.18.38 LTS from kernel.org with the series in patches/kernel/ and the defconfig of the image
# in patches/kernel/board/. Which device tree a board boots is a property of the board (boards/<id>/board.env,
# doku/121 section 3). The two HY200 device trees are always built and kept next to it, so that a regression on
# cstenger's bench boards shows; the projector's tree (KERNEL_DTB_PROJECTOR) has never been booted on hardware.
# The FIT loads and enters the kernel at 0x48000000, clear of BL31.
KERNEL_VERSION=6.18.38
KERNEL_ARCH=arm64
KERNEL_DEFCONFIG=hy200_qz713df_a1_defconfig
KERNEL_DTB_BENCH=sun50i-h713-hy200-qz713df-a1
KERNEL_DTB_PROJECTOR=sun50i-h713-hy200-qz713-v2
KERNEL_TARBALL_URL="https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-${KERNEL_VERSION}.tar.xz"
KERNEL_TARBALL_SHA256=ac26e508abd56e9f8b89872b6e10c49fc823bcc70d8068a5d8504c1a7c4ff045
KERNEL_LOAD=0x48000000

# The U-Boot defconfigs of the two HY200 boards (the DDR3 one at a base clock of 624 MHz). Nothing reads the keys;
# boards/check.sh wants each name to stand in this file.
UBOOT_DEFCONFIG_DDR3=hy200_qz713df_a1_defconfig
UBOOT_DEFCONFIG_LPDDR3=hy200_qz713_v2_defconfig

# The AIC8800 Wi-Fi/Bluetooth driver (GPL), carried like the kernel: a pinned upstream tarball and a series of our
# own, no fork and no driver source in the repository. radxa-pkg/aic8800 ships the vendor's driver release
# 2026_0123_5f7be68d unchanged under src/ and a compatibility series of its own under debian/patches/. build.sh
# applies that series to the whole tarball first, then ours to the SDIO driver (patches/aic8800/README.md).
# Two vendor patches do not apply at this commit and are skipped by name, so that any other one that fails still
# stops the build: fix-usb-firmware-path (USB only, no SDIO hunk) and fix-Lower-the-debugging-log-level (already
# in, it would apply the wrong way round).
AIC8800_COMMIT=df4c783b663eba1956579c681acd5e45f25c671d
AIC8800_TARBALL_URL="https://codeload.github.com/radxa-pkg/aic8800/tar.gz/${AIC8800_COMMIT}"
AIC8800_TARBALL_SHA256=dec58a98da7f3da4150cfb522e2ce9f7ae66e61f4f9182c4e59763a61e146753
AIC8800_SUBTREE=src/SDIO/driver_fw/driver/aic8800
AIC8800_VENDOR_PATCH_SKIP="fix-usb-firmware-path.patch fix-Lower-the-debugging-log-level.patch"
