# H713 mainline — pinned versions (single source of truth for build/build.sh)
# Sourced as shell. Component *sources* are the git submodules under external/;
# the exact commit is the submodule gitlink. The bases below record which
# upstream each curated series sits on, for provenance and rebases.

# --- TF-A BL31 (external/arm-trusted-firmware @ sun50i-h713) ---
ATF_BASE=347d1c164          # upstream TF-A commit the sun50i_h713 series is on
ATF_PLAT=sun50i_h713

# --- U-Boot (external/u-boot @ h713) ---
UBOOT_BASE=f605dcee103      # upstream U-Boot commit the h713 series is on
UBOOT_DEFCONFIG_DDR3=hy200_qz713df_a1_defconfig    # HY200 QZ713DF_A1 bench (DDR3)
UBOOT_DEFCONFIG_LPDDR3=hy200_qz713_v2_defconfig     # HY200 QZ713_V2 projector (LPDDR3)

# --- sunxi-tools (external/sunxi-tools @ h713) ---
SUNXITOOLS_BASE=7540cb2     # upstream sunxi-tools commit the h713 series is on

# --- Linux kernel (mainline tarball + patches/kernel/) ---
KERNEL_VERSION=6.18.38                              # LTS; boot-good on HY200 QZ713DF_A1
KERNEL_TARGET=6.18.38                               # current target (see docs/kernel-bump.md)
KERNEL_ARCH=arm64
KERNEL_DEFCONFIG=hy200_qz713df_a1_defconfig            # bench (HY200 QZ713DF_A1)
KERNEL_DTB=sun50i-h713-hy200-qz713df-a1              # arm64 board DTB (patch 0024, bench)
KERNEL_DTB_PROJECTOR=sun50i-h713-hy200-qz713-v2       # arm64 projector DTB (untested on hardware)
KERNEL_TARBALL_URL="https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-${KERNEL_VERSION}.tar.xz"
KERNEL_TARBALL_SHA256=ac26e508abd56e9f8b89872b6e10c49fc823bcc70d8068a5d8504c1a7c4ff045

# --- AIC8800 WiFi/BT driver (pinned vendor tarball + patches/aic8800/) ---
# WiFi over SDIO (mmc1), BT over UART HCI. The driver is GPL and is carried the
# same way as the kernel: a pinned upstream tarball plus a curated patch series,
# not a fork and not vendored source. Upstream is radxa-pkg/aic8800, which
# redistributes an unmodified Aicsemi release under src/ together with its own
# kernel-compat series under debian/patches/. Both are applied — theirs first,
# to the whole repo, then ours to the extracted SDIO subtree. See
# patches/aic8800/README.md.
AIC8800_COMMIT=df4c783b663eba1956579c681acd5e45f25c671d   # radxa-pkg/aic8800; driver release 2026_0123_5f7be68d
AIC8800_TARBALL_URL="https://codeload.github.com/radxa-pkg/aic8800/tar.gz/${AIC8800_COMMIT}"
AIC8800_TARBALL_SHA256=dec58a98da7f3da4150cfb522e2ce9f7ae66e61f4f9182c4e59763a61e146753
AIC8800_SUBTREE=src/SDIO/driver_fw/driver/aic8800        # the SDIO driver inside the repo
# Vendor patches that do not apply at AIC8800_COMMIT and are expected to be
# skipped. Listing them by name means an *unexpected* failure still stops the
# build. fix-usb-firmware-path: USB-only, zero SDIO hunks.
# fix-Lower-the-debugging-log-level: already merged upstream (applies reversed).
AIC8800_VENDOR_PATCH_SKIP="fix-usb-firmware-path.patch fix-Lower-the-debugging-log-level.patch"

# --- AIC8800 firmware (proprietary blob) ---
# No open equivalent exists, so it is NOT committed — it is pinned by SHA-256
# and copied into the rootfs at build time from the local-only source of record.
# Paths are relative to the repo root.
AIC8800_FW_SRC=local/allwinner-h713-linux/drivers/wifi/firmware/aic8800_sdio/aic8800D80
AIC8800_FW_SUMS=modules/aic8800/firmware.sha256sums   # tracked checksum manifest (pin)
# Must equal the driver's CONFIG_AIC_FW_PATH. The vendor rebase moved it:
# radxa's debian/patches/fix-sdio-firmware-path.patch sets it to
# /lib/firmware/aic8800_fw/SDIO/aic8800D80 (was aic8800_sdio/aic8800). On
# Debian /lib is a symlink to /usr/lib, so this path IS /lib/firmware/...;
# if these two ever drift apart the driver loads no firmware and wlan0 never
# appears, with only "file failed to open" in dmesg to say why.
AIC8800_FW_DEST=usr/lib/firmware/aic8800_fw/SDIO/aic8800D80

# --- Optional boot WiFi hotspot (AP) ---
# If this (local-only, gitignored) file exists, the rootfs build bakes in an
# on-boot hotspot from its settings; absent => no hotspot. Keeps the SSID/
# passphrase out of git. See tools/rootfs/hotspot.conf.example for the format.
HOTSPOT_CONF=local/hotspot.conf

# --- libva-v4l2-request (VA-API shim, patches/libva-v4l2-request/) ---
# The VA-API driver that lets stock mpv/ffmpeg decode on the VE. Cloned and
# patched rather than vendored; build it ON THE BOARD (the driver entry-point
# symbol is derived from the libva version at build time). PR #38, not master.
LIBVAV4L2REQ_UPSTREAM=https://github.com/bootlin/libva-v4l2-request
LIBVAV4L2REQ_REF=refs/pull/38/head
LIBVAV4L2REQ_BASE=1c5f2cad21dff3b56d35355082867c24e4f191c6

# --- Debian root filesystem ---
DEBIAN_SUITE=trixie
DEBIAN_ARCH=arm64
DEBIAN_MIRROR=https://deb.debian.org/debian
DEBIAN_ARCHIVE_KEYRING=/usr/share/keyrings/debian-archive-keyring.gpg
ROOTFS_IMAGE_SIZE=2G

# --- Memory map / load addresses (see docs/bringup-notes.md) ---
BL31_BASE=0x40000000        # BL31_IN_DRAM
KERNEL_LOAD=0x48000000      # FIT load/entry (arm64 Image), keeps clear of BL31
