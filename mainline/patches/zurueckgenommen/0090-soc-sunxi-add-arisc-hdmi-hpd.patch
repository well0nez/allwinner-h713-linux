From: well0nez <well0nez@users.noreply.github.com>
Subject: [PATCH] soc: sunxi: drive the H713 HDMI hotplug pin through the ARISC

The HPD pin of this SoC belongs to the ARISC, a small OpenRISC coprocessor
that owns the R_ peripherals. Linux cannot write the pin -- reading its
register from the ARM hangs the SoC hard -- but it can ask the ARISC to do
it, and the stock firmware we load into the ARISC answers.

The message goes over msgbox 0x03003000, user1 port 0. That port is not the
one the vendor code and every earlier attempt used: port 3 reaches a separate
power-management dispatcher that knows nine message types and answers
everything else with -3. Port 0 reaches the receiver that handles HDMI
sub-commands. Getting this wrong is what made the path look "hollow by
design" for a long time.

One quirk decides the shape of send_sub_cmd(): the firmware's receiver keeps
the frame length in a register, not in its context, and a poller wakes it as
soon as the first word lands. Split the words and the length is gone by the
time the second one arrives. The receiver reads the sub-command from its
payload buffer rather than from the length, so the driver writes the payload
into that buffer and sends a zero-length frame. That is immune to the race
instead of hoping to win it.

Verified on a HY310: PullHotPlug for all three ports and all three values
(UP, DOWN, RESET), each confirmed twice over -- the handler zeroes a scratch
buffer, and RESET puts exactly 84 into the port's counter, which a ~100 Hz
timer inside the firmware walks down before the firmware's main loop raises
the pin. Both are read back, so a command that did not arrive returns -EIO
rather than a silent success.

The main loop can be wedged by a half-finished frame on port 3, which also
stops HDMI from working; the driver detects that (the counter stops at 1
instead of reaching 0) and frees it with zero words before every command.
Tested by wedging it deliberately.

Interface is debugfs for now, and the addresses are fixed rather than coming
from the devicetree -- both are the right size for this step; a proper
binding follows once the DRM side needs it.


Startup handshake (2026-09-06): after loading, the firmware sends a startup
notify on msgbox ch3 (ARISC -> ARM) and then waits up to 100000 ticks for the
ARM's reply on user1 port 3 (header word, then count). Until that reply
arrives it sits in front of its main loop and serves no HDMI command; without
a reader the notify itself already blocks ~100 s at word 9 (FIFO depth 8).
The stock ARM driver performs this handshake; startup_handshake() does it at
module load and status shows the result. Only the notify is acknowledged --
acknowledging replies (result -3 from the standby dispatcher) ping-pongs.
diff -ruN a/drivers/soc/sunxi/arisc_hdmi/arisc_hdmi.c b/drivers/soc/sunxi/arisc_hdmi/arisc_hdmi.c
--- a/drivers/soc/sunxi/arisc_hdmi/arisc_hdmi.c	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/soc/sunxi/arisc_hdmi/arisc_hdmi.c	2026-09-06 15:25:59.000000000 +0200
@@ -0,0 +1,851 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * arisc_hdmi.c — HDMI-Hotplug (HPD) über die ARISC des Allwinner H713
+ *
+ * Der HPD-Pin gehört der ARISC (OpenRISC-Coprozessor). Linux schreibt ihn
+ * nicht selbst, sondern schickt der laufenden ARISC-Firmware über die Msgbox
+ * den Unterbefehl PullHotPlug (0x0211); die Firmware setzt den Pin.
+ *
+ * Alle Adressen und Abläufe sind am Gerät verifiziert (HY310, ARISC-Firmware
+ * TV-303 00.00.00.09). Referenzwerkzeug mit derselben Semantik:
+ * analyse/arisc-msg/arisc_hdmi.py; Herleitung in
+ * doku/68-stock-extraktion-arisc-hdcp.md.
+ *
+ * Schnittstelle: debugfs, /sys/kernel/debug/arisc-hdmi/
+ *   hotplug    W  "<port> up|down|reset"  PullHotPlug über die Msgbox
+ *   hpd_delay  W  "<port> <ms>"           Flanke über den Zähler, ohne Nachricht
+ *   status     R                          Hauptschleife, Zähler, Empfänger, FIFOs
+ *   unstick    W                          Rettung einer hängenden Hauptschleife
+ * Die beschreibbaren Dateien geben beim Lesen das Ergebnis des letzten
+ * Befehls zurück.
+ *
+ * Feste ioremap-Adressen, kein Device-Tree-Binding -- das kommt später.
+ */
+
+#define pr_fmt(fmt) "arisc-hdmi: " fmt
+
+#include <linux/module.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/io.h>
+#include <linux/delay.h>
+#include <linux/ktime.h>
+#include <linux/mutex.h>
+#include <linux/debugfs.h>
+#include <linux/seq_file.h>
+#include <linux/uaccess.h>
+#include <linux/string.h>
+#include <linux/bitops.h>
+#include <linux/minmax.h>
+#include <linux/math.h>
+#include <linux/errno.h>
+
+/* ── Msgbox 0x03003000, Bank user1 = ARM -> ARISC ──────────────────── */
+/*
+ * Nur diese Bank wird gemappt. user2 (0x03003800) gehört cpu_comm
+ * (ARM <-> MIPS) und wird nicht angefasst. MSG_DATA wird nie gelesen:
+ * ein Lesezugriff poppt die FIFO.
+ */
+#define MSGBOX_U1_PHYS		0x03003400UL
+#define MSGBOX_U1_LEN		0x100
+#define U1_TX_IRQ_EN		0x30			/* 0x03003430: Doorbell, Bit (2*port+1) */
+#define U1_FIFO_STAT(p)		(0x60 + 4 * (p))	/* 0x03003460 + 4*port; nur 0 = leer ist verlässlich */
+#define U1_MSG_DATA(p)		(0x70 + 4 * (p))	/* 0x03003470 + 4*port */
+
+#define PORT_HDMI		0	/* RPM-Pumpe: der einzige HDMI-Weg */
+#define PORT_STANDBY		3	/* Standby-Dispatcher: ausschließlich für die Rettung */
+
+/* ── Msgbox Bank user0 = ARISC -> ARM (Empfang), nur ch3 ───────────── */
+/*
+ * Startup-Handshake der Firmware (Disassembly 0xc4b0..0xc548, Sender 0x75e0,
+ * Warteroutine 0x756c; Boots 105-108 am 06.09.2026 gemessen): nach dem Start
+ * sendet die ARISC ihre Startup-Notify (Kopf state|attr|type=0x90|result,
+ * count=13, 13 Datenwörter = Versionsstring) auf ARM-RX ch3 und wartet dann
+ * in 0x756c(3) mit 100000 Ticks Timeout auf die Antwort des ARM auf ihrer
+ * RX user1 Port 3: Kopfwort, dann count. Ohne Leser blockiert schon Wort 9
+ * der Notify ~100 s (FIFO 8 tief), mit Leser ohne Antwort die Quittung
+ * ~100 s. Erst danach läuft die Hauptschleife, erst dann werden
+ * HDMI-Befehle bedient. Der Stock-ARM-Treiber liest die Notify und
+ * antwortet; das tut hier startup_handshake() beim Laden.
+ */
+#define MSGBOX_U0_PHYS		0x03003000UL
+#define MSGBOX_U0_LEN		0x100
+#define U0_FIFO_STAT(c)		(0x60 + 4 * (c))	/* 0x03003060 + 4*ch: Wörter in der FIFO */
+#define U0_MSG_DATA(c)		(0x70 + 4 * (c))	/* 0x03003070 + 4*ch: Lesen poppt */
+#define CH_NOTIFY		3
+#define NOTIFY_TYPE		0x90
+#define NOTIFY_MAX_WORDS	16
+#define NOTIFY_WAIT_MS		3000	/* die ARISC ist beim Laden längst gestartet */
+#define NOTIFY_GAP_MS		200	/* Wortlücke: die Firmware sendet Wort für Wort */
+
+/* ── ARISC-SRAM, ARM-Sicht = ARISC-Adresse + 0x100000 ──────────────── */
+/*
+ * Gemappt wird nur 0x115000..0x118000, außerhalb wird nichts geschrieben.
+ * Zugriffe wortweise (readl/writel) oder byteweise (readb/writeb); breitere
+ * oder schief ausgerichtete Zugriffe lösen auf dem Device-Mapping
+ * Alignment-Faults aus.
+ */
+#define SRAM_PHYS		0x00115000UL
+#define SRAM_LEN		0x3000
+#define RPM_STATE		0x115f54UL	/* Zustandswort des Empfängers, 0 = bereit; nur lesen */
+#define RPM_BUF			0x115f59UL	/* Nutzlast: sub_cmd_lo, sub_cmd_hi, arg1, arg2 */
+#define HPD_COUNTER		0x11722cUL	/* 3 Bytes: HPD-Zähler Port 0..2 */
+#define SCRATCH			0x117320UL	/* 65 Bytes, vom Befehls-Handler genullt */
+
+#define SCRATCH_WORDS		17
+#define SCRATCH_PATTERN		0xAAAAAAAAU
+#define SCRATCH_ZEROED_MIN	14	/* memset(…, 0, 0x41) nullt 16 volle Wörter; gemessen 15 */
+
+/* ── Das Protokoll ─────────────────────────────────────────────────── */
+#define BOP_MARKER		0xA5	/* Kopfwort: Marker | seq<<8; type 0, Länge 0 */
+#define SUB_CMD_LO_MIN		0x10	/* außerhalb 0x10..0x15 verwirft die Firmware */
+#define SUB_CMD_LO_MAX		0x15
+#define SUB_CMD_PULL_HOTPLUG	0x0211
+
+#define HPD_PORTS		3
+#define HPD_UP			1	/* Zähler += 1 */
+#define HPD_DOWN		2	/* Pin sofort low, Zähler unverändert */
+#define HPD_RESET		3	/* Pin low, dann Zähler = 84 */
+#define HPD_RESET_COUNTER	84
+#define HPD_RESET_PEAK_MIN	70	/* gemessen 80..84; darunter kam der Befehl nicht an */
+#define HPD_TICK_MS		10	/* Timer ~100 Hz */
+#define HPD_COUNTER_MAX		255	/* ein Byte */
+
+/* ── Wartezeiten: Anhaltspunkte, am Gerät gemessen ─────────────────── */
+#define ALIVE_PROBE		3	/* Zähler 3: nach ~30 ms bei 1, dann Hauptschleife -> 0 */
+#define ALIVE_TIMEOUT_MS	500	/* Soll ~100 ms; ein Fehlurteil hieße Rettung, daher großzügig */
+#define HANDLER_TIMEOUT_MS	500	/* bis dahin muss die Sonde genullt sein */
+#define PEAK_TIMEOUT_MS		100	/* RESET: der Zähler muss nach dem Handler sofort oben sein */
+#define CMD_TIMEOUT_MS		2000	/* RESET: 84 Ticks à ~10 ms plus Reserve */
+#define FIFO_EMPTY_TIMEOUT_MS	100
+#define UNSTICK_MAX_WORDS	10
+
+enum wait_mode {
+	WAIT_HANDLER,		/* DOWN:  nur die Sonde */
+	WAIT_ZERO,		/* UP:    Sonde, dann Zähler wieder 0 */
+	WAIT_PEAK_ZERO,		/* RESET: Sonde, Zähler ~84, dann 0 */
+};
+
+struct cmd_result {
+	bool ran;		/* Sonde genullt: classify und Handler liefen */
+	unsigned int zeroed;	/* genullte Sondenwörter, 0..17 */
+	u8 before;		/* Zähler des Ports vor dem Senden */
+	u8 peak;		/* Maximum danach */
+	u8 last;		/* zuletzt gelesener Stand */
+	int ms;			/* Dauer bis Abschluss oder Abbruch */
+};
+
+static void __iomem *msgbox;		/* Bank user1 */
+static void __iomem *msgbox_rx;		/* Bank user0: nur ch3 (Startup-Notify) */
+static void __iomem *sram;		/* 0x115000..0x118000 */
+static char notify_version[64] = "keine Notify gesehen";
+static int notify_result = -ENODATA;	/* 0 = quittiert; sonst Fehlercode */
+static DEFINE_MUTEX(lock);		/* ein Zugriff auf die ARISC zur Zeit */
+static u8 seq = 1;			/* rotierende Folgenummer im Kopfwort */
+static u8 down_mask;			/* Ports, die wir selbst auf DOWN gesetzt haben */
+
+/*
+ * Letzte Lebensprüfung. status() gibt nur diesen Zwischenspeicher aus und
+ * fasst die Hardware nicht an -- die aktive Prüfung steht in probe().
+ */
+static int		alive_ms = -2;	/* -2 = noch nie geprüft, -1 = hing */
+static unsigned int	alive_port;
+static ktime_t		alive_at;
+static struct dentry *dbg_dir;
+
+static char last_hotplug[160] = "noch kein Befehl\n";
+static char last_delay[128] = "noch kein Befehl\n";
+static char last_unstick[96] = "noch nicht ausgefuehrt\n";
+
+/* ── Zugriffshelfer ────────────────────────────────────────────────── */
+
+static inline void __iomem *sram_addr(unsigned long phys)
+{
+	return sram + (phys - SRAM_PHYS);
+}
+
+static inline u8 hpd_counter_read(unsigned int port)
+{
+	return readb(sram_addr(HPD_COUNTER) + port);
+}
+
+static inline void hpd_counter_write(unsigned int port, u8 v)
+{
+	writeb(v, sram_addr(HPD_COUNTER) + port);
+}
+
+/*
+ * Doorbell: die Msgbox ist flankengesteuert. Ohne den Puls auf TX_IRQ_EN
+ * bleibt das Wort in der FIFO liegen und wird nie abgeholt.
+ */
+static void doorbell(unsigned int port)
+{
+	u32 old = readl(msgbox + U1_TX_IRQ_EN);
+
+	writel(old | BIT(2 * port + 1), msgbox + U1_TX_IRQ_EN);
+	usleep_range(20, 50);
+	writel(old, msgbox + U1_TX_IRQ_EN);
+}
+
+/*
+ * Startup-Notify der Firmware lesen und quittieren (siehe Kopfkommentar zu
+ * MSGBOX_U0_PHYS). Liest ch3 Wort für Wort (die Firmware schiebt nach, sobald
+ * Platz ist), prüft Kopf und Länge, antwortet auf user1 Port 3 mit dem
+ * Kopfwort (result 0) und count 0 und klopft an. Nur die Notify wird
+ * quittiert -- eine Antwort auf beliebige Rahmen erzeugte ein Ping-Pong mit
+ * dem Standby-Dispatcher (result -3), gemessen Boot 108.
+ * Rückgabe: 0 quittiert; -ETIMEDOUT keine Notify (Firmware lief schon durch
+ * oder ist nicht geladen); -EPROTO unerwarteter Kopf.
+ */
+static int startup_handshake(void)
+{
+	u32 words[NOTIFY_MAX_WORDS];
+	unsigned int n = 0, need = 2, i;
+	ktime_t t0 = ktime_get(), last = t0;
+	u32 hdr, cnt, old;
+	char *p;
+
+	while (n < need) {
+		if (readl(msgbox_rx + U0_FIFO_STAT(CH_NOTIFY))) {
+			words[n++] = readl(msgbox_rx + U0_MSG_DATA(CH_NOTIFY));
+			last = ktime_get();
+			if (n == 2) {
+				cnt = words[1] & 0xff;
+				if (cnt > NOTIFY_MAX_WORDS - 2)
+					return -EPROTO;
+				need = 2 + cnt;
+			}
+			continue;
+		}
+		if (ktime_ms_delta(ktime_get(), n ? last : t0) >
+		    (n ? NOTIFY_GAP_MS : NOTIFY_WAIT_MS))
+			return n ? -EPROTO : -ETIMEDOUT;
+		usleep_range(500, 1000);
+	}
+	hdr = words[0];
+	if (((hdr >> 16) & 0xff) != NOTIFY_TYPE || (hdr >> 24) != 0)
+		return -EPROTO;
+
+	/*
+	 * Versionsstring: die Firmware sendet die Wörter ab einer um ein Byte
+	 * versetzten Adresse; in Busreihenfolge (LSB zuerst) erscheint der Text
+	 * um ein Byte verschoben und je Vierergruppe gedreht (Boot 108 gemessen:
+	 * "]ejorrotc3vt-a-30…" = ']' + rev4("rojector-tv303-…")). Deshalb: Bytes
+	 * in Busreihenfolge sammeln, ab Byte 1 je Vierergruppe umkehren.
+	 */
+	{
+		u8 raw[4 * NOTIFY_MAX_WORDS];
+		unsigned int nb = 0, m;
+
+		for (i = 2; i < n; i++) {
+			raw[nb++] = words[i] & 0xff;
+			raw[nb++] = (words[i] >> 8) & 0xff;
+			raw[nb++] = (words[i] >> 16) & 0xff;
+			raw[nb++] = (words[i] >> 24) & 0xff;
+		}
+		p = notify_version;
+		for (m = 0; m + 1 < nb && p < notify_version + sizeof(notify_version) - 1; m++) {
+			unsigned int idx = 1 + 4 * (m / 4) + (3 - m % 4);
+			char c = idx < nb ? raw[idx] : 0;
+
+			if (c < 0x20 || c >= 0x7f)
+				break;
+			*p++ = c;
+		}
+		*p = '\0';
+	}
+
+	writel(hdr & 0x00ffffffU, msgbox + U1_MSG_DATA(PORT_STANDBY));
+	writel(0, msgbox + U1_MSG_DATA(PORT_STANDBY));
+	old = readl(msgbox + U1_TX_IRQ_EN);
+	writel(old | BIT(2 * PORT_STANDBY + 1), msgbox + U1_TX_IRQ_EN);
+	usleep_range(20, 50);
+	writel(old, msgbox + U1_TX_IRQ_EN);
+	return 0;
+}
+
+/*
+ * Lebensprüfung: Zähler auf 3 setzen. Der Timer-ISR (~100 Hz) zählt nur bis
+ * 1 herunter; auf 0 bringt ihn ausschließlich die Hauptschleife -- und setzt
+ * dabei den Pin des Ports high. Der Aufrufer wählt deshalb mit probe_port()
+ * einen Port, der nach unserem Wissen ohnehin high ist.
+ * Rückgabe: Millisekunden bis zur 0, oder -1 wenn die Hauptschleife hängt
+ * (der Zähler bleibt dann auf 1 stehen).
+ */
+static int main_loop_alive(unsigned int port)
+{
+	ktime_t t0 = ktime_get();
+	s64 ms;
+	int res = -1;
+
+	hpd_counter_write(port, ALIVE_PROBE);
+	do {
+		usleep_range(5000, 7000);
+		ms = ktime_ms_delta(ktime_get(), t0);
+		if (hpd_counter_read(port) == 0) {
+			res = ms;
+			break;
+		}
+	} while (ms < ALIVE_TIMEOUT_MS);
+
+	alive_ms = res;
+	alive_port = port;
+	alive_at = ktime_get();
+	return res;
+}
+
+/*
+ * Port für die Lebensprüfung: bevorzugt der gewünschte, sonst der erste, den
+ * wir nicht selbst auf DOWN gesetzt haben. Auf einem Port, der schon high
+ * ist, ist die Prüfung elektrisch unsichtbar. Sind alle unten, bleibt nur
+ * der gewünschte. Was das Referenzwerkzeug nebenher geschaltet hat, wissen
+ * wir nicht -- den Pin selbst dürfen wir nicht lesen (0x07091014 hängt den SoC).
+ */
+static unsigned int probe_port(unsigned int pref)
+{
+	unsigned int p;
+
+	if (!(down_mask & BIT(pref)))
+		return pref;
+	for (p = 0; p < HPD_PORTS; p++)
+		if (!(down_mask & BIT(p)))
+			return p;
+	return pref;
+}
+
+/*
+ * Rettung einer hängenden Hauptschleife. Der Standby-Dispatcher auf Port 3
+ * wartet ohne Zeitlimit auf die restlichen Wörter eines angefangenen Rahmens
+ * und blockiert dabei die ganze Hauptschleife. Einzelne Nullwörter
+ * vervollständigen den Rahmen; je zwei ergeben einen Leerrahmen, den die
+ * Firmware mit -3 quittiert -- unschädlich. Nach jedem Wort die Lebensprüfung;
+ * in der Praxis genügten drei Wörter.
+ * Rückgabe: Anzahl der nötigen Wörter, oder -ENODEV (Neustart nötig).
+ */
+static int rescue(unsigned int port)
+{
+	int i;
+
+	for (i = 1; i <= UNSTICK_MAX_WORDS; i++) {
+		writel(0, msgbox + U1_MSG_DATA(PORT_STANDBY));
+		doorbell(PORT_STANDBY);
+		if (main_loop_alive(port) >= 0) {
+			pr_info("Hauptschleife befreit nach %d Nullwort(en) auf Port 3\n", i);
+			return i;
+		}
+	}
+	pr_err("Hauptschleife haengt und liess sich mit %d Nullwoertern nicht befreien -- Geraet neu starten\n",
+	       UNSTICK_MAX_WORDS);
+	return -ENODEV;
+}
+
+/* Vor jedem Befehl: läuft die Hauptschleife? Wenn nicht, einmal die Rettung. */
+static int ensure_alive(unsigned int port)
+{
+	int n;
+
+	if (main_loop_alive(port) >= 0)
+		return 0;
+	pr_warn("Hauptschleife haengt -- versuche die Rettung ueber Port 3\n");
+	n = rescue(port);
+	return n < 0 ? n : 0;
+}
+
+static unsigned int scratch_zeroed(void)
+{
+	unsigned int i, n = 0;
+
+	for (i = 0; i < SCRATCH_WORDS; i++)
+		if (readl(sram_addr(SCRATCH) + 4 * i) == 0)
+			n++;
+	return n;
+}
+
+/*
+ * Einen HDMI-Unterbefehl abliefern, genau in dieser Reihenfolge:
+ *   1. Nutzlast nach 0x115f59 -- die Firmware liest den Befehl von dort
+ *   2. Kopfwort 0xA5 | seq<<8 nach MSG_DATA Port 0: type 0, Länge 0
+ *   3. Füllwort 0 nach MSG_DATA Port 0
+ *   4. Doorbell Port 0
+ * Die Länge 0 ist Absicht: so ist der Ablauf gegen das Zeitrennen in der
+ * Empfangspumpe immun. Die Nutzlast als weitere Msgbox-Wörter zu schicken
+ * funktioniert nur manchmal -- deshalb nicht.
+ *
+ * Ob der Handler lief, zeigt die memset-Sonde bei 0x117320; was er tat, der
+ * Zähler des beobachteten Ports. Rückgabe: 0, -EINVAL, -EBUSY (FIFO nicht
+ * leer), -EIO (nachweislich nicht angekommen), -ETIMEDOUT (angekommen, aber
+ * der Zähler ging nicht auf 0 -- der Aufrufer prüft dann die Hauptschleife).
+ */
+static int send_sub_cmd(u16 sub_cmd, u8 arg1, u8 arg2, unsigned int port,
+			enum wait_mode wait, struct cmd_result *r)
+{
+	u8 lo = sub_cmd & 0xff, hi = sub_cmd >> 8;
+	ktime_t t0;
+	s64 ms, ran_ms = 0;
+	unsigned int i;
+	u8 cur;
+
+	if (lo < SUB_CMD_LO_MIN || lo > SUB_CMD_LO_MAX)
+		return -EINVAL;
+
+	memset(r, 0, sizeof(*r));
+
+	/* Ein Rest in der FIFO hieße: die Pumpe holt nicht ab. Dann nicht nachlegen. */
+	t0 = ktime_get();
+	while (readl(msgbox + U1_FIFO_STAT(PORT_HDMI)) != 0) {
+		if (ktime_ms_delta(ktime_get(), t0) > FIFO_EMPTY_TIMEOUT_MS) {
+			pr_err("FIFO Port 0 nicht leer (FIFO_STAT=%u), sende nicht\n",
+			       readl(msgbox + U1_FIFO_STAT(PORT_HDMI)));
+			return -EBUSY;
+		}
+		usleep_range(1000, 2000);
+	}
+
+	/* 1. Nutzlast; dazu die Sonde scharf machen */
+	writeb(lo, sram_addr(RPM_BUF) + 0);
+	writeb(hi, sram_addr(RPM_BUF) + 1);
+	writeb(arg1, sram_addr(RPM_BUF) + 2);
+	writeb(arg2, sram_addr(RPM_BUF) + 3);
+	for (i = 0; i < SCRATCH_WORDS; i++)
+		writel(SCRATCH_PATTERN, sram_addr(SCRATCH) + 4 * i);
+	r->before = hpd_counter_read(port);
+
+	/*
+	 * 2.-4. Kopfwort, Füllwort, Doorbell. writel() enthält die
+	 * Schreibsperre, welche die SRAM-Zugriffe davor einordnet.
+	 */
+	writel(BOP_MARKER | ((u32)seq << 8), msgbox + U1_MSG_DATA(PORT_HDMI));
+	writel(0, msgbox + U1_MSG_DATA(PORT_HDMI));
+	doorbell(PORT_HDMI);
+	seq = seq % 255 + 1;
+
+	/* Beobachten: Sonde, dann Zählerverlauf -- je nach Befehl */
+	t0 = ktime_get();
+	do {
+		usleep_range(1000, 2000);
+		ms = ktime_ms_delta(ktime_get(), t0);
+		if (!r->ran) {
+			r->zeroed = scratch_zeroed();
+			if (r->zeroed >= SCRATCH_ZEROED_MIN) {
+				r->ran = true;
+				ran_ms = ms;
+			}
+		}
+		cur = hpd_counter_read(port);
+		r->peak = max(r->peak, cur);
+		r->last = cur;
+		if (!r->ran) {
+			if (ms > HANDLER_TIMEOUT_MS)
+				break;
+			continue;
+		}
+		if (wait == WAIT_HANDLER)
+			break;
+		if (wait == WAIT_PEAK_ZERO && r->peak < HPD_RESET_PEAK_MIN) {
+			if (ms - ran_ms > PEAK_TIMEOUT_MS)
+				break;
+			continue;
+		}
+		if (cur == 0)
+			break;
+	} while (ms < CMD_TIMEOUT_MS);
+	r->ms = ms;
+
+	if (!r->ran) {
+		pr_warn("sub_cmd 0x%04x: Handler lief nicht (Sonde %u/%u genullt) -- nicht angekommen\n",
+			sub_cmd, r->zeroed, SCRATCH_WORDS);
+		return -EIO;
+	}
+	if (wait == WAIT_PEAK_ZERO && r->peak < HPD_RESET_PEAK_MIN) {
+		pr_warn("RESET Port %u: Zaehler kam nur auf %u statt ~%u -- nicht angekommen\n",
+			port, r->peak, HPD_RESET_COUNTER);
+		return -EIO;
+	}
+	if (wait != WAIT_HANDLER && r->last != 0) {
+		pr_warn("Port %u: Zaehler blieb nach %d ms auf %u stehen\n",
+			port, r->ms, r->last);
+		return -ETIMEDOUT;
+	}
+	return 0;
+}
+
+/* ── Die Befehle ───────────────────────────────────────────────────── */
+
+static const char *action_name(unsigned int value)
+{
+	switch (value) {
+	case HPD_UP:
+		return "UP";
+	case HPD_DOWN:
+		return "DOWN";
+	case HPD_RESET:
+		return "RESET";
+	}
+	return "?";
+}
+
+/*
+ * Blieb der Zähler nach einem angekommenen Befehl stehen, hängt vermutlich
+ * die Hauptschleife -- dann einmal die Rettung. Gelingt sie, bleibt es bei
+ * -ETIMEDOUT (der Puls kam verspätet), sonst -ENODEV.
+ */
+static int after_stall(unsigned int port, int ret)
+{
+	unsigned int p = probe_port(port);
+
+	if (ret != -ETIMEDOUT || main_loop_alive(p) >= 0)
+		return ret;
+	pr_warn("Hauptschleife haengt nach dem Befehl -- versuche die Rettung\n");
+	return rescue(p) < 0 ? -ENODEV : ret;
+}
+
+static int do_hotplug(unsigned int port, unsigned int value)
+{
+	static const enum wait_mode wait_for[] = {
+		[HPD_UP] = WAIT_ZERO,
+		[HPD_DOWN] = WAIT_HANDLER,
+		[HPD_RESET] = WAIT_PEAK_ZERO,
+	};
+	struct cmd_result r = { };
+	int ret;
+
+	ret = ensure_alive(probe_port(port));
+	if (ret)
+		goto out;
+	ret = send_sub_cmd(SUB_CMD_PULL_HOTPLUG, port, value, port,
+			   wait_for[value], &r);
+	ret = after_stall(port, ret);
+	if (ret == 0) {
+		if (value == HPD_DOWN)
+			down_mask |= BIT(port);
+		else
+			down_mask &= ~BIT(port);
+	}
+out:
+	scnprintf(last_hotplug, sizeof(last_hotplug),
+		  "port=%u %s rc=%d handler=%s sonde=%u/%u zaehler vorher=%u max=%u ende=%u dauer=%dms\n",
+		  port, action_name(value), ret, r.ran ? "ja" : "NEIN",
+		  r.zeroed, SCRATCH_WORDS, r.before, r.peak, r.last, r.ms);
+	pr_info("PullHotPlug %s", last_hotplug);
+	return ret;
+}
+
+/*
+ * Nebenweg ohne Nachricht: den Zähler direkt setzen. n Ticks à ~10 ms, dann
+ * setzt die Hauptschleife den Pin. Wartet, bis der Zähler wieder 0 ist.
+ */
+static int do_hpd_delay(unsigned int port, unsigned int ms_req)
+{
+	unsigned int ticks = clamp_val(DIV_ROUND_CLOSEST(ms_req, HPD_TICK_MS),
+				       1, HPD_COUNTER_MAX);
+	ktime_t t0;
+	s64 ms = 0;
+	u8 cur = 0;
+	int ret;
+
+	ret = ensure_alive(probe_port(port));
+	if (ret)
+		goto out;
+
+	hpd_counter_write(port, ticks);
+	t0 = ktime_get();
+	do {
+		usleep_range(2000, 4000);
+		ms = ktime_ms_delta(ktime_get(), t0);
+		cur = hpd_counter_read(port);
+		if (cur == 0)
+			break;
+	} while (ms < ticks * HPD_TICK_MS + ALIVE_TIMEOUT_MS);
+
+	if (cur != 0) {
+		pr_warn("hpd_delay Port %u: Zaehler blieb nach %lld ms auf %u stehen\n",
+			port, ms, cur);
+		ret = after_stall(port, -ETIMEDOUT);
+	} else {
+		down_mask &= ~BIT(port);
+	}
+out:
+	scnprintf(last_delay, sizeof(last_delay),
+		  "port=%u ms=%u ticks=%u rc=%d ende=%u dauer=%lldms\n",
+		  port, ms_req, ticks, ret, cur, ms);
+	pr_info("hpd_delay %s", last_delay);
+	return ret;
+}
+
+static int do_unstick(void)
+{
+	unsigned int port = probe_port(0);
+	int n = 0;
+
+	if (main_loop_alive(port) < 0)
+		n = rescue(port);
+
+	if (n == 0)
+		scnprintf(last_unstick, sizeof(last_unstick),
+			  "frei, war nicht blockiert\n");
+	else if (n > 0)
+		scnprintf(last_unstick, sizeof(last_unstick),
+			  "befreit nach %d Nullwort(en) auf Port 3\n", n);
+	else
+		scnprintf(last_unstick, sizeof(last_unstick),
+			  "NICHT befreit -- Geraet neu starten\n");
+	return n < 0 ? n : 0;
+}
+
+/* ── debugfs ───────────────────────────────────────────────────────── */
+
+static int read_user_line(char *buf, size_t size, const char __user *ubuf,
+			  size_t count)
+{
+	if (count == 0 || count >= size)
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, count))
+		return -EFAULT;
+	buf[count] = '\0';
+	return 0;
+}
+
+static int parse_action(const char *word)
+{
+	if (!strcasecmp(word, "up") || !strcmp(word, "1"))
+		return HPD_UP;
+	if (!strcasecmp(word, "down") || !strcmp(word, "2"))
+		return HPD_DOWN;
+	if (!strcasecmp(word, "reset") || !strcmp(word, "3"))
+		return HPD_RESET;
+	return -EINVAL;
+}
+
+static ssize_t hotplug_write(struct file *file, const char __user *ubuf,
+			     size_t count, loff_t *ppos)
+{
+	char buf[32], word[8];
+	int port, value, ret;
+
+	ret = read_user_line(buf, sizeof(buf), ubuf, count);
+	if (ret)
+		return ret;
+	if (sscanf(buf, "%d %7s", &port, word) != 2)
+		return -EINVAL;
+	if (port < 0 || port >= HPD_PORTS)
+		return -EINVAL;
+	value = parse_action(word);
+	if (value < 0)
+		return value;
+
+	ret = mutex_lock_interruptible(&lock);
+	if (ret)
+		return ret;
+	ret = do_hotplug(port, value);
+	mutex_unlock(&lock);
+	return ret ?: count;
+}
+
+static ssize_t hpd_delay_write(struct file *file, const char __user *ubuf,
+			       size_t count, loff_t *ppos)
+{
+	char buf[32];
+	int port, ms, ret;
+
+	ret = read_user_line(buf, sizeof(buf), ubuf, count);
+	if (ret)
+		return ret;
+	if (sscanf(buf, "%d %d", &port, &ms) != 2)
+		return -EINVAL;
+	if (port < 0 || port >= HPD_PORTS)
+		return -EINVAL;
+	if (ms < 0 || ms > HPD_COUNTER_MAX * HPD_TICK_MS)
+		return -EINVAL;
+
+	ret = mutex_lock_interruptible(&lock);
+	if (ret)
+		return ret;
+	ret = do_hpd_delay(port, ms);
+	mutex_unlock(&lock);
+	return ret ?: count;
+}
+
+static ssize_t unstick_write(struct file *file, const char __user *ubuf,
+			     size_t count, loff_t *ppos)
+{
+	int ret;
+
+	ret = mutex_lock_interruptible(&lock);
+	if (ret)
+		return ret;
+	ret = do_unstick();
+	mutex_unlock(&lock);
+	return ret ?: count;
+}
+
+static int show_last(struct seq_file *s, const char *last)
+{
+	int ret = mutex_lock_interruptible(&lock);
+
+	if (ret)
+		return ret;
+	seq_puts(s, last);
+	mutex_unlock(&lock);
+	return 0;
+}
+
+static int hotplug_show(struct seq_file *s, void *unused)
+{
+	return show_last(s, last_hotplug);
+}
+
+static int hpd_delay_show(struct seq_file *s, void *unused)
+{
+	return show_last(s, last_delay);
+}
+
+static int unstick_show(struct seq_file *s, void *unused)
+{
+	return show_last(s, last_unstick);
+}
+
+/*
+ * status: fasst die Hardware NICHT an -- nur Lesezugriffe. Die Lebensprüfung
+ * steht in probe(), weil sie den Zähler schreibt und damit einen HPD-Pin hebt;
+ * ein Lesezugriff darf das nicht auslösen. MSG_DATA wird nie angefasst.
+ */
+static int status_show(struct seq_file *s, void *unused)
+{
+	int ret;
+
+	ret = mutex_lock_interruptible(&lock);
+	if (ret)
+		return ret;
+	if (alive_ms == -2)
+		seq_puts(s, "hauptschleife ungeprueft -- 'cat probe' fuer die aktive Pruefung\n");
+	else
+		seq_printf(s, "hauptschleife %s (port=%u, vor %lld ms geprueft)\n",
+			   alive_ms >= 0 ? "lief" : "HING", alive_port,
+			   ktime_ms_delta(ktime_get(), alive_at));
+	seq_printf(s, "hpd_zaehler %u %u %u\n", hpd_counter_read(0),
+		   hpd_counter_read(1), hpd_counter_read(2));
+	seq_printf(s, "rpm_zustand %u\n", readl(sram_addr(RPM_STATE)));
+	seq_printf(s, "rpm_puffer %02x %02x %02x %02x\n",
+		   readb(sram_addr(RPM_BUF) + 0), readb(sram_addr(RPM_BUF) + 1),
+		   readb(sram_addr(RPM_BUF) + 2), readb(sram_addr(RPM_BUF) + 3));
+	seq_printf(s, "fifo_stat port0=%u port3=%u\n",
+		   readl(msgbox + U1_FIFO_STAT(PORT_HDMI)),
+		   readl(msgbox + U1_FIFO_STAT(PORT_STANDBY)));
+	seq_printf(s, "down_mask 0x%x\n", down_mask);
+	seq_printf(s, "startup_notify %s (%s)\n",
+		   notify_result == 0 ? "quittiert" :
+		   notify_result == -ETIMEDOUT ? "nicht gesehen" : "fehlerhaft",
+		   notify_version);
+	mutex_unlock(&lock);
+	return 0;
+}
+
+/*
+ * probe: die aktive Lebensprüfung. Sie SCHREIBT den Zähler des Prüfports und
+ * hebt damit dessen HPD-Pin -- an einem HDMI-Eingang heißt das, die
+ * angeschlossene Quelle fängt an zu senden. Deshalb steht sie hier und nicht
+ * in status: wer sie auslöst, soll es absichtlich tun.
+ */
+static int probe_show(struct seq_file *s, void *unused)
+{
+	unsigned int port;
+	int ret, alive;
+
+	ret = mutex_lock_interruptible(&lock);
+	if (ret)
+		return ret;
+	port = probe_port(0);
+	alive = main_loop_alive(port);
+	seq_printf(s, "hauptschleife %s\n", alive >= 0 ? "laeuft" : "HAENGT");
+	seq_printf(s, "lebenspruefung port=%u ms=%d\n", port, alive);
+	mutex_unlock(&lock);
+	return 0;
+}
+
+#define ARISC_HDMI_FOPS(name, write_fn)					\
+static int name##_open(struct inode *inode, struct file *file)		\
+{									\
+	return single_open(file, name##_show, NULL);			\
+}									\
+static const struct file_operations name##_fops = {			\
+	.owner	 = THIS_MODULE,						\
+	.open	 = name##_open,						\
+	.read	 = seq_read,						\
+	.write	 = write_fn,						\
+	.llseek	 = seq_lseek,						\
+	.release = single_release,					\
+}
+
+ARISC_HDMI_FOPS(hotplug, hotplug_write);
+ARISC_HDMI_FOPS(hpd_delay, hpd_delay_write);
+ARISC_HDMI_FOPS(unstick, unstick_write);
+ARISC_HDMI_FOPS(status, NULL);
+ARISC_HDMI_FOPS(probe, NULL);
+
+/* ── Modul ─────────────────────────────────────────────────────────── */
+
+static int __init arisc_hdmi_init(void)
+{
+	msgbox = ioremap(MSGBOX_U1_PHYS, MSGBOX_U1_LEN);
+	if (!msgbox)
+		return -ENOMEM;
+	msgbox_rx = ioremap(MSGBOX_U0_PHYS, MSGBOX_U0_LEN);
+	if (!msgbox_rx) {
+		iounmap(msgbox);
+		return -ENOMEM;
+	}
+	sram = ioremap(SRAM_PHYS, SRAM_LEN);
+	if (!sram) {
+		iounmap(msgbox_rx);
+		iounmap(msgbox);
+		return -ENOMEM;
+	}
+
+	/*
+	 * Zuerst der Startup-Handshake: bis er erledigt ist, steht die Firmware
+	 * vor ihrer Hauptschleife und bedient keinen HDMI-Befehl.
+	 */
+	notify_result = startup_handshake();
+	if (notify_result == 0)
+		pr_info("ARISC-Startup-Notify quittiert: %s\n", notify_version);
+	else
+		pr_info("ARISC-Startup-Notify %s (%d)\n",
+			notify_result == -ETIMEDOUT ? "nicht gesehen" : "fehlerhaft",
+			notify_result);
+
+	dbg_dir = debugfs_create_dir("arisc-hdmi", NULL);
+	if (IS_ERR(dbg_dir)) {
+		iounmap(sram);
+		iounmap(msgbox_rx);
+		iounmap(msgbox);
+		return PTR_ERR(dbg_dir);
+	}
+	debugfs_create_file("hotplug", 0600, dbg_dir, NULL, &hotplug_fops);
+	debugfs_create_file("hpd_delay", 0600, dbg_dir, NULL, &hpd_delay_fops);
+	debugfs_create_file("status", 0400, dbg_dir, NULL, &status_fops);
+	debugfs_create_file("probe", 0400, dbg_dir, NULL, &probe_fops);
+	debugfs_create_file("unstick", 0600, dbg_dir, NULL, &unstick_fops);
+
+	/* Beim Laden nur lesen -- die Lebensprüfung hätte einen Seiteneffekt */
+	pr_info("geladen: rpm_zustand=%u hpd_zaehler=%u/%u/%u fifo_stat port0=%u port3=%u\n",
+		readl(sram_addr(RPM_STATE)), hpd_counter_read(0),
+		hpd_counter_read(1), hpd_counter_read(2),
+		readl(msgbox + U1_FIFO_STAT(PORT_HDMI)),
+		readl(msgbox + U1_FIFO_STAT(PORT_STANDBY)));
+	return 0;
+}
+
+static void __exit arisc_hdmi_exit(void)
+{
+	debugfs_remove_recursive(dbg_dir);
+	iounmap(sram);
+	iounmap(msgbox_rx);
+	iounmap(msgbox);
+}
+
+module_init(arisc_hdmi_init);
+module_exit(arisc_hdmi_exit);
+
+MODULE_DESCRIPTION("HY310: HDMI-Hotplug ueber die ARISC des Allwinner H713 (debugfs)");
+MODULE_AUTHOR("HY310 Mainline Port");
+MODULE_LICENSE("GPL");
