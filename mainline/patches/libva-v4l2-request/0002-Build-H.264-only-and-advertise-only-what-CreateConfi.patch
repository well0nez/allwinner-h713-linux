 include/hevc-ctrls.h | 185 -------------------------------------------
 src/config.c         |  27 +++----
 src/context.c        |   1 -
 src/meson.build      |   6 +-
 src/picture.c        |  26 ------
 5 files changed, 11 insertions(+), 234 deletions(-)
 delete mode 100644 include/hevc-ctrls.h

