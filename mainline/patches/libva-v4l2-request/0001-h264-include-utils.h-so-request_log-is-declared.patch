From f56c3ef2dc782db3e637f41c9226e824a9c00565 Mon Sep 17 00:00:00 2001
From: Christopher Stenger <chris.h.stenger@gmail.com>
Date: Sun, 16 Aug 2026 17:03:06 -0700
Subject: [PATCH 1/3] h264: include utils.h so request_log is declared

h264.c calls request_log() in its slice-parameter path but never includes
the header that declares it, so the file does not compile against a
compiler that treats implicit declarations as an error -- which is every
compiler from GCC 14 on. PR #38 was developed against an older default.

One line, and it is the only thing standing between this branch and a
working H.264 build.
---
 src/h264.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/h264.c b/src/h264.c
index f3f08b0..2330367 100644
--- a/src/h264.c
+++ b/src/h264.c
@@ -36,6 +36,7 @@
 
 #include "request.h"
 #include "surface.h"
+#include "utils.h"
 #include "v4l2.h"
 
 enum h264_slice_type {
-- 
2.55.0

