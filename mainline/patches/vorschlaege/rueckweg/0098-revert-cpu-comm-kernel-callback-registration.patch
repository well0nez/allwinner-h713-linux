+}
 EXPORT_SYMBOL_GPL(cpu_comm_register_callback);
 
-int cpu_comm_unregister_callback(const char *base_name, cpu_comm_cb_t fn)
+int cpu_comm_unregister_callback(u32 comp_id, cpu_comm_cb_t fn)
 {
