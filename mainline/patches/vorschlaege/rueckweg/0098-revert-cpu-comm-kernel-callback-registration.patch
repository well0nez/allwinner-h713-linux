-	 */
-	if (cpu_comm_full_name(full, sizeof(full), base_name,
-			       CPU_COMM_CPU_ARM) < 0)
-		return -EINVAL;
-
-	comp_id = cpu_comm_name2id(base_name, CPU_COMM_CPU_ARM);
-	if (!comp_id)
+	if (!comp_id || !fn)
 		return -EINVAL;
 
 	mutex_lock(&cpu_comm_kcb_mutex);
@@ -416,50 +193,39 @@
 			break;
 		}
 	}
-	if (!slot) {
-		ret = -ENOSPC;
-		goto out;
-	}
-
-	/*
-	 * Routine first: if the co-processor cannot be told about the
-	 * name, a handler for it would be a handler that can never run,
-	 * and the caller is better off seeing the error.
-	 */
-	ret = cpu_comm_install_routine(comp_id, base_name);
-	if (ret)
+	if (!slot)
 		goto out;
 
 	slot->comp_id = comp_id;
 	slot->ctx = ctx;
 	slot->hits = 0;
-	strscpy(slot->name, base_name, sizeof(slot->name));
+	if (name)
+		strscpy(slot->name, name, sizeof(slot->name));
