+		slot->name[0] = '\0';
 	/* fn last: delivery treats it as the slot's valid marker. */
 	slot->fn = fn;
 	atomic_inc(&cpu_comm_kcb_count);
 	ret = 0;
 
-	pr_info("cpu_comm: kernel handler registered for comp=0x%08x %s\n",
-		comp_id, base_name);
+	pr_info("cpu_comm: kernel handler registered for comp=0x%08x%s%s\n",
+		comp_id, name ? " " : "", name ? name : "");
 out:
 	mutex_unlock(&cpu_comm_kcb_mutex);
 	return ret;
 }
+
+int cpu_comm_register_callback(u32 comp_id, cpu_comm_cb_t fn, void *ctx)
+{
