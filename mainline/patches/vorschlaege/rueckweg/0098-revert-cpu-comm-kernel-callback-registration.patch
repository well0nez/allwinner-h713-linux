 #include <linux/crc32.h>
 #include <linux/debugfs.h>
 #include <linux/io.h>
 #include <linux/kernel.h>
 #include <linux/mutex.h>
 #include <linux/slab.h>
-#include <linux/stddef.h>
 #include <linux/string.h>
 #include <linux/uaccess.h>
 
@@ -68,35 +49,17 @@
  * kernel's crc32_le() computes. The string it hashes is the full routine
  * name including the "_<cpu>_<pid>" suffix; every stock routine uses pid 0.
  */
-/*
- * Spell out the name that is hashed and that goes into the routine
- * descriptor: "<base>_<cpu>_<pid>", pid 0 for every stock routine.
- *
- * Return: the length written, or -EINVAL if it does not fit @out_len.
- */
-static int cpu_comm_full_name(char *out, size_t out_len, const char *base_name,
-			      unsigned int target_cpu)
+u32 cpu_comm_name2id(const char *base_name, unsigned int target_cpu)
 {
+	char name[CPU_COMM_NAME_MAX + 8];
 	int len;
 
 	if (!base_name || !*base_name)
-		return -EINVAL;
+		return 0;
 
-	len = snprintf(out, out_len, "%s_%1x_%3.3x",
+	len = snprintf(name, sizeof(name), "%s_%1x_%3.3x",
 		       base_name, target_cpu & 0xf, 0);
-	if (len <= 0 || len >= (int)out_len)
-		return -EINVAL;
-
-	return len;
-}
-
-u32 cpu_comm_name2id(const char *base_name, unsigned int target_cpu)
-{
-	char name[CPU_COMM_NAME_MAX + 8];
-	int len;
-
-	len = cpu_comm_full_name(name, sizeof(name), base_name, target_cpu);
-	if (len < 0)
+	if (len <= 0 || len >= (int)sizeof(name))
 		return 0;
 
 	return crc32_le(CPU_COMM_NAME2ID_SEED, name, len);
@@ -172,170 +135,6 @@
 }
 EXPORT_SYMBOL_GPL(cpu_comm_call);
 
-/* ── Incoming calls: the routine table ──────────────────────── */
-
-/*
- * The 96-byte routine descriptor, exactly as IOCTL_INSTALL_RT takes it
- * from userspace and as AddInRoutine() copies it into the table in shared
- * memory. The field names are the vendor's (cpucomm.h); the layout is
- * pinned by what the rest of this driver reads back out of it:
- * FindRoutineEx() copies +0, +2, +4, +8, +12..75 and +80, and
- * SendComm2CPUEx() puts the +4 word into every outgoing call at +0x10.
- */
-struct cpu_comm_routine_desc {
-	u16	channel;	/* +0x00 low nibble is the channel key */
-	u16	target_cpu;	/* +0x02 CPU that implements the routine */
-	u32	owner;		/* +0x04 owner tag, echoed into every call */
-	u32	comp_id;	/* +0x08 hash of the full routine name */
-	char	name[64];	/* +0x0c */
-	u8	reserved[16];	/* +0x4c */
-	s32	next_index;	/* +0x5c hash-chain link */
-};
-static_assert(sizeof(struct cpu_comm_routine_desc) == 96,
-	      "routine descriptor must match a shared-table entry");
-
-/*
- * What goes into the owner field, and why it is zero.
- *
- * Userspace writes its pid there. cpu_comm_release() then hands the
- * closing task's pid to RemovePidRoutines(), which drops every entry
- * carrying it, so the kernel's entries must be tagged with something no
- * task can ever be: pid 0 belongs to the idle task, which never opens a
- * file, so no close() can take these entries away.
- *
- * The tag comes back in every incoming call at +0x10, where
- * Comm_Add2NewCallFifo() turns it into the channel key
- * CPU_COMM_CPU_MIPS | owner << 4 -- one key for every kernel callback,
- * registered once. That is the second reason for zero and the reason a
- * value above PID_MAX_LIMIT does not work: the same function then checks
- * the channel's own fields against the call entry, and the first of the
- * three reads the key's upper 16 bits (Comm_AddNewChannel() stores the
- * whole key in one word, so channel + 2 is key >> 16) against the call
- * entry's channel field. That only holds while the key stays below
- * 0x10000, which for a pid-derived key means a pid below 4096 -- an
- * accident the character-device path lives on. Zero makes it exact
- * rather than lucky: key 1, upper half 0, and 1 is a key no
- * IOCTL_INSTALL_RT can produce (theirs is 1 | pid << 4, never below 17).
- */
-#define CPU_COMM_KERNEL_OWNER	0u
-#define CPU_COMM_KERNEL_CHANNEL	(CPU_COMM_CPU_MIPS | (CPU_COMM_KERNEL_OWNER << 4))
-
-/* The channel pool, spelled the way the ioctl path spells it. */
-#define cpu_comm_channel_pool()	((u8 *)pcpu_comm_dev + 0x30)
-
-/*
- * @base_name may be NULL when the descriptor is only used as a key, as it
- * is for RemoveRoutine(). When it is given, the name field gets the same
- * *full* name that was hashed, suffix included, because that is what
- * IOCTL_INSTALL_RT puts there and the descriptor is read by the other
- * processor.
- */
-static int cpu_comm_fill_desc(struct cpu_comm_routine_desc *desc, u32 comp_id,
-			      const char *base_name)
-{
-	memset(desc, 0, sizeof(*desc));
-	desc->channel = 0;
-	desc->target_cpu = CPU_COMM_CPU_ARM;
-	desc->owner = CPU_COMM_KERNEL_OWNER;
-	desc->comp_id = comp_id;
-	desc->next_index = -1;
-
-	if (base_name && cpu_comm_full_name(desc->name, sizeof(desc->name),
-					    base_name, CPU_COMM_CPU_ARM) < 0)
-		return -EINVAL;
-
-	return 0;
-}
-
-/*
- * cpu_comm_routine_owner -- what the shared table says about @comp_id.
- *
- * Return: 0 and fill @owner/@target_cpu if there is an entry, -ENOENT if
- * there is none, -ENODEV if the shared region is not mapped yet.
- */
-static int cpu_comm_routine_owner(u32 comp_id, u32 *owner, u16 *target_cpu)
-{
-	u8 buf[96] __aligned(8);
-
-	if (!ShMemAddrBase)
-		return -ENODEV;
-
-	if (FindRoutineEx(comp_id, buf, NULL))
-		return -ENOENT;
-
-	*owner = *(u32 *)(buf + 4);
-	*target_cpu = *(u16 *)(buf + 2);
-	return 0;
-}
-
-/*
- * cpu_comm_install_routine -- put @name where the co-processor looks.
- *
- * Without this the firmware's SendComm2CPUEx() fails the FindRoutine()
- * lookup for @comp_id and returns -3 before it touches the message FIFO:
- * the callback is never sent, and no amount of handler registration on
- * this side changes that. Same two steps as IOCTL_INSTALL_RT, for the
- * same reason.
- */
-static int cpu_comm_install_routine(u32 comp_id, const char *name)
-{
-	struct cpu_comm_routine_desc desc;
-	unsigned long existing = 0;
-	int ret;
-
-	if (!ShMemAddrBase || !pcpu_comm_dev)
-		return -ENODEV;
-
-	ret = cpu_comm_fill_desc(&desc, comp_id, name);
-	if (ret)
-		return ret;
-
-	ret = AddInRoutine(&desc);
-	if (ret)
-		return ret == -2 ? -ENOSPC : ret;
-
-	/*
-	 * AddInRoutine() treats an id that is already in the table as
-	 * success and leaves that entry alone -- one a userspace daemon
-	 * installed, or one it left behind. Either is fine here: what
-	 * matters is that the co-processor can resolve the name, and
-	 * delivery below does not care whose owner tag the entry carries.
-	 * The debugfs listing prints the owner that is really in the table
-	 * so the difference stays visible.
-	 */
-
-	if (Comm_QueryChannel(cpu_comm_channel_pool(), CPU_COMM_KERNEL_CHANNEL,
-			      &existing) == 0 && !existing)
-		Comm_AddNewChannel(cpu_comm_channel_pool(), CPU_COMM_CPU_MIPS,
-				   CPU_COMM_KERNEL_OWNER);
-
-	return 0;
-}
-
-/*
- * The reverse. Only an entry this API installed is removed: a daemon that
- * registered the same routine keeps its own, and a stale entry left by a
- * dead process is not ours to clean up here.
- *
- * The channel stays registered. It is shared by every kernel callback,
- * costs one of 32 pool slots, and the character-device path does not
- * remove its channels on close either.
- */
-static void cpu_comm_remove_routine(u32 comp_id)
-{
-	struct cpu_comm_routine_desc desc;
-	u16 target_cpu = 0;
-	u32 owner = 0;
-
-	if (cpu_comm_routine_owner(comp_id, &owner, &target_cpu) ||
-	    owner != CPU_COMM_KERNEL_OWNER)
-		return;
-
-	if (cpu_comm_fill_desc(&desc, comp_id, NULL))
-		return;
-	RemoveRoutine(&desc);
-}
-
 /* ── Incoming calls: kernel handlers ────────────────────────── */
 
 #define CPU_COMM_MAX_KERNEL_CB	16
@@ -345,6 +144,8 @@
 	cpu_comm_cb_t	fn;
 	void		*ctx;
 	unsigned long	hits;
+	/* Only filled by the debugfs consumer below; a driver that
+	 * registers a handler of its own leaves it empty. */
 	char		name[CPU_COMM_NAME_MAX];
 };
 
@@ -352,18 +153,10 @@
 static DEFINE_MUTEX(cpu_comm_kcb_mutex);
 
 /*
- * Instrumentation. @cpu_comm_rx_calls counts every incoming call that
- * reached this file, whether or not anything was registered for it, and
- * @cpu_comm_rx_unmatched counts the ones no handler claimed. The pair is
- * what tells "the co-processor sends nothing" (rx stays 0) apart from
- * "it sends and we drop it" (rx rises, unmatched rises with it) -- the
- * two failure modes that look identical in a per-driver event counter.
+ * Delivery reads this without the mutex to stay off the receive path when
+ * nothing is registered, which is the normal case. It only ever gates a
+ * second, locked look at the table.
  */
-static atomic_t cpu_comm_rx_calls = ATOMIC_INIT(0);
-static atomic_t cpu_comm_rx_unmatched = ATOMIC_INIT(0);
-static u32 cpu_comm_rx_last_unmatched;	/* under cpu_comm_kcb_mutex */
-
-/* How many slots are in use; only read for the debugfs listing. */
 static atomic_t cpu_comm_kcb_count = ATOMIC_INIT(0);
 
 static struct cpu_comm_kcb *cpu_comm_kcb_find(u32 comp_id)
@@ -378,29 +171,13 @@
 	return NULL;
 }
 
-int cpu_comm_register_callback(const char *base_name, cpu_comm_cb_t fn,
-			       void *ctx)
+static int cpu_comm_register_named(u32 comp_id, cpu_comm_cb_t fn, void *ctx,
+				   const char *name)
 {
-	char full[sizeof_field(struct cpu_comm_routine_desc, name)];
 	struct cpu_comm_kcb *slot = NULL;
-	u32 comp_id;
-	int i, ret;
+	int i, ret = -ENOSPC;
 
-	if (!base_name || !fn)
-		return -EINVAL;
-
-	/*
-	 * The full name goes into the descriptor's 64-byte name field, so
-	 * the base name has to leave room for the "_<cpu>_<pid>" suffix
