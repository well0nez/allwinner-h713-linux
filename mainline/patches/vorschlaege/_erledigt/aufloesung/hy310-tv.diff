+/*
+ * The geometry the framebuffer has to have. Asked for separately from the
+ * timings because the two answer different questions: QUERY_DV_TIMINGS says
+ * what the source sends, G_FMT says how the capture lays it out in the ring --
+ * and the ring is what the plane reads. Today the two agree by construction
+ * (0094 derives the format from the timings); the framebuffer still follows
+ * the format, because that is the statement about the ring.
+ *
+ * bytesperline has to equal the width: the plane programs the ring stride
+ * from the framebuffer pitch, and a dumb buffer is exactly as wide as its
+ * pitch. A padded format would need a padded buffer, which CREATE_DUMB does
+ * not promise -- so it is refused rather than approximated.
+ */
+static bool capture_format(struct capture *cap, unsigned int *w,
+			   unsigned int *h)
+{
+	struct v4l2_format f;
+	const struct v4l2_pix_format_mplane *pix = &f.fmt.pix_mp;
+
+	memset(&f, 0, sizeof(f));
+	f.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+	if (ioctl(cap->fd, VIDIOC_G_FMT, &f)) {
+		warn("G_FMT: %s", strerror(errno));
+		return false;
+	}
+	if (pix->pixelformat != V4L2_PIX_FMT_NV16M || pix->num_planes != 2) {
+		warn("das Aufnahmegeraet liefert nicht NV16M in zwei Ebenen (%.4s, %u Ebenen)",
+		     (const char *)&pix->pixelformat, pix->num_planes);
+		return false;
+	}
+	if (pix->plane_fmt[0].bytesperline != pix->width ||
+	    pix->plane_fmt[1].bytesperline != pix->width) {
+		warn("Zeilenabstand %u/%u passt nicht zur Breite %u -- die Plane kann nur einen Ring lesen, dessen Zeilen genau eine Breite auseinanderliegen",
+		     pix->plane_fmt[0].bytesperline, pix->plane_fmt[1].bytesperline,
+		     pix->width);
+		return false;
+	}
+	*w = pix->width;
+	*h = pix->height;
+
+	return true;
+}
