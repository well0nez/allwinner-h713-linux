-/dts-v1/;
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+/*
+ * HY200 QZ713DF A1: sold as the HY300 Pro with the box label HY300PRO-G-EU
+ * (stock Android 11 of 2025-05-06, the maintainer's own) and as the "HY300
+ * Pro+" of 2025 (stock of 2025-09-22); cstenger's bench board carries the same
+ * silkscreen. Not the HY300 Pro of issue #1 (sun50i-h713-hy300-pro.dts).
+ *
+ * The tree measured on the HY300PRO-G-EU (0167, until 0181 named after its
+ * box label). Both firmwares' stock trees are identical but for motor_ctr, and
+ * both panel_config.ini declare the same [PWMSetting]; the DRAM clock, which
+ * differs, is U-Boot's. The HY310's tree, plus:
+ *
+ *  - the lamp's PWM words: hardware channel 5, polarity 1 (low active),
+ *    40 kHz, vsync lock 1, duty 1..100 (the HY310: channel 2, 25 kHz). The
+ *    display firmware owns that PWM; hdmirx sends the words (0166, 0168). No
+ *    pin group (0166a);
+ *  - no pwm-backlight: the dtsi's PWM2 on PB4 is the HY310's dimmer, and
+ *    nothing of this board says what PB4 is. The fan_power_hog on PB5 stays;
+ *  - fan tacho PH13 (stock fan0 fg-gpio of both firmwares, 5520-5610 rpm on
+ *    the HY300PRO-G-EU; the HY310: PH17). The board manager powers off when
+ *    it counts too little, so the input has to be the right one;
+ *  - no focus motor: the HY300PRO-G-EU has none and its firmware disables
+ *    motor_ctr; the 2025-09 firmware enables it with the HY310's step tables.
+ *    The driver homes at probe on PH4..PH7, so it stays off until a 2025-09
+ *    unit shows a motor.
+ *
+ * The SC7A20 node at 0x18 stays; the HY300PRO-G-EU answers there. Not here:
+ * the elog addresses (cpu_comm's are the HY310's, right for the 2025-05
+ * display.bin, unknown for the 2025-09 one) and the panel (project id 0x34,
+ * driven by the display coprocessor, selected by h713_project).
+ */
 
-#include "sun50i-h713.dtsi"
+#include "sun50i-h713-hy310.dts"
 
 / {
 	model = "HY200 QZ713DF_A1 (Allwinner H713)";
-	compatible = "cstenger,hy200-qz713df-a1", "allwinner,sun50i-h713";
+	compatible = "magcubic,hy200-qz713df-a1", "allwinner,sun50i-h713";
+};
+
+&backlight {
+	status = "disabled";
+};
 
-	chosen {
-		bootargs = "console=ttyS0,115200 console=tty0 loglevel=4 root=/dev/mmcblk0p26 rootwait rootfstype=ext4 rw net.ifnames=0 panic=5 clk_ignore_unused pd_ignore_unused cma=128M";
+&hdmirx {
+	allwinner,backlight-pwm-info = <5 1 40000 1 1 100>;
+};
+
+&board_mgr {
+	fan0 {
+		fg-gpio = <&pio 7 13 GPIO_ACTIVE_HIGH>;	/* PH13, stock fan0 fg-gpio */
 	};
 };
 
-&mips_reserved { status = "okay"; };
-&cpu_comm_reserved { status = "okay"; };
-&mips_framebuf { status = "okay"; };
-&framebuf_reserved { status = "okay"; };
-/* twi1 carries the accelerometer of the auto keystone (plan/keystone S8) and the
- * DLPC3435 node nothing binds to; it was disabled while nothing needed it. */
-&twi1 { status = "okay"; };
-&codec { status = "okay"; };
-&dummy_cpudai { status = "disabled"; };
-&codec_machine { status = "disabled"; };
-&i2s0 { status = "disabled"; };
-&i2s1 { status = "disabled"; };
-&i2s2 { status = "disabled"; };
-&spdif { status = "disabled"; };
-&spdif1 { status = "disabled"; };
-&audio_bridge { status = "disabled"; };
-&ge2d { status = "disabled"; };
-&tvtop { status = "disabled"; };
-/*
- * DECD enabled 2026-08-12 for zero-copy video: it is the only way to
- * hand the display a decoder buffer, since userspace can neither resolve
- * a V4L2 buffer to a physical address nor program display registers.
- * Built as a module so it is loaded deliberately, after U-Boot has set
- * up the panel. TVTOP stays disabled -- see patch 0033.
- */
-&cpu_comm { status = "okay"; };	/* Treiber wird seit 01.09. gebaut */
-&motor_ctr { status = "okay"; };	/* Bereichswaechter PH14 vermessen 12.09., siehe doku/94 */
-&adc_keys { status = "disabled"; };
-&board_mgr { status = "okay"; };	/* Temperatur + Luefterdrehzahl, siehe doku/60 */
+&motor_ctr {
+	status = "disabled";
+};
