media: sunxi-cir: h713 - re-apply PL9 after the ARISC firmware has started

Its main 0xc570 -> 0x10e4c -> 0x11e88 stores 0x222222ff to PL_CFG1 unread (0x11ec4), PL9 -> 0xf.
---
--- a/drivers/media/rc/sunxi-cir.c
+++ b/drivers/media/rc/sunxi-cir.c
@@ -15,6 +15,7 @@
 #include <linux/io.h>
 #include <linux/module.h>
 #include <linux/of.h>
+#include <linux/pinctrl/consumer.h>
 #include <linux/platform_device.h>
 #include <linux/reset.h>
 #include <media/rc-core.h>
@@ -97,6 +98,8 @@
 	struct reset_control *rst;
 	const char      *map_name;
 	bool		is_h713_vendor_init;
+	struct notifier_block arisc_nb;
+	struct delayed_work repin_work;
 };
 
 static irqreturn_t sunxi_ir_irq(int irqno, void *dev_id)
@@ -261,6 +264,31 @@
 
 static SIMPLE_DEV_PM_OPS(sunxi_ir_pm_ops, sunxi_ir_suspend, sunxi_ir_resume);
 
+/* H713: the ARISC firmware's start stores 0x222222ff to PL_CFG1 (0x11ec4),
+ * PL9 becomes function 0xf. Re-apply PL9 a second after its probe ended. */
+static void sunxi_ir_repin(struct work_struct *work)
+{
+	struct sunxi_ir *ir = container_of(to_delayed_work(work),
+					   struct sunxi_ir, repin_work);
+	struct device *dev = ir->rc->dev.parent;
+	int ret = pinctrl_pm_select_sleep_state(dev) ?:
+		  pinctrl_pm_select_default_state(dev);
+
+	dev_info(dev, "PL9 re-applied after the ARISC start: %d\n", ret);
+}
+
+static int sunxi_ir_arisc_event(struct notifier_block *nb, unsigned long act,
+				void *data)
+{
+	struct sunxi_ir *ir = container_of(nb, struct sunxi_ir, arisc_nb);
+	struct device_node *np = ((struct device *)data)->of_node;
+
+	if ((act == BUS_NOTIFY_BOUND_DRIVER || act == BUS_NOTIFY_DRIVER_NOT_BOUND) &&
+	    of_device_is_compatible(np, "allwinner,sun50i-h713-arisc"))
+		mod_delayed_work(system_wq, &ir->repin_work, HZ);
+	return NOTIFY_DONE;
+}
+
 
 static int sunxi_ir_probe(struct platform_device *pdev)
 {
@@ -372,6 +400,12 @@
 
 	dev_info(dev, "initialized sunXi IR driver\n");
 
+	if (ir->is_h713_vendor_init) {
+		INIT_DELAYED_WORK(&ir->repin_work, sunxi_ir_repin);
+		ir->arisc_nb.notifier_call = sunxi_ir_arisc_event;
+		bus_register_notifier(&platform_bus_type, &ir->arisc_nb);
+	}
+
 	return 0;
 
 exit_free_dev:
@@ -384,6 +418,10 @@
 {
 	struct sunxi_ir *ir = platform_get_drvdata(pdev);
 
+	if (ir->is_h713_vendor_init) {
+		bus_unregister_notifier(&platform_bus_type, &ir->arisc_nb);
+		cancel_delayed_work_sync(&ir->repin_work);
+	}
 	rc_unregister_device(ir->rc);
 	rc_free_device(ir->rc);
 	sunxi_ir_hw_exit(&pdev->dev);
