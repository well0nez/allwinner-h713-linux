 }
 
+/*
+ * The SoC watchdog stops in its suspend_noirq and starts again in its
+ * resume_noirq; crust's sleep net is armed in ours. A device link puts ours
+ * first on the way down and theirs first on the way up, so there is no
+ * window without a watchdog that depends on the order of the dpm list. A
+ * missing "allwinner,watchdog" is no error, but then a crust built with the
+ * net gets no standby.
+ */
+static void h713_arisc_unlink(void *link)
+{
+	device_link_del(link);
+}
+
+static void h713_arisc_link_watchdog(struct h713_arisc *a)
+{
+	struct device_node *np;
+	struct platform_device *wdt;
+	struct device_link *link;
+
+	np = of_parse_phandle(a->dev->of_node, "allwinner,watchdog", 0);
+	if (!np)
+		return;
+	wdt = of_find_device_by_node(np);
+	of_node_put(np);
+	if (!wdt) {
+		dev_warn(a->dev, "\"allwinner,watchdog\" names no device -- no link\n");
+		return;
+	}
+	link = device_link_add(a->dev, &wdt->dev, DL_FLAG_STATELESS);
+	if (!link)
+		dev_warn(a->dev, "no device link to %s\n", dev_name(&wdt->dev));
+	else
+		a->wdt_link = !devm_add_action_or_reset(a->dev, h713_arisc_unlink,
+							 link);
+	put_device(&wdt->dev);
+}
+
 static int h713_arisc_probe(struct platform_device *pdev)
 {
 	struct h713_arisc *a;
 	struct resource *res;
+	struct clk *clk;
 	u32 mask = 0;
 	int ret;
 
@@ -3072,7 +3124,6 @@ static int h713_arisc_probe(struct platform_device *pdev)
 	if (ret)
 		return ret;
 	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "sram");
-	a->sram_phys = res->start;
 	a->sram_size = resource_size(res);
 	ret = h713_arisc_map(pdev, "msgbox-rx", &a->rx);
 	if (ret)
@@ -3087,6 +3138,17 @@ static int h713_arisc_probe(struct platform_device *pdev)
 	if (ret)
 		return ret;
 
+	/*
+	 * The message box's bus clock, so it does not hang on cpu_comm or
+	 * clk_ignore_unused. Not its reset: cpu_comm holds that one exclusive
+	 * and only ever releases it, and nothing in Linux asserts it.
+	 */
+	clk = devm_clk_get_optional_enabled(&pdev->dev, NULL);
+	if (IS_ERR(clk))
+		return dev_err_probe(&pdev->dev, PTR_ERR(clk),
+				     "msgbox clock\n");
+	h713_arisc_link_watchdog(a);
+
 	/*
 	 * Board policy, not a debugging knob: one byte covers all three ports.
 	 * Absent is 0 -- every port on block 0, as since the first sequence.
