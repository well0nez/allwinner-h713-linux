+++ b/drivers/staging/media/sunxi/cedrus/cedrus_video.c
@@ -284,6 +284,7 @@
 static int cedrus_try_fmt_vid_cap_p(struct cedrus_ctx *ctx,
 				    struct v4l2_pix_format *pix_fmt)
 {
+	unsigned int output_width, output_height;
 	struct cedrus_format *fmt =
 		cedrus_find_format(ctx, pix_fmt->pixelformat,
 				   CEDRUS_DECODE_DST);
@@ -291,7 +292,7 @@
 	if (!fmt)
 		return -EINVAL;
 
-	pix_fmt->pixelformat = cedrus_scaling(ctx) ? V4L2_PIX_FMT_NV12 :
+	pix_fmt->pixelformat = cedrus_transforming(ctx) ? V4L2_PIX_FMT_NV12 :
 						 fmt->pixelformat;
 	/*
 	 * COMPOSE is a window inside the capture allocation.  Keep userspace's
@@ -300,13 +301,17 @@
 	 * immediately after the 544 visible rows and forced the display fetcher to
 	 * use a small raster, which this H713 hardware wraps and shears.
 	 */
-	if (cedrus_scaling(ctx)) {
-		pix_fmt->width = max(pix_fmt->width,
-				     ALIGN(ctx->src_fmt.width, 16) >>
-				     ctx->sd_h_shift);
-		pix_fmt->height = max(pix_fmt->height,
-				      ALIGN(ctx->src_fmt.height, 16) >>
-				      ctx->sd_v_shift);
+	if (cedrus_transforming(ctx)) {
+		output_width = ctx->sd_h_shift ?
+			ALIGN(ctx->src_fmt.width, 16) >> ctx->sd_h_shift :
+			ctx->src_fmt.width;
+		output_height = ctx->sd_v_shift ?
+			ALIGN(ctx->src_fmt.height, 16) >> ctx->sd_v_shift :
+			ctx->src_fmt.height;
+		if (cedrus_rotation_swaps_axes(ctx))
+			swap(output_width, output_height);
+		pix_fmt->width = max(pix_fmt->width, output_width);
+		pix_fmt->height = max(pix_fmt->height, output_height);
 	} else {
 		pix_fmt->width = ctx->src_fmt.width;
 		pix_fmt->height = ctx->src_fmt.height;
@@ -425,6 +430,8 @@
 		sel->r.height = ctx->sd_v_shift ?
 			ALIGN(ctx->src_fmt.height, 16) >> ctx->sd_v_shift :
 			ctx->src_fmt.height;
+		if (cedrus_rotation_swaps_axes(ctx))
+			swap(sel->r.width, sel->r.height);
 		return 0;
 	case V4L2_SEL_TGT_COMPOSE_DEFAULT:
 	case V4L2_SEL_TGT_COMPOSE_BOUNDS:
@@ -462,6 +469,9 @@
 	if (sel->r.left || sel->r.top || !sel->r.width || !sel->r.height)
 		return -EINVAL;
 
+	if (cedrus_rotation_swaps_axes(ctx))
+		swap(sel->r.width, sel->r.height);
+
 	h_shift = cedrus_compose_shift(ctx->src_fmt.width, sel->r.width,
 				       false, sel->flags);
 	v_shift = cedrus_compose_shift(ctx->src_fmt.height, sel->r.height,
@@ -480,6 +490,8 @@
 	sel->r.height = ctx->sd_v_shift ?
 		ALIGN(ctx->src_fmt.height, 16) >> ctx->sd_v_shift :
 		ctx->src_fmt.height;
+	if (cedrus_rotation_swaps_axes(ctx))
+		swap(sel->r.width, sel->r.height);
 
 	return 0;
 }
@@ -522,6 +534,13 @@
 	if (ret)
 		return ret;
 
+	/*
+	 * Selecting a codec without a rotator is not an error even with a
+	 * rotation still set: cedrus_rotation() reports zero for it, the
+	 * capture format is re-derived below, and the request comes back into
+	 * effect if H.264 is selected again. Refusing here made the output
+	 * format depend on control state in a way userspace cannot discover.
+	 */
 	ctx->src_fmt = *pix_fmt;
 
 	vq = v4l2_m2m_get_vq(ctx->fh.m2m_ctx, V4L2_BUF_TYPE_VIDEO_OUTPUT);
@@ -769,7 +788,7 @@
 	struct cedrus_buffer *cbuf = vb2_to_cedrus_buffer(vb);
 	struct cedrus_dev *dev = ctx->dev;
 
-	if (V4L2_TYPE_IS_OUTPUT(vq->type) || !cedrus_scaling(ctx))
+	if (V4L2_TYPE_IS_OUTPUT(vq->type) || !cedrus_transforming(ctx))
 		return 0;
 
 	cbuf->recon_size = ctx->recon_fmt.sizeimage;
