+/*
+ * The repeat of a failed first switch. Runs H713_RETRY_SETTLE_MS after the
+ * firmware reported the HDMI source again (h713_hdmirx_signal_cb), or
+ * H713_RETRY_AGAIN_MS after a repeat that did not bring the capture back.
+ *
+ * Slowly, on purpose. The first version of this repeat switched the moment the
+ * callback arrived, with SetSource 1 and 3 back to back as the ordinary switch
+ * does; measured 08.09.2026 that hit a port that had locked 50 ms earlier,
+ * the port fell to state 3 and never came back -- no relock, no callback --
+ * until a switch by hand with a second between the two calls. The ordinary
+ * switch of a first publication meets a port that has been locked for a
+ * while and is left as it is.
+ */
+static void h713_hdmirx_rearm_retry_work(struct work_struct *work)
+{
+	struct h713_hdmirx *rx = container_of(to_delayed_work(work),
+					      struct h713_hdmirx,
+					      rearm_retry_work);
+	struct h713_hdmirx_signal_info sig;
+	u32 arg = H713_SOURCE_VIDEODEC;
+	ktime_t start;
+	unsigned int val;
+	int ret;
+
+	if (!rx->rearm_pending)
+		return;
+
+	/* did the firmware bring the capture back by itself meanwhile? */
+	if (!regmap_read(rx->incap, H713_INCAP_ENABLE_Y, &val) &&
+	    (val & H713_INCAP_ENABLE_BIT)) {
+		dev_info(rx->dev, "Freigabe: Capture laeuft inzwischen von selbst\n");
+		rx->rearm_pending = false;
+		h713_hdmirx_restore_icsc(rx, "nach der Wiederholung");
+		return;
+	}
+
+	if (h713_hdmirx_read_signal_info(rx, &sig) ||
+	    sig.signal_id == H713_SIGNAL_ID_NONE ||
+	    sig.signal_id == H713_SIGNAL_ID_UNKNOWN ||
+	    !sig.h_size || !sig.v_size) {
+		dev_dbg(rx->dev, "Freigabe: Wiederholung wartet auf ein Signal\n");
+		return;
+	}
+
+	rx->rearm_retries++;
+	dev_info(rx->dev,
+		 "Freigabe: Signal da (%ux%u), Quellenwechsel wird wiederholt (%u. Mal, mit %u ms Pause)\n",
+		 sig.h_size, sig.v_size, rx->rearm_retries, H713_RETRY_GAP_MS);
+
+	ret = cpu_comm_call(rx->id_setsource, &arg, 1, NULL, 0, 0);
+	if (ret)
+		dev_warn(rx->dev, "Freigabe: SetSource(VideoDec) fehlgeschlagen: %d\n", ret);
+	msleep(H713_RETRY_GAP_MS);
+	ret = h713_hdmirx_set_source(rx);
+	if (ret)
+		dev_warn(rx->dev, "Freigabe: SetSource(HDMI-1) fehlgeschlagen: %d\n", ret);
+	h713_hdmirx_reapply_saturation(rx);
+
+	start = ktime_get();
+	do {
+		if (!regmap_read(rx->incap, H713_INCAP_ENABLE_Y, &val) &&
+		    (val & H713_INCAP_ENABLE_BIT)) {
+			dev_info(rx->dev,
+				 "Freigabe: Capture laeuft wieder, nach %lld ms (Wiederholung)\n",
+				 ktime_ms_delta(ktime_get(), start));
+			rx->rearm_pending = false;
+			h713_hdmirx_restore_icsc(rx, "nach der Wiederholung");
+			return;
+		}
+		msleep(20);
+	} while (ktime_ms_delta(ktime_get(), start) < H713_RETRY_WAIT_MS);
+
+	if (rx->rearm_retries >= H713_RETRY_MAX) {
+		dev_warn(rx->dev,
+			 "Freigabe: auch nach %u Wiederholungen keine Capture -- aufgegeben; hy310-tv ctl resync oder Kaltstart\n",
+			 rx->rearm_retries);
+		rx->rearm_pending = false;
+		return;
+	}
+	dev_info(rx->dev,
+		 "Freigabe: Wiederholung %u ohne Erfolg, naechster Versuch in %u ms\n",
+		 rx->rearm_retries, H713_RETRY_AGAIN_MS);
+	queue_delayed_work(system_wq, &rx->rearm_retry_work,
+			   msecs_to_jiffies(H713_RETRY_AGAIN_MS));
+}
+
 static void h713_hdmirx_rearm_work(struct work_struct *work)
 {
 	struct h713_hdmirx *rx = container_of(work, struct h713_hdmirx,
@@ -3071,6 +3157,7 @@
 	rx->flip_nb.notifier_call = h713_hdmirx_flip_notify;
 	rx->desc_nb.notifier_call = h713_hdmirx_desc_notify;
 	INIT_WORK(&rx->rearm_work, h713_hdmirx_rearm_work);
+	INIT_DELAYED_WORK(&rx->rearm_retry_work, h713_hdmirx_rearm_retry_work);
 	h713_hdmirx_set_timings(rx, &h713_hdmirx_timings);
 	rx->last_slot = -1;
 	mutex_init(&rx->lock);
@@ -3298,6 +3385,7 @@
 	struct h713_hdmirx *rx = platform_get_drvdata(pdev);
 
 	h713_afbd_unregister_descriptor_notifier(&rx->desc_nb);
+	cancel_delayed_work_sync(&rx->rearm_retry_work);
 	cancel_work_sync(&rx->rearm_work);
 	debugfs_remove_recursive(rx->debugfs);
 	vb2_video_unregister_device(&rx->vdev);
