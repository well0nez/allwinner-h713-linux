 #define H713_SOURCE_RETRIES	3
+
+/*
+ * The repeat of a failed first switch (h713_hdmirx_rearm_retry_work). Measured
+ * 08.09.2026: a switch sent 50 ms after the port had locked, with SetSource 1
+ * and 3 two milliseconds apart, left the firmware's HDMI port in state 3 for
+ * good -- no relock, no callback, until a switch by hand with a pause between
+ * the two calls. So the repeat waits for the firmware to settle, pauses
+ * between away and back, allows the relock more time, and tries again a few
+ * times if the capture still does not come.
+ */
+#define H713_RETRY_SETTLE_MS	2000
+#define H713_RETRY_GAP_MS	1000
+#define H713_RETRY_WAIT_MS	3000
+#define H713_RETRY_AGAIN_MS	5000
+#define H713_RETRY_MAX		5
 #define H713_HDMI_PORT		0
 
