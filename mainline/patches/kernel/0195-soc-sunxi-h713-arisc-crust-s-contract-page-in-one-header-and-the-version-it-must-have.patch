--- /dev/null
+++ b/include/linux/soc/sunxi/h713-crust-contract.h
@@ -0,0 +1,298 @@
+/* SPDX-License-Identifier: (GPL-2.0-only OR BSD-3-Clause) */
+/*
+ * The contract page between crust, the firmware of the AR100 in the
+ * Allwinner H713, and the ARM side (TF-A and sun50i-h713-arisc), version 5.
+ *
+ * One page of 1 KiB at AR100 0x23800 (ARM 0x123800, the top of SRAM A2
+ * below crust's SCPI page). Offsets here are from the page start. Every
+ * word has exactly one writer: the bus has no atomic read-modify-write
+ * between the ARM and the AR100. The classes say who writes and who clears:
+ *
+ *   R  0x000..0x1ff  crust; cleared at its every start, except 0x010..0x0ff
+ *                    across a restart Linux had acknowledged
+ *   D  0x200..0x23f  crust; cleared by a loader after its copy to P
+ *   S  0x240..0x25f  crust; cleared at its every start
+ *   K  0x260..0x2bf  crust only; cleared by crust at its first start
+ *                    (starts word 0) and by a loader after its copy to P
+ *   A  0x2c0..0x2cf  the ARM, one writer per word; crust only reads
+ *   P  0x2d0..0x38f  the ARM only: TF-A at boot, Linux before a reload
+ *   X  0x390..0x3ff  reserved, rules of K
+ *
+ * Nothing here depends on the kernel: a host test builds this header with a
+ * shim that provides u8, u16, u32 and bool.
+ */
+#ifndef __LINUX_SOC_SUNXI_H713_CRUST_CONTRACT_H
+#define __LINUX_SOC_SUNXI_H713_CRUST_CONTRACT_H
+
+#ifdef __KERNEL__
+#include <linux/types.h>
+#endif
+
+#define H713_PAGE		0x23800		/* AR100 address */
+#define H713_PAGE_SIZE		0x400
+
+/* R */
+#define H713_MAGIC		0x000
+#define H713_MAGIC_VALUE	0x33313748	/* "H713" */
+#define H713_VERSION		0x004
+#define H713_STATUS		0x008
+#define H713_ST_RUNNING		0x00000001
+#define H713_ST_HANDSHAKE	0x00000002
+#define H713_ST_HEARTBEAT	0xffff0000	/* moves once per main loop pass */
+#define H713_WAKE		0x00c		/* the last 0x11 answer */
+#define H713_GDATA		0x020
+#define H713_PUMP		0x180
+#define H713_RO_SIZE		0x1fc		/* bytes of .text and .rodata */
+
+/*
+ * D: the little-endian window crust found and closed (enable word, window 0
+ * start and end), CPUS_CLK_REG as found, the tick timer of its last main
+ * loop pass, its starts, R_INTC +0x80/+0x88 as found, the display MIPS's
+ * frames and the first bytes of the last one, ARM frames of a foreign type,
+ * then the words below.
+ */
+#define H713_DIAG		0x200
+#define H713_DIAG_WORDS		16
+#define H713_DIAG_INITS		0x214		/* crust's starts */
+#define H713_DIAG_STEP		0x22c		/* last standby step */
+#define H713_DIAG_EXCEPTION	0x230		/* number << 24 | pc */
+#define H713_DIAG_SLEPT_MS	0x234
+#define H713_DIAG_WAKE_TIMER	0x238		/* the armed wake timer, ms */
+#define H713_DIAG_BUILD		0x23c
+#define H713_BUILD_SIZE		0x000fffff	/* image bytes */
+#define H713_BUILD_SR		(1U << 24)	/* DRAM self-refresh */
+#define H713_BUILD_DEEP		(1U << 25)
+#define H713_BUILD_IR		(1U << 26)	/* IR wake codes */
+#define H713_BUILD_VDD_SYS	(1U << 27)	/* never standby: Linux restores nothing */
+#define H713_BUILD_PLL_LDO	(1U << 28)	/* not measured */
+#define H713_BUILD_SLEEP_NET	(1U << 29)	/* R_WDOG net while asleep */
+#define H713_BUILD_TEST		(1U << 30)	/* forced faults, for tests only */
+#define H713_BUILD_AVCC		(1U << 31)	/* not measured */
+
+/* K */
+#define H713_K			0x260
+#define H713_K_WORDS		24
+#define H713_COMPAT		0x260	/* 7..0 lowest reader version, 15..8 NET_REQ format */
+#define H713_COMPAT_READER(c)	((c) & 0xff)
+#define H713_COMPAT_NET_FORMAT(c) (((c) >> 8) & 0xff)
+#define H713_BUILD2		0x264
+#define H713_BUILD2_DRAM_MHZ(b)	((b) & 0xfff)		/* 0 without self-refresh */
+#define H713_BUILD2_BOARD(b)	(((b) >> 12) & 0xf)	/* 1 HY310, 2 HY300 Pro */
+#define H713_BUILD2_RWDOG(b)	(((b) >> 16) & 0xff)	/* 0: no net built */
+#define H713_SB_STATE		0x268
+#define H713_NET_ACC		0x26c	/* budgets taken: 15..0 presleep s, 31..16 resuming s */
+#define H713_NET_RB		0x270	/* R_WDOG read back when armed: 15..0 MODE, 31..16 CFG */
+#define H713_NET_MS		0x274	/* ms in a net phase (presleep..resuming), kept after */
+#define H713_NET_FOUND		0x278	/* R_WDOG at the first start: 15..0 MODE, 31..16 STA */
+#define H713_ERR		0x27c	/* sticky error bits */
+#define H713_ERR_DETAIL		0x280	/* 31..24 last bit, 23..16 sub-id, 15..0 step */
+#define H713_ERR_DATA		0x284
+#define H713_CNT0		0x288	/* byte counters, all errors */
+#define H713_CNT1		0x28c	/* 15..0 errors, 23..16 MIPS 0x17, 31..24 MIPS 0x16 */
+#define H713_CNT2		0x290	/* accepted, woken, restarts, clean resets */
+#define H713_CYCLE		0x294	/* standby attempts */
+#define H713_WAKE_MS		0x298	/* 0x22 received -> CPU0 released */
+#define H713_MIPS_PORT		0x29c	/* 7..0 port of the last display MIPS frame */
+#define H713_FAIL_PATH		0x2a0	/* 7..0 1 R_WDOG, 2 SoC watchdog; 15..8 attempt */
+#define H713_DRAM_PLL		0x2a4	/* PLL_DDR0 when a request was taken */
+#define H713_SUBSTEP		0x2a8	/* deep stage only */
+#define H713_DEEP_LOCK		0x2ac	/* deep stage only */
+
+/*
+ * A: TF-A writes its word, Linux the other three, in this order for every
+ * request: NET_CONFIRM := 0, NET_BUDGET, NET_REQ - and NET_REQ := 0 again
+ * once crust answered, whatever the answer. The first is part of the
+ * contract, not tidiness: a confirmation left from a request crust did not
+ * take names the very cycle the next request asks for, and crust would
+ * release that one as soon as it took it.
+ */
+#define H713_NET_REQ		0x2c0
+#define H713_NET_BUDGET		0x2c4
+#define H713_NET_CONFIRM	0x2c8
+#define H713_TFA_WORD		0x2cc
+
+/* P */
+#define H713_P_HDR		0x2d0
+#define H713_P_SUM		0x2d4
+#define H713_P_STATUS		0x2d8	/* first word under the sum */
+#define H713_P_WAKE		0x2dc
+#define H713_P_RWDOG		0x2e0
+#define H713_P_GP5		0x2e4
+#define H713_P_TFA_WORD		0x2e8
+#define H713_P_NET_CONFIRM	0x2ec
+#define H713_P_DIAG		0x2f0
+#define H713_P_K		0x330
+#define H713_P_END		0x390
+#define H713_P_SUM_WORDS	((H713_P_END - H713_P_STATUS) / 4)
+#define H713_P_MARK		0x5052
+#define H713_P_FROM_BL31	1
+#define H713_P_FROM_LINUX	2
+#define H713_P_REPORTED		0x00000001
+
+/* X */
+#define H713_X			0x390
+
+/* SB_STATE */
+enum h713_phase {
+	H713_PHASE_OFF, H713_PHASE_PRESLEEP, H713_PHASE_CPU_OP,
+	H713_PHASE_SLEEP, H713_PHASE_RESUMING, H713_PHASE_RELEASED,
+	H713_PHASE_RESET,
+};
+
+#define H713_SB_NET_ARMED	(1U << 4)
+#define H713_SB_ACCEPTED	(1U << 5)
+
+/* SB_STATE 23..16: why crust's last clean reset came (its ERR bit) */
+enum h713_cause {
+	H713_CAUSE_PRESLEEP = 1,	/* presleep budget over (9) */
+	H713_CAUSE_RESUMING,		/* resuming budget over (9) */
+	H713_CAUSE_DRAM_PHY,		/* DRAM PHY error after self-refresh (6) */
+	H713_CAUSE_POLL,		/* a poll's deadline (7) */
+	H713_CAUSE_RESTART,		/* restart in cpu-op, sleep or reset (8) */
+	H713_CAUSE_CPU_OP,		/* an invalid cpu op (4) */
+	H713_CAUSE_LOOP,		/* third restart in presleep or resuming (8) */
+	H713_CAUSE_PLL_LOCK = 9,	/* PLL lock deadline, deep stage only (10) */
+};
+
+static inline u32 h713_sb_state(unsigned int phase, bool armed, bool accepted,
+				unsigned int restarts, u8 cycle, u8 cause)
+{
+	return (u32)cause << 16 | (u32)cycle << 8 | (restarts & 3) << 6 |
+	       (u32)accepted << 5 | (u32)armed << 4 | (phase & 0xf);
+}
+
+static inline unsigned int h713_sb_phase(u32 s)
+{
+	return s & 0xf;
+}
+
+static inline unsigned int h713_sb_restarts(u32 s)
+{
+	return (s >> 6) & 3;
+}
+
+static inline u8 h713_sb_cycle(u32 s)
+{
+	return (u8)(s >> 8);
+}
+
+static inline u8 h713_sb_cause(u32 s)
+{
+	return (u8)(s >> 16);
+}
+
+/* NET_REQ, NET_BUDGET, NET_CONFIRM */
+#define H713_NET_REQ_MARK	0xa5
+#define H713_NET_REQ_FORMAT	1
+#define H713_NET_CONFIRM_MARK	0xc0f1
+
+static inline u32 h713_net_req(u8 cycle)
+{
+	return (u32)H713_NET_REQ_MARK << 24 | (u32)H713_NET_REQ_FORMAT << 16 |
+	       (u32)cycle << 8;
+}
+
+static inline u8 h713_net_req_format(u32 req)
+{
+	return (u8)(req >> 16);
+}
+
+static inline u8 h713_net_req_cycle(u32 req)
+{
+	return (u8)(req >> 8);
+}
+
+static inline u32 h713_net_budget(u16 presleep_s, u16 resuming_s)
+{
+	return (u32)resuming_s << 16 | presleep_s;
+}
+
+static inline u32 h713_net_confirm(u8 cycle)
+{
+	return (u32)H713_NET_CONFIRM_MARK << 16 | cycle;
+}
+
+/* crust's rule: the mark and the cycle of the phase it is in. */
+static inline bool h713_net_confirm_ok(u32 w, u8 cycle)
+{
+	return w >> 16 == H713_NET_CONFIRM_MARK && (u8)w == cycle;
+}
+
+/* TFA_WORD: 31..24 event, 23..16 running number, 15..0 detail */
+#define H713_TFA_DENIED		1	/* detail: the failed checks below */
+#define H713_TFA_START_LATE	2
+#define H713_TFA_RWDOG_FOUND	3
+#define H713_TFA_NOT_ACCEPTED	4
+/*
+ * DENIED detail, one bit per failed check from bit 0 on: magic, version,
+ * VDD_SYS build, unmeasured build (28 or 31), phase, net, running,
+ * heartbeat, affinity 0.
+ */
+#define H713_DENY_CHECKS	9
+
+static inline u32 h713_tfa_word(u8 event, u8 seq, u16 detail)
+{
+	return (u32)event << 24 | (u32)seq << 16 | detail;
+}
+
+static inline u8 h713_tfa_event(u32 w)
+{
+	return (u8)(w >> 24);
+}
+
+static inline u8 h713_tfa_seq(u32 w)
+{
+	return (u8)(w >> 16);
+}
+
+static inline u16 h713_tfa_detail(u32 w)
+{
+	return (u16)w;
+}
+
+/* P_HDR: 31..16 mark, 15..8 source, bit 0 reported by Linux */
+static inline u32 h713_p_hdr(u8 source)
+{
+	return (u32)H713_P_MARK << 16 | (u32)source << 8;
+}
+
+static inline u8 h713_p_source(u32 hdr)
+{
+	return hdr >> 16 == H713_P_MARK ? (hdr >> 8) & 0xff : 0;
+}
+
+/* P_SUM: the complement of the 32-bit sum of the words P_STATUS..P_END. */
+static inline u32 h713_p_sum(const u32 *w)
+{
+	u32 sum = 0;
+	unsigned int i;
+
+	for (i = 0; i < H713_P_SUM_WORDS; i++)
+		sum += w[i];
+	return ~sum;
+}
+
+/* A record to read: the mark, TF-A or Linux as its source, the checksum. */
+static inline bool h713_p_valid(u32 hdr, u32 sum, const u32 *w)
+{
+	u8 source = h713_p_source(hdr);
+
+	return (source == H713_P_FROM_BL31 || source == H713_P_FROM_LINUX) &&
+	       h713_p_sum(w) == sum;
+}
+
+/*
+ * The acceptance rule of a reader that knows versions MIN..MAX. From
+ * version 5 on, COMPAT names the oldest reader the page still suits, so a
+ * newer crust that only added words stays readable and one that changed a
+ * meaning is refused loudly instead of misread.
+ */
+static inline bool h713_contract_accept(u32 magic, u32 version, u32 compat,
+					u32 min, u32 max)
+{
+	u32 compat_eff = version >= 5 ? (compat & 0xff) : version;
+
+	return magic == H713_MAGIC_VALUE && version >= min && compat_eff <= max;
+}
+
+#endif /* __LINUX_SOC_SUNXI_H713_CRUST_CONTRACT_H */
