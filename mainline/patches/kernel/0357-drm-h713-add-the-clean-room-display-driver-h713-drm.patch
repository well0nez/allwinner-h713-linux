+static void h713_report_log(struct h713_drm *p, const struct h713_plane *n,
+			    const struct h713_report *r, int ret)
+{
+	struct drm_device *drm = &p->drm;
+	u32 i;
+
+	if (r->full_enable)
+		drm_info(
+			drm,
+			"video: %s %ux%u pitch %u luma 0x%08x chroma 0x%08x; rgb %s 0x%08x alpha %u\n",
+			n->video_fmt ? "NV16" : "NV12", n->width, n->height, n->pitch, n->luma,
+			n->chroma, n->rgb_on ? "on" : "off", n->rgb_phys, n->alpha);
+
+	if (r->full_enable || ret || r->mismatches || r->timeouts || r->check_fails)
+		drm_info(
+			drm,
+			"commit: %d, %u ops, %u writes, %u read-back mismatches, %u timeouts, %u check failures%s\n",
+			ret, r->ops, r->writes, r->mismatches, r->timeouts, r->check_fails,
+			r->full_enable ? " (video plane: full enable)" : "");
+	for (i = 0; i < r->nbad && i < H713_REPORT_BAD; i++)
+		drm_warn(drm, "  0x%08x: expected 0x%08x, read 0x%08x\n", r->bad_addr[i],
+			 r->bad_expect[i], r->bad_read[i]);
+	if (r->raster_fails)
+		drm_err(drm,
+			"raster stall suspected (spec 10 §6.3): %u stall signs; channel 0 cannot latch\n",
+			r->raster_fails);
+	if (r->cap_skipped)
+		drm_info(drm, "commit: %u capture-block writes left out (no TV-side re-init since the wake, spec 60 §3)\n",
+			 r->cap_skipped);
+	if (r->latch_pending)
+		dev_warn_ratelimited(drm->dev, "RGB latch still pending at a new flip (%u)\n",
+				     r->latch_pending);
+	if (ret && r->error_addr)
+		drm_err(drm, "commit stopped at 0x%08x\n", r->error_addr);
+}
+
+/*
+ * Picture controls and gamma. The controls whose value changed - after a full video enable every
+ * control and the LUT, since the enable programs its own state (spec/12, and the LUT off: 30 §4.3)
+ * - are computed by the Rust layer from the owner's files and written in the next vblank interrupt
+ * (or now, when no vblank is running), each word read back. A new LUT is loaded at once into the
+ * hidden bank (the picture does not change); its bank switch is one of the vblank writes. Writes
+ * still waiting from an earlier commit are performed first, so no change is lost and no load can
+ * hit a bank that is about to be shown.
+ */
+static void h713_pq_flush_pending(struct h713_drm *p, const char *why)
+{
+	unsigned long flags;
+	u32 n, bad = 0;
+	int ret = 0;
+
+	spin_lock_irqsave(&p->al_lock, flags);
+	n = p->pq_npending;
+	if (n)
+		ret = h713_hw_pq_apply(&p->hw, p->pq_pending, n, &bad);
+	p->pq_npending = 0;
+	spin_unlock_irqrestore(&p->al_lock, flags);
+	if (n) {
+		drm_crtc_vblank_put(&p->crtc);
+		drm_info(&p->drm,
+			 "pq: %u earlier words written now (%s): %d, %u read-back mismatches\n", n,
+			 why, ret, bad);
+	}
+}
+
+static void h713_pq_commit(struct h713_drm *p, const struct h713_crtc_state *cs, bool full_enable)
+{
+	struct drm_device *drm = &p->drm;
+	struct drm_property_blob *lut = cs->base.gamma_lut;
+	struct h713_write w[H713_PQ_N * H713_PQ_MAX_WRITES + 1];
+	unsigned long flags;
+	u32 i, n = 0, k, bad = 0, changed = 0;
+	bool gamma = p->pq_gamma && (lut != p->gamma_cur || (full_enable && lut));
+	int ret;
+
+	for (i = 0; i < H713_PQ_N; i++) {
+		if (!(p->pq_avail & BIT(i)) || (cs->pq[i] == p->pq_cur[i] && !full_enable))
+			continue;
+		ret = h713_hw_pq_writes(&p->hw, i, cs->pq[i], &w[n], H713_PQ_MAX_WRITES, &k);
+		if (ret) {
+			drm_warn(drm, "pq: control %u = %u: %d\n", i, cs->pq[i], ret);
+			continue;
+		}
+		n += k;
+		changed |= BIT(i);
+		p->pq_cur[i] = cs->pq[i];
+	}
+	if (gamma) {
+		h713_pq_flush_pending(p, "gamma load follows");
+		if (lut) {
+			ret = h713_hw_gamma_load(&p->hw, lut->data, H713_GAMMA_SIZE, &w[n], &bad);
+			drm_info(
+				drm,
+				"gamma: LUT %u loaded into the hidden bank: %d, %u read-back mismatches\n",
+				lut->base.id, ret, bad);
+		} else {
+			h713_hw_gamma_off(&w[n]);
+			ret = 0;
+		}
+		if (!ret) {
+			n++;
+			if (p->gamma_cur)
+				drm_property_blob_put(p->gamma_cur);
+			p->gamma_cur = lut ? drm_property_blob_get(lut) : NULL;
+		}
+	}
+	if (!n)
+		return;
+	if (drm_crtc_vblank_get(&p->crtc) == 0) {
+		h713_pq_flush_pending(p, "next commit came first");
+		spin_lock_irqsave(&p->al_lock, flags);
+		memcpy(p->pq_pending, w, n * sizeof(w[0]));
+		p->pq_npending = n;
+		spin_unlock_irqrestore(&p->al_lock, flags);
+		drm_dbg_kms(drm, "pq: %u words for the next vblank (controls 0x%x%s)\n", n, changed,
+			    gamma ? ", gamma" : "");
+		return;
+	}
+	ret = h713_hw_pq_apply(&p->hw, w, n, &bad);
+	drm_info(
+		drm,
+		"pq: controls 0x%x%s: %u words written now (no vblank): %d, %u read-back mismatches\n",
+		changed, gamma ? " and gamma" : "", n, ret, bad);
+}
+
+/*
+ * Unload: every control back at its default and the LUT off, so the logo (05 §6) or the next driver
+ * sees the picture the enable programs, not a client's tint (round 5: 0x051c00dc stayed 0x06400800
+ * after rmmod).
+ */
+static void h713_pq_restore(struct h713_drm *p)
+{
+	struct h713_write w[H713_PQ_N * H713_PQ_MAX_WRITES + 1];
+	u32 i, n = 0, k, bad = 0, lo, hi, def;
+	const char *name;
+	int ret;
+
+	for (i = 0; i < H713_PQ_N; i++) {
+		if (!(p->pq_avail & BIT(i)) || h713_hw_pq_info(i, &name, &lo, &hi, &def) ||
+		    p->pq_cur[i] == def)
+			continue;
+		if (!h713_hw_pq_writes(&p->hw, i, def, &w[n], H713_PQ_MAX_WRITES, &k)) {
+			n += k;
+			p->pq_cur[i] = def;
+		}
+	}
+	if (p->gamma_cur) {
+		h713_hw_gamma_off(&w[n++]);
+		drm_property_blob_put(p->gamma_cur);
+		p->gamma_cur = NULL;
+	}
+	ret = n ? h713_hw_pq_apply(&p->hw, w, n, &bad) : 0;
+	dev_info(
+		p->drm.dev,
+		"unload: picture controls at their defaults, LUT off: %u words: %d, %u read-back mismatches\n",
+		n, ret, bad);
+}
+
+/* --- the HDMI input (spec 50, 55, 96) -------------------------------------------------------- */
+
+/*
+ * A state machine in a delayed work, 100 ms per reading while the CRTC's video_source is "hdmi":
+ *
+ *   no TMDS (50 §4)            -> no-signal; after 3 readings without TMDS the capture stops and
+ *                                 the receiver is brought up again when TMDS returns (relock after
+ *                                 signal loss or a hot-plug pulse of the external EDID provider)
+ *   TMDS, receiver not up      -> the receiver sequence of 50 §8 (about 7 s), then 4 s to lock
+ *   TMDS, no valid timing      -> tmds; after 5 s the receiver is brought up again
+ *   a timing other than 1080p60 -> unsupported: nothing is captured or shown
+ *   1080p60, capture off       -> the capture programming of 55 §8 into the driver's ring
+ *   capture counting at 1080p60 -> channel 0 on the ring (a full enable as for an NV16 client
+ *                                 buffer), then the video vsync IRQ rotates the slot (55 §5)
+ *   capture standing 0.5 s     -> capture off; the receiver is brought up again
+ *
+ * Every stop clears both capture outputs and waits 40 ms (55 §4), after the video plane is off
+ * (96 T3-05: no stale frame). EDID and hot-plug are an external provider's (50 §3).
+ * Lock order: hdmi_lock, then hw_lock.
+ */
+#define H713_HDMI_PERIOD_MS 100
+
+static void h713_hdmi_props(struct h713_drm *p)
+{
+	struct drm_mode_object *o = &p->crtc.base;
+	const struct h713_rx_signs *s = &p->signs;
+	bool timing = p->hdmi_state >= H713_HDMI_UNSUPPORTED && p->hdmi_state <= H713_HDMI_CAPTURING;
+	u32 v[H713_HDMI_INFO_N] = {
+		[H713_HDMI_WIDTH] = timing ? s->timing[1] : 0,
+		[H713_HDMI_HEIGHT] = timing ? s->timing[7] : 0,
+		[H713_HDMI_REFRESH_MHZ] = timing ? s->refresh_mhz : 0,
+		[H713_HDMI_SOURCE_FRAMES] = p->src_frames,
+		[H713_HDMI_SHOWN] = READ_ONCE(p->rot.shown),
+		[H713_HDMI_REPEATED] = READ_ONCE(p->rot.repeated),
+		[H713_HDMI_SKIPPED] = READ_ONCE(p->rot.skipped),
+	};
+	u32 i;
+
+	if (!p->hdmi_state_prop)
+		return;
+	drm_object_property_set_value(o, p->hdmi_state_prop, p->hdmi_state);
+	for (i = 0; i < H713_HDMI_INFO_N; i++)
+		drm_object_property_set_value(o, p->hdmi_info_prop[i], v[i]);
+}
+
+/* The video part of a commit while the CRTC shows the HDMI input. */
+static void h713_hdmi_video(struct h713_drm *p, struct h713_plane *d)
+{
+	d->video_on = p->hdmi_video.video_on;
+	d->video_fmt = p->hdmi_video.video_fmt;
+	d->width = p->hdmi_video.width;
+	d->height = p->hdmi_video.height;
+	d->pitch = p->hdmi_video.pitch;
+	d->luma = p->hdmi_video.luma;
+	d->chroma = p->hdmi_video.chroma;
+}
+
+/* Commit p->hdmi_video with the rest as the hardware shows it (hdmi_lock held). */
+static int h713_hdmi_commit(struct h713_drm *p)
+{
+	struct h713_report rep = {};
+	struct h713_plane next;
+	int ret;
+
+	mutex_lock(&p->hw_lock);
+	next = p->cur;
+	h713_hdmi_video(p, &next);
+	ret = h713_hw_commit(&p->hw, &p->cur, &next, &rep);
+	h713_report_log(p, &next, &rep, ret);
+	if (!ret)
+		p->cur = next;
+	else
+		memset(&p->cur, 0, sizeof(p->cur));
+	mutex_unlock(&p->hw_lock);
+	return ret;
+}
+
+static void h713_hdmi_log_counts(struct h713_drm *p, const char *when)
+{
+	drm_info(&p->drm,
+		 "hdmi: %s: %u source frames, %u shown, %u repeated, %u skipped (%u bad write indices, %u latch timeouts)\n",
+		 when, p->src_frames, p->rot.shown, p->rot.repeated, p->rot.skipped,
+		 p->rot.bad_index, p->rot.latch_timeouts);
+}
+
+/* Video plane off, capture stopped, 40 ms (hdmi_lock held). */
+static void h713_hdmi_capture_off(struct h713_drm *p, const char *why)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&p->al_lock, flags);
+	p->ring_live = false;
+	spin_unlock_irqrestore(&p->al_lock, flags);
+	/*
+	 * The video vsync interrupt goes off with the rotation: its handler clears the vsync status
+	 * bit (0x056000c0 bit 0) that the next full enable's raster check polls for (10 §6.3); left
+	 * on, every later full enable of the boot (and of a reloaded module: the enable bit stays)
+	 * timed out there (round 11).
+	 */
+	h713_hw_video_vsync_irq(&p->hw, false);
+	if (p->hdmi_video.video_on) {
+		p->hdmi_video.video_on = 0;
+		h713_hdmi_commit(p);
+	}
+	if (p->cap_on) {
+		h713_hw_cap_stop(&p->hw);
+		msleep(40);	/* 55 §4: nothing is written 40 ms after both enables are clear */
+		p->cap_on = false;
+		h713_hdmi_log_counts(p, why);
+	}
+}
+
+/* The CRTC stops showing the HDMI input (hdmi_lock held; not with hw_lock). */
+static void h713_hdmi_off(struct h713_drm *p, const char *why)
+{
+	h713_hdmi_capture_off(p, why);
+	if (p->hdmi_state == H713_HDMI_LOCKED || p->hdmi_state == H713_HDMI_CAPTURING)
+		h713_hdmirx_source_change(p->rx);
+	p->hdmi_on = false;
+	p->provider_done = false;	/* the next hdmi_on serves EDID and pulses hot-plug again */
+	p->rx_up = false;		/* and brings the receiver up again (a sleep loses it) */
+	p->rx_written = false;
+	p->rx_forced = 0;
+	p->hdmi_state = H713_HDMI_OFF;
+	p->hdmi_video.video_on = 0;
+	h713_hdmi_props(p);
+	drm_info(&p->drm, "hdmi: off (%s)\n", why);
+}
+
+static void h713_hdmi_state(struct h713_drm *p, enum h713_hdmi_state st)
+{
+	const struct h713_rx_signs *s = &p->signs;
+
+	bool was = p->hdmi_state == H713_HDMI_LOCKED || p->hdmi_state == H713_HDMI_CAPTURING;
+	bool is = st == H713_HDMI_LOCKED || st == H713_HDMI_CAPTURING;
+
+	if (st == p->hdmi_state)
+		return;
+	if (was != is)
+		h713_hdmirx_source_change(p->rx);	/* lock or loss: V4L2_EVENT_SOURCE_CHANGE */
+	drm_info(&p->drm,
+		 "hdmi: %s -> %s (TMDS %u, timing %ux%u of %ux%u, enables %u, CAP 0x104 0x%08x 0x548 0x%08x 0x874 0x%08x 0x928 0x%08x)\n",
+		 h713_hdmi_state_names[p->hdmi_state], h713_hdmi_state_names[st], s->tmds,
+		 s->timing[1], s->timing[7], s->timing[0], s->timing[6], s->enables, s->counter,
+		 s->totals, s->size, s->out_luma);
+	p->hdmi_state = st;
+}
+
+/*
+ * spec 57: the EDID upload (with the provider's EDID-module reset, 0.64 s on the bench) and a hot-plug
+ * reset pulse (back up after about 0.83 s), process context. The receiver sequence then starts 3 s
+ * later, as on the bench (Q-RX-3). Returns 0 or the provider's error (-ENODEV: absent or its firmware
+ * stopped; -EAGAIN: not ready).
+ */
+static int h713_hdmi_provider(struct h713_drm *p)
+{
+#if H713_HAVE_ARISC
+	const void *edid = p->edid_len ? p->edid_buf : NULL;
+	size_t len = p->edid_len ? ARISC_HDMI_EDID_SIZE : 0;
+	int ret;
+
+	if (p->edid_cleared) {
+		drm_info(&p->drm, "hdmi: provider: EDID cleared by S_EDID: hot-plug stays low\n");
+		return 0;
+	}
+	ret = arisc_hdmi_edid_init(hdmi_port, edid, len);
+	if (ret) {
+		drm_warn(&p->drm, "hdmi: provider: EDID upload on port %u: %d\n", hdmi_port, ret);
+		return ret;
+	}
+	ret = arisc_hdmi_hpd(hdmi_port, ARISC_HDMI_HPD_RESET);
+	if (ret) {
+		drm_warn(&p->drm, "hdmi: provider: hot-plug reset on port %u: %d\n", hdmi_port, ret);
+		return ret;
+	}
+	drm_info(&p->drm, "hdmi: provider: EDID (%s) served on port %u, hot-plug pulsed\n",
+		 edid ? "the driver's 512 bytes" : "as held", hdmi_port);
+	return 0;
+#else
+	return -ENODEV;
+#endif
+}
+
+static void h713_hdmi_work(struct work_struct *work)
+{
+	struct h713_drm *p = container_of(to_delayed_work(work), struct h713_drm, hdmi_work);
+	struct h713_rx_signs *s = &p->signs;
+	struct h713_rx_report rr;
+	unsigned long delay = msecs_to_jiffies(H713_HDMI_PERIOD_MS);
+	unsigned long flags;
+	u32 frame, slot, step;
+	int ret;
+
+	mutex_lock(&p->hdmi_lock);
+	if (!p->hdmi_on)
+		goto out;
+	if (!p->rx_safe) {
+		/* spec 60 v4: no receiver / capture access after a deep sleep until reboot */
+		if (p->hdmi_state != H713_HDMI_UNAVAILABLE) {
+			p->hdmi_state = H713_HDMI_UNAVAILABLE;
+			h713_hdmi_props(p);
+			h713_hdmirx_source_change(p->rx);
+			/* once per entry into the state (each new user), not per reading */
+			drm_warn(&p->drm, "hdmi: unavailable after a deep sleep (spec 60 v4): reboot to use the HDMI input\n");
+		}
+		goto out;	/* not requeued */
+	}
+	if (!p->provider_done && !hdmi_edid_external) {
+		ret = h713_hdmi_provider(p);
+		if (ret) {
+			delay = secs_to_jiffies(5);	/* try again */
+			goto again;
+		}
+		p->provider_done = true;
+		delay = secs_to_jiffies(3);	/* the bench started the receiver 3 s later */
+		goto again;
+	}
+	s->frame_before = p->last_frame;
+	ret = h713_hw_rx_signs(&p->hw, s);
+	if (ret) {
+		drm_err(&p->drm, "hdmi: lock signs unreadable: %d\n", ret);
+		goto again;
+	}
+	frame = s->counter >> 16;
+	if (p->cap_on)
+		p->src_frames += (u16)(frame - p->last_frame);
+	p->last_frame = frame;
+
+	step = h713_hw_rx_step(s->tmds, p->rx_up || p->cap_on, p->rx_written,
+			       jiffies_to_msecs(min(jiffies - p->rx_written_at, (unsigned long)INT_MAX)),
+			       p->hdmi_lost);
+	switch (step) {
+	case H713_RX_EVALUATE:
+		p->hdmi_lost = 0;
+		break;
+	case H713_RX_WAIT:
+		h713_hdmi_state(p, H713_HDMI_NO_SIGNAL);
+		goto again;
+	case H713_RX_COUNT:
+		p->hdmi_lost++;
+		h713_hdmi_state(p, H713_HDMI_NO_SIGNAL);
+		goto again;
+	case H713_RX_LOST:
+		if (p->cap_on)
+			h713_hdmi_capture_off(p, "signal lost");
+		p->rx_up = false;
+		p->hdmi_lost = 0;
+		h713_hdmi_state(p, H713_HDMI_NO_SIGNAL);
+		goto again;
+	default:	/* H713_RX_WRITE_TMDS, H713_RX_WRITE_NO_TMDS */
+		p->hdmi_lost = 0;
+		if (step == H713_RX_WRITE_TMDS) {
+			/* 50 §8; Q-RX-3: the bench started 3 s after the hot-plug call */
+			h713_hdmi_state(p, H713_HDMI_TMDS);
+			drm_info(&p->drm, "hdmi: TMDS present: receiver sequence (spec 50 §8%s)\n",
+				 hdmi_pace ? ", the bench's pauses: about 7 s" : ", no pauses");
+		} else if (!p->rx_forced++) {
+			/*
+			 * 50 §8 / §9: the bench wrote the sequence 3 s after the hot-plug with no TMDS
+			 * condition; on a fresh bench boot (r15) and after a wake (60 §3) TMDS only
+			 * shows once it is written. Again every 10 s while no TMDS comes.
+			 */
+			drm_info(&p->drm, "hdmi: no TMDS: receiver sequence as the bench wrote it (spec 50 §8, §9; again every %u s without TMDS)\n",
+				 10);
+		}
+		ret = h713_hw_rx_bringup(&p->hw, hdmi_ccu, hdmi_pace, &rr);
+		p->rx_written = true;
+		p->rx_written_at = jiffies;
+		if (step == H713_RX_WRITE_TMDS || p->rx_forced == 1 || ret || rr.mismatches)
+			drm_info(&p->drm,
+				 "hdmi: receiver sequence: %d, %u writes, %u read-back mismatches (first 0x%08x read 0x%02x; status bytes not compared), %u CCU writes left to the clock driver\n",
+				 ret, rr.writes, rr.mismatches, rr.bad_addr, rr.bad_read, rr.skipped_ccu);
+		p->rx_up = !ret;
+		p->hdmi_wait = 0;
+		/* 58 §2: lock 0.1-0.7 s after the writes; the paced bench read it 4 s later */
+		if (hdmi_pace)
+			delay = usecs_to_jiffies(4000000);
+		goto again;
+	}
+
+	switch (s->state) {
+	case H713_HDMI_TMDS:
+		h713_hdmi_capture_off(p, "timing lost");
+		h713_hdmi_state(p, H713_HDMI_TMDS);
+		/* no timing 2 s after the writes (5 s paced): the receiver again */
+		if (++p->hdmi_wait >= (hdmi_pace ? 50 : 20)) {
+			p->rx_up = false;
+			p->hdmi_wait = 0;
+		}
+		break;
+	case H713_HDMI_UNSUPPORTED:
+		/*
+		 * Round 11: right after the receiver writes the vertical total settles through
+		 * other values (2200x1085) for about 0.1 s. Not a relock reason; a running capture
+		 * stops only after 3 readings (0.3 s) of an unsupported timing.
+		 */
+		if (p->cap_on && ++p->hdmi_unsup >= 3)
+			h713_hdmi_capture_off(p, "unsupported timing");
+		h713_hdmi_state(p, H713_HDMI_UNSUPPORTED);
+		break;
+	case H713_HDMI_LOCKED:
+		p->hdmi_wait = 0;
+		p->hdmi_unsup = 0;
+		if (!p->cap_on) {
+			ret = h713_hw_cap_start(&p->hw, p->ring.luma[0], hdmi_pace, &rr);
+			drm_info(&p->drm,
+				 "hdmi: capture programming (spec 55 §8) into the ring at 0x%08x: %d, %u writes, %u read-back mismatches (first 0x%08x read 0x%08x)\n",
+				 p->ring.luma[0], ret, rr.writes, rr.mismatches, rr.bad_addr,
+				 rr.bad_read);
+			p->cap_on = true;
+			p->hdmi_stand = 0;
+			p->src_frames = 0;
+			memset(&p->rot, 0, sizeof(p->rot));
+			p->rot.shown_slot = 0xff;
+		} else if (++p->hdmi_stand >= 5) {
+			h713_hdmi_capture_off(p, "capture stands");
+			p->rx_up = false;
+		}
+		h713_hdmi_state(p, H713_HDMI_LOCKED);
+		break;
+	case H713_HDMI_CAPTURING:
+		p->hdmi_stand = 0;
+		p->hdmi_unsup = 0;
+		h713_hdmi_state(p, H713_HDMI_CAPTURING);
+		if (!(p->hdmi_users & H713_HDMI_USER_DRM)) {
+			/* V4L2 alone: the ring is read by the V4L2 client, channel 0 stays as it is */
+		} else if (!p->hdmi_video.video_on) {
+			/* start on the last complete slot (55 §5); the IRQ rotates from there */
+			slot = ((s->write_index & 7) + 2) % 3;
+			p->hdmi_video = (struct h713_plane){
+				.video_on = 1, .video_fmt = 1, .width = 1920, .height = 1080,
+				.pitch = 1920, .luma = p->ring.luma[slot], .chroma = p->ring.chroma[slot],
+			};
+			ret = h713_hdmi_commit(p);
+			if (ret) {
+				p->hdmi_video.video_on = 0;
+				break;
+			}
+			spin_lock_irqsave(&p->al_lock, flags);
+			/*
+			 * Count from here: the first vsync picks the last complete slot again (no
+			 * skips for the source frames of the full enable, 58 §6).
+			 */
+			memset(&p->rot, 0, sizeof(p->rot));
+			p->rot.shown_slot = 0xff;
+			p->ring_live = true;
+			spin_unlock_irqrestore(&p->al_lock, flags);
+			h713_hw_video_vsync_irq(&p->hw, true);
+			p->src_frames = 0;
+			p->hdmi_log_ns = ktime_get_ns();
+			drm_info(&p->drm, "hdmi: channel 0 shows the ring (slot %u), rotating at the video vsync\n",
+				 slot);
+		} else if (ktime_get_ns() - p->hdmi_log_ns >= 10 * NSEC_PER_SEC) {
+			h713_hdmi_log_counts(p, "running");
+			p->hdmi_log_ns = ktime_get_ns();
+		}
+		break;
+	default:
+		break;
+	}
+again:
+	h713_hdmi_props(p);
+	queue_delayed_work(system_long_wq, &p->hdmi_work, delay);
+out:
+	mutex_unlock(&p->hdmi_lock);
+}
+
+static void h713_hdmi_off(struct h713_drm *p, const char *why);
+static void h713_hdmi_video(struct h713_drm *p, struct h713_plane *d);
+
+/* A user takes the HDMI input (hdmi_lock held): it starts with the first one. */
+/*
+ * Spec 60 §3: after a wake, the TV-side re-init before the first receiver / capture access
+ * (hdmi_lock held; process context, about 0.2 s). Its success can only be judged by its read-backs:
+ * a bad one shows as a hang at the first receiver read (5 of 6 good on the bench).
+ */
+static bool h713_tvside_reinit(struct h713_drm *p)
+{
+	struct h713_report rep = {};
+	u32 i, k, writes = 0, bad = 0;
+	int r = 0;
+
+	if (p->rx_safe)
+		return true;
+	if (!p->ntvtop) {
+		drm_info(&p->drm, "hdmi: no TV-side re-init (tvtop_init=none, spec 60 v4): the HDMI input is unavailable until reboot\n");
+		return false;
+	}
+	for (k = 0; k < p->ntvtop && !r; k++) {
+		r = h713_hw_regs_run(&p->hw, p->tvtop[k].text, p->tvtop[k].len, &rep);
+		writes += rep.writes;
+		bad += rep.mismatches;
+		for (i = 0; i < min_t(u32, rep.nbad, H713_REPORT_BAD); i++)
+			drm_warn(&p->drm, "  0x%08x: expected 0x%08x, read 0x%08x\n", rep.bad_addr[i],
+				 rep.bad_expect[i], rep.bad_read[i]);
+	}
+	p->rx_safe = !r && !bad;
+	p->hw.cap_blocked = !p->rx_safe;
+	p->rx_written = false;	/* 60 §3: then the receiver sequence without waiting for TMDS */
+	drm_warn(&p->drm, "hdmi: UNSAFE TV-side re-init after the wake (tvtop_init; spec 60 v4: a bad one hangs at the next receiver read): %d, %u writes, %u read-back mismatches%s\n",
+		 r, writes, bad, p->rx_safe ? "" : ": the HDMI input stays off");
+	return p->rx_safe;
+}
+
+static void h713_hdmi_get(struct h713_drm *p, u32 user)
+{
+	p->hdmi_users |= user;
+	if (p->hdmi_on)
+		return;
+	if (!p->rx_safe)
+		h713_tvside_reinit(p);	/* the work holds the input off if this did not succeed */
+	p->hdmi_on = true;
+	p->hdmi_state = H713_HDMI_NO_SIGNAL;
+	drm_info(&p->drm, "hdmi: the HDMI input runs (users 0x%x; 1080p60 only)\n", p->hdmi_users);
+	mod_delayed_work(system_long_wq, &p->hdmi_work, 0);
+}
+
+/*
+ * A user lets go (hdmi_lock held; not with hw_lock): the CRTC's going stops the rotation and takes
+ * the video plane off; the last one's stops the input (capture off, 40 ms).
+ */
+static void h713_hdmi_put(struct h713_drm *p, u32 user, const char *why)
+{
+	unsigned long flags;
+
+	p->hdmi_users &= ~user;
+	if (user & H713_HDMI_USER_DRM) {
+		spin_lock_irqsave(&p->al_lock, flags);
+		p->ring_live = false;
+		spin_unlock_irqrestore(&p->al_lock, flags);
+		h713_hw_video_vsync_irq(&p->hw, false);
+		if (p->hdmi_video.video_on) {
+			p->hdmi_video.video_on = 0;
+			h713_hdmi_commit(p);
+		}
+	}
+	if (!p->hdmi_users && p->hdmi_on)
+		h713_hdmi_off(p, why);
+	else if (p->hdmi_on)
+		drm_info(&p->drm, "hdmi: %s; the input stays on for the %s\n", why,
+			 p->hdmi_users & H713_HDMI_USER_DRM ? "CRTC (video_source = hdmi)" :
+							      "open V4L2 file(s)");
+}
