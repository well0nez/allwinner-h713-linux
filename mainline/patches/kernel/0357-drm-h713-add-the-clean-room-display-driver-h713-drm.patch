+    /// In: the frame counter of the previous reading.
+    frame_before: u32,
+    /// Out: `enum h713_hdmi_state` (h713-vp `hdmi::Lock` + 1; 0 = off is the C side's).
+    state: u32,
+    refresh_mhz: u32,
