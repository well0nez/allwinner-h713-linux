+static const u32 h713_primary_formats[] = { DRM_FORMAT_XRGB8888 };
+static const u32 h713_overlay_formats[] = { DRM_FORMAT_NV12, DRM_FORMAT_NV16 };
+static const u64 h713_modifiers[] = { DRM_FORMAT_MOD_LINEAR, DRM_FORMAT_MOD_INVALID };
+
+/* Fill the primary part of `d` from a plane state; returns false if the plane shows nothing. */
+static bool h713_desc_primary(struct drm_plane_state *ps, struct h713_plane *d)
+{
+	struct drm_framebuffer *fb = ps->fb;
+
+	if (!ps->visible || !fb || !ps->crtc)
+		return false;
+	d->rgb_on = 1;
+	d->rgb_phys = (u32)drm_fb_dma_get_gem_addr(fb, ps, 0);
+	d->rgb_pitch = fb->pitches[0];
+	d->alpha = ps->alpha >> 8;
+	return true;
+}
+
+static bool h713_desc_overlay(struct drm_plane_state *ps, struct h713_plane *d)
+{
+	struct drm_framebuffer *fb = ps->fb;
+
+	if (!ps->visible || !fb || !ps->crtc)
+		return false;
+	d->video_on = 1;
+	d->video_fmt = fb->format->format == DRM_FORMAT_NV16 ? 1 : 0;
+	d->width = ps->src_w >> 16;
+	d->height = ps->src_h >> 16;
+	d->pitch = fb->pitches[0];
+	d->luma = (u32)drm_fb_dma_get_gem_addr(fb, ps, 0);
+	d->chroma = (u32)drm_fb_dma_get_gem_addr(fb, ps, 1);
+	return true;
+}
+
+static int h713_plane_atomic_check(struct drm_plane *plane, struct h713_atomic *state)
+{
+	struct h713_drm *p = to_h713(plane->dev);
+	struct drm_plane_state *ps = drm_atomic_get_new_plane_state(state, plane);
+	struct drm_crtc_state *cs = NULL;
+	bool overlay = plane == &p->overlay;
+	struct h713_plane d = {};
+	struct drm_framebuffer *fb = ps->fb;
+	int ret;
+
+	if (ps->crtc)
+		cs = drm_atomic_get_new_crtc_state(state, ps->crtc);
+	/*
+	 * 1:1 for the primary plane; the overlay enlarges 1280x720 by 1.5 (scale = src/dst =
+	 * 0xaaaa).
+	 */
+	ret = drm_atomic_helper_check_plane_state(ps, cs, overlay ? 0xaaaa : DRM_PLANE_NO_SCALING,
+						  DRM_PLANE_NO_SCALING, false, true);
+	if (ret || !ps->visible)
+		return ret;
+	if (ps->src_x || ps->src_y || (ps->src_w >> 16) != fb->width ||
+	    (ps->src_h >> 16) != fb->height)
+		return -EINVAL;	/* whole buffer only */
+	if (overlay) {
+		if (fb->pitches[1] != fb->pitches[0])
+			return -EINVAL;
+		h713_desc_overlay(ps, &d);
+	} else {
+		if (fb->width != 1920 || fb->height != 1080)
+			return -EINVAL;
+		h713_desc_primary(ps, &d);
+	}
+	ret = h713_hw_check(&p->hw, &d);
+	if (ret)
+		drm_dbg_kms(plane->dev, "%s: refused by the hardware layer: %d\n", plane->name,
+			    ret);
+	return ret;
+}
