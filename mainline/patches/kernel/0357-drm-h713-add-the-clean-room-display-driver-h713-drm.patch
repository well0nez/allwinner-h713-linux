+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+//! The composer: (frame, panel, switches, table list, the owner's `database.TSE`) -> ordered steps
+//! of operations.
+//!
+//! Enable order (each step names its spec rows; switches in brackets):
+//!
+//! 1. `precondition` [precheck]: read-only checks of 00 §3/§4 (co-processor never ran, display
+//!    clocks on, raster).
+//! 2. one step per table of the list [init-tables]: the owner's tables in list order, 40 §4.3 write
+//!    rule.
+//! 3. `lock-totals` [lock-totals]: `PROC_LOCK`/`PNL_LOCK` `fe08` = panel totals (10 §6.2 Q1 state).
+//! 4. `runtime-30-5` [runtime-30-5]: the live words of 30 §5.
+//! 5. spec/12, by `Config::dram_set` (12 §M): full = `dram-rest` [dram-rest] (lock, `PROC`, `SCL`,
+//!    `DEI`, `PNL`) and `dram-nrc-border` [dram-nrc-border] (`NRC`, `BORDER`, the driver's
+//!    buffers); or one `dram-minimal40` / `dram-minimal85` step [dram-nrc-border]. The 12 §M.3
+//!    status words are never written.
+//! 6. `scaler` [scaler]: 20 §3 S1 or S2 HY320 (ratio rule of 20 §2.1).
+//! 7. `source-geometry` [source-geometry]: `PROC`, `NRC`, `DEI` words that carry the source size
+//!    (20 §3 S2 HY320).
+//! 8. `frame-source` [frame-source]: 10 §6.2, the "+1" on the source height (20 §3 S2 HY320).
+//! 9. `white-balance` [white-balance]: 30 §4.1 (off by default).
+//! 10. `video-channel`: 10 §6 L4, the one place of the enable/latch path (91 O1); `VCH_OUTSIZE` =
+//!     source window.
+//! 11. `raster-check` [raster-check]: the stall signs of 10 §6.3, reported (bounded reads, no blind
+//!     wait); after channel 0 is on, because the video vsync status sets only then (10 §6.3).
+//! 12. `plane-select` [plane-select]: `PNL_SEL`, `MIX` (10 §3).
+//!
+//! The init tables and the lock totals are written with the pauses of `Config::pacing` (10 §6.3).
+#![deny(
+    clippy::indexing_slicing,
+    clippy::arithmetic_side_effects,
+    clippy::unwrap_used,
+    clippy::expect_used
+)]
+
+use super::block::Block;
+use super::config::{
+    Config, ConfigError, DramSet, Frame, LatchWait, PixelFormat, ScaleState, Switch,
+    CHROMA_GAIN_REST,
+};
+use super::op::{Cond, Op, Readback, Sink};
+use super::state12::{self, Word};
+use super::tables::{self, TableError, TableRef};
