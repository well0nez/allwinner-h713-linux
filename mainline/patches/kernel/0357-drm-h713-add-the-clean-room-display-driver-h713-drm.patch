+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+//! The table list (91 O11: which file tables, in which order and state, is data, not code) and the
+//! state selection over the owner's `database.TSE`.
+//!
+//! The text form of the list is parsed by [`super::tablelist`] (host tools only).
+#![deny(
+    clippy::indexing_slicing,
+    clippy::arithmetic_side_effects,
+    clippy::unwrap_used,
+    clippy::expect_used
+)]
+
+use super::h713_tse::regtable::{RegTable, TableWrite};
+use super::h713_tse::tse::{self, Found};
+
+/// How the state of a table is chosen.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Selector {
+    /// The module must have exactly one state.
+    Only,
+    /// State by 0-based index.
+    Index(u32),
+    /// The single state whose attribute list holds every given word (unused slots 0).
+    Attr([u32; 4]),
+    /// The single state whose write to `addr` has `value` under the write's mask.
+    Value { addr: u32, value: u32 },
+}
+
+/// One entry of the table list.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct TableRef {
+    pub handle: u32,
+    pub selector: Selector,
+}
+
+/// The init tables in the order of the 10 §6.2 Q1 state: panel `0x2006`, processing `0x2005`, noise
+/// reduction `0x2003`, deinterlacer `0x2004`, data-path reset `0x1c003` (40 §4.2, §4.4).
+pub const DEFAULT_LIST: [TableRef; 5] = [
+    TableRef {
+        handle: 0x2006,
+        selector: Selector::Only,
+    },
+    TableRef {
+        handle: 0x2005,
+        selector: Selector::Only,
+    },
+    TableRef {
+        handle: 0x2003,
+        selector: Selector::Only,
+    },
+    TableRef {
+        handle: 0x2004,
+        selector: Selector::Only,
+    },
+    TableRef {
+        handle: 0x1c003,
+        selector: Selector::Only,
+    },
+];
+
+/// Why a table cannot be used.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum TableError {
+    /// The file does not parse.
+    Parse(super::h713_tse::Error),
+    /// No module with that handle.
+    NotFound,
+    /// The module is not a register table.
+    NotRegisterTable,
+    /// No state matches the selector.
+    NoState,
+    /// More than one state matches.
+    Ambiguous,
+    /// An access width other than 4 bytes (never seen in the HY320 file; 32-bit access only).
+    Width,
+    /// A write outside the blocks of spec/00 §1.
+    UnknownBlock(u32),
+}
+
+impl From<super::h713_tse::Error> for TableError {
+    fn from(e: super::h713_tse::Error) -> Self {
+        Self::Parse(e)
+    }
+}
+
+/// A resolved table: the module, its register table and the chosen state.
+#[derive(Clone, Copy, Debug)]
+pub struct Resolved<'a> {
+    pub found: Found<'a>,
+    pub table: RegTable<'a>,
+    pub state: u32,
+}
+
+impl<'a> Resolved<'a> {
+    pub fn writes(&self) -> impl Iterator<Item = TableWrite> + 'a {
+        self.table.writes(self.state).into_iter().flatten()
+    }
+}
+
+/// Resolves `r` against the owner's `database.TSE` bytes and checks every write (32-bit, inside a
+/// known block).
+pub fn resolve(db: &[u8], r: TableRef) -> Result<Resolved<'_>, TableError> {
+    let found = tse::find_module(db, r.handle)?.ok_or(TableError::NotFound)?;
+    let table = found.module.reg_table().map_err(|e| match e.kind {
+        super::h713_tse::ErrorKind::Unsupported => TableError::NotRegisterTable,
+        _ => TableError::Parse(e),
+    })?;
+    let n = table.state_count;
+    let pick = |pred: &dyn Fn(u32) -> bool| -> Result<u32, TableError> {
+        let mut hit = None;
+        for s in 0..n {
+            if pred(s) {
+                if hit.is_some() {
+                    return Err(TableError::Ambiguous);
+                }
+                hit = Some(s);
+            }
+        }
+        hit.ok_or(TableError::NoState)
+    };
+    let state = match r.selector {
+        Selector::Only if n == 1 => 0,
+        Selector::Only => return Err(TableError::Ambiguous),
+        Selector::Index(i) if i < n => i,
+        Selector::Index(_) => return Err(TableError::NoState),
+        Selector::Attr(words) => pick(&|s| {
+            found.module.state(s).is_some_and(|st| {
+                words
+                    .iter()
+                    .filter(|&&w| w != 0)
+                    .all(|&w| st.attrs.has_word(w))
+            })
+        })?,
+        Selector::Value { addr, value } => pick(&|s| {
+            table
+                .writes(s)
+                .into_iter()
+                .flatten()
+                .any(|w| w.addr == addr && w.value & w.mask == value & w.mask)
+        })?,
+    };
+    for w in table.writes(state).into_iter().flatten() {
+        if w.width != 4 {
+            return Err(TableError::Width);
+        }
+        if super::block::Block::of(w.addr).is_none() {
+            return Err(TableError::UnknownBlock(w.addr));
+        }
+    }
+    Ok(Resolved {
+        found,
+        table,
+        state,
+    })
+}
