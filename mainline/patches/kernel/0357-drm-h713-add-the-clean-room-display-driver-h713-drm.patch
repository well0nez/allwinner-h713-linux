new file mode 100644
index 000000000..d7598f58a
--- /dev/null
+++ b/drivers/gpu/drm/h713/h713_hdmirx.h
@@ -0,0 +1,70 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * h713_drm: the HDMI receiver as a V4L2 capture device ("h713-hdmirx-clean"), the interface between
+ * the DRM/KMS shell (h713_drm_main.c, which owns the HDMI input: receiver, capture, ring) and the
+ * V4L2 part (h713_hdmirx.c). Built only with CONFIG_VIDEO_DEV.
+ *
+ * Ownership: the HDMI input (spec 50, 55: receiver bring-up, capture programming, the ring in
+ * reserved memory) has one owner, the shell's HDMI state machine. It runs while it has a user: the
+ * CRTC (video_source = hdmi; channel 0 shows the ring) and/or the V4L2 device (an open file). Both
+ * only read the ring; nothing but the state machine programs the receiver or the capture block.
+ */
+#ifndef H713_HDMIRX_H
+#define H713_HDMIRX_H
+
+#include <linux/types.h>
+
+struct device;
+struct drm_device;
+struct h713_drm;
+struct h713_hdmirx;
+
+/* --- shell -> V4L2 part ---------------------------------------------------------------------- */
+
+#if IS_ENABLED(CONFIG_VIDEO_DEV)
+int h713_hdmirx_register(struct h713_drm *p, struct device *dev, struct h713_hdmirx **out);
+void h713_hdmirx_unregister(struct h713_hdmirx *rx);
+/* the lock state changed (locked <-> not, or the timing): a SOURCE_CHANGE event; any context */
+void h713_hdmirx_source_change(struct h713_hdmirx *rx);
+/* stop reading the capture block (before a suspend); process context */
+void h713_hdmirx_quiesce(struct h713_hdmirx *rx);
+/* after a resume: a stream that was running polls again */
+void h713_hdmirx_resume(struct h713_hdmirx *rx);
+#else
+static inline int h713_hdmirx_register(struct h713_drm *p, struct device *dev,
+				       struct h713_hdmirx **out)
+{
+	*out = NULL;
+	return 0;
+}
+
+static inline void h713_hdmirx_unregister(struct h713_hdmirx *rx) { }
+static inline void h713_hdmirx_source_change(struct h713_hdmirx *rx) { }
+static inline void h713_hdmirx_quiesce(struct h713_hdmirx *rx) { }
+static inline void h713_hdmirx_resume(struct h713_hdmirx *rx) { }
+#endif
+
+/* --- V4L2 part -> shell ---------------------------------------------------------------------- */
+
+struct h713_hdmi_status {
+	u32 state;		/* enum h713_hdmi_state */
+	u32 width, height;	/* the receiver's timing (0 without one) */
+	u32 refresh_mhz;
+	u32 ring_luma[3];	/* the ring slots (55 §8), physical */
+	u32 ring_chroma[3];
+};
+
+void h713_hdmi_status(struct h713_drm *p, struct h713_hdmi_status *st);
+/* a V4L2 user of the HDMI input (an open file) comes / goes; process context */
+void h713_hdmi_v4l2_user(struct h713_drm *p, bool get);
+/*
+ * CAP 0xa0c and 0x104 (55 §9) while the capture runs and the capture block may be read (spec 60);
+ * -EAGAIN otherwise; any context
+ */
+int h713_hdmi_ring_index(struct h713_drm *p, u32 *write_index, u32 *counter);
+/* the EDID the socket serves (spec 57): get into buf (len in/out, bytes) / set (len 0: hot-plug low) */
+int h713_hdmi_get_edid(struct h713_drm *p, u8 *buf, u32 *len);
+int h713_hdmi_set_edid(struct h713_drm *p, const u8 *buf, u32 len);
+struct drm_device *h713_hdmi_drm(struct h713_drm *p);
+
+#endif /* H713_HDMIRX_H */
