@@ -0,0 +1,327 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+//! User-control curves of `pq_custom.TSE`, table kind `0x9101f` (spec/40 §5, answers in 40 §7).
+//!
+//! - each sub-blob's u32 length counts its own 6-byte header (40 §7 Q-PQ-1);
+//! - each record's u32 length counts the whole record from its id on (Q-PQ-2);
+//! - each register entry ends with a signed byte = minus the bit position of the mask's lowest set
+//!   bit, the field's shift (Q-PQ-3); an entry with its constant flag set is refused, the data
+//!   shows no such entry;
+//! - curve results go into the field truncated toward zero (Q-PQ-4, measured);
+//! - the second sub-blob (`FeatureSet_0x0`) is carried as raw bytes (Q-PQ-5).
+//!
+//! No floating point (the kernel module shares this file): the curve points are IEEE
+//! single-precision numbers, decoded exactly into 16.16 fixed point ([`q16`]; every HY320 point is
+//! an integer), and the segment is evaluated in 64-bit integers. No panicking operation.
+#![deny(
+    clippy::indexing_slicing,
+    clippy::arithmetic_side_effects,
+    clippy::unwrap_used,
+    clippy::expect_used
+)]
+
+use super::reader::Reader;
+use super::{Error, ErrorKind, Result};
+
+const SUB_HEADER: usize = 6;
+const POINT_LEN: usize = 16;
+
+/// A validated user-control blob.
+#[derive(Clone, Copy, Debug)]
+pub struct UserControls<'a> {
+    /// Tag of the first sub-blob.
+    pub tag: u16,
+    pub count: u16,
+    names: &'a [u8],
+    records: &'a [u8],
+    /// The second sub-blob: (tag, bytes after its 6-byte header).
+    pub second: (u16, &'a [u8]),
+}
+
+/// One named control with its record.
+#[derive(Clone, Copy, Debug)]
+pub struct Control<'a> {
+    /// Name without the NUL.
+    pub name: &'a [u8],
+    pub id: u32,
+    pub record: Record<'a>,
+}
+
+/// One control record: flags and curve sets.
+#[derive(Clone, Copy, Debug)]
+pub struct Record<'a> {
+    pub id: u32,
+    pub flags: u8,
+    pub set_count: u16,
+    sets: &'a [u8],
+}
+
+/// One set: a piecewise-linear curve and the registers it drives.
+#[derive(Clone, Copy, Debug)]
+pub struct CurveSet<'a> {
+    pub curve: Curve<'a>,
+    pub reg_count: u16,
+    regs: &'a [u8],
+}
+
+/// A piecewise-linear curve: points of four big-endian IEEE floats (x0, x1, y0, y1).
+#[derive(Clone, Copy, Debug)]
+pub struct Curve<'a> {
+    pub point_count: u16,
+    points: &'a [u8],
+}
+
+/// One curve segment, in 16.16 fixed point.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Segment {
+    pub x0: i64,
+    pub x1: i64,
+    pub y0: i64,
+    pub y1: i64,
+}
+
+/// One register entry (kind 0).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct RegEntry {
+    pub kind: u8,
+    pub addr: u32,
+    pub width_bits: u8,
+    pub mask: u32,
+    /// The trailing signed byte: minus the field's shift (40 §7 Q-PQ-3).
+    pub shift_byte: i8,
+}
+
+/// One in 16.16 fixed point.
+pub const ONE: i64 = 1 << 16;
+
+/// An IEEE single-precision number (its bits) as 16.16 fixed point: exact for numbers with at most
+/// 16 fraction bits and a magnitude below 2^46, truncated toward zero beyond 16 fraction bits;
+/// `None` for infinities, NaN, denormals and larger magnitudes.
+pub fn q16(bits: u32) -> Option<i64> {
+    let neg = bits >> 31 != 0;
+    let exp = ((bits >> 23) & 0xff) as i32;
+    let man = (bits & 0x7f_ffff) as i64;
+    let v = match exp {
+        0 if man == 0 => 0,
+        0 | 255 => return None,
+        _ => {
+            let m = man | 0x80_0000;
+            // value = m x 2^(exp - 150); in 16.16: m x 2^(exp - 134).
+            let shift = exp.wrapping_sub(134);
+            if shift >= 0 {
+                if shift > 22 {
+                    return None;
+                }
+                m << shift
+            } else {
+                m.checked_shr(shift.unsigned_abs()).unwrap_or(0)
+            }
+        }
+    };
+    Some(if neg { v.wrapping_neg() } else { v })
+}
+
+fn be32(b: &[u8], o: usize) -> u32 {
+    o.checked_add(4)
+        .and_then(|e| b.get(o..e))
+        .and_then(|w| w.try_into().ok())
+        .map_or(0, u32::from_be_bytes)
+}
+
+impl<'a> Curve<'a> {
+    pub fn segments(&self) -> impl Iterator<Item = Segment> + 'a {
+        self.points.chunks_exact(POINT_LEN).filter_map(|p| {
+            Some(Segment {
+                x0: q16(be32(p, 0))?,
+                x1: q16(be32(p, 4))?,
+                y0: q16(be32(p, 8))?,
+                y1: q16(be32(p, 12))?,
+            })
+        })
+    }
+
+    /// 40 §5 evaluation for the user value `v`: the first segment with x0 <= v <= x1 gives
+    /// y0 + (v - x0)(y1 - y0)/(x1 - x0), truncated toward zero (40 §7 Q-PQ-4). `None` if no
+    /// segment covers `v`.
+    pub fn eval(&self, v: i32) -> Option<i32> {
+        let vq = (v as i64).checked_mul(ONE)?;
+        let s = self.segments().find(|s| s.x0 <= vq && vq <= s.x1)?;
+        let dx = s.x1.checked_sub(s.x0)?;
+        let yq = if dx == 0 {
+            s.y0
+        } else {
+            // (v - x0)(y1 - y0) is 32.32 (below 2^55 for the 0..1023 / 0..4095 ranges), / dx back
+            // to 16.16.
+            let num = vq.checked_sub(s.x0)?.checked_mul(s.y1.checked_sub(s.y0)?)?;
+            s.y0.checked_add(num.checked_div(dx)?)?
+        };
+        i32::try_from(yq / ONE).ok()
+    }
+}
+
+impl RegEntry {
+    /// Bit position of the mask's lowest set bit.
+    pub const fn shift(&self) -> u32 {
+        if self.mask == 0 {
+            0
+        } else {
+            self.mask.trailing_zeros()
+        }
+    }
+
+    /// The register value with `result` placed under the mask: two's complement for negative
+    /// results, shifted to the mask's lowest bit and masked; bits outside the mask keep `old` (40
+    /// §5).
+    pub const fn place(&self, old: u32, result: i32) -> u32 {
+        let field = (result as u32).wrapping_shl(self.shift()) & self.mask;
+        (old & !self.mask) | field
+    }
+}
+
+impl<'a> CurveSet<'a> {
+    pub fn regs(&self) -> impl Iterator<Item = RegEntry> + 'a {
+        let mut r = Reader::new(self.regs, 0);
+        (0..self.reg_count).map_while(move |_| parse_reg(&mut r).ok())
+    }
+}
+
+impl<'a> Record<'a> {
+    pub fn sets(&self) -> impl Iterator<Item = CurveSet<'a>> + 'a {
+        let mut r = Reader::new(self.sets, 0);
+        (0..self.set_count).map_while(move |_| parse_set(&mut r).ok())
+    }
+}
+
+fn parse_reg(r: &mut Reader<'_>) -> Result<RegEntry> {
+    let at = r.abs();
+    let kind = r.u8()?;
+    if kind != 0 {
+        return Err(Error::new(ErrorKind::Unsupported, at));
+    }
+    let addr = r.u32()?;
+    let width_bits = r.u8()?;
+    let mask = r.u32()?;
+    let flag_at = r.abs();
+    if r.u8()? != 0 {
+        // 40 §7 Q-PQ-3: the layout with the constant flag set is not shown by any data; refuse it.
+        return Err(Error::new(ErrorKind::Unsupported, flag_at));
+    }
+    let shift_byte = r.u8()? as i8;
+    Ok(RegEntry {
+        kind,
+        addr,
+        width_bits,
+        mask,
+        shift_byte,
+    })
+}
+
+fn parse_set<'a>(r: &mut Reader<'a>) -> Result<CurveSet<'a>> {
+    let point_count = r.u16()?;
+    let points = r.bytes((point_count as usize).saturating_mul(POINT_LEN))?;
+    let reg_count = r.u16()?;
+    let start = r.pos();
+    for _ in 0..reg_count {
+        parse_reg(r)?;
+    }
+    Ok(CurveSet {
+        curve: Curve {
+            point_count,
+            points,
+        },
+        reg_count,
+        regs: r.since(start),
+    })
+}
+
+fn parse_record<'a>(r: &mut Reader<'a>) -> Result<Record<'a>> {
+    let at = r.abs();
+    let id = r.u32()?;
+    let len = r.u32()? as usize;
+    let body_len = len
+        .checked_sub(8)
+        .ok_or(Error::new(ErrorKind::BadLength, at.saturating_add(4)))?;
+    let mut body = r.sub(body_len)?;
+    let flags = body.u8()?;
+    let set_count = body.u16()?;
+    let start = body.pos();
+    for _ in 0..set_count {
+        parse_set(&mut body)?;
+    }
+    let sets = body.since(start);
+    body.finish()?;
+    Ok(Record {
+        id,
+        flags,
+        set_count,
+        sets,
+    })
+}
+
+fn cstr<'a>(r: &mut Reader<'a>) -> Result<&'a [u8]> {
+    let start = r.pos();
+    while r.u8()? != 0 {}
+    let s = r.since(start);
+    Ok(s.split_last().map_or(&[][..], |(_, chars)| chars))
+}
+
+impl<'a> UserControls<'a> {
+    /// Parses and validates a `0x9101f` blob; both sub-blobs must end exactly where their lengths
+    /// say and the second must end at the blob's end.
+    pub fn parse(blob: &'a [u8]) -> Result<Self> {
+        let mut r = Reader::new(blob, 0);
+        let tag = r.u16()?;
+        let at = r.abs();
+        let len = r.u32()? as usize;
+        let mut s = r.sub(
+            len.checked_sub(SUB_HEADER)
+                .ok_or(Error::new(ErrorKind::BadLength, at))?,
+        )?;
+        let count = s.u16()?;
+        let names_start = s.pos();
+        for _ in 0..count {
+            cstr(&mut s)?;
+            s.u32()?;
+        }
+        let names = s.since(names_start);
+        let rec_start = s.pos();
+        for _ in 0..count {
+            parse_record(&mut s)?;
+        }
+        let records = s.since(rec_start);
+        s.finish()?;
+        let tag2 = r.u16()?;
+        let at2 = r.abs();
+        let len2 = r.u32()? as usize;
+        let second = (
+            tag2,
+            r.bytes(
+                len2.checked_sub(SUB_HEADER)
+                    .ok_or(Error::new(ErrorKind::BadLength, at2))?,
+            )?,
+        );
+        r.finish()?;
+        Ok(Self {
+            tag,
+            count,
+            names,
+            records,
+            second,
+        })
+    }
+
+    pub fn controls(&self) -> impl Iterator<Item = Control<'a>> + 'a {
+        let mut n = Reader::new(self.names, 0);
+        let mut rr = Reader::new(self.records, 0);
+        (0..self.count).map_while(move |_| {
+            let name = cstr(&mut n).ok()?;
+            let id = n.u32().ok()?;
+            let record = parse_record(&mut rr).ok()?;
+            Some(Control { name, id, record })
+        })
+    }
+
+    /// The control named `name` (without NUL).
+    pub fn find(&self, name: &[u8]) -> Option<Control<'a>> {
+        self.controls().find(|c| c.name == name)
+    }
+}
diff --git a/drivers/gpu/drm/h713/shared/h713-tse/reader.rs b/drivers/gpu/drm/h713/shared/h713-tse/reader.rs
new file mode 100644
index 000000000..2e2734b75
--- /dev/null
+++ b/drivers/gpu/drm/h713/shared/h713-tse/reader.rs
@@ -0,0 +1,183 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+//! Bounds-checked little-endian reader over a byte slice, and the crate's error type.
+//!
+//! Shared with the kernel module (`drivers/h713-drm`): no panicking operation (no indexing, no
+//! unchecked arithmetic), and only `super::` paths, so the file compiles as a submodule of another
+//! crate.
+#![deny(
+    clippy::indexing_slicing,
+    clippy::arithmetic_side_effects,
+    clippy::unwrap_used,
+    clippy::expect_used
+)]
+
+use core::fmt;
+
+/// What went wrong while parsing.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ErrorKind {
+    /// A field reaches past the end of its container, blob or file.
+    Truncated,
+    /// Magic bytes do not match (`TSE`, `logo`).
+    BadMagic,
+    /// TSE header length is not `0x1a` (40 §4.1).
+    BadHeaderLength,
+    /// A tagged record has an unexpected tag (40 §2: tag = the record's own header length).
+    BadTag { expected: u16, found: u16 },
+    /// A length or count field is inconsistent with the bytes around it.
+    BadLength,
+    /// A parse did not end exactly at the length of its container or blob (40 opening paragraph).
+    Trailing { remaining: usize },
+    /// A field holds a value the spec does not describe (e.g. index size other than 1).
+    Unsupported,
+    /// A name is not terminated by its NUL byte (40 §2).
+    BadName,
+    /// A byte the spec fixes (e.g. zero fill) holds another value.
+    BadValue,
+    /// A structure the spec locates by a pattern is not in the file.
+    NotFound,
+}
+
+/// Parse error with the byte offset (relative to the slice handed to the parser) where it was
+/// detected.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Error {
+    pub kind: ErrorKind,
+    pub offset: usize,
+}
+
+impl Error {
+    pub(crate) const fn new(kind: ErrorKind, offset: usize) -> Self {
+        Self { kind, offset }
+    }
+}
+
+impl fmt::Display for Error {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "{:?} at offset {:#x}", self.kind, self.offset)
+    }
+}
+
+/// Cursor over `buf`; every read is bounded by `buf.len()`.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct Reader<'a> {
+    buf: &'a [u8],
+    pos: usize,
+    /// Offset of `buf[0]` in the outermost slice, for error messages.
+    base: usize,
+}
+
+impl<'a> Reader<'a> {
+    pub(crate) const fn new(buf: &'a [u8], base: usize) -> Self {
+        Self { buf, pos: 0, base }
+    }
+
+    pub(crate) const fn pos(&self) -> usize {
+        self.pos
+    }
+
+    pub(crate) const fn remaining(&self) -> usize {
+        self.buf.len().saturating_sub(self.pos)
+    }
+
+    pub(crate) const fn abs(&self) -> usize {
+        self.base.saturating_add(self.pos)
+    }
+
+    pub(crate) fn err(&self, kind: ErrorKind) -> Error {
+        Error::new(kind, self.abs())
+    }
+
+    pub(crate) fn bytes(&mut self, n: usize) -> super::Result<&'a [u8]> {
+        let end = self
+            .pos
+            .checked_add(n)
+            .ok_or(self.err(ErrorKind::Truncated))?;
+        let s = self
+            .buf
+            .get(self.pos..end)
+            .ok_or(self.err(ErrorKind::Truncated))?;
+        self.pos = end;
+        Ok(s)
+    }
+
+    pub(crate) fn sub(&mut self, n: usize) -> super::Result<Reader<'a>> {
+        let base = self.abs();
+        Ok(Reader::new(self.bytes(n)?, base))
+    }
+
+    fn array<const N: usize>(&mut self) -> super::Result<[u8; N]> {
+        let at = self.abs();
+        self.bytes(N)?
+            .try_into()
+            .map_err(|_| Error::new(ErrorKind::Truncated, at))
+    }
+
+    pub(crate) fn u8(&mut self) -> super::Result<u8> {
+        Ok(u8::from_le_bytes(self.array()?))
+    }
+
+    pub(crate) fn u16(&mut self) -> super::Result<u16> {
+        Ok(u16::from_le_bytes(self.array()?))
+    }
+
+    pub(crate) fn u32(&mut self) -> super::Result<u32> {
+        Ok(u32::from_le_bytes(self.array()?))
+    }
+
+    /// A u32 count whose elements are at least `min_size` bytes each; rejects counts that cannot
+    /// fit.
+    pub(crate) fn count(&mut self, min_size: usize) -> super::Result<u32> {
+        let at = self.abs();
+        let n = self.u32()?;
+        if (n as usize).saturating_mul(min_size) > self.remaining() {
+            return Err(Error::new(ErrorKind::BadLength, at));
+        }
+        Ok(n)
+    }
+
+    /// Tagged-record header: u16 tag that must equal `expected` (40 §2).
+    pub(crate) fn tag(&mut self, expected: u16) -> super::Result<()> {
+        let at = self.abs();
+        let found = self.u16()?;
+        if found != expected {
+            return Err(Error::new(ErrorKind::BadTag { expected, found }, at));
+        }
+        Ok(())
+    }
+
+    /// "name": u8 length counting a trailing NUL, then the characters, then the NUL (40 §2).
+    /// Returns the characters without the NUL.
+    pub(crate) fn name(&mut self) -> super::Result<&'a [u8]> {
+        let at = self.abs();
+        let n = self.u8()? as usize;
+        let s = self.bytes(n)?;
+        match s.split_last() {
+            Some((0, chars)) => Ok(chars),
+            _ => Err(Error::new(ErrorKind::BadName, at)),
+        }
+    }
+
+    /// Fails unless every byte was consumed.
+    pub(crate) fn finish(&self) -> super::Result<()> {
+        if self.remaining() != 0 {
+            return Err(self.err(ErrorKind::Trailing {
+                remaining: self.remaining(),
+            }));
+        }
+        Ok(())
+    }
+
+    /// The bytes consumed since position `start` of this reader (empty if `start` is ahead).
+    pub(crate) fn since(&self, start: usize) -> &'a [u8] {
+        self.buf.get(start..self.pos).unwrap_or(&[])
+    }
+}
+
+/// Little-endian u32 at word index `i` of `b`; 0 when out of range (callers index validated data).
+pub(crate) fn le32(b: &[u8], i: usize) -> u32 {
+    i.checked_mul(4)
+        .and_then(|o| b.get(o..o.checked_add(4)?))
+        .and_then(|w| w.try_into().ok())
+        .map_or(0, u32::from_le_bytes)
+}
diff --git a/drivers/gpu/drm/h713/shared/h713-tse/regtable.rs b/drivers/gpu/drm/h713/shared/h713-tse/regtable.rs
new file mode 100644
index 000000000..aa61c8bf4
--- /dev/null
+++ b/drivers/gpu/drm/h713/shared/h713-tse/regtable.rs
@@ -0,0 +1,322 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+//! Register-table blobs, table kind `0x90007` (spec/40 §4.3).
+//!
+//! Head: u32 mode, u32 state count, u32 entry count. Each entry: a 13-byte header, `n` one-byte
+//! indices, the masks (big-endian; one per register, or one per register per state when mode = 1),
+//! the values (big-endian, one per register per state, register-major). The masks of a mode-1 table
+//! are taken register-major like the values (40 §7 Q-TSE-2).
+#![deny(
+    clippy::indexing_slicing,
+    clippy::arithmetic_side_effects,
+    clippy::unwrap_used,
+    clippy::expect_used
+)]
+
+use super::reader::Reader;
+use super::{Error, ErrorKind, Result};
+
+/// Size of an entry header (40 §4.3).
+pub const ENTRY_HEADER_LEN: usize = 13;
+/// The only entry type seen (40 §4.3); others are rejected.
+pub const ENTRY_TYPE: u8 = 6;
+/// Mode whose masks are per register per state (40 §4.3).
+pub const MODE_MASK_PER_STATE: u32 = 1;
+
+/// A parsed, validated register table.
+#[derive(Clone, Copy, Debug)]
+pub struct RegTable<'a> {
+    pub mode: u32,
+    pub state_count: u32,
+    pub entry_count: u32,
+    /// Total registers over all entries (writes per state).
+    pub register_count: u32,
+    entries: &'a [u8],
+    base: usize,
+}
+
+/// One register write of one state.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct TableWrite {
+    pub addr: u32,
+    /// Access width in bytes (1, 2 or 4).
+    pub width: u8,
+    pub mask: u32,
+    pub value: u32,
+}
+
+impl TableWrite {
+    /// All ones for the access width.
+    pub const fn full_mask(&self) -> u32 {
+        match self.width {
+            1 => 0xff,
+            2 => 0xffff,
+            _ => 0xffff_ffff,
+        }
+    }
+
+    /// A mask of all ones for the width is a plain write (40 §4.3 write rule).
+    pub const fn is_plain(&self) -> bool {
+        self.mask == self.full_mask()
+    }
+
+    /// The register's new value given its old value: plain write, or `(old AND NOT mask) OR (value
+    /// AND mask)`; value bits outside the mask are not applied (40 §4.3).
+    pub const fn apply(&self, old: u32) -> u32 {
+        if self.is_plain() {
+            self.value
+        } else {
+            (old & !self.mask) | (self.value & self.mask)
+        }
+    }
+}
+
+/// One entry: a run of registers sharing a base address and width.
+#[derive(Clone, Copy, Debug)]
+pub struct Entry<'a> {
+    pub entry_type: u8,
+    pub index_size: u8,
+    pub width: u8,
+    /// Base address (bits 31:8 from the header, low byte 0).
+    pub base: u32,
+    /// Header bytes 6..8 (meaning not in the spec).
+    pub unknown: [u8; 3],
+    pub count: u32,
+    mode: u32,
+    states: u32,
+    indices: &'a [u8],
+    masks: &'a [u8],
+    values: &'a [u8],
+}
+
+/// Big-endian value `i` of width `w` in `b` (0 when out of range; callers index validated data).
+fn be(b: &[u8], i: usize, w: usize) -> u32 {
+    let field = i
+        .checked_mul(w)
+        .and_then(|o| b.get(o..o.checked_add(w)?))
+        .unwrap_or(&[]);
+    field.iter().fold(0u32, |acc, &x| (acc << 8) | x as u32)
+}
+
+/// Value index `k * states + state` (register-major), saturating (out of range reads 0).
+fn idx(k: u32, states: u32, state: u32) -> usize {
+    (k as usize)
+        .saturating_mul(states as usize)
+        .saturating_add(state as usize)
+}
+
+impl<'a> Entry<'a> {
+    /// Address of register `k` of this entry: base + index x width.
+    pub fn addr(&self, k: u32) -> u32 {
+        let i = self.indices.get(k as usize).copied().unwrap_or(0) as u32;
+        self.base.wrapping_add(i.wrapping_mul(self.width as u32))
+    }
+
+    /// Mask of register `k` in state `state`.
+    pub fn mask(&self, k: u32, state: u32) -> u32 {
+        let w = self.width as usize;
+        if self.mode == MODE_MASK_PER_STATE {
+            be(self.masks, idx(k, self.states, state), w)
+        } else {
+            be(self.masks, k as usize, w)
+        }
+    }
+
+    /// Value of register `k` in state `state` (register-major).
+    pub fn value(&self, k: u32, state: u32) -> u32 {
+        be(self.values, idx(k, self.states, state), self.width as usize)
+    }
+
+    pub fn write(&self, k: u32, state: u32) -> TableWrite {
+        TableWrite {
+            addr: self.addr(k),
+            width: self.width,
+            mask: self.mask(k, state),
+            value: self.value(k, state),
+        }
+    }
+}
+
+impl<'a> RegTable<'a> {
+    /// Parses and validates a register-table blob; the walk must end exactly at the blob length.
+    pub fn parse(blob: &'a [u8]) -> Result<Self> {
+        Self::parse_at(blob, 0)
+    }
+
+    /// As [`RegTable::parse`], with `base` = offset of the blob in its file (error offsets only).
+    pub fn parse_at(blob: &'a [u8], base: usize) -> Result<Self> {
+        let mut r = Reader::new(blob, base);
+        let mode = r.u32()?;
+        let state_count = r.u32()?;
+        let entry_count = r.count(ENTRY_HEADER_LEN)?;
+        if state_count == 0 {
+            return Err(Error::new(ErrorKind::BadLength, base.saturating_add(4)));
+        }
+        let start = r.pos();
+        let entries_base = r.abs();
+        let mut register_count = 0u32;
+        for _ in 0..entry_count {
+            let e = parse_entry(&mut r, mode, state_count)?;
+            register_count = register_count
+                .checked_add(e.count)
+                .ok_or(Error::new(ErrorKind::BadLength, base))?;
+        }
+        let entries = r.since(start);
+        r.finish()?;
+        Ok(Self {
+            mode,
+            state_count,
+            entry_count,
+            register_count,
+            entries,
+            base: entries_base,
+        })
+    }
+
+    pub fn entries(&self) -> Entries<'a> {
+        Entries {
+            r: Reader::new(self.entries, self.base),
+            left: self.entry_count,
+            mode: self.mode,
+            states: self.state_count,
+        }
+    }
+
+    /// The writes of state `state` (0-based column), in file order. `None` if the state does not
+    /// exist.
+    pub fn writes(&self, state: u32) -> Option<Writes<'a>> {
+        if state >= self.state_count {
+            return None;
+        }
+        Some(Writes {
+            entries: self.entries(),
+            cur: None,
+            k: 0,
+            state,
+        })
+    }
+}
+
+fn parse_entry<'a>(r: &mut Reader<'a>, mode: u32, states: u32) -> Result<Entry<'a>> {
+    let at = r.abs();
+    let h: [u8; ENTRY_HEADER_LEN] = r
+        .bytes(ENTRY_HEADER_LEN)?
+        .try_into()
+        .map_err(|_| Error::new(ErrorKind::Truncated, at))?;
+    let [entry_type, index_size, width, b3, b2, b1, u0, u1, u2, c0, c1, c2, c3] = h;
+    if entry_type != ENTRY_TYPE || index_size != 1 || !matches!(width, 1 | 2 | 4) {
+        return Err(Error::new(ErrorKind::Unsupported, at));
+    }
+    let base = u32::from_be_bytes([b3, b2, b1, 0]);
+    let unknown = [u0, u1, u2];
+    let count = u32::from_le_bytes([c0, c1, c2, c3]);
+    let n = count as usize;
+    let w = width as usize;
+    let bad = Error::new(ErrorKind::BadLength, at);
+    let indices = r.bytes(n)?;
+    let nvals = n.checked_mul(states as usize).ok_or(bad)?;
+    let nmask = if mode == MODE_MASK_PER_STATE {
+        nvals
+    } else {
+        n
+    };
+    let masks = r.bytes(nmask.checked_mul(w).ok_or(bad)?)?;
+    let values = r.bytes(nvals.checked_mul(w).ok_or(bad)?)?;
+    Ok(Entry {
+        entry_type,
+        index_size,
+        width,
+        base,
+        unknown,
+        count,
+        mode,
+        states,
+        indices,
+        masks,
+        values,
+    })
+}
+
+/// Iterator over the entries of a validated table.
+#[derive(Clone, Debug)]
+pub struct Entries<'a> {
+    r: Reader<'a>,
+    left: u32,
+    mode: u32,
+    states: u32,
+}
+
+impl<'a> Iterator for Entries<'a> {
+    type Item = Entry<'a>;
+
+    fn next(&mut self) -> Option<Self::Item> {
+        if self.left == 0 {
+            return None;
+        }
+        self.left = self.left.saturating_sub(1);
+        // Validated in RegTable::parse.
+        parse_entry(&mut self.r, self.mode, self.states).ok()
+    }
+}
+
+/// Iterator over the writes of one state, file order.
+#[derive(Clone, Debug)]
+pub struct Writes<'a> {
+    entries: Entries<'a>,
+    cur: Option<Entry<'a>>,
+    k: u32,
+    state: u32,
+}
+
+impl Iterator for Writes<'_> {
+    type Item = TableWrite;
+
+    fn next(&mut self) -> Option<TableWrite> {
+        loop {
+            if let Some(e) = &self.cur {
+                if self.k < e.count {
+                    let w = e.write(self.k, self.state);
+                    self.k = self.k.saturating_add(1);
+                    return Some(w);
+                }
+            }
+            self.cur = Some(self.entries.next()?);
+            self.k = 0;
+        }
+    }
+}
+
+impl<'a> super::tse::Module<'a> {
+    /// The module's register table (table kind `0x90007`, first blob), validated. Its state columns
+    /// follow the module's state records in file order (both counts are equal in every HY320 table;
+    /// checked here).
+    pub fn reg_table(&self) -> Result<RegTable<'a>> {
+        let blob = self
+            .blobs()
+            .next()
+            .ok_or(Error::new(ErrorKind::BadLength, 0))??;
+        if self.table_kind != super::kind::REGISTER_TABLE {
+            return Err(Error::new(ErrorKind::Unsupported, blob.offset));
+        }
+        let t = RegTable::parse_at(blob.data, blob.offset)?;
+        if t.state_count != self.state_count {
+            return Err(Error::new(
+                ErrorKind::BadLength,
+                blob.offset.saturating_add(4),
+            ));
+        }
+        Ok(t)
+    }
+
+    /// Index of the first state whose attribute list holds the attribute word `word` (type in the
+    /// upper 16 bits, 40 §4.1).
+    pub fn state_with_attr(&self, word: u32) -> Option<u32> {
+        let mut i = 0u32;
+        for s in self.states() {
+            if s.is_ok_and(|s| s.attrs.has_word(word)) {
+                return Some(i);
+            }
+            i = i.saturating_add(1);
+        }
+        None
+    }
+}
diff --git a/drivers/gpu/drm/h713/shared/h713-tse/tse.rs b/drivers/gpu/drm/h713/shared/h713-tse/tse.rs
new file mode 100644
index 000000000..0480c579a
--- /dev/null
+++ b/drivers/gpu/drm/h713/shared/h713-tse/tse.rs
@@ -0,0 +1,706 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+//! TSE containers and their group / module / state / attribute records (spec/40 §4.1).
+//!
+//! A file is containers back to back; the walk goes on until the file ends. Container types 0, 1, 2
+//! and 5 carry groups; types 3 (attribute-name strings) and 6 are skipped by their length, type 4
+//! holds the colour-space rows read by [`super::colorspace`] (40 §7 Q-TSE-5).
+//!
+//! The header field at `0x10` is the number of zero bytes between the end of the last group and the
+//! container length (40 §4.1, §7 Q-TSE-1); the group walk must end exactly there and those bytes
+//! must be zero. A group's first module count has no known meaning (Q-TSE-3); the count after the
+//! name is followed.
+#![deny(
+    clippy::indexing_slicing,
+    clippy::arithmetic_side_effects,
+    clippy::unwrap_used,
+    clippy::expect_used
+)]
+
+use super::reader::{le32, Reader};
+use super::{Error, ErrorKind, Result};
+
+/// Length of the TSE header (40 §4.1: "header length, always `0x1a`").
+pub const HEADER_LEN: usize = 0x1a;
+
+/// Container types (40 §4.1 offset `0x03`).
+pub mod container_type {
+    pub const DATABASE: u8 = 0;
+    pub const DATABASE_PART2: u8 = 1;
+    pub const PROJECT: u8 = 2;
+    pub const FURTHER_3: u8 = 3;
+    pub const FURTHER_4: u8 = 4;
+    pub const USER_CONTROLS: u8 = 5;
+    pub const PROJECT_TABLE: u8 = 6;
+}
+
+/// Group kinds (40 §4.1 group record).
+pub mod group_kind {
+    pub const DATABASE: u8 = 0;
+    pub const DATABASE_PART2: u8 = 1;
+    pub const PROJECT: u8 = 2;
+    pub const USER_CONTROL: u8 = 3;
+}
+
+const TAG_GROUP: u16 = 17;
+const TAG_MODULE: u16 = 13;
+const TAG_STATE: u16 = 8;
+const TAG_ATTRS: u16 = 4;
+
+/// Attribute type 0 marks an unconditional state (40 §4.1).
+pub const ATTR_UNCONDITIONAL: u16 = 0;
+
+/// One TSE container (40 §4.1 header).
+#[derive(Clone, Copy, Debug)]
+pub struct Container<'a> {
+    /// Offset of the container in the file.
+    pub offset: usize,
+    /// Container type (`container_type`).
+    pub kind: u8,
+    pub version: u32,
+    pub timestamp: u32,
+    /// Project id (0 for database containers).
+    pub project_id: u16,
+    /// Header field at `0x10`: zero fill bytes after the last group (40 §4.1).
+    pub pad: u16,
+    /// Container length including the header.
+    pub length: u32,
+    /// Check field (its algorithm is not part of the spec; carried, not verified).
+    pub check: u32,
+    raw: &'a [u8],
+}
+
+impl<'a> Container<'a> {
+    /// Parses the container that starts at `file[offset..]`.
+    pub fn parse(file: &'a [u8], offset: usize) -> Result<Self> {
+        let rest = file
+            .get(offset..)
+            .ok_or(Error::new(ErrorKind::Truncated, offset))?;
+        let mut r = Reader::new(rest, offset);
+        if r.bytes(3)? != b"TSE" {
+            return Err(Error::new(ErrorKind::BadMagic, offset));
+        }
+        let kind = r.u8()?;
+        if r.u16()? as usize != HEADER_LEN {
+            return Err(Error::new(
+                ErrorKind::BadHeaderLength,
+                offset.saturating_add(4),
+            ));
+        }
+        let version = r.u32()?;
+        let timestamp = r.u32()?;
+        let project_id = r.u16()?;
+        let pad = r.u16()?;
+        let length = r.u32()?;
+        let check = r.u32()?;
+        let len = length as usize;
+        let bad = Error::new(ErrorKind::BadLength, offset.saturating_add(0x12));
+        if len < HEADER_LEN.saturating_add(pad as usize) {
+            return Err(bad);
+        }
+        let raw = rest.get(..len).ok_or(bad)?;
+        Ok(Self {
+            offset,
+            kind,
+            version,
+            timestamp,
+            project_id,
+            pad,
+            length,
+            check,
+            raw,
+        })
+    }
+
+    /// The whole container, header included.
+    pub fn raw(&self) -> &'a [u8] {
+        self.raw
+    }
+
+    /// The bytes after the header, up to the container length.
+    pub fn body(&self) -> &'a [u8] {
+        self.raw.get(HEADER_LEN..).unwrap_or(&[])
+    }
+
+    /// Whether the body is a group list (container types 0, 1, 2, 5; 40 §4.1).
+    pub fn has_groups(&self) -> bool {
+        matches!(
+            self.kind,
+            container_type::DATABASE
+                | container_type::DATABASE_PART2
+                | container_type::PROJECT
+                | container_type::USER_CONTROLS
+        )
+    }
+
+    /// The group list. Fails with `Unsupported` for container types without groups.
+    pub fn groups(&self) -> Result<Groups<'a>> {
+        if !self.has_groups() {
+            return Err(Error::new(
+                ErrorKind::Unsupported,
+                self.offset.saturating_add(3),
+            ));
+        }
+        let end = self.raw.len().saturating_sub(self.pad as usize);
+        let body = self
+            .raw
+            .get(HEADER_LEN..end)
+            .ok_or(Error::new(ErrorKind::BadLength, self.offset))?;
+        let mut r = Reader::new(body, self.offset.saturating_add(HEADER_LEN));
+        let count = r.count(19)?;
+        Ok(Groups { r, left: count })
+    }
+
+    /// Walks every group, module, state, blob and attribute list and checks that the walk ends
+    /// exactly at the container length minus the fill, and that the fill bytes are zero. Returns
+    /// (groups, modules).
+    pub fn validate(&self) -> Result<(u32, u32)> {
+        let fill_at = self.raw.len().saturating_sub(self.pad as usize);
+        let fill = self.raw.get(fill_at..).unwrap_or(&[]);
+        let mut at = self.offset.saturating_add(fill_at);
+        for &b in fill {
+            if b != 0 {
+                return Err(Error::new(ErrorKind::BadValue, at));
+            }
+            at = at.saturating_add(1);
+        }
+        let mut groups = self.groups()?;
+        let (mut ng, mut nm) = (0u32, 0u32);
+        for g in groups.by_ref() {
+            let g = g?;
+            ng = ng.saturating_add(1);
+            for m in g.modules() {
+                m?;
+                nm = nm.saturating_add(1);
+            }
+        }
+        groups.r.finish()?;
+        Ok((ng, nm))
+    }
+}
+
+/// Iterator over the containers of a file; stops after the first error.
+#[derive(Clone, Debug)]
+pub struct Containers<'a> {
+    file: &'a [u8],
+    pos: usize,
+    failed: bool,
+}
+
+/// All containers of a TSE file, back to back until the file ends (40 §4.1).
+pub fn containers(file: &[u8]) -> Containers<'_> {
+    Containers {
+        file,
+        pos: 0,
+        failed: false,
+    }
+}
+
+impl<'a> Iterator for Containers<'a> {
+    type Item = Result<Container<'a>>;
+
+    fn next(&mut self) -> Option<Self::Item> {
+        if self.failed || self.pos >= self.file.len() {
+            return None;
+        }
+        match Container::parse(self.file, self.pos) {
+            Ok(c) => {
+                self.pos = self.pos.saturating_add(c.length as usize);
+                Some(Ok(c))
+            }
+            Err(e) => {
+                self.failed = true;
+                Some(Err(e))
+            }
+        }
+    }
+}
+
+/// One group record (40 §4.1, tag 17).
+#[derive(Clone, Copy, Debug)]
+pub struct Group<'a> {
+    /// Module count of the record header. Can differ from [`Group::module_count`] (HY320
+    /// `SYSTEM_INIT_SVP`: 10 vs 6); its meaning is not known (40 §7 Q-TSE-3); the second count is
+    /// the one the modules follow.
+    pub header_module_count: u32,
+    pub id: u32,
+    /// Group kind (`group_kind`).
+    pub kind: u8,
+    pub project_id: u16,
+    /// Name without its NUL.
+    pub name: &'a [u8],
+    /// Module count after the name: the number of module records that follow.
+    pub module_count: u32,
+    modules_raw: &'a [u8],
+    modules_base: usize,
+}
+
+impl<'a> Group<'a> {
+    pub fn modules(&self) -> Modules<'a> {
+        Modules {
+            r: Reader::new(self.modules_raw, self.modules_base),
+            left: self.module_count,
+        }
+    }
+}
+
+/// Iterator over the groups of a container.
+#[derive(Clone, Debug)]
+pub struct Groups<'a> {
+    r: Reader<'a>,
+    left: u32,
+}
+
+impl<'a> Iterator for Groups<'a> {
+    type Item = Result<Group<'a>>;
+
+    fn next(&mut self) -> Option<Self::Item> {
+        if self.left == 0 {
+            return None;
+        }
+        self.left = self.left.saturating_sub(1);
+        let g = parse_group(&mut self.r);
+        if g.is_err() {
+            self.left = 0;
+        }
+        Some(g)
+    }
+}
+
+fn record_version(r: &mut Reader<'_>) -> Result<()> {
+    let at = r.abs();
+    if r.u16()? != 1 {
+        return Err(Error::new(ErrorKind::Unsupported, at));
+    }
+    Ok(())
+}
+
+fn parse_group<'a>(r: &mut Reader<'a>) -> Result<Group<'a>> {
+    r.tag(TAG_GROUP)?;
+    record_version(r)?;
+    let header_module_count = r.u32()?;
+    let id = r.u32()?;
+    let kind = r.u8()?;
+    let project_id = r.u16()?;
+    let _padding = r.u16()?;
+    let name = r.name()?;
+    let module_count = r.count(14)?;
+    let start = r.pos();
+    let base = r.abs();
+    for _ in 0..module_count {
+        parse_module(r)?;
+    }
+    Ok(Group {
+        header_module_count,
+        id,
+        kind,
+        project_id,
+        name,
+        module_count,
+        modules_raw: r.since(start),
+        modules_base: base,
+    })
+}
+
+/// One module record (40 §4.1, tag 13): a table with its states, blobs and attribute list.
+#[derive(Clone, Copy, Debug)]
+pub struct Module<'a> {
+    /// State count of the record header.
+    pub header_state_count: u32,
+    /// The numeric handle (40 §4.2 "handle").
+    pub handle: u32,
+    /// The "always" byte (40 §4.2).
+    pub always: u8,
+    pub name: &'a [u8],
+    /// State count after the name: the number of state records that follow.
+    pub state_count: u32,
+    /// Table kind (`super::kind`).
+    pub table_kind: u32,
+    pub blob_count: u32,
+    states_raw: &'a [u8],
+    states_base: usize,
+    blobs_raw: &'a [u8],
+    blobs_base: usize,
+    /// The module's trailing attribute list.
+    pub attrs: AttrList<'a>,
+}
+
+impl<'a> Module<'a> {
+    pub fn states(&self) -> States<'a> {
+        States {
+            r: Reader::new(self.states_raw, self.states_base),
+            left: self.state_count,
+        }
+    }
+
+    /// State number `index` (0-based, file order).
+    pub fn state(&self, index: u32) -> Option<State<'a>> {
+        self.states().nth(index as usize).and_then(|s| s.ok())
+    }
+
+    pub fn blobs(&self) -> Blobs<'a> {
+        Blobs {
+            r: Reader::new(self.blobs_raw, self.blobs_base),
+            left: self.blob_count,
+        }
+    }
+
+    /// The first blob, the one every HY320 table carries (each module has exactly one blob there).
+    pub fn first_blob(&self) -> Option<Blob<'a>> {
+        self.blobs().next().and_then(|b| b.ok())
+    }
+}
+
+/// Iterator over the modules of a group.
+#[derive(Clone, Debug)]
+pub struct Modules<'a> {
+    r: Reader<'a>,
+    left: u32,
+}
+
+impl<'a> Iterator for Modules<'a> {
+    type Item = Result<Module<'a>>;
+
+    fn next(&mut self) -> Option<Self::Item> {
+        if self.left == 0 {
+            return None;
+        }
+        self.left = self.left.saturating_sub(1);
+        let m = parse_module(&mut self.r);
+        if m.is_err() {
+            self.left = 0;
+        }
+        Some(m)
+    }
+}
+
+fn parse_module<'a>(r: &mut Reader<'a>) -> Result<Module<'a>> {
+    r.tag(TAG_MODULE)?;
+    record_version(r)?;
+    let header_state_count = r.u32()?;
+    let handle = r.u32()?;
+    let always = r.u8()?;
+    let name = r.name()?;
+    let state_count = r.count(14)?;
+    let states_start = r.pos();
+    let states_base = r.abs();
+    for _ in 0..state_count {
+        parse_state(r)?;
+    }
+    let states_raw = r.since(states_start);
+    let table_kind = r.u32()?;
+    let blob_count = r.count(8)?;
+    let blobs_start = r.pos();
+    let blobs_base = r.abs();
+    for _ in 0..blob_count {
+        parse_blob(r)?;
+    }
+    let blobs_raw = r.since(blobs_start);
+    let attrs = parse_attrs(r)?;
+    Ok(Module {
+        header_state_count,
+        handle,
+        always,
+        name,
+        state_count,
+        table_kind,
+        blob_count,
+        states_raw,
+        states_base,
+        blobs_raw,
+        blobs_base,
+        attrs,
+    })
+}
+
+/// One state record (40 §4.1, tag 8).
+#[derive(Clone, Copy, Debug)]
+pub struct State<'a> {
+    pub id: u16,
+    pub extra: u16,
+    pub attrs: AttrList<'a>,
+}
+
+/// Iterator over the states of a module.
+#[derive(Clone, Debug)]
+pub struct States<'a> {
+    r: Reader<'a>,
+    left: u32,
+}
+
+impl<'a> Iterator for States<'a> {
+    type Item = Result<State<'a>>;
+
+    fn next(&mut self) -> Option<Self::Item> {
+        if self.left == 0 {
+            return None;
+        }
+        self.left = self.left.saturating_sub(1);
+        let s = parse_state(&mut self.r);
+        if s.is_err() {
+            self.left = 0;
+        }
+        Some(s)
+    }
+}
+
+fn parse_state<'a>(r: &mut Reader<'a>) -> Result<State<'a>> {
+    r.tag(TAG_STATE)?;
+    record_version(r)?;
+    let id = r.u16()?;
+    let extra = r.u16()?;
+    let attrs = parse_attrs(r)?;
+    Ok(State { id, extra, attrs })
+}
+
+/// One blob: u32 type, u32 size, bytes (40 §4.1).
+#[derive(Clone, Copy, Debug)]
+pub struct Blob<'a> {
+    pub ty: u32,
+    pub data: &'a [u8],
+    /// Offset of `data` in the file.
+    pub offset: usize,
+}
+
+/// Iterator over the blobs of a module.
+#[derive(Clone, Debug)]
+pub struct Blobs<'a> {
+    r: Reader<'a>,
+    left: u32,
+}
+
+impl<'a> Iterator for Blobs<'a> {
+    type Item = Result<Blob<'a>>;
+
+    fn next(&mut self) -> Option<Self::Item> {
+        if self.left == 0 {
+            return None;
+        }
+        self.left = self.left.saturating_sub(1);
+        let b = parse_blob(&mut self.r);
+        if b.is_err() {
+            self.left = 0;
+        }
+        Some(b)
+    }
+}
+
+fn parse_blob<'a>(r: &mut Reader<'a>) -> Result<Blob<'a>> {
+    let ty = r.u32()?;
+    let size = r.u32()? as usize;
+    let offset = r.abs();
+    let data = r.bytes(size)?;
+    Ok(Blob { ty, data, offset })
+}
+
+/// Attribute list (40 §4.1, tag 4): entries of (u16 type, u32 value count, values).
+#[derive(Clone, Copy, Debug)]
+pub struct AttrList<'a> {
+    pub count: u32,
+    raw: &'a [u8],
+}
+
+/// One attribute entry. Values carry their type in the upper 16 bits (40 §4.1).
+#[derive(Clone, Copy, Debug)]
+pub struct Attr<'a> {
+    pub ty: u16,
+    values: &'a [u8],
+}
+
+impl<'a> Attr<'a> {
+    pub fn len(&self) -> usize {
+        self.values.len() / 4
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.values.is_empty()
+    }
+
+    pub fn value(&self, i: usize) -> u32 {
+        le32(self.values, i)
+    }
+
+    pub fn values(&self) -> impl Iterator<Item = u32> + 'a {
+        let v = self.values;
+        (0..v.len() / 4).map(move |i| le32(v, i))
+    }
+
+    pub fn contains(&self, value: u32) -> bool {
+        self.values().any(|v| v == value)
+    }
+}
+
+impl<'a> AttrList<'a> {
+    pub fn iter(&self) -> AttrIter<'a> {
+        AttrIter {
+            raw: self.raw,
+            pos: 0,
+            left: self.count,
+        }
+    }
+
+    /// The entry of attribute type `ty`, if present.
+    pub fn get(&self, ty: u16) -> Option<Attr<'a>> {
+        self.iter().find(|a| a.ty == ty)
+    }
+
+    /// Whether the list is the unconditional marker (a single type-0 entry, 40 §4.1).
+    pub fn is_unconditional(&self) -> bool {
+        self.iter().all(|a| a.ty == ATTR_UNCONDITIONAL)
+    }
+
+    /// Whether some entry holds the full attribute word `word` (type in the upper 16 bits).
+    pub fn has_word(&self, word: u32) -> bool {
+        self.iter()
+            .any(|a| a.ty == (word >> 16) as u16 && a.contains(word))
+    }
+}
+
+/// Iterator over attribute entries (already validated when the list was parsed).
+#[derive(Clone, Debug)]
+pub struct AttrIter<'a> {
+    raw: &'a [u8],
+    pos: usize,
+    left: u32,
+}
+
+impl<'a> Iterator for AttrIter<'a> {
+    type Item = Attr<'a>;
+
+    fn next(&mut self) -> Option<Self::Item> {
+        if self.left == 0 {
+            return None;
+        }
+        self.left = self.left.saturating_sub(1);
+        // Validated in parse_attrs; a short read ends the iteration.
+        let mut r = Reader::new(self.raw.get(self.pos..)?, 0);
+        let ty = r.u16().ok()?;
+        let n = r.u32().ok()? as usize;
+        let values = r.bytes(n.checked_mul(4)?).ok()?;
+        self.pos = self.pos.saturating_add(r.pos());
+        Some(Attr { ty, values })
+    }
+}
+
+fn parse_attrs<'a>(r: &mut Reader<'a>) -> Result<AttrList<'a>> {
+    r.tag(TAG_ATTRS)?;
+    record_version(r)?;
+    let count = r.count(6)?;
+    let start = r.pos();
+    for _ in 0..count {
+        let _ty = r.u16()?;
+        let n = r.count(4)?;
+        r.bytes((n as usize).saturating_mul(4))?;
+    }
+    Ok(AttrList {
+        count,
+        raw: r.since(start),
+    })
+}
+
+/// A module found in a file, with the group and container that hold it.
+#[derive(Clone, Copy, Debug)]
+pub struct Found<'a> {
+    pub container: Container<'a>,
+    pub group: Group<'a>,
+    pub module: Module<'a>,
+}
+
+/// Iterator over every module of every group-carrying container of a file, in file order.
+pub struct AllModules<'a> {
+    containers: Containers<'a>,
+    container: Option<Container<'a>>,
+    groups: Option<Groups<'a>>,
+    group: Option<Group<'a>>,
+    modules: Option<Modules<'a>>,
+    failed: bool,
+}
+
+/// Every module of `file` (all containers of types 0, 1, 2, 5), in file order.
+pub fn all_modules(file: &[u8]) -> AllModules<'_> {
+    AllModules {
+        containers: containers(file),
+        container: None,
+        groups: None,
+        group: None,
+        modules: None,
+        failed: false,
+    }
+}
+
+impl<'a> AllModules<'a> {
+    fn fail(&mut self, e: Error) -> Option<Result<Found<'a>>> {
+        self.failed = true;
+        Some(Err(e))
+    }
+}
+
+impl<'a> Iterator for AllModules<'a> {
+    type Item = Result<Found<'a>>;
+
+    fn next(&mut self) -> Option<Self::Item> {
+        loop {
+            if self.failed {
+                return None;
+            }
+            if let (Some(c), Some(g), Some(ms)) =
+                (self.container, self.group, self.modules.as_mut())
+            {
+                match ms.next() {
+                    Some(Ok(module)) => {
+                        return Some(Ok(Found {
+                            container: c,
+                            group: g,
+                            module,
+                        }))
+                    }
+                    Some(Err(e)) => return self.fail(e),
+                    None => self.modules = None,
+                }
+            }
+            if let Some(gs) = self.groups.as_mut() {
+                match gs.next() {
+                    Some(Ok(g)) => {
+                        self.modules = Some(g.modules());
+                        self.group = Some(g);
+                        continue;
+                    }
+                    Some(Err(e)) => return self.fail(e),
+                    None => self.groups = None,
+                }
+            }
+            match self.containers.next()? {
+                Ok(c) if c.has_groups() => match c.groups() {
+                    Ok(gs) => {
+                        self.container = Some(c);
+                        self.groups = Some(gs);
+                    }
+                    Err(e) => return self.fail(e),
+                },
+                Ok(_) => {}
+                Err(e) => return self.fail(e),
+            }
+        }
+    }
+}
+
+/// The module with numeric handle `handle` (40 §4.2), searched over all containers of `file`.
+pub fn find_module(file: &[u8], handle: u32) -> Result<Option<Found<'_>>> {
+    for f in all_modules(file) {
+        let f = f?;
+        if f.module.handle == handle {
+            return Ok(Some(f));
+        }
+    }
+    Ok(None)
+}
+
+/// The module whose group and module names (without NUL) are `group` and `module` (40 §4.2 keys).
+pub fn find_by_key<'a>(file: &'a [u8], group: &[u8], module: &[u8]) -> Result<Option<Found<'a>>> {
+    for f in all_modules(file) {
+        let f = f?;
+        if f.group.name == group && f.module.name == module {
+            return Ok(Some(f));
+        }
+    }
+    Ok(None)
+}
diff --git a/drivers/gpu/drm/h713/shared/h713-vp/align.rs b/drivers/gpu/drm/h713/shared/h713-vp/align.rs
new file mode 100644
index 000000000..10a4e5b18
--- /dev/null
+++ b/drivers/gpu/drm/h713/shared/h713-vp/align.rs
@@ -0,0 +1,501 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+//! Lining up the RGB plane's raster with the video plane's raster (spec/05 §2.1).
+//!
+//! The two planes run on two rasters of the same totals (2200 x 1125) and rate; the RGB plane's
+//! position over the video plane is their phase difference, in whole rows and columns (B1, B2).
+//! What moves it, as measured (B4):
+//!
+//! - one RGB frame with the vertical total 1125 + c, c = 25..100, written to `RASTER 0x0525c000`
+//!   right after one RGB done and restored right after the next: the image moves by exactly c rows,
+//!   the columns unchanged;
+//! - one frame with the horizontal total 2199 or 2201: the image moves by 1125 columns one way or
+//!   the other (to within 2 columns); combined with row moves this reaches a lattice of gcd(1125,
+//!   2200) = 25 columns;
+//! - the horizontal total is used line by line (B9): 2201 or 2199 for m lines, written right after
+//!   the video line counter `PNL 0x051c0174` stepped, moves the image by m - 2 .. m columns - but
+//!   some windows make the RGB raster jump by 65536 pixel clocks instead (30 rows, 464 columns; the
+//!   delay changes by about 0.41 ms), so every window is checked by the delay and undone by the row
+//!   and lattice steps when it jumped.
+//!
+//! What reads it: the time from the video vsync to the next RGB done gives the offset to about one
+//! line (B3, B8, B11: 13.785 ms aligned at 1920x1080, 13.772 ms at 1280x720 scaled, B10); only the
+//! histogram sees columns.
+//!
+//! [`align`] therefore does (each part bounded):
+//! 1. rows by timing (always): measure the delay, move the RGB raster by the missing lines, repeat
+//!    until the delay is within the tolerance of 95 S1-T6 (+/- 0.014 ms) or the iterations run out;
+//! 2. with `calibrate` (optional; it shows the driver's own test frames for a few seconds): columns
+//!    by the histogram - a white band of rows over the black video frame shows |column error|
+//!    exactly whatever the row error within +/- 100 rows; the column error is moved to the nearest
+//!    point of the 25-column lattice (testing both signs), then to 0 by line windows (B9), each
+//!    checked by the delay; then rows by the histogram - a white band of columns shows |row error|
+//!    exactly, corrected by row moves.
+//!
+//! Every move is a sequence of whole RGB frames with one changed `RASTER 0x000` word; the executor
+//! (the driver's RGB done interrupt) writes it and restores [`HANDOFF_WORD`].
+#![deny(
+    clippy::indexing_slicing,
+    clippy::arithmetic_side_effects,
+    clippy::unwrap_used,
+    clippy::expect_used
+)]
+
+/// `RASTER 0x0525c000` as the boot loader leaves it: (1125 - 1) << 16 | (2200 - 1) (05 §1.1).
+pub const HANDOFF_WORD: u32 = 0x0464_0897;
+pub const RASTER_TOTAL: u32 = 0x0525_c000;
+pub const H_TOTAL: u32 = 2200;
+pub const V_TOTAL: u32 = 1125;
+pub const WIDTH: u32 = 1920;
+pub const HEIGHT: u32 = 1080;
+/// The panel frame (05 §5: 15.2583 ms) and line (13.563 us) in nanoseconds.
+pub const FRAME_NS: u64 = 15_258_300;
+pub const LINE_NS: u64 = FRAME_NS / V_TOTAL as u64;
+/// Video vsync -> RGB done in the aligned state (05 §2.1 B8, 95 S1-T6: 13.785 ms +/- 0.014 ms) at
+/// 1920x1080.
+pub const ALIGNED_DELAY_NS: u64 = 13_785_000;
+/// The same at 1280x720 scaled (B10: 13.772 ms, 1015 lines).
+pub const ALIGNED_DELAY_720P_NS: u64 = 13_772_000;
+
+/// The aligned delay of a video geometry (B10).
+pub const fn aligned_delay_ns(state: super::config::ScaleState) -> u64 {
+    match state {
+        super::config::ScaleState::OneToOne => ALIGNED_DELAY_NS,
+        super::config::ScaleState::Up720To1080 => ALIGNED_DELAY_720P_NS,
+    }
+}
+
+/// A change of the delay by more than this across one window means the raster jumped (B9: about
+/// 0.41 ms).
+pub const JUMP_NS: u64 = 100_000;
+/// Line windows: lines per window at most, attempts at most.
+pub const WINDOW_MAX_LINES: u32 = 64;
+pub const WINDOW_ATTEMPTS: u32 = 6;
+/// Jumps undone at most before the fine step gives up.
+pub const JUMPS_MAX: u32 = 3;
+/// Half a line (13.563 us): the rows are aligned when the delay rounds to the target line. B10
+/// tells 13.785 from 13.772 ms (one row); the column part of the offset adds up to +/- 6.8 us; B11
+/// saw no latency difference above 0.002 ms between the two interrupt lines. (95 S1-T6 checks the
+/// result with +/- 0.014 ms.)
+pub const DELAY_TOLERANCE_NS: u64 = LINE_NS / 2;
+/// Row moves of one frame (B4: c = 25..100 moved exactly c rows; 1 line moved columns too, B5).
+pub const ROW_STEP_MIN: u32 = 25;
+pub const ROW_STEP_MAX: u32 = 100;
+/// One frame with the horizontal total +/- 1 moves 1125 columns (B4).
+pub const COL_STEP: u32 = V_TOTAL;
+/// The calibration bands: a white band of rows 100..979 (880 rows) and one of columns 100..1819
+/// (1720 columns).
+pub const BAND_MARGIN: u32 = 100;
+pub const ROW_BAND_ROWS: u32 = HEIGHT - 2 * BAND_MARGIN;
+pub const COL_BAND_COLS: u32 = WIDTH - 2 * BAND_MARGIN;
+
+/// The `RASTER 0x000` word of a frame lengthened by `c` lines.
+pub const fn lengthened(c: u32) -> u32 {
+    ((V_TOTAL - 1).wrapping_add(c) << 16) | (H_TOTAL - 1)
+}
+
+/// The `RASTER 0x000` word of a frame with the horizontal total 2200 + 1 (`plus`) or 2200 - 1.
+pub const fn htotal_step(plus: bool) -> u32 {
+    ((V_TOTAL - 1) << 16) | if plus { H_TOTAL } else { H_TOTAL - 2 }
+}
+
+/// Whether `word` is one the alignment may write: the handoff word, a lengthened frame (c =
+/// 25..100) or a horizontal step. Everything else is refused by the executor.
+pub fn word_allowed(word: u32) -> bool {
+    if word == HANDOFF_WORD || word == htotal_step(true) || word == htotal_step(false) {
+        return true;
+    }
+    let v = (word >> 16).wrapping_add(1).wrapping_sub(V_TOTAL);
+    word & 0xffff == H_TOTAL - 1 && (ROW_STEP_MIN..=ROW_STEP_MAX).contains(&v)
+}
+
+/// Lines the RGB raster has to be delayed by so that the measured delay reaches `target_ns`; `None`
+/// when it rounds to the target line (within [`DELAY_TOLERANCE_NS`]; 05 §2.1 B3/B8: lengthening the
+/// RGB frame by c lines makes the RGB done come c lines later).
+pub fn rows_from_delay(delay_ns: u64, target_ns: u64) -> Option<u32> {
+    let delay = delay_ns % FRAME_NS;
+    let target = target_ns % FRAME_NS;
+    // (target - delay) mod frame, both below one frame.
+    let diff = target.saturating_add(FRAME_NS).wrapping_sub(delay) % FRAME_NS;
+    // Round to the nearest line.
+    let lines = (diff.saturating_add(LINE_NS / 2) / LINE_NS) as u32 % V_TOTAL;
+    if lines == 0 {
+        return None;
+    }
+    Some(lines)
+}
+
+/// A row move of `d` lines (mod 1125) made of frames of 25..100 lines: below 25 a whole frame (1125
+/// lines) is added, which is the same alignment. Returns (frames, lines per frame for the first
+/// frames, lines of the rest).
+pub fn row_plan(d: u32) -> RowPlan {
+    let d = d % V_TOTAL;
+    if d == 0 {
+        return RowPlan {
+            total: 0,
+            frames: 0,
+        };
+    }
+    let total = if d < ROW_STEP_MIN {
+        d.wrapping_add(V_TOTAL)
+    } else {
+        d
+    };
+    RowPlan {
+        total,
+        frames: total.div_ceil(ROW_STEP_MAX),
+    }
+}
+
+/// A row move split into frames.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct RowPlan {
+    pub total: u32,
+    pub frames: u32,
+}
+
+impl RowPlan {
+    /// Lines of frame `i` (0-based): the total spread evenly, each 25..100.
+    pub fn frame(&self, i: u32) -> u32 {
+        if self.frames == 0 {
+            return 0;
+        }
+        let base = self.total.checked_div(self.frames).unwrap_or(0);
+        let extra = self.total.checked_rem(self.frames).unwrap_or(0);
+        if i < extra {
+            base.saturating_add(1)
+        } else {
+            base
+        }
+    }
+}
+
+/// Centres a column error into -1099..=1100.
+pub const fn centred(e: i64) -> i64 {
+    let m = e.rem_euclid(H_TOTAL as i64);
+    if m > (H_TOTAL / 2) as i64 {
+        m.wrapping_sub(H_TOTAL as i64)
+    } else {
+        m
+    }
+}
+
+/// The number of horizontal steps (negative: `htotal_step(false)`) that brings a column error `e`
+/// closest to 0, with |steps| <= 44 (88 = 2200 / 25 lattice points).
+pub fn best_col_steps(e: i64) -> (i32, i64) {
+    let mut best = (0i32, centred(e).abs());
+    let mut a = -44i32;
+    while a <= 44 {
+        let r = centred(e.saturating_add((a as i64).saturating_mul(COL_STEP as i64))).abs();
+        if r < best.1 || (r == best.1 && a.unsigned_abs() < best.0.unsigned_abs()) {
+            best = (a, r);
+        }
+        a = a.saturating_add(1);
+    }
+    best
+}
+
+/// |column error| from the high-bin count of the row band (880 white rows, full width) over the black video.
+pub fn col_error_from_band(high: u32) -> u32 {
+    WIDTH.saturating_sub(high / ROW_BAND_ROWS)
+}
+
+/// |row error| from the high-bin count of the column band (1720 white columns, full height).
+pub fn row_error_from_band(high: u32) -> u32 {
+    HEIGHT.saturating_sub(high / COL_BAND_COLS)
+}
+
+/// What the alignment shows while it calibrates.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Content {
+    /// White rows 100..979 over the black video frame, alpha 0xff: measures columns.
+    RowBand,
+    /// White columns 100..1819 over the black video frame, alpha 0xff: measures rows.
+    ColBand,
+    /// The user's planes again.
+    User,
+}
+
+/// What the executor provides.
+pub trait AlignEnv {
+    type Error;
+    /// Median of `samples` video vsync -> next RGB done delays, ns (`None`: no samples came).
+    fn delay_ns(&mut self, samples: u32) -> Result<Option<u64>, Self::Error>;
+    /// `word` in `RASTER 0x000` for `frames` RGB frames (from an RGB done on), then
+    /// [`HANDOFF_WORD`].
+    fn raster(&mut self, word: u32, frames: u32) -> Result<(), Self::Error>;
+    /// Waits `frames` RGB frames.
+    fn settle(&mut self, frames: u32) -> Result<(), Self::Error>;
+    /// Histogram high-bin count (bins 24..31) of the last frame.
+    fn high(&mut self) -> Result<u32, Self::Error>;
+    /// Shows calibration content (or the user's planes back).
+    fn show(&mut self, c: Content) -> Result<(), Self::Error>;
+    /// A line window (B9): the horizontal total 2201 (`plus`) or 2199 for `lines` lines, written
+    /// right after the video line counter stepped; returns the lines the window actually spanned
+    /// (read back from the counter).
+    fn window(&mut self, plus: bool, lines: u32) -> Result<u32, Self::Error>;
+}
+
+/// Bounds and switches.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct AlignParams {
+    pub samples: u32,
+    pub row_iterations: u32,
+    pub calibrate: bool,
+    /// The aligned delay of the current video geometry ([`aligned_delay_ns`]).
+    pub target_ns: u64,
+}
+
+impl AlignParams {
+    pub const DEFAULT: Self = Self {
+        samples: 16,
+        row_iterations: 3,
+        calibrate: false,
+        target_ns: ALIGNED_DELAY_NS,
+    };
+}
+
+/// What the alignment measured and did.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct AlignReport {
+    /// Delays before and after (ns; 0 = not measured).
+    pub delay_before: u64,
+    pub delay_after: u64,
+    /// Lines moved by timing, and the frames it took.
+    pub timing_lines: u32,
+    pub timing_frames: u32,
+    pub timing_aligned: bool,
+    pub calibrated: bool,
+    /// |column error| before and after the column calibration.
+    pub col_before: u32,
+    pub col_after: u32,
+    /// Horizontal steps applied (signed sum).
+    pub col_steps: i32,
+    /// |row error| before and after the histogram row step.
+    pub row_before: u32,
+    pub row_after: u32,
+    /// Lines moved by the histogram row step.
+    pub hist_lines: u32,
+    /// |column error| after the lattice step (before the line windows).
+    pub col_lattice: u32,
+    /// Line windows made, raster jumps seen (and undone).
+    pub windows: u32,
+    pub jumps: u32,
+}
+
+fn move_rows<E: AlignEnv>(env: &mut E, lines: u32) -> Result<u32, E::Error> {
+    let p = row_plan(lines);
+    for i in 0..p.frames {
+        env.raster(lengthened(p.frame(i)), 1)?;
+    }
+    Ok(p.frames)
+}
+
+fn move_cols<E: AlignEnv>(env: &mut E, steps: i32) -> Result<(), E::Error> {
+    if steps != 0 {
+        env.raster(htotal_step(steps > 0), steps.unsigned_abs())?;
+    }
+    Ok(())
+}
+
+fn rows_by_timing<E: AlignEnv>(
+    env: &mut E,
+    p: &AlignParams,
+    rep: &mut AlignReport,
+) -> Result<(), E::Error> {
+    for _ in 0..p.row_iterations {
+        let Some(d) = env.delay_ns(p.samples)? else {
+            return Ok(());
+        };
+        if rep.delay_before == 0 {
+            rep.delay_before = d;
+        }
+        rep.delay_after = d;
+        match rows_from_delay(d, p.target_ns) {
+            None => {
+                rep.timing_aligned = true;
+                return Ok(());
+            }
+            Some(lines) => {
+                let f = move_rows(env, lines)?;
+                rep.timing_lines = rep.timing_lines.saturating_add(lines);
+                rep.timing_frames = rep.timing_frames.saturating_add(f);
+                env.settle(2)?;
+            }
+        }
+    }
+    if let Some(d) = env.delay_ns(p.samples)? {
+        rep.delay_after = d;
+        rep.timing_aligned = rows_from_delay(d, p.target_ns).is_none();
+    }
+    Ok(())
+}
+
+/// Measurement rounds of the column calibration (each at most 44 frames of moves).
+pub const COL_ROUNDS: u32 = 4;
+
+/// Columns by the row band (bounded: [`COL_ROUNDS`] rounds of at most 44 frames). The band shows
+/// |column error| exactly; the sign is unknown at first: the first move assumes it positive, and
+/// the next measurement tells which sign it was (the two predictions differ), so later rounds move
+/// from a signed error and absorb the per-step slip of B4 ("to within 2 columns").
+fn cols_by_histogram<E: AlignEnv>(
+    env: &mut E,
+    rep: &mut AlignReport,
+) -> Result<(u32, Option<i64>), E::Error> {
+    env.show(Content::RowBand)?;
+    env.settle(3)?;
+    let mut g = col_error_from_band(env.high()?);
+    if rep.col_before == 0 {
+        rep.col_before = g;
+    }
+    let mut known: Option<i64> = None;
+    for _ in 0..COL_ROUNDS {
+        if g <= 2 {
+            break;
+        }
+        let e = known.unwrap_or(g as i64);
+        let (a, _) = best_col_steps(e);
+        if a == 0 {
+            break;
+        }
+        move_cols(env, a)?;
+        env.settle(3)?;
+        let g1 = col_error_from_band(env.high()?);
+        let shift = (a as i64).saturating_mul(COL_STEP as i64);
+        let plus = centred(e.saturating_add(shift));
+        let minus = centred(shift.saturating_sub(e));
+        let take_plus = known.is_some()
+            || (g1 as i64).saturating_sub(plus.abs()).abs()
+                <= (g1 as i64).saturating_sub(minus.abs()).abs();
+        let sign = if take_plus {
+            plus.signum()
+        } else {
+            minus.signum()
+        };
+        known = Some(sign.saturating_mul(g1 as i64));
+        rep.col_steps = rep.col_steps.saturating_add(a);
+        g = g1;
+    }
+    rep.col_after = g;
+    rep.col_lattice = g;
+    Ok((g, known))
+}
+
+fn jumped(d0: Option<u64>, d1: Option<u64>) -> bool {
+    match (d0, d1) {
+        (Some(a), Some(b)) => {
+            let d = a.abs_diff(b) % FRAME_NS;
+            d.min(FRAME_NS.saturating_sub(d)) > JUMP_NS
+        }
+        _ => false,
+    }
+}
+
+/// Columns to 0 by line windows (B9), each checked by the delay; a jump is undone by the row and
+/// lattice steps.
+fn cols_fine<E: AlignEnv>(
+    env: &mut E,
+    p: &AlignParams,
+    rep: &mut AlignReport,
+    mut g: u32,
+    mut known: Option<i64>,
+) -> Result<(), E::Error> {
+    // Lines a window came short by (B9: writes land late); the next window asks for that many more.
+    let mut short = 0u32;
+    for _ in 0..WINDOW_ATTEMPTS {
+        if g == 0 {
+            break;
+        }
+        let e = known.unwrap_or(g as i64);
+        let plus = e < 0;
+        let m = g.saturating_add(short).clamp(1, WINDOW_MAX_LINES);
+        let d0 = env.delay_ns(p.samples)?;
+        let got = env.window(plus, m)?;
+        rep.windows = rep.windows.saturating_add(1);
+        short = m.saturating_sub(got);
+        let d1 = env.delay_ns(p.samples)?;
+        if jumped(d0, d1) {
+            rep.jumps = rep.jumps.saturating_add(1);
+            if rep.jumps > JUMPS_MAX {
+                break;
+            }
+            // Undo: rows by timing, then the lattice again (B9: the jump moved rows and columns).
+            rows_by_timing(env, p, rep)?;
+            let (g1, k1) = cols_by_histogram(env, rep)?;
+            g = g1;
+            known = k1;
+            continue;
+        }
+        env.settle(3)?;
+        let g1 = col_error_from_band(env.high()?);
+        let moved = if plus {
+            got as i64
+        } else {
+            (got as i64).saturating_neg()
+        };
+        let same = centred(e.saturating_add(moved));
+        let flip = centred(moved.saturating_sub(e));
+        let take_same = known.is_some()
+            || (g1 as i64).saturating_sub(same.abs()).abs()
+                <= (g1 as i64).saturating_sub(flip.abs()).abs();
+        let sign = if take_same {
+            same.signum()
+        } else {
+            flip.signum()
+        };
+        known = Some(if sign == 0 {
+            0
+        } else {
+            sign.saturating_mul(g1 as i64)
+        });
+        g = g1;
+    }
+    rep.col_after = g;
+    Ok(())
+}
+
+/// Rows by the column band (after the columns are within the lattice): both signs tested.
+fn rows_by_histogram<E: AlignEnv>(env: &mut E, rep: &mut AlignReport) -> Result<(), E::Error> {
+    env.show(Content::ColBand)?;
+    env.settle(3)?;
+    let r = row_error_from_band(env.high()?);
+    rep.row_before = r;
+    rep.row_after = r;
+    if r == 0 {
+        return Ok(());
+    }
+    // Hypothesis: the image sits r rows too far (a move of 1125 - r lines brings it back).
+    let first = V_TOTAL.saturating_sub(r % V_TOTAL);
+    move_rows(env, first)?;
+    rep.hist_lines = first;
+    env.settle(3)?;
+    let r1 = row_error_from_band(env.high()?);
+    rep.row_after = r1;
+    if r1 == 0 {
+        return Ok(());
+    }
+    // The other sign: it now sits 2r rows off the other way.
+    let second = r.saturating_mul(2) % V_TOTAL;
+    move_rows(env, second)?;
+    rep.hist_lines = rep.hist_lines.saturating_add(second);
+    env.settle(3)?;
+    rep.row_after = row_error_from_band(env.high()?);
+    Ok(())
+}
+
+/// The alignment of 05 §2.1 (see the module text). Call only while both planes are shown.
+pub fn align<E: AlignEnv>(env: &mut E, p: &AlignParams) -> Result<AlignReport, E::Error> {
+    let mut rep = AlignReport::default();
+    rows_by_timing(env, p, &mut rep)?;
+    if p.calibrate {
+        rep.calibrated = true;
+        let r = cols_by_histogram(env, &mut rep)
+            .and_then(|(g, known)| cols_fine(env, p, &mut rep, g, known))
+            .and_then(|()| rows_by_histogram(env, &mut rep));
+        env.show(Content::User)?;
+        r?;
+        if let Some(d) = env.delay_ns(p.samples)? {
+            rep.delay_after = d;
+        }
+    }
+    Ok(rep)
+}
