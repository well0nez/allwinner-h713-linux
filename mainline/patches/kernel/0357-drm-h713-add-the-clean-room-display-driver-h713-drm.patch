diff --git a/drivers/gpu/drm/h713/Kconfig b/drivers/gpu/drm/h713/Kconfig
new file mode 100644
index 000000000..63f989a43
--- /dev/null
+++ b/drivers/gpu/drm/h713/Kconfig
@@ -0,0 +1,42 @@
+# SPDX-License-Identifier: GPL-2.0-only
+config DRM_H713
+	tristate "DRM support for the Allwinner H713 display engine"
+	depends on DRM && OF && RUST
+	depends on VIDEO_DEV || VIDEO_DEV=n
+	depends on ARM64 || COMPILE_TEST
+	depends on ARCH_SUNXI || COMPILE_TEST
+	select DRM_GEM_DMA_HELPER
+	select DRM_KMS_HELPER
+	select FW_LOADER
+	help
+	  Display driver for the Allwinner H713 projector SoC: the panel
+	  output the boot loader set up (adopted, never re-timed), an RGB
+	  plane (XRGB8888) and a video plane (NV12/NV16, 1:1 or scaled
+	  1280x720 -> 1920x1080), picture controls as CRTC properties and
+	  the standard GAMMA_LUT. The display co-processor is not used.
+
+	  The register programming is a Rust object linked into the module
+	  (CONFIG_RUST). At run time the driver reads the board vendor's
+	  display data files (database.TSE, pq_custom.TSE, ProjectID_*.TSE)
+	  through the firmware loader; none of their content is built in.
+
+	  The HDMI input needs the H713 ARISC driver's EDID / hot-plug
+	  services (linux/soc/sunxi/h713-arisc.h); without that header the
+	  input is offered only with hdmi_edid_external=1.
+
+	  With V4L2 (CONFIG_VIDEO_DEV) the HDMI input is also a V4L2
+	  capture device, "h713-hdmirx-clean": DV timings, source-change
+	  events, EDID, and streaming of the capture ring with dma-buf
+	  export.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called h713_drm.
+
+config DRM_H713_BENCH
+	bool "H713 bench mode (resources without a device tree node)"
+	depends on DRM_H713
+	help
+	  Adds the module parameter bench=1, which registers a platform
+	  device with the display's register blocks and interrupts
+	  itself, for bench boots whose device tree has no display node.
+	  Development only; say N.
diff --git a/drivers/gpu/drm/h713/Makefile b/drivers/gpu/drm/h713/Makefile
new file mode 100644
index 000000000..7e7634bcf
--- /dev/null
+++ b/drivers/gpu/drm/h713/Makefile
@@ -0,0 +1,19 @@
+# SPDX-License-Identifier: GPL-2.0-only
+#
+# Allwinner H713 display: one module of a C object (the DRM/KMS shell) and one Rust object (the hardware layer,
+# a crate root without `module!`); kbuild's %.o: %.rs rule builds the Rust one. The Rust root includes the shared
+# no_std sources under shared/ with #[path] (they are part of its crate, not objects).
+#
+# Out of tree (this repository): drivers/h713-drm/build.sh stages this directory with shared/ and runs
+# `make M=... CONFIG_DRM_H713=m [CONFIG_DRM_H713_BENCH=y]`.
+
+obj-$(CONFIG_DRM_H713) += h713_drm.o
+h713_drm-y := h713_drm_main.o h713_drm_hw.o
+# the HDMI receiver as a V4L2 capture device (h713_hdmirx.h), only with V4L2 in the kernel
+ifneq ($(CONFIG_VIDEO_DEV),)
+h713_drm-y += h713_hdmirx.o
+endif
+
+# The bench mode (a platform device with the spec's resources for boots without a DT node) is compiled in only
+# with CONFIG_DRM_H713_BENCH; a define rather than the Kconfig symbol so that the out-of-tree build can switch it.
+ccflags-$(CONFIG_DRM_H713_BENCH) += -DH713_DRM_BENCH
diff --git a/drivers/gpu/drm/h713/h713_compat.h b/drivers/gpu/drm/h713/h713_compat.h
new file mode 100644
index 000000000..8f83c251f
--- /dev/null
+++ b/drivers/gpu/drm/h713/h713_compat.h
@@ -0,0 +1,34 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * h713_drm: the kernel-version switches of the C shell, all in one place. One source builds against mainline
+ * 6.18 and 7.3 (the HY320's kernel).
+ */
+#ifndef H713_COMPAT_H
+#define H713_COMPAT_H
+
+#include <linux/version.h>
+
+/*
+ * 7.3 renamed the atomic update that the plane and CRTC hooks and the drm_atomic_get_*_state() helpers take:
+ * struct drm_atomic_state became struct drm_atomic_commit (same role, same helpers).
+ */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 3, 0)
+#define h713_atomic drm_atomic_commit
+#else
+#define h713_atomic drm_atomic_state
+#endif
+
+/*
+ * The EDID / hot-plug provider of the HDMI input (spec 57): the project's ARISC driver, which exists
+ * only in the project's kernels (CONFIG_SUN50I_H713_ARISC, linux/soc/sunxi/h713-arisc.h). Without
+ * it the provider counts as absent (the module parameter hdmi_edid_external=1 then declares that
+ * someone else serves EDID and hot-plug).
+ */
+#if IS_ENABLED(CONFIG_SUN50I_H713_ARISC)
+#include <linux/soc/sunxi/h713-arisc.h>
+#define H713_HAVE_ARISC 1
+#else
+#define H713_HAVE_ARISC 0
+#endif
+
+#endif /* H713_COMPAT_H */
diff --git a/drivers/gpu/drm/h713/h713_drm.h b/drivers/gpu/drm/h713/h713_drm.h
new file mode 100644
index 000000000..1b334453d
--- /dev/null
+++ b/drivers/gpu/drm/h713/h713_drm.h
@@ -0,0 +1,378 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * h713_drm: the C ABI between the DRM/KMS shell (h713_drm_main.c) and the Rust hardware layer
+ * (h713_drm_hw.rs). Each struct here has a #[repr(C)] twin and each prototype a #[no_mangle] extern
+ * "C" fn of the same name on the Rust side; nothing checks the two against each other, so a change
+ * goes into both files.
+ *
+ * Every register address that crosses this interface is a physical address of spec/00 §1; the Rust
+ * side finds the block mapping that holds it in struct h713_hw and refuses anything outside.
+ */
+#ifndef H713_DRM_H
+#define H713_DRM_H
+
+#include <linux/compiler_types.h>
+#include <linux/types.h>
+
+/*
+ * Register blocks (spec/00 §1), the order of struct h713_hw.blk and of the "reg-names" of the DT
+ * binding.
+ */
+enum h713_blk {
+	H713_BLK_SCANOUT, /* 0x05600000, 0x1000 */
+	H713_BLK_PNL, /* 0x051c0000, 0x10000 (with PNL_LOCK) */
+	H713_BLK_PROC, /* 0x05140000, 0x10000 (with PROC_LOCK) */
+	H713_BLK_SCL, /* 0x05180000, 0x1000 */
+	H713_BLK_NRC, /* 0x05000000, 0x2000 */
+	H713_BLK_DEI, /* 0x050c0000, 0x1000 */
+	H713_BLK_BORDER, /* 0x05200000, 0x1000 */
+	H713_BLK_MIX, /* 0x058c0000, 0x2000 */
+	H713_BLK_TCON, /* 0x05880000, 0x1000: read only (precondition) */
+	H713_BLK_CAP, /* 0x06940000, 0x1000: two bits of the data-path reset (40 §4.4) */
+	H713_BLK_CCU, /* 0x02001000, 0x1000: read only (precondition), bench mode only */
+	/* 0x0525c000, 0x1000: RGB raster totals (alignment, spec 05 §2.1) */
+	H713_BLK_RASTER,
+	H713_BLK_GAMMA, /* 0x05208000, 0x2000: gamma LUT ports (spec 30 §4.3), optional */
+	H713_BLK_RXCTL,		/* 0x06800000, 0x4000: HDMI receiver control bytes (spec 50 §1), optional */
+	H713_BLK_RXLINK,	/* 0x06840000, 0x2000: HDMI receiver link bytes (spec 50 §1), optional */
+	H713_BLK_TVTOP,		/* 0x06e00000, 0x1000: TV top clock/reset words (spec 50 §2), optional */
+	H713_NBLK
+};
+
+struct h713_block {
+	u32 phys;
+	u32 size;
+	void __iomem *base;	/* NULL: not mapped */
+};
+
+struct h713_hw {
+	struct h713_block blk[H713_NBLK];
+	const u8 *tse;		/* the owner's database.TSE (request_firmware), or NULL */
+	size_t tse_len;
+	u32 nr_base; /* physical base of the relocated spec/12 buffer area (full set) */
+	u32 dram_set;		/* 0 full, 1 minimal40, 2 minimal85 (spec/12 §M) */
+	u32 latch_timeout_us;	/* bound of every latch poll */
+	u32 switches_off;	/* bit i = switch i of `vp-bench switches` off */
+	u32 pace_write_us;	/* init path pacing (spec 10 §6.3): after each init-table write */
+	u32 pace_table_us;	/* ... and between the tables / before the lock totals */
+	/* 1: [nr_base, nr_base + h713_hw_nr_span()) lies in a no-map reserved region */
+	u32 nr_reserved;
+	const u8 *pq;		/* the owner's pq_custom.TSE (request_firmware), or NULL */
+	size_t pq_len;
+	/* the owner's ProjectID_0x00NN.TSE (gamma curves, spec 40 §6), or NULL */
+	const u8 *project;
+	size_t project_len;
+	/* the owner's LogoRegData.bin (spec 40 §3), loaded only for the resume's panel step, or NULL */
+	const u8 *logo;
+	size_t logo_len;
+	/*
+	 * 1: no access to the capture block (between a suspend and a good TV-side re-init, spec 60):
+	 * writes there are left out of every plan and counted
+	 */
+	u32 cap_blocked;
+};
+
+/* What both planes show (one commit). */
+struct h713_plane {
+	u32 rgb_on;
+	u32 rgb_phys;		/* XRGB8888 1920x1080 */
+	u32 rgb_pitch;		/* 7680 */
+	u32 alpha;		/* 0..255: RGB over video */
+	u32 video_on;
+	u32 video_fmt;		/* 0 NV12, 1 NV16 */
+	u32 width;
+	u32 height;
+	u32 pitch;
+	u32 luma;
+	u32 chroma;
+};
+
+#define H713_REPORT_BAD 4
+
+/* Outcome of one commit: every written word is read back. */
+struct h713_report {
+	u32 ops;
+	u32 writes;
+	u32 mismatches;
+	u32 timeouts;
+	u32 check_fails;
+	u32 raster_fails;	/* stall signs of spec/10 §6.3 */
+	u32 latch_pending;	/* RGB latch still set when a new flip came (95 S1-T2) */
+	u32 full_enable;	/* the video plane went through the full enable path */
+	u32 nbad;
+	u32 bad_addr[H713_REPORT_BAD];
+	u32 bad_expect[H713_REPORT_BAD];
+	u32 bad_read[H713_REPORT_BAD];
+	u32 error_addr; /* address of the operation that stopped the commit, if any */
+	u32 cap_skipped;	/* capture-block writes left out (hw->cap_blocked, spec 60) */
+};
+
+/* Rust -> C: sleep (process context only; the commit path). */
+void h713_drm_sleep_us(u32 us);
+
+/* C -> Rust. All return 0 or a negative errno. */
+int h713_hw_tse_check(const struct h713_hw *hw);
+int h713_hw_check(const struct h713_hw *hw, const struct h713_plane *plane);
+int h713_hw_commit(const struct h713_hw *hw, const struct h713_plane *old_state,
+		   const struct h713_plane *new_state, struct h713_report *rep);
+/* no sleep: callable under a spinlock */
+int h713_hw_vblank_irq(const struct h713_hw *hw, bool on);
+/* IRQ context: 1 if the RGB done bit was set */
+u32 h713_hw_vblank_ack(const struct h713_hw *hw);
+int h713_hw_read(const struct h713_hw *hw, u32 addr, u32 *val);
+u32 h713_hw_nr_span(void);
+
+/* --- RGB over video: raster alignment (spec 05 §2.1) ------------------------------------------ */
+
+#define H713_RASTER_HANDOFF 0x04640897	/* RASTER 0x000 as the boot loader leaves it */
+
+/*
+ * Timing services of the C side (interrupt time stamps, the frame-exact RASTER writes in the RGB
+ * done IRQ).
+ */
+struct h713_align_ops {
+	void *cookie;
+	/* median of `samples` video vsync -> next RGB done delays: 0 ok, 1 no samples, < 0 error */
+	int (*delay_ns)(void *cookie, u32 samples, u64 *median_ns);
+	/*
+	 * `word` in RASTER 0x000 for `frames` RGB frames from the next RGB done on, then the
+	 * handoff word
+	 */
+	int (*raster)(void *cookie, u32 word, u32 frames);
+	/* wait `frames` RGB frames */
+	int (*settle)(void *cookie, u32 frames);
+	/*
+	 * a line window (05 §2.1 B9): horizontal total 2201 (plus) / 2199 for `lines` lines; *got =
+	 * lines spanned
+	 */
+	int (*window)(void *cookie, u32 plus, u32 lines, u32 *got);
+};
+
+/* Driver-owned calibration content (0 = none: no calibration). */
+struct h713_align_bufs {
+	/* XRGB8888 1920x1080 pitch 7680: white rows 100..979, black elsewhere */
+	u32 rgb_rows;
+	u32 rgb_cols;		/* white columns 100..1819 */
+	u32 video_luma;		/* a black frame of the current video geometry */
+	u32 video_chroma;
+};
+
+struct h713_align_report {
+	u64 delay_before_ns;
+	u64 delay_after_ns;
+	u32 timing_lines;
+	u32 timing_frames;
+	u32 timing_aligned;
+	u32 calibrated;
+	u32 col_before;
+	u32 col_after;
+	s32 col_steps;
+	u32 row_before;
+	u32 row_after;
+	u32 hist_lines;
+	u32 col_lattice;
+	u32 windows;
+	u32 jumps;
+	u32 target_ns;
+};
+
+/* IRQ context; only the words of 05 §2.1 B4 */
+int h713_hw_raster_set(const struct h713_hw *hw, u32 word);
+/*
+ * Busy-waits (bounded) until the video line counter leaves room for a window of `lines` lines. IRQs
+ * on.
+ */
+int h713_hw_line_wait(const struct h713_hw *hw, u32 lines);
+/*
+ * The B9 window, IRQs off: -EAGAIN if the line counter left the room; the handoff word is always
+ * restored.
+ */
+int h713_hw_raster_window(const struct h713_hw *hw, bool plus, u32 lines, u32 *got);
+void h713_drm_udelay(u32 us); /* Rust -> C: busy delay */
+
+/* --- picture controls (spec 30, 40 §5) -------------------------------------------------------- */
+
+enum h713_pq {
+	H713_PQ_SATURATION,	/* 0..100, default 50 */
+	H713_PQ_HUE,		/* 0..100, default 50 */
+	H713_PQ_WB_RED_GAIN,	/* 0..1023, default 512 (all six) */
+	H713_PQ_WB_GREEN_GAIN,
+	H713_PQ_WB_BLUE_GAIN,
+	H713_PQ_WB_RED_OFFSET,
+	H713_PQ_WB_GREEN_OFFSET,
+	H713_PQ_WB_BLUE_OFFSET,
+	H713_PQ_CONTRAST,	/* 0..100, default 95 */
+	H713_PQ_DITHER,		/* dither class 0..7, default 0 */
+	H713_PQ_BRIGHTNESS,	/* 0..100, default 100 (= the enable's +100; 50 = 0) */
+	H713_PQ_SHARPNESS,	/* 0..100, default 50 */
+	H713_PQ_N
+};
+
+struct h713_write {
+	u32 addr;
+	u32 mask;
+	u32 value;
+};
+
+#define H713_PQ_MAX_WRITES 4	/* per control */
+
+/* Name (NUL-terminated, static), range and default of control `c`; -EINVAL past the last. */
+int h713_hw_pq_info(u32 c, const char **name, u32 *min, u32 *max, u32 *def);
+/* bit i: control i computable from the owner's files */
+u32 h713_hw_pq_available(const struct h713_hw *hw);
+/* The masked writes of control `c` at `value` into out[0..max); *n = their count. */
+int h713_hw_pq_writes(const struct h713_hw *hw, u32 c, u32 value, struct h713_write *out, u32 max,
+		      u32 *n);
+/*
+ * Performs the writes and reads every word back (IRQ context, no sleep); *mismatches = words that
+ * differ.
+ */
+int h713_hw_pq_apply(const struct h713_hw *hw, const struct h713_write *w, u32 n, u32 *mismatches);
+/*
+ * Gamma (spec 30 §4.3): the DRM LUT (struct drm_color_lut[n], n = 1024) into the hidden bank; *show
+ * = the write that shows it with the LUT on (for h713_hw_pq_apply in the next vblank). Process
+ * context.
+ */
+int h713_hw_gamma_load(const struct h713_hw *hw, const u16 *lut, u32 n, struct h713_write *show,
+		       u32 *mismatches);
+/* the write that turns the LUT off (linear) */
+void h713_hw_gamma_off(struct h713_write *w);
+bool h713_hw_gamma_mapped(const struct h713_hw *hw);
+/*
+ * The default LUT (struct drm_color_lut[n], n = 1024): the owner's third curve of the ProjectID
+ * file, which the 12 state's bank showed after a normal boot (spec 30 §4.3). -ENODEV without the
+ * file or its curve.
+ */
+int h713_hw_gamma_default(const struct h713_hw *hw, u16 *lut, u32 n);
+#define H713_GAMMA_SIZE 1024
+int h713_hw_video_vsync_irq(const struct h713_hw *hw, bool on);	/* no sleep */
+u32 h713_hw_video_vsync_ack(const struct h713_hw *hw);		/* IRQ context */
+int h713_hw_align(const struct h713_hw *hw, const struct h713_align_ops *ops,
+		  const struct h713_align_bufs *bufs, const struct h713_plane *cur, u32 calibrate,
+		  struct h713_align_report *ar,
+		  /* bytes of the spec/12 buffer layout from nr_base */
+		  struct h713_report *rep);
+/* spec 05 §6 */
+int h713_hw_restore_handoff(const struct h713_hw *hw, u32 logo, struct h713_report *rep);
+
+/* --- stage 3: the HDMI input (spec 50, 55) --------------------------------------------------- */
+
+/* the CRTC's read-only hdmi_state; 1..5 are h713-vp hdmi::Lock + 1 */
+enum h713_hdmi_state {
+	H713_HDMI_OFF,		/* the video plane shows client buffers, or the input is unavailable */
+	H713_HDMI_NO_SIGNAL,	/* no TMDS on the socket */
+	H713_HDMI_TMDS,		/* TMDS, no valid timing (yet) */
+	H713_HDMI_UNSUPPORTED,	/* a timing other than CTA 1080p60: refused */
+	H713_HDMI_LOCKED,	/* 1080p60, the capture not (yet) writing */
+	H713_HDMI_CAPTURING,	/* the capture writes the ring, channel 0 shows it */
+	/*
+	 * after a deep sleep (or a load after one): the TV side is not as the boot loader left it
+	 * and no measured re-init is reliable (spec 60 v4): no receiver access until reboot
+	 */
+	H713_HDMI_UNAVAILABLE,
+};
+
+struct h713_rx_report {
+	u32 writes;
+	u32 mismatches;
+	u32 skipped_ccu;
+	u32 bad_addr;		/* the first write whose read-back differed */
+	u32 bad_read;
+};
+
+struct h713_rx_signs {
+	u16 timing[12];		/* RX_LINK +0x28..+0x3f: H total/active/blank/front/sync/back, V ... */
+	u32 tmds;
+	u32 enables;
+	u32 counter;		/* CAP 0x104 */
+	u32 totals;		/* CAP 0x548 */
+	u32 size;		/* CAP 0x874 */
+	u32 out_luma;		/* CAP 0x928 */
+	u32 out_chroma;		/* CAP 0x968 */
+	u32 write_index;	/* CAP 0xa0c */
+	u32 frame_before;	/* in: CAP 0x104 [31:16] of the previous reading */
+	u32 state;		/* out: enum h713_hdmi_state */
+	u32 refresh_mhz;
+};
+
+struct h713_ring {
+	u32 luma[3];
+	u32 chroma[3];
+	u32 span;
+};
+
+struct h713_rotation {
+	u32 shown_slot;		/* 0xff: none */
+	u32 frame_at_show;
+	u32 shown;
+	u32 repeated;
+	u32 skipped;
+	u32 bad_index;
+	u32 latch_timeouts;
+};
+
+bool h713_hw_hdmi_mapped(const struct h713_hw *hw);
+/*
+ * spec 50 §8 (process context); ccu: make the CCU writes (bench mode); pace: the bench's pauses
+ * (about 7 s; 58 §2: not needed)
+ */
+int h713_hw_rx_bringup(const struct h713_hw *hw, bool ccu, bool pace, struct h713_rx_report *rep);
+int h713_hw_rx_signs(const struct h713_hw *hw, struct h713_rx_signs *s);	/* no sleep */
+/* spec 60 v4: 0x06e00000/04/08 hold the boot loader's set-up (not the reset values of a sleep) */
+bool h713_hw_tvtop_set_up(u32 t0, u32 t4, u32 t8);
+/* h713-vp hdmi::RxStep: the receiver bookkeeping of one reading (spec 50 §8, §9; 58 §2; 60 §3) */
+enum h713_rx_step {
+	H713_RX_EVALUATE,	/* TMDS, receiver up: the lock evaluation */
+	H713_RX_WRITE_TMDS,	/* TMDS, receiver not up: the receiver sequence */
+	H713_RX_WRITE_NO_TMDS,	/* no TMDS, not written (recently): the sequence as the bench wrote it */
+	H713_RX_WAIT,		/* no signal, nothing counted */
+	H713_RX_COUNT,		/* no signal with the receiver up: one more reading counted */
+	H713_RX_LOST,		/* the receiver (and a running capture) goes down */
+};
+u32 h713_hw_rx_step(bool tmds, bool up, bool written, u32 ms_since_write, u32 lost);
+int h713_hw_ring(u32 base, struct h713_ring *out);
+/* spec 55 §8 (process context); pace: 500 ms before the enables, as the bench */
+int h713_hw_cap_start(const struct h713_hw *hw, u32 ring_base, bool pace,
+		      struct h713_rx_report *rep);
+int h713_hw_cap_stop(const struct h713_hw *hw);	/* no sleep; wait 40 ms after it */
+/* IRQ context: the slot newly shown, -1 if none, or -errno */
+int h713_hw_ring_tick(const struct h713_hw *hw, struct h713_rotation *rot, u32 ring_base);
+
+/* --- resume: the panel bring-up step as data (spec 40 §3; the plan from spec 05 §7) ----------- */
+
+struct h713_panel_counts {
+	u32 writes;
+	u32 pulses;
+	u32 delays;
+	u32 delay_ms;
+};
+
+/* Parse `plan` (len bytes, "prologue,timing,picture[a-b]", ...) and check it against hw->logo. */
+int h713_hw_panel_check(const struct h713_hw *hw, const char *plan, u32 len, u32 project,
+			struct h713_panel_counts *c);
+/* The 4 KiB pages the plan writes, ascending, into out[0..max); *n = their count. */
+int h713_hw_panel_pages(const struct h713_hw *hw, const char *plan, u32 len, u32 project,
+			u32 *out, u32 max, u32 *n);
+/*
+ * Replay the plan from hw->logo (process context: delays sleep): each write through hw's blocks
+ * or `maps` (the plan's pages, mapped by the caller), read back under its mask; rep counts.
+ */
+int h713_hw_panel_replay(const struct h713_hw *hw, const char *plan, u32 len, u32 project,
+			 const struct h713_block *maps, u32 nmaps, struct h713_report *rep);
+
+/*
+ * The TV-top re-init after a wake (spec 60), as data: "ADDR=VALUE,delay=US,..." 32-bit writes into
+ * mapped blocks. check: parse, every address mapped, *writes = the writes; run: each write read
+ * back (process context).
+ */
+int h713_hw_regs_check(const struct h713_hw *hw, const char *plan, u32 len, u32 *writes);
+int h713_hw_regs_run(const struct h713_hw *hw, const char *plan, u32 len, struct h713_report *rep);
+/* spec 60's default TV-side re-init: part 0 the boot loader's TV clock rewrites, 1 the TV-top sequence */
+const char *h713_hw_tvtop_default(u32 part, u32 *len);
+/*
+ * Before a deep sleep (spec 60 §1, §2): channel 0 off + latch, the NRC write channels' bit 31
+ * cleared, the RGB channel off (0x83001900) + latch; each word read back. Process context.
+ */
+int h713_hw_sleep_quiesce(const struct h713_hw *hw, struct h713_report *rep);
+
+#endif /* H713_DRM_H */
diff --git a/drivers/gpu/drm/h713/h713_drm_hw.rs b/drivers/gpu/drm/h713/h713_drm_hw.rs
new file mode 100644
index 000000000..8838b3ed5
--- /dev/null
+++ b/drivers/gpu/drm/h713/h713_drm_hw.rs
@@ -0,0 +1,2277 @@
+// SPDX-License-Identifier: GPL-2.0-only
+//! h713_drm: the Rust hardware layer of the clean H713 display driver. Not a Rust module (no
+//! `module!`): an object of the C module h713_drm, with the functions of C ABI declared in
+//! `h713_drm.h` (notes/kernel-rust/README.md). All register programming is here: the operation
+//! lists come from the shared `h713-vp` composer (spec 05, 10, 12, 20, 30) and the owner's
+//! `database.TSE` (`h713-tse`, spec 40); this file executes them on the mappings the C side made,
+//! reads every written word back and reports.
+//!
+//! No floats, no allocation, no panicking operation: addresses are looked up with checked
+//! arithmetic, errors cross the C ABI as negative errno values.
+
+use kernel::bindings;
+use kernel::error::code::{EFAULT, EINVAL, EIO, ENODEV};
+use kernel::ffi::c_void;
+
+#[allow(unreachable_pub, dead_code, missing_docs, clippy::all)]
+#[path = "hw_tse.rs"]
+mod h713_tse;
+
+#[allow(unreachable_pub, dead_code, missing_docs, clippy::all)]
+#[path = "hw_vp.rs"]
+mod h713_vp;
+
+use h713_vp::align::{self, AlignEnv, AlignParams, Content};
+use h713_vp::compose::{self, ComposeError, Step};
+use h713_vp::config::{
+    Config, DramSet, Frame, LatchWait, NrBuffers, Pacing, PixelFormat, Switch, FW_BUFFER_SPAN,
+    SWITCHES,
+};
+use h713_vp::gamma;
+use h713_vp::hdmi::{self, Lock, Ring, Rotation, RxKind, Signs, Timing};
+use h713_vp::op::{Op, Sink};
+use h713_vp::planes::{self, rgb, PlaneState, Rgb};
+use h713_vp::pq;
+use h713_vp::resume::{self, Plan, RegPlan};
+use h713_vp::tables::{self, DEFAULT_LIST};
+
+/// Number of blocks of `struct h713_hw` (`enum h713_blk`).
+const NBLK: usize = 16;
+const BLK_TCON: usize = 8;
+const BLK_CCU: usize = 10;
+const BLK_GAMMA: usize = 12;
+
+/// `struct h713_block`.
+#[repr(C)]
+pub struct H713Block {
+    phys: u32,
+    size: u32,
+    base: *mut c_void,
+}
+
+/// `struct h713_hw`.
+#[repr(C)]
+pub struct H713Hw {
+    blk: [H713Block; NBLK],
+    tse: *const u8,
+    tse_len: usize,
+    nr_base: u32,
+    dram_set: u32,
+    latch_timeout_us: u32,
+    switches_off: u32,
+    pace_write_us: u32,
+    pace_table_us: u32,
+    nr_reserved: u32,
+    pq: *const u8,
+    pq_len: usize,
+    project: *const u8,
+    project_len: usize,
+    logo: *const u8,
+    logo_len: usize,
+    cap_blocked: u32,
+}
+
+/// `struct h713_plane`.
+#[repr(C)]
+pub struct H713Plane {
+    rgb_on: u32,
+    rgb_phys: u32,
+    rgb_pitch: u32,
+    alpha: u32,
+    video_on: u32,
+    video_fmt: u32,
+    width: u32,
+    height: u32,
+    pitch: u32,
+    luma: u32,
+    chroma: u32,
+}
+
+const REPORT_BAD: usize = 4;
+
+/// `struct h713_report`.
+#[repr(C)]
+pub struct H713Report {
+    ops: u32,
+    writes: u32,
+    mismatches: u32,
+    timeouts: u32,
+    check_fails: u32,
+    raster_fails: u32,
+    latch_pending: u32,
+    full_enable: u32,
+    nbad: u32,
+    bad_addr: [u32; REPORT_BAD],
+    bad_expect: [u32; REPORT_BAD],
+    bad_read: [u32; REPORT_BAD],
+    error_addr: u32,
+    cap_skipped: u32,
+}
+
+extern "C" {
+    /// `void h713_drm_sleep_us(u32 us)` of the C side (fsleep).
+    fn h713_drm_sleep_us(us: u32);
+    /// `void h713_drm_udelay(u32 us)` of the C side (udelay, atomic context).
+    fn h713_drm_udelay(us: u32);
+}
+
+/// Poll step of every bounded wait.
+const POLL_STEP_US: u32 = 500;
+
+/// The register mappings of one device.
+struct Mmio<'a> {
+    hw: &'a H713Hw,
+}
+
+impl Mmio<'_> {
+    /// The mapped address of the 32-bit register at physical `addr`, if a block holds it.
+    fn ptr(&self, addr: u32) -> Option<*mut c_void> {
+        if addr % 4 != 0 {
+            return None;
+        }
+        self.hw.blk.iter().find_map(|b| {
+            if b.base.is_null() {
+                return None;
+            }
+            let off = addr.checked_sub(b.phys)?;
+            if off.checked_add(4)? > b.size {
+                return None;
+            }
+            Some(
+                b.base
+                    .cast::<u8>()
+                    .wrapping_add(off as usize)
+                    .cast::<c_void>(),
+            )
+        })
+    }
+
+    fn read(&self, addr: u32) -> Result<u32, i32> {
+        let p = self.ptr(addr).ok_or(EFAULT.to_errno())?;
+        // SAFETY: `p` lies inside a live MMIO mapping the C side made (`struct h713_hw`),
+        // 4-aligned, with 4 bytes left in the block.
+        Ok(unsafe { bindings::readl(p.cast_const()) })
+    }
+
+    fn write(&self, addr: u32, val: u32) -> Result<(), i32> {
+        let p = self.ptr(addr).ok_or(EFAULT.to_errno())?;
+        // SAFETY: as in `read`.
+        unsafe { bindings::writel(val, p) };
+        Ok(())
+    }
+
+    /// The mapped address of the byte register at physical `addr` (the receiver windows are byte
+    /// registers: 32-bit writes there are lost, 50 §1).
+    fn ptr8(&self, addr: u32) -> Option<*mut c_void> {
+        self.hw.blk.iter().find_map(|b| {
+            if b.base.is_null() {
+                return None;
+            }
+            let off = addr.checked_sub(b.phys)?;
+            if off >= b.size {
+                return None;
+            }
+            Some(
+                b.base
+                    .cast::<u8>()
+                    .wrapping_add(off as usize)
+                    .cast::<c_void>(),
+            )
+        })
+    }
+
+    fn read8(&self, addr: u32) -> Result<u8, i32> {
+        let p = self.ptr8(addr).ok_or(EFAULT.to_errno())?;
+        // SAFETY: `p` lies inside a live MMIO mapping the C side made, with a byte left in the
+        // block.
+        Ok(unsafe { bindings::readb(p.cast_const()) })
+    }
+
+    fn write8(&self, addr: u32, val: u8) -> Result<(), i32> {
+        let p = self.ptr8(addr).ok_or(EFAULT.to_errno())?;
+        // SAFETY: as in `read8`.
+        unsafe { bindings::writeb(val, p) };
+        Ok(())
+    }
+
+    fn mapped(&self, blk: usize) -> bool {
+        self.hw.blk.get(blk).is_some_and(|b| !b.base.is_null())
+    }
+}
+
+fn sleep_us(us: u32) {
+    // SAFETY: plain C function; only called from the commit path (process context).
+    unsafe { h713_drm_sleep_us(us) }
+}
+
+/// The executor: a `Sink` that performs each operation at once.
+struct Exec<'a> {
+    io: Mmio<'a>,
+    rep: &'a mut H713Report,
+    in_raster: bool,
+    may_sleep: bool,
+}
+
+impl Exec<'_> {
+    fn bad(&mut self, addr: u32, expect: u32, read: u32) {
+        let i = self.rep.nbad as usize;
+        if let (Some(a), Some(e), Some(r)) = (
+            self.rep.bad_addr.get_mut(i),
+            self.rep.bad_expect.get_mut(i),
+            self.rep.bad_read.get_mut(i),
+        ) {
+            *a = addr;
+            *e = expect;
+            *r = read;
+        }
+        self.rep.nbad = self.rep.nbad.saturating_add(1);
+    }
+
+    /// Reads `addr` until `done(value)` or `timeout_us`; returns (value, done).
+    fn wait(
+        &mut self,
+        addr: u32,
+        timeout_us: u32,
+        done: impl Fn(u32) -> bool,
+    ) -> Result<(u32, bool), i32> {
+        let mut left = timeout_us;
+        loop {
+            let v = self.io.read(addr)?;
+            if done(v) {
+                return Ok((v, true));
+            }
+            if left == 0 || !self.may_sleep {
+                return Ok((v, false));
+            }
+            let step = left.min(POLL_STEP_US);
+            sleep_us(step);
+            left = left.saturating_sub(step);
+        }
+    }
+
+    fn fail_check(&mut self, addr: u32) {
+        self.rep.check_fails = self.rep.check_fails.saturating_add(1);
+        if self.in_raster {
+            self.rep.raster_fails = self.rep.raster_fails.saturating_add(1);
+        }
+        if addr == h713_vp::compose::reg::RGB_LATCH {
+            self.rep.latch_pending = self.rep.latch_pending.saturating_add(1);
+        }
+    }
+}
+
+impl Sink for Exec<'_> {
+    type Error = i32;
+
+    fn step(&mut self, step: &Step) -> Result<(), i32> {
+        self.in_raster = step.name == "raster-check";
+        if step.name == "precondition" {
+            self.rep.full_enable = 1;
+        }
+        Ok(())
+    }
+
+    fn op(&mut self, op: Op) -> Result<(), i32> {
+        self.rep.ops = self.rep.ops.saturating_add(1);
+        let addr = op.addr().unwrap_or(0);
+        // Spec 60: between a suspend and a good TV-side re-init the capture block must not be
+        // touched (the stage-2 data-path reset writes CAP 0x06940400, 40 §4.4); left out, counted.
+        if self.io.hw.cap_blocked != 0 && (hdmi::CAP..hdmi::CAP.wrapping_add(0x1_0000)).contains(&addr) {
+            self.rep.cap_skipped = self.rep.cap_skipped.saturating_add(1);
+            return Ok(());
+        }
+        self.rep.error_addr = addr;
+        match op {
+            Op::Write { .. } | Op::Masked { .. } => {
+                let old = if matches!(op, Op::Masked { .. }) {
+                    self.io.read(addr)?
+                } else {
+                    0
+                };
+                let new = op.result(old).ok_or(EINVAL.to_errno())?;
+                self.io.write(addr, new)?;
+                self.rep.writes = self.rep.writes.saturating_add(1);
+                if !op.reads_back() {
+                    self.rep.error_addr = 0;
+                    return Ok(());
+                }
+                let read = self.io.read(addr)?;
+                if !op.readback_ok(new, read) {
+                    self.rep.mismatches = self.rep.mismatches.saturating_add(1);
+                    self.bad(addr, new, read);
+                }
+            }
+            Op::Delay { us } => {
+                if self.may_sleep {
+                    sleep_us(us);
+                }
+            }
+            Op::Poll {
+                mask,
+                want,
+                timeout_us,
+                ..
+            } => {
+                let (_, ok) = self.wait(addr, timeout_us, |v| v & mask == want)?;
+                if !ok {
+                    self.rep.timeouts = self.rep.timeouts.saturating_add(1);
+                    if self.in_raster {
+                        self.rep.raster_fails = self.rep.raster_fails.saturating_add(1);
+                    }
+                }
+            }
+            Op::Changes {
+                mask, timeout_us, ..
+            } => {
+                let first = self.io.read(addr)?;
+                let (_, ok) = self.wait(addr, timeout_us, |v| (v ^ first) & mask != 0)?;
+                if !ok {
+                    self.fail_check(addr);
+                }
+            }
+            Op::Check {
+                mask, cond, fatal, ..
+            } => {
+                let v = self.io.read(addr)?;
+                if !cond.holds(v & mask) {
+                    self.fail_check(addr);
+                    if fatal {
+                        self.bad(addr, 0, v);
+                        return Err(EIO.to_errno());
+                    }
+                }
+            }
+        }
+        self.rep.error_addr = 0;
+        Ok(())
+    }
+}
+
+fn empty_report() -> H713Report {
+    H713Report {
+        ops: 0,
+        writes: 0,
+        mismatches: 0,
+        timeouts: 0,
+        check_fails: 0,
+        raster_fails: 0,
+        latch_pending: 0,
+        full_enable: 0,
+        nbad: 0,
+        bad_addr: [0; REPORT_BAD],
+        bad_expect: [0; REPORT_BAD],
+        bad_read: [0; REPORT_BAD],
+        error_addr: 0,
+        cap_skipped: 0,
+    }
+}
+
+fn compose_err(e: ComposeError<i32>) -> i32 {
+    match e {
+        ComposeError::Sink(errno) => errno,
+        ComposeError::Config(_) | ComposeError::Table { .. } => EINVAL.to_errno(),
+    }
+}
+
+fn tse(hw: &H713Hw) -> &[u8] {
+    if hw.tse.is_null() || hw.tse_len == 0 {
+        return &[];
+    }
+    // SAFETY: the C side keeps the firmware image (`tse`, `tse_len`) alive while `hw` is in use.
+    unsafe { core::slice::from_raw_parts(hw.tse, hw.tse_len) }
+}
+
+/// The composer configuration of the module parameters; the frame is filled in per commit.
+fn base_config(hw: &H713Hw) -> Config {
+    let mut cfg = Config::new(Frame::contiguous(PixelFormat::Nv12, 1920, 1080, 1920, 0));
+    cfg.nr_buffers = NrBuffers { base: hw.nr_base };
+    cfg.dram_set = match hw.dram_set {
+        1 => DramSet::Minimal40,
+        2 => DramSet::Minimal85,
+        _ => DramSet::Full,
+    };
+    cfg.latch = LatchWait::Poll {
+        timeout_us: hw.latch_timeout_us,
+    };
+    cfg.pacing = Pacing {
+        per_write_us: hw.pace_write_us,
+        between_tables_us: hw.pace_table_us,
+    };
+    let mut bit = 1u32;
+    for s in SWITCHES {
+        if hw.switches_off & bit != 0 {
+            cfg.switches.set(s, false);
+        }
+        bit = bit.wrapping_shl(1);
+    }
+    let io = Mmio { hw };
+    if !io.mapped(BLK_CCU) || !io.mapped(BLK_TCON) {
+        // The precondition reads CCU and TCON words; without them (DT mode) the clock API holds the
+        // clocks.
+        cfg.switches.set(Switch::Precheck, false);
+    }
+    cfg
+}
+
+fn plane_state(p: &H713Plane) -> Result<PlaneState, i32> {
+    let video = if p.video_on != 0 {
+        let format = match p.video_fmt {
+            0 => PixelFormat::Nv12,
+            1 => PixelFormat::Nv16,
+            _ => return Err(EINVAL.to_errno()),
+        };
+        Some(Frame {
+            format,
+            width: p.width,
+            height: p.height,
+            pitch: p.pitch,
+            luma: p.luma,
+            chroma: p.chroma,
+        })
+    } else {
+        None
+    };
+    Ok(PlaneState {
+        rgb: (p.rgb_on != 0).then_some(Rgb {
+            phys: p.rgb_phys,
+            pitch: p.rgb_pitch,
+        }),
+        alpha: u8::try_from(p.alpha).unwrap_or(u8::MAX),
+        video,
+    })
+}
+
+/// `int h713_hw_tse_check(const struct h713_hw *hw)`: the firmware image parses (every group
+/// container walks to its end, 40 §4.1) and the default table list resolves (40 §4.2).
+///
+/// # Safety
+///
+/// `hw` is NULL or points to a live `struct h713_hw`.
+#[no_mangle]
+pub unsafe extern "C" fn h713_hw_tse_check(hw: *const H713Hw) -> i32 {
+    // SAFETY: by this function's contract.
+    let Some(hw) = (unsafe { hw.as_ref() }) else {
+        return EINVAL.to_errno();
+    };
+    let db = tse(hw);
+    if db.is_empty() {
+        return ENODEV.to_errno();
+    }
+    for c in h713_tse::tse::containers(db) {
+        match c {
+            Ok(c) if c.has_groups() => {
+                if c.validate().is_err() {
+                    return EINVAL.to_errno();
+                }
+            }
+            Ok(_) => {}
+            Err(_) => return EINVAL.to_errno(),
+        }
+    }
+    for t in DEFAULT_LIST {
+        if tables::resolve(db, t).is_err() {
+            return EINVAL.to_errno();
+        }
+    }
+    0
+}
+
+/// `int h713_hw_check(const struct h713_hw *hw, const struct h713_plane *plane)`: whether a commit
+/// of `plane` is within what the spec proves (atomic check).
+///
+/// # Safety
+///
+/// Both pointers are NULL or point to live structs.
+#[no_mangle]
+pub unsafe extern "C" fn h713_hw_check(hw: *const H713Hw, plane: *const H713Plane) -> i32 {
+    // SAFETY: by this function's contract.
+    let (Some(hw), Some(plane)) = (unsafe { hw.as_ref() }, unsafe { plane.as_ref() }) else {
+        return EINVAL.to_errno();
+    };
+    let st = match plane_state(plane) {
+        Ok(s) => s,
+        Err(e) => return e,
+    };
+    if let Some(r) = &st.rgb {
+        if planes::rgb_valid(r).is_err() {
+            return EINVAL.to_errno();
+        }
+    }
+    if let Some(f) = st.video {
+        if tse(hw).is_empty() {
+            return ENODEV.to_errno();
+        }
+        let cfg = Config {
+            frame: f,
+            ..base_config(hw)
+        };
+        if cfg.validate().is_err() {
+            return EINVAL.to_errno();
+        }
+        // 05 §6, 12 §M.4: the full set switches the NRC write channels on; their buffers must be
+        // reserved no-map.
+        if cfg.dram_set == DramSet::Full
+            && cfg.switches.on(Switch::DramNrcBorder)
+            && hw.nr_reserved == 0
+        {
+            return EINVAL.to_errno();
+        }
+    }
+    0
+}
+
+/// `int h713_hw_commit(hw, old, new, rep)`: the operations from `old` to `new` (h713-vp
+/// `planes::commit`), executed and read back; `rep` gets the counts.
+///
+/// # Safety
+///
+/// All pointers are NULL or point to live structs; process context (the commit may sleep).
+#[no_mangle]
+pub unsafe extern "C" fn h713_hw_commit(
+    hw: *const H713Hw,
+    old: *const H713Plane,
+    new: *const H713Plane,
+    rep: *mut H713Report,
+) -> i32 {
+    // SAFETY: by this function's contract.
+    let (Some(hw), Some(old), Some(new), Some(rep)) = (
+        unsafe { hw.as_ref() },
+        unsafe { old.as_ref() },
+        unsafe { new.as_ref() },
+        unsafe { rep.as_mut() },
+    ) else {
+        return EINVAL.to_errno();
+    };
+    let (old, new) = match (plane_state(old), plane_state(new)) {
+        (Ok(o), Ok(n)) => (o, n),
+        _ => return EINVAL.to_errno(),
+    };
+    let base = base_config(hw);
+    let mut ex = Exec {
+        io: Mmio { hw },
+        rep,
+        in_raster: false,
+        may_sleep: true,
+    };
+    match planes::commit(&mut ex, &base, tse(hw), &DEFAULT_LIST, &old, &new) {
+        Ok(()) => 0,
+        Err(e) => compose_err(e),
+    }
+}
