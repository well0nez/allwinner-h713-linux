+/* --- the shell's side of h713_hdmirx.h -------------------------------------------------------- */
+
+struct drm_device *h713_hdmi_drm(struct h713_drm *p)
+{
+	return &p->drm;
+}
+
+void h713_hdmi_status(struct h713_drm *p, struct h713_hdmi_status *st)
+{
+	const struct h713_rx_signs *s = &p->signs;
+	u32 i, state = READ_ONCE(p->hdmi_state);
+	bool timing = state >= H713_HDMI_UNSUPPORTED && state <= H713_HDMI_CAPTURING;
+
+	st->state = state;
+	st->width = timing ? s->timing[1] : 0;
+	st->height = timing ? s->timing[7] : 0;
+	st->refresh_mhz = timing ? s->refresh_mhz : 0;
+	for (i = 0; i < 3; i++) {
+		st->ring_luma[i] = p->ring.luma[i];
+		st->ring_chroma[i] = p->ring.chroma[i];
+	}
+}
+
+void h713_hdmi_v4l2_user(struct h713_drm *p, bool get)
+{
+	mutex_lock(&p->hdmi_lock);
+	if (!p->hdmi_gone) {
+		if (get && !p->v4l2_opens++)
+			h713_hdmi_get(p, H713_HDMI_USER_V4L2);
+		else if (!get && p->v4l2_opens && !--p->v4l2_opens)
+			h713_hdmi_put(p, H713_HDMI_USER_V4L2, "the last V4L2 file closed");
+	}
+	mutex_unlock(&p->hdmi_lock);
+}
+
+int h713_hdmi_ring_index(struct h713_drm *p, u32 *write_index, u32 *counter)
+{
+	/* spec 60: never between a suspend and the TV-top re-init; 55 §9: only while capturing */
+	if (READ_ONCE(p->hdmi_gone) || !READ_ONCE(p->rx_safe) || !READ_ONCE(p->cap_on) ||
+	    READ_ONCE(p->hdmi_state) != H713_HDMI_CAPTURING)
+		return -EAGAIN;
+	if (h713_hw_read(&p->hw, 0x06940a0c, write_index) ||
+	    h713_hw_read(&p->hw, 0x06940104, counter))
+		return -EIO;
+	return 0;
+}
+
+int h713_hdmi_get_edid(struct h713_drm *p, u8 *buf, u32 *len)
+{
+	int ret = 0;
+
+	mutex_lock(&p->hdmi_lock);
+	if (p->edid_cleared) {
+		*len = 0;
+	} else if (p->edid_len) {
+		*len = min_t(u32, *len, p->edid_len);
+		memcpy(buf, p->edid_buf, *len);
+	} else {
+#if H713_HAVE_ARISC
+		/* what the socket serves (block 0 with the port's physical address, 57 §3) */
+		ret = hdmi_edid_external ? -ENODATA : arisc_hdmi_get_edid(hdmi_port, buf, min_t(u32, *len, 256));
+		if (ret >= 0) {
+			*len = ret;
+			ret = 0;
+		}
+#else
+		ret = -ENODATA;
+#endif
+	}
+	mutex_unlock(&p->hdmi_lock);
+	return ret;
+}
+
+int h713_hdmi_set_edid(struct h713_drm *p, const u8 *buf, u32 len)
+{
+#if H713_HAVE_ARISC
+	int ret;
+
+	if (hdmi_edid_external)
+		return -ENOTTY;	/* someone else serves EDID and hot-plug */
+	if (len != 0 && len != 256 && len != 512)
+		return -EINVAL;
+	mutex_lock(&p->hdmi_lock);
+	if (!len) {
+		ret = arisc_hdmi_hpd(hdmi_port, ARISC_HDMI_HPD_DOWN);
+		if (!ret)
+			p->edid_cleared = true;
+		drm_info(&p->drm, "hdmi: S_EDID 0 blocks: hot-plug low on port %u: %d\n", hdmi_port, ret);
+		goto out;
+	}
+	/* 57 §3: the provider takes 512 bytes; 256 are served as both halves */
+	memcpy(p->edid_buf, buf, len);
+	if (len == 256)
+		memcpy(p->edid_buf + 256, buf, 256);
+	p->edid_len = 512;
+	p->edid_cleared = false;
+	ret = arisc_hdmi_edid_init(hdmi_port, p->edid_buf, ARISC_HDMI_EDID_SIZE);
+	if (!ret)
+		ret = arisc_hdmi_hpd(hdmi_port, ARISC_HDMI_HPD_UP);
+	p->provider_done = !ret;
+	drm_info(&p->drm, "hdmi: S_EDID %u bytes: uploaded on port %u, hot-plug up: %d\n", len, hdmi_port,
+		 ret);
+out:
+	mutex_unlock(&p->hdmi_lock);
+	return ret;
+#else
+	return -ENOTTY;
+#endif
+}
+
+static void h713_crtc_atomic_flush(struct drm_crtc *crtc, struct h713_atomic *state)
+{
+	struct h713_drm *p = to_h713(crtc->dev);
+	struct drm_pending_vblank_event *event = crtc->state->event;
+	struct h713_plane next = {};
+	struct h713_report rep = {};
+	bool want_hdmi = crtc->state->active &&
+			 to_h713_cs(crtc->state)->video_source == H713_SOURCE_HDMI;
+	/* only commits change hdmi_on; the state machine's lock only when the source switches */
+	bool switching = want_hdmi != !!(p->hdmi_users & H713_HDMI_USER_DRM);
+	int ret;
+
+	if (switching) {
+		mutex_lock(&p->hdmi_lock);
+		if (!want_hdmi)
+			h713_hdmi_put(p, H713_HDMI_USER_DRM, "the video plane shows client buffers again");
+	}
+	mutex_lock(&p->hw_lock);
+	if (crtc->state->active) {
+		h713_desc_primary(p->primary.state, &next);
+		if (want_hdmi)
+			h713_hdmi_video(p, &next);
+		else
+			h713_desc_overlay(p->overlay.state, &next);
+		if (!next.rgb_on)
+			next.alpha = 0xff;
+	}
+	if (memcmp(&next, &p->cur, sizeof(next))) {
+		struct h713_plane prev = p->cur;
+		bool both_new;
+
+		ret = h713_hw_commit(&p->hw, &p->cur, &next, &rep);
+		h713_report_log(p, &next, &rep, ret);
+		if (!ret)
+			p->cur = next;
+		else
+			/* unknown: the next commit starts from "off" */
+			memset(&p->cur, 0, sizeof(p->cur));
+		/*
+		 * 05 §2.1: align when both planes become visible or the video plane was set up anew
+		 */
+		both_new = next.rgb_on && next.video_on &&
+			   (!prev.rgb_on || !prev.video_on || rep.full_enable);
+		if (!ret && align && both_new) {
+			struct drm_crtc_state *old = drm_atomic_get_old_crtc_state(state, crtc);
+
+			/*
+			 * A commit that also enables the CRTC flushes before atomic_enable turns
+			 * vblank on.
+			 */
+			if (old && !old->active)
+				p->align_pending = true;
+			else
+				h713_align(p);
+		}
+	}
+
+	mutex_unlock(&p->hw_lock);
+	if (switching) {
+		if (want_hdmi) {
+			drm_info(&p->drm, "hdmi: the video plane shows the HDMI input\n");
+			h713_hdmi_get(p, H713_HDMI_USER_DRM);
+		}
+		mutex_unlock(&p->hdmi_lock);
+	}
+
+	if (crtc->state->active)
+		h713_pq_commit(p, to_h713_cs(crtc->state), rep.full_enable);
+
+	/*
+	 * 05 §2 R2: the RGB latch is taken at a frame boundary 1.4..13.8 ms after it was written,
+	 * so a latch written just before an RGB done can still be pending at that interrupt (round
+	 * 6: once in 3930 flips). The flip event is therefore sent once the latch reads 0: at the
+	 * RGB done if it already does, else by a timer that polls the latch every H713_FLIP_POLL_US
+	 * after that RGB done (round 7 showed the latch of a flip made right after an RGB done is
+	 * taken shortly after the next one: waiting for the next RGB done halved the flip rate). A
+	 * latch still set after H713_FLIP_POLLS polls waits for the next RGB done; after
+	 * H713_FLIP_WAIT_MAX vblanks the event goes anyway (logged).
+	 */
+	if (event) {
+		crtc->state->event = NULL;
+		if (READ_ONCE(p->flip_event))
+			hrtimer_cancel(&p->flip_timer);
+		spin_lock_irq(&crtc->dev->event_lock);
+		if (crtc->state->active && drm_crtc_vblank_get(crtc) == 0) {
+			/* cannot happen with the helper's commit tracking; never lose one */
+			if (p->flip_event) {
+				drm_crtc_send_vblank_event(crtc, p->flip_event);
+				drm_crtc_vblank_put(crtc);
+			}
+			p->flip_event = event;
+			p->flip_wait = 0;
+		} else {
+			drm_crtc_send_vblank_event(crtc, event);
+		}
+		spin_unlock_irq(&crtc->dev->event_lock);
+	}
+}
