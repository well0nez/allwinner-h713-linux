+pub const TMDS_BYTE: u32 = 0x0680_08fc;
+/// `TMDS_BYTE` bit.
+pub const TMDS_BIT: u8 = 0x80;
+/// The six enables of 50 §8 #85-#90: (address, bits that read set while locked).
+pub const ENABLES: [(u32, u8); 6] = [
+    (0x0684_0006, 0x6a),
+    (0x0684_0010, 0x4d),
+    (0x0684_0012, 0x27),
+    (0x0684_000c, 0x87),
+    (0x0684_000d, 0x8f),
+    (0x0684_000b, 0x01),
+];
