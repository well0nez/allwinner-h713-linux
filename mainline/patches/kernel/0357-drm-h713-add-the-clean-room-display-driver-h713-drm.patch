+
+const BLK_CAP: usize = 9;
+const BLK_RXCTL: usize = 13;
+const BLK_RXLINK: usize = 14;
+const BLK_TVTOP: usize = 15;
+
+/// `struct h713_rx_report`.
+#[repr(C)]
+pub struct H713RxReport {
+    writes: u32,
+    mismatches: u32,
+    skipped_ccu: u32,
+    bad_addr: u32,
+    bad_read: u32,
+}
+
+/// `bool h713_hw_hdmi_mapped(hw)`: the receiver windows, `TVTOP` and the capture block are mapped.
+///
+/// # Safety
+///
+/// `hw` is NULL or live.
+#[no_mangle]
+pub unsafe extern "C" fn h713_hw_hdmi_mapped(hw: *const H713Hw) -> bool {
+    // SAFETY: by this function's contract.
+    unsafe { hw.as_ref() }.is_some_and(|hw| {
+        let io = Mmio { hw };
+        [BLK_CAP, BLK_RXCTL, BLK_RXLINK, BLK_TVTOP]
+            .iter()
+            .all(|&b| io.mapped(b))
+    })
+}
