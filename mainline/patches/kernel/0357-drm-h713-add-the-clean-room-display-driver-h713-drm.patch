+/* --- bench mode: a platform device with the spec's resources ---------------------------------- */
+
+#ifdef H713_DRM_BENCH
+
+static struct platform_device *bench_pdev;
+static unsigned int bench_virq[2];
+
+/*
+ * GIC SPI -> Linux interrupt number, through the GIC's own domain (05 §3: level, SPI 112 and 110).
+ */
+static int bench_map_spi(u32 spi)
+{
+	struct device_node *gic = of_find_compatible_node(NULL, NULL, gic_compat);
+	struct irq_fwspec spec = {};
+	unsigned int virq;
+
+	if (!gic)
+		return -ENODEV;
+	spec.fwnode = of_fwnode_handle(gic);
+	spec.param_count = 3;
+	spec.param[0] = 0;	/* GIC_SPI */
+	spec.param[1] = spi;
+	spec.param[2] = IRQ_TYPE_LEVEL_HIGH;
+	virq = irq_create_fwspec_mapping(&spec);
+	of_node_put(gic);
+	return virq ? virq : -ENXIO;
+}
+
+static int bench_register(void)
+{
+	static const struct { u32 start, size; } blk[H713_NBLK] = {
+		[H713_BLK_SCANOUT] = { 0x05600000, 0x1000 },
+		[H713_BLK_PNL] = { 0x051c0000, 0x10000 },
+		[H713_BLK_PROC] = { 0x05140000, 0x10000 },
+		[H713_BLK_SCL] = { 0x05180000, 0x1000 },
+		[H713_BLK_NRC] = { 0x05000000, 0x2000 },
+		[H713_BLK_DEI] = { 0x050c0000, 0x1000 },
+		[H713_BLK_BORDER] = { 0x05200000, 0x1000 },
+		[H713_BLK_MIX] = { 0x058c0000, 0x2000 },
+		[H713_BLK_TCON] = { 0x05880000, 0x1000 },
+		[H713_BLK_CAP] = { 0x06940000, 0x1000 },
+		[H713_BLK_CCU] = { 0x02001000, 0x1000 },
+		[H713_BLK_RASTER] = { 0x0525c000, 0x1000 },
+		[H713_BLK_GAMMA] = { 0x05208000, 0x2000 },
+		[H713_BLK_RXCTL] = { 0x06800000, 0x4000 },
+		[H713_BLK_RXLINK] = { 0x06840000, 0x2000 },
+		[H713_BLK_TVTOP] = { 0x06e00000, 0x1000 },
+	};
+	struct resource res[H713_NBLK + 2];
+	struct platform_device_info info = {
+		.name = DRV_NAME,
+		.id = PLATFORM_DEVID_NONE,
+		.res = res,
+		.num_res = ARRAY_SIZE(res),
+		.dma_mask = DMA_BIT_MASK(32),
+	};
+	int i, irq;
+
+	for (i = 0; i < H713_NBLK; i++)
+		res[i] = (struct resource)DEFINE_RES_MEM_NAMED(blk[i].start, blk[i].size,
+							       h713_reg_names[i]);
+	irq = bench_map_spi(112);
+	if (irq < 0)
+		return irq;
+	bench_virq[0] = irq;
+	res[H713_NBLK] = (struct resource)DEFINE_RES_IRQ_NAMED(irq, "rgb-done");
+	irq = bench_map_spi(110);
+	if (irq < 0)
+		return irq;
+	bench_virq[1] = irq;
+	res[H713_NBLK + 1] = (struct resource)DEFINE_RES_IRQ_NAMED(irq, "video-vsync");
+
+	bench_pdev = platform_device_register_full(&info);
+	if (IS_ERR(bench_pdev)) {
+		int ret = PTR_ERR(bench_pdev);
+
+		bench_pdev = NULL;
+		return ret;
+	}
+	pr_info("bench device registered (rgb-done irq %u = SPI 112, video-vsync irq %u = SPI 110)\n",
+		bench_virq[0], bench_virq[1]);
+	return 0;
+}
+
+static void bench_unregister(void)
+{
+	int i;
+
+	if (bench_pdev)
+		platform_device_unregister(bench_pdev);
+	bench_pdev = NULL;
+	for (i = 0; i < ARRAY_SIZE(bench_virq); i++)
+		if (bench_virq[i])
+			irq_dispose_mapping(bench_virq[i]);
+}
+
+#else
+static bool bench;
+static int bench_register(void) { return 0; }
+static void bench_unregister(void) { }
+#endif
+
+static int __init h713_drm_init(void)
+{
+	int ret = platform_driver_register(&h713_platform_driver);
+
+	if (ret || !bench)
+		return ret;
+	ret = bench_register();
+	if (ret) {
+		bench_unregister();
+		platform_driver_unregister(&h713_platform_driver);
+	}
+	return ret;
+}
+
+static void __exit h713_drm_exit(void)
+{
+	bench_unregister();
+	platform_driver_unregister(&h713_platform_driver);
+}
+
+module_init(h713_drm_init);
+module_exit(h713_drm_exit);
+
+MODULE_DESCRIPTION(
+	"Allwinner H713 display (clean-room DRM/KMS driver, C shell + Rust hardware layer)");
+MODULE_LICENSE("GPL");
diff --git a/drivers/gpu/drm/h713/h713_hdmirx.c b/drivers/gpu/drm/h713/h713_hdmirx.c
new file mode 100644
index 000000000..ccdd2b389
--- /dev/null
+++ b/drivers/gpu/drm/h713/h713_hdmirx.c
@@ -0,0 +1,828 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * h713_drm: the HDMI receiver as a V4L2 capture device, "h713-hdmirx-clean" (public V4L2 API only).
+ *
+ * - one input ("HDMI"), DV timings: CTA-861 1920x1080p60 only (the one mode measured without the
+ *   display firmware, spec 50 §4, 96); QUERY_DV_TIMINGS returns it while the receiver is locked,
+ *   -ENOLINK without a signal, -ENOLCK with TMDS and no valid timing, -ERANGE with another timing;
+ * - V4L2_EVENT_SOURCE_CHANGE when the lock state or the timing changes;
+ * - G_EDID / S_EDID through the EDID / hot-plug provider (spec 57): 4 blocks (512 bytes, the HDMI
+ *   1.4 and 2.0 halves) or 2 blocks (256 bytes; served as both halves), 0 blocks = hot-plug low;
+ * - streaming (MMAP, multi-planar NV16M: luma and chroma are not contiguous in the ring) of the
+ *   three capture-ring slots, the buffers being the slots themselves: a queued buffer is returned
+ *   when the capture has completed a frame in its slot - slot (CAP 0xa0c + 2) mod 3 once the write
+ *   index has stepped (55 §9), polled every 2 ms (there is no capture interrupt, 55 §9) - and is
+ *   taken back (counted as dropped) when the capture starts writing that slot again before it was
+ *   dequeued. A dequeued buffer stays unchanged until the capture writes its slot again: two source
+ *   frames (about 33 ms at 60 Hz) after it was returned;
+ * - VIDIOC_EXPBUF: each plane as a dma-buf of the reserved ring memory (no struct pages: importers
+ *   get DMA addresses through dma_map_resource, CPU access by mmap).
+ *
+ * The HDMI input is owned by the DRM shell's state machine (h713_hdmirx.h): an open file is a user
+ * of it, so the receiver runs and captures while the device is open, and the CRTC may show the same
+ * ring at the same time. The picture controls of the CRTC are not mirrored as V4L2 controls: they
+ * act on the panel path after the ring (spec 30), not on the captured frames.
+ */
+#define pr_fmt(fmt) KBUILD_MODNAME ": " fmt
+
+#include <linux/dma-buf.h>
+#include <linux/dma-mapping.h>
+#include <linux/hrtimer.h>
+#include <linux/math64.h>
+#include <linux/mm.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+#include <linux/v4l2-dv-timings.h>
+#include <linux/wait.h>
+#include <drm/drm_drv.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-dev.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-dv-timings.h>
+#include <media/v4l2-event.h>
+#include <media/v4l2-fh.h>
+#include <media/v4l2-ioctl.h>
+
+#include "h713_drm.h"
+#include "h713_hdmirx.h"
+
+#define RX_NAME "h713-hdmirx-clean"
+#define RX_W 1920
+#define RX_H 1080
+#define RX_PLANE (RX_W * RX_H)			/* NV16: luma W x H, chroma W x H (Cb/Cr pairs) */
+#define RX_NBUF 3
+#define RX_MMAP_STEP 0x200000			/* mmap offset of (buffer, plane) = (2 * index + plane) x this */
+#define RX_POLL_NS (2 * NSEC_PER_MSEC)
+
+MODULE_IMPORT_NS("DMA_BUF");
+
+static const struct v4l2_dv_timings rx_1080p60 = V4L2_DV_BT_CEA_1920X1080P60;
+
+struct rx_buf {
+	bool queued;		/* the driver may return it */
+	bool done;		/* returned, not yet dequeued */
+	u32 sequence;
+	u64 ts_ns;
+};
+
+struct h713_hdmirx {
+	struct h713_drm *p;
+	struct v4l2_device v4l2;
+	struct video_device vdev;
+	struct mutex lock;		/* the ioctls (video_device.lock) */
+	struct file *owner;		/* the file that holds the buffers (REQBUFS), or NULL */
+	bool streaming;
+	u32 nbufs;
+	spinlock_t qlock;		/* bufs, done ring, last index, counters (the poll timer) */
+	struct rx_buf bufs[RX_NBUF];
+	u8 done_fifo[RX_NBUF];
+	u32 ndone;
+	u32 last_index;			/* 0xff: none seen */
+	u32 sequence;
+	u32 dropped;
+	wait_queue_head_t wait;
+	struct hrtimer timer;
+	u32 last_state;
+	bool unavail_logged;		/* the "unavailable" line was logged in this stretch of the state */
+	unsigned long unavail_at;	/* jiffies of that line */
+};
+
+static struct h713_hdmirx *file_rx(struct file *f)
+{
+	return video_drvdata(f);
+}
+
+/* --- the poll timer: deliver complete slots (55 §9) ------------------------------------------ */
+
+static void rx_done_remove(struct h713_hdmirx *rx, u32 i)
+{
+	u32 k, n = 0;
+
+	for (k = 0; k < rx->ndone; k++)
+		if (rx->done_fifo[k] != i)
+			rx->done_fifo[n++] = rx->done_fifo[k];
+	rx->ndone = n;
+}
+
+static enum hrtimer_restart rx_poll(struct hrtimer *t)
+{
+	struct h713_hdmirx *rx = container_of(t, struct h713_hdmirx, timer);
+	unsigned long flags;
+	u32 idx, counter, slot;
+	bool wake = false;
+
+	if (h713_hdmi_ring_index(rx->p, &idx, &counter))
+		goto again;
+	idx &= 7;
+	if (idx > 2)
+		goto again;
+	spin_lock_irqsave(&rx->qlock, flags);
+	if (idx != rx->last_index) {
+		rx->last_index = idx;
+		/* the slot now written: a returned, not dequeued frame there is overwritten */
+		if (rx->bufs[idx].done) {
+			rx->bufs[idx].done = false;
+			rx->bufs[idx].queued = true;
+			rx_done_remove(rx, idx);
+			rx->dropped++;
+		}
+		/* the last complete frame (55 §9) */
+		slot = (idx + 2) % 3;
+		rx->sequence++;
+		if (rx->bufs[slot].queued && slot < rx->nbufs) {
+			rx->bufs[slot].queued = false;
+			rx->bufs[slot].done = true;
+			rx->bufs[slot].sequence = rx->sequence;
+			rx->bufs[slot].ts_ns = ktime_get_ns();
+			rx->done_fifo[rx->ndone++] = slot;
+			wake = true;
+		} else {
+			rx->dropped++;
+		}
+	}
+	spin_unlock_irqrestore(&rx->qlock, flags);
+	if (wake)
+		wake_up_interruptible(&rx->wait);
+again:
+	hrtimer_forward_now(t, ns_to_ktime(RX_POLL_NS));
+	return HRTIMER_RESTART;
+}
+
+static void rx_stream_stop(struct h713_hdmirx *rx)
+{
+	unsigned long flags;
+	u32 i;
+
+	hrtimer_cancel(&rx->timer);
+	spin_lock_irqsave(&rx->qlock, flags);
+	rx->streaming = false;
+	for (i = 0; i < RX_NBUF; i++)
+		rx->bufs[i] = (struct rx_buf){};
+	rx->ndone = 0;
+	spin_unlock_irqrestore(&rx->qlock, flags);
+	wake_up_interruptible(&rx->wait);
+}
+
+void h713_hdmirx_quiesce(struct h713_hdmirx *rx)
+{
+	if (rx)
+		hrtimer_cancel(&rx->timer);	/* restarted by nothing until a new STREAMON */
+}
+
+void h713_hdmirx_resume(struct h713_hdmirx *rx)
+{
+	if (rx && rx->streaming)
+		hrtimer_start(&rx->timer, ns_to_ktime(RX_POLL_NS), HRTIMER_MODE_REL);
+}
+
+void h713_hdmirx_source_change(struct h713_hdmirx *rx)
+{
+	static const struct v4l2_event ev = {
+		.type = V4L2_EVENT_SOURCE_CHANGE,
+		.u.src_change.changes = V4L2_EVENT_SRC_CH_RESOLUTION,
+	};
+
+	if (rx && video_is_registered(&rx->vdev))
+		v4l2_event_queue(&rx->vdev, &ev);
+}
+
+/* --- file operations ------------------------------------------------------------------------- */
+
+static int rx_open(struct file *f)
+{
+	struct h713_hdmirx *rx = file_rx(f);
+	int ret = v4l2_fh_open(f);
+
+	if (ret)
+		return ret;
+	drm_dev_get(h713_hdmi_drm(rx->p));	/* the shell's memory outlives this file */
+	h713_hdmi_v4l2_user(rx->p, true);
+	return 0;
+}
+
+static int rx_release(struct file *f)
+{
+	struct h713_hdmirx *rx = file_rx(f);
+	struct drm_device *drm = h713_hdmi_drm(rx->p);
+
+	mutex_lock(&rx->lock);
+	if (rx->owner == f) {
+		rx_stream_stop(rx);
+		rx->owner = NULL;
+		rx->nbufs = 0;
+	}
+	mutex_unlock(&rx->lock);
+	h713_hdmi_v4l2_user(rx->p, false);
+	v4l2_fh_release(f);
+	drm_dev_put(drm);
+	return 0;
+}
+
+static __poll_t rx_poll_file(struct file *f, struct poll_table_struct *wait)
+{
+	struct h713_hdmirx *rx = file_rx(f);
+	__poll_t mask = v4l2_ctrl_poll(f, wait);
+	unsigned long flags;
+
+	poll_wait(f, &rx->wait, wait);
+	spin_lock_irqsave(&rx->qlock, flags);
+	if (rx->owner == f && rx->ndone)
+		mask |= EPOLLIN | EPOLLRDNORM;
+	spin_unlock_irqrestore(&rx->qlock, flags);
+	return mask;
+}
+
+static int rx_plane_of(struct h713_hdmirx *rx, unsigned long off, phys_addr_t *phys)
+{
+	struct h713_hdmi_status st;
+	u32 n = off / RX_MMAP_STEP;
+
+	if (off % RX_MMAP_STEP || n >= 2 * RX_NBUF)
+		return -EINVAL;
+	h713_hdmi_status(rx->p, &st);
+	*phys = (n & 1) ? st.ring_chroma[n / 2] : st.ring_luma[n / 2];
+	return 0;
+}
+
+static int rx_remap(struct vm_area_struct *vma, phys_addr_t phys)
+{
+	unsigned long size = vma->vm_end - vma->vm_start;
+
+	if (size > PAGE_ALIGN(RX_PLANE))
+		return -EINVAL;
+	vma->vm_page_prot = pgprot_writecombine(vma->vm_page_prot);
+	vm_flags_set(vma, VM_IO | VM_DONTEXPAND | VM_DONTDUMP);
+	return io_remap_pfn_range(vma, vma->vm_start, phys >> PAGE_SHIFT, size, vma->vm_page_prot);
+}
+
+static int rx_mmap(struct file *f, struct vm_area_struct *vma)
+{
+	struct h713_hdmirx *rx = file_rx(f);
+	phys_addr_t phys;
+	int ret;
+
+	ret = rx_plane_of(rx, vma->vm_pgoff << PAGE_SHIFT, &phys);
+	if (ret)
+		return ret;
+	return rx_remap(vma, phys);
+}
+
+static const struct v4l2_file_operations rx_fops = {
+	.owner = THIS_MODULE,
+	.open = rx_open,
+	.release = rx_release,
+	.unlocked_ioctl = video_ioctl2,
+	.poll = rx_poll_file,
+	.mmap = rx_mmap,
+};
+
+/* --- dma-buf export of one ring plane ----------------------------------------------------------- */
+
+struct rx_dmabuf {
+	phys_addr_t phys;
+	size_t size;
+	struct drm_device *drm;
+};
+
+static struct sg_table *rx_map(struct dma_buf_attachment *a, enum dma_data_direction dir)
+{
+	struct rx_dmabuf *b = a->dmabuf->priv;
+	struct sg_table *sgt;
+	dma_addr_t addr;
+	int ret;
+
+	sgt = kzalloc(sizeof(*sgt), GFP_KERNEL);
+	if (!sgt)
+		return ERR_PTR(-ENOMEM);
+	ret = sg_alloc_table(sgt, 1, GFP_KERNEL);
+	if (ret)
+		goto free;
+	addr = dma_map_resource(a->dev, b->phys, b->size, dir, DMA_ATTR_SKIP_CPU_SYNC);
+	ret = dma_mapping_error(a->dev, addr);
+	if (ret) {
+		sg_free_table(sgt);
+		goto free;
+	}
+	sg_dma_address(sgt->sgl) = addr;
+	sg_dma_len(sgt->sgl) = b->size;
+	return sgt;
+free:
+	kfree(sgt);
+	return ERR_PTR(ret);
+}
+
+static void rx_unmap(struct dma_buf_attachment *a, struct sg_table *sgt,
+		     enum dma_data_direction dir)
+{
+	struct rx_dmabuf *b = a->dmabuf->priv;
+
+	dma_unmap_resource(a->dev, sg_dma_address(sgt->sgl), b->size, dir, DMA_ATTR_SKIP_CPU_SYNC);
+	sg_free_table(sgt);
+	kfree(sgt);
+}
+
+static void rx_dmabuf_release(struct dma_buf *d)
+{
+	struct rx_dmabuf *b = d->priv;
+
+	drm_dev_put(b->drm);
+	kfree(b);
+}
+
+static int rx_dmabuf_mmap(struct dma_buf *d, struct vm_area_struct *vma)
+{
+	struct rx_dmabuf *b = d->priv;
+
+	if (vma->vm_pgoff)
+		return -EINVAL;
+	return rx_remap(vma, b->phys);
+}
+
+static const struct dma_buf_ops rx_dmabuf_ops = {
+	.map_dma_buf = rx_map,
+	.unmap_dma_buf = rx_unmap,
+	.release = rx_dmabuf_release,
+	.mmap = rx_dmabuf_mmap,
+};
+
+/* --- ioctls ----------------------------------------------------------------------------------- */
+
+static int rx_querycap(struct file *f, void *priv, struct v4l2_capability *cap)
+{
+	/* driver = the module (16 bytes, the usual convention); the device's name stays RX_NAME */
+	strscpy(cap->driver, KBUILD_MODNAME, sizeof(cap->driver));
+	strscpy(cap->card, RX_NAME, sizeof(cap->card));
+	strscpy(cap->bus_info, "platform:h713-drm", sizeof(cap->bus_info));
+	return 0;
+}
+
+static u32 rx_input_status(struct h713_hdmirx *rx)
+{
+	struct h713_hdmi_status st;
+
+	h713_hdmi_status(rx->p, &st);
+	switch (st.state) {
+	case H713_HDMI_LOCKED:
+	case H713_HDMI_CAPTURING:
+		return 0;
+	case H713_HDMI_TMDS:
+	case H713_HDMI_UNSUPPORTED:
+		return V4L2_IN_ST_NO_SYNC;
+	default:
+		return V4L2_IN_ST_NO_SIGNAL;
+	}
+}
+
+static int rx_enum_input(struct file *f, void *priv, struct v4l2_input *in)
+{
+	if (in->index)
+		return -EINVAL;
+	strscpy(in->name, "HDMI", sizeof(in->name));
+	in->type = V4L2_INPUT_TYPE_CAMERA;
+	in->capabilities = V4L2_IN_CAP_DV_TIMINGS;
+	in->status = rx_input_status(file_rx(f));
+	return 0;
+}
+
+static int rx_g_input(struct file *f, void *priv, unsigned int *i)
+{
+	*i = 0;
+	return 0;
+}
+
+static int rx_s_input(struct file *f, void *priv, unsigned int i)
+{
+	return i ? -EINVAL : 0;
+}
+
+static int rx_query_dv_timings(struct file *f, void *priv, struct v4l2_dv_timings *t)
+{
+	struct h713_hdmirx *rx = file_rx(f);
+	struct h713_hdmi_status st;
+
+	h713_hdmi_status(rx->p, &st);
+	if (st.state != H713_HDMI_UNAVAILABLE)
+		rx->unavail_logged = false;
+	switch (st.state) {
+	case H713_HDMI_LOCKED:
+	case H713_HDMI_CAPTURING:
+		*t = rx_1080p60;
+		return 0;
+	case H713_HDMI_TMDS:
+		return -ENOLCK;
+	case H713_HDMI_UNSUPPORTED:
+		return -ERANGE;
+	case H713_HDMI_UNAVAILABLE:
+		/* once when the state is entered, then at most once a minute while it is polled */
+		if (!rx->unavail_logged || time_after(jiffies, rx->unavail_at + 60 * HZ)) {
+			dev_info(rx->v4l2.dev,
+				 "hdmirx: unavailable after a deep sleep (spec 60 v4): reboot to use the HDMI input\n");
+			rx->unavail_logged = true;
+			rx->unavail_at = jiffies;
+		}
+		return -ENOLINK;
+	default:
+		return -ENOLINK;
+	}
+}
+
+static int rx_g_dv_timings(struct file *f, void *priv, struct v4l2_dv_timings *t)
+{
+	*t = rx_1080p60;	/* the only timing this receiver is set up for */
+	return 0;
+}
+
+static int rx_s_dv_timings(struct file *f, void *priv, struct v4l2_dv_timings *t)
+{
+	if (!v4l2_match_dv_timings(t, &rx_1080p60, 0, false))
+		return -EINVAL;
+	*t = rx_1080p60;
+	return 0;
+}
+
+static int rx_enum_dv_timings(struct file *f, void *priv, struct v4l2_enum_dv_timings *t)
+{
+	if (t->pad || t->index)
+		return -EINVAL;
+	t->timings = rx_1080p60;
+	return 0;
+}
+
+static int rx_dv_timings_cap(struct file *f, void *priv, struct v4l2_dv_timings_cap *cap)
+{
+	if (cap->pad)
+		return -EINVAL;
+	cap->type = V4L2_DV_BT_656_1120;
+	cap->bt.min_width = cap->bt.max_width = RX_W;
+	cap->bt.min_height = cap->bt.max_height = RX_H;
+	cap->bt.min_pixelclock = cap->bt.max_pixelclock = 148500000;
+	cap->bt.standards = V4L2_DV_BT_STD_CEA861;
+	cap->bt.capabilities = V4L2_DV_BT_CAP_PROGRESSIVE;
+	return 0;
+}
+
+static int rx_g_edid(struct file *f, void *priv, struct v4l2_edid *e)
+{
+	u8 buf[512];
+	u32 len = sizeof(buf), blocks;
+	int ret;
+
+	if (e->pad)
+		return -EINVAL;
+	ret = h713_hdmi_get_edid(file_rx(f)->p, buf, &len);
+	if (ret)
+		return ret;
+	blocks = len / 128;
+	if (!e->start_block && !e->blocks) {
+		e->blocks = blocks;
+		return 0;
+	}
+	if (!blocks)
+		return -ENODATA;
+	if (e->start_block >= blocks)
+		return -EINVAL;
+	e->blocks = min(e->blocks, blocks - e->start_block);
+	memcpy(e->edid, buf + e->start_block * 128, e->blocks * 128);
+	return 0;
+}
+
+static int rx_s_edid(struct file *f, void *priv, struct v4l2_edid *e)
+{
+	memset(e->reserved, 0, sizeof(e->reserved));
+	if (e->pad || e->start_block)
+		return -EINVAL;
+	if (e->blocks > 4) {
+		e->blocks = 4;
+		return -E2BIG;
+	}
+	if (e->blocks && e->blocks != 2 && e->blocks != 4)
+		return -EINVAL;
+	return h713_hdmi_set_edid(file_rx(f)->p, e->edid, e->blocks * 128);
+}
+
+static int rx_enum_fmt(struct file *f, void *priv, struct v4l2_fmtdesc *d)
+{
+	if (d->index)
+		return -EINVAL;
+	d->pixelformat = V4L2_PIX_FMT_NV16M;
+	return 0;
+}
+
+static int rx_fmt(struct file *f, void *priv, struct v4l2_format *fmt)
+{
+	struct v4l2_pix_format_mplane *mp = &fmt->fmt.pix_mp;
+	u32 i;
+
+	memset(mp, 0, sizeof(*mp));
+	mp->width = RX_W;
+	mp->height = RX_H;
+	mp->pixelformat = V4L2_PIX_FMT_NV16M;
+	mp->field = V4L2_FIELD_NONE;
+	mp->colorspace = V4L2_COLORSPACE_REC709;
+	mp->num_planes = 2;
+	for (i = 0; i < 2; i++) {
+		mp->plane_fmt[i].bytesperline = RX_W;
+		mp->plane_fmt[i].sizeimage = RX_PLANE;
+	}
+	return 0;
+}
+
+static int rx_reqbufs(struct file *f, void *priv, struct v4l2_requestbuffers *r)
+{
+	struct h713_hdmirx *rx = file_rx(f);
+
+	if (r->type != V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE || r->memory != V4L2_MEMORY_MMAP)
+		return -EINVAL;
+	if (rx->owner && rx->owner != f)
+		return -EBUSY;
+	r->capabilities = V4L2_BUF_CAP_SUPPORTS_MMAP;
+	if (!r->count) {
+		rx_stream_stop(rx);
+		rx->owner = NULL;
+		rx->nbufs = 0;
+		return 0;
+	}
+	if (rx->streaming)
+		return -EBUSY;
+	r->count = RX_NBUF;	/* the buffers are the three ring slots */
+	rx->nbufs = RX_NBUF;
+	rx->owner = f;
+	return 0;
+}
+
+static int rx_fill_buf(struct h713_hdmirx *rx, struct v4l2_buffer *b)
+{
+	struct rx_buf *rb;
+	u32 i;
+
+	if (b->type != V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE || b->index >= rx->nbufs)
+		return -EINVAL;
+	if (!b->m.planes || b->length < 2)
+		return -EINVAL;
+	rb = &rx->bufs[b->index];
+	b->memory = V4L2_MEMORY_MMAP;
+	b->field = V4L2_FIELD_NONE;
+	b->length = 2;
+	b->flags = V4L2_BUF_FLAG_TIMESTAMP_MONOTONIC | V4L2_BUF_FLAG_TSTAMP_SRC_SOE;
+	if (rb->queued)
+		b->flags |= V4L2_BUF_FLAG_QUEUED;
+	if (rb->done)
+		b->flags |= V4L2_BUF_FLAG_DONE;
+	b->sequence = rb->sequence;
+	b->timestamp.tv_sec = div_u64_rem(rb->ts_ns, NSEC_PER_SEC, &i);
+	b->timestamp.tv_usec = i / NSEC_PER_USEC;
+	for (i = 0; i < 2; i++) {
+		b->m.planes[i].length = RX_PLANE;
+		b->m.planes[i].bytesused = RX_PLANE;
+		b->m.planes[i].data_offset = 0;
+		b->m.planes[i].m.mem_offset = (2 * b->index + i) * RX_MMAP_STEP;
+	}
+	return 0;
+}
+
+static int rx_querybuf(struct file *f, void *priv, struct v4l2_buffer *b)
+{
+	struct h713_hdmirx *rx = file_rx(f);
+	unsigned long flags;
+	int ret;
+
+	spin_lock_irqsave(&rx->qlock, flags);
+	ret = rx_fill_buf(rx, b);
+	spin_unlock_irqrestore(&rx->qlock, flags);
+	return ret;
+}
+
+static int rx_qbuf(struct file *f, void *priv, struct v4l2_buffer *b)
+{
+	struct h713_hdmirx *rx = file_rx(f);
+	unsigned long flags;
+	int ret = -EINVAL;
+
+	if (rx->owner != f)
+		return -EBUSY;
+	spin_lock_irqsave(&rx->qlock, flags);
+	if (b->index < rx->nbufs && !rx->bufs[b->index].queued && !rx->bufs[b->index].done) {
+		rx->bufs[b->index].queued = true;
+		ret = rx_fill_buf(rx, b);
+	}
+	spin_unlock_irqrestore(&rx->qlock, flags);
+	return ret;
+}
+
+static bool rx_have_done(struct h713_hdmirx *rx)
+{
+	unsigned long flags;
+	bool r;
+
+	spin_lock_irqsave(&rx->qlock, flags);
+	r = rx->ndone || !rx->streaming;
+	spin_unlock_irqrestore(&rx->qlock, flags);
+	return r;
+}
+
+static int rx_dqbuf(struct file *f, void *priv, struct v4l2_buffer *b)
+{
+	struct h713_hdmirx *rx = file_rx(f);
+	unsigned long flags;
+	u32 i, k;
+	int ret;
+
+	if (rx->owner != f)
+		return -EBUSY;
+	for (;;) {
+		spin_lock_irqsave(&rx->qlock, flags);
+		if (!rx->streaming) {
+			spin_unlock_irqrestore(&rx->qlock, flags);
+			return -EINVAL;
+		}
+		if (rx->ndone) {
+			i = rx->done_fifo[0];
+			for (k = 1; k < rx->ndone; k++)
+				rx->done_fifo[k - 1] = rx->done_fifo[k];
+			rx->ndone--;
+			b->index = i;
+			ret = rx_fill_buf(rx, b);
+			rx->bufs[i].done = false;
+			b->flags &= ~V4L2_BUF_FLAG_DONE;
+			spin_unlock_irqrestore(&rx->qlock, flags);
+			return ret;
+		}
+		spin_unlock_irqrestore(&rx->qlock, flags);
+		if (f->f_flags & O_NONBLOCK)
+			return -EAGAIN;
+		/* the ioctl lock is dropped while waiting, so QBUF/STREAMOFF from other threads run */
+		mutex_unlock(&rx->lock);
+		ret = wait_event_interruptible(rx->wait, rx_have_done(rx));
+		mutex_lock(&rx->lock);
+		if (ret)
+			return ret;
+	}
+}
+
+static int rx_expbuf(struct file *f, void *priv, struct v4l2_exportbuffer *e)
+{
+	struct h713_hdmirx *rx = file_rx(f);
+	DEFINE_DMA_BUF_EXPORT_INFO(info);
+	struct h713_hdmi_status st;
+	struct dma_buf *d;
+	struct rx_dmabuf *b;
+	int fd;
+
+	if (e->type != V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE || e->index >= RX_NBUF || e->plane > 1)
+		return -EINVAL;
+	if (e->flags & ~(O_CLOEXEC | O_ACCMODE))
+		return -EINVAL;
+	h713_hdmi_status(rx->p, &st);
+	b = kzalloc(sizeof(*b), GFP_KERNEL);
+	if (!b)
+		return -ENOMEM;
+	b->phys = e->plane ? st.ring_chroma[e->index] : st.ring_luma[e->index];
+	b->size = PAGE_ALIGN(RX_PLANE);
+	b->drm = h713_hdmi_drm(rx->p);
+	drm_dev_get(b->drm);
+	info.ops = &rx_dmabuf_ops;
+	info.size = b->size;
+	info.flags = O_RDWR;
+	info.priv = b;
+	d = dma_buf_export(&info);
+	if (IS_ERR(d)) {
+		drm_dev_put(b->drm);
+		kfree(b);
+		return PTR_ERR(d);
+	}
+	fd = dma_buf_fd(d, e->flags & O_CLOEXEC);
+	if (fd < 0) {
+		dma_buf_put(d);	/* releases b */
+		return fd;
+	}
+	e->fd = fd;
+	return 0;
+}
+
+static int rx_streamon(struct file *f, void *priv, enum v4l2_buf_type t)
+{
+	struct h713_hdmirx *rx = file_rx(f);
+	unsigned long flags;
+
+	if (t != V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE)
+		return -EINVAL;
+	if (rx->owner != f || !rx->nbufs)
+		return -EINVAL;
+	if (rx->streaming)
+		return 0;
+	spin_lock_irqsave(&rx->qlock, flags);
+	rx->streaming = true;
+	rx->last_index = 0xff;
+	rx->ndone = 0;
+	rx->dropped = 0;
+	spin_unlock_irqrestore(&rx->qlock, flags);
+	hrtimer_start(&rx->timer, ns_to_ktime(RX_POLL_NS), HRTIMER_MODE_REL);
+	return 0;
+}
+
+static int rx_streamoff(struct file *f, void *priv, enum v4l2_buf_type t)
+{
+	struct h713_hdmirx *rx = file_rx(f);
+
+	if (t != V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE)
+		return -EINVAL;
+	if (rx->owner != f)
+		return -EBUSY;
+	if (rx->streaming)
+		dev_info(rx->v4l2.dev, "hdmirx: stream off: %u frames, %u dropped\n", rx->sequence,
+			 rx->dropped);
+	rx_stream_stop(rx);
+	return 0;
+}
+
+static int rx_subscribe(struct v4l2_fh *fh, const struct v4l2_event_subscription *sub)
+{
+	if (sub->type == V4L2_EVENT_SOURCE_CHANGE)
+		return v4l2_src_change_event_subscribe(fh, sub);
+	return -EINVAL;
+}
+
+static const struct v4l2_ioctl_ops rx_ioctl_ops = {
+	.vidioc_querycap = rx_querycap,
+	.vidioc_enum_input = rx_enum_input,
+	.vidioc_g_input = rx_g_input,
+	.vidioc_s_input = rx_s_input,
+	.vidioc_query_dv_timings = rx_query_dv_timings,
+	.vidioc_g_dv_timings = rx_g_dv_timings,
+	.vidioc_s_dv_timings = rx_s_dv_timings,
+	.vidioc_enum_dv_timings = rx_enum_dv_timings,
+	.vidioc_dv_timings_cap = rx_dv_timings_cap,
+	.vidioc_g_edid = rx_g_edid,
+	.vidioc_s_edid = rx_s_edid,
+	.vidioc_enum_fmt_vid_cap = rx_enum_fmt,
+	.vidioc_g_fmt_vid_cap_mplane = rx_fmt,
+	.vidioc_s_fmt_vid_cap_mplane = rx_fmt,
+	.vidioc_try_fmt_vid_cap_mplane = rx_fmt,
+	.vidioc_reqbufs = rx_reqbufs,
+	.vidioc_querybuf = rx_querybuf,
+	.vidioc_qbuf = rx_qbuf,
+	.vidioc_dqbuf = rx_dqbuf,
+	.vidioc_expbuf = rx_expbuf,
+	.vidioc_streamon = rx_streamon,
+	.vidioc_streamoff = rx_streamoff,
+	.vidioc_subscribe_event = rx_subscribe,
+	.vidioc_unsubscribe_event = v4l2_event_unsubscribe,
+};
+
+/* --- registration ------------------------------------------------------------------------------ */
+
+static void rx_vdev_release(struct video_device *vdev)
+{
+	kfree(container_of(vdev, struct h713_hdmirx, vdev));
+}
+
+int h713_hdmirx_register(struct h713_drm *p, struct device *dev, struct h713_hdmirx **out)
+{
+	struct h713_hdmirx *rx;
+	int ret;
+
+	*out = NULL;
+	/* freed by the video device's release: open files may outlive the unbind */
+	rx = kzalloc(sizeof(*rx), GFP_KERNEL);
+	if (!rx)
+		return -ENOMEM;
+	rx->p = p;
+	mutex_init(&rx->lock);
+	spin_lock_init(&rx->qlock);
+	init_waitqueue_head(&rx->wait);
+	hrtimer_setup(&rx->timer, rx_poll, CLOCK_MONOTONIC, HRTIMER_MODE_REL);
+	rx->last_index = 0xff;
+	ret = v4l2_device_register(dev, &rx->v4l2);
+	if (ret) {
+		kfree(rx);
+		return ret;
+	}
+	strscpy(rx->vdev.name, RX_NAME, sizeof(rx->vdev.name));
+	rx->vdev.v4l2_dev = &rx->v4l2;
+	rx->vdev.fops = &rx_fops;
+	rx->vdev.ioctl_ops = &rx_ioctl_ops;
+	rx->vdev.lock = &rx->lock;
+	rx->vdev.release = rx_vdev_release;
+	rx->vdev.vfl_dir = VFL_DIR_RX;
+	rx->vdev.device_caps = V4L2_CAP_VIDEO_CAPTURE_MPLANE | V4L2_CAP_STREAMING;
+	video_set_drvdata(&rx->vdev, rx);
+	ret = video_register_device(&rx->vdev, VFL_TYPE_VIDEO, -1);
+	if (ret) {
+		v4l2_device_unregister(&rx->v4l2);
+		kfree(rx);
+		return ret;
+	}
+	dev_info(dev, "hdmirx: %s registered as %s\n", RX_NAME, video_device_node_name(&rx->vdev));
+	*out = rx;
+	return 0;
+}
+
+void h713_hdmirx_unregister(struct h713_hdmirx *rx)
+{
+	if (!rx)
+		return;
+	video_unregister_device(&rx->vdev);
+	hrtimer_cancel(&rx->timer);
+	v4l2_device_unregister(&rx->v4l2);
+}
