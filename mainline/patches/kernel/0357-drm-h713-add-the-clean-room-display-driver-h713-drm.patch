+static int h713_crtc_set_property(struct drm_crtc *crtc, struct drm_crtc_state *state,
+				  struct drm_property *property, u64 val)
+{
+	struct h713_drm *p = to_h713(crtc->dev);
+	u32 i;
+
+	for (i = 0; i < H713_PQ_N; i++) {
+		if (p->pq_prop[i] == property) {
+			/* the range property has checked the bounds */
+			to_h713_cs(state)->pq[i] = val;
+			return 0;
+		}
+	}
+	if (p->hdmi_source_prop && property == p->hdmi_source_prop) {
+		to_h713_cs(state)->video_source = val;
+		return 0;
+	}
+	return -EINVAL;
+}
+
+static int h713_crtc_get_property(struct drm_crtc *crtc, const struct drm_crtc_state *state,
+				  struct drm_property *property, u64 *val)
+{
+	struct h713_drm *p = to_h713(crtc->dev);
+	u32 i;
+
+	for (i = 0; i < H713_PQ_N; i++) {
+		if (p->pq_prop[i] == property) {
+			*val = to_h713_cs(state)->pq[i];
+			return 0;
+		}
+	}
+	if (p->hdmi_source_prop && property == p->hdmi_source_prop) {
+		*val = to_h713_cs(state)->video_source;
+		return 0;
+	}
+	return -EINVAL;
+}
