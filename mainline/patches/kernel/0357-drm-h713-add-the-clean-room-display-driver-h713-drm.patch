+/* --- interrupt -------------------------------------------------------------------------------- */
+
+#define H713_RGB_LATCH 0x05600144	/* spec 05 §1.2 / §2 R2 */
+#define H713_FLIP_WAIT_MAX 3		/* vblanks a flip event waits for the latch at most */
+#define H713_FLIP_POLL_US 100		/* latch poll period after an RGB done */
+#define H713_FLIP_POLLS 40		/* polls per RGB done (4 ms of the 15.26 ms frame) */
+
+/* event_lock held */
+static void h713_flip_send(struct h713_drm *p)
+{
+	drm_crtc_send_vblank_event(&p->crtc, p->flip_event);
+	p->flip_event = NULL;
+	drm_crtc_vblank_put(&p->crtc);
+}
+
+/* event_lock held: sends the flip event if the RGB latch has been taken (05 §2 R2) */
+static bool h713_flip_try(struct h713_drm *p)
+{
+	u32 latch = 1;
+
+	if (h713_hw_read(&p->hw, H713_RGB_LATCH, &latch) || (latch & 1))
+		return false;
+	h713_flip_send(p);
+	return true;
+}
+
+static enum hrtimer_restart h713_flip_poll(struct hrtimer *t)
+{
+	struct h713_drm *p = container_of(t, struct h713_drm, flip_timer);
+	enum hrtimer_restart again = HRTIMER_NORESTART;
+	unsigned long flags;
+
+	spin_lock_irqsave(&p->drm.event_lock, flags);
+	if (p->flip_event) {
+		p->flip_polls++;
+		if (h713_flip_try(p)) {
+			p->flip_at_poll++;
+			p->flip_poll_max = max(p->flip_poll_max, p->flip_polls);
+		} else if (p->flip_polls < H713_FLIP_POLLS) {
+			hrtimer_forward_now(t, ns_to_ktime(H713_FLIP_POLL_US * NSEC_PER_USEC));
+			again = HRTIMER_RESTART;
+		} else {
+			p->flip_late++;	/* waits for the next RGB done */
+		}
+	}
+	spin_unlock_irqrestore(&p->drm.event_lock, flags);
+	return again;
+}
+
+static irqreturn_t h713_irq(int irq, void *arg)
+{
+	struct h713_drm *p = arg;
+	u64 now;
+
+	if (!h713_hw_vblank_ack(&p->hw))
+		return IRQ_NONE;
+	now = ktime_get_ns();
+	spin_lock(&p->al_lock);
+	/*
+	 * 05 §2.1 B4: the RASTER word is written right after one RGB done and restored right after
+	 * the last frame.
+	 */
+	if (p->rs_state == RS_ARMED) {
+		h713_hw_raster_set(&p->hw, p->rs_word);
+		p->rs_state = RS_RUNNING;
+	} else if (p->rs_state == RS_RUNNING && --p->rs_left == 0) {
+		h713_hw_raster_set(&p->hw, H713_RASTER_HANDOFF);
+		p->rs_state = RS_DONE;
+	}
+	/* B3: video vsync -> next RGB done */
+	if (p->al_sampling && p->al_vsync_ns > p->al_done_ns &&
+	    p->al_nsamples < ARRAY_SIZE(p->al_samples))
+		p->al_samples[p->al_nsamples++] = now - p->al_vsync_ns;
+	p->al_done_ns = now;
+	p->al_frames++;
+	if (p->pq_npending) {
+		u32 bad = 0, n = p->pq_npending;
+		int ret = h713_hw_pq_apply(&p->hw, p->pq_pending, n, &bad);
+
+		p->pq_npending = 0;
+		spin_unlock(&p->al_lock);
+		dev_info(p->drm.dev,
+			 "pq: %u words written in vblank: %d, %u read-back mismatches\n", n, ret,
+			 bad);
+		drm_crtc_vblank_put(&p->crtc);
+		spin_lock(&p->al_lock);
+	}
+	spin_unlock(&p->al_lock);
+	wake_up(&p->al_wq);
+	p->vblanks++;
+	drm_crtc_handle_vblank(&p->crtc);
+	spin_lock(&p->drm.event_lock);
+	if (p->flip_event) {
+		if (h713_flip_try(p)) {
+			p->flip_at_irq++;
+		} else if (++p->flip_wait >= H713_FLIP_WAIT_MAX) {
+			dev_warn_ratelimited(p->drm.dev, "RGB latch not taken after %u vblanks\n",
+					     p->flip_wait);
+			h713_flip_send(p);
+		} else {
+			p->flip_polls = 0;
+			hrtimer_start(&p->flip_timer,
+				      ns_to_ktime(H713_FLIP_POLL_US * NSEC_PER_USEC),
+				      HRTIMER_MODE_REL);
+		}
+	}
+	spin_unlock(&p->drm.event_lock);
+	return IRQ_HANDLED;
+}
+
+static irqreturn_t h713_vsync_irq(int irq, void *arg)
+{
+	struct h713_drm *p = arg;
+
+	if (!h713_hw_video_vsync_ack(&p->hw))
+		return IRQ_NONE;
+	spin_lock(&p->al_lock);
+	p->al_vsync_ns = ktime_get_ns();
+	/* 55 §5: point channel 0 at the last complete ring slot; the address takes at the next vsync */
+	if (p->ring_live)
+		h713_hw_ring_tick(&p->hw, &p->rot, p->ring.luma[0]);
+	spin_unlock(&p->al_lock);
+	return IRQ_HANDLED;
+}
+
+/* --- raster alignment services (h713_align_ops) ----------------------------------------------- */
+
+#define H713_FRAME_MS 16	/* one 65.5 Hz frame, rounded up */
+
+static int h713_cmp_u64(const void *a, const void *b)
+{
+	u64 x = *(const u64 *)a, y = *(const u64 *)b;
+
+	return x < y ? -1 : x > y;
+}
+
+static int h713_al_delay(void *cookie, u32 samples, u64 *median)
+{
+	struct h713_drm *p = cookie;
+	unsigned long flags;
+	u64 buf[32];
+	u32 n;
+
+	samples = clamp_t(u32, samples, 1, ARRAY_SIZE(p->al_samples));
+	spin_lock_irqsave(&p->al_lock, flags);
+	p->al_nsamples = 0;
+	p->al_vsync_ns = 0;
+	p->al_sampling = true;
+	spin_unlock_irqrestore(&p->al_lock, flags);
+	h713_hw_video_vsync_irq(&p->hw, true);
+	wait_event_timeout(p->al_wq, READ_ONCE(p->al_nsamples) >= samples,
+			   msecs_to_jiffies((samples + 4) * 2 * H713_FRAME_MS));
+	if (!READ_ONCE(p->ring_live))	/* the HDMI ring rotation keeps it on */
+		h713_hw_video_vsync_irq(&p->hw, false);
+	spin_lock_irqsave(&p->al_lock, flags);
+	p->al_sampling = false;
+	n = p->al_nsamples;
+	memcpy(buf, p->al_samples, n * sizeof(buf[0]));
+	spin_unlock_irqrestore(&p->al_lock, flags);
+	if (!n)
+		return 1;
+	sort(buf, n, sizeof(buf[0]), h713_cmp_u64, NULL);
+	*median = buf[n / 2];
+	return 0;
+}
+
+static int h713_al_raster(void *cookie, u32 word, u32 frames)
+{
+	struct h713_drm *p = cookie;
+	unsigned long flags;
+	long left;
+
+	if (!frames)
+		return 0;
+	spin_lock_irqsave(&p->al_lock, flags);
+	p->rs_word = word;
+	p->rs_left = frames;
+	p->rs_state = RS_ARMED;
+	spin_unlock_irqrestore(&p->al_lock, flags);
+	/* a lengthened frame lasts up to 1225 lines; allow two frames of slack per frame */
+	left = wait_event_timeout(p->al_wq, READ_ONCE(p->rs_state) == RS_DONE,
+				  msecs_to_jiffies((frames + 3) * 2 * H713_FRAME_MS));
+	spin_lock_irqsave(&p->al_lock, flags);
+	if (p->rs_state != RS_DONE)
+		/* never leave a changed total behind */
+		h713_hw_raster_set(&p->hw, H713_RASTER_HANDOFF);
+	p->rs_state = RS_IDLE;
+	spin_unlock_irqrestore(&p->al_lock, flags);
+	return left ? 0 : -ETIMEDOUT;
+}
+
+/*
+ * 05 §2.1 B9: a line window with interrupts off, so that nothing delays the two writes; a few tries
+ * when the line counter moved past the room for the window in between.
+ */
+static int h713_al_window(void *cookie, u32 plus, u32 lines, u32 *got)
+{
+	struct h713_drm *p = cookie;
+	unsigned long flags;
+	int ret = -EAGAIN, i;
+
+	for (i = 0; i < 3 && ret == -EAGAIN; i++) {
+		ret = h713_hw_line_wait(&p->hw, lines);
+		if (ret)
+			return ret;
+		local_irq_save(flags);
+		ret = h713_hw_raster_window(&p->hw, plus, lines, got);
+		local_irq_restore(flags);
+	}
+	return ret;
+}
+
+static int h713_al_settle(void *cookie, u32 frames)
+{
+	struct h713_drm *p = cookie;
+	u64 target = READ_ONCE(p->al_frames) + frames;
+
+	return wait_event_timeout(p->al_wq, READ_ONCE(p->al_frames) >= target,
+				  msecs_to_jiffies((frames + 3) * H713_FRAME_MS)) ? 0 : -ETIMEDOUT;
+}
+
+/*
+ * Calibration content: two XRGB8888 bands and a black video frame of the current geometry (05 §2.1
+ * method).
+ */
+static int h713_cal_buffers(struct h713_drm *p, const struct h713_plane *v,
+			    struct h713_align_bufs *b)
+{
+	struct device *dev = p->drm.dev;
+	size_t rgb = 7680 * 1080, vid = (size_t)v->pitch * v->height * 2;
+	u32 *w;
+	u32 x, y;
+	u8 *c;
+
+	if (!p->cal_rgb_rows) {
+		p->cal_rgb_rows = dmam_alloc_coherent(dev, rgb, &p->cal_rgb_rows_dma, GFP_KERNEL);
+		p->cal_rgb_cols = dmam_alloc_coherent(dev, rgb, &p->cal_rgb_cols_dma, GFP_KERNEL);
+		if (!p->cal_rgb_rows || !p->cal_rgb_cols)
+			return -ENOMEM;
+		for (w = p->cal_rgb_rows, y = 0; y < 1080; y++)
+			for (x = 0; x < 1920; x++)
+				*w++ = (y >= 100 && y < 980) ? 0xffffffff : 0xff000000;
+		for (w = p->cal_rgb_cols, y = 0; y < 1080; y++)
+			for (x = 0; x < 1920; x++)
+				*w++ = (x >= 100 && x < 1820) ? 0xffffffff : 0xff000000;
+	}
+	if (p->cal_video_size < vid) {
+		p->cal_video = dmam_alloc_coherent(dev, vid, &p->cal_video_dma, GFP_KERNEL);
+		if (!p->cal_video)
+			return -ENOMEM;
+		p->cal_video_size = vid;
+	}
+	/* black: Y 16 for the luma rows, Cb/Cr 128 after them (NV12 and NV16, 10 §4) */
+	c = p->cal_video;
+	memset(c, 16, (size_t)v->pitch * v->height);
+	memset(c + (size_t)v->pitch * v->height, 128, vid - (size_t)v->pitch * v->height);
+	b->rgb_rows = p->cal_rgb_rows_dma;
+	b->rgb_cols = p->cal_rgb_cols_dma;
+	b->video_luma = p->cal_video_dma;
+	b->video_chroma = p->cal_video_dma + v->pitch * v->height;
+	return 0;
+}
+
+static void h713_align(struct h713_drm *p)
+{
+	struct drm_device *drm = &p->drm;
+	struct h713_align_ops ops = {
+		.cookie = p,
+		.delay_ns = h713_al_delay,
+		.raster = h713_al_raster,
+		.settle = h713_al_settle,
+		.window = h713_al_window,
+	};
+	struct h713_align_bufs bufs = {};
+	struct h713_align_report ar = {};
+	struct h713_report rep = {};
+	int ret;
+
+	if (!p->hw.blk[H713_BLK_RASTER].base) {
+		drm_warn(drm, "align: no \"raster\" registers: RGB over video not aligned\n");
+		return;
+	}
+	if (align_cal) {
+		ret = h713_cal_buffers(p, &p->cur, &bufs);
+		if (ret)
+			drm_warn(drm, "align: no calibration buffers (%d): rows by timing only\n",
+				 ret);
+	}
+	if (drm_crtc_vblank_get(&p->crtc)) {
+		drm_warn(drm, "align: vblank interrupt unavailable\n");
+		return;
+	}
+	ret = h713_hw_align(&p->hw, &ops, &bufs, &p->cur, align_cal && bufs.rgb_rows, &ar, &rep);
+	drm_crtc_vblank_put(&p->crtc);
+	drm_info(
+		drm,
+		"align (05 §2.1): %d; vsync->RGB done %llu.%03llu ms -> %llu.%03llu ms (aligned %u.%03u); "
+		"timing moved %u lines in %u frames%s\n",
+		ret, ar.delay_before_ns / 1000000, (ar.delay_before_ns / 1000) % 1000,
+		ar.delay_after_ns / 1000000, (ar.delay_after_ns / 1000) % 1000,
+		ar.target_ns / 1000000, (ar.target_ns / 1000) % 1000, ar.timing_lines,
+		ar.timing_frames, ar.timing_aligned ? ", rows aligned" : ", rows NOT aligned");
+	if (ar.calibrated)
+		drm_info(
+			drm,
+			"align calibration: |columns| %u -> %u by the lattice (%d horizontal steps) -> %u by %u line windows (%u raster jumps undone), |rows| %u -> %u (%u lines moved); %u register writes, %u read-back mismatches\n",
+			ar.col_before, ar.col_lattice, ar.col_steps, ar.col_after, ar.windows,
+			ar.jumps, ar.row_before, ar.row_after, ar.hist_lines, rep.writes,
+			rep.mismatches);
+}
