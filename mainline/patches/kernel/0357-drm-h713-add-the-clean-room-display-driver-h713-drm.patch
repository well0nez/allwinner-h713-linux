+/// A named step of a plan.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Step {
+    pub name: &'static str,
+    /// The switch that guards the step (`None`: always part of the plan).
+    pub switch: Option<Switch>,
+    /// The spec rows the step rests on.
+    pub rests_on: &'static str,
+    /// For a table step: the table.
+    pub table: Option<TableRef>,
+}
+
+/// Why a plan could not be composed.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ComposeError<E> {
+    Sink(E),
+    Config(ConfigError),
+    Table { handle: u32, error: TableError },
+}
+
+impl<E> From<ConfigError> for ComposeError<E> {
+    fn from(e: ConfigError) -> Self {
+        Self::Config(e)
+    }
+}
