+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+//! Inputs of the composer: the frame, the panel, the named switches of the unproven steps
+//! (spec/91), and the validation that keeps the composer inside the states the spec proves.
+#![deny(
+    clippy::indexing_slicing,
+    clippy::arithmetic_side_effects,
+    clippy::unwrap_used,
+    clippy::expect_used
+)]
+
+use core::fmt;
+
+/// Source pixel formats (91 O4: NV12 and NV16 only).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum PixelFormat {
+    /// Luma plane, then a W x H/2 plane of interleaved Cb, Cr (10 §4).
+    Nv12,
+    /// Luma plane, then a W x H plane of interleaved Cb, Cr; read with a doubled chroma stride (10
+    /// §4).
+    Nv16,
+}
+
+impl PixelFormat {
+    pub fn parse(s: &str) -> Option<Self> {
+        if s.eq_ignore_ascii_case("nv12") {
+            Some(Self::Nv12)
+        } else if s.eq_ignore_ascii_case("nv16") {
+            Some(Self::Nv16)
+        } else {
+            None
+        }
+    }
+
+    /// Chroma plane rows for a frame of `height` rows.
+    pub const fn chroma_rows(self, height: u32) -> u32 {
+        match self {
+            Self::Nv12 => height / 2,
+            Self::Nv16 => height,
+        }
+    }
+}
+
+/// A frame in DRAM.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Frame {
+    pub format: PixelFormat,
+    pub width: u32,
+    pub height: u32,
+    /// Luma line pitch in bytes (= chroma pitch in DRAM for both formats).
+    pub pitch: u32,
+    /// Physical address of the luma plane.
+    pub luma: u32,
+    /// Physical address of the chroma plane.
+    pub chroma: u32,
+}
+
+impl Frame {
+    /// Chroma directly after luma (95 §2 buffers, 10 §4).
+    pub const fn contiguous(
+        format: PixelFormat,
+        width: u32,
+        height: u32,
+        pitch: u32,
+        luma: u32,
+    ) -> Self {
+        Self {
+            format,
+            width,
+            height,
+            pitch,
+            luma,
+            chroma: luma.saturating_add(pitch.saturating_mul(height)),
+        }
+    }
+
+    /// End (exclusive) of the frame's bytes.
+    pub const fn end(&self) -> u64 {
+        let l = (self.luma as u64)
+            .saturating_add((self.pitch as u64).saturating_mul(self.height as u64));
+        let c = (self.chroma as u64).saturating_add(
+            (self.pitch as u64).saturating_mul(self.format.chroma_rows(self.height) as u64),
+        );
+        if l > c {
+            l
+        } else {
+            c
+        }
+    }
+
+    pub const fn start(&self) -> u32 {
+        if self.luma < self.chroma {
+            self.luma
+        } else {
+            self.chroma
+        }
+    }
+}
+
+/// Panel size.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Panel {
+    pub width: u32,
+    pub height: u32,
+}
+
+/// The HY320 panel (00 §4).
+pub const PANEL_1080P: Panel = Panel {
+    width: 1920,
+    height: 1080,
+};
+
+/// How the composer waits for a latch request (`VCH_LATCH`, the RGB channel latch) to be consumed
+/// (91 O1: one place).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum LatchWait {
+    /// Poll for bit 0 = 0, at most this many microseconds (10 §6.2 checked at 200 ms; L1 bound 50
+    /// ms).
+    Poll { timeout_us: u32 },
+    /// A fixed wait.
+    Delay { us: u32 },
+    /// No wait.
+    None,
+}
+
+/// Where the DRAM buffers of spec/12's `*` words go.
+///
+/// spec/12's buffer words point into the firmware's reserved area: capture ring luma `0x4c3ef000`,
+/// `0x4c5ee000`, `0x4c7ed000`, chroma `0x4c9ec000`, `0x4cbeb000`, `0x4cdea000`; noise-reduction
+/// buffers `0x4d028000`, `0x4d1c1000`, `0x4d35a000`, `0x4d4f3000`. The composer moves the whole
+/// layout by one offset: new = `base` + (old - [`FW_BUFFER_LOW`]). `base` = [`FW_BUFFER_LOW`] keeps
+/// the firmware's layout, which is unused in the bench boot.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct NrBuffers {
+    pub base: u32,
+}
+
+/// Lowest buffer address of spec/12.
+pub const FW_BUFFER_LOW: u32 = 0x4c3e_f000;
+/// Highest buffer address of spec/12.
+pub const FW_BUFFER_HIGH: u32 = 0x4d4f_3000;
+/// Assumed size of the last buffer: the spacing of the two noise-reduction buffers before it
+/// (`0x4d4f3000 - 0x4d35a000`). [INFERENCE; spec gap Q-VP-6]
+pub const FW_LAST_BUFFER: u32 = 0x0019_9000;
+/// Bytes the relocated area spans.
+pub const FW_BUFFER_SPAN: u32 = FW_BUFFER_HIGH - FW_BUFFER_LOW + FW_LAST_BUFFER;
+
+impl NrBuffers {
+    pub const FIRMWARE_LAYOUT: Self = Self {
+        base: FW_BUFFER_LOW,
+    };
+
+    /// Relocates a spec/12 buffer word (address >> 4).
+    pub const fn relocate(&self, word: u32) -> u32 {
+        let addr = word << 4;
+        (self.base.wrapping_add(addr.wrapping_sub(FW_BUFFER_LOW))) >> 4
+    }
+}
+
+/// The named switches. Each guards one step whose necessity is open in spec/91; the doc line names
+/// the item.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+#[repr(u8)]
+pub enum Switch {
+    /// Read-only precondition checks (00 §3, §4).
+    Precheck,
+    /// Raster-stall detection after the init tables (10 §6.3; 91 O1): reported, never waited out.
+    RasterCheck,
+    /// The owner's init tables, from the table list (91 O11: list as data).
+    InitTables,
+    /// `PROC_LOCK`/`PNL_LOCK` `fe08` = panel totals (10 §6.2 Q1 state; 91 O1 open: 65.5 Hz).
+    LockTotals,
+    /// spec/30 §5 run-time words as one group (91 O5).
+    Runtime30,
+    /// spec/12 words of `PROC_LOCK`, `PNL_LOCK`, `PROC`, `SCL`, `DEI`, `PNL` (10 §6.2: not
+    /// separated).
+    DramRest,
+    /// spec/12 words of `NRC` and `BORDER` with the driver's buffers (91 O1, O2).
+    DramNrcBorder,
+    /// Scaler words of 20 §3 S1 / S2 (91 O8, O9).
+    Scaler,
+    /// Source-size geometry of `PROC`, `NRC`, `DEI` (20 §3 S2 HY320, §5.2).
+    SourceGeometry,
+    /// The frame-source step: `NRC 0x0500046c`, `0x05000840` (10 §6.2).
+    FrameSource,
+    /// Write the scaler words to all four register copies (20 §3 S1: all four held the same values;
+    /// 91 O8).
+    SclAllCopies,
+    /// The remaining T1 words without an observed meaning: `0x018`, `0x01c`, `0x028`, `0x02c`,
+    /// `0x034` (10 §5 T1).
+    VchT1Extra,
+    /// User white balance by read-modify-write (91 O16). Off by default.
+    WhiteBalance,
+    /// `PNL_SEL` video alone and `MIX` bit 28 clear (10 §3).
+    PlaneSelect,
+}
+
+pub const SWITCHES: [Switch; 14] = [
+    Switch::Precheck,
+    Switch::RasterCheck,
+    Switch::InitTables,
+    Switch::LockTotals,
+    Switch::Runtime30,
+    Switch::DramRest,
+    Switch::DramNrcBorder,
+    Switch::Scaler,
+    Switch::SourceGeometry,
+    Switch::FrameSource,
+    Switch::SclAllCopies,
+    Switch::VchT1Extra,
+    Switch::WhiteBalance,
+    Switch::PlaneSelect,
+];
+
+impl Switch {
+    pub const fn name(self) -> &'static str {
+        match self {
+            Switch::Precheck => "precheck",
+            Switch::RasterCheck => "raster-check",
+            Switch::InitTables => "init-tables",
+            Switch::LockTotals => "lock-totals",
+            Switch::Runtime30 => "runtime-30-5",
+            Switch::DramRest => "dram-rest",
+            Switch::DramNrcBorder => "dram-nrc-border",
+            Switch::Scaler => "scaler",
+            Switch::SourceGeometry => "source-geometry",
+            Switch::FrameSource => "frame-source",
+            Switch::SclAllCopies => "scl-all-copies",
+            Switch::VchT1Extra => "vch-t1-extra",
+            Switch::WhiteBalance => "white-balance",
+            Switch::PlaneSelect => "plane-select",
+        }
+    }
+
+    /// The spec item the switch stands for.
+    pub const fn rests_on(self) -> &'static str {
+        match self {
+            Switch::Precheck => "00 §3, §3.1, §4",
+            Switch::RasterCheck => "10 §6.3; 91 O1",
+            Switch::InitTables => "40 §4.2-4.4; 10 §6.2 Q1 state; 91 O11",
+            Switch::LockTotals => "10 §6.1, §6.2 Q1 state; 20 §6",
+            Switch::Runtime30 => "30 §5; 91 O5",
+            Switch::DramRest => "12; 10 §6.2, §6.3 (full set only)",
+            Switch::DramNrcBorder => "12, 12 §M; 10 §6.2, §6.3; 91 O2",
+            Switch::Scaler => "20 §2.1, §3 S1 / S2 HY320; 91 O8, O9",
+            Switch::SourceGeometry => "20 §3 S2 HY320, §5.2",
+            Switch::FrameSource => "10 §6.2; 20 §5.1; 91 O1",
+            Switch::SclAllCopies => "20 §2, §3 S1; 91 O8",
+            Switch::VchT1Extra => "10 §5 T1",
+            Switch::WhiteBalance => "30 §4.1; 91 O16",
+            Switch::PlaneSelect => "10 §3, §6 L4",
+        }
+    }
+
+    pub fn by_name(name: &str) -> Option<Switch> {
+        SWITCHES.iter().copied().find(|s| s.name() == name)
+    }
+}
+
+/// One bit per switch (the discriminants are 0..SWITCHES.len()).
+const ALL_SWITCHES: u32 = (1 << SWITCHES.len()) - 1;
+
+/// First address above the 32-bit physical range the scanout words can hold.
+const ADDRESS_LIMIT: u64 = 1 << 32;
+
+/// A set of switches.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Switches(u32);
+
+impl Switches {
+    pub const NONE: Self = Self(0);
+
+    /// Everything on except white balance.
+    pub const fn defaults() -> Self {
+        Self(ALL_SWITCHES & !(1 << Switch::WhiteBalance as u8))
+    }
+
+    pub const fn on(&self, s: Switch) -> bool {
+        self.0 & (1 << s as u8) != 0
+    }
+
+    pub fn set(&mut self, s: Switch, on: bool) {
+        if on {
+            self.0 |= 1 << s as u8;
+        } else {
+            self.0 &= !(1 << s as u8);
+        }
+    }
+
+    pub const fn with(mut self, s: Switch, on: bool) -> Self {
+        if on {
+            self.0 |= 1 << s as u8;
+        } else {
+            self.0 &= !(1 << s as u8);
+        }
+        self
+    }
+}
+
+impl Default for Switches {
+    fn default() -> Self {
+        Self::defaults()
+    }
+}
+
+/// User white balance as register fields (30 §4.1): gains unsigned 12 bit (`0x800` = 1.0), offsets
+/// signed 12 bit.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct WhiteBalance {
+    pub red_gain: u16,
+    pub green_gain: u16,
+    pub blue_gain: u16,
+    pub red_offset: i16,
+    pub green_offset: i16,
+    pub blue_offset: i16,
+}
+
+impl WhiteBalance {
+    /// Neutral (30 §4.1).
+    pub const NEUTRAL: Self = Self {
+        red_gain: 0x800,
+        green_gain: 0x800,
+        blue_gain: 0x800,
+        red_offset: 0,
+        green_offset: 0,
+        blue_offset: 0,
+    };
+}
+
+/// Which of spec/12's word sets the plan writes (12 §M).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum DramSet {
+    /// All of spec/12 (minus the §M.3 status words): the firmware's picture; buffers relocated.
+    Full,
+    /// 12 §M.1: black/white follow the frame, P1 loses its levels.
+    Minimal40,
+    /// 12 §M.2: black/white follow and P1 keeps its levels.
+    Minimal85,
+}
+
+impl DramSet {
+    pub fn parse(s: &str) -> Option<Self> {
+        Some(match s {
+            "full" => Self::Full,
+            "minimal40" => Self::Minimal40,
+            "minimal85" => Self::Minimal85,
+            _ => return None,
+        })
+    }
+
+    pub const fn name(self) -> &'static str {
+        match self {
+            Self::Full => "full",
+            Self::Minimal40 => "minimal40",
+            Self::Minimal85 => "minimal85",
+        }
+    }
+}
+
+/// Pauses while the owner's init tables and the lock totals are written (10 §6.3 "Pacing of the
+/// init tables": written back-to-back within 12 ms the video side stayed broken for the whole boot;
+/// either pause alone was enough, 1 ms after each write or 200 ms between the tables, in two boots
+/// each, also for later full enables).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Pacing {
+    /// After each write of an init table.
+    pub per_write_us: u32,
+    /// Before each table after the first, and before the lock totals.
+    pub between_tables_us: u32,
+}
+
+impl Pacing {
+    /// One pause: 200 ms between the tables and before the lock totals (10 §6.3; about 1 s per full
+    /// enable).
+    pub const MEASURED: Self = Self {
+        per_write_us: 0,
+        between_tables_us: 200_000,
+    };
+    pub const NONE: Self = Self {
+        per_write_us: 0,
+        between_tables_us: 0,
+    };
+}
+
+/// Everything the composer needs.
+#[derive(Clone, Copy, Debug)]
+pub struct Config {
+    pub frame: Frame,
+    pub panel: Panel,
+    pub switches: Switches,
+    pub latch: LatchWait,
+    pub nr_buffers: NrBuffers,
+    /// spec/12 word set (12 §M).
+    pub dram_set: DramSet,
+    /// Pauses in the init path (10 §6.3).
+    pub pacing: Pacing,
+    /// `PROC 0x05140508` at enable (12 §M.5: `0x04400000` on the HY320).
+    pub chroma_gain: u32,
+    pub white_balance: WhiteBalance,
+}
+
+/// Default chroma gain word: the HY320 firmware's value (12 §M.5; the HY310's was `0x144c0000`, 10
+/// §6 L4).
+pub const CHROMA_GAIN_DEFAULT: u32 = 0x0440_0000;
+/// Chroma gain rest value with the plane off (10 §6 L5).
+pub const CHROMA_GAIN_REST: u32 = 0x0400_0000;
+
+impl Config {
+    /// Defaults around a frame: HY320 panel, default switches, 200 ms latch poll, firmware buffer
+    /// layout.
+    pub const fn new(frame: Frame) -> Self {
+        Self {
+            frame,
+            panel: PANEL_1080P,
+            switches: Switches::defaults(),
+            latch: LatchWait::Poll {
+                timeout_us: 200_000,
+            },
+            nr_buffers: NrBuffers::FIRMWARE_LAYOUT,
+            dram_set: DramSet::Full,
+            pacing: Pacing::MEASURED,
+            chroma_gain: CHROMA_GAIN_DEFAULT,
+            white_balance: WhiteBalance::NEUTRAL,
+        }
+    }
+}
+
+/// The scaler states the spec proves (20 §3; 91 O8).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ScaleState {
+    /// S1: source = panel = 1920x1080.
+    OneToOne,
+    /// S2: 1280x720 source on the 1920x1080 panel.
+    Up720To1080,
+}
+
+/// Why a configuration is refused.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ConfigError {
+    /// Only the 1920x1080 panel was measured (00 §4, 10 §5, 12, 30 §5).
+    UnprovenPanel,
+    /// A scaling other than 1:1 and 1280x720 -> 1920x1080 (91 O8).
+    UnprovenScale,
+    /// Source larger than the panel: the path does not downscale (00 §2, 10 §7).
+    Downscale,
+    /// Zero or odd width/height, or a pitch below the width.
+    Geometry,
+    /// Luma not 4 KiB-aligned or chroma not 1 KiB-aligned: never tried (10 §4, 91 O4).
+    Alignment,
+    /// The frame overlaps the relocated buffer area of spec/12.
+    BufferOverlap,
+    /// An address computation overflows 32 bits.
+    AddressRange,
+    /// A 12 §M minimal set at 1280x720: the areas come out wrong (12 §M.4); only the full set is
+    /// proven there.
+    MinimalSetAt720p,
+}
+
+impl fmt::Display for ConfigError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        let s = match self {
+            ConfigError::UnprovenPanel => "only the 1920x1080 panel is measured (00 §4)",
+            ConfigError::UnprovenScale => {
+                "only 1:1 and 1280x720->1920x1080 are proven (20 §3, 91 O8)"
+            }
+            ConfigError::Downscale => "source larger than the panel: no downscaling (00 §2, 10 §7)",
+            ConfigError::Geometry => "width/height must be even and non-zero, pitch >= width",
+            ConfigError::Alignment => "luma must be 4 KiB- and chroma 1 KiB-aligned (10 §4, 91 O4)",
+            ConfigError::BufferOverlap => "frame overlaps the relocated spec/12 buffer area",
+            ConfigError::AddressRange => "address out of the 32-bit range",
+            ConfigError::MinimalSetAt720p => {
+                "12 §M minimal sets give wrong areas at 1280x720 (12 §M.4): use the full set"
+            }
+        };
+        f.write_str(s)
+    }
+}
+
+impl Config {
+    /// Validates and returns the scaler state.
+    pub fn validate(&self) -> Result<ScaleState, ConfigError> {
+        let f = &self.frame;
+        if self.panel != PANEL_1080P {
+            return Err(ConfigError::UnprovenPanel);
+        }
+        if f.width == 0
+            || f.height == 0
+            || f.width % 2 != 0
+            || f.height % 2 != 0
+            || f.pitch < f.width
+        {
+            return Err(ConfigError::Geometry);
+        }
+        if f.width > self.panel.width || f.height > self.panel.height {
+            return Err(ConfigError::Downscale);
+        }
+        if f.luma % 4096 != 0 || f.chroma % 1024 != 0 {
+            return Err(ConfigError::Alignment);
+        }
+        if f.end() > ADDRESS_LIMIT {
+            return Err(ConfigError::AddressRange);
+        }
+        if self.dram_set == DramSet::Full && self.switches.on(Switch::DramNrcBorder) {
+            let lo = self.nr_buffers.base as u64;
+            let hi = lo.saturating_add(FW_BUFFER_SPAN as u64);
+            if hi > ADDRESS_LIMIT {
+                return Err(ConfigError::AddressRange);
+            }
+            if (f.start() as u64) < hi && lo < f.end() {
+                return Err(ConfigError::BufferOverlap);
+            }
+        }
+        match (f.width, f.height) {
+            (1920, 1080) => Ok(ScaleState::OneToOne),
+            (1280, 720) if self.dram_set != DramSet::Full => Err(ConfigError::MinimalSetAt720p),
+            (1280, 720) => Ok(ScaleState::Up720To1080),
+            _ => Err(ConfigError::UnprovenScale),
+        }
+    }
+}
