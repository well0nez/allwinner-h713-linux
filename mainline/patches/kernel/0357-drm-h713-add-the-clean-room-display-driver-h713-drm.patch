+static enum drm_mode_status h713_crtc_mode_valid(struct drm_crtc *crtc,
+						 const struct drm_display_mode *mode)
+{
+	return h713_mode_matches(mode) ? MODE_OK : MODE_BAD;
+}
+
+static int h713_crtc_atomic_check(struct drm_crtc *crtc, struct h713_atomic *state)
+{
+	struct drm_crtc_state *cs = drm_atomic_get_new_crtc_state(state, crtc);
+
+	if (cs->enable && !h713_mode_matches(&cs->mode))
+		return -EINVAL;	/* the panel mode is adopted, never set (05 §5) */
+	if (cs->gamma_lut && drm_color_lut_size(cs->gamma_lut) != H713_GAMMA_SIZE)
+		return -EINVAL;	/* one entry per 10-bit input (30 §4.3) */
+	if (to_h713_cs(cs)->video_source == H713_SOURCE_HDMI) {
+		struct h713_drm *p = to_h713(crtc->dev);
+		struct drm_plane_state *ov;
+
+		if (!p->hdmi_avail)
+			return -ENODEV;
+		/* the video plane shows the HDMI input: the overlay plane carries no buffer */
+		ov = drm_atomic_get_plane_state(state, &p->overlay);
+		if (IS_ERR(ov))
+			return PTR_ERR(ov);
+		if (ov->fb && ov->crtc == crtc)
+			return -EBUSY;
+	}
+	return 0;
+}
+
+static void h713_crtc_atomic_enable(struct drm_crtc *crtc, struct h713_atomic *state)
+{
+	struct h713_drm *p = to_h713(crtc->dev);
+
+	drm_crtc_vblank_on(crtc);
+	/*
+	 * The planes were committed in atomic_flush, before this (the helper's order); align now
+	 * that vblank runs.
+	 */
+	if (p->align_pending) {
+		p->align_pending = false;
+		h713_align(p);
+	}
+}
+
+static void h713_pq_flush_pending(struct h713_drm *p, const char *why);
+static void h713_flip_send(struct h713_drm *p);
+
+static void h713_crtc_atomic_disable(struct drm_crtc *crtc, struct h713_atomic *state)
+{
+	struct h713_drm *p = to_h713(crtc->dev);
+
+	p->align_pending = false;
+	/*
+	 * picture controls still waiting for a vblank: written now, their vblank reference dropped
+	 */
+	h713_pq_flush_pending(p, "disable");
+	hrtimer_cancel(&p->flip_timer);
+	spin_lock_irq(&crtc->dev->event_lock);
+	if (p->flip_event)
+		h713_flip_send(p);
+	spin_unlock_irq(&crtc->dev->event_lock);
+	drm_crtc_vblank_off(crtc);
+	spin_lock_irq(&crtc->dev->event_lock);
+	if (crtc->state->event && !crtc->state->active) {
+		drm_crtc_send_vblank_event(crtc, crtc->state->event);
+		crtc->state->event = NULL;
+	}
+	spin_unlock_irq(&crtc->dev->event_lock);
+}
