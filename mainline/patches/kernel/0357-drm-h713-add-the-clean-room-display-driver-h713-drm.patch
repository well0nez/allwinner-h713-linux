+/// `int h713_hw_rx_signs(hw, s)`: one reading of the lock signs (50 §4, 55 §3) and their verdict
+/// (`hdmi::lock`). Byte reads of the receiver windows; no sleep.
+///
+/// # Safety
+///
+/// `hw` and `s` are NULL or live.
+#[no_mangle]
+pub unsafe extern "C" fn h713_hw_rx_signs(hw: *const H713Hw, s: *mut H713RxSigns) -> i32 {
+    // SAFETY: by this function's contract.
+    let (Some(hw), Some(s)) = (unsafe { hw.as_ref() }, unsafe { s.as_mut() }) else {
+        return EINVAL.to_errno();
+    };
+    let io = Mmio { hw };
+    let mut b = [0u8; hdmi::TIMING_LEN];
+    let mut a = hdmi::TIMING_BYTES;
+    for x in b.iter_mut() {
+        *x = match io.read8(a) {
+            Ok(v) => v,
+            Err(e) => return e,
+        };
+        a = a.wrapping_add(1);
+    }
+    let timing = Timing::from_bytes(&b);
+    let tmds = match io.read8(hdmi::TMDS_BYTE) {
+        Ok(v) => v & hdmi::TMDS_BIT != 0,
+        Err(e) => return e,
+    };
+    let mut enables = true;
+    for (addr, bits) in hdmi::ENABLES {
+        match io.read8(addr) {
+            Ok(v) => enables &= v & bits == bits,
+            Err(e) => return e,
+        }
+    }
+    let rd = |addr: u32| io.read(addr);
+    let (counter, totals, size, out_luma, out_chroma, write_index) = match (
+        rd(hdmi::cap::COUNTER),
+        rd(hdmi::cap::TOTALS),
+        rd(hdmi::cap::SIZE),
+        rd(hdmi::cap::OUT_LUMA),
+        rd(hdmi::cap::OUT_CHROMA),
+        rd(hdmi::cap::WRITE_INDEX),
+    ) {
+        (Ok(a), Ok(b), Ok(c), Ok(d), Ok(e), Ok(f)) => (a, b, c, d, e, f),
+        _ => return EFAULT.to_errno(),
+    };
+    let signs = Signs {
+        timing,
+        tmds,
+        enables,
+        frame: (counter >> 16) as u16,
+        frame_before: s.frame_before as u16,
+        totals,
+        size,
+        capturing: out_luma & hdmi::cap::OUT_ENABLE != 0 && out_chroma & hdmi::cap::OUT_ENABLE != 0,
+    };
+    let t = [
+        timing.h_total,
+        timing.h_active,
+        timing.h_blank,
+        timing.h_front,
+        timing.h_sync,
+        timing.h_back,
+        timing.v_total,
+        timing.v_active,
+        timing.v_blank,
+        timing.v_front,
+        timing.v_sync,
+        timing.v_back,
+    ];
+    s.timing = t;
+    s.tmds = u32::from(tmds);
+    s.enables = u32::from(enables);
+    s.counter = counter;
+    s.totals = totals;
+    s.size = size;
+    s.out_luma = out_luma;
+    s.out_chroma = out_chroma;
+    s.write_index = write_index;
+    s.refresh_mhz = timing.refresh_mhz();
+    s.state = match hdmi::lock(&signs) {
+        Lock::NoSignal => 1,
+        Lock::Tmds => 2,
+        Lock::Unsupported => 3,
+        Lock::Locked => 4,
+        Lock::Capturing => 5,
+    };
+    0
+}
