+/// The source timing as the receiver reports it: `RX_LINK +0x28..+0x3f`, twelve big-endian 16-bit
+/// values (50 §4).
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct Timing {
+    pub h_total: u16,
+    pub h_active: u16,
+    pub h_blank: u16,
+    pub h_front: u16,
+    pub h_sync: u16,
+    pub h_back: u16,
+    pub v_total: u16,
+    pub v_active: u16,
+    pub v_blank: u16,
+    pub v_front: u16,
+    pub v_sync: u16,
+    pub v_back: u16,
+}
+
+/// First byte of the timing block.
+pub const TIMING_BYTES: u32 = RX_LINK + 0x28;
+/// Bytes of the timing block.
+pub const TIMING_LEN: usize = 24;
+
+impl Timing {
+    /// CTA-861 1920x1080p60 (50 §4: all twelve values as measured; public CTA-861).
+    pub const CTA_1080P60: Timing = Timing {
+        h_total: 2200,
+        h_active: 1920,
+        h_blank: 280,
+        h_front: 88,
+        h_sync: 44,
+        h_back: 148,
+        v_total: 1125,
+        v_active: 1080,
+        v_blank: 45,
+        v_front: 4,
+        v_sync: 5,
+        v_back: 36,
+    };
+
+    /// Decodes the 24 bytes read from [`TIMING_BYTES`] on.
+    pub fn from_bytes(b: &[u8; TIMING_LEN]) -> Self {
+        let w = |i: usize| -> u16 {
+            let hi = b.get(i.wrapping_mul(2)).copied().unwrap_or(0);
+            let lo = b
+                .get(i.wrapping_mul(2).wrapping_add(1))
+                .copied()
+                .unwrap_or(0);
+            u16::from_be_bytes([hi, lo])
+        };
+        Timing {
+            h_total: w(0),
+            h_active: w(1),
+            h_blank: w(2),
+            h_front: w(3),
+            h_sync: w(4),
+            h_back: w(5),
+            v_total: w(6),
+            v_active: w(7),
+            v_blank: w(8),
+            v_front: w(9),
+            v_sync: w(10),
+            v_back: w(11),
+        }
+    }
+
+    /// All zero: no signal (50 §4).
+    pub fn is_zero(&self) -> bool {
+        *self == Timing::default()
+    }
+
+    /// The refresh rate in mHz for a pixel clock of 148.5 MHz per 2200 x 1125 (the only clock this
+    /// stage knows; 50 §4: 1080p60 = 2 475 000 clocks per frame).
+    pub fn refresh_mhz(&self) -> u32 {
+        let total = u64::from(self.h_total).saturating_mul(u64::from(self.v_total));
+        if total == 0 {
+            return 0;
+        }
+        u32::try_from(148_500_000_000u64.checked_div(total).unwrap_or(0)).unwrap_or(0)
+    }
+}
