+/// one reading (`hdmi::rx_step`; the values of `enum h713_rx_step`).
+#[no_mangle]
+pub extern "C" fn h713_hw_rx_step(
+    tmds: bool,
+    up: bool,
+    written: bool,
+    ms_since_write: u32,
