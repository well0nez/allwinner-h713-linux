+/// `int h713_hw_cap_start(hw, ring_base, pace, rep)`: the capture programming of 55 §8 in its order
+/// (the top word last), each word read back; `pace`: with the bench's 500 ms before the enables (58
+/// §2: it changes nothing). Process context. Call only with the receiver locked at 1080p60.
+///
+/// # Safety
+///
+/// `hw` and `rep` are NULL or live.
+#[no_mangle]
+pub unsafe extern "C" fn h713_hw_cap_start(
+    hw: *const H713Hw,
+    ring_base: u32,
+    pace: bool,
+    rep: *mut H713RxReport,
+) -> i32 {
+    // SAFETY: by this function's contract.
+    let (Some(hw), Some(rep)) = (unsafe { hw.as_ref() }, unsafe { rep.as_mut() }) else {
+        return EINVAL.to_errno();
+    };
+    let Some(ring) = Ring::at(ring_base) else {
+        return EINVAL.to_errno();
+    };
+    let io = Mmio { hw };
+    *rep = H713RxReport {
+        writes: 0,
+        mismatches: 0,
+        skipped_ccu: 0,
+        bad_addr: 0,
+        bad_read: 0,
+    };
+    for (addr, value, pause) in hdmi::capture_writes(&ring) {
+        if pace && pause != 0 {
+            sleep_us(pause);
+        }
+        if let Err(e) = io.write(addr, value) {
+            return e;
+        }
+        let read = match io.read(addr) {
+            Ok(v) => v,
+            Err(e) => return e,
+        };
+        rep.writes = rep.writes.saturating_add(1);
+        if read != value {
+            if rep.mismatches == 0 {
+                rep.bad_addr = addr;
+                rep.bad_read = read;
+            }
+            rep.mismatches = rep.mismatches.saturating_add(1);
+        }
+    }
+    0
+}
+
+/// `int h713_hw_cap_stop(hw)`: clear bit 31 of both capture outputs (55 §4); the caller waits
+/// 40 ms before anything else. No sleep.
+///
+/// # Safety
+///
+/// `hw` is NULL or live.
+#[no_mangle]
+pub unsafe extern "C" fn h713_hw_cap_stop(hw: *const H713Hw) -> i32 {
+    // SAFETY: by this function's contract.
+    let Some(hw) = (unsafe { hw.as_ref() }) else {
+        return EINVAL.to_errno();
+    };
+    let io = Mmio { hw };
+    for addr in hdmi::CAPTURE_STOP {
+        let r = io
+            .read(addr)
+            .and_then(|v| io.write(addr, v & !hdmi::cap::OUT_ENABLE));
+        if let Err(e) = r {
+            return e;
+        }
+    }
+    0
+}
+
+/// `struct h713_rotation` (h713-vp `hdmi::Rotation`; `shown_slot` 0xff = none).
+#[repr(C)]
+pub struct H713Rotation {
+    shown_slot: u32,
+    frame_at_show: u32,
+    shown: u32,
+    repeated: u32,
+    skipped: u32,
+    bad_index: u32,
+    latch_timeouts: u32,
+}
+
+/// `int h713_hw_ring_tick(hw, rot, ring_base)`: one panel vsync with channel 0 on the ring (55 §5):
+/// read the write index and the frame counter, account the frame, and when the slot to show changes
+/// point channel 0 at it (its slot words and the address latch, 10 §6 L2; the new address takes
+/// effect at the next vsync). Returns the slot newly shown, -1 if none, or -errno. IRQ context.
+///
+/// # Safety
+///
+/// `hw` and `rot` are NULL or live.
+#[no_mangle]
+pub unsafe extern "C" fn h713_hw_ring_tick(
+    hw: *const H713Hw,
+    rot: *mut H713Rotation,
+    ring_base: u32,
+) -> i32 {
+    // SAFETY: by this function's contract.
+    let (Some(hw), Some(rot)) = (unsafe { hw.as_ref() }, unsafe { rot.as_mut() }) else {
+        return EINVAL.to_errno();
+    };
+    let Some(ring) = Ring::at(ring_base) else {
+        return EINVAL.to_errno();
+    };
+    let io = Mmio { hw };
+    let (idx, counter) = match (
+        io.read(hdmi::cap::WRITE_INDEX),
+        io.read(hdmi::cap::COUNTER),
+    ) {
+        (Ok(a), Ok(b)) => (a, b),
+        _ => return EFAULT.to_errno(),
+    };
+    let mut r = Rotation {
+        shown_slot: u8::try_from(rot.shown_slot).ok().filter(|&s| s < 3),
+        frame_at_show: rot.frame_at_show as u16,
+        shown: rot.shown,
+        repeated: rot.repeated,
+        skipped: rot.skipped,
+        bad_index: rot.bad_index,
+    };
+    let next = r.vsync(idx, counter);
+    rot.shown_slot = r.shown_slot.map_or(0xff, u32::from);
+    rot.frame_at_show = u32::from(r.frame_at_show);
+    rot.shown = r.shown;
+    rot.repeated = r.repeated;
+    rot.skipped = r.skipped;
+    rot.bad_index = r.bad_index;
+    let Some(slot) = next else {
+        return -1;
+    };
+    let Some((luma, chroma)) = ring.slot(slot) else {
+        return EINVAL.to_errno();
+    };
+    let cfg = Config {
+        frame: Frame {
+            format: PixelFormat::Nv16,
+            width: 1920,
+            height: 1080,
+            pitch: 1920,
+            luma,
+            chroma,
+        },
+        ..base_config(hw)
+    };
+    let mut report = empty_report();
+    let mut ex = Exec {
+        io,
+        rep: &mut report,
+        in_raster: false,
+        may_sleep: false,
+    };
+    if let Err(e) = compose::flip(&cfg, &mut ex) {
+        return compose_err(e);
+    }
+    if report.timeouts != 0 {
+        rot.latch_timeouts = rot.latch_timeouts.saturating_add(1);
+    }
+    i32::from(slot)
+}
