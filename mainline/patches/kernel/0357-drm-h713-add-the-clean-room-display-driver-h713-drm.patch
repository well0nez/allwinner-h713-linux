@@ -0,0 +1,346 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+//! `LogoRegData.bin` (spec/40 §3): the stage-1 register program, listed here for completeness.
+//!
+//! Header: magic `logo`, u32 version, u16 descriptor-table size, u16 class-table size, u32 bytes
+//! after both tables; container length = 0x10 + both table sizes + that. Descriptors of 24 bytes
+//! per project, classes of 12 bytes (u32 class id, u32 offset from the start of the class table,
+//! u32 length), each class a chain of blocks (u32 index, u32 payload length, 16-byte records).
+//! Every offset is bounded by the container length and every write address must lie in
+//! `0x02000000..=0x030fffff` or `0x04000000..=0x06ffffff` (40 §3 walk rules).
+//!
+//! Blocks are looked up by the value of their own index field; a descriptor's index is compared
+//! with that field directly. On the HY320 this reproduces the spec's counts (prologue 32 writes /
+//! 13 delays, timing 24 / 5, picture path 48); block 0 of the prologue class is empty there, which
+//! is what "1-based" in 40 §3 amounts to.
+
+#![deny(
+    clippy::indexing_slicing,
+    clippy::arithmetic_side_effects,
+    clippy::unwrap_used,
+    clippy::expect_used
+)]
+
+use super::reader::Reader;
+use super::{Error, ErrorKind, Result};
+
+pub const HEADER_LEN: usize = 0x10;
+pub const DESCRIPTOR_LEN: usize = 24;
+pub const CLASS_LEN: usize = 12;
+pub const RECORD_LEN: usize = 16;
+
+/// Class ids (40 §3).
+pub mod class {
+    pub const PROLOGUE: u32 = 0;
+    pub const TIMING: u32 = 1;
+    pub const PICTURE_PATH: u32 = 2;
+}
+
+/// Address ranges a record may touch (40 §3 walk rules).
+pub const ALLOWED: [(u32, u32); 2] = [(0x0200_0000, 0x030f_ffff), (0x0400_0000, 0x06ff_ffff)];
+
+/// Whether `addr` lies in one of the [`ALLOWED`] ranges.
+pub fn address_allowed(addr: u32) -> bool {
+    ALLOWED.iter().any(|&(lo, hi)| (lo..=hi).contains(&addr))
+}
+
+/// A validated `LogoRegData.bin`.
+#[derive(Clone, Copy, Debug)]
+pub struct Logo<'a> {
+    pub version: u32,
+    pub descriptor_bytes: u16,
+    pub class_bytes: u16,
+    pub after_bytes: u32,
+    /// 0x10 + both table sizes + the bytes after them.
+    pub container_len: usize,
+    data: &'a [u8],
+}
+
+/// Project descriptor (40 §3).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Descriptor {
+    pub project_id: u32,
+    pub version: u32,
+    /// Prologue block index.
+    pub prologue: u16,
+    /// Timing block index.
+    pub timing: u16,
+    /// Picture-path block index.
+    pub picture_path: u16,
+}
+
+/// Class table entry.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Class {
+    pub id: u32,
+    pub offset: u32,
+    pub length: u32,
+}
+
+/// One 16-byte record.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Record {
+    pub addr: u32,
+    pub value: u32,
+    pub mask: u32,
+    pub kind: u32,
+}
+
+/// What a record does (40 §3 record kinds).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Action {
+    /// Kinds 1, 2, 4: new = (old with the mask bits cleared) OR (value AND mask); always a 32-bit
+    /// access.
+    Masked { addr: u32, value: u32, mask: u32 },
+    /// Kind `0xfe`: read, write back with the mask bits cleared, then with them set.
+    Pulse { addr: u32, mask: u32 },
+    /// Kind `0xff` with address 0: wait `us` microseconds.
+    Delay { us: u32 },
+    /// Any other kind: not described by the spec.
+    Unknown,
+}
+
+impl Record {
+    pub const fn action(&self) -> Action {
+        match self.kind {
+            1 | 2 | 4 => Action::Masked {
+                addr: self.addr,
+                value: self.value,
+                mask: self.mask,
+            },
+            0xfe => Action::Pulse {
+                addr: self.addr,
+                mask: self.mask,
+            },
+            0xff if self.addr == 0 => Action::Delay { us: self.value },
+            _ => Action::Unknown,
+        }
+    }
+
+    /// Masked-write result on `old` (kinds 1, 2, 4).
+    pub const fn apply(&self, old: u32) -> u32 {
+        (old & !self.mask) | (self.value & self.mask)
+    }
+}
+
+/// The records of one block.
+#[derive(Clone, Copy, Debug)]
+pub struct Block<'a> {
+    pub index: u32,
+    payload: &'a [u8],
+}
+
+/// Little-endian u32 at `i` of `b` (0 where `b` is too short; callers pass fixed-size chunks).
+fn le32(b: &[u8], i: usize) -> u32 {
+    let mut w = [0u8; 4];
+    if let Some(s) = b.get(i..i.saturating_add(4)) {
+        w.copy_from_slice(s);
+    }
+    u32::from_le_bytes(w)
+}
+
+fn le16(b: &[u8], i: usize) -> u16 {
+    (le32(b, i) & 0xffff) as u16
+}
+
+impl<'a> Block<'a> {
+    pub fn len(&self) -> usize {
+        self.payload.len().checked_div(RECORD_LEN).unwrap_or(0)
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.payload.is_empty()
+    }
+
+    pub fn records(&self) -> impl Iterator<Item = Record> + 'a {
+        self.payload.chunks_exact(RECORD_LEN).map(|c| Record {
+            addr: le32(c, 0),
+            value: le32(c, 4),
+            mask: le32(c, 8),
+            kind: le32(c, 12),
+        })
+    }
+}
+
+impl<'a> Logo<'a> {
+    /// Parses and validates the file's structure: header, tables, every class chain (each must end
+    /// exactly at its class length). Records are checked per program ([`Logo::program`],
+    /// [`check_block`]): the HY320 file holds, in a timing block no HY320 descriptor uses, two
+    /// records the spec does not describe (kind `0xff` with a non-zero address, kind 4 with address
+    /// 0); see Q-LOGO-2.
+    pub fn parse(file: &'a [u8]) -> Result<Self> {
+        let mut r = Reader::new(file, 0);
+        if r.bytes(4)? != b"logo" {
+            return Err(Error::new(ErrorKind::BadMagic, 0));
+        }
+        let version = r.u32()?;
+        let descriptor_bytes = r.u16()?;
+        let class_bytes = r.u16()?;
+        let after_bytes = r.u32()?;
+        let container_len = HEADER_LEN
+            .saturating_add(descriptor_bytes as usize)
+            .saturating_add(class_bytes as usize)
+            .saturating_add(after_bytes as usize);
+        if container_len > file.len()
+            || descriptor_bytes as usize % DESCRIPTOR_LEN != 0
+            || class_bytes as usize % CLASS_LEN != 0
+        {
+            return Err(Error::new(ErrorKind::BadLength, 8));
+        }
+        let logo = Self {
+            version,
+            descriptor_bytes,
+            class_bytes,
+            after_bytes,
+            container_len,
+            data: file.get(..container_len).unwrap_or(&[]),
+        };
+        for c in logo.classes() {
+            for b in logo.blocks(c)? {
+                b?;
+            }
+        }
+        Ok(logo)
+    }
+
+    fn class_table(&self) -> usize {
+        HEADER_LEN.saturating_add(self.descriptor_bytes as usize)
+    }
+
+    fn class_start(&self, c: Class) -> usize {
+        self.class_table().saturating_add(c.offset as usize)
+    }
+
+    pub fn descriptors(&self) -> impl Iterator<Item = Descriptor> + 'a {
+        let end = HEADER_LEN.saturating_add(self.descriptor_bytes as usize);
+        let t = self.data.get(HEADER_LEN..end).unwrap_or(&[]);
+        t.chunks_exact(DESCRIPTOR_LEN).map(|d| Descriptor {
+            project_id: le32(d, 0),
+            version: le32(d, 4),
+            prologue: le16(d, 8),
+            timing: le16(d, 10),
+            picture_path: le16(d, 12),
+        })
+    }
+
+    pub fn project(&self, id: u32) -> Option<Descriptor> {
+        self.descriptors().find(|d| d.project_id == id)
+    }
+
+    pub fn classes(&self) -> impl Iterator<Item = Class> + 'a {
+        let s = self.class_table();
+        let t = self
+            .data
+            .get(s..s.saturating_add(self.class_bytes as usize))
+            .unwrap_or(&[]);
+        t.chunks_exact(CLASS_LEN).map(|c| Class {
+            id: le32(c, 0),
+            offset: le32(c, 4),
+            length: le32(c, 8),
+        })
+    }
+
+    /// Class by id (40 §3: "look classes up by id").
+    pub fn class(&self, id: u32) -> Option<Class> {
+        self.classes().find(|c| c.id == id)
+    }
+
+    /// The block chain of class `c`, bounded by the container length.
+    pub fn blocks(&self, c: Class) -> Result<Blocks<'a>> {
+        let start = self.class_start(c);
+        let end = start
+            .checked_add(c.length as usize)
+            .ok_or(Error::new(ErrorKind::BadLength, start))?;
+        if end > self.container_len {
+            return Err(Error::new(ErrorKind::BadLength, start));
+        }
+        Ok(Blocks {
+            r: Reader::new(
+                self.data
+                    .get(start..end)
+                    .ok_or(Error::new(ErrorKind::BadLength, start))?,
+                start,
+            ),
+            failed: false,
+        })
+    }
+
+    /// Block `index` of class `class_id`.
+    pub fn block(&self, class_id: u32, index: u32) -> Result<Option<Block<'a>>> {
+        let Some(c) = self.class(class_id) else {
+            return Ok(None);
+        };
+        for b in self.blocks(c)? {
+            let b = b?;
+            if b.index == index {
+                return Ok(Some(b));
+            }
+        }
+        Ok(None)
+    }
+
+    /// The three blocks of project `id` in walk order: prologue, timing, picture path, each checked
+    /// by [`check_block`].
+    pub fn program(&self, id: u32) -> Result<Option<[Block<'a>; 3]>> {
+        let Some(d) = self.project(id) else {
+            return Ok(None);
+        };
+        let p = self.block(class::PROLOGUE, d.prologue as u32)?;
+        let t = self.block(class::TIMING, d.timing as u32)?;
+        let q = self.block(class::PICTURE_PATH, d.picture_path as u32)?;
+        match (p, t, q) {
+            (Some(p), Some(t), Some(q)) => {
+                for b in [&p, &t, &q] {
+                    check_block(b)?;
+                }
+                Ok(Some([p, t, q]))
+            }
+            _ => Ok(None),
+        }
+    }
+}
+
+/// Walk-rule check of one block: every record has a known kind and every write or pulse address
+/// lies in the [`ALLOWED`] ranges (40 §3). The error offset is the index of the offending record.
+pub fn check_block(b: &Block<'_>) -> Result<()> {
+    for (i, rec) in b.records().enumerate() {
+        match rec.action() {
+            Action::Masked { addr, .. } | Action::Pulse { addr, .. } if !address_allowed(addr) => {
+                return Err(Error::new(ErrorKind::Unsupported, i));
+            }
+            Action::Unknown => return Err(Error::new(ErrorKind::Unsupported, i)),
+            _ => {}
+        }
+    }
+    Ok(())
+}
+
+/// Iterator over a class's block chain.
+#[derive(Clone, Debug)]
+pub struct Blocks<'a> {
+    r: Reader<'a>,
+    failed: bool,
+}
+
+impl<'a> Iterator for Blocks<'a> {
+    type Item = Result<Block<'a>>;
+
+    fn next(&mut self) -> Option<Self::Item> {
+        if self.failed || self.r.remaining() == 0 {
+            return None;
+        }
+        let res = (|| {
+            let index = self.r.u32()?;
+            let at = self.r.abs();
+            let len = self.r.u32()? as usize;
+            if len % RECORD_LEN != 0 {
+                return Err(Error::new(ErrorKind::BadLength, at));
+            }
+            Ok(Block {
+                index,
+                payload: self.r.bytes(len)?,
+            })
+        })();
+        self.failed = res.is_err();
+        Some(res)
+    }
+}
