+/// Words the spec names read-only or self-moving; their read-back is logged, not compared.
+fn readback_for(addr: u32) -> Readback {
+    match addr {
+        0x051c_0144..=0x051c_0168 => Readback::Ignore, // PNL status (30 §5)
+        0x0520_000c => Readback::Ignore,               // BORDER read-only (00 §3.1)
+        0x0514_fe00 | 0x0514_fe04 | 0x051c_fe00 | 0x051c_fe04 => Readback::Ignore, // lock status (30 §5)
+        _ => Readback::Exact,
+    }
+}
