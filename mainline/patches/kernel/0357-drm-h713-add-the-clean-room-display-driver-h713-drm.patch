+/// Capture words the lock check reads (55 §3).
+pub mod cap {
+    /// Frame << 16 | line; counts about 60 frames per second with a 1080p60 source.
+    pub const COUNTER: u32 = super::CAP + 0x104;
+    /// V total << 16 | H total (1080p60: `0x04650898`).
+    pub const TOTALS: u32 = super::CAP + 0x548;
+    /// Active width << 16 | height (1080p60: `0x07800438`).
+    pub const SIZE: u32 = super::CAP + 0x874;
+    /// [2:0] = the slot being written.
+    pub const WRITE_INDEX: u32 = super::CAP + 0xa0c;
+    /// Luma output word, bit 31 = writing.
+    pub const OUT_LUMA: u32 = super::CAP + 0x928;
+    /// Chroma output word.
+    pub const OUT_CHROMA: u32 = super::CAP + 0x968;
+    /// Row bytes (luma); `0x00780078` at 1920.
+    pub const ROW_LUMA: u32 = super::CAP + 0x924;
+    /// The top word; the capture runs once it holds `0x3a7b` (55 §7, §8 #78).
+    pub const TOP: u32 = super::CAP;
+    /// 1080p60 totals.
+    pub const TOTALS_1080P60: u32 = 0x0465_0898;
+    /// 1080p60 size.
+    pub const SIZE_1080P60: u32 = 0x0780_0438;
+    /// Output word bit 31.
+    pub const OUT_ENABLE: u32 = 1 << 31;
+    /// The output words as 55 §8 writes them before the enable (#64, #72): `0x60020000 | height`.
+    pub const OUT_LUMA_OFF_VALUE: u32 = 0x6002_0438;
+}
