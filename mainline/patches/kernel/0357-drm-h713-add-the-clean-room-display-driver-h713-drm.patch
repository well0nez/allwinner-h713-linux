+struct Emit<'s, S: Sink> {
+    sink: &'s mut S,
+}
+
+impl<S: Sink> Emit<'_, S> {
+    fn step(
+        &mut self,
+        name: &'static str,
+        switch: Option<Switch>,
+        rests_on: &'static str,
+        table: Option<TableRef>,
+    ) -> Result<(), ComposeError<S::Error>> {
+        self.sink
+            .step(&Step {
+                name,
+                switch,
+                rests_on,
+                table,
+            })
+            .map_err(ComposeError::Sink)
+    }
+
+    fn op(&mut self, op: Op) -> Result<(), ComposeError<S::Error>> {
+        self.sink.op(gamma_rule(op)).map_err(ComposeError::Sink)
+    }
+
+    fn write(&mut self, addr: u32, value: u32) -> Result<(), ComposeError<S::Error>> {
+        self.op(Op::Write {
+            addr,
+            value,
+            rb: readback_for(addr),
+        })
+    }
+
+    fn masked(&mut self, addr: u32, mask: u32, value: u32) -> Result<(), ComposeError<S::Error>> {
+        self.op(Op::Masked {
+            addr,
+            mask,
+            value,
+            rb: readback_for(addr),
+        })
+    }
+
+    fn latch(&mut self, addr: u32) -> Result<(), ComposeError<S::Error>> {
+        self.op(Op::Write {
+            addr,
+            value: 1,
+            rb: Readback::Latch,
+        })
+    }
+
+    fn check(
+        &mut self,
+        addr: u32,
+        mask: u32,
+        want: u32,
+        fatal: bool,
+        what: &'static str,
+    ) -> Result<(), ComposeError<S::Error>> {
+        self.op(Op::Check {
+            addr,
+            mask,
+            cond: Cond::Eq(want),
+            fatal,
+            what,
+        })
+    }
+}
+
+/// The ratio rule of 20 §2.1: floor(65536 x source / destination).
+pub const fn ratio(src: u32, dst: u32) -> u32 {
+    match (src as u64).saturating_mul(65536).checked_div(dst as u64) {
+        Some(r) => r as u32,
+        None => 0,
+    }
+}
+
+/// `SCL_HRATIO` word: [30:28] horizontal mode, [26:24] vertical mode (20 §2.1: 4/3 at 1:1, 3/2 at
+/// 0xaaaa), [21:0] the horizontal ratio.
+pub const fn hratio_word(state: ScaleState, src_w: u32, dst_w: u32) -> u32 {
+    let (h, v) = match state {
+        ScaleState::OneToOne => (4, 3),
+        ScaleState::Up720To1080 => (3, 2),
+    };
+    (h << 28) | (v << 24) | (ratio(src_w, dst_w) & 0x003f_ffff)
+}
+
+/// Channel 0 geometry words of 10 §2 for a frame.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct ChannelGeometry {
+    pub size: u32,
+    pub blocks: u32,
+    pub ystride: u32,
+    pub cstride: u32,
+    pub ycrop: u32,
+    pub ccrop: u32,
+}
+
+/// 10 §2 / §4 rules: `VCH_SIZE` = (height rounded up to 16, minus 1) << 16 | (width - 1);
+/// `VCH_BLOCKS` = (floor(height/16) - 1) << 16 | (width/16 - 1); strides; crops (chroma height H/2
+/// for NV12 and NV16).
+pub const fn channel_geometry(f: &Frame) -> ChannelGeometry {
+    let h16 = f.height.div_ceil(16).saturating_mul(16);
+    ChannelGeometry {
+        size: (h16.saturating_sub(1) << 16) | f.width.saturating_sub(1),
+        blocks: ((f.height / 16).saturating_sub(1) << 16) | (f.width / 16).saturating_sub(1),
+        ystride: f.pitch,
+        cstride: match f.format {
+            PixelFormat::Nv12 => f.pitch,
+            PixelFormat::Nv16 => f.pitch.saturating_mul(2),
+        },
+        ycrop: (f.height << 16) | f.width,
+        ccrop: ((f.height / 2) << 16) | f.width,
+    }
+}
+
+fn latch_wait<S: Sink>(
+    e: &mut Emit<'_, S>,
+    cfg: &Config,
+    addr: u32,
+) -> Result<(), ComposeError<S::Error>> {
+    match cfg.latch {
+        LatchWait::Poll { timeout_us } => e.op(Op::Poll {
+            addr,
+            mask: 1,
+            want: 0,
+            timeout_us,
+        }),
+        LatchWait::Delay { us } => e.op(Op::Delay { us }),
+        LatchWait::None => Ok(()),
+    }
+}
+
+fn precondition<S: Sink>(e: &mut Emit<'_, S>, cfg: &Config) -> Result<(), ComposeError<S::Error>> {
+    e.step(
+        "precondition",
+        Some(Switch::Precheck),
+        Switch::Precheck.rests_on(),
+        None,
+    )?;
+    e.check(
+        reg::COPROC_CLK,
+        !0,
+        0,
+        true,
+        "co-processor clock 0 (never ran)",
+    )?;
+    e.check(
+        reg::COPROC_RST,
+        !0,
+        0,
+        true,
+        "co-processor reset 0 (never ran)",
+    )?;
+    e.check(0x0200_1050, 1 << 31, 1 << 31, true, "video PLL 2 enabled")?;
+    for (a, what) in [
+        (0x0200_1db0, "deinterlacer clock gate"),
+        (0x0200_1db4, "panel clock gate"),
+        (0x0200_1db8, "video processing clock gate"),
+        (0x0200_1dc0, "scanout clock gate"),
+    ] {
+        e.check(a, 1 << 31, 1 << 31, true, what)?;
+    }
+    e.check(
+        0x0200_1dd8,
+        0x0001_0001,
+        0x0001_0001,
+        true,
+        "display bus gate and reset release",
+    )?;
+    e.check(
+        reg::TCON_TOTAL,
+        !0,
+        (RASTER_V_TOTAL << 16) | RASTER_H_TOTAL,
+        true,
+        "raster totals 2200 x 1125",
+    )?;
+    e.check(
+        reg::TCON_ACTIVE,
+        !0,
+        (cfg.panel.height << 16) | cfg.panel.width,
+        true,
+        "active size = panel",
+    )?;
+    e.check(
+        reg::SCAN_TOP,
+        !0,
+        0x8000_0020,
+        false,
+        "SCAN_TOP as the stage-1 tables leave it",
+    )
+}
+
+/// 10 §6.3 stall signs, as bounded reads that report: the line counter moves, the video vsync
+/// status sets, `PROC_LOCK 0xfe74` [31:16] shows the programmed vertical total, `PNL
+/// 0x051c0148..0158` are non-zero.
+fn raster_check<S: Sink>(e: &mut Emit<'_, S>, cfg: &Config) -> Result<(), ComposeError<S::Error>> {
+    e.step(
+        "raster-check",
+        Some(Switch::RasterCheck),
+        Switch::RasterCheck.rests_on(),
+        None,
+    )?;
+    e.op(Op::Changes {
+        addr: reg::PNL_LINE,
+        mask: 0xffff,
+        timeout_us: 100_000,
+        what: "line counter moves",
+    })?;
+    e.op(Op::Poll {
+        addr: reg::SCAN_IRQ_STATUS,
+        mask: 1,
+        want: 1,
+        timeout_us: 100_000,
+    })?;
+    if cfg.switches.on(Switch::LockTotals) {
+        e.check(
+            reg::PROC_LOCK_SEEN,
+            0xffff_0000,
+            (RASTER_V_TOTAL - 1) << 16,
+            false,
+            "PROC_LOCK fe74 = programmed vertical total",
+        )?;
+    }
+    for a in [
+        0x051c_0148,
+        0x051c_014c,
+        0x051c_0150,
+        0x051c_0154,
+        0x051c_0158,
+    ] {
+        e.op(Op::Check {
+            addr: a,
+            mask: !0,
+            cond: Cond::Ne(0),
+            fatal: false,
+            what: "PNL raster status non-zero",
+        })?;
+    }
+    Ok(())
+}
+
+fn table_steps<S: Sink>(
+    e: &mut Emit<'_, S>,
+    cfg: &Config,
+    db: &[u8],
+    list: &[TableRef],
+) -> Result<(), ComposeError<S::Error>> {
+    let pace = cfg.pacing;
+    let mut first = true;
+    for &t in list {
+        let r = tables::resolve(db, t).map_err(|error| ComposeError::Table {
+            handle: t.handle,
+            error,
+        })?;
+        e.step(
+            "table",
+            Some(Switch::InitTables),
+            Switch::InitTables.rests_on(),
+            Some(t),
+        )?;
+        if !first && pace.between_tables_us > 0 {
+            e.op(Op::Delay {
+                us: pace.between_tables_us,
+            })?;
+        }
+        first = false;
+        for w in r.writes() {
+            if w.is_plain() {
+                e.write(w.addr, w.value)?;
+            } else {
+                e.masked(w.addr, w.mask, w.value)?;
+            }
+            if pace.per_write_us > 0 {
+                e.op(Op::Delay {
+                    us: pace.per_write_us,
+                })?;
+            }
+        }
+    }
+    Ok(())
+}
+
+fn words12<S: Sink>(
+    e: &mut Emit<'_, S>,
+    cfg: &Config,
+    words: &[Word],
+) -> Result<(), ComposeError<S::Error>> {
+    for w in words.iter().filter(|w| !state12::is_status(w.addr)) {
+        let v = if w.buffer {
+            cfg.nr_buffers.relocate(w.value)
+        } else {
+            w.value
+        };
+        e.write(w.addr, v)?;
+    }
+    Ok(())
+}
+
+fn scaler<S: Sink>(
+    e: &mut Emit<'_, S>,
+    cfg: &Config,
+    state: ScaleState,
+) -> Result<(), ComposeError<S::Error>> {
+    e.step(
+        "scaler",
+        Some(Switch::Scaler),
+        Switch::Scaler.rests_on(),
+        None,
+    )?;
+    let f = &cfg.frame;
+    let copies: &[u32] = if cfg.switches.on(Switch::SclAllCopies) {
+        &SCL_COPIES
+    } else {
+        &SCL_COPIES[..1]
+    };
+    for &c in copies {
+        for &(off, _) in &S1_HY320 {
+            if let Some(v) = scaler_word(
+                state,
+                off,
+                f.width,
+                f.height,
+                cfg.panel.width,
+                cfg.panel.height,
+            ) {
+                e.write(reg::SCL.wrapping_add(c).wrapping_add(off), v)?;
+            }
+        }
+    }
+    Ok(())
+}
+
+/// Line-buffer word of `NRC` (20 §3 S2 HY320: 150 at 1920, 100 at 1280 = width / 12.8).
+pub const fn nrc_line_buffer(width: u32) -> u32 {
+    width.saturating_mul(10) / 128
+}
+
+/// `NRC` write-channel words among the source-geometry rows (bit 31 = DMA writes on). 12 §M.4:
+/// never set them without the buffer addresses of the full set in place.
+pub const NRC_WRITE_CHANNELS: [u32; 4] = [0x0500_0178, 0x0500_01b8, 0x0500_0278, 0x0500_02b8];
+
+/// The `PROC`, `NRC` and `DEI` words that carry the source size (20 §3 S2 HY320 and its 1:1 column;
+/// 20 §5.2; `NRC 0x05001028` left out per 12 §M.5). Full set: every row, the write channels only
+/// while the full set's `NRC` words (with their buffers) are written; minimal sets: only the `PROC`
+/// windows and the rows the set writes.
+pub fn source_geometry(cfg: &Config, state: ScaleState) -> impl Iterator<Item = (u32, u32)> {
+    let (w, h) = (cfg.frame.width, cfg.frame.height);
+    let (pw, ph) = (cfg.panel.width, cfg.panel.height);
+    let lb = nrc_line_buffer(w);
+    let set = cfg.dram_set;
+    let words: [(u32, u32); 21] = [
+        (0x0514_0104, w << 16),
+        (0x0514_0108, h << 16),
+        (0x0514_011c, (h << 16) | 0x8002),
+        (0x0514_0124, pw << 16),
+        (0x0514_0128, ph << 16),
+        (0x0500_0224, (h << 16) | w),
+        (0x0500_0444, (h << 16) | w),
+        (0x0500_0544, (h << 16) | w),
+        (0x0500_0804, 0x009f_0000 | w),
+        (0x0500_080c, 0x000f_0000 | h),
+        (0x0500_0844, (w << 16) | 0xa3),
+        (0x0500_085c, (w << 16) | 0xa3),
+        (0x0500_0278, 0xe002_0000 | (h / 2)),
+        (0x0500_02b8, 0xe002_0000 | h),
+        (0x0500_0174, (lb << 16) | lb),
+        (0x0500_01b4, (lb << 16) | lb),
+        (0x0500_0274, (lb << 16) | lb),
+        (0x0500_02b4, (lb << 16) | lb),
+        (0x0500_00f0, 0x6300_0000 | (lb << 8) | lb),
+        (0x0500_0210, 0x6300_0000 | (lb << 8) | lb),
+        (
+            0x050c_028c,
+            match state {
+                ScaleState::OneToOne => 0x0002_46c8,
+                ScaleState::Up720To1080 => 0x0052_46c8,
+            },
+        ),
+    ];
+    let minimal: &'static [Word] = match set {
+        DramSet::Full => &[],
+        DramSet::Minimal40 => &state12::MINIMAL_40,
+        DramSet::Minimal85 => &state12::MINIMAL_85,
+    };
+    let channels_ok = set == DramSet::Full && cfg.switches.on(Switch::DramNrcBorder);
+    words.into_iter().filter(move |&(a, _)| {
+        if NRC_WRITE_CHANNELS.contains(&a) {
+            return channels_ok;
+        }
+        set == DramSet::Full
+            || (0x0514_0104..=0x0514_0128).contains(&a)
+            || minimal.iter().any(|m| m.addr == a)
+    })
+}
+
+/// The channel 0 part of the enable path (10 §6 L4). The one place of the enable/latch hypothesis
+/// (91 O1).
+fn video_channel<S: Sink>(e: &mut Emit<'_, S>, cfg: &Config) -> Result<(), ComposeError<S::Error>> {
+    e.step(
+        "video-channel",
+        None,
+        "10 §2, §4, §5 T1, §6 L1/L4, §6.2; 20 §3 S2 HY320; 91 O1, O3",
+        None,
+    )?;
+    let f = &cfg.frame;
+    let g = channel_geometry(f);
+    let sw = cfg.switches;
+    e.write(reg::RGB_CTRL, RGB_OFF)?;
+    e.latch(reg::RGB_LATCH)?;
+    latch_wait(e, cfg, reg::RGB_LATCH)?;
+    e.write(reg::VCH_SIZE, g.size)?;
+    e.write(reg::VCH_BLOCKS, g.blocks)?;
+    e.write(reg::VCH_YSTRIDE, g.ystride)?;
+    e.write(reg::VCH_CSTRIDE, g.cstride)?;
+    e.write(reg::VCH_YCROP, g.ycrop)?;
+    e.write(reg::VCH_CCROP, g.ccrop)?;
+    // 10 §2 / 20 §3 S2 HY320: the source window, at (0, 0) of the frame (91 O3 answered).
+    e.write(reg::VCH_OUTSIZE, (f.height << 16) | f.width)?;
+    e.write(reg::VCH_YSTART, 0)?;
+    e.write(reg::VCH_CSTART, 0)?;
+    if sw.on(Switch::VchT1Extra) {
+        for (off, v) in [
+            (0x018, 0),
+            (0x01c, 0),
+            (0x028, 0),
+            (0x02c, 0),
+            (0x034, 0x0008_0808),
+        ] {
+            e.write(reg::SCAN.wrapping_add(off), v)?;
+        }
+    }
+    e.write(reg::VCH_GATE, 1)?;
+    e.write(reg::VCH_FIELD, 0)?;
+    e.write(reg::VCH_SRCSEL, VCH_SRCSEL_SLOTS)?;
+    for off in [0x080, 0x094, 0x0a8] {
+        e.write(reg::SCAN.wrapping_add(off), 0)?;
+    }
+    slots(e, f.luma, f.chroma)?;
+    e.latch(reg::VCH_ADDR_LATCH)?;
+    e.write(reg::CHROMA_GAIN, cfg.chroma_gain)?;
+    e.write(reg::VCH_CTRL, VCH_CTRL_ON)?;
+    e.latch(reg::VCH_LATCH)?;
+    latch_wait(e, cfg, reg::VCH_LATCH)?;
+    latch_wait(e, cfg, reg::VCH_ADDR_LATCH)
+}
+
+fn slots<S: Sink>(
+    e: &mut Emit<'_, S>,
+    luma: u32,
+    chroma: u32,
+) -> Result<(), ComposeError<S::Error>> {
+    for i in 0..4u32 {
+        e.write(reg::VCH_YADDR.wrapping_add(i.wrapping_mul(4)), luma)?;
+    }
+    for i in 0..4u32 {
+        e.write(reg::VCH_CADDR.wrapping_add(i.wrapping_mul(4)), chroma)?;
+    }
+    Ok(())
+}
+
+fn white_balance<S: Sink>(e: &mut Emit<'_, S>, cfg: &Config) -> Result<(), ComposeError<S::Error>> {
+    e.step(
+        "white-balance",
+        Some(Switch::WhiteBalance),
+        Switch::WhiteBalance.rests_on(),
+        None,
+    )?;
+    let wb = &cfg.white_balance;
+    let g = |v: u16| v as u32 & 0xfff;
+    let o = |v: i16| v as u16 as u32 & 0xfff;
+    e.masked(
+        reg::WB_GAIN_RG,
+        0x0fff_0fff,
+        (g(wb.red_gain) << 16) | g(wb.green_gain),
+    )?;
+    e.masked(reg::WB_GAIN_B, 0x0fff_0000, g(wb.blue_gain) << 16)?;
+    e.masked(reg::WB_OFFSET_R, 0x0000_0fff, o(wb.red_offset))?;
+    e.masked(
+        reg::WB_OFFSET_GB,
+        0x0fff_0fff,
+        (o(wb.green_offset) << 16) | o(wb.blue_offset),
+    )
+}
+
+/// Composes the enable plan. `db` = the owner's `database.TSE`; `list` = the table list (e.g.
+/// [`tables::DEFAULT_LIST`]). Returns the scaler state the plan targets.
+pub fn enable<S: Sink>(
+    cfg: &Config,
+    db: &[u8],
+    list: &[TableRef],
+    sink: &mut S,
+) -> Result<ScaleState, ComposeError<S::Error>> {
+    let state = cfg.validate()?;
+    let sw = cfg.switches;
+    let mut e = Emit { sink };
+    if sw.on(Switch::Precheck) {
+        precondition(&mut e, cfg)?;
+    }
+    if sw.on(Switch::InitTables) {
+        table_steps(&mut e, cfg, db, list)?;
+    }
+    if sw.on(Switch::LockTotals) {
+        e.step(
+            "lock-totals",
+            Some(Switch::LockTotals),
+            Switch::LockTotals.rests_on(),
+            None,
+        )?;
+        if cfg.pacing.between_tables_us > 0 {
+            e.op(Op::Delay {
+                us: cfg.pacing.between_tables_us,
+            })?;
+        }
+        let t = ((RASTER_V_TOTAL - 1) << 16) | (RASTER_H_TOTAL - 1);
+        e.write(reg::PROC_LOCK_TOTALS, t)?;
+        e.write(reg::PNL_LOCK_TOTALS, t)?;
+    }
+    if sw.on(Switch::Runtime30) {
+        e.step(
+            "runtime-30-5",
+            Some(Switch::Runtime30),
+            Switch::Runtime30.rests_on(),
+            None,
+        )?;
+        for &(addr, value, rb) in &RUNTIME_30_5 {
+            e.op(Op::Write { addr, value, rb })?;
+        }
+    }
+    match cfg.dram_set {
+        DramSet::Full => {
+            if sw.on(Switch::DramRest) {
+                e.step(
+                    "dram-rest",
+                    Some(Switch::DramRest),
+                    Switch::DramRest.rests_on(),
+                    None,
+                )?;
+                for words in [
+                    &state12::PROC_LOCK[..],
+                    &state12::PNL_LOCK,
+                    &state12::PROC,
+                    &state12::SCL,
+                    &state12::DEI,
+                    &state12::PNL,
+                ] {
+                    words12(&mut e, cfg, words)?;
+                }
+            }
+            if sw.on(Switch::DramNrcBorder) {
+                e.step(
+                    "dram-nrc-border",
+                    Some(Switch::DramNrcBorder),
+                    Switch::DramNrcBorder.rests_on(),
+                    None,
+                )?;
+                words12(&mut e, cfg, &state12::NRC)?;
+                words12(&mut e, cfg, &state12::BORDER)?;
+            }
+        }
+        DramSet::Minimal40 | DramSet::Minimal85 if sw.on(Switch::DramNrcBorder) => {
+            let (name, words): (&'static str, &[Word]) = if cfg.dram_set == DramSet::Minimal40 {
+                ("dram-minimal40", &state12::MINIMAL_40)
+            } else {
+                ("dram-minimal85", &state12::MINIMAL_85)
+            };
+            e.step(
+                name,
+                Some(Switch::DramNrcBorder),
+                "12 §M.1 / §M.2; 10 §6.3",
+                None,
+            )?;
+            words12(&mut e, cfg, words)?;
+        }
+        _ => {}
+    }
+    if sw.on(Switch::Scaler) {
+        scaler(&mut e, cfg, state)?;
+    }
+    if sw.on(Switch::SourceGeometry) {
+        e.step(
+            "source-geometry",
+            Some(Switch::SourceGeometry),
+            Switch::SourceGeometry.rests_on(),
+            None,
+        )?;
+        for (addr, value) in source_geometry(cfg, state) {
+            e.write(addr, value)?;
+        }
+    }
+    if sw.on(Switch::FrameSource) {
+        e.step(
+            "frame-source",
+            Some(Switch::FrameSource),
+            Switch::FrameSource.rests_on(),
+            None,
+        )?;
+        e.write(reg::NRC_LATCH_A, NRC_LATCH_A_VALUE)?;
+        e.write(reg::NRC_LATCH_B, nrc_latch_b(cfg.frame.height))?;
+    }
+    if sw.on(Switch::WhiteBalance) {
+        white_balance(&mut e, cfg)?;
+    }
+    video_channel(&mut e, cfg)?;
+    if sw.on(Switch::RasterCheck) {
+        raster_check(&mut e, cfg)?;
+    }
+    if sw.on(Switch::PlaneSelect) {
+        e.step(
+            "plane-select",
+            Some(Switch::PlaneSelect),
+            Switch::PlaneSelect.rests_on(),
+            None,
+        )?;
+        e.write(reg::PNL_SEL, PNL_SEL_VIDEO)?;
+        e.masked(reg::MIX, MIX_RGB_ALONE, 0)?;
+    }
+    Ok(state)
+}
+
+/// Composes the disable plan (10 §6 L5): channel off and latched, slots 0, address latch, chroma
+/// gain rest, RGB channel on and latched, `PNL_SEL` RGB, `MIX` bit 28 set.
+pub fn disable<S: Sink>(cfg: &Config, sink: &mut S) -> Result<(), ComposeError<S::Error>> {
+    let mut e = Emit { sink };
+    e.step("video-off", None, "10 §6 L5", None)?;
+    e.masked(reg::VCH_CTRL, 0x3, 0)?;
+    e.latch(reg::VCH_LATCH)?;
+    latch_wait(&mut e, cfg, reg::VCH_LATCH)?;
+    slots(&mut e, 0, 0)?;
+    e.latch(reg::VCH_ADDR_LATCH)?;
+    e.write(reg::CHROMA_GAIN, CHROMA_GAIN_REST)?;
+    e.write(reg::RGB_CTRL, RGB_ON)?;
+    e.latch(reg::RGB_LATCH)?;
+    latch_wait(&mut e, cfg, reg::RGB_LATCH)?;
+    e.write(reg::PNL_SEL, PNL_SEL_RGB)?;
+    e.masked(reg::MIX, MIX_RGB_ALONE, MIX_RGB_ALONE)
+}
+
+/// Composes an address-only update (10 §6 L2): wait for the previous address latch to be taken (95
+/// T3), luma slots, chroma slots, `VCH_ADDR_LATCH`.
+pub fn flip<S: Sink>(cfg: &Config, sink: &mut S) -> Result<(), ComposeError<S::Error>> {
+    let f = &cfg.frame;
+    if f.luma % 4096 != 0 || f.chroma % 1024 != 0 {
+        return Err(ComposeError::Config(ConfigError::Alignment));
+    }
+    let mut e = Emit { sink };
+    e.step("flip", None, "10 §6 L2, L3; 95 T3", None)?;
+    latch_wait(&mut e, cfg, reg::VCH_ADDR_LATCH)?;
+    slots(&mut e, f.luma, f.chroma)?;
+    e.latch(reg::VCH_ADDR_LATCH)
+}
+
+/// The block of every address a plan touches is one of spec/00 §1 (used by tests and executors).
+pub fn block_of(op: &Op) -> Option<Block> {
+    op.addr().and_then(Block::of)
+}
