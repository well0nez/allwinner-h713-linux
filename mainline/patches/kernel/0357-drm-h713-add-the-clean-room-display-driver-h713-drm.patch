+/// The executor of `align::align`: timing through the C side's callbacks, everything shown through
+/// `Exec`.
+struct AlignExec<'a> {
+    ex: Exec<'a>,
+    ops: &'a H713AlignOps,
+    bufs: &'a H713AlignBufs,
+    cur: PlaneState,
+    base: Config,
+}
+
+/// Histogram bins (30 §4.5): high = bins 24..31 (10 §6.3).
+const HIST_HIGH: u32 = 0x051c_0380 + 24 * 4;
+
+impl AlignEnv for AlignExec<'_> {
+    type Error = i32;
+
+    fn delay_ns(&mut self, samples: u32) -> Result<Option<u64>, i32> {
+        let f = self.ops.delay_ns.ok_or(EINVAL.to_errno())?;
+        let mut v = 0u64;
+        // SAFETY: a C callback with the cookie it was given; `v` is a live u64.
+        match unsafe { f(self.ops.cookie, samples, &mut v) } {
+            0 => Ok(Some(v)),
+            1 => Ok(None),
+            e => Err(e),
+        }
+    }
+
+    fn raster(&mut self, word: u32, frames: u32) -> Result<(), i32> {
+        let f = self.ops.raster.ok_or(EINVAL.to_errno())?;
+        // SAFETY: as in `delay_ns`.
+        match unsafe { f(self.ops.cookie, word, frames) } {
+            0 => Ok(()),
+            e => Err(e),
+        }
+    }
+
+    fn settle(&mut self, frames: u32) -> Result<(), i32> {
+        let f = self.ops.settle.ok_or(EINVAL.to_errno())?;
+        // SAFETY: as in `delay_ns`.
+        match unsafe { f(self.ops.cookie, frames) } {
+            0 => Ok(()),
+            e => Err(e),
+        }
+    }
+
+    fn window(&mut self, plus: bool, lines: u32) -> Result<u32, i32> {
+        let f = self.ops.window.ok_or(EINVAL.to_errno())?;
+        let mut got = 0u32;
+        // SAFETY: as in `delay_ns`; `got` is a live u32.
+        match unsafe { f(self.ops.cookie, u32::from(plus), lines, &mut got) } {
+            0 => Ok(got),
+            e => Err(e),
+        }
+    }
+
+    fn high(&mut self) -> Result<u32, i32> {
+        let mut sum = 0u32;
+        let mut a = HIST_HIGH;
+        for _ in 0..8 {
+            sum = sum.saturating_add(self.ex.io.read(a)?);
+            a = a.wrapping_add(4);
+        }
+        Ok(sum)
+    }
+
+    fn show(&mut self, c: Content) -> Result<(), i32> {
+        let (rgb, video, alpha) = match c {
+            Content::User => (self.cur.rgb, self.cur.video, self.cur.alpha),
+            Content::RowBand | Content::ColBand => {
+                let phys = if c == Content::RowBand {
+                    self.bufs.rgb_rows
+                } else {
+                    self.bufs.rgb_cols
+                };
+                let v = self.cur.video.map(|f| Frame {
+                    luma: self.bufs.video_luma,
+                    chroma: self.bufs.video_chroma,
+                    ..f
+                });
+                (
+                    Some(Rgb {
+                        phys,
+                        pitch: planes::RGB_LINE_BYTES,
+                    }),
+                    v,
+                    0xff,
+                )
+            }
+        };
+        if let Some(r) = &rgb {
+            planes::rgb_show(&mut self.ex, r).map_err(compose_err)?;
+        }
+        if let Some(f) = video {
+            compose::flip(
+                &Config {
+                    frame: f,
+                    ..self.base
+                },
+                &mut self.ex,
+            )
+            .map_err(compose_err)?;
+        }
+        planes::mix(&mut self.ex, video.is_some(), rgb.is_some(), alpha).map_err(compose_err)
+    }
+}
