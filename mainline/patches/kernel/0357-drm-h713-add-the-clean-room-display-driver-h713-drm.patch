+/// One reading of every lock sign.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct Signs {
+    pub timing: Timing,
+    /// Bit 7 of [`TMDS_BYTE`].
+    pub tmds: bool,
+    /// All six enables read set.
+    pub enables: bool,
+    /// `CAP 0x104` [31:16] now and one reading interval earlier.
+    pub frame: u16,
+    pub frame_before: u16,
+    /// `CAP 0x548`, `0x874`.
+    pub totals: u32,
+    pub size: u32,
+    /// Both capture outputs have bit 31 set.
+    pub capturing: bool,
+}
+
+/// What the signs say.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Lock {
+    /// No TMDS on the socket.
+    NoSignal,
+    /// TMDS present, the timing not (yet) valid.
+    Tmds,
+    /// A valid timing other than 1080p60: refused (96: only the measured mode).
+    Unsupported,
+    /// 1080p60 timing and TMDS (the receiver is locked; the capture may start).
+    Locked,
+    /// Locked, and the capture writes the ring: the frame counter moves and its totals and size are
+    /// 1080p60 (55 §3, 96 T3-02/T3-03).
+    Capturing,
+}
+
+/// The TV top as the boot loader leaves it (`0x06e00000/04/08` = `0x00111111 / 0x01111117 /
+/// 0x404`, 50 §2 and 60), or with `+8 = 0x504` once the receiver sequence has run (50 §8 row 18,
+/// 58 §1). After a deep sleep it reads `0x10 / 0 / 0` (60 v4); only the set-up state lets the driver
+/// touch the receiver and the capture block (a reload after a wake hung otherwise, 60 v4 r1/r2).
+pub fn tvtop_set_up(words: [u32; 3]) -> bool {
+    words[0] == 0x0011_1111 && words[1] == 0x0111_1117 && (words[2] == 0x404 || words[2] == 0x504)
+}
+
+/// The receiver sequence is written although TMDS is absent when it has not been written since the
+/// input started, or this long after the last write (inference: not measured; 50 §9's bench wrote
+/// it once per boot).
+pub const RX_RETRY_MS: u32 = 10_000;
+/// After a write, readings without TMDS are not counted as a loss for this long (58 §2: lock
+/// 0.1-0.7 s after the writes; 50 §9 read it 2 s after).
+pub const RX_GRACE_MS: u32 = 2_000;
+/// Readings without TMDS (100 ms apart) that take a written receiver down.
+pub const RX_LOST_READINGS: u32 = 3;
+
+/// The receiver bookkeeping the HDMI work keeps between readings.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct RxWatch {
+    /// The receiver sequence ran and has not been taken down since (or the capture runs).
+    pub up: bool,
+    /// The receiver sequence was written since the input started.
+    pub written: bool,
+    /// Milliseconds since that write (saturating).
+    pub ms_since_write: u32,
+    /// Readings without TMDS counted so far.
+    pub lost: u32,
+}
+
+/// What the HDMI work does with one reading, before the lock evaluation.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+#[repr(u32)]
+pub enum RxStep {
+    /// TMDS with the receiver up: evaluate the reading (`lock`).
+    Evaluate = 0,
+    /// TMDS, receiver not up: write the receiver sequence (50 §8).
+    WriteTmds = 1,
+    /// No TMDS, receiver not up and not written recently: write the receiver sequence anyway, as
+    /// the bench did 3 s after the hot-plug with no TMDS condition (50 §8 Q-RX-3, §9); a fresh
+    /// bench boot (r15) and a wake (60 §3) show TMDS only after it.
+    WriteNoTmds = 2,
+    /// No signal; nothing to count.
+    Wait = 3,
+    /// No signal with the receiver up past the grace: count the reading (`lost + 1`).
+    Count = 4,
+    /// The `RX_LOST_READINGS`-th such reading: take the receiver (and a running capture) down.
+    Lost = 5,
+}
+
+/// One step of the receiver bookkeeping (spec 50 §8, §9; 58 §2; 60 §3).
+pub fn rx_step(tmds: bool, w: &RxWatch) -> RxStep {
+    if tmds {
+        return if w.up {
+            RxStep::Evaluate
+        } else {
+            RxStep::WriteTmds
+        };
+    }
+    if w.up {
+        if w.written && w.ms_since_write < RX_GRACE_MS {
+            return RxStep::Wait;
+        }
+        return if w.lost.saturating_add(1) >= RX_LOST_READINGS {
+            RxStep::Lost
+        } else {
+            RxStep::Count
+        };
+    }
+    if !w.written || w.ms_since_write >= RX_RETRY_MS {
+        RxStep::WriteNoTmds
+    } else {
+        RxStep::Wait
+    }
+}
+
+/// Evaluates one reading (50 §4, 55 §3).
+pub fn lock(s: &Signs) -> Lock {
+    if !s.tmds {
+        return Lock::NoSignal;
+    }
+    if s.timing.is_zero() || s.timing.h_total == 0 || s.timing.v_total == 0 {
+        return Lock::Tmds;
+    }
+    if s.timing != Timing::CTA_1080P60 {
+        return Lock::Unsupported;
+    }
+    if s.capturing
+        && s.frame != s.frame_before
+        && s.totals == cap::TOTALS_1080P60
+        && s.size == cap::SIZE_1080P60
+    {
+        return Lock::Capturing;
+    }
+    Lock::Locked
+}
