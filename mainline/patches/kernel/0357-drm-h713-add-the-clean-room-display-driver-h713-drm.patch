+static void h713_crtc_reset(struct drm_crtc *crtc)
+{
+	struct h713_crtc_state *s;
+	u32 i, lo, hi, def;
+	const char *name;
+
+	if (crtc->state)
+		h713_crtc_destroy_state(crtc, crtc->state);
+	crtc->state = NULL;
+	s = kzalloc(sizeof(*s), GFP_KERNEL);
+	if (!s)
+		return;
+	for (i = 0; i < H713_PQ_N; i++)
+		if (!h713_hw_pq_info(i, &name, &lo, &hi, &def))
+			s->pq[i] = def;
+	__drm_atomic_helper_crtc_reset(crtc, &s->base);
+	/*
+	 * 30 §4.3: the default picture is the 12 state's, whose bank showed the owner's third curve
+	 */
+	if (to_h713(crtc->dev)->gamma_default)
+		s->base.gamma_lut = drm_property_blob_get(to_h713(crtc->dev)->gamma_default);
+}
+
+static struct drm_crtc_state *h713_crtc_duplicate_state(struct drm_crtc *crtc)
+{
+	struct h713_crtc_state *s = kzalloc(sizeof(*s), GFP_KERNEL);
+
+	if (!s)
+		return NULL;
+	__drm_atomic_helper_crtc_duplicate_state(crtc, &s->base);
+	memcpy(s->pq, to_h713_cs(crtc->state)->pq, sizeof(s->pq));
+	s->video_source = to_h713_cs(crtc->state)->video_source;
+	return &s->base;
+}
