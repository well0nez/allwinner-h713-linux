+/// A sink that performs the gamma load at once: masked writes read-modify-write and read back, the
+/// port writes write-only (30 §4.3: the ports never return the data).
+struct GammaLoad<'a> {
+    io: Mmio<'a>,
+    mismatches: u32,
+}
+
+impl Sink for GammaLoad<'_> {
+    type Error = i32;
+
+    fn step(&mut self, _: &Step) -> Result<(), i32> {
+        Ok(())
+    }
+
+    fn op(&mut self, op: Op) -> Result<(), i32> {
+        let addr = op.addr().ok_or(EINVAL.to_errno())?;
+        let old = if matches!(op, Op::Masked { .. }) {
+            self.io.read(addr)?
+        } else {
+            0
+        };
+        let new = op.result(old).ok_or(EINVAL.to_errno())?;
+        self.io.write(addr, new)?;
+        if op.reads_back() && !op.readback_ok(new, self.io.read(addr)?) {
+            self.mismatches = self.mismatches.saturating_add(1);
+        }
+        Ok(())
+    }
+}
+
+/// `int h713_hw_gamma_load(hw, lut, n, show, mismatches)`: a DRM gamma LUT (`struct
+/// drm_color_lut[n]`, n = 1024) into the hidden bank (30 §4.3; the picture does not change), and in
+/// `show` the masked write that shows it with the LUT on (for the next vblank). `*mismatches`:
+/// control-word read-backs that differ. Process context.
+///
+/// # Safety
+///
+/// `hw`, `show`, `mismatches` and `lut` (with `4 * n` u16) are NULL or live.
+#[no_mangle]
+pub unsafe extern "C" fn h713_hw_gamma_load(
+    hw: *const H713Hw,
+    lut: *const u16,
+    n: u32,
+    show: *mut H713Write,
+    mismatches: *mut u32,
+) -> i32 {
+    // SAFETY: by this function's contract.
+    let (Some(hw), Some(show), Some(mismatches)) =
+        (unsafe { hw.as_ref() }, unsafe { show.as_mut() }, unsafe {
+            mismatches.as_mut()
+        })
+    else {
+        return EINVAL.to_errno();
+    };
+    if lut.is_null() || n as usize != gamma::SIZE {
+        return EINVAL.to_errno();
+    }
+    // SAFETY: `lut` has `4 * n` u16 by this function's contract.
+    let lut = unsafe { core::slice::from_raw_parts(lut, gamma::SIZE.saturating_mul(4)) };
+    let mut sink = GammaLoad {
+        io: Mmio { hw },
+        mismatches: 0,
+    };
+    let ctrl = match sink.io.read(compose::GAMMA_CTRL) {
+        Ok(v) => v,
+        Err(e) => return e,
+    };
+    if let Err(e) = gamma::load(&|ch, i| gamma::drm_sample(lut, ch, i), &mut sink) {
+        return e;
+    }
+    let (mask, value) = gamma::show(ctrl);
+    *show = H713Write {
+        addr: compose::GAMMA_CTRL,
+        mask,
+        value,
+    };
+    *mismatches = sink.mismatches;
+    0
+}
+
+fn project_file(hw: &H713Hw) -> &[u8] {
+    if hw.project.is_null() || hw.project_len == 0 {
+        return &[];
+    }
+    // SAFETY: the C side keeps the firmware image (`project`, `project_len`) alive while `hw` is in
+    // use.
+    unsafe { core::slice::from_raw_parts(hw.project, hw.project_len) }
+}
+
+/// `int h713_hw_gamma_default(hw, lut, n)`: the owner's third curve (file order,
+/// `gamma::OWNER_STATE`; 30 §4.3) as `struct drm_color_lut[n]` (n = 1024; red, green, blue,
+/// reserved), each 12-bit sample as `gamma::drm16`, so the load gives the samples back exactly.
+///
+/// # Safety
+///
+/// `hw` and `lut` (with `4 * n` u16) are NULL or live.
+#[no_mangle]
+pub unsafe extern "C" fn h713_hw_gamma_default(hw: *const H713Hw, lut: *mut u16, n: u32) -> i32 {
+    // SAFETY: by this function's contract.
+    let Some(hw) = (unsafe { hw.as_ref() }) else {
+        return EINVAL.to_errno();
+    };
+    if lut.is_null() || n as usize != gamma::SIZE {
+        return EINVAL.to_errno();
+    }
+    // SAFETY: `lut` has `4 * n` u16 by this function's contract.
+    let lut = unsafe { core::slice::from_raw_parts_mut(lut, gamma::SIZE.saturating_mul(4)) };
+    let Some(g) = gamma::owner_curves(project_file(hw)) else {
+        return ENODEV.to_errno();
+    };
+    for (i, e) in lut.chunks_exact_mut(4).enumerate() {
+        for (ch, v) in e.iter_mut().enumerate() {
+            *v = if ch < 3 {
+                match g.sample(gamma::OWNER_STATE, ch, i) {
+                    Some(s) => gamma::drm16(s),
+                    None => return ENODEV.to_errno(),
+                }
+            } else {
+                0
+            };
+        }
+    }
+    0
+}
+
+/// `void h713_hw_gamma_off(w)`: the masked write that turns the LUT off (exactly linear, 30 §4.3).
+///
+/// # Safety
+///
+/// `w` is NULL or live.
+#[no_mangle]
+pub unsafe extern "C" fn h713_hw_gamma_off(w: *mut H713Write) {
+    // SAFETY: by this function's contract.
+    if let Some(w) = unsafe { w.as_mut() } {
+        *w = H713Write {
+            addr: compose::GAMMA_CTRL,
+            mask: gamma::OFF.0,
+            value: gamma::OFF.1,
+        };
+    }
+}
