--- /dev/null
+++ b/drivers/gpu/drm/h713/shared/h713-vp/gamma.rs
@@ -0,0 +1,161 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+//! The panel gamma LUT (30 §4.3, measured with no firmware; 91 O12/O14 answered).
+//!
+//! - Two banks. `0x051c00e8` bit 28 selects the bank shown; the three ports (red `0x05208000`,
+//!   green `0x05208800`, blue `0x05209000`, 512 words each, samples 2k in [11:0] and 2k+1 in
+//!   [23:12]) write into the **other** one, and only while bit 30 is set. Toggling bit 28 swaps the
+//!   banks at once.
+//! - The LUT applies only with bit 26 set and [21:20] = 3; bit 26 clear is exactly linear (the
+//!   neutral state).
+//! - Sequence: set bit 30, write the 3 x 512 words, clear bit 30, toggle bit 28 (and set bit 26
+//!   with [21:20] = 3). No frame-boundary wait is needed.
+//!
+//! The ports never return the data (30 §4.3), so the port writes are [`Readback::WriteOnly`]; what
+//! proves an upload is the probe word `0x051c0304` (30 §4.5) after the bank switch.
+//!
+//! The composer never turns the LUT on (`compose::gamma_rule`): the bank the 12 state points at
+//! holds whatever was there before (a stale curve after a warm reboot). [`upload`] is the only path
+//! that sets bit 26, and only after its curve is in the bank it shows.
+//!
+//! The default picture is the 12 state's, whose bank showed the owner's third curve after a normal
+//! boot (30 §4.3): the DRM module loads that curve ([`owner_curves`], [`OWNER_STATE`]) as its
+//! default `GAMMA_LUT`.
+#![deny(
+    clippy::indexing_slicing,
+    clippy::arithmetic_side_effects,
+    clippy::unwrap_used,
+    clippy::expect_used
+)]
+
+use super::compose::{GAMMA_BANK, GAMMA_CTRL, GAMMA_MODE, GAMMA_ON, GAMMA_PORTS_OPEN};
+use super::h713_tse::gamma::GammaBlob;
+use super::h713_tse::{kind, tse};
+use super::op::{Op, Readback, Sink};
+
+/// LUT entries per channel (one per 10-bit input value).
+pub const SIZE: usize = 1024;
+/// Port words per channel.
+pub const PORT_WORDS: usize = SIZE / 2;
+/// Ports, in the order red, green, blue (30 §4.3: a red port of zeros made pure red black).
+pub const PORTS: [u32; 3] = [0x0520_8000, 0x0520_8800, 0x0520_9000];
+
+/// A 16-bit LUT value (DRM `struct drm_color_lut`) as a 12-bit sample, rounded: 0 -> 0, 0xffff ->
+/// 4095.
+pub const fn sample12(v: u16) -> u16 {
+    // v * 4095 + 32767 <= 268_402_687 fits u32; the quotient is at most 4095.
+    ((v as u32).wrapping_mul(4095).wrapping_add(32767) / 65535) as u16
+}
+
+/// The identity curve of 30 §4.3 (sample i = 4i + i/256): gives back the input within one output
+/// step.
+pub const fn identity12(i: usize) -> u16 {
+    let i = if i < SIZE { i } else { 1023 };
+    // i <= 1023: at most 4095.
+    (i.wrapping_mul(4).wrapping_add(i / 256)) as u16
+}
+
+/// Port word `k` of a channel whose 12-bit samples `sample(i)` gives (values above 4095 are
+/// clipped): sample 2k in [11:0], 2k+1 in [23:12] (30 §4.3; the same packing as
+/// `h713_tse::gamma::port_word`).
+pub fn port_word(k: usize, sample: &impl Fn(usize) -> u16) -> u32 {
+    let clip = |v: u16| u32::from(v.min(0x0fff));
+    let even = k.saturating_mul(2);
+    clip(sample(even)) | (clip(sample(even.saturating_add(1))) << 12)
+}
+
+/// The upload into the hidden bank, then the switch: [`load`], then [`show`] of `ctrl` = the
+/// control word as read now (its bank bit decides which bank is hidden; the switch toggles it).
+pub fn upload<S: Sink>(
+    ctrl: u32,
+    sample: &impl Fn(usize, usize) -> u16,
+    sink: &mut S,
+) -> Result<(), S::Error> {
+    load(sample, sink)?;
+    let (mask, value) = show(ctrl);
+    sink.op(Op::Masked {
+        addr: GAMMA_CTRL,
+        mask,
+        value,
+        rb: Readback::Exact,
+    })
+}
+
+/// The curve into the hidden bank (the picture does not change): ports open, 3 x 512 words, ports
+/// closed. `sample(channel, i)` gives the 12-bit sample `i` of channel 0 (red), 1 (green), 2
+/// (blue).
+pub fn load<S: Sink>(sample: &impl Fn(usize, usize) -> u16, sink: &mut S) -> Result<(), S::Error> {
+    sink.op(Op::Masked {
+        addr: GAMMA_CTRL,
+        mask: GAMMA_PORTS_OPEN,
+        value: GAMMA_PORTS_OPEN,
+        rb: Readback::Exact,
+    })?;
+    for (ch, &port) in PORTS.iter().enumerate() {
+        let one = |i: usize| sample(ch, i);
+        for k in 0..PORT_WORDS {
+            // k < 512: the offset stays inside the port's 0x800 bytes.
+            let addr = port.wrapping_add((k as u32).wrapping_mul(4));
+            sink.op(Op::Write {
+                addr,
+                value: port_word(k, &one),
+                rb: Readback::WriteOnly,
+            })?;
+        }
+    }
+    sink.op(Op::Masked {
+        addr: GAMMA_CTRL,
+        mask: GAMMA_PORTS_OPEN,
+        value: 0,
+        rb: Readback::Exact,
+    })
+}
+
+/// The 12-bit sample of entry `i` of channel `ch` of a DRM LUT (`struct drm_color_lut` = red,
+/// green, blue, reserved, u16 each; [`SIZE`] entries), as a flat u16 slice. Out of range -> 0.
+pub fn drm_sample(lut: &[u16], ch: usize, i: usize) -> u16 {
+    i.checked_mul(4)
+        .and_then(|o| o.checked_add(ch))
+        .and_then(|o| lut.get(o))
+        .map_or(0, |&v| sample12(v))
+}
+
+/// The (mask, value) that shows the hidden bank (bank bit toggled from `ctrl`) with the LUT on.
+pub const fn show(ctrl: u32) -> (u32, u32) {
+    (
+        GAMMA_BANK | GAMMA_ON | GAMMA_MODE,
+        ((ctrl ^ GAMMA_BANK) & GAMMA_BANK) | GAMMA_ON | GAMMA_MODE,
+    )
+}
+
+/// The (mask, value) that turns the LUT off (exactly linear, 30 §4.3; the neutral state, 91 O14).
+pub const OFF: (u32, u32) = (GAMMA_ON, 0);
+
+/// What the probe word `0x051c0304` should show for a 10-bit input `x` through a channel with
+/// 12-bit samples: the sample of index `x`, on the 10-bit output scale (>> 2).
+pub fn expected10(x: u32, sample: &impl Fn(usize) -> u16) -> u32 {
+    let i = (x as usize).min(1023);
+    u32::from(sample(i).min(0x0fff)) >> 2
+}
+
+/// A 12-bit sample as a DRM 16-bit LUT value, rounded so that [`sample12`] gives the sample back
+/// exactly.
+pub const fn drm16(s: u16) -> u16 {
+    let s = if s > 0x0fff { 0x0fff } else { s as u32 };
+    // s * 65535 + 2047 <= 268_369_972 fits u32; the quotient is at most 65535.
+    ((s.wrapping_mul(65535).wrapping_add(2047)) / 4095) as u16
+}
+
+/// Which of the owner's curves is the default picture: the third in file order (30 §4.3: the bank
+/// the 12 state shows after a normal boot held it - probe values equal to it; the closest to
+/// neutral).
+pub const OWNER_STATE: u32 = 2;
+
+/// The owner's gamma curves (`ProjectID_0x00NN.TSE`, the module of table kind `0x90009`, 40 §6).
+pub fn owner_curves(project: &[u8]) -> Option<GammaBlob<'_>> {
+    tse::all_modules(project)
+        .filter_map(|f| f.ok())
+        .find(|f| f.module.table_kind == kind::GAMMA)
+        .and_then(|f| f.module.first_blob())
+        .and_then(|b| GammaBlob::parse(b.data).ok())
+        .filter(|g| g.state(OWNER_STATE).is_some())
+}
