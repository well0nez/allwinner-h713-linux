+/*
+ * Whether [base, base + size) lies inside one no-map region of /reserved-memory (05 §6); its name
+ * in *name.
+ */
+static bool h713_reserved_nomap(u64 base, u64 size, const char **name)
+{
+	struct device_node *rm = of_find_node_by_path("/reserved-memory");
+	struct device_node *child;
+	bool ok = false;
+
+	if (!rm)
+		return false;
+	for_each_child_of_node(rm, child) {
+		struct reserved_mem *r = of_reserved_mem_lookup(child);
+
+		if (r && of_property_read_bool(child, "no-map") && base >= r->base &&
+		    base + size <= r->base + r->size) {
+			*name = r->name;
+			ok = true;
+			of_node_put(child);
+			break;
+		}
+	}
+	of_node_put(rm);
+	return ok;
+}
+
+/*
+ * Spec 60 v4: a deep sleep resets the TV top to 0x10 / 0 / 0 (0x06e00000/04/08) and no re-init is
+ * reliable; a load after a wake that touched the receiver hung (0 of 2). The receiver and the
+ * capture block are used only if the TV top holds the boot loader's set-up: 0x00111111 /
+ * 0x01111117 / 0x404 (50 §2, 60), or 0x504 at +8 once the receiver sequence has run (50 §8, 58
+ * §1). Anything else - the reset values in particular - keeps them off until reboot.
+ */
+static void h713_tvtop_check(struct h713_drm *p)
+{
+	struct device *dev = p->drm.dev;
+	u32 t0 = 0, t4 = 0, t8 = 0;
+
+	if (h713_hw_read(&p->hw, 0x06e00000, &t0) || h713_hw_read(&p->hw, 0x06e00004, &t4) ||
+	    h713_hw_read(&p->hw, 0x06e00008, &t8))
+		return;	/* no TV top mapped: no HDMI input at all (h713_hw_hdmi_mapped) */
+	p->rx_safe = h713_hw_tvtop_set_up(t0, t4, t8);
+	p->hw.cap_blocked = !p->rx_safe;
+	if (p->rx_safe)
+		dev_info(dev, "hdmi: TV top 0x%08x / 0x%08x / 0x%x as the boot loader set it up\n", t0, t4, t8);
+	else
+		dev_warn(dev, "hdmi: TV top 0x%08x / 0x%08x / 0x%x, not the boot loader's set-up (0x10 / 0 / 0 after a deep sleep, spec 60 v4): the HDMI input and the capture block stay untouched until reboot\n",
+			 t0, t4, t8);
+}
+
+static void h713_pd_put(void *data)
+{
+	pm_runtime_put(data);
+}
+
+/* Attach the node's power domains (if it lists more than one) and keep each on; returns how many. */
+static int h713_hold_power_domains(struct device *dev)
+{
+	static const struct dev_pm_domain_attach_data data = {
+		.pd_flags = PD_FLAG_ATTACH_POWER_ON,
+	};
+	struct dev_pm_domain_list *list = NULL;
+	int n, i, ret;
+
+	n = devm_pm_domain_attach_list(dev, &data, &list);
+	if (n <= 0)
+		return n;	/* none, or the single one the core attached (on while bound) */
+	for (i = 0; i < n; i++) {
+		ret = pm_runtime_resume_and_get(list->pd_devs[i]);
+		if (ret)
+			return ret;
+		ret = devm_add_action_or_reset(dev, h713_pd_put, list->pd_devs[i]);
+		if (ret)
+			return ret;
+	}
+	dev_info(dev, "%d power domains held on\n", n);
+	return n;
+}
