+/// `int h713_hw_rx_bringup(hw, ccu, pace, rep)`: the receiver sequence of 50 §8 in its order, each
+/// write read back against what the spec saw (status bytes logged, not compared, 58 §6). `pace`:
+/// with the bench's pauses (about 7 s); without them (58 §2) the writes take milliseconds. `ccu`: make the 17 CCU
+/// writes (#1-#17; only possible where the CCU page is mapped, the bench mode); otherwise they are
+/// counted in `skipped_ccu` and the clocks are the clock driver's. Process context.
+///
+/// # Safety
+///
+/// `hw` and `rep` are NULL or live.
+#[no_mangle]
+pub unsafe extern "C" fn h713_hw_rx_bringup(
+    hw: *const H713Hw,
+    ccu: bool,
+    pace: bool,
+    rep: *mut H713RxReport,
+) -> i32 {
+    // SAFETY: by this function's contract.
+    let (Some(hw), Some(rep)) = (unsafe { hw.as_ref() }, unsafe { rep.as_mut() }) else {
+        return EINVAL.to_errno();
+    };
+    let io = Mmio { hw };
+    let ccu = ccu && io.mapped(BLK_CCU);
+    *rep = H713RxReport {
+        writes: 0,
+        mismatches: 0,
+        skipped_ccu: 0,
+        bad_addr: 0,
+        bad_read: 0,
+    };
+    for w in hdmi::RX_SEQUENCE.iter() {
+        if w.is_ccu() && !ccu {
+            rep.skipped_ccu = rep.skipped_ccu.saturating_add(1);
+            continue;
+        }
+        if pace && w.pause_before_us != 0 {
+            sleep_us(w.pause_before_us);
+        }
+        let (old, read) = match w.kind {
+            RxKind::W8 | RxKind::Or8 => {
+                let old = match io.read8(w.addr) {
+                    Ok(v) => v,
+                    Err(e) => return e,
+                };
+                let new = if w.kind == RxKind::Or8 {
+                    old | w.value as u8
+                } else {
+                    w.value as u8
+                };
+                if let Err(e) = io.write8(w.addr, new) {
+                    return e;
+                }
+                match io.read8(w.addr) {
+                    Ok(r) => (u32::from(old), u32::from(r)),
+                    Err(e) => return e,
+                }
+            }
+            RxKind::W32 | RxKind::Set32 => {
+                let old = match io.read(w.addr) {
+                    Ok(v) => v,
+                    Err(e) => return e,
+                };
+                let new = if w.kind == RxKind::Set32 {
+                    old | w.value
+                } else {
+                    w.value
+                };
+                if let Err(e) = io.write(w.addr, new) {
+                    return e;
+                }
+                match io.read(w.addr) {
+                    Ok(r) => (old, r),
+                    Err(e) => return e,
+                }
+            }
+        };
+        rep.writes = rep.writes.saturating_add(1);
+        if !w.readback_ok(old, read) {
+            if rep.mismatches == 0 {
+                rep.bad_addr = w.addr;
+                rep.bad_read = read;
+            }
+            rep.mismatches = rep.mismatches.saturating_add(1);
+        }
+    }
+    0
+}
