+/// The driver's own capture ring: three NV16 slots of 1920x1080 (55 §2, §8).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Ring {
+    pub luma: [u32; 3],
+    pub chroma: [u32; 3],
+}
+
+/// Slot stride (55 §2: `0x1ff000`).
+pub const SLOT_STRIDE: u32 = 0x1f_f000;
+/// Chroma of a slot after its luma (55 §2, §8: `0x5fd000`).
+pub const CHROMA_OFFSET: u32 = 0x5f_d000;
+/// Bytes of one slot's chroma (NV16 1920x1080: one byte per pixel).
+pub const CHROMA_BYTES: u32 = 1920 * 1080;
+/// The ring of 55 §8 (bench: inside the never-started co-processor's reserved region).
+pub const RING_BASE_DEFAULT: u32 = 0x4b10_0000;
+
+impl Ring {
+    /// The ring at `base` (4 KiB aligned: channel 0 needs luma % 4096 and chroma % 1024, 10 §4).
+    pub fn at(base: u32) -> Option<Ring> {
+        if base % 4096 != 0 {
+            return None;
+        }
+        let s = |i: u32| base.checked_add(SLOT_STRIDE.checked_mul(i)?);
+        let luma = [s(0)?, s(1)?, s(2)?];
+        let c = |l: u32| l.checked_add(CHROMA_OFFSET);
+        let ring = Ring {
+            luma,
+            chroma: [c(luma[0])?, c(luma[1])?, c(luma[2])?],
+        };
+        ring.span()?;
+        Some(ring)
+    }
+
+    /// Bytes from the ring's base to the end of its last chroma slot.
+    pub fn span(&self) -> Option<u32> {
+        self.chroma[2]
+            .checked_add(CHROMA_BYTES)?
+            .checked_sub(self.luma[0])
+    }
+
+    /// Slot `i` (0..3) as (luma, chroma).
+    pub fn slot(&self, i: u8) -> Option<(u32, u32)> {
+        let i = usize::from(i);
+        Some((*self.luma.get(i)?, *self.chroma.get(i)?))
+    }
+}
+
+/// 55 §8 #57-#62 / #65-#70: six table entries, the three slots and slot 3 three times more.
+fn table(slots: &[u32; 3]) -> [u32; 6] {
+    let [a, b, c] = *slots;
+    [a >> 4, b >> 4, c >> 4, c >> 4, c >> 4, c >> 4]
+}
+
+/// One capture write: (address, value, pause before it in µs).
+pub type CapWrite = (u32, u32, u32);
+
+/// The capture programming of 55 §8 in its order, #1..#78, with the ring's address tables; the
+/// output enables (#76/#77) 500 ms after #75, the top word (#78) last.
+pub fn capture_writes(ring: &Ring) -> impl Iterator<Item = CapWrite> + '_ {
+    let luma = table(&ring.luma);
+    let chroma = table(&ring.chroma);
+    let addr = |base: u32, i: usize| base.wrapping_add((i as u32).wrapping_mul(4));
+    let cfg = CAP_CONFIG.iter().map(|&(a, v)| (a, v, 0));
+    let luma_tab =
+        (0..6usize).map(move |i| (addr(CAP + 0x8f0, i), luma.get(i).copied().unwrap_or(0), 0));
+    let chroma_tab =
+        (0..6usize).map(move |i| (addr(CAP + 0x930, i), chroma.get(i).copied().unwrap_or(0), 0));
+    let off = cap::OUT_LUMA_OFF_VALUE;
+    cfg.chain(luma_tab)
+        .chain([(cap::ROW_LUMA, 0x0078_0078, 0), (cap::OUT_LUMA, off, 0)])
+        .chain(chroma_tab)
+        .chain([
+            (CAP + 0x964, 0x0078_0078, 0),
+            (cap::OUT_CHROMA, off, 0),
+            (CAP + 0x970, 0x0c00_0000, 0),
+            (CAP + 0x974, 0x0100_0100, 0),
+            (CAP + 0x978, 0x0000_0003, 0),
+            (
+                cap::OUT_LUMA,
+                off | cap::OUT_ENABLE,
+                CAPTURE_ENABLE_PAUSE_US,
+            ),
+            (cap::OUT_CHROMA, off | cap::OUT_ENABLE, 0),
+            (cap::TOP, 0x0000_3a7b, 0),
+        ])
+}
+
+/// Stopping (55 §4, §8): clear bit 31 of both outputs, then wait [`CAPTURE_STOP_WAIT_US`] before
+/// anything else (power, the ring).
+pub const CAPTURE_STOP: [u32; 2] = [cap::OUT_LUMA, cap::OUT_CHROMA];
+
+/// Slot rotation and frame accounting for channel 0 on the ring (55 §5, §9; 91 O35). There is no
+/// capture interrupt (55 §9): the driver calls this from the video vsync (SPI 110, the panel rate).
+///
+/// At every panel vsync the driver reads the write index (`CAP 0xa0c` [2:0] = the slot written in
+/// the current frame) and the source frame counter (`CAP 0x104` [31:16]) and shows slot
+/// `(0xa0c + 2) mod 3`: the last complete frame, not written for the next two frames (55 §9), while
+/// the new address takes effect at the next vsync (55 §5). A slot shown again is a repeat; source frames that completed but were never shown
+/// are skipped. The shown slot only moves forward (A -> B -> C -> A).
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct Rotation {
+    /// The slot channel 0 was last told to show.
+    pub shown_slot: Option<u8>,
+    /// Source frame counter when that slot was chosen.
+    pub frame_at_show: u16,
+    /// Distinct source frames shown.
+    pub shown: u32,
+    /// Vsyncs that kept the previous slot (no new complete frame).
+    pub repeated: u32,
+    /// Complete source frames never shown.
+    pub skipped: u32,
+    /// Vsyncs with a write index outside 0..2 (ignored).
+    pub bad_index: u32,
+}
+
+impl Rotation {
+    /// One panel vsync: `write_index` = `CAP 0xa0c`, `counter` = `CAP 0x104`. Returns the slot to
+    /// show when it changes.
+    pub fn vsync(&mut self, write_index: u32, counter: u32) -> Option<u8> {
+        let idx = (write_index & 7) as u8;
+        if idx > 2 {
+            self.bad_index = self.bad_index.saturating_add(1);
+            return None;
+        }
+        let frame = (counter >> 16) as u16;
+        let slot = match idx {
+            0 => 2,
+            1 => 0,
+            _ => 1,
+        };
+        match self.shown_slot {
+            Some(s) if s == slot => {
+                self.repeated = self.repeated.saturating_add(1);
+                None
+            }
+            prev => {
+                if let Some(prev) = prev {
+                    // Frames between the two choices that were never shown. The slot step says it
+                    // exactly for up to one lost frame (+1: none, +2: one); the frame counter beyond
+                    // that. The counter alone would jitter by one: it steps about 60 us (3-4 lines)
+                    // before the write index (55 §9).
+                    let step = slot.wrapping_add(3).wrapping_sub(prev) % 3;
+                    let done = frame.wrapping_sub(self.frame_at_show);
+                    let lost = if done >= 3 {
+                        u32::from(done.saturating_sub(1))
+                    } else {
+                        u32::from(step.saturating_sub(1))
+                    };
+                    self.skipped = self.skipped.saturating_add(lost);
+                }
+                self.shown = self.shown.saturating_add(1);
+                self.shown_slot = Some(slot);
+                self.frame_at_show = frame;
+                Some(slot)
+            }
+        }
+    }
+}
diff --git a/drivers/gpu/drm/h713/shared/h713-vp/op.rs b/drivers/gpu/drm/h713/shared/h713-vp/op.rs
new file mode 100644
index 000000000..c66f94215
--- /dev/null
+++ b/drivers/gpu/drm/h713/shared/h713-vp/op.rs
@@ -0,0 +1,159 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+//! The ordered operations a plan consists of. Every access is a 32-bit access at a 4-byte-aligned
+//! physical address.
+#![deny(
+    clippy::indexing_slicing,
+    clippy::arithmetic_side_effects,
+    clippy::unwrap_used,
+    clippy::expect_used
+)]
+
+/// What a read-back after a write is expected to show.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Readback {
+    /// The written bits (all bits for a plain write, the masked bits for a masked write) read back.
+    Exact,
+    /// A request bit the hardware consumes: reads back as written, or 0 once taken (10 §2
+    /// `VCH_LATCH`).
+    Latch,
+    /// Not comparable: a read-only or self-moving word (spec says so); the read is logged only.
+    Ignore,
+    /// Not read back at all: a write port whose reads never return the data (30 §4.3 gamma ports).
+    WriteOnly,
+}
+
+/// The condition of a [`Op::Check`].
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Cond {
+    /// (value AND mask) = the word.
+    Eq(u32),
+    /// (value AND mask) != the word.
+    Ne(u32),
+}
+
+impl Cond {
+    pub const fn holds(self, masked: u32) -> bool {
+        match self {
+            Cond::Eq(w) => masked == w,
+            Cond::Ne(w) => masked != w,
+        }
+    }
+}
+
+/// One operation.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Op {
+    /// Plain 32-bit write.
+    Write { addr: u32, value: u32, rb: Readback },
+    /// Read-modify-write: new = (old AND NOT mask) OR (value AND mask) (40 §4.3 rule).
+    Masked {
+        addr: u32,
+        mask: u32,
+        value: u32,
+        rb: Readback,
+    },
+    /// Wait `us` microseconds.
+    Delay { us: u32 },
+    /// Read `addr` until (value AND mask) = want, at most `timeout_us`; a timeout is reported, not
+    /// fatal.
+    Poll {
+        addr: u32,
+        mask: u32,
+        want: u32,
+        timeout_us: u32,
+    },
+    /// Read `addr` and test (value AND mask) against `cond`. `fatal`: stop the plan when it does
+    /// not hold.
+    Check {
+        addr: u32,
+        mask: u32,
+        cond: Cond,
+        fatal: bool,
+        what: &'static str,
+    },
+    /// Read `addr` until (value AND mask) differs from its first read, at most `timeout_us`;
+    /// reported, not fatal.
+    Changes {
+        addr: u32,
+        mask: u32,
+        timeout_us: u32,
+        what: &'static str,
+    },
+}
+
+impl Op {
+    /// The register the operation accesses, if any.
+    pub const fn addr(&self) -> Option<u32> {
+        match *self {
+            Op::Write { addr, .. }
+            | Op::Masked { addr, .. }
+            | Op::Poll { addr, .. }
+            | Op::Check { addr, .. }
+            | Op::Changes { addr, .. } => Some(addr),
+            Op::Delay { .. } => None,
+        }
+    }
+
+    /// For a write: the value the register should hold afterwards given its old value.
+    pub const fn result(&self, old: u32) -> Option<u32> {
+        match *self {
+            Op::Write { value, .. } => Some(value),
+            Op::Masked { mask, value, .. } => Some((old & !mask) | (value & mask)),
+            _ => None,
+        }
+    }
+
+    /// For a write: the bits a read-back is compared on (0 for `Readback::Ignore` / `WriteOnly`).
+    pub const fn compare_mask(&self) -> u32 {
+        match *self {
+            Op::Write {
+                rb: Readback::Ignore | Readback::WriteOnly,
+                ..
+            }
+            | Op::Masked {
+                rb: Readback::Ignore | Readback::WriteOnly,
+                ..
+            } => 0,
+            Op::Write { .. } => 0xffff_ffff,
+            Op::Masked { mask, .. } => mask,
+            _ => 0,
+        }
+    }
+
+    /// Whether the write is followed by a read at all.
+    pub const fn reads_back(&self) -> bool {
+        !matches!(
+            *self,
+            Op::Write {
+                rb: Readback::WriteOnly,
+                ..
+            } | Op::Masked {
+                rb: Readback::WriteOnly,
+                ..
+            }
+        )
+    }
+
+    /// Whether `read` after the write matches the expectation (`expect` = [`Op::result`]).
+    pub const fn readback_ok(&self, expect: u32, read: u32) -> bool {
+        let m = self.compare_mask();
+        match *self {
+            Op::Write {
+                rb: Readback::Latch,
+                ..
+            }
+            | Op::Masked {
+                rb: Readback::Latch,
+                ..
+            } => read & m == expect & m || read & m == 0,
+            _ => read & m == expect & m,
+        }
+    }
+}
+
+/// Where an operation list goes: the composer calls `step` before the operations of each step.
+pub trait Sink {
+    type Error;
+    fn step(&mut self, step: &super::compose::Step) -> Result<(), Self::Error>;
+    fn op(&mut self, op: Op) -> Result<(), Self::Error>;
+}
diff --git a/drivers/gpu/drm/h713/shared/h713-vp/planes.rs b/drivers/gpu/drm/h713/shared/h713-vp/planes.rs
new file mode 100644
index 000000000..9675e4154
--- /dev/null
+++ b/drivers/gpu/drm/h713/shared/h713-vp/planes.rs
@@ -0,0 +1,299 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+//! The RGB plane (scanout channel 2) and the mix of the two planes, for a KMS driver (spec/05 §1.2,
+//! §2, §3; 10 §3).
+//!
+//! [`commit`] turns an old and a new plane state into operations: the video plane through
+//! [`super::compose`] (enable, address-only flip, disable), the RGB plane by its address/pitch
+//! words and latch (05 §2 R1-R3), and the selector / mixer / global alpha words (10 §3, 05 §2 R5).
+//!
+//! Plane geometry lives in one place: every word that places or sizes the RGB plane is written by
+//! [`rgb_show`], every word that stacks it over the video plane by [`mix`]. The RGB plane covers
+//! the whole panel; its vertical offset over the video plane (05 §2 R4) is not yet measured and
+//! nothing here moves it.
+#![deny(
+    clippy::indexing_slicing,
+    clippy::arithmetic_side_effects,
+    clippy::unwrap_used,
+    clippy::expect_used
+)]
+
+use super::compose::{
+    self, reg, ComposeError, Step, MIX_RGB_ALONE, PNL_SEL_RGB, PNL_SEL_VIDEO, RGB_OFF, RGB_ON,
+};
+use super::config::{Config, ConfigError, Frame};
+use super::op::{Cond, Op, Readback, Sink};
+use super::tables::TableRef;
+
+/// RGB channel words (05 §1.2).
+pub mod rgb {
+    pub const PITCH: u32 = 0x0560_0170;
+    pub const SIZE_PITCH: u32 = 0x0560_0174;
+    pub const ADDR: u32 = 0x0560_0178;
+    pub const STATUS: u32 = 0x0560_0168;
+    pub const IRQ_EN: u32 = 0x0560_016c;
+    /// Frame-done status bit, write 1 to clear (05 §3).
+    pub const DONE: u32 = 1 << 1;
+    /// Interrupt enable of the done bit (05 §3, SPI 112).
+    pub const DONE_IRQ: u32 = 1 << 4;
+}
+
+/// Video vsync status / enable (10 §2, 05 §3, SPI 110).
+pub const VIDEO_VSYNC: u32 = 1;
+pub const VIDEO_IRQ_EN: u32 = 0x0560_00c4;
+
+/// `PNL` global alpha of the RGB plane over the video plane, [7:0] (10 §3, 05 §2 R5).
+pub const PNL_ALPHA: u32 = 0x051c_0070;
+
+/// The RGB frame the takeover state carries (05 §1.2): 1920x1080 XRGB8888.
+pub const RGB_WIDTH: u32 = 1920;
+pub const RGB_HEIGHT: u32 = 1080;
+/// Bytes fetched per line, `0x174` [15:0]: the line length 1920 x 4, not the pitch (05 §1.2).
+pub const RGB_LINE_BYTES: u32 = 7680;
+/// Largest pitch: `0x170` holds 16 bits and the fetch uses it in steps of 16 bytes (05 §1.2).
+pub const RGB_PITCH_MAX: u32 = 0xfff0;
+/// The pitch step the fetch uses (05 §1.2: 7684 fetched as 7680, 8196 as 8192).
+pub const RGB_PITCH_STEP: u32 = 16;
+/// The boot loader's logo (05 §1.2, §6): XRGB8888 1920x1080 at pitch 7680 in the reserved
+/// `uboot-scanout` region.
+pub const LOGO_ADDR: u32 = 0x6c10_0000;
+
+/// The RGB plane: a 1920x1080 XRGB8888 buffer.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Rgb {
+    pub phys: u32,
+    pub pitch: u32,
+}
+
+/// What both planes show.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]
+pub struct PlaneState {
+    pub rgb: Option<Rgb>,
+    /// Global alpha of the RGB plane over the video plane (0xff = RGB only, 05 §2 R5).
+    pub alpha: u8,
+    pub video: Option<Frame>,
+}
+
+/// Whether two frames need the full video enable (anything but the buffer addresses differs).
+pub fn same_geometry(a: &Frame, b: &Frame) -> bool {
+    a.format == b.format && a.width == b.width && a.height == b.height && a.pitch == b.pitch
+}
+
+/// Checks an RGB frame against the measured takeover state.
+pub fn rgb_valid(r: &Rgb) -> Result<(), ConfigError> {
+    // 05 §1.2: `0x170` is the pitch, 16 bits, used in steps of 16 bytes; at least one line's bytes.
+    if r.pitch < RGB_LINE_BYTES || r.pitch > RGB_PITCH_MAX {
+        return Err(ConfigError::Geometry);
+    }
+    if r.phys % 4 != 0 || r.pitch % RGB_PITCH_STEP != 0 {
+        return Err(ConfigError::Alignment);
+    }
+    let bytes = (r.pitch as u64).saturating_mul(RGB_HEIGHT as u64);
+    if (r.phys as u64).saturating_add(bytes) > 1 << 32 {
+        return Err(ConfigError::AddressRange);
+    }
+    Ok(())
+}
+
+fn step<S: Sink>(
+    s: &mut S,
+    name: &'static str,
+    rests_on: &'static str,
+) -> Result<(), ComposeError<S::Error>> {
+    s.step(&Step {
+        name,
+        switch: None,
+        rests_on,
+        table: None,
+    })
+    .map_err(ComposeError::Sink)
+}
+
+fn op<S: Sink>(s: &mut S, o: Op) -> Result<(), ComposeError<S::Error>> {
+    s.op(o).map_err(ComposeError::Sink)
+}
+
+fn write<S: Sink>(s: &mut S, addr: u32, value: u32) -> Result<(), ComposeError<S::Error>> {
+    op(
+        s,
+        Op::Write {
+            addr,
+            value,
+            rb: Readback::Exact,
+        },
+    )
+}
+
+/// Shows `r` on the RGB channel: report a latch still pending (95 S1-T2), address, pitch `0x170`,
+/// lines and bytes per line `0x174` (05 §1.2: 1080 lines of 7680 bytes whatever the pitch), fetch
+/// on, latch (05 §2 R1-R3: the address written before the latch, in the same frame, is the one
+/// taken).
+pub fn rgb_show<S: Sink>(s: &mut S, r: &Rgb) -> Result<(), ComposeError<S::Error>> {
+    rgb_valid(r)?;
+    step(s, "rgb-show", "05 §1.2, §2 R1-R3")?;
+    op(
+        s,
+        Op::Check {
+            addr: reg::RGB_LATCH,
+            mask: 1,
+            cond: Cond::Eq(0),
+            fatal: false,
+            what: "previous RGB latch taken",
+        },
+    )?;
+    write(s, rgb::ADDR, r.phys)?;
+    write(s, rgb::PITCH, r.pitch)?;
+    write(s, rgb::SIZE_PITCH, (RGB_HEIGHT << 16) | RGB_LINE_BYTES)?;
+    write(s, reg::RGB_CTRL, RGB_ON)?;
+    op(
+        s,
+        Op::Write {
+            addr: reg::RGB_LATCH,
+            value: 1,
+            rb: Readback::Latch,
+        },
+    )
+}
+
+/// RGB fetch off (05 §1.2 `0x83001900`) and latch.
+pub fn rgb_off<S: Sink>(s: &mut S) -> Result<(), ComposeError<S::Error>> {
+    step(s, "rgb-off", "05 §1.2; 10 §3")?;
+    write(s, reg::RGB_CTRL, RGB_OFF)?;
+    op(
+        s,
+        Op::Write {
+            addr: reg::RGB_LATCH,
+            value: 1,
+            rb: Readback::Latch,
+        },
+    )
+}
+
+/// Selector, global alpha and mixer for the planes shown (10 §3; 05 §2 R5).
+pub fn mix<S: Sink>(
+    s: &mut S,
+    video_on: bool,
+    rgb_on: bool,
+    alpha: u8,
+) -> Result<(), ComposeError<S::Error>> {
+    step(s, "mix", "10 §3; 05 §2 R5")?;
+    if video_on {
+        write(
+            s,
+            reg::PNL_SEL,
+            if rgb_on { PNL_SEL_RGB } else { PNL_SEL_VIDEO },
+        )?;
+        op(
+            s,
+            Op::Masked {
+                addr: PNL_ALPHA,
+                mask: 0xff,
+                value: alpha as u32,
+                rb: Readback::Exact,
+            },
+        )?;
+        op(
+            s,
+            Op::Masked {
+                addr: reg::MIX,
+                mask: MIX_RGB_ALONE,
+                value: 0,
+                rb: Readback::Exact,
+            },
+        )
+    } else {
+        op(
+            s,
+            Op::Masked {
+                addr: reg::MIX,
+                mask: MIX_RGB_ALONE,
+                value: MIX_RGB_ALONE,
+                rb: Readback::Exact,
+            },
+        )
+    }
+}
+
+/// Leaves the panel as the boot loader left it (05 §6): the logo at `logo` on the RGB channel,
+/// fetch on, latch, `PNL_SEL` 0, `MIX` bit 28 set (RGB alone). Call with the video plane off; the
+/// logo region must still be reserved and untouched.
+pub fn restore_handoff<S: Sink>(s: &mut S, logo: u32) -> Result<(), ComposeError<S::Error>> {
+    rgb_show(
+        s,
+        &Rgb {
+            phys: logo,
+            pitch: RGB_LINE_BYTES,
+        },
+    )?;
+    step(s, "restore-handoff", "05 §6, §1.1")?;
+    write(s, reg::PNL_SEL, 0)?;
+    op(
+        s,
+        Op::Masked {
+            addr: reg::MIX,
+            mask: MIX_RGB_ALONE,
+            value: MIX_RGB_ALONE,
+            rb: Readback::Exact,
+        },
+    )
+}
+
+/// The RGB done interrupt enable (05 §3).
+pub fn vblank_irq<S: Sink>(s: &mut S, on: bool) -> Result<(), ComposeError<S::Error>> {
+    op(
+        s,
+        Op::Masked {
+            addr: rgb::IRQ_EN,
+            mask: rgb::DONE_IRQ,
+            value: if on { rgb::DONE_IRQ } else { 0 },
+            rb: Readback::Exact,
+        },
+    )
+}
+
+/// Operations from `old` to `new`. `base` carries everything but the frame (switches, latch wait,
+/// buffers, set); `db` and `list` as for [`compose::enable`].
+pub fn commit<S: Sink>(
+    s: &mut S,
+    base: &Config,
+    db: &[u8],
+    list: &[TableRef],
+    old: &PlaneState,
+    new: &PlaneState,
+) -> Result<(), ComposeError<S::Error>> {
+    if let Some(r) = &new.rgb {
+        rgb_valid(r)?;
+    }
+    // Video plane. The enable and disable paths rewrite the RGB channel control (10 §6 L4/L5).
+    let mut rgb_touched = false;
+    match (&old.video, &new.video) {
+        (Some(o), Some(n)) if same_geometry(o, n) => {
+            if o.luma != n.luma || o.chroma != n.chroma {
+                compose::flip(&Config { frame: *n, ..*base }, s)?;
+            }
+        }
+        (_, Some(n)) => {
+            compose::enable(&Config { frame: *n, ..*base }, db, list, s)?;
+            rgb_touched = true;
+        }
+        (Some(o), None) => {
+            compose::disable(&Config { frame: *o, ..*base }, s)?;
+            rgb_touched = true;
+        }
+        (None, None) => {}
+    }
+    // RGB plane.
+    match (&old.rgb, &new.rgb) {
+        (o, Some(n)) if rgb_touched || *o != Some(*n) => rgb_show(s, n)?,
+        (o, None) if rgb_touched || o.is_some() => rgb_off(s)?,
+        _ => {}
+    }
+    // Mixer.
+    let mix_changed = old.video.is_some() != new.video.is_some()
+        || old.rgb.is_some() != new.rgb.is_some()
+        || old.alpha != new.alpha
+        || rgb_touched;
+    if mix_changed {
+        mix(s, new.video.is_some(), new.rgb.is_some(), new.alpha)?;
+    }
+    Ok(())
+}
diff --git a/drivers/gpu/drm/h713/shared/h713-vp/pq.rs b/drivers/gpu/drm/h713/shared/h713-vp/pq.rs
new file mode 100644
index 000000000..a059df7d0
--- /dev/null
+++ b/drivers/gpu/drm/h713/shared/h713-vp/pq.rs
@@ -0,0 +1,282 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+//! Picture controls (the PQ part of stage 2): user values -> masked register writes, computed from
+//! the owner's `pq_custom.TSE` curves (40 §5, truncation per 40 §7) and, for the dither class, from
+//! the owner's `database.TSE` (30 §4.4). Only controls whose target words the spec names are
+//! offered:
+//!
+//! | control | words | spec |
+//! |---|---|---|
+//! | saturation 0..100 | `PROC 0x05140508` [23:16] chroma gain, `0x40` = 1.0 | 30 §3.4 (bench boot, no firmware), 12 §M.5 |
+//! | hue 0..100 | `PROC 0x05140508` [9:0], signed, about -0.35 degrees per unit (user 0 -> +256, 100 -> -256) | 30 §3.4 |
+//! | white balance gains / offsets 0..1023 | `PNL 0x051c00d4..00e0`, per channel before gamma; gain `0x800` = 1.0, offset unit = half a 10-bit step | 30 §4.1 |
+//! | contrast 0..100 | `PROC 0x05140d34` [27:16] green, [11:0] blue, `0x05140d38` [11:0] red, `0x958` = 1.0 | 30 §3.3 |
+//! | dither class 0..7 | `PNL 0x051c00ec` | 30 §4.4 four-state table by attribute `0x69`; `0x10101000` adds nothing, `0x14141400` up to +4, `0x16161600` up to +16 on the 10-bit output |
+//! | brightness 0..100 | `PROC 0x051405bc` [17:8], signed 10 bit before the gains (user 50 = 0) | 30 §3.3 (Q-PQ-6) |
+//! | sharpness 0..100 | `PROC 0x05140c4c` [23:16], [7:4], [3:0] (three curves; user 0 = no overshoot) | 30 §3.5 (Q-PQ-7) |
+//!
+//! Left out: the contrast black level (`0x05140d38` [27:16]) and the coarse brightness
+//! (`0x051405bc` [7:0]): the owner's curves do not drive them (30 §3.3); gamma is the DRM
+//! `GAMMA_LUT` (`super::gamma`). The defaults reproduce the state the video enable programs
+//! (spec/12 / 12 §M.5), which is brighter than neutral (30 §3.3: brightness +100, gains 1.45).
+#![deny(
+    clippy::indexing_slicing,
+    clippy::arithmetic_side_effects,
+    clippy::unwrap_used,
+    clippy::expect_used
+)]
+
+use super::h713_tse::pqcustom::UserControls;
+use super::h713_tse::tse;
+
+/// The controls, in the order of the driver interface.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+#[repr(u8)]
+pub enum Control {
+    Saturation,
+    Hue,
+    WbRedGain,
+    WbGreenGain,
+    WbBlueGain,
+    WbRedOffset,
+    WbGreenOffset,
+    WbBlueOffset,
+    Contrast,
+    Dither,
+    Brightness,
+    Sharpness,
+}
+
+pub const CONTROLS: [Control; 12] = [
+    Control::Saturation,
+    Control::Hue,
+    Control::WbRedGain,
+    Control::WbGreenGain,
+    Control::WbBlueGain,
+    Control::WbRedOffset,
+    Control::WbGreenOffset,
+    Control::WbBlueOffset,
+    Control::Contrast,
+    Control::Dither,
+    Control::Brightness,
+    Control::Sharpness,
+];
+
+/// A masked register write: new = (old AND NOT mask) OR value (value within the mask).
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]
+pub struct MaskedWrite {
+    pub addr: u32,
+    pub mask: u32,
+    pub value: u32,
+}
+
+impl MaskedWrite {
+    pub const fn apply(&self, old: u32) -> u32 {
+        (old & !self.mask) | (self.value & self.mask)
+    }
+}
+
+/// Writes of one control (at most 3 words: contrast).
+pub const MAX_WRITES: usize = 4;
+
+/// Why a control cannot be computed.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum PqError {
+    /// The value is outside the control's range.
+    Range,
+    /// The owner's file has no such control / table.
+    Missing,
+    /// The file's curve does not cover the value.
+    Curve,
+    /// The file targets a register the spec does not name for this control.
+    Target(u32),
+}
+
+impl Control {
+    pub const fn name(self) -> &'static str {
+        match self {
+            Control::Saturation => "saturation",
+            Control::Hue => "hue",
+            Control::WbRedGain => "wb_red_gain",
+            Control::WbGreenGain => "wb_green_gain",
+            Control::WbBlueGain => "wb_blue_gain",
+            Control::WbRedOffset => "wb_red_offset",
+            Control::WbGreenOffset => "wb_green_offset",
+            Control::WbBlueOffset => "wb_blue_offset",
+            Control::Contrast => "contrast",
+            Control::Dither => "dither_class",
+            Control::Brightness => "brightness",
+            Control::Sharpness => "sharpness",
+        }
+    }
+
+    pub fn by_name(name: &str) -> Option<Control> {
+        CONTROLS.iter().copied().find(|c| c.name() == name)
+    }
+
+    /// (min, max) of the user value.
+    pub const fn range(self) -> (u32, u32) {
+        match self {
+            Control::Saturation
+            | Control::Hue
+            | Control::Contrast
+            | Control::Brightness
+            | Control::Sharpness => (0, 100),
+            Control::Dither => (0, 7),
+            _ => (0, 1023),
+        }
+    }
+
+    /// The value that reproduces the state the video enable programs.
+    pub const fn default(self) -> u32 {
+        match self {
+            // 12 §M.5: chroma gain 0x40 = saturation 50; hue 50 -> [9:0] = 0 (12: 0x04400000).
+            Control::Saturation | Control::Hue => 50,
+            // 12: 0x05140d34 = 0x0d8c0d8c, 0x05140d38 = 0x00400d8c = contrast 95 (the file's base
+            // 0x958 is 50).
+            Control::Contrast => 95,
+            // 12: 0x051c00ec = 0x14141400 = the dither table's state of class 0 (and 2).
+            Control::Dither => 0,
+            // 12: 0x051405bc = 0x00006480: [17:8] = +100 = user 100 (the curve maps 50..100 to
+            // 0..100).
+            Control::Brightness => 100,
+            // 12: 0x05140c4c = 0x80780855: [23:16] = 0x78, [7:4] = [3:0] = 5 = user 50 on all three
+            // curves.
+            Control::Sharpness => 50,
+            // 30 §4.1: neutral = 512 (gain 2048, offset 0).
+            _ => 512,
+        }
+    }
+
+    /// The control's curves in `pq_custom.TSE` (40 §5); empty for the dither class (a
+    /// `database.TSE` table).
+    pub const fn curve_names(self) -> &'static [&'static [u8]] {
+        match self {
+            Control::Saturation => &[b"mp_saturation_1"],
+            Control::Hue => &[b"mp_tint_1"],
+            Control::WbRedGain => &[b"wb_r_gain"],
+            Control::WbGreenGain => &[b"wb_g_gain"],
+            Control::WbBlueGain => &[b"wb_b_gain"],
+            Control::WbRedOffset => &[b"wb_r_offset"],
+            Control::WbGreenOffset => &[b"wb_g_offset"],
+            Control::WbBlueOffset => &[b"wb_b_offset"],
+            Control::Contrast => &[b"mp_contrast"],
+            Control::Dither => &[],
+            Control::Brightness => &[b"mp_brightness"],
+            // 30 §3.5: [23:16], [7:4], [3:0] of 0x05140c4c.
+            Control::Sharpness => &[b"mp_sharpness_1", b"mp_sharpness_7", b"mp_sharpness_8"],
+        }
+    }
+
+    /// The (register, mask) pairs the spec names for the control; any other target in the file is
+    /// refused.
+    pub const fn targets(self) -> &'static [(u32, u32)] {
+        match self {
+            Control::Saturation => &[(0x0514_0508, 0x00ff_0000)],
+            Control::Hue => &[(0x0514_0508, 0x0000_03ff)],
+            Control::WbRedGain => &[(0x051c_00dc, 0x0fff_0000)],
+            Control::WbGreenGain => &[(0x051c_00dc, 0x0000_0fff)],
+            Control::WbBlueGain => &[(0x051c_00e0, 0x0fff_0000)],
+            Control::WbRedOffset => &[(0x051c_00d4, 0x0000_0fff)],
+            Control::WbGreenOffset => &[(0x051c_00d8, 0x0fff_0000)],
+            Control::WbBlueOffset => &[(0x051c_00d8, 0x0000_0fff)],
+            Control::Contrast => &[
+                (0x0514_0d34, 0x0fff_0000),
+                (0x0514_0d34, 0x0000_0fff),
+                (0x0514_0d38, 0x0000_0fff),
+            ],
+            Control::Dither => &[(0x051c_00ec, 0xffff_ffff)],
+            Control::Brightness => &[(0x0514_05bc, 0x0003_ff00)],
+            Control::Sharpness => &[
+                (0x0514_0c4c, 0x00ff_0000),
+                (0x0514_0c4c, 0x0000_00f0),
+                (0x0514_0c4c, 0x0000_000f),
+            ],
+        }
+    }
+}
+
+/// The writes of `control` at `value`. `pq`: the parsed `pq_custom.TSE` controls; `db`:
+/// `database.TSE` (dither). Returns the writes and their count.
+pub fn writes(
+    control: Control,
+    value: u32,
+    pq: Option<&UserControls<'_>>,
+    db: &[u8],
+) -> Result<([MaskedWrite; MAX_WRITES], usize), PqError> {
+    let (lo, hi) = control.range();
+    if value < lo || value > hi {
+        return Err(PqError::Range);
+    }
+    let mut out = [MaskedWrite::default(); MAX_WRITES];
+    let mut n = 0usize;
+    let mut push = |w: MaskedWrite| -> Result<(), PqError> {
+        if !control.targets().contains(&(w.addr, w.mask)) {
+            return Err(PqError::Target(w.addr));
+        }
+        let slot = out.get_mut(n).ok_or(PqError::Target(w.addr))?;
+        *slot = w;
+        n = n.saturating_add(1);
+        Ok(())
+    };
+    let names = control.curve_names();
+    if !names.is_empty() {
+        let v = i32::try_from(value).map_err(|_| PqError::Range)?;
+        for name in names {
+            let c = pq.and_then(|p| p.find(name)).ok_or(PqError::Missing)?;
+            for set in c.record.sets() {
+                let y = set.curve.eval(v).ok_or(PqError::Curve)?;
+                for r in set.regs() {
+                    if r.width_bits != 32 {
+                        return Err(PqError::Target(r.addr));
+                    }
+                    push(MaskedWrite {
+                        addr: r.addr,
+                        mask: r.mask,
+                        value: r.place(0, y),
+                    })?;
+                }
+            }
+        }
+    } else {
+        // 30 §4.4: the four-state table that writes 0x051c00ec, state by the attribute 0x69 value.
+        let found = dither_table(db).ok_or(PqError::Missing)?;
+        let state = found
+            .state_with_attr(0x0069_0000 | value)
+            .ok_or(PqError::Range)?;
+        let t = found.reg_table().map_err(|_| PqError::Missing)?;
+        for w in t.writes(state).into_iter().flatten() {
+            push(MaskedWrite {
+                addr: w.addr,
+                mask: w.mask,
+                value: w.value & w.mask,
+            })?;
+        }
+    }
+    if n == 0 {
+        return Err(PqError::Missing);
+    }
+    Ok((out, n))
+}
+
+fn dither_table(db: &[u8]) -> Option<tse::Module<'_>> {
+    tse::all_modules(db)
+        .filter_map(|f| f.ok())
+        .map(|f| f.module)
+        .find(|m| {
+            m.table_kind == super::h713_tse::kind::REGISTER_TABLE
+                && m.state_count == 4
+                && m.reg_table()
+                    .ok()
+                    .and_then(|t| t.writes(0))
+                    .is_some_and(|mut w| w.any(|w| w.addr == 0x051c_00ec))
+        })
+}
+
+/// The `pq_custom.TSE` controls blob in a file (the module of table kind `0x9101f`, 40 §5).
+pub fn user_controls(file: &[u8]) -> Option<UserControls<'_>> {
+    tse::all_modules(file)
+        .filter_map(|f| f.ok())
+        .find(|f| f.module.table_kind == super::h713_tse::kind::USER_CONTROLS)
+        .and_then(|f| f.module.first_blob())
+        .and_then(|b| UserControls::parse(b.data).ok())
+}
diff --git a/drivers/gpu/drm/h713/shared/h713-vp/resume.rs b/drivers/gpu/drm/h713/shared/h713-vp/resume.rs
new file mode 100644
index 000000000..b835bea16
--- /dev/null
+++ b/drivers/gpu/drm/h713/shared/h713-vp/resume.rs
@@ -0,0 +1,557 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+//! Resume from system sleep: the "panel bring-up" step, as data.
+//!
+//! After a real sleep the boot loader's panel set-up (stage 1, 05 §1) is gone. The register
+//! program the boot loader runs is in the owner's `LogoRegData.bin` (40 §3: per project a
+//! prologue, a timing and a picture-path block of masked writes, pulses and delays). Which of
+//! those records a resume must replay, and in which order, is spec/05 §7 - **not crossed yet**.
+//! This module therefore guesses nothing: the replay is a [`Plan`] given as data (a module
+//! parameter on the device), parsed and validated here, and executed record by record from the
+//! owner's file. With an empty plan there is no panel step.
+//!
+//! Plan syntax (ASCII): parts separated by `,`; each part is a class name `prologue`, `timing` or
+//! `picture` (the project's block of that class, 40 §3) with an optional inclusive record range
+//! `[a-b]` (`[a-]` = to the end of the block). Example: `prologue,timing,picture[0-11]`.
+#![deny(
+    clippy::indexing_slicing,
+    clippy::arithmetic_side_effects,
+    clippy::unwrap_used,
+    clippy::expect_used
+)]
+
+use super::h713_tse::logo::{self, Action, Logo};
+use super::op::{Op, Readback, Sink};
+
+/// At most this many parts in a plan.
+pub const MAX_PARTS: usize = 8;
+
+/// One part of a plan: records `first..=last` of the project's block of `class`.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Part {
+    /// `logo::class::PROLOGUE`, `TIMING` or `PICTURE_PATH`.
+    pub class: u32,
+    pub first: u32,
+    /// Inclusive; `u32::MAX` = to the end of the block.
+    pub last: u32,
+}
+
+/// A parsed plan.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Plan {
+    parts: [Part; MAX_PARTS],
+    len: usize,
+}
+
+/// Why a plan is refused.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum PlanError {
+    /// A part names no known class.
+    Class,
+    /// A malformed or empty record range.
+    Range,
+    /// More than [`MAX_PARTS`] parts.
+    TooLong,
+    /// The owner's file has no program for the project (40 §3).
+    NoProgram,
+    /// The file does not parse, or a block fails the walk rules (40 §3).
+    File,
+    /// A part's range lies beyond its block.
+    BeyondBlock,
+}
+
+fn number(s: &[u8]) -> Option<u32> {
+    if s.is_empty() || s.len() > 9 {
+        return None;
+    }
+    let mut v = 0u32;
+    for &c in s {
+        if !c.is_ascii_digit() {
+            return None;
+        }
+        v = v
+            .checked_mul(10)?
+            .checked_add(u32::from(c.wrapping_sub(b'0')))?;
+    }
+    Some(v)
+}
+
+/// Index of the first `b` in `s` (a plain loop, as `trim`).
+fn find(s: &[u8], b: u8) -> Option<usize> {
+    let mut i = 0usize;
+    for &c in s {
+        if c == b {
+            return Some(i);
+        }
+        i = i.wrapping_add(1);
+    }
+    None
+}
+
+fn trim(s: &[u8]) -> &[u8] {
+    // Plain slice patterns: the kernel builds this crate with overflow checks, and the generic
+    // `position` / `rposition` / `count` would bring theirs in.
+    let mut s = s;
+    while let [first, rest @ ..] = s {
+        if !first.is_ascii_whitespace() {
+            break;
+        }
+        s = rest;
+    }
+    while let [rest @ .., last] = s {
+        if !last.is_ascii_whitespace() {
+            break;
+        }
+        s = rest;
+    }
+    s
+}
+
+impl Plan {
+    /// The empty plan: no panel step.
+    pub const EMPTY: Plan = Plan {
+        parts: [Part {
+            class: 0,
+            first: 0,
+            last: 0,
+        }; MAX_PARTS],
+        len: 0,
+    };
+
+    /// Parses the plan syntax of the module text.
+    pub fn parse(s: &[u8]) -> Result<Plan, PlanError> {
+        let mut plan = Plan::EMPTY;
+        for raw in s.split(|&c| c == b',') {
+            let p = trim(raw);
+            if p.is_empty() {
+                continue;
+            }
+            let (name, range) = match find(p, b'[') {
+                Some(i) => (
+                    trim(p.get(..i).unwrap_or(&[])),
+                    Some(p.get(i..).unwrap_or(&[])),
+                ),
+                None => (p, None),
+            };
+            let class = match name {
+                b"prologue" => logo::class::PROLOGUE,
+                b"timing" => logo::class::TIMING,
+                b"picture" => logo::class::PICTURE_PATH,
+                _ => return Err(PlanError::Class),
+            };
+            let (first, last) = match range {
+                None => (0, u32::MAX),
+                Some(r) => {
+                    let inner = r
+                        .strip_prefix(b"[")
+                        .and_then(|r| r.strip_suffix(b"]"))
+                        .ok_or(PlanError::Range)?;
+                    let dash = find(inner, b'-').ok_or(PlanError::Range)?;
+                    let a = inner.get(..dash).unwrap_or(&[]);
+                    let b = inner.get(dash.saturating_add(1)..).unwrap_or(&[]);
+                    let first = number(trim(a)).ok_or(PlanError::Range)?;
+                    let last = if trim(b).is_empty() {
+                        u32::MAX
+                    } else {
+                        number(trim(b)).ok_or(PlanError::Range)?
+                    };
+                    if last < first {
+                        return Err(PlanError::Range);
+                    }
+                    (first, last)
+                }
+            };
+            let slot = plan.parts.get_mut(plan.len).ok_or(PlanError::TooLong)?;
+            *slot = Part { class, first, last };
+            plan.len = plan.len.saturating_add(1);
+        }
+        Ok(plan)
+    }
+
+    /// The parts, in their order.
+    pub fn parts(&self) -> &[Part] {
+        self.parts.get(..self.len).unwrap_or(&[])
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.len == 0
+    }
+}
+
+/// The program's block of `class` (40 §3, walk rules checked).
+fn block<'a>(file: &Logo<'a>, project: u32, class: u32) -> Result<logo::Block<'a>, PlanError> {
+    let prog = file
+        .program(project)
+        .map_err(|_| PlanError::File)?
+        .ok_or(PlanError::NoProgram)?;
+    let [p, t, q] = prog;
+    Ok(match class {
+        logo::class::PROLOGUE => p,
+        logo::class::TIMING => t,
+        _ => q,
+    })
+}
+
+/// The records of one part.
+fn records<'a>(
+    file: &Logo<'a>,
+    project: u32,
+    part: &Part,
+) -> Result<impl Iterator<Item = logo::Record> + 'a, PlanError> {
+    let b = block(file, project, part.class)?;
+    let n = b.len();
+    let first = part.first as usize;
+    if first >= n || (part.last != u32::MAX && part.last as usize >= n) {
+        return Err(PlanError::BeyondBlock);
+    }
+    let take = if part.last == u32::MAX {
+        n.saturating_sub(first)
+    } else {
+        (part.last as usize).saturating_sub(first).saturating_add(1)
+    };
+    Ok(b.records().skip(first).take(take))
+}
+
+/// What a replay consists of.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct Counts {
+    pub writes: u32,
+    pub pulses: u32,
+    pub delays: u32,
+    pub delay_us: u64,
+}
+
+/// Validates `plan` against the owner's file and counts what it would do.
+pub fn check(file: &[u8], project: u32, plan: &Plan) -> Result<Counts, PlanError> {
+    let l = Logo::parse(file).map_err(|_| PlanError::File)?;
+    let mut c = Counts::default();
+    for part in plan.parts() {
+        for r in records(&l, project, part)? {
+            match r.action() {
+                Action::Masked { .. } => c.writes = c.writes.saturating_add(1),
+                Action::Pulse { .. } => c.pulses = c.pulses.saturating_add(1),
+                Action::Delay { us } => {
+                    c.delays = c.delays.saturating_add(1);
+                    c.delay_us = c.delay_us.saturating_add(u64::from(us));
+                }
+                // `program` has checked every record (40 §3 walk rules).
+                Action::Unknown => return Err(PlanError::File),
+            }
+        }
+    }
+    Ok(c)
+}
+
+/// The distinct 4 KiB register pages the plan touches, ascending, into `out`; returns how many
+/// (the caller maps them; more than `out` holds is an error).
+pub fn pages(file: &[u8], project: u32, plan: &Plan, out: &mut [u32]) -> Result<usize, PlanError> {
+    let l = Logo::parse(file).map_err(|_| PlanError::File)?;
+    let mut n = 0usize;
+    for part in plan.parts() {
+        for r in records(&l, project, part)? {
+            let addr = match r.action() {
+                Action::Masked { addr, .. } | Action::Pulse { addr, .. } => addr,
+                Action::Delay { .. } => continue,
+                Action::Unknown => return Err(PlanError::File),
+            };
+            let page = addr & !0xfff;
+            let seen = out.get(..n).unwrap_or(&[]);
+            if seen.contains(&page) {
+                continue;
+            }
+            // Insert keeping `out[..=n]` ascending: shift the larger ones up by one.
+            let mut at = 0usize;
+            for &p in seen {
+                if p < page {
+                    at = at.wrapping_add(1);
+                }
+            }
+            if n >= out.len() {
+                return Err(PlanError::TooLong);
+            }
+            let mut i = n;
+            while i > at {
+                let prev = out.get(i.wrapping_sub(1)).copied().unwrap_or(0);
+                if let Some(o) = out.get_mut(i) {
+                    *o = prev;
+                }
+                i = i.wrapping_sub(1);
+            }
+            if let Some(o) = out.get_mut(at) {
+                *o = page;
+            }
+            n = n.saturating_add(1);
+        }
+    }
+    Ok(n)
+}
+
+/// The replay as operations, in the plan's order: a masked write per kind-1/2/4 record (read back
+/// and compared under its mask; a mismatch is reported, the replay goes on), a pulse as the mask
+/// bits cleared then set (not compared), a delay as a delay.
+pub fn replay<S: Sink>(
+    file: &[u8],
+    project: u32,
+    plan: &Plan,
+    sink: &mut S,
+) -> Result<Counts, ReplayError<S::Error>> {
+    let l = Logo::parse(file).map_err(|_| ReplayError::Plan(PlanError::File))?;
+    let mut c = Counts::default();
+    for part in plan.parts() {
+        let step = super::compose::Step {
+            name: match part.class {
+                logo::class::PROLOGUE => "panel-prologue",
+                logo::class::TIMING => "panel-timing",
+                _ => "panel-picture-path",
+            },
+            switch: None,
+            rests_on: "40 §3 (LogoRegData); the plan from spec 05 §7",
+            table: None,
+        };
+        sink.step(&step).map_err(ReplayError::Sink)?;
+        for r in records(&l, project, part).map_err(ReplayError::Plan)? {
+            let op = match r.action() {
+                Action::Masked { addr, value, mask } => {
+                    c.writes = c.writes.saturating_add(1);
+                    Op::Masked {
+                        addr,
+                        mask,
+                        value,
+                        rb: Readback::Exact,
+                    }
+                }
+                Action::Pulse { addr, mask } => {
+                    c.pulses = c.pulses.saturating_add(1);
+                    sink.op(Op::Masked {
+                        addr,
+                        mask,
+                        value: 0,
+                        rb: Readback::Ignore,
+                    })
+                    .map_err(ReplayError::Sink)?;
+                    Op::Masked {
+                        addr,
+                        mask,
+                        value: mask,
+                        rb: Readback::Ignore,
+                    }
+                }
+                Action::Delay { us } => {
+                    c.delays = c.delays.saturating_add(1);
+                    c.delay_us = c.delay_us.saturating_add(u64::from(us));
+                    Op::Delay { us }
+                }
+                Action::Unknown => return Err(ReplayError::Plan(PlanError::File)),
+            };
+            sink.op(op).map_err(ReplayError::Sink)?;
+        }
+    }
+    Ok(c)
+}
+
+/// A replay failure.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ReplayError<E> {
+    Plan(PlanError),
+    Sink(E),
+}
+
+/// At most this many entries in a [`RegPlan`].
+pub const MAX_REGS: usize = 48;
+
+/// One entry of a [`RegPlan`].
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum RegStep {
+    /// A 32-bit write, read back and compared unless `check` is false (`ADDR=VALUE!`: words that
+    /// read back otherwise, e.g. 60 §3's PLL words whose bit 0 reads 0).
+    Write { addr: u32, value: u32, check: bool },
+    /// Wait `us` microseconds.
+    Delay { us: u32 },
+}
+
+/// A register re-init given as data: the TV-top re-init after a wake (spec 60: the TV top resets
+/// in a sleep, and the first capture read before its re-init hangs the SoC). Its words come from
+/// the spec side; nothing is compiled in.
+///
+/// Syntax (ASCII): entries separated by `,`: `ADDR=VALUE` (hex with `0x`, or decimal; a 32-bit
+/// write, 4-aligned, read back and compared), `ADDR=VALUE!` (the same, the read-back logged only)
+/// or `delay=US`.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct RegPlan {
+    steps: [RegStep; MAX_REGS],
+    len: usize,
+}
+
+fn value(s: &[u8]) -> Option<u32> {
+    match s {
+        [b'0', b'x' | b'X', hex @ ..] => {
+            if hex.is_empty() || hex.len() > 8 {
+                return None;
+            }
+            let mut v = 0u32;
+            for &c in hex {
+                let d = match c {
+                    b'0'..=b'9' => c.wrapping_sub(b'0'),
+                    b'a'..=b'f' => c.wrapping_sub(b'a').wrapping_add(10),
+                    b'A'..=b'F' => c.wrapping_sub(b'A').wrapping_add(10),
+                    _ => return None,
+                };
+                v = (v << 4) | u32::from(d);
+            }
+            Some(v)
+        }
+        _ => number(s),
+    }
+}
+
+impl RegPlan {
+    /// The empty plan.
+    pub const EMPTY: RegPlan = RegPlan {
+        steps: [RegStep::Delay { us: 0 }; MAX_REGS],
+        len: 0,
+    };
+
+    /// Parses the syntax above.
+    pub fn parse(s: &[u8]) -> Result<RegPlan, PlanError> {
+        let mut plan = RegPlan::EMPTY;
+        for raw in s.split(|&c| c == b',') {
+            let e = trim(raw);
+            if e.is_empty() {
+                continue;
+            }
+            let eq = find(e, b'=').ok_or(PlanError::Range)?;
+            let key = trim(e.get(..eq).unwrap_or(&[]));
+            let val = trim(e.get(eq.saturating_add(1)..).unwrap_or(&[]));
+            let step = if key == b"delay" {
+                RegStep::Delay {
+                    us: value(val).ok_or(PlanError::Range)?,
+                }
+            } else {
+                let addr = value(key).ok_or(PlanError::Range)?;
+                if addr % 4 != 0 {
+                    return Err(PlanError::Range);
+                }
+                let (val, check) = match val.strip_suffix(b"!") {
+                    Some(v) => (trim(v), false),
+                    None => (val, true),
+                };
+                RegStep::Write {
+                    addr,
+                    value: value(val).ok_or(PlanError::Range)?,
+                    check,
+                }
+            };
+            let slot = plan.steps.get_mut(plan.len).ok_or(PlanError::TooLong)?;
+            *slot = step;
+            plan.len = plan.len.saturating_add(1);
+        }
+        Ok(plan)
+    }
+
+    pub fn steps(&self) -> &[RegStep] {
+        self.steps.get(..self.len).unwrap_or(&[])
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.len == 0
+    }
+
+    /// Number of writes.
+    pub fn writes(&self) -> usize {
+        let mut n = 0usize;
+        for s in self.steps() {
+            if matches!(s, RegStep::Write { .. }) {
+                n = n.wrapping_add(1);
+            }
+        }
+        n
+    }
+
+    /// The plan as operations under one step named `name` (each write read back exactly).
+    pub fn ops<S: Sink>(&self, name: &'static str, sink: &mut S) -> Result<(), S::Error> {
+        sink.step(&super::compose::Step {
+            name,
+            switch: None,
+            rests_on: "spec 60 (the words from the spec side)",
+            table: None,
+        })?;
+        for s in self.steps() {
+            sink.op(match *s {
+                RegStep::Write { addr, value, check } => Op::Write {
+                    addr,
+                    value,
+                    rb: if check {
+                        Readback::Exact
+                    } else {
+                        Readback::Ignore
+                    },
+                },
+                RegStep::Delay { us } => Op::Delay { us },
+            })?;
+        }
+        Ok(())
+    }
+}
+
+/// Before a deep sleep (spec 60 §1, §2): a wake is lost whenever a display DMA master runs during the
+/// sleep, and channel 0 stays frozen after it unless the RGB channel was off too. In this order:
+/// channel 0 disabled (`VCH_CTRL` [1:0] = 0) and latched, the four `NRC` write channels' bit 31
+/// cleared, the RGB channel off (`0x83001900`) and latched; each latch waited for (`timeout_us`).
+pub fn sleep_quiesce<S: Sink>(timeout_us: u32, sink: &mut S) -> Result<(), S::Error> {
+    use super::compose::{reg, NRC_WRITE_CHANNELS, RGB_OFF};
+    sink.step(&super::compose::Step {
+        name: "sleep-quiesce",
+        switch: None,
+        rests_on: "spec 60 §1, §2",
+        table: None,
+    })?;
+    let latch = |sink: &mut S, addr: u32| -> Result<(), S::Error> {
+        sink.op(Op::Write {
+            addr,
+            value: 1,
+            rb: Readback::Latch,
+        })?;
+        sink.op(Op::Poll {
+            addr,
+            mask: 1,
+            want: 0,
+            timeout_us,
+        })
+    };
+    sink.op(Op::Masked {
+        addr: reg::VCH_CTRL,
+        mask: 0x3,
+        value: 0,
+        rb: Readback::Exact,
+    })?;
+    latch(sink, reg::VCH_LATCH)?;
+    for addr in NRC_WRITE_CHANNELS {
+        sink.op(Op::Masked {
+            addr,
+            mask: 1 << 31,
+            value: 0,
+            rb: Readback::Exact,
+        })?;
+    }
+    sink.op(Op::Write {
+        addr: reg::RGB_CTRL,
+        value: RGB_OFF,
+        rb: Readback::Exact,
+    })?;
+    latch(sink, reg::RGB_LATCH)
+}
