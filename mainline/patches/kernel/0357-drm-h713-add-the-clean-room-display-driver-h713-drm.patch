index 000000000..50afddd8b
--- /dev/null
+++ b/drivers/gpu/drm/h713/shared/h713-vp/block.rs
@@ -0,0 +1,135 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+//! The register blocks of spec/00 §1, and the first-access tracker of 91 O0.
+#![deny(
+    clippy::indexing_slicing,
+    clippy::arithmetic_side_effects,
+    clippy::unwrap_used,
+    clippy::expect_used
+)]
+
+/// A register block (neutral names of spec/00 §1).
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]
+#[repr(u8)]
+pub enum Block {
+    Ccu,
+    Nrc,
+    Dei,
+    Proc,
+    ProcLock,
+    Scl,
+    Pnl,
+    PnlLock,
+    Border,
+    GammaLut,
+    Osd,
+    Raster,
+    Scanout,
+    Dtop,
+    Lvds,
+    Tcon,
+    Mix,
+    Cap,
+    Tvtop,
+}
+
+/// (block, first address, last address); ordered so the narrower lock windows win over their
+/// parents.
+const RANGES: [(Block, u32, u32); 19] = [
+    (Block::Ccu, 0x0200_1000, 0x0200_1fff),
+    (Block::Nrc, 0x0500_0000, 0x0500_1fff),
+    (Block::Dei, 0x050c_0000, 0x050c_ffff),
+    (Block::ProcLock, 0x0514_fe00, 0x0514_ffff),
+    (Block::Proc, 0x0514_0000, 0x0514_fdff),
+    (Block::Scl, 0x0518_0000, 0x0518_03ff),
+    (Block::PnlLock, 0x051c_fe00, 0x051c_ffff),
+    (Block::Pnl, 0x051c_0000, 0x051c_fdff),
+    (Block::GammaLut, 0x0520_8000, 0x0520_9fff),
+    (Block::Border, 0x0520_0000, 0x0520_0fff),
+    (Block::Osd, 0x0524_c000, 0x0524_cfff),
+    (Block::Raster, 0x0525_c000, 0x0525_cfff),
+    (Block::Scanout, 0x0560_0000, 0x0560_0fff),
+    (Block::Dtop, 0x0570_0000, 0x0570_0fff),
+    (Block::Lvds, 0x0580_0000, 0x0580_ffff),
+    (Block::Tcon, 0x0588_0000, 0x0588_ffff),
+    (Block::Mix, 0x058c_0000, 0x058c_ffff),
+    (Block::Cap, 0x0694_0000, 0x0694_ffff),
+    (Block::Tvtop, 0x06e0_0000, 0x06e0_0fff),
+];
+
+/// Number of blocks.
+pub const COUNT: usize = RANGES.len();
+
+impl Block {
+    /// The block that holds `addr`, if it is one of spec/00 §1.
+    pub fn of(addr: u32) -> Option<Block> {
+        RANGES
+            .iter()
+            .find(|&&(_, lo, hi)| (lo..=hi).contains(&addr))
+            .map(|&(b, _, _)| b)
+    }
+
+    /// The neutral name of spec/00 §1.
+    pub const fn name(self) -> &'static str {
+        match self {
+            Block::Ccu => "CCU",
+            Block::Nrc => "NRC",
+            Block::Dei => "DEI",
+            Block::Proc => "PROC",
+            Block::ProcLock => "PROC_LOCK",
+            Block::Scl => "SCL",
+            Block::Pnl => "PNL",
+            Block::PnlLock => "PNL_LOCK",
+            Block::Border => "BORDER",
+            Block::GammaLut => "GAMMA_LUT",
+            Block::Osd => "OSD",
+            Block::Raster => "RASTER",
+            Block::Scanout => "SCANOUT",
+            Block::Dtop => "DTOP",
+            Block::Lvds => "LVDS",
+            Block::Tcon => "TCON",
+            Block::Mix => "MIX",
+            Block::Cap => "CAP",
+            Block::Tvtop => "TVTOP",
+        }
+    }
+
+    /// Block by neutral name (case-insensitive).
+    pub fn by_name(name: &str) -> Option<Block> {
+        RANGES
+            .iter()
+            .map(|r| r.0)
+            .find(|b| b.name().eq_ignore_ascii_case(name))
+    }
+
+    /// First and last address of the block's window.
+    pub fn range(self) -> (u32, u32) {
+        RANGES
+            .iter()
+            .find(|r| r.0 == self)
+            .map_or((0, 0), |r| (r.1, r.2))
+    }
+
+    pub fn all() -> impl Iterator<Item = Block> {
+        RANGES.iter().map(|r| r.0)
+    }
+}
+
+/// Tracks which blocks were accessed. 91 O0 asked for every block's first access behind one
+/// function the bench can log before calling: an executor calls [`FirstAccess::first`] before each
+/// access and logs when it returns true.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct FirstAccess(u32);
+
+impl FirstAccess {
+    pub const fn new() -> Self {
+        Self(0)
+    }
+
+    /// True exactly once per block: the access about to be made is the block's first.
+    pub fn first(&mut self, b: Block) -> bool {
+        let bit = 1u32 << b as u8;
+        let first = self.0 & bit == 0;
+        self.0 |= bit;
+        first
+    }
+}
