+/// `int h713_hw_align(hw, ops, bufs, cur, calibrate, ar, rep)`: lines the RGB raster up with the
+/// video raster (05 §2.1; `h713-vp::align`): rows by the interrupt timing, with `calibrate` also
+/// columns and rows by the histogram with the driver's test content. Both planes must be shown
+/// (`cur`), `RASTER 0x000` must hold the handoff word. Process context.
+///
+/// # Safety
+///
+/// All pointers are NULL or point to live structs; the callbacks are valid for `ops.cookie`.
+#[no_mangle]
+pub unsafe extern "C" fn h713_hw_align(
+    hw: *const H713Hw,
+    ops: *const H713AlignOps,
+    bufs: *const H713AlignBufs,
+    cur: *const H713Plane,
+    calibrate: u32,
+    ar: *mut H713AlignReport,
+    rep: *mut H713Report,
+) -> i32 {
+    // SAFETY: by this function's contract.
+    let (Some(hw), Some(ops), Some(bufs), Some(cur), Some(ar), Some(rep)) = (
+        unsafe { hw.as_ref() },
+        unsafe { ops.as_ref() },
+        unsafe { bufs.as_ref() },
+        unsafe { cur.as_ref() },
+        unsafe { ar.as_mut() },
+        unsafe { rep.as_mut() },
+    ) else {
+        return EINVAL.to_errno();
+    };
+    let cur = match plane_state(cur) {
+        Ok(c) if c.rgb.is_some() && c.video.is_some() => c,
+        Ok(_) => return EINVAL.to_errno(),
+        Err(e) => return e,
+    };
+    let io = Mmio { hw };
+    match io.read(align::RASTER_TOTAL) {
+        Ok(w) if w == align::HANDOFF_WORD => {}
+        Ok(_) => return EINVAL.to_errno(),
+        Err(e) => return e,
+    }
+    let calibrate =
+        calibrate != 0 && bufs.rgb_rows != 0 && bufs.rgb_cols != 0 && bufs.video_luma != 0;
+    let mut env = AlignExec {
+        ex: Exec {
+            io,
+            rep,
+            in_raster: false,
+            may_sleep: true,
+        },
+        ops,
+        bufs,
+        cur,
+        base: base_config(hw),
+    };
+    // B10: the aligned delay depends on the video geometry.
+    let target_ns = match cur.video {
+        Some(f) => match (Config {
+            frame: f,
+            ..base_config(hw)
+        })
+        .validate()
+        {
+            Ok(state) => align::aligned_delay_ns(state),
+            Err(_) => return EINVAL.to_errno(),
+        },
+        None => return EINVAL.to_errno(),
+    };
+    let p = AlignParams {
+        calibrate,
+        target_ns,
+        ..AlignParams::DEFAULT
+    };
+    let r = align::align(&mut env, &p);
+    let out = match &r {
+        Ok(a) => *a,
+        Err(_) => align::AlignReport::default(),
+    };
+    *ar = H713AlignReport {
+        delay_before_ns: out.delay_before,
+        delay_after_ns: out.delay_after,
+        timing_lines: out.timing_lines,
+        timing_frames: out.timing_frames,
+        timing_aligned: u32::from(out.timing_aligned),
+        calibrated: u32::from(out.calibrated),
+        col_before: out.col_before,
+        col_after: out.col_after,
+        col_steps: out.col_steps,
+        row_before: out.row_before,
+        row_after: out.row_after,
+        hist_lines: out.hist_lines,
+        col_lattice: out.col_lattice,
+        windows: out.windows,
+        jumps: out.jumps,
+        target_ns: u32::try_from(target_ns).unwrap_or(0),
+    };
+    match r {
+        Ok(_) => 0,
+        Err(e) => e,
+    }
+}
+
+/// The video line counter `PNL 0x051c0174` [15:0] (30 §4.5: 0..1124).
+const LINE_COUNTER: u32 = 0x051c_0174;
+/// Reads per line the spins allow (a read takes well under a microsecond; a line is 13.563 us).
+const SPINS_PER_LINE: u32 = 400;
+/// B9 wrote the words 8 us after the counter stepped.
+const WINDOW_DELAY_US: u32 = 8;
+
+fn line(io: &Mmio<'_>) -> Result<u32, i32> {
+    Ok(io.read(LINE_COUNTER)? & 0xffff)
+}
+
+/// Whether a window of `lines` lines starting at `l` stays inside one frame, away from its start.
+fn window_room(l: u32, lines: u32) -> bool {
+    l >= 4 && l.saturating_add(lines).saturating_add(16) < align::V_TOTAL
+}
+
+/// `int h713_hw_line_wait(hw, lines)`: busy-waits (at most about two frames of reads) until the
+/// line counter leaves room for a window of `lines` lines. IRQs on.
+///
+/// # Safety
+///
+/// `hw` is NULL or points to a live `struct h713_hw`.
+#[no_mangle]
+pub unsafe extern "C" fn h713_hw_line_wait(hw: *const H713Hw, lines: u32) -> i32 {
+    // SAFETY: by this function's contract.
+    let Some(hw) = (unsafe { hw.as_ref() }) else {
+        return EINVAL.to_errno();
+    };
+    let io = Mmio { hw };
+    let mut spins = SPINS_PER_LINE.saturating_mul(2 * align::V_TOTAL);
+    while spins > 0 {
+        match line(&io) {
+            Ok(l) if window_room(l, lines) => return 0,
+            Ok(_) => {}
+            Err(e) => return e,
+        }
+        spins = spins.saturating_sub(1);
+    }
+    kernel::error::code::ETIMEDOUT.to_errno()
+}
+
+/// `int h713_hw_raster_window(hw, plus, lines, got)`: 05 §2.1 B9 - `RASTER 0x000` [15:0] = 2200
+/// (`plus`) or 2198 written 8 us after the video line counter stepped, restored 8 us after it
+/// stepped `lines` lines later; `*got` = the lines between the two writes as the counter read them.
+/// IRQs off (the caller). `-EAGAIN` when the counter left the room for the window before the first
+/// write. The handoff word is always written back.
+///
+/// # Safety
+///
+/// `hw` and `got` are NULL or point to live objects.
+#[no_mangle]
+pub unsafe extern "C" fn h713_hw_raster_window(
+    hw: *const H713Hw,
+    plus: bool,
+    lines: u32,
+    got: *mut u32,
+) -> i32 {
+    // SAFETY: by this function's contract.
+    let (Some(hw), Some(got)) = (unsafe { hw.as_ref() }, unsafe { got.as_mut() }) else {
+        return EINVAL.to_errno();
+    };
+    if lines == 0 || lines > align::WINDOW_MAX_LINES {
+        return EINVAL.to_errno();
+    }
+    let io = Mmio { hw };
+    let r = window(&io, plus, lines);
+    // Whatever happened, the RGB raster gets its own totals back.
+    let restore = io.write(align::RASTER_TOTAL, align::HANDOFF_WORD);
+    match (r, restore) {
+        (Ok(n), Ok(())) => {
+            *got = n;
+            0
+        }
+        (Err(e), _) | (_, Err(e)) => e,
+    }
+}
+
+fn window(io: &Mmio<'_>, plus: bool, lines: u32) -> Result<u32, i32> {
+    let timeout = kernel::error::code::ETIMEDOUT.to_errno();
+    // The next step of the counter.
+    let l0 = line(io)?;
+    let mut spins = SPINS_PER_LINE.saturating_mul(2);
+    let start = loop {
+        let l = line(io)?;
+        if l != l0 {
+            break l;
+        }
+        spins = spins.checked_sub(1).ok_or(timeout)?;
+    };
+    if !window_room(start, lines) {
+        return Err(kernel::error::code::EAGAIN.to_errno());
+    }
+    // SAFETY: plain C function (udelay), callable with IRQs off.
+    unsafe { h713_drm_udelay(WINDOW_DELAY_US) };
+    io.write(align::RASTER_TOTAL, align::htotal_step(plus))?;
+    let first = line(io)?;
+    let target = start.saturating_add(lines);
+    let mut spins = SPINS_PER_LINE.saturating_mul(lines.saturating_add(2));
+    loop {
+        let l = line(io)?;
+        if l >= target || l < start {
+            break;
+        }
+        spins = spins.checked_sub(1).ok_or(timeout)?;
+    }
+    // SAFETY: as above.
+    unsafe { h713_drm_udelay(WINDOW_DELAY_US) };
+    io.write(align::RASTER_TOTAL, align::HANDOFF_WORD)?;
+    let last = line(io)?;
+    Ok(if last >= first {
+        last.saturating_sub(first)
+    } else {
+        lines
+    })
+}
+
+/// `struct h713_write`.
+#[repr(C)]
+#[derive(Clone, Copy)]
+pub struct H713Write {
+    addr: u32,
+    mask: u32,
+    value: u32,
+}
+
+fn pq_file(hw: &H713Hw) -> &[u8] {
+    if hw.pq.is_null() || hw.pq_len == 0 {
+        return &[];
+    }
+    // SAFETY: the C side keeps the firmware image (`pq`, `pq_len`) alive while `hw` is in use.
+    unsafe { core::slice::from_raw_parts(hw.pq, hw.pq_len) }
+}
+
+/// `u32 h713_hw_pq_available(hw)`: bit i set when control i (`enum h713_pq`,
+/// `h713-vp::pq::CONTROLS`) can be computed at its default from the owner's files.
+///
+/// # Safety
+///
+/// `hw` is NULL or points to a live `struct h713_hw`.
+#[no_mangle]
+pub unsafe extern "C" fn h713_hw_pq_available(hw: *const H713Hw) -> u32 {
+    // SAFETY: by this function's contract.
+    let Some(hw) = (unsafe { hw.as_ref() }) else {
+        return 0;
+    };
+    let uc = pq::user_controls(pq_file(hw));
+    let mut mask = 0u32;
+    let mut bit = 1u32;
+    for c in pq::CONTROLS {
+        if pq::writes(c, c.default(), uc.as_ref(), tse(hw)).is_ok() {
+            mask |= bit;
+        }
+        bit = bit.wrapping_shl(1);
+    }
+    mask
+}
+
+/// `int h713_hw_pq_writes(hw, c, value, out, max, n)`: the masked writes of control `c` at `value`
+/// (h713-vp `pq::writes`: the owner's curves, 40 §5, truncation 40 §7; the dither class from
+/// `database.TSE`, 30 §4.4).
+///
+/// # Safety
+///
+/// `hw`, `n` and `out` (with room for `max` entries) are NULL or live.
+#[no_mangle]
+pub unsafe extern "C" fn h713_hw_pq_writes(
+    hw: *const H713Hw,
+    c: u32,
+    value: u32,
+    out: *mut H713Write,
+    max: u32,
+    n: *mut u32,
+) -> i32 {
+    // SAFETY: by this function's contract.
+    let (Some(hw), Some(n)) = (unsafe { hw.as_ref() }, unsafe { n.as_mut() }) else {
+        return EINVAL.to_errno();
+    };
+    if out.is_null() {
+        return EINVAL.to_errno();
+    }
+    // SAFETY: `out` has room for `max` entries by this function's contract.
+    let out = unsafe { core::slice::from_raw_parts_mut(out, max as usize) };
+    let Some(&control) = pq::CONTROLS.get(c as usize) else {
+        return EINVAL.to_errno();
+    };
+    let uc = pq::user_controls(pq_file(hw));
+    match pq::writes(control, value, uc.as_ref(), tse(hw)) {
+        Ok((w, count)) => {
+            let mut k = 0u32;
+            for (dst, src) in out.iter_mut().zip(w.iter().take(count)) {
+                *dst = H713Write {
+                    addr: src.addr,
+                    mask: src.mask,
+                    value: src.value,
+                };
+                k = k.saturating_add(1);
+            }
+            if (k as usize) < count {
+                return EINVAL.to_errno();
+            }
+            *n = k;
+            0
+        }
+        Err(pq::PqError::Missing) => ENODEV.to_errno(),
+        Err(_) => EINVAL.to_errno(),
+    }
+}
+
+/// `int h713_hw_pq_apply(hw, w, n, mismatches)`: the masked writes (read-modify-write, 32-bit),
+/// each read back and compared under its mask. Called from the RGB done interrupt (vblank): no
+/// sleep.
+///
+/// # Safety
+///
+/// `hw`, `mismatches` and `w` (with `n` entries) are NULL or live.
+#[no_mangle]
+pub unsafe extern "C" fn h713_hw_pq_apply(
+    hw: *const H713Hw,
+    w: *const H713Write,
+    n: u32,
+    mismatches: *mut u32,
+) -> i32 {
+    // SAFETY: by this function's contract.
+    let (Some(hw), Some(mismatches)) = (unsafe { hw.as_ref() }, unsafe { mismatches.as_mut() })
+    else {
+        return EINVAL.to_errno();
+    };
+    if w.is_null() {
+        return EINVAL.to_errno();
+    }
+    // SAFETY: `w` has `n` entries by this function's contract.
+    let writes = unsafe { core::slice::from_raw_parts(w, n as usize) };
+    let io = Mmio { hw };
+    let mut bad = 0u32;
+    for x in writes {
+        // Only the words the picture controls own (h713-vp pq::Control::targets) and the gamma
+        // switch / off.
+        let gamma_word =
+            x.addr == compose::GAMMA_CTRL && (x.mask == gamma::show(0).0 || x.mask == gamma::OFF.0);
+        if !gamma_word
+            && !pq::CONTROLS
+                .iter()
+                .any(|c| c.targets().contains(&(x.addr, x.mask)))
+        {
+            return EINVAL.to_errno();
+        }
+        let r = io.read(x.addr).and_then(|old| {
+            let new = (old & !x.mask) | (x.value & x.mask);
+            io.write(x.addr, new)?;
+            Ok(io.read(x.addr)? & x.mask == new & x.mask)
+        });
+        match r {
+            Ok(true) => {}
+            Ok(false) => bad = bad.saturating_add(1),
+            Err(e) => return e,
+        }
+    }
+    *mismatches = bad;
+    0
+}
+
+/// The controls' names as C strings, in `pq::CONTROLS` order (`h713_hw_pq_info` compares each with
+/// `Control::name` and refuses a mismatch, so the probe fails rather than mislabel a property).
+const PQ_NAMES: [&[u8]; 12] = [
+    b"saturation\0",
+    b"hue\0",
+    b"wb_red_gain\0",
+    b"wb_green_gain\0",
+    b"wb_blue_gain\0",
+    b"wb_red_offset\0",
+    b"wb_green_offset\0",
+    b"wb_blue_offset\0",
+    b"contrast\0",
+    b"dither_class\0",
+    b"brightness\0",
+    b"sharpness\0",
+];
+
+/// `int h713_hw_pq_info(c, name, min, max, def)`: the DRM property of control `c`.
+///
+/// # Safety
+///
+/// The out pointers are NULL or live.
+#[no_mangle]
+pub unsafe extern "C" fn h713_hw_pq_info(
+    c: u32,
+    name: *mut *const u8,
+    min: *mut u32,
+    max: *mut u32,
+    def: *mut u32,
+) -> i32 {
+    // SAFETY: by this function's contract.
+    let (Some(name), Some(min), Some(max), Some(def)) = (
+        unsafe { name.as_mut() },
+        unsafe { min.as_mut() },
+        unsafe { max.as_mut() },
+        unsafe { def.as_mut() },
+    ) else {
+        return EINVAL.to_errno();
+    };
+    let (Some(&control), Some(&cname)) = (pq::CONTROLS.get(c as usize), PQ_NAMES.get(c as usize))
+    else {
+        return EINVAL.to_errno();
+    };
+    if cname.split_last().map(|(_, n)| n) != Some(control.name().as_bytes()) {
+        return EINVAL.to_errno();
+    }
+    let (lo, hi) = control.range();
+    *name = cname.as_ptr();
+    *min = lo;
+    *max = hi;
+    *def = control.default();
+    0
+}
