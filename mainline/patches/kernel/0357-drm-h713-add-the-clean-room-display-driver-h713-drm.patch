+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+//! Stage 3: the HDMI input as a source of the video plane, with the display firmware never started
+//! (spec 50, 55, 96; 91 O30-O35).
+//!
+//! - [`RX_SEQUENCE`]: the receiver writes of 50 §8 in their order (CCU, `TVTOP`, the `RX_LINK`
+//!   opener, the two lock bytes, port select, the no-signal configuration, PHY / equaliser, the
+//!   `+0x002` pulse, the six enables), each read back; the expected read-back where the spec says it
+//!   differs.
+//! - [`Timing`] / [`lock`]: the lock signs of 50 §4 (the source timing bytes `RX_LINK +0x28..+0x3f`,
+//!   TMDS present, the enables) and the capture's own (55 §3: frame counter, totals, size). Only
+//!   CTA-861 1080p60 is accepted (the only mode measured without the firmware); every other timing is
+//!   [`Lock::Unsupported`].
+//! - [`Ring`] / [`capture_writes`]: the capture programming of 55 §8 in its order, with the address
+//!   tables pointed at the driver's own three-slot NV16 ring; [`CAPTURE_STOP`] (55 §4).
+//! - [`Rotation`]: which ring slot channel 0 shows at each panel vsync: the last complete one, the
+//!   write index minus one (55 §5), with counts of frames shown, repeated (the 65.5 Hz panel is faster
+//!   than a 60 Hz source) and skipped.
+//!
+//! EDID and hot-plug are served by an external provider (50 §3, §8 Q-RX-3: the ARISC); this module
+//! never touches `AUX` (reading it before the provider's EDID-module reset hangs the SoC).
+#![deny(
+    clippy::indexing_slicing,
+    clippy::arithmetic_side_effects,
+    clippy::unwrap_used,
+    clippy::expect_used
+)]
+
+/// The receiver control window (byte registers, 50 §1); mapped `0x4000` bytes.
+pub const RX_CTL: u32 = 0x0680_0000;
+/// Size of the `RX_CTL` mapping (50 §6a: `0x4000` bytes wide, aliased every `0x10000`).
+pub const RX_CTL_SIZE: u32 = 0x4000;
+/// The receiver link window (byte registers, 50 §1) including `0x06841000..`.
+pub const RX_LINK: u32 = 0x0684_0000;
+/// Size of the `RX_LINK` mapping.
+pub const RX_LINK_SIZE: u32 = 0x2000;
+/// The TV top clock/reset words (50 §2).
+pub const TVTOP: u32 = 0x06e0_0000;
+/// The capture block (55 §1).
+pub const CAP: u32 = 0x0694_0000;
+
+/// Pause between the groups of [`RX_SEQUENCE`] (50 §8: 0.25-1 s were used).
+pub const GROUP_PAUSE_US: u32 = 250_000;
+/// The bench read the lock 4 s after the last receiver write (50 §6a, §8); without pauses it came
+/// 0.1-0.7 s after the writes (58 §2).
+pub const LOCK_WAIT_US: u32 = 4_000_000;
+/// After clearing the two output enables, nothing is written 40 ms later (55 §4).
+pub const CAPTURE_STOP_WAIT_US: u32 = 40_000;
+/// The output enables are set 500 ms after the last configuration word (55 §8 #76); 58 §2: the
+/// pause changes nothing.
+pub const CAPTURE_ENABLE_PAUSE_US: u32 = 500_000;
+
+/// How one receiver write is made.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum RxKind {
+    /// A byte store.
+    W8,
+    /// A byte read-modify-write `|= value` (the enables, 50 §8 #85-#90).
+    Or8,
+    /// A 32-bit store.
+    W32,
+    /// A 32-bit read-modify-write `|= value` (PLL_VIDEO1 bit 31, 50 §8 #1).
+    Set32,
+}
+
+/// What the read-back after a receiver write should show.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum RxReadback {
+    /// The value written (for `Or8` / `Set32`: the old value or'ed with it).
+    Equal,
+    /// The value written, or this one (50 §8: status bits while TMDS is present).
+    Reads(u32),
+    /// These bits set.
+    Bits(u32),
+    /// A status byte of a live receiver: read and logged, not compared (58 §6: `+0x1ab`, `+0x1ac`,
+    /// `+0x1af` follow the receiver's state, `+0x040` the audio state, 50 §5; `+0x3c5` changes
+    /// between 1 and 2 in the firmware's relock, 50 §4, and read back 1 after a reload, round 11).
+    Status,
+}
+
+/// One write of [`RX_SEQUENCE`].
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct RxWrite {
+    pub addr: u32,
+    pub value: u32,
+    pub kind: RxKind,
+    pub readback: RxReadback,
+    /// Wait before this write as the bench of 50 §8 made it (group pauses, 10 ms before the
+    /// second `+0x002` write, 1 s before each of the first five enables). 58 §2: not needed (the
+    /// receiver locks 0.1-0.7 s after the writes made without pauses); a driver makes them only on
+    /// request.
+    pub pause_before_us: u32,
+}
+
+impl RxWrite {
+    /// Whether the read-back `read` (after the write over `old`) is what the spec saw.
+    pub const fn readback_ok(&self, old: u32, read: u32) -> bool {
+        let (written, mask) = match self.kind {
+            RxKind::W8 => (self.value & 0xff, 0xff),
+            RxKind::Or8 => ((old | self.value) & 0xff, 0xff),
+            RxKind::W32 => (self.value, 0xffff_ffff),
+            RxKind::Set32 => (old | self.value, 0xffff_ffff),
+        };
+        match self.readback {
+            RxReadback::Equal => read & mask == written,
+            RxReadback::Reads(alt) => read & mask == written || read & mask == alt,
+            RxReadback::Bits(b) => read & b == b,
+            RxReadback::Status => true,
+        }
+    }
+
+    /// Whether the write goes to the CCU (`0x02001000` page): only made where the driver may
+    /// touch the CCU (the bench mode; with a DT node the clock driver owns those words).
+    pub const fn is_ccu(&self) -> bool {
+        self.addr >= 0x0200_1000 && self.addr < 0x0200_2000
+    }
+}
