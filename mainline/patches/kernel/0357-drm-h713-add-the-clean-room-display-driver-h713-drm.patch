diff --git a/drivers/gpu/drm/h713/shared/h713-tse/gamma.rs b/drivers/gpu/drm/h713/shared/h713-tse/gamma.rs
new file mode 100644
index 000000000..06c9d72ef
--- /dev/null
+++ b/drivers/gpu/drm/h713/shared/h713-tse/gamma.rs
@@ -0,0 +1,93 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+//! Gamma curves of `ProjectID_0x00NN.TSE`, table kind `0x90009` (spec/40 §6).
+//!
+//! u32 state count; per state u32 length and the state: 4608 bytes = 512 records of 9 bytes. Record
+//! i: bytes 0..2 low 8 bits of sample 2i for R, G, B; bytes 3..5 low 8 bits of sample 2i+1 for R,
+//! G, B; bytes 6..8 per channel: low nibble = bits 11:8 of sample 2i, high nibble = bits 11:8 of
+//! sample 2i+1. 1024 12-bit samples per channel. Which attribute value keys which state is open (30
+//! §4.3); neutral is the LUT off (91 O14). The driver's LUT is the DRM `GAMMA_LUT` (`h713-vp`
+//! `gamma`), not a file curve.
+
+use super::reader::Reader;
+use super::{Error, ErrorKind, Result};
+
+pub const SAMPLES: usize = 1024;
+pub const RECORDS: usize = 512;
+pub const STATE_LEN: usize = RECORDS * 9;
+
+/// Three channels R, G, B of 1024 12-bit samples.
+pub type Channels = [[u16; SAMPLES]; 3];
+
+/// A validated gamma blob.
+#[derive(Clone, Copy, Debug)]
+pub struct GammaBlob<'a> {
+    pub state_count: u32,
+    states: &'a [u8],
+}
+
+impl<'a> GammaBlob<'a> {
+    /// Parses and validates: every state must be 4608 bytes and the walk must end at the blob
+    /// length.
+    pub fn parse(blob: &'a [u8]) -> Result<Self> {
+        let mut r = Reader::new(blob, 0);
+        let state_count = r.count(4 + STATE_LEN)?;
+        let start = r.pos();
+        for _ in 0..state_count {
+            let at = r.abs();
+            if r.u32()? as usize != STATE_LEN {
+                return Err(Error::new(ErrorKind::BadLength, at));
+            }
+            r.bytes(STATE_LEN)?;
+        }
+        let states = r.since(start);
+        r.finish()?;
+        Ok(Self {
+            state_count,
+            states,
+        })
+    }
+
+    /// Raw bytes of state `index` (0-based, file order).
+    pub fn state(&self, index: u32) -> Option<&'a [u8]> {
+        if index >= self.state_count {
+            return None;
+        }
+        let o = (index as usize)
+            .checked_mul(4 + STATE_LEN)?
+            .checked_add(4)?;
+        self.states.get(o..o.checked_add(STATE_LEN)?)
+    }
+
+    /// 12-bit sample `i` (0..1024) of channel `ch` (0 R, 1 G, 2 B) of state `index`.
+    pub fn sample(&self, index: u32, ch: usize, i: usize) -> Option<u16> {
+        if ch >= 3 || i >= SAMPLES {
+            return None;
+        }
+        let rec = self.state(index)?.get((i / 2) * 9..(i / 2) * 9 + 9)?;
+        let hi = u16::from(*rec.get(6 + ch)?);
+        Some(if i % 2 == 0 {
+            u16::from(*rec.get(ch)?) | ((hi & 0xf) << 8)
+        } else {
+            u16::from(*rec.get(3 + ch)?) | ((hi >> 4) << 8)
+        })
+    }
+
+    /// Decodes state `index` into `out` (R, G, B). Returns false if the state does not exist.
+    pub fn decode(&self, index: u32, out: &mut Channels) -> bool {
+        if self.state(index).is_none() {
+            return false;
+        }
+        for (ch, o) in out.iter_mut().enumerate() {
+            for (i, d) in o.iter_mut().enumerate() {
+                *d = self.sample(index, ch, i).unwrap_or(0);
+            }
+        }
+        true
+    }
+}
+
+/// Gamma port word for samples `even`, `odd` of one channel: even sample in [11:0], odd in [23:12]
+/// (spec/30 §4.3; 512 words per channel).
+pub const fn port_word(even: u16, odd: u16) -> u32 {
+    (even as u32 & 0xfff) | ((odd as u32 & 0xfff) << 12)
+}
