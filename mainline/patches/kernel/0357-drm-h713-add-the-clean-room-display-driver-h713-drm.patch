+//! spec/12-dram-frame-state-hy320.md: the firmware's register state with a DRAM frame on the video
+//! plane and no input signal (HY320, measured 2026-11-03), the words beyond the owner's init
+//! tables. Transcribed from the spec's tables, block by block, in the spec's address order; the
+//! word counts are the spec's (checked by a test).
+//!
+//! §M adds the two measured subsets ([`MINIMAL_40`], [`MINIMAL_85`]) and the 41 words that do not
+//! read back ([`STATUS`]), which no plan writes.
+//!
+//! `buffer: true` marks the spec's `*` words: DRAM buffer addresses >> 4 inside the firmware's
+//! reserved area; the composer relocates them to the driver's own area
+//! ([`super::config::NrBuffers`]).
+#![deny(
+    clippy::indexing_slicing,
+    clippy::arithmetic_side_effects,
+    clippy::unwrap_used,
+    clippy::expect_used
+)]
+
+/// One word of the table.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Word {
+    pub addr: u32,
+    pub value: u32,
+    /// A DRAM buffer address >> 4 (`*` in spec/12).
+    pub buffer: bool,
+}
+
+const fn w(addr: u32, value: u32) -> Word {
+    Word {
+        addr,
+        value,
+        buffer: false,
+    }
+}
+
+const fn b(addr: u32, value: u32) -> Word {
+    Word {
+        addr,
+        value,
+        buffer: true,
+    }
+}
