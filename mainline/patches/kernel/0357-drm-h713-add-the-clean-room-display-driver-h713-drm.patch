+// --- resume: the panel bring-up step (spec 40 §3, plan from 05 §7) -----------------------------
+
+fn logo_file(hw: &H713Hw) -> &[u8] {
+    if hw.logo.is_null() || hw.logo_len == 0 {
+        return &[];
+    }
+    // SAFETY: the C side keeps the firmware image (`logo`, `logo_len`) alive while `hw` is in use.
+    unsafe { core::slice::from_raw_parts(hw.logo, hw.logo_len) }
+}
+
+/// The plan text from C (`plan`, `len` bytes), parsed.
+///
+/// # Safety
+///
+/// `plan` is NULL (empty plan) or has `len` bytes.
+unsafe fn plan_of(plan: *const u8, len: u32) -> Result<Plan, i32> {
+    if plan.is_null() || len == 0 {
+        return Ok(Plan::EMPTY);
+    }
+    // SAFETY: by this function's contract.
+    let text = unsafe { core::slice::from_raw_parts(plan, len as usize) };
+    Plan::parse(text).map_err(|_| EINVAL.to_errno())
+}
+
+fn plan_err(e: resume::PlanError) -> i32 {
+    match e {
+        resume::PlanError::NoProgram | resume::PlanError::File => ENODEV.to_errno(),
+        _ => EINVAL.to_errno(),
+    }
+}
+
+/// `struct h713_panel_counts`.
+#[repr(C)]
+pub struct H713PanelCounts {
+    writes: u32,
+    pulses: u32,
+    delays: u32,
+    delay_ms: u32,
+}
+
+/// `int h713_hw_panel_check(hw, plan, len, project, c)`.
+///
+/// # Safety
+///
+/// `hw` and `c` are NULL or live; `plan` is NULL or has `len` bytes.
+#[no_mangle]
+pub unsafe extern "C" fn h713_hw_panel_check(
+    hw: *const H713Hw,
+    plan: *const u8,
+    len: u32,
+    project: u32,
+    c: *mut H713PanelCounts,
+) -> i32 {
+    // SAFETY: by this function's contract.
+    let (Some(hw), Some(c)) = (unsafe { hw.as_ref() }, unsafe { c.as_mut() }) else {
+        return EINVAL.to_errno();
+    };
+    // SAFETY: by this function's contract.
+    let plan = match unsafe { plan_of(plan, len) } {
+        Ok(p) => p,
+        Err(e) => return e,
+    };
+    match resume::check(logo_file(hw), project, &plan) {
+        Ok(k) => {
+            *c = H713PanelCounts {
+                writes: k.writes,
+                pulses: k.pulses,
+                delays: k.delays,
+                delay_ms: u32::try_from(k.delay_us / 1000).unwrap_or(u32::MAX),
+            };
+            0
+        }
+        Err(e) => plan_err(e),
+    }
+}
+
+/// `int h713_hw_panel_pages(hw, plan, len, project, out, max, n)`.
+///
+/// # Safety
+///
+/// `hw` and `n` are NULL or live; `out` has `max` entries; `plan` is NULL or has `len` bytes.
+#[no_mangle]
+pub unsafe extern "C" fn h713_hw_panel_pages(
+    hw: *const H713Hw,
+    plan: *const u8,
+    len: u32,
+    project: u32,
+    out: *mut u32,
+    max: u32,
+    n: *mut u32,
+) -> i32 {
+    // SAFETY: by this function's contract.
+    let (Some(hw), Some(n)) = (unsafe { hw.as_ref() }, unsafe { n.as_mut() }) else {
+        return EINVAL.to_errno();
+    };
+    if out.is_null() {
+        return EINVAL.to_errno();
+    }
+    // SAFETY: by this function's contract.
+    let plan = match unsafe { plan_of(plan, len) } {
+        Ok(p) => p,
+        Err(e) => return e,
+    };
+    // SAFETY: `out` has `max` entries by this function's contract.
+    let out = unsafe { core::slice::from_raw_parts_mut(out, max as usize) };
+    match resume::pages(logo_file(hw), project, &plan, out) {
+        Ok(k) => {
+            *n = k as u32;
+            0
+        }
+        Err(e) => plan_err(e),
+    }
+}
+
+/// Register access through the device's blocks and the caller's extra mappings.
+struct PanelIo<'a> {
+    hw: &'a H713Hw,
+    extra: &'a [H713Block],
+}
+
+impl PanelIo<'_> {
+    fn ptr(&self, addr: u32) -> Option<*mut c_void> {
+        if addr % 4 != 0 {
+            return None;
+        }
+        self.extra.iter().chain(self.hw.blk.iter()).find_map(|b| {
+            if b.base.is_null() {
+                return None;
+            }
+            let off = addr.checked_sub(b.phys)?;
+            if off.checked_add(4)? > b.size {
+                return None;
+            }
+            Some(b.base.cast::<u8>().wrapping_add(off as usize).cast::<c_void>())
+        })
+    }
+
+    fn read(&self, addr: u32) -> Result<u32, i32> {
+        let p = self.ptr(addr).ok_or(EFAULT.to_errno())?;
+        // SAFETY: inside a live MMIO mapping of the C side, 4-aligned, 4 bytes left.
+        Ok(unsafe { bindings::readl(p.cast_const()) })
+    }
+
+    fn write(&self, addr: u32, v: u32) -> Result<(), i32> {
+        let p = self.ptr(addr).ok_or(EFAULT.to_errno())?;
+        // SAFETY: as in `read`.
+        unsafe { bindings::writel(v, p) };
+        Ok(())
+    }
+}
+
+struct PanelExec<'a> {
+    io: PanelIo<'a>,
+    rep: &'a mut H713Report,
+}
+
+impl Sink for PanelExec<'_> {
+    type Error = i32;
+
+    fn step(&mut self, _: &Step) -> Result<(), i32> {
+        Ok(())
+    }
+
+    fn op(&mut self, op: Op) -> Result<(), i32> {
+        self.rep.ops = self.rep.ops.saturating_add(1);
+        match op {
+            Op::Masked { addr, .. } | Op::Write { addr, .. } => {
+                self.rep.error_addr = addr;
+                let old = if matches!(op, Op::Masked { .. }) { self.io.read(addr)? } else { 0 };
+                let new = op.result(old).ok_or(EINVAL.to_errno())?;
+                self.io.write(addr, new)?;
+                self.rep.writes = self.rep.writes.saturating_add(1);
+                let read = self.io.read(addr)?;
+                if !op.readback_ok(new, read) {
+                    self.rep.mismatches = self.rep.mismatches.saturating_add(1);
+                    let i = self.rep.nbad as usize;
+                    if let (Some(a), Some(e), Some(r)) = (
+                        self.rep.bad_addr.get_mut(i),
+                        self.rep.bad_expect.get_mut(i),
+                        self.rep.bad_read.get_mut(i),
+                    ) {
+                        *a = addr;
+                        *e = new;
+                        *r = read;
+                    }
+                    self.rep.nbad = self.rep.nbad.saturating_add(1);
+                }
+                self.rep.error_addr = 0;
+            }
+            Op::Delay { us } => sleep_us(us),
+            _ => return Err(EINVAL.to_errno()),
+        }
+        Ok(())
+    }
+}
+
+/// `int h713_hw_panel_replay(hw, plan, len, project, maps, nmaps, rep)`.
+///
+/// # Safety
+///
+/// `hw` and `rep` are NULL or live; `maps` has `nmaps` live blocks (or is NULL with 0); `plan` is
+/// NULL or has `len` bytes. Process context.
+#[no_mangle]
+pub unsafe extern "C" fn h713_hw_panel_replay(
+    hw: *const H713Hw,
+    plan: *const u8,
+    len: u32,
+    project: u32,
+    maps: *const H713Block,
+    nmaps: u32,
+    rep: *mut H713Report,
+) -> i32 {
+    // SAFETY: by this function's contract.
+    let (Some(hw), Some(rep)) = (unsafe { hw.as_ref() }, unsafe { rep.as_mut() }) else {
+        return EINVAL.to_errno();
+    };
+    let extra: &[H713Block] = if maps.is_null() || nmaps == 0 {
+        &[]
+    } else {
+        // SAFETY: `maps` has `nmaps` entries by this function's contract.
+        unsafe { core::slice::from_raw_parts(maps, nmaps as usize) }
+    };
+    // SAFETY: by this function's contract.
+    let plan = match unsafe { plan_of(plan, len) } {
+        Ok(p) => p,
+        Err(e) => return e,
+    };
+    *rep = empty_report();
+    let mut ex = PanelExec {
+        io: PanelIo { hw, extra },
+        rep,
+    };
+    match resume::replay(logo_file(hw), project, &plan, &mut ex) {
+        Ok(_) => 0,
+        Err(resume::ReplayError::Plan(e)) => plan_err(e),
+        Err(resume::ReplayError::Sink(e)) => e,
+    }
+}
+
+/// The register re-init text from C, parsed.
+///
+/// # Safety
+///
+/// `plan` is NULL (empty) or has `len` bytes.
+unsafe fn reg_plan_of(plan: *const u8, len: u32) -> Result<RegPlan, i32> {
+    if plan.is_null() || len == 0 {
+        return Ok(RegPlan::EMPTY);
+    }
+    // SAFETY: by this function's contract.
+    let text = unsafe { core::slice::from_raw_parts(plan, len as usize) };
+    RegPlan::parse(text).map_err(|_| EINVAL.to_errno())
+}
+
+/// `int h713_hw_regs_check(hw, plan, len, writes)`: parse a register re-init (`ADDR=VALUE`,
+/// `delay=US`, ...) and check that every address lies in a mapped block; `*writes` = its writes.
+///
+/// # Safety
+///
+/// `hw` and `writes` are NULL or live; `plan` is NULL or has `len` bytes.
+#[no_mangle]
+pub unsafe extern "C" fn h713_hw_regs_check(
+    hw: *const H713Hw,
+    plan: *const u8,
+    len: u32,
+    writes: *mut u32,
+) -> i32 {
+    // SAFETY: by this function's contract.
+    let (Some(hw), Some(writes)) = (unsafe { hw.as_ref() }, unsafe { writes.as_mut() }) else {
+        return EINVAL.to_errno();
+    };
+    // SAFETY: by this function's contract.
+    let plan = match unsafe { reg_plan_of(plan, len) } {
+        Ok(p) => p,
+        Err(e) => return e,
+    };
+    let io = Mmio { hw };
+    for st in plan.steps() {
+        if let resume::RegStep::Write { addr, .. } = *st {
+            if io.ptr(addr).is_none() {
+                return EFAULT.to_errno();
+            }
+        }
+    }
+    *writes = plan.writes() as u32;
+    0
+}
+
+/// `int h713_hw_regs_run(hw, plan, len, rep)`: the register re-init, each write read back (process
+/// context: delays sleep).
+///
+/// # Safety
+///
+/// `hw` and `rep` are NULL or live; `plan` is NULL or has `len` bytes.
+#[no_mangle]
+pub unsafe extern "C" fn h713_hw_regs_run(
+    hw: *const H713Hw,
+    plan: *const u8,
+    len: u32,
+    rep: *mut H713Report,
+) -> i32 {
+    // SAFETY: by this function's contract.
+    let (Some(hw), Some(rep)) = (unsafe { hw.as_ref() }, unsafe { rep.as_mut() }) else {
+        return EINVAL.to_errno();
+    };
+    // SAFETY: by this function's contract.
+    let plan = match unsafe { reg_plan_of(plan, len) } {
+        Ok(p) => p,
+        Err(e) => return e,
+    };
+    *rep = empty_report();
+    let mut ex = Exec {
+        io: Mmio { hw },
+        rep,
+        in_raster: false,
+        may_sleep: true,
+    };
+    match plan.ops("tvtop-reinit", &mut ex) {
+        Ok(()) => 0,
+        Err(e) => e,
+    }
+}
+
+/// `const char *h713_hw_tvtop_default(part, len)`: spec 60 §3's re-init text (part 0: the TV clock
+/// rewrites; 1: the TV-top sequence), not NUL-terminated; NULL for another part.
+///
+/// # Safety
+///
+/// `len` is NULL or live.
+#[no_mangle]
+pub unsafe extern "C" fn h713_hw_tvtop_default(part: u32, len: *mut u32) -> *const u8 {
+    let text = match part {
+        0 => resume::TVTOP_REINIT_CLOCKS,
+        1 => resume::TVTOP_REINIT,
+        _ => return core::ptr::null(),
+    };
+    // SAFETY: by this function's contract.
+    if let Some(len) = unsafe { len.as_mut() } {
+        *len = text.len() as u32;
+    }
+    text.as_ptr()
+}
+
+/// `int h713_hw_sleep_quiesce(hw, rep)` (h713-vp `resume::sleep_quiesce`, spec 60 §1/§2).
+///
+/// # Safety
+///
+/// `hw` and `rep` are NULL or live. Process context.
+#[no_mangle]
+pub unsafe extern "C" fn h713_hw_sleep_quiesce(hw: *const H713Hw, rep: *mut H713Report) -> i32 {
+    // SAFETY: by this function's contract.
+    let (Some(hw), Some(rep)) = (unsafe { hw.as_ref() }, unsafe { rep.as_mut() }) else {
+        return EINVAL.to_errno();
+    };
+    *rep = empty_report();
+    let mut ex = Exec {
+        io: Mmio { hw },
+        rep,
+        in_raster: false,
+        may_sleep: true,
+    };
+    match resume::sleep_quiesce(hw.latch_timeout_us, &mut ex) {
+        Ok(()) => 0,
+        Err(e) => e,
+    }
+}
