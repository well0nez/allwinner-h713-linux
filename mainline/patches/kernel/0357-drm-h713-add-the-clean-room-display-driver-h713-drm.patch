+}
+
+static int h713_kms_init(struct h713_drm *p)
+{
+	struct drm_device *drm = &p->drm;
+	u32 i;
+	int ret;
+
+	ret = drmm_mode_config_init(drm);
+	if (ret)
+		return ret;
+	drm->mode_config.min_width = 1280;
+	drm->mode_config.min_height = 720;
+	drm->mode_config.max_width = 1920;
+	drm->mode_config.max_height = 1080;
+	drm->mode_config.funcs = &h713_mode_config_funcs;
+
+	ret = drm_universal_plane_init(drm, &p->primary, 1, &h713_plane_funcs, h713_primary_formats,
+				       ARRAY_SIZE(h713_primary_formats), h713_modifiers,
+				       DRM_PLANE_TYPE_PRIMARY, "rgb");
+	if (ret)
+		return ret;
+	drm_plane_helper_add(&p->primary, &h713_plane_helper_funcs);
+	drm_plane_create_alpha_property(&p->primary);
+	drm_plane_create_zpos_immutable_property(&p->primary, 1);
+
+	ret = drm_universal_plane_init(drm, &p->overlay, 1, &h713_plane_funcs, h713_overlay_formats,
+				       ARRAY_SIZE(h713_overlay_formats), h713_modifiers,
+				       DRM_PLANE_TYPE_OVERLAY, "video");
+	if (ret)
+		return ret;
+	drm_plane_helper_add(&p->overlay, &h713_plane_helper_funcs);
+	drm_plane_create_zpos_immutable_property(&p->overlay, 0);
+
+	ret = drm_crtc_init_with_planes(drm, &p->crtc, &p->primary, NULL, &h713_crtc_funcs,
+					"panel");
+	if (ret)
+		return ret;
+	drm_crtc_helper_add(&p->crtc, &h713_crtc_helper_funcs);
+
+	/* picture controls the owner's files back (spec 30, 40 §5) */
+	p->pq_avail = h713_hw_pq_available(&p->hw);
+	for (i = 0; i < H713_PQ_N; i++) {
+		const char *name;
+		u32 lo, hi, def;
+
+		if (h713_hw_pq_info(i, &name, &lo, &hi, &def))
+			return -EINVAL;
+		p->pq_cur[i] = def;
+		if (!(p->pq_avail & BIT(i)))
+			continue;
+		p->pq_prop[i] = drm_property_create_range(drm, 0, name, lo, hi);
+		if (!p->pq_prop[i])
+			return -ENOMEM;
+		drm_object_attach_property(&p->crtc.base, p->pq_prop[i], def);
+	}
+	if (p->hdmi_avail) {
+		static const struct drm_prop_enum_list src[] = {
+			{ H713_SOURCE_BUFFER, "buffer" }, { H713_SOURCE_HDMI, "hdmi" },
+		};
+		struct drm_prop_enum_list st[ARRAY_SIZE(h713_hdmi_state_names)];
+
+		for (i = 0; i < ARRAY_SIZE(st); i++)
+			st[i] = (struct drm_prop_enum_list){ i, h713_hdmi_state_names[i] };
+		p->hdmi_source_prop = drm_property_create_enum(drm, 0, "video_source", src,
+								ARRAY_SIZE(src));
+		p->hdmi_state_prop = drm_property_create_enum(drm, DRM_MODE_PROP_IMMUTABLE,
+							       "hdmi_state", st, ARRAY_SIZE(st));
+		if (!p->hdmi_source_prop || !p->hdmi_state_prop)
+			return -ENOMEM;
+		drm_object_attach_property(&p->crtc.base, p->hdmi_source_prop, H713_SOURCE_BUFFER);
+		drm_object_attach_property(&p->crtc.base, p->hdmi_state_prop, H713_HDMI_OFF);
+		for (i = 0; i < H713_HDMI_INFO_N; i++) {
+			p->hdmi_info_prop[i] = drm_property_create_range(drm, DRM_MODE_PROP_IMMUTABLE,
+									 h713_hdmi_info_names[i], 0,
+									 U32_MAX);
+			if (!p->hdmi_info_prop[i])
+				return -ENOMEM;
+			drm_object_attach_property(&p->crtc.base, p->hdmi_info_prop[i], 0);
+		}
+	}
+	p->pq_gamma = h713_hw_gamma_mapped(&p->hw);
+	if (p->pq_gamma) {
+		ret = drm_mode_crtc_set_gamma_size(&p->crtc, H713_GAMMA_SIZE);
+		if (ret)
+			return ret;
+		drm_crtc_enable_color_mgmt(&p->crtc, 0, false, H713_GAMMA_SIZE);
+		if (p->hw.project) {
+			struct drm_property_blob *b;
+
+			b = drm_property_create_blob(
+				drm, H713_GAMMA_SIZE * sizeof(struct drm_color_lut), NULL);
+			if (IS_ERR(b))
+				return PTR_ERR(b);
+			ret = h713_hw_gamma_default(&p->hw, b->data, H713_GAMMA_SIZE);
+			if (ret) {
+				drm_warn(drm, "%s: no gamma curve (%d): GAMMA_LUT starts off\n",
+					 gamma_fw, ret);
+				drm_property_blob_put(b);
+			} else {
+				p->gamma_default = b;
+			}
+		}
+	}
+	drm_info(drm, "picture controls available: 0x%x of 0x%lx; GAMMA_LUT %s, default %s\n",
+		 p->pq_avail, BIT(H713_PQ_N) - 1,
+		 p->pq_gamma ? "1024 entries" : "off (no \"gamma\" registers)",
+		 p->gamma_default ? "the owner's third curve" : "off");
+
+	ret = drm_simple_encoder_init(drm, &p->encoder, DRM_MODE_ENCODER_LVDS);
+	if (ret)
+		return ret;
+	p->encoder.possible_crtcs = drm_crtc_mask(&p->crtc);
+
+	ret = drm_connector_init(drm, &p->connector, &h713_connector_funcs,
+				 DRM_MODE_CONNECTOR_LVDS);
+	if (ret)
+		return ret;
+	drm_connector_helper_add(&p->connector, &h713_connector_helper_funcs);
+	ret = drm_connector_attach_encoder(&p->connector, &p->encoder);
+	if (ret)
+		return ret;
+
+	ret = drm_vblank_init(drm, 1);
+	if (ret)
+		return ret;
+	drm_mode_config_reset(drm);
+	return 0;
+}
+
+static int h713_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct clk_bulk_data *clks;
+	struct reset_control *rst;
+	const char *region = NULL;
+	struct h713_drm *p;
+	int i, irq, nclk, ret;
+	u32 v140 = 0, v178 = 0, v16c = 0;
+
+	/* scanout words hold 32-bit addresses */
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret)
+		return ret;
+
+	p = devm_drm_dev_alloc(dev, &h713_driver, struct h713_drm, drm);
+	if (IS_ERR(p))
+		return PTR_ERR(p);
+	platform_set_drvdata(pdev, p);
+	spin_lock_init(&p->al_lock);
+	mutex_init(&p->hdmi_lock);
+	p->rx_safe = true;	/* the boot loader left the TV top set up (T3-00) */
+	mutex_init(&p->hw_lock);
+	INIT_DELAYED_WORK(&p->hdmi_work, h713_hdmi_work);
+	init_waitqueue_head(&p->al_wq);
+	hrtimer_setup(&p->flip_timer, h713_flip_poll, CLOCK_MONOTONIC, HRTIMER_MODE_REL);
+
+	for (i = 0; i < H713_NBLK; i++) {
+		struct resource *res =
+			platform_get_resource_byname(pdev, IORESOURCE_MEM, h713_reg_names[i]);
+
+		if (!res) {
+			if (i == H713_BLK_CCU || i == H713_BLK_TCON || i == H713_BLK_RASTER ||
+			    i == H713_BLK_GAMMA ||
+			    i == H713_BLK_RXCTL || i == H713_BLK_RXLINK || i == H713_BLK_TVTOP)
+				/*
+				 * optional: precondition reads only; RASTER for the alignment;
+				 * GAMMA
+				 */
+				continue;
+			return dev_err_probe(dev, -ENODEV, "missing reg \"%s\"\n",
+					     h713_reg_names[i]);
+		}
+		/*
+		 * Not requested: CCU belongs to the clock driver, the display blocks may be claimed
+		 * by nobody else.
+		 */
+		p->hw.blk[i].base = devm_ioremap(dev, res->start, resource_size(res));
+		if (!p->hw.blk[i].base)
+			return -ENOMEM;
+		p->hw.blk[i].phys = res->start;
+		p->hw.blk[i].size = resource_size(res);
+	}
+	h713_tvtop_check(p);
+	p->hw.nr_base = nr_base;
+	p->hw.dram_set = dram_set;
+	p->hw.latch_timeout_us = latch_timeout_us;
+	p->hw.switches_off = switches_off;
+	p->hw.pace_write_us = pace_write_us;
+	p->hw.pace_table_us = pace_table_us;
+	/* stage 3: the HDMI input needs its windows, the ring in a no-map region and the EDID provider */
+	if (!h713_hw_hdmi_mapped(&p->hw)) {
+		dev_info(dev, "hdmi: no \"rxctl\"/\"rxlink\"/\"tvtop\"/\"cap\" registers: no HDMI input\n");
+	} else if (h713_hw_ring(ring_base, &p->ring)) {
+		dev_warn(dev, "hdmi: ring_base 0x%08x not 4 KiB aligned: no HDMI input\n", ring_base);
+	} else if (!h713_reserved_nomap(p->ring.luma[0], p->ring.span, &region)) {
+		dev_warn(dev, "hdmi: ring 0x%08x+0x%x not in a no-map reserved region: no HDMI input\n",
+			 p->ring.luma[0], p->ring.span);
+	} else if (!H713_HAVE_ARISC && !hdmi_edid_external) {
+		dev_info(dev, "hdmi: no EDID/hot-plug provider (spec 57) and no hdmi_edid_external=1: no HDMI input\n");
+	} else if (hdmi_port > 2) {
+		dev_warn(dev, "hdmi: hdmi_port %u: the provider has ports 0..2\n", hdmi_port);
+	} else {
+		p->hdmi_avail = true;
+		dev_info(dev, "hdmi: input offered; ring 0x%08x+0x%x inside no-map region %s; EDID/hot-plug %s\n",
+			 p->ring.luma[0], p->ring.span, region,
+			 hdmi_edid_external ? "external (override)" : "by the provider (spec 57)");
+		if (!hdmi_edid_external && !request_firmware(&p->edid, edid_fw, dev)) {
+			if (p->edid->size != 512) {
+				dev_warn(dev, "hdmi: %s: %zu bytes, not 512: the provider serves what it holds\n",
+					 edid_fw, p->edid->size);
+			} else {
+				memcpy(p->edid_buf, p->edid->data, 512);
+				p->edid_len = 512;
+			}
+			release_firmware(p->edid);
+			p->edid = NULL;
+		} else if (!hdmi_edid_external) {
+			p->edid = NULL;
+			dev_info(dev, "hdmi: no %s: the provider serves the EDID it holds\n", edid_fw);
+		}
+	}
+	if (h713_reserved_nomap(nr_base, h713_hw_nr_span(), &region)) {
+		p->hw.nr_reserved = 1;
+		dev_info(dev, "spec/12 buffers 0x%08x+0x%x inside no-map region %s\n", nr_base,
+			 h713_hw_nr_span(), region);
+	} else {
+		dev_warn(
+			dev,
+			"spec/12 buffers 0x%08x+0x%x not in a no-map reserved region: full-set video refused (05 §6)\n",
+			nr_base, h713_hw_nr_span());
+	}
+
+	/*
+	 * 05 §4: hold every clock the node lists, or the unused-clock cleanup gates the panel path.
+	 */
+	nclk = devm_clk_bulk_get_all_enabled(dev, &clks);
+	if (nclk < 0)
+		return dev_err_probe(dev, nclk, "clocks\n");
+	if (!nclk)
+		dev_warn(dev, "no clocks to hold: boot with clk_ignore_unused (spec 05 §4)\n");
+	/*
+	 * 58 §3: the HDMI receiver and capture need the power domains tvfe and tvcap on (the node may
+	 * list them; the core attaches only a single domain by itself): attach every listed domain and
+	 * hold it on for the device's life.
+	 */
+	ret = h713_hold_power_domains(dev);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "power domains\n");
+	/* 05 §4.1: the display bus reset stays deasserted (shared: nobody asserts it under us). */
+	rst = devm_reset_control_get_optional_shared_deasserted(dev, NULL);
+	if (IS_ERR(rst))
+		return dev_err_probe(dev, PTR_ERR(rst), "reset\n");
+
+	ret = request_firmware(&p->tse, fw, dev);
+	if (ret) {
+		dev_warn(dev, "%s: %d: the video plane stays off\n", fw, ret);
+		p->tse = NULL;
+	} else {
+		ret = devm_add_action_or_reset(dev, h713_release_fw, (void *)p->tse);
+		if (ret)
+			return ret;
+		p->hw.tse = p->tse->data;
+		p->hw.tse_len = p->tse->size;
+		ret = h713_hw_tse_check(&p->hw);
+		if (ret) {
+			dev_warn(dev, "%s: does not parse (%d): the video plane stays off\n", fw,
+				 ret);
+			p->hw.tse = NULL;
+			p->hw.tse_len = 0;
+		}
+	}
+
+	ret = request_firmware(&p->pq_fw, pq_fw, dev);
+	if (ret) {
+		dev_warn(dev, "%s: %d: no picture controls from it\n", pq_fw, ret);
+		p->pq_fw = NULL;
+	} else {
+		ret = devm_add_action_or_reset(dev, h713_release_fw, (void *)p->pq_fw);
+		if (ret)
+			return ret;
+		p->hw.pq = p->pq_fw->data;
+		p->hw.pq_len = p->pq_fw->size;
+	}
+
+	if (panel_replay) {
+		struct h713_panel_counts c;
+
+		ret = request_firmware(&p->logo_fw, logo_fw, dev);
+		if (ret) {
+			dev_warn(dev, "resume: %s: %d: no panel bring-up\n", logo_fw, ret);
+			p->logo_fw = NULL;
+		} else {
+			ret = devm_add_action_or_reset(dev, h713_release_fw, (void *)p->logo_fw);
+			if (ret)
+				return ret;
+			p->hw.logo = p->logo_fw->data;
+			p->hw.logo_len = p->logo_fw->size;
+			ret = h713_hw_panel_check(&p->hw, panel_plan, strlen(panel_plan), logo_project, &c);
+			if (ret || !c.writes)
+				dev_warn(dev, "resume: panel_plan \"%s\" refused (%d, %u writes): no panel bring-up\n",
+					 panel_plan, ret, c.writes);
+			else
+				p->panel_ok = true;
+			if (p->panel_ok)
+				dev_info(dev, "resume: panel bring-up from %s project 0x%x, plan \"%s\": %u writes, %u pulses, %u delays (%u ms)\n",
+					 logo_fw, logo_project, panel_plan, c.writes, c.pulses, c.delays,
+					 c.delay_ms);
+		}
+	}
+
+	/* spec 60 §3: the TV-side re-init after a wake, as data */
+	if (!*tvtop_init || !strcmp(tvtop_init, "none")) {
+		dev_info(dev, "resume: no HDMI input after a deep sleep until reboot (spec 60 v4)\n");
+	} else if (strcmp(tvtop_init, "spec60")) {
+		u32 w = 0;
+
+		ret = h713_hw_regs_check(&p->hw, tvtop_init, strlen(tvtop_init), &w);
+		if (ret) {
+			dev_warn(dev, "resume: tvtop_init refused (%d: syntax, or an address outside the mapped blocks)\n",
+				 ret);
+		} else {
+			p->tvtop[0].text = tvtop_init;
+			p->tvtop[0].len = strlen(tvtop_init);
+			p->ntvtop = 1;
+			dev_warn(dev, "resume: TV-side re-init after a wake (tvtop_init, UNSAFE, spec 60 v4): %u writes\n",
+				 w);
+		}
+	} else {
+		u32 part, len, w, total = 0;
+
+		dev_warn(dev, "resume: tvtop_init=spec60 is UNSAFE (spec 60 v4: 8 of 12 good, a bad one hangs the SoC)\n");
+
+		/* the clock rewrites need the CCU page (bench mode); with a DT node they are the clock driver's */
+		for (part = 0; part < 2; part++) {
+			const char *t = h713_hw_tvtop_default(part, &len);
+
+			if (h713_hw_regs_check(&p->hw, t, len, &w))
+				continue;
+			p->tvtop[p->ntvtop].text = t;
+			p->tvtop[p->ntvtop].len = len;
+			p->ntvtop++;
+			total += w;
+		}
+		dev_info(dev, "resume: TV-side re-init after a wake (spec 60 §3%s): %u writes\n",
+			 p->ntvtop == 2 ? ": TV clocks + TV top" : ": TV top only, no CCU page", total);
+	}
+
+	ret = request_firmware(&p->project_fw, gamma_fw, dev);
+	if (ret) {
+		dev_warn(dev, "%s: %d: GAMMA_LUT starts off\n", gamma_fw, ret);
+		p->project_fw = NULL;
+	} else {
+		ret = devm_add_action_or_reset(dev, h713_release_fw, (void *)p->project_fw);
+		if (ret)
+			return ret;
+		p->hw.project = p->project_fw->data;
+		p->hw.project_len = p->project_fw->size;
+	}
+
+	ret = h713_kms_init(p);
+	if (ret)
+		return ret;
+
+	/*
+	 * The video vsync interrupt starts off whatever an earlier load left (its enable bit
+	 * survives an unload): it is on only while the alignment samples it or the HDMI rotation
+	 * runs, never during a full enable (the raster check polls its status bit, 10 §6.3).
+	 */
+	h713_hw_video_vsync_irq(&p->hw, false);
+
+	irq = platform_get_irq_byname(pdev, "rgb-done");
+	if (irq < 0)
+		return irq;
+	ret = devm_request_irq(dev, irq, h713_irq, 0, DRV_NAME, p);
+	if (ret)
+		return ret;
+	irq = platform_get_irq_byname_optional(pdev, "video-vsync");
+	if (irq > 0) {
+		ret = devm_request_irq(dev, irq, h713_vsync_irq, 0, DRV_NAME "-vsync", p);
+		if (ret)
+			return ret;
+	} else if (align) {
+		dev_warn(dev, "no video-vsync interrupt: alignment by timing impossible\n");
+	}
+
+	h713_hw_read(&p->hw, 0x05600140, &v140);
+	h713_hw_read(&p->hw, 0x05600178, &v178);
+	h713_hw_read(&p->hw, 0x0560016c, &v16c);
+	dev_info(
+		dev,
+		"handoff: RGB control 0x%08x, address 0x%08x, irq enable 0x%08x; %d clocks, reset %s; %s %s\n",
+		v140, v178, v16c, nclk, rst ? "held" : "none", fw,
+		p->hw.tse ? "loaded" : "missing");
+
+	ret = drm_dev_register(&p->drm, 0);
+	if (ret)
+		return ret;
+	/* the HDMI receiver as a V4L2 capture device too (h713_hdmirx.h: the same input, one owner) */
+	if (p->hdmi_avail) {
+		ret = h713_hdmirx_register(p, dev, &p->rx);
+		if (ret)
+			dev_warn(dev, "hdmirx: V4L2 device not registered: %d (the CRTC path stays)\n", ret);
+		else if (!p->rx)
+			dev_info(dev, "hdmirx: no V4L2 device (kernel without CONFIG_VIDEO_DEV)\n");
+	}
+	return 0;
+}
+
+static void h713_remove(struct platform_device *pdev)
+{
+	struct h713_drm *p = platform_get_drvdata(pdev);
+
+	h713_hdmirx_unregister(p->rx);	/* no new V4L2 opens; open files keep p, not the hardware */
+	drm_dev_unregister(&p->drm);
+	drm_atomic_helper_shutdown(&p->drm);
+	/* the shutdown's commit put the CRTC's use of the HDMI input; a V4L2 user's goes here */
+	mutex_lock(&p->hdmi_lock);
+	p->hdmi_gone = true;
+	if (p->hdmi_on)
+		h713_hdmi_off(p, "unload");
+	mutex_unlock(&p->hdmi_lock);
+	cancel_delayed_work_sync(&p->hdmi_work);
+	h713_hw_video_vsync_irq(&p->hw, false);	/* leave no enable bit to the next load */
+	hrtimer_cancel(&p->flip_timer);
+	dev_info(
+		&pdev->dev,
+		"flip events: %u at the RGB done, %u after polling the latch (at most %u x %u us), %u waited for the next RGB done\n",
+		p->flip_at_irq, p->flip_at_poll, p->flip_poll_max, H713_FLIP_POLL_US, p->flip_late);
+	h713_pq_restore(p);
+	if (p->gamma_default) {
+		drm_property_blob_put(p->gamma_default);
+		p->gamma_default = NULL;
+	}
+	if (restore_logo) {
+		struct h713_report rep = {};
+		const char *region = NULL;
+		int ret;
+
+		/* 1080 lines of 7680 bytes, inside a reserved region nobody else writes (05 §6). */
+		if (!h713_reserved_nomap(logo_addr, 1080 * 7680, &region)) {
+			dev_warn(&pdev->dev,
+				 "logo 0x%08x not in a no-map reserved region: panel left black\n",
+				 logo_addr);
+			return;
+		}
+		ret = h713_hw_restore_handoff(&p->hw, logo_addr, &rep);
+		dev_info(
+			&pdev->dev,
+			"unload: logo 0x%08x (%s) restored: %d, %u writes, %u read-back mismatches\n",
+			logo_addr, region, ret, rep.writes, rep.mismatches);
+	}
+}
+
+static void h713_shutdown(struct platform_device *pdev)
+{
+	drm_atomic_helper_shutdown(&((struct h713_drm *)platform_get_drvdata(pdev))->drm);
+}
+
+static const struct of_device_id h713_of_match[] = {
+	{ .compatible = "allwinner,sun50i-h713-display-engine" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, h713_of_match);
+
+/* --- system sleep ------------------------------------------------------------------------------ */
+
+/*
+ * The panel bring-up step of a resume: map the 4 KiB pages panel_plan writes and replay it from
+ * LogoRegData.bin (spec 40 §3) in the plan's order (spec 05 §7), each write read back.
+ */
+static int h713_panel_bringup(struct h713_drm *p)
+{
+	struct device *dev = p->drm.dev;
+	struct h713_report rep = {};
+	struct h713_block *maps;
+	u32 *pages, n = 0, i;
+	int ret;
+
+	pages = kcalloc(64, sizeof(*pages), GFP_KERNEL);
+	maps = kcalloc(64, sizeof(*maps), GFP_KERNEL);
+	ret = -ENOMEM;
+	if (!pages || !maps)
+		goto out;
+	ret = h713_hw_panel_pages(&p->hw, panel_plan, strlen(panel_plan), logo_project, pages, 64, &n);
+	if (ret)
+		goto out;
+	for (i = 0; i < n; i++) {
+		maps[i].phys = pages[i];
+		maps[i].size = 0x1000;
+		maps[i].base = ioremap(pages[i], 0x1000);
+		if (!maps[i].base) {
+			ret = -ENOMEM;
+			goto unmap;
+		}
+	}
+	ret = h713_hw_panel_replay(&p->hw, panel_plan, strlen(panel_plan), logo_project, maps, n, &rep);
+	dev_info(dev, "resume: panel bring-up (plan \"%s\", %u pages): %d, %u writes, %u read-back mismatches\n",
+		 panel_plan, n, ret, rep.writes, rep.mismatches);
+	for (i = 0; i < min_t(u32, rep.nbad, H713_REPORT_BAD); i++)
+		dev_warn(dev, "  0x%08x: expected 0x%08x, read 0x%08x\n", rep.bad_addr[i],
+			 rep.bad_expect[i], rep.bad_read[i]);
+unmap:
+	for (i = 0; i < n; i++)
+		if (maps[i].base)
+			iounmap(maps[i].base);
+out:
+	kfree(maps);
+	kfree(pages);
+	return ret;
+}
+
+/*
+ * Suspend (spec 60): the helper saves the atomic state and disables the CRTC - that commit stops the
+ * HDMI rotation and the CRTC's use of the input, takes the planes off and vblank goes off. Then
+ * the V4L2 stream's poll and any other user of the HDMI input stop (capture outputs off, 40 ms);
+ * then every display DMA master is stopped with the exact words of 60 §1/§2 (a wake is lost while
+ * channel 0 or an NRC write channel runs, and channel 0 stays frozen after it unless the RGB
+ * channel was off too): channel 0 off + latch, the NRC write channels' bit 31, the RGB channel off +
+ * latch; from here on nothing touches the capture block or the receiver until the TV-side
+ * re-init after the wake. Last the work, the flip timer and both scanout interrupt enables.
+ */
+static int h713_pm_suspend(struct device *dev)
+{
+	struct h713_drm *p = dev_get_drvdata(dev);
+	struct h713_report rep = {};
+	int ret;
+
+	ret = drm_mode_config_helper_suspend(&p->drm);
+	if (ret)
+		return ret;
+	h713_hdmirx_quiesce(p->rx);	/* the V4L2 stream's poll of CAP stops first */
+	mutex_lock(&p->hdmi_lock);
+	if (p->hdmi_on)			/* a V4L2 user still holds the input: stop it for the sleep */
+		h713_hdmi_off(p, "suspend");
+	p->rx_safe = false;
+	p->hw.cap_blocked = 1;
+	mutex_unlock(&p->hdmi_lock);
+	cancel_delayed_work_sync(&p->hdmi_work);
+	hrtimer_cancel(&p->flip_timer);
+	ret = h713_hw_sleep_quiesce(&p->hw, &rep);
+	h713_hw_video_vsync_irq(&p->hw, false);
+	h713_hw_vblank_irq(&p->hw, false);
+	memset(&p->cur, 0, sizeof(p->cur));	/* the hardware shows nothing now */
+	p->suspends++;
+	drm_info(&p->drm,
+		 "suspend %u: planes off, HDMI input stopped; channel 0, NRC write channels, RGB channel stopped (spec 60): %d, %u writes, %u read-back mismatches, %u latch timeouts; interrupts off\n",
+		 p->suspends, ret, rep.writes, rep.mismatches, rep.timeouts);
+	return 0;
+}
+
+/*
+ * Resume (spec 60): every display block kept its words (60 §2, no panel re-bring-up; panel_replay
+ * stays a switch), the TV top did not (60 §3). In this order:
+ * 1. the saved state committed: the RGB channel back, the video plane through the stage-2 full
+ *    enable (the init tables onwards, as a first enable - with the capture-block writes left out
+ *    while the TV side is not set up again), all picture controls and GAMMA_LUT written again;
+ * 2. the TV-side re-init (tvtop_init; spec 60 §3's best: 5 of 6 good, a bad one is only seen as a
+ *    hang at the first receiver / capture read, so it runs only when a user needs the HDMI input,
+ *    from h713_hdmi_get);
+ * 3. the HDMI input again if the CRTC or an open V4L2 file uses it: the provider, then the
+ *    receiver sequence without waiting for TMDS (60 §3: TMDS returns only after it), lock,
+ *    capture, rotation.
+ */
+static int h713_pm_resume(struct device *dev)
+{
+	struct h713_drm *p = dev_get_drvdata(dev);
+	u32 i;
+	int ret;
+
+	if (p->panel_ok)
+		h713_panel_bringup(p);
+	/* the hardware may have lost words: write every control and the LUT again */
+	for (i = 0; i < H713_PQ_N; i++)
+		p->pq_cur[i] = U32_MAX;
+	if (p->gamma_cur) {
+		drm_property_blob_put(p->gamma_cur);
+		p->gamma_cur = NULL;
+	}
+	p->rs_state = RS_IDLE;
+	p->align_pending = false;
+	ret = drm_mode_config_helper_resume(&p->drm);
+
+	/*
+	 * The CRTC's use came back with the commit above (its get runs the TV-side re-init after the
+	 * stage-2 enable); an open V4L2 file's here. Unused, the TV side stays untouched until a user
+	 * comes (the re-init then runs first).
+	 */
+	mutex_lock(&p->hdmi_lock);
+	if (p->hdmi_users && !p->hdmi_on)
+		h713_hdmi_get(p, 0);
+	if (!p->hdmi_users)
+		drm_info(&p->drm, "resume: the HDMI input is not in use: the TV side stays untouched\n");
+	mutex_unlock(&p->hdmi_lock);
+	h713_hdmirx_resume(p->rx);
+	return ret;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(h713_pm_ops, h713_pm_suspend, h713_pm_resume);
+
+static struct platform_driver h713_platform_driver = {
+	.probe = h713_probe,
+	.remove = h713_remove,
+	.shutdown = h713_shutdown,
+	.driver = {
+		.name = DRV_NAME,
+		.of_match_table = h713_of_match,
+		.pm = pm_sleep_ptr(&h713_pm_ops),
+	},
+};
