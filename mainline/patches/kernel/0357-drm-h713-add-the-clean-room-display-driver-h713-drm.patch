+/// The gamma control word (30 §4.3): bit 28 selects the bank shown, bit 30 opens the ports, bit 26
+/// with [21:20] = 3 applies the LUT.
+pub const GAMMA_CTRL: u32 = 0x051c_00e8;
+/// Bank select (toggling it swaps the shown and the hidden bank).
+pub const GAMMA_BANK: u32 = 1 << 28;
+/// Ports take data while set.
+pub const GAMMA_PORTS_OPEN: u32 = 1 << 30;
+/// LUT applied (with [21:20] = 3); clear = exactly linear (30 §4.3, 91 O14: neutral = LUT off).
+pub const GAMMA_ON: u32 = 1 << 26;
+/// [21:20]: both set for the LUT to apply.
+pub const GAMMA_MODE: u32 = 0x0030_0000;
+
+/// Every plan write of [`GAMMA_CTRL`] (the init table's `0x00f00000`, 30 §5's `0x04f00000`, the 12
+/// state's `0x14f00000`) becomes a masked write that leaves the bank bit alone and keeps the LUT
+/// off and the ports closed: the 12 state's value would show whatever the bank holds after reset
+/// (30 §4.3: a stale curve after a warm reboot). The LUT is turned on only by the gamma upload
+/// (`gamma::upload`), after its curve is in the bank.
+fn gamma_rule(op: Op) -> Op {
+    let fix = |value: u32| value & !(GAMMA_BANK | GAMMA_PORTS_OPEN | GAMMA_ON);
+    match op {
+        Op::Write {
+            addr: GAMMA_CTRL,
+            value,
+            ..
+        } => Op::Masked {
+            addr: GAMMA_CTRL,
+            mask: !GAMMA_BANK,
+            value: fix(value),
+            rb: Readback::Exact,
+        },
+        Op::Masked {
+            addr: GAMMA_CTRL,
+            mask,
+            value,
+            ..
+        } => Op::Masked {
+            addr: GAMMA_CTRL,
+            mask: (mask | GAMMA_ON | GAMMA_PORTS_OPEN) & !GAMMA_BANK,
+            value: fix(value),
+            rb: Readback::Exact,
+        },
+        other => other,
+    }
+}
