+/// Phase words (20 §3 S1/S2 HY320: `0x000` [15:0], `0x038` [15:0]; the two measured points only, 91
+/// O8).
+pub const fn phase_words(state: ScaleState) -> (u32, u32) {
+    match state {
+        ScaleState::OneToOne => (0x0f00_8000, 0x0010_0000),
+        ScaleState::Up720To1080 => (0x0f00_6aaa, 0x0010_d555),
+    }
+}
+
+/// The scaler word at `off` for `state`: S1 HY320 with the ratio rule (20 §2.1), the measured
+/// phases and modes, bypass set only at 1:1, and the input window = source size.
+pub fn scaler_word(
+    state: ScaleState,
+    off: u32,
+    src_w: u32,
+    src_h: u32,
+    dst_w: u32,
+    dst_h: u32,
+) -> Option<u32> {
+    let (hp, vp) = phase_words(state);
+    Some(match off {
+        0x000 => hp,
+        0x008 => hratio_word(state, src_w, dst_w),
+        0x014 => match state {
+            ScaleState::OneToOne => SCL_BYPASS,
+            ScaleState::Up720To1080 => 0,
+        },
+        0x034 => (src_w << 16) | src_h,
+        0x038 => vp,
+        0x03c => ratio(src_h, dst_h),
+        _ => S1_HY320.iter().find(|w| w.0 == off)?.1,
+    })
+}
