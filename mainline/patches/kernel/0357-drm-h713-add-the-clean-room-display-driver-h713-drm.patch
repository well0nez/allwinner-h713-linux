+/*
+ * The panel mode the boot loader leaves (05 §5): 2200 x 1125 at 162.21 MHz = 65.538 Hz. Sync
+ * positions are not decoded and do not reach the hardware (the timing is adopted, not programmed).
+ */
+static const struct drm_display_mode h713_mode = {
+	DRM_MODE("1920x1080", DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED, 162210,
+		 1920, 2008, 2052, 2200, 0, 1080, 1084, 1089, 1125, 0,
+		 DRM_MODE_FLAG_PHSYNC | DRM_MODE_FLAG_PVSYNC)
+};
+
+static bool h713_mode_matches(const struct drm_display_mode *m)
+{
+	return m->hdisplay == h713_mode.hdisplay && m->vdisplay == h713_mode.vdisplay &&
+	       m->htotal == h713_mode.htotal && m->vtotal == h713_mode.vtotal &&
+	       m->clock == h713_mode.clock;
+}
