+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * h713_drm: clean-room DRM/KMS driver for the Allwinner H713 display (HY320 panel), the C shell.
+ *
+ * C owns the module, the platform driver, the DRM device, the mappings, the interrupt and the
+ * clocks; every register access of the display goes through the Rust hardware layer
+ * (h713_drm_hw.rs, h713_drm.h). Spec: cleanroom-h713/spec 00, 05, 10, 12, 20, 30, 40.
+ *
+ * - one CRTC that adopts the panel mode the boot loader left (05 §1, §5): no modeset of the panel;
+ * - a primary plane, XRGB8888 1920x1080 on the RGB channel (05 §1.2, flips per 05 §2), on top, with
+ *   a global alpha property for RGB over video (05 §2 R5);
+ * - an overlay plane, NV12/NV16 on the video channel, 1920x1080 1:1 or 1280x720 -> 1920x1080 (10,
+ *   12, 20);
+ * - vblank from the RGB channel's frame-done interrupt, GIC SPI 112 (05 §3);
+ * - every clock of the DT node held, its display bus reset kept deasserted (05 §4, §4.1);
+ * - the init tables paced (10 §6.3); the spec/12 buffers only inside a no-map reserved region (05
+ *   §6);
+ * - on unload, optionally the boot logo back (05 §6);
+ * - picture controls as CRTC properties (saturation, hue, white balance, contrast, dither class,
+ *   brightness, sharpness), computed from the owner's pq_custom.TSE / database.TSE (spec 30, 40
+ *   §5), and the standard GAMMA_LUT (spec 30 §4.3: loaded into the hidden bank, shown by the bank
+ *   switch), written in the vblank interrupt and read back;
+ * - RGB over video: the RGB raster lined up with the video raster when both planes are shown (05
+ *   §2.1): rows by the interrupt timing, optionally columns and rows by a short calibration with
+ *   the driver's test content.
+ *
+ * With CONFIG_DRM_H713_BENCH (H713_DRM_BENCH), `bench=1` registers a platform device with the
+ * spec's resources for a boot without a DT node (the B0 bench boot).
+ */
+#define pr_fmt(fmt) KBUILD_MODNAME ": " fmt
+
+#include <linux/clk.h>
