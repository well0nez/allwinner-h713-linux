+/* --- module parameters ------------------------------------------------------------------------ */
+
+#ifdef H713_DRM_BENCH
+static bool bench;
+module_param(bench, bool, 0444);
+MODULE_PARM_DESC(
+	bench,
+	"register an own platform device with the spec's resources (B0 bench boot, no DT node)");
+#endif
+
+static char *fw = "h713/database.TSE";
+module_param(fw, charp, 0444);
+MODULE_PARM_DESC(fw, "firmware name of the owner's database.TSE (request_firmware)");
+
+static uint nr_base = 0x4c3ef000;
+module_param(nr_base, uint, 0444);
+MODULE_PARM_DESC(nr_base,
+		 "physical base of the spec/12 buffer area (full set; must be reserved memory)");
+
+static uint dram_set;
+module_param(dram_set, uint, 0444);
+MODULE_PARM_DESC(dram_set, "spec/12 word set: 0 full, 1 minimal40, 2 minimal85 (1080p only)");
+
+static uint switches_off;
+module_param(switches_off, uint, 0444);
+MODULE_PARM_DESC(switches_off, "bit i: switch i of `vp-bench switches` off");
+
+static uint latch_timeout_us = 200000;
+module_param(latch_timeout_us, uint, 0444);
+MODULE_PARM_DESC(latch_timeout_us, "bound of every latch poll");
+
+static uint pace_write_us;
+module_param(pace_write_us, uint, 0444);
+MODULE_PARM_DESC(
+	pace_write_us,
+	"pause after each init-table write (spec 10 §6.3; 0: the table pause alone is enough)");
