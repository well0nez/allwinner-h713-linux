gpiolib: of: keep of_get_named_gpio() for the H713 board drivers

Linux 7.3 removed of_get_named_gpio() and <linux/of_gpio.h>. hy310-board-mgr and hy310-focus-motor read
GPIOs from properties that do not end in -gpio(s) (motor-gpio-phase0, ...), which the gpiod lookups cannot
name. This brings back the 6.18 function and header unchanged; converting the two drivers to descriptors
is a follow-up.

diff --git a/drivers/gpio/gpiolib-of.c b/drivers/gpio/gpiolib-of.c
index f36e4b171..5daee3a4d 100644
--- a/drivers/gpio/gpiolib-of.c
+++ b/drivers/gpio/gpiolib-of.c
@@ -13,6 +13,7 @@
 #include <linux/fwnode.h>
 #include <linux/io.h>
 #include <linux/module.h>
+#include <linux/of_gpio.h>
 #include <linux/of.h>
 #include <linux/of_address.h>
 #include <linux/pinctrl/pinctrl.h>
@@ -454,6 +455,32 @@ static struct gpio_desc *of_get_named_gpiod_flags(const struct device_node *np,
 	return desc;
 }
 
+/**
+ * of_get_named_gpio() - Get a GPIO number to use with GPIO API
+ * @np:		device node to get GPIO from
+ * @propname:	Name of property containing gpio specifier(s)
+ * @index:	index of the GPIO
+ *
+ * **DEPRECATED** This function is deprecated and must not be used in new code.
+ *
+ * Returns:
+ * GPIO number to use with Linux generic GPIO API, or one of the errno
+ * value on the error condition.
+ */
+int of_get_named_gpio(const struct device_node *np, const char *propname,
+		      int index)
+{
+	struct gpio_desc *desc;
+
+	desc = of_get_named_gpiod_flags(np, propname, index, NULL);
+
+	if (IS_ERR(desc))
+		return PTR_ERR(desc);
+	else
+		return desc_to_gpio(desc);
+}
+EXPORT_SYMBOL_GPL(of_get_named_gpio);
+
 /* Converts gpio_lookup_flags into bitmask of GPIO_* values */
 static unsigned long of_convert_gpio_flags(enum of_gpio_flags flags)
 {
