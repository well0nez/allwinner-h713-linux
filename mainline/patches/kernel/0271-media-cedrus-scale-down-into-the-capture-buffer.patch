+/*
+ * The reconstruction is always the full coded size in linear NV12, whatever
+ * the capture queue has been scaled to.
+ */
+void cedrus_update_recon_format(struct cedrus_ctx *ctx)
+{
+	ctx->recon_fmt = ctx->dst_fmt;
+	ctx->recon_fmt.width = ctx->src_fmt.width;
+	ctx->recon_fmt.height = ctx->src_fmt.height;
+	ctx->recon_fmt.pixelformat = V4L2_PIX_FMT_NV12;
+	cedrus_prepare_format(&ctx->recon_fmt);
+}
+
+/*
+ * Scaling is a property of the H.264 engine block -- VE_H264_SDROT_* live at
+ * 0x240 inside it -- so it is offered for H.264 only.  Each axis divides by 1,
+ * 2 or 4 and nothing between: the VE has no arbitrary-ratio scaler that works
+ * on this part.  A request is rounded DOWN to the next reachable size rather
+ * than refused, which is what V4L2 expects of a compose rectangle, and the
+ * caller reads back what it actually got.
+ */
+static u8 cedrus_compose_shift(unsigned int coded, unsigned int want)
+{
+	u8 shift = 0;
+
+	/* Largest reachable size that is still no bigger than asked for. */
+	while (shift < VE_H264_SDROT_MAX_SHIFT && (coded >> shift) > want)
+		shift++;
+
+	return shift;
+}
+
+static int cedrus_g_selection(struct file *file, void *priv,
+			      struct v4l2_selection *sel)
+{
+	struct cedrus_ctx *ctx = cedrus_file2ctx(file);
+
+	if (sel->type != V4L2_BUF_TYPE_VIDEO_CAPTURE)
+		return -EINVAL;
+
+	switch (sel->target) {
+	case V4L2_SEL_TGT_COMPOSE:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = ctx->dst_fmt.width;
+		sel->r.height = ctx->dst_fmt.height;
+		return 0;
+	case V4L2_SEL_TGT_COMPOSE_DEFAULT:
+	case V4L2_SEL_TGT_COMPOSE_BOUNDS:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = ctx->src_fmt.width;
+		sel->r.height = ctx->src_fmt.height;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int cedrus_s_selection(struct file *file, void *priv,
+			      struct v4l2_selection *sel)
+{
+	struct cedrus_ctx *ctx = cedrus_file2ctx(file);
+	struct vb2_queue *vq;
+	u8 h_shift, v_shift;
+
+	if (sel->type != V4L2_BUF_TYPE_VIDEO_CAPTURE ||
+	    sel->target != V4L2_SEL_TGT_COMPOSE)
+		return -EINVAL;
+
+	if (ctx->src_fmt.pixelformat != V4L2_PIX_FMT_H264_SLICE)
+		return -EINVAL;
+
+	/* The buffer size changes with the picture, so nothing may be queued. */
+	vq = v4l2_m2m_get_vq(ctx->fh.m2m_ctx, V4L2_BUF_TYPE_VIDEO_CAPTURE);
+	if (vb2_is_busy(vq))
+		return -EBUSY;
+
+	if (sel->r.left || sel->r.top || !sel->r.width || !sel->r.height ||
+	    sel->r.width > ctx->src_fmt.width ||
+	    sel->r.height > ctx->src_fmt.height)
+		return -EINVAL;
+
+	h_shift = cedrus_compose_shift(ctx->src_fmt.width, sel->r.width);
+	v_shift = cedrus_compose_shift(ctx->src_fmt.height, sel->r.height);
+
+	ctx->sd_h_shift = h_shift;
+	ctx->sd_v_shift = v_shift;
+	cedrus_reset_cap_format(ctx);
+	cedrus_update_recon_format(ctx);
+
+	sel->r.width = ctx->dst_fmt.width;
+	sel->r.height = ctx->dst_fmt.height;
+
+	return 0;
+}
