--- a/drivers/staging/media/sunxi/cedrus/cedrus_regs.h
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_regs.h
@@ -63,6 +63,15 @@
 #define VE_PRIMARY_FB_LINE_STRIDE_CHROMA(s)	SHIFT_AND_MASK_BITS(s, 31, 16)
 #define VE_PRIMARY_FB_LINE_STRIDE_LUMA(s)	SHIFT_AND_MASK_BITS(s, 15, 0)
 
+/*
+ * Secondary (scale-down) output line stride, {chroma << 16, luma}: the same
+ * packing as VE_PRIMARY_FB_LINE_STRIDE at 0xc8, which it follows.
+ */
+#define VE_SECONDARY_FB_LINE_STRIDE		0xcc
+
+#define VE_SECONDARY_FB_LINE_STRIDE_CHROMA(s)	SHIFT_AND_MASK_BITS(s, 31, 16)
+#define VE_SECONDARY_FB_LINE_STRIDE_LUMA(s)	SHIFT_AND_MASK_BITS(s, 15, 0)
+
 #define VE_CHROMA_BUF_LEN			0xe8
 
 #define VE_SECONDARY_OUT_FMT_TILED_32_NV12	(0x00 << 30)
@@ -607,6 +616,27 @@
 #define VE_H264_VLD_LEN			0x238
 #define VE_H264_VLD_END			0x23c
 #define VE_H264_SDROT_CTRL		0x240
+/*
+ * Two independent 2-bit fields, one per axis: 0 = 1:1, 1 = 1/2, 2 = 1/4.
+ * A field of 3 is not a valid eighth -- it produces a partial write.  There
+ * is no arbitrary ratio here, so 1920x1080 cannot become 1280x720 in one
+ * step; the closest reachable raster is 960x544, which the display side then
+ * magnifies back to the panel.
+ */
+#define VE_H264_SDROT_CTRL_H_SHIFT(s)	SHIFT_AND_MASK_BITS(s, 9, 8)
+#define VE_H264_SDROT_CTRL_V_SHIFT(s)	SHIFT_AND_MASK_BITS(s, 11, 10)
+#define VE_H264_SDROT_MAX_SHIFT		2
+/*
+ * The two registers following VE_H264_SDROT_CTRL are the scale-down output
+ * addresses. Mainline leaves the gap unnamed, but three sources agree on what
+ * lives there: the vendor libawh264.so exports sd_rotate_ctrl_reg40,
+ * sd_rotate_buf_addr_reg44 and sd_rotate_chroma_buf_addr_reg48, whose numbers
+ * are offsets within this engine block (0x200), matching SDROT_CTRL at 0x240;
+ * and the H.265 engine carries the same trio as VE_DEC_H265_SDRT_{CTRL,
+ * LUMA_ADDR,CHROMA_ADDR} at its own +0x50/0x54/0x58.
+ */
+#define VE_H264_SDROT_LUMA_ADDR		0x244
+#define VE_H264_SDROT_CHROMA_ADDR	0x248
 #define VE_H264_OUTPUT_FRAME_IDX	0x24c
 #define VE_H264_EXTRA_BUFFER1		0x250
 #define VE_H264_EXTRA_BUFFER2		0x254
