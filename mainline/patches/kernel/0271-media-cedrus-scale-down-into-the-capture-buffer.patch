+	 * been asked to scale by; see cedrus_s_selection().
+	 */
+	pix_fmt->width = ctx->src_fmt.width >> ctx->sd_h_shift;
+	pix_fmt->height = ctx->src_fmt.height >> ctx->sd_v_shift;
 	cedrus_prepare_format(pix_fmt);
 
