+/*
+ * Point the VE's secondary output at the V4L2 capture buffer and set the
+ * per-axis division.  The primary reconstruction keeps writing full size into
+ * the buffer's private frame; this is the copy userspace actually gets.
+ *
+ * Three things here are not optional, and each of them fails silently:
+ *
+ *   - THIS MUST RUN AFTER THE CODEC'S OWN SETUP, which is where
+ *     cedrus_engine_enable() writes VE_MODE.  A disabled engine accepts the
+ *     control word and then DROPS THE ADDRESSES, which read back as zero.
+ *   - the addresses go in raw and unshifted, unlike several neighbouring
+ *     engine registers.
+ *   - the secondary output defaults to TILED_32_NV12.  Linear NV12 needs both
+ *     the EXT table selected in VE_CHROMA_BUF_LEN[31:30] and the format in
+ *     VE_PRIMARY_OUT_FMT[3:0]; miss either and a perfectly working scaler
+ *     produces something that renders as horizontal stripes.
+ */
+void cedrus_sd_program(struct cedrus_ctx *ctx, struct vb2_buffer *dst)
+{
+	struct cedrus_dev *dev = ctx->dev;
+	dma_addr_t luma = cedrus_buf_addr(dst, &ctx->dst_fmt, 0);
+	dma_addr_t chroma = cedrus_buf_addr(dst, &ctx->dst_fmt, 1);
+	unsigned int stride = ctx->dst_fmt.bytesperline;
+	u32 reg;
+
+	if (!cedrus_scaling(ctx))
+		return;
+
+	cedrus_write(dev, VE_H264_SDROT_LUMA_ADDR, (u32)luma);
+	cedrus_write(dev, VE_H264_SDROT_CHROMA_ADDR, (u32)chroma);
+
+	cedrus_write(dev, VE_SECONDARY_FB_LINE_STRIDE,
+		     VE_SECONDARY_FB_LINE_STRIDE_CHROMA(stride) |
+		     VE_SECONDARY_FB_LINE_STRIDE_LUMA(stride));
+
+	reg = cedrus_read(dev, VE_CHROMA_BUF_LEN);
+	reg &= ~GENMASK(31, 30);
+	reg |= VE_SECONDARY_OUT_FMT_EXT;
+	cedrus_write(dev, VE_CHROMA_BUF_LEN, reg);
+
+	reg = cedrus_read(dev, VE_PRIMARY_OUT_FMT);
+	reg &= ~0xfu;
+	reg |= VE_SECONDARY_OUT_FMT_EXT_NV12;
+	cedrus_write(dev, VE_PRIMARY_OUT_FMT, reg);
+
+	cedrus_write(dev, VE_H264_SDROT_CTRL,
+		     VE_H264_SDROT_CTRL_H_SHIFT(ctx->sd_h_shift) |
+		     VE_H264_SDROT_CTRL_V_SHIFT(ctx->sd_v_shift));
+
+	/*
+	 * A zero address here means the engine was not enabled when we wrote
+	 * it, and the decode would quietly produce nothing at all.
+	 */
+	if (!cedrus_read(dev, VE_H264_SDROT_LUMA_ADDR))
+		dev_warn_once(dev->dev,
+			      "scale-down address did not latch; engine off?\n");
+}
+
 static irqreturn_t cedrus_irq(int irq, void *data)
 {
 	struct cedrus_dev *dev = data;
