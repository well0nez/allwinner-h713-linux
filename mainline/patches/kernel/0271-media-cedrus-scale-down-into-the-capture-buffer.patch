+/*
+ * While the VE is scaling, each capture buffer needs a private full-size frame
+ * for the reconstruction to live in, because the buffer itself holds the
+ * smaller picture.  It is per buffer rather than a shared pool because the DPB
+ * indexes by capture buffer: two references alive at once are two distinct
+ * frames, and sharing one would corrupt prediction in a way that still decodes.
+ */
+static int cedrus_buf_init(struct vb2_buffer *vb)
+{
+	struct vb2_queue *vq = vb->vb2_queue;
+	struct cedrus_ctx *ctx = vb2_get_drv_priv(vq);
+	struct cedrus_buffer *cbuf = vb2_to_cedrus_buffer(vb);
+	struct cedrus_dev *dev = ctx->dev;
+
+	if (V4L2_TYPE_IS_OUTPUT(vq->type) || !cedrus_scaling(ctx))
+		return 0;
+
+	cbuf->recon_size = ctx->recon_fmt.sizeimage;
+	cbuf->recon = dma_alloc_attrs(dev->dev, cbuf->recon_size,
+				      &cbuf->recon_dma, GFP_KERNEL,
+				      DMA_ATTR_NO_KERNEL_MAPPING);
+	if (!cbuf->recon) {
+		cbuf->recon_size = 0;
+		return -ENOMEM;
+	}
+
+	return 0;
+}
+
+static void cedrus_buf_cleanup(struct vb2_buffer *vb)
+{
+	struct cedrus_ctx *ctx = vb2_get_drv_priv(vb->vb2_queue);
+	struct cedrus_buffer *cbuf = vb2_to_cedrus_buffer(vb);
+
+	if (!cbuf->recon)
+		return;
+
+	dma_free_attrs(ctx->dev->dev, cbuf->recon_size, cbuf->recon,
+		       cbuf->recon_dma, DMA_ATTR_NO_KERNEL_MAPPING);
+	cbuf->recon = NULL;
+	cbuf->recon_dma = 0;
+	cbuf->recon_size = 0;
