+static inline struct cedrus_buffer *
+vb2_v4l2_to_cedrus_buffer(const struct vb2_v4l2_buffer *p)
+{
+	return container_of(p, struct cedrus_buffer, m2m_buf.vb);
+}
+
+static inline struct cedrus_buffer *
+vb2_to_cedrus_buffer(const struct vb2_buffer *p)
+{
+	return vb2_v4l2_to_cedrus_buffer(to_vb2_v4l2_buffer(p));
+}
+
+static inline bool cedrus_scaling(struct cedrus_ctx *ctx)
+{
+	return ctx->sd_h_shift || ctx->sd_v_shift;
+}
+
+/*
+ * Where the decoder writes and predicts from.  EVERY frame address goes
+ * through here -- the current picture and every DPB reference alike -- because
+ * they must agree.  While the VE is scaling, the capture buffer holds the
+ * scaled output and is not a decodable reference, so the frame the hardware
+ * reconstructs into is the buffer's private full-size one.  Getting this
+ * wrong does not fail cleanly: it produces plausible-looking corruption.
+ */
+static inline dma_addr_t cedrus_frame_addr(struct cedrus_ctx *ctx,
+					   struct vb2_buffer *buf,
+					   unsigned int plane)
+{
+	struct cedrus_buffer *cbuf;
+
+	if (!buf)
+		return 0;
+
+	if (cedrus_scaling(ctx)) {
+		cbuf = vb2_to_cedrus_buffer(buf);
+		if (cbuf->recon_dma)
+			return cbuf->recon_dma +
+			       (dma_addr_t)ctx->recon_fmt.bytesperline *
+			       ctx->recon_fmt.height * plane;
+	}
+
+	return cedrus_buf_addr(buf, &ctx->dst_fmt, plane);
+}
+
 static inline dma_addr_t cedrus_dst_buf_addr(struct cedrus_ctx *ctx,
 					     struct vb2_buffer *buf,
 					     unsigned int plane)
 {
-	return buf ? cedrus_buf_addr(buf, &ctx->dst_fmt, plane) : 0;
+	return cedrus_frame_addr(ctx, buf, plane);
 }
 
