  * released. Every register write is logged after its step, with the value
  * before and the read-back, never in the middle of a timed sequence.
  *
+ * The TV top (third reg, 0x06e00000) is the clock and reset word of the
+ * TV blocks behind the receiver: LINK, INCAP and the rest of 0x06xxxxxx.
+ * U-Boot writes it before it starts the core (h713_disp_clocks(): +4
+ * 0x01111117, +8 0x404, +0 0x00111111, all three 0, the three again, 12 ms
+ * apart). A standby to RAM powers the TVFE and TVCAP domains off and on,
+ * and the words read 0x10, 0, 0 after it (HY310, 09.10.2026): a core
+ * started then stalls the bus at its first access to those blocks, the
+ * whole SoC with it, within 200 ms (three of three). So the U-Boot start
+ * repeats U-Boot's step when the words are not U-Boot's; with them in
+ * place (a park without a standby) it leaves them alone.
+ *
  * sysfs: "state" reads running|halted|parked|failed and a register line;
  * writing a display.bin path ("-": /boot/mips/display.bin) to "restart"
  * restarts the core. The receiver (sun50i-h713-hdmirx) has to be unbound
@@ -57,6 +69,12 @@
 #define H713_MIPS_CFG_OFF	0x00d01000	/* cfg file, then TSE: kept */
 #define H713_MIPS_READY_MS	10000		/* U-Boot's budget */
 #define H713_MIPS_DEFAULT_FW	"/boot/mips/display.bin"
+#define H713_TVTOP_CLK		0x0		/* 0x06e00000 */
+#define H713_TVTOP_CLK_ON	0x00111111u
+#define H713_TVTOP_GATE		0x4		/* 0x06e00004 */
+#define H713_TVTOP_GATE_ON	0x01111117u
+#define H713_TVTOP_RST		0x8		/* 0x06e00008; the firmware adds bit 8 */
+#define H713_TVTOP_RST_ON	0x00000404u
 /* "sltiu v1,v1,0x33" of Rx_HDCP14_LoadKey, with 0x06840093 built within 1 KiB */
 #define H713_HDCP_WAIT		0x2c630033
 #define H713_HDCP_NONE		0x2c630000
@@ -91,7 +109,7 @@ static const char * const h713_mips_state_name[] = { "running", "halted", "parke
 
 struct h713_mips {
 	struct device *dev;
-	void __iomem *regs, *ccu;
+	void __iomem *regs, *ccu, *tvtop;
 	void *win;
 	phys_addr_t win_base;
 	struct mutex lock;		/* every register access after the probe */
@@ -200,6 +218,39 @@ static int h713_mips_load(struct h713_mips *m, const void *img, size_t n)
 	return 0;
 }
 
+/* U-Boot's TV top step, where the words are not U-Boot's (after a standby) */
+static int h713_mips_tvtop(struct h713_mips *m)
+{
+	static const u32 seq[][3] = {	/* +4, +8, +0, in U-Boot's order */
+		{ H713_TVTOP_GATE_ON, H713_TVTOP_RST_ON, H713_TVTOP_CLK_ON }, { 0, 0, 0 },
+		{ H713_TVTOP_GATE_ON, H713_TVTOP_RST_ON, H713_TVTOP_CLK_ON },
+	};
+	u32 clk, gate, rst;
+	int i;
+
+	if (!m->tvtop)
+		return h713_mips_say(m, -ENXIO, "U-Boot start: no TV top window (reg 2), core held");
+	clk = readl(m->tvtop + H713_TVTOP_CLK);
+	gate = readl(m->tvtop + H713_TVTOP_GATE);
+	rst = readl(m->tvtop + H713_TVTOP_RST);
+	if (clk == H713_TVTOP_CLK_ON && gate == H713_TVTOP_GATE_ON &&
+	    (rst & H713_TVTOP_RST_ON) == H713_TVTOP_RST_ON)
+		return h713_mips_say(m, 0, "TV top in place: 0x%08x 0x%08x 0x%08x", clk, gate, rst);
+	for (i = 0; i < ARRAY_SIZE(seq); i++) {
+		writel(seq[i][0], m->tvtop + H713_TVTOP_GATE);
+		writel(seq[i][1], m->tvtop + H713_TVTOP_RST);
+		writel(seq[i][2], m->tvtop + H713_TVTOP_CLK);
+		wmb();	/* the words reach the block before the wait starts */
+		fsleep(12000);
+	}
+	return h713_mips_say(m, readl(m->tvtop + H713_TVTOP_CLK) == H713_TVTOP_CLK_ON &&
+			     readl(m->tvtop + H713_TVTOP_GATE) == H713_TVTOP_GATE_ON &&
+			     readl(m->tvtop + H713_TVTOP_RST) == H713_TVTOP_RST_ON ? 0 : -EIO,
+			     "TV top 0x%08x 0x%08x 0x%08x, U-Boot's step: reads 0x%08x 0x%08x 0x%08x",
+			     clk, gate, rst, readl(m->tvtop + H713_TVTOP_CLK),
+			     readl(m->tvtop + H713_TVTOP_GATE), readl(m->tvtop + H713_TVTOP_RST));
+}
+
 static int h713_mips_start(struct h713_mips *m, bool uboot)
 {
 	const char *how = uboot ? "U-Boot" : "vendor";
@@ -209,8 +260,12 @@ static int h713_mips_start(struct h713_mips *m, bool uboot)
 	if (!uboot && readl(m->ccu + H713_MIPS_RST) != H713_MIPS_HELD)
 		return h713_mips_say(m, -ENXIO, "%s start: 0x0200160c 0x%08x, only from 0x00030001",
 				     how, readl(m->ccu + H713_MIPS_RST));
-	if (uboot)
+	if (uboot) {
+		ret = h713_mips_tvtop(m);
+		if (ret)
+			return ret;
 		h713_mips_steps(m, h713_mips_ladder);
+	}
 	/* the share registers and the boot address are in the MIPS block */
 	if (!h713_mips_readable(m))
 		return h713_mips_say(m, -ENXIO, "%s start: gate off or bus reset held", how);
@@ -380,6 +435,11 @@ static int h713_mips_probe(struct platform_device *pdev)
 	m->ccu = res && resource_size(res) >= 0x10 ? devm_ioremap(dev, res->start, 0x10) : NULL;
 	if (!m->ccu)
 		return dev_err_probe(dev, -ENODEV, "no MIPS clock and reset registers (reg 1)\n");
+	/* not requested either: the (disabled) tvtop node describes the block */
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 2);
+	m->tvtop = res && resource_size(res) >= 0xc ? devm_ioremap(dev, res->start, 0xc) : NULL;
+	if (!m->tvtop)
+		dev_warn(dev, "no TV top window (reg 2): no start out of the standby park\n");
 	ret = of_reserved_mem_region_to_resource(dev->of_node, 0, &win);
 	if (ret || win.start != H713_MIPS_WIN_BASE || resource_size(&win) < H713_MIPS_CFG_OFF)
 		return dev_err_probe(dev, -ENODEV, "no memory-region at 0x%x of 0x%x bytes\n",
