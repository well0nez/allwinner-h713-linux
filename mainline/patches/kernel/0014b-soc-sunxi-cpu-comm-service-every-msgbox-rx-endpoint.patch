diff -ruN a/drivers/soc/sunxi/cpu_comm/cpu_comm_hw.c b/drivers/soc/sunxi/cpu_comm/cpu_comm_hw.c
--- a/drivers/soc/sunxi/cpu_comm/cpu_comm_hw.c
+++ b/drivers/soc/sunxi/cpu_comm/cpu_comm_hw.c
@@ -168,12 +168,57 @@
 #define H713_MSGBOX_RX_IRQ_BIT	BIT(2)	/* RX IRQ bit for Port 1 */
 
 /*
- * H713 msgbox exposes three GIC SPI lines (one per user-bank). MIPS can
- * assert any of them depending on which bank it writes to. We register a
- * handler on every line the DTS provides and share one FIFO drain loop.
+ * One GIC line per register bank, in the order the device tree lists
+ * them:  index 0 = bank 0 @0x03003000 = this core's inbox = GIC_SPI 46,
+ * index 1 = bank 1 @0x03003400 = CPUS/ARISC inbox = GIC_SPI 109,
+ * index 2 = bank 2 @0x03003800 = display MIPS inbox = GIC_SPI 108.
+ *
+ * The registers of a link from sender S to receiver R live in R's bank,
+ * in the 256 byte sub-block sub(R, S) = (R < S) ? S - 1 : S: RX at
+ * +0x20/+0x24 (BIT(2 * port)), TX at +0x30/+0x34 (BIT(2 * port + 1)),
+ * FIFO at +0x60 + 4 * port, word at +0x70 + 4 * port -- the vendor's own
+ * arithmetic (sx_base 0xc07dabc8, sx_read_irq_enable 0xc07daab8,
+ * sx_write_irq_disable 0xc07daaf0). With ARM = 0, ARISC = 1, MIPS = 2
+ * that gives every address this driver has rung on hardware, so this
+ * core receives in bank 0 only.
+ *
+ * The vendor handler never asks which line called it -- sunxi_msgbox_irq
+ * (0xc07dacc0) ignores its irq argument and walks every endpoint it
+ * knows. Neither does ours: it services every RX endpoint in the table
+ * below, whichever of the three lines woke it.
  */
 #define MSGBOX_MAX_IRQS	3
 
+static const char * const msgbox_bank_desc[MSGBOX_MAX_IRQS] = {
+	"bank 0 @0x03003000, this core's inbox",
+	"bank 1 @0x03003400, CPUS/ARISC inbox",
+	"bank 2 @0x03003800, display MIPS inbox",
+};
+
+const char *cpu_comm_msgbox_bank_name(int index)
+{
+	if (index < 0 || index >= MSGBOX_MAX_IRQS)
+		return "unknown bank";
+	return msgbox_bank_desc[index];
+}
+
+/*
+ * The RX endpoints this driver owns: enable +0x20, status +0x24 (write
+ * 1 to clear), FIFO occupancy, message word (reading pops), BIT(2*port).
+ * Bank 0 sub-block 0 is the ARISC's answer FIFO and belongs to the arisc
+ * driver (h713-arisc, reg-name "msgbox-rx"), so it is not in this table.
+ */
+struct msgbox_rx_endpoint {
+	const char *what;
+	u32 irq_en, irq_stat, fifo, data, bit;
+};
+
+static const struct msgbox_rx_endpoint msgbox_rx_eps[] = {
+	{ "bank 0 sub-block 1 port 1, display MIPS -> ARM",
+	  H713_MSGBOX_RX_IRQ_EN, H713_MSGBOX_RX_IRQ_CLR,
+	  H713_MSGBOX_RX_FIFO, H713_MSGBOX_RX_DATA, H713_MSGBOX_RX_IRQ_BIT },
+};
+
 struct msgbox_irq_slot {
 	int  num;		/* Linux IRQ number (−1 if unused) */
 	bool registered;	/* request_irq succeeded for this slot */
@@ -224,20 +269,20 @@
  * der cpu_comm_cb der Firmware bei 0x8b122678 schaltet auf den ganzen
  * 32-Bit-Wert und verwirft alles ueber 3.
  */
-static int cpu_comm_msgbox_drain(int cap)
+static int cpu_comm_msgbox_drain(const struct msgbox_rx_endpoint *ep, int cap)
 {
 	u32 raw;
 	int n = 0;
 
-	while (readl(msgbox_ctrl_base + H713_MSGBOX_RX_FIFO)) {
-		raw = readl(msgbox_ctrl_base + H713_MSGBOX_RX_DATA);
+	while (readl(msgbox_ctrl_base + ep->fifo)) {
+		raw = readl(msgbox_ctrl_base + ep->data);
 
 		pr_info_ratelimited("cpu_comm: msgbox rx raw=0x%08x (%s)\n",
 				    raw, cpu_comm_msgbox_type_name(raw));
 
 		if (raw > MSG_TYPE_RETURN_ACK)
-			pr_warn_ratelimited("cpu_comm: dropping unknown msgbox word 0x%08x\n",
-					    raw);
+			pr_warn_ratelimited("cpu_comm: dropping unknown msgbox word 0x%08x on %s\n",
+					    raw, ep->what);
 		else if (msgbox_rx_callback)
 			msgbox_rx_callback(raw, H713_MSGBOX_RX_FROM_MIPS);
 
@@ -261,25 +306,33 @@
  */
 static irqreturn_t cpu_comm_msgbox_irq_handler(int irq, void *dev_id)
 {
+	int drained = 0;
+	unsigned int i;
 	u32 en;
-	int drained;
 
 	atomic_inc(&msgbox_irq_count);
 
 	if (!msgbox_ctrl_base)
 		return IRQ_NONE;
 
-	en = readl(msgbox_ctrl_base + H713_MSGBOX_RX_IRQ_EN);
-	writel(en & ~H713_MSGBOX_RX_IRQ_BIT,
-	       msgbox_ctrl_base + H713_MSGBOX_RX_IRQ_EN);
+	/*
+	 * Any of the three lines can be the one that woke us, and none of
+	 * them says which endpoint has something. Walk the endpoints this
+	 * driver owns, the way the vendor handler walks its own list.
+	 */
+	for (i = 0; i < ARRAY_SIZE(msgbox_rx_eps); i++) {
+		const struct msgbox_rx_endpoint *ep = &msgbox_rx_eps[i];
 
-	drained = cpu_comm_msgbox_drain(64);
-	atomic_add(drained, &msgbox_irq_msgs_drained);
+		en = readl(msgbox_ctrl_base + ep->irq_en);
+		writel(en & ~ep->bit, msgbox_ctrl_base + ep->irq_en);
 
-	writel(H713_MSGBOX_RX_IRQ_BIT,
-	       msgbox_ctrl_base + H713_MSGBOX_RX_IRQ_CLR);
-	writel(en | H713_MSGBOX_RX_IRQ_BIT,
-	       msgbox_ctrl_base + H713_MSGBOX_RX_IRQ_EN);
+		drained += cpu_comm_msgbox_drain(ep, 64);
+
+		writel(ep->bit, msgbox_ctrl_base + ep->irq_stat);
+		writel(en | ep->bit, msgbox_ctrl_base + ep->irq_en);
+	}
+
+	atomic_add(drained, &msgbox_irq_msgs_drained);
 
 	/*
 	 * IRQ_HANDLED nur, wenn wirklich etwas aus der FIFO kam.
@@ -314,10 +367,13 @@
  */
 static void cpu_comm_msgbox_poll_fn(struct work_struct *work)
 {
+	unsigned int i;
+
 	if (!msgbox_poll_active || !msgbox_ctrl_base)
 		return;
 
-	cpu_comm_msgbox_drain(32);
+	for (i = 0; i < ARRAY_SIZE(msgbox_rx_eps); i++)
+		cpu_comm_msgbox_drain(&msgbox_rx_eps[i], 32);
 
 	if (msgbox_poll_active)
 		schedule_delayed_work(&msgbox_poll_work, msecs_to_jiffies(1));
@@ -371,9 +427,9 @@
 	       | H713_MSGBOX_RX_IRQ_BIT,
 	       msgbox_ctrl_base + H713_MSGBOX_RX_IRQ_EN);
 
-	pr_info("cpu_comm: msgbox RX IRQ %d registered (slot %d, Port 1, BIT(2)); "
-		"enable-reg: 0x%08x\n",
-		irq, slot,
+	pr_info("cpu_comm: msgbox RX IRQ %d registered (slot %d = %s, Port 1, "
+		"BIT(2)); enable-reg: 0x%08x\n",
+		irq, slot, cpu_comm_msgbox_bank_name(slot),
 		readl(msgbox_ctrl_base + H713_MSGBOX_RX_IRQ_EN));
 	return 0;
 }
