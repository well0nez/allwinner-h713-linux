--- a/drivers/staging/media/sunxi/cedrus/cedrus_hw.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_hw.c
@@ -155,6 +155,109 @@
  * the vendor sets alongside write_sc_rt_pic.  Two outputs writing concurrently
  * is exactly when DDR consistency would matter.
  */
+#include "cedrus_scaler_coef.h"
+
+/*
+ * "VE/Top1 Level" (vendor register group 7) at VE + 0xf00: the polyphase
+ * scaler the vendor's H.265 path programs for any real downscale.  The
+ * power-of-two VE_DEC_H265_SDRT_CTRL field is NOT used in that case -- the
+ * vendor's HevcJudgeScaleMode picks mode 2 and takes this path instead.
+ *
+ * Field widths below were read out of the vendor blob and then confirmed on
+ * hardware by a write-all-ones readback: 0x10/0x18 = 3fff3fff (two 14-bit),
+ * 0x14 = ffffffff (two 16-bit), 0xf8 = 00000ffc.
+ */
+#define TOP1				0xf00
+#define TOP1_IN_SIZE			(TOP1 + 0x0c)	/* [29:16] h, [13:0] w */
+#define TOP1_OUT_SIZE			(TOP1 + 0x10)	/* [29:16] h, [13:0] w */
+#define TOP1_STEP			(TOP1 + 0x14)	/* [31:16] v, [15:0] h */
+#define TOP1_INV			(TOP1 + 0x18)	/* [29:16] v, [13:0] h */
+#define TOP1_LINE_BUF			(TOP1 + 0xe4)	/* [31:2] = addr >> 10 */
+#define TOP1_COEF_IDX			(TOP1 + 0xf8)
+#define TOP1_COEF_DATA			(TOP1 + 0xfc)
+#define TOP1_COEF_IDX_INIT		0x340
+
+/* (a << 12) / b, rounded to nearest, minus one -- exactly what the blob does. */
+static u32 cedrus_top1_ratio(u32 a, u32 b)
+{
+	if (!b)
+		return 0;
+	return (((u64)a << 12) + b / 2) / b - 1;
+}
+
+/* Filter set by downscale ratio; thresholds are the blob's, in Q12. */
+static const u16 cedrus_top1_coef_thresh[] = {
+	4608, 5120, 5632, 6144, 6656, 7168, 7680,
+	8192, 9216, 10240, 11264, 12288, 16384, 20480,
+};
+
+static unsigned int cedrus_top1_coef_set(u32 src, u32 dst)
+{
+	u32 ratio = dst ? (((u64)src << 12) + dst / 2) / dst : 4096;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(cedrus_top1_coef_thresh); i++)
+		if (ratio < cedrus_top1_coef_thresh[i])
+			return i;
+
+	return ARRAY_SIZE(cedrus_top1_coef_thresh);
+}
+
+static void cedrus_top1_configure(struct cedrus_ctx *ctx, dma_addr_t line_buf,
+				  u32 src_w, u32 src_h, u32 out_w, u32 out_h)
+{
+	struct cedrus_dev *dev = ctx->dev;
+	unsigned int v_set = cedrus_top1_coef_set(src_h, out_h);
+	unsigned int h_set = cedrus_top1_coef_set(src_w, out_w);
+	unsigned int i;
+	u32 reg;
+
+	/*
+	 * HARDWARE-CONFIRMED FIELD ORDER: the HIGH half is horizontal/width and
+	 * the LOW half is vertical/height, in all three registers.  This is the
+	 * opposite of what the vendor disassembly appeared to say; an asymmetric
+	 * scale (2x horizontal, 4x vertical) is what settles it -- a symmetric
+	 * ratio cannot distinguish the two orders in the step registers.
+	 */
+	reg = cedrus_read(dev, TOP1_IN_SIZE) & ~0x3fff3fffu;
+	reg |= (src_w & 0x3fff) << 16 | (src_h & 0x3fff);
+	cedrus_write(dev, TOP1_IN_SIZE, reg);
+
+	reg = cedrus_read(dev, TOP1_OUT_SIZE) & ~0x3fff3fffu;
+	reg |= (out_w & 0x3fff) << 16 | (out_h & 0x3fff);
+	cedrus_write(dev, TOP1_OUT_SIZE, reg);
+
+	cedrus_write(dev, TOP1_STEP,
+		     (cedrus_top1_ratio(src_w, out_w) & 0xffff) << 16 |
+		     (cedrus_top1_ratio(src_h, out_h) & 0xffff));
+
+	reg = cedrus_read(dev, TOP1_LINE_BUF) & ~0xfffffffcu;
+	reg |= ((u32)(line_buf >> 10)) << 2;
+	cedrus_write(dev, TOP1_LINE_BUF, reg);
+
+	reg = cedrus_read(dev, TOP1_INV) & ~0x3fff3fffu;
+	reg |= (cedrus_top1_ratio(out_w, src_w) & 0x3fff) << 16 |
+	       (cedrus_top1_ratio(out_h, src_h) & 0x3fff);
+	cedrus_write(dev, TOP1_INV, reg);
+
+	reg = cedrus_read(dev, TOP1_COEF_IDX) & ~0xffcu;
+	reg |= TOP1_COEF_IDX_INIT << 2;
+	cedrus_write(dev, TOP1_COEF_IDX, reg);
+
+	/*
+	 * HORIZONTAL BANK FIRST, then vertical.  Established on hardware with a
+	 * delta/blur pair: loading delta-then-blur leaves the output sharp
+	 * across and blurred down, and swapping the two mirrors it exactly.
+	 * A symmetric ratio cannot see this -- both banks hold the same set --
+	 * so it only shows up when the axes scale by different amounts.
+	 */
+	for (i = 0; i < 32; i++)
+		cedrus_write(dev, TOP1_COEF_DATA, cedrus_scaler_coef[h_set][i]);
+	for (i = 0; i < 32; i++)
+		cedrus_write(dev, TOP1_COEF_DATA, cedrus_scaler_coef[v_set][i]);
+
+}
+
 static void cedrus_sd_program_h265(struct cedrus_ctx *ctx, dma_addr_t luma,
 				   dma_addr_t chroma)
 {
@@ -174,11 +277,40 @@
 		     VE_DEC_H265_CTRL_ROTATE_SCALE_OUT_EN |
 		     VE_DEC_H265_CTRL_DDR_CONSISTENCY_EN);
 
+	/*
+	 * scale_precision stays ZERO: the vendor's mode-2 path leaves the
+	 * power-of-two shifter off and lets the VE+0xf00 polyphase scaler do
+	 * all of the scaling.  Setting both makes them fight.
+	 */
 	cedrus_write(dev, VE_DEC_H265_SDRT_CTRL,
-		     VE_DEC_H265_SDRT_CTRL_ROTATE(cedrus_rotation(ctx)) |
-		     VE_DEC_H265_SDRT_CTRL_H_SHIFT(ctx->sd_h_shift) |
-		     VE_DEC_H265_SDRT_CTRL_V_SHIFT(ctx->sd_v_shift));
+		     VE_DEC_H265_SDRT_CTRL_ROTATE(cedrus_rotation(ctx)));
 
+	/*
+	 * 10-bit: the secondary output needs its own 2-bit plane, exactly as
+	 * the primary does.  Offsets are byte offsets into the frame, and the
+	 * 2-bit stride is the luma width / 4, 32-aligned.  Layout and bit
+	 * positions come from the vendor's regHEVC_10BIT_CONFIGURE.
+	 */
+	if (ctx->bit_depth > 8) {
+		unsigned int w = ctx->dst_fmt.width, h = ctx->dst_fmt.height;
+		unsigned int two_bit = ALIGN(w / 4, 32) * h * 3 / 2;
+		u32 reg;
+
+		cedrus_write(dev, VE_DEC_H265_OFFSET_ADDR_SECOND_OUT,
+			     ctx->dst_fmt.sizeimage - two_bit);
+
+		reg = cedrus_read(dev, VE_DEC_H265_10BIT_CONFIGURE);
+		reg &= ~(GENMASK(24, 11));
+		reg |= VE_DEC_H265_10BIT_CONFIGURE_SECOND_2BIT_STRIDE(ALIGN(w / 4, 32)) |
+		       VE_DEC_H265_10BIT_CONFIGURE_SECOND_2BIT_ENABLE |
+		       VE_DEC_H265_10BIT_CONFIGURE_SECOND_OUT_FMT(VE_DEC_H265_SECOND_OUT_FMT_8BIT_PLUS_2BIT);
+		cedrus_write(dev, VE_DEC_H265_10BIT_CONFIGURE, reg);
+	}
+
+	cedrus_top1_configure(ctx, ctx->codec.h265.scaler_buf_addr,
+			      ctx->recon_fmt.width, ctx->recon_fmt.height,
+			      ALIGN(ctx->src_fmt.width, 16) >> ctx->sd_h_shift,
+			      ALIGN(ctx->src_fmt.height, 16) >> ctx->sd_v_shift);
 }
 
