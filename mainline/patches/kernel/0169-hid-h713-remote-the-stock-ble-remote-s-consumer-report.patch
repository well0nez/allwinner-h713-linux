HID: h713-remote: the stock BLE remote's consumer report carries one usage, not two

The stock remote of the HY310 and the HY300PRO-G-EU (BLE HID over GATT, 1d5a:c081) declares report 3
(consumer control) as two 16-bit usages and sends one. The HID core refuses reports shorter than their
descriptor since the hardening in hid_report_raw_event ("Event data for report 3 was too short (4 vs 3)",
-EINVAL) instead of padding them as the vendor's 5.4 kernel did, so no key of the remote reached the input
layer; only the mouse report 2 did. Measured on the HY310 03.10.2026: descriptor 176 bytes, report 3 at
offset 71. The fixup sets its report count to one.
---
diff -uNr a/drivers/hid/hid-h713-remote.c b/drivers/hid/hid-h713-remote.c
--- a/drivers/hid/hid-h713-remote.c	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/hid/hid-h713-remote.c	2026-10-03 21:05:14.735965697 +0200
@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * The stock Bluetooth LE remote of H713 projectors (HY310, HY300PRO-G-EU),
+ * HID over GATT, 1d5a:c081.
+ *
+ * Its report descriptor declares the consumer-control report 3 as an array
+ * of two 16-bit usages (0x95 0x02 0x75 0x10), but every key sends one usage.
+ * Since the HID core refuses reports shorter than their descriptor ("Event
+ * data for report 3 was too short") instead of padding them, no key reached
+ * the input layer; only the mouse report 2 did. The vendor kernel (5.4)
+ * padded. Report 3 is fixed up to one usage, which is what the remote sends.
+ */
+
+#include <linux/hid.h>
+#include <linux/module.h>
+#include <linux/string.h>
+
+#define H713_REMOTE_VENDOR	0x1d5a
+#define H713_REMOTE_PRODUCT	0xc081
+
+/* Report ID 3, usages 0..0x29c, logical 0..0x29c, count 2, size 16, Input */
+static const u8 h713_remote_report3[] = {
+	0x85, 0x03, 0x19, 0x00, 0x2a, 0x9c, 0x02, 0x15, 0x00,
+	0x26, 0x9c, 0x02, 0x95, 0x02, 0x75, 0x10, 0x81, 0x00,
+};
+#define H713_REMOTE_COUNT_OFFSET	13	/* the 0x02 after 0x95 */
+
+static const __u8 *h713_remote_report_fixup(struct hid_device *hdev, __u8 *rdesc,
+					    unsigned int *rsize)
+{
+	unsigned int i;
+
+	for (i = 0; i + sizeof(h713_remote_report3) <= *rsize; i++) {
+		if (memcmp(rdesc + i, h713_remote_report3, sizeof(h713_remote_report3)))
+			continue;
+		rdesc[i + H713_REMOTE_COUNT_OFFSET] = 0x01;
+		hid_info(hdev, "consumer report 3 fixed up to one usage (the remote sends one)\n");
+		break;
+	}
+	return rdesc;
+}
+
+static const struct hid_device_id h713_remote_devices[] = {
+	{ HID_BLUETOOTH_DEVICE(H713_REMOTE_VENDOR, H713_REMOTE_PRODUCT) },
+	{ }
+};
+MODULE_DEVICE_TABLE(hid, h713_remote_devices);
+
+static struct hid_driver h713_remote_driver = {
+	.name = "h713-remote",
+	.id_table = h713_remote_devices,
+	.report_fixup = h713_remote_report_fixup,
+};
+module_hid_driver(h713_remote_driver);
+
+MODULE_DESCRIPTION("HID descriptor fixup for the H713 projectors' stock BLE remote");
+MODULE_LICENSE("GPL");
diff -uNr a/drivers/hid/Kconfig b/drivers/hid/Kconfig
--- a/drivers/hid/Kconfig	2026-10-03 21:05:14.734185416 +0200
+++ b/drivers/hid/Kconfig	2026-10-03 21:05:14.746530836 +0200
@@ -452,6 +452,15 @@
 	help
 	  Support for Goodix GT7986U SPI HID touchscreen device.
 
+config HID_H713_REMOTE
+	tristate "H713 projectors' stock BLE remote"
+	depends on HID
+	help
+	  Report descriptor fixup for the stock Bluetooth LE remote of
+	  Allwinner H713 projectors (1d5a:c081): its consumer-control report
+	  declares two usages but carries one, so the HID core would drop
+	  every key.
+
 config HID_GOOGLE_HAMMER
 	tristate "Google Hammer Keyboard"
 	select HID_VIVALDI_COMMON
diff -uNr a/drivers/hid/Makefile b/drivers/hid/Makefile
--- a/drivers/hid/Makefile	2026-10-03 21:05:14.734230339 +0200
+++ b/drivers/hid/Makefile	2026-10-03 21:05:14.746751186 +0200
@@ -58,6 +58,7 @@
