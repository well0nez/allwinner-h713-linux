+ *
+ * It deliberately differs from the record this driver used to write for
+ * Cedrus in four words: the HDR metadata pointers at +0x64/+0x68 stay NULL
+ * and +0x48..+0x54 and +0x8c stay zero. Those words only matter to the AFBD;
+ * the record has a second reader here. The MIPS firmware follows the pointer
+ * in AFBD +0x098 (GetFrameInfo), validates the magic and rebuilds NR, PROC
+ * and the capture node from it (ConvertFrameInfo2SignalInfo), so anything the
+ * firmware was not measured against is left at zero.
+ */
+static void h713_afbd_build_video_info(u32 *rec, unsigned int w,
+				       unsigned int h, unsigned int stride)
+{
+	memset(rec, 0, H713_VIDEO_INFO_WORDS * sizeof(*rec));
 
