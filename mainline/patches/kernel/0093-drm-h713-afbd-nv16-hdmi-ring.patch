+ * rounds the height up to a whole block row, BLOCK_M1 counts the whole block
+ * rows only -- 1080 is not a multiple of 16, and the firmware truncates there.
+ */
+static u32 h713_video_size_m1(unsigned int w, unsigned int h)
+{
+	return ((ALIGN(h, H713_VIDEO_BLOCK) - 1) << 16) | (w - 1);
