@@ -0,0 +1,129 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Capture-ring flip notifier of the H713 display engine.
+ *
+ * The MIPS co-processor captures HDMI into a ring of slots and rotates a pair
+ * of pointers at AFBD +0x320/+0x324 through them. A change of that pair is the
+ * hardware saying "this slot is finished", and it is the only capture event
+ * the ARM can observe at all: three independent searches of the firmware image
+ * found the frame-done interrupt inside the MIPS interrupt controller only,
+ * and the stock device tree wires no capture interrupt to the ARM (doku/84, RE
+ * question K2).
+ *
+ * The pair lives inside the register window of display@5600000, which
+ * sun50i-h713-afbd owns, clocks, and already reads on every vsync (GIC 142)
+ * for its own passthrough plane. A second driver mapping the same two words
+ * would be a second owner of one register pair -- and it does not even work,
+ * because the region is claimed and devm_ioremap_resource() on it returns
+ * -EBUSY. So the display driver hands the pair out instead: the read, with the
+ * torn-pair handling that belongs to it, stays in one place, and a consumer
+ * gets the event phase-correct on the vsync interrupt that is serviced anyway.
+ *
+ * This header sits next to h713-cpu-comm.h and h713-arisc.h because that is
+ * where this SoC's cross-driver interfaces are collected. That the producer
+ * happens to be a DRM driver is an accident of the hardware: the same block
+ * does scanout.
+ */
+
+#ifndef __LINUX_SOC_SUNXI_H713_AFBD_H
+#define __LINUX_SOC_SUNXI_H713_AFBD_H
+
+#include <linux/errno.h>
+#include <linux/types.h>
+
+struct notifier_block;
+
+/* The only event on the chain today: a capture slot has been finished. */
+#define H713_AFBD_EVENT_FLIP		1
+
+/**
+ * struct h713_afbd_flip - the capture ring flip pointers, sampled at one vsync
+ * @y: AFBD +0x320, physical address of the luma slot the capture just finished
+ * @c: AFBD +0x324, physical address of the matching chroma slot
+ *
+ * The pair names the finished slot by its address, which is why there is no
+ * index in here: the slot table is measured knowledge of the capture, not of
+ * the display, and the display driver knows only the bounds of the reserved
+ * region the ring lives in. Y and C always name the same index.
+ *
+ * Both words are guaranteed to belong to the same sample: the producer reads Y
+ * twice around C and discards the sample if Y moved, so a consumer never sees
+ * a Y from one slot with a C from the next.
+ */
+struct h713_afbd_flip {
+	u32 y;
+	u32 c;
+};
+
+#if IS_ENABLED(CONFIG_DRM_SUN50I_H713_AFBD)
+
+/**
+ * h713_afbd_register_flip_notifier() - be told when a capture slot is finished
+ * @nb: notifier block; its handler is called with action
+ *	%H713_AFBD_EVENT_FLIP and a pointer to a struct h713_afbd_flip
+ *
+ * The handler runs in hard interrupt context, on the display's vsync
+ * interrupt, and it must behave accordingly: it must not sleep, it must not
+ * call back into this interface, and it must be short -- everything it does
+ * delays the next scanout commit. The payload is on the interrupt stack and is
+ * not valid after the handler returns.
+ *
+ * The handler is called only when the pointer pair actually changed, so a
+ * consumer needs no "has it moved" test of its own. While at least one
+ * notifier is registered the display keeps the vsync interrupt unmasked; with
+ * none registered and the plane not following the ring, the vsync handler does
+ * not so much as read the register pair.
+ *
+ * May sleep; call from process context.
+ *
+ * Return: 0 on success, -EPROBE_DEFER if the display device has not bound yet,
+ * -ENODEV if the display driver is not in this kernel at all.
+ */
+int h713_afbd_register_flip_notifier(struct notifier_block *nb);
+
+/**
+ * h713_afbd_unregister_flip_notifier() - stop being told
+ * @nb: the notifier block that was registered
+ *
+ * Waits for a handler that is currently running to return, so no event can
+ * arrive after this has returned. May sleep; call from process context.
+ *
+ * Return: 0 on success, -ENOENT if @nb was not registered.
+ */
+int h713_afbd_unregister_flip_notifier(struct notifier_block *nb);
+
+/**
+ * h713_afbd_read_flip() - read the flip pointer pair right now
+ * @flip: filled in on success
+ *
+ * For the questions that cannot wait for a vsync -- "is a signal present at
+ * all", "what does the ring look like at this instant". Ordinary frame
+ * delivery uses the notifier; this is the poll for everything else, and it
+ * exists so that no second driver has to map the register pair for it.
+ *
+ * Return: 0 and the pair, -EAGAIN if the pair could not be sampled cleanly or
+ * does not point into the capture ring, -EPROBE_DEFER if the display device
+ * has not bound yet, -ENODEV if the display driver is not in this kernel.
+ */
+int h713_afbd_read_flip(struct h713_afbd_flip *flip);
+
+#else /* !CONFIG_DRM_SUN50I_H713_AFBD */
+
+static inline int h713_afbd_register_flip_notifier(struct notifier_block *nb)
+{
+	return -ENODEV;
+}
+
+static inline int h713_afbd_unregister_flip_notifier(struct notifier_block *nb)
+{
+	return -ENODEV;
+}
+
+static inline int h713_afbd_read_flip(struct h713_afbd_flip *flip)
+{
+	return -ENODEV;
+}
+
+#endif /* CONFIG_DRM_SUN50I_H713_AFBD */
+
+#endif /* __LINUX_SOC_SUNXI_H713_AFBD_H */
