+static unsigned int cedrus_vp9_sb64(unsigned int pixels)
+{
+	return DIV_ROUND_UP(pixels, 64);
+}
+
+/* vendor: ((mi + 15) >> 3) superblocks a side, 640 B each, plus 0x4400 */
+static size_t cedrus_vp9_mv_size(unsigned int width, unsigned int height)
+{
+	unsigned int cols = (DIV_ROUND_UP(width, 8) + 15) >> 3;
+	unsigned int rows = (DIV_ROUND_UP(height, 8) + 15) >> 3;
+
+	return ALIGN(cols * rows * 640 + 0x4400, SZ_1K);
+}
+
+static enum cedrus_irq_status cedrus_vp9_irq_status(struct cedrus_ctx *ctx)
+{
+	struct cedrus_vp9_ctx *vp9 = ctx->codec.vp9.priv;
+	u32 reg = cedrus_read(ctx->dev, VE_DEC_H265_STATUS);
+
+	reg &= VE_DEC_H265_STATUS_CHECK_MASK;
+	vp9->ok = !(reg & VE_DEC_H265_STATUS_CHECK_ERROR) &&
+		  (reg & VE_DEC_H265_STATUS_SUCCESS);
+
+	return vp9->ok ? CEDRUS_IRQ_OK : CEDRUS_IRQ_ERROR;
+}
+
+static void cedrus_vp9_irq_clear(struct cedrus_ctx *ctx)
+{
+	cedrus_write(ctx->dev, VE_DEC_H265_STATUS,
+		     VE_DEC_H265_STATUS_CHECK_MASK);
+}
+
+static void cedrus_vp9_irq_disable(struct cedrus_ctx *ctx)
+{
+	struct cedrus_dev *dev = ctx->dev;
+	u32 reg = cedrus_read(dev, VE_DEC_H265_CTRL);
+
+	cedrus_write(dev, VE_DEC_H265_CTRL, reg & ~VE_DEC_H265_CTRL_IRQ_MASK);
+}
