+static void cedrus_vp9_counts_from_hw(struct cedrus_vp9_ctx *vp9)
+{
+	const struct cedrus_vp9_hw_counts *hw =
+		(void *)(vp9->prob_buf + CEDRUS_VP9_COUNTS);
+	struct cedrus_vp9_counts *c = &vp9->counts;
+	struct v4l2_vp9_frame_symbol_counts *s = &vp9->symbols;
+	unsigned int i, j, k, l, m;
+
+	memcpy(c->partition, hw->partition, sizeof(c->partition));
+	memcpy(c->skip, hw->skip, sizeof(c->skip));
+	memcpy(c->intra_inter, hw->intra_inter, sizeof(c->intra_inter));
+	memcpy(c->tx32p, hw->tx32p, sizeof(c->tx32p));
+	memset(c->tx16p, 0, sizeof(c->tx16p));
+	for (i = 0; i < 2; i++)
+		memcpy(c->tx16p[i], hw->tx16p[i], sizeof(hw->tx16p[i]));
+	memcpy(c->tx8p, hw->tx8p, sizeof(c->tx8p));
+	memcpy(c->y_mode, hw->y_mode, sizeof(c->y_mode));
+	memcpy(c->uv_mode, hw->uv_mode, sizeof(c->uv_mode));
+	memcpy(c->comp, hw->comp_inter, sizeof(c->comp));
+	memcpy(c->comp_ref, hw->comp_ref, sizeof(c->comp_ref));
+	memcpy(c->single_ref, hw->single_ref, sizeof(c->single_ref));
+	memcpy(c->mv_mode, hw->inter_mode, sizeof(c->mv_mode));
+	memcpy(c->filter, hw->interp, sizeof(c->filter));
+	memcpy(c->mv_joint, hw->joints, sizeof(c->mv_joint));
+
+	for (i = 0; i < 2; i++) {
+		/* the hardware stores component 1 first */
+		const struct cedrus_vp9_hw_mv_counts *mv = &hw->comp[1 - i];
+
+		memcpy(c->sign[i], mv->sign, sizeof(mv->sign));
+		memcpy(c->classes[i], mv->classes, sizeof(mv->classes));
+		memcpy(c->class0[i], mv->class0, sizeof(mv->class0));
+		memcpy(c->bits[i], mv->bits, sizeof(mv->bits));
+		memcpy(c->class0_fp[i], mv->class0_fp,
+			      sizeof(mv->class0_fp));
+		memcpy(c->fp[i], mv->fp, sizeof(mv->fp));
+		memcpy(c->class0_hp[i], mv->class0_hp,
+			      sizeof(mv->class0_hp));
+		memcpy(c->hp[i], mv->hp, sizeof(mv->hp));
+	}
+
+	s->partition = &c->partition;
+	s->skip = &c->skip;
+	s->intra_inter = &c->intra_inter;
+	s->tx32p = &c->tx32p;
+	s->tx16p = &c->tx16p;
+	s->tx8p = &c->tx8p;
+	s->y_mode = &c->y_mode;
+	s->uv_mode = &c->uv_mode;
+	s->comp = &c->comp;
+	s->comp_ref = &c->comp_ref;
+	s->single_ref = &c->single_ref;
+	s->mv_mode = &c->mv_mode;
+	s->filter = &c->filter;
+	s->mv_joint = &c->mv_joint;
+	s->sign = &c->sign;
+	s->classes = &c->classes;
+	s->class0 = &c->class0;
+	s->bits = &c->bits;
+	s->class0_fp = &c->class0_fp;
+	s->fp = &c->fp;
+	s->class0_hp = &c->class0_hp;
+	s->hp = &c->hp;
+
+	/*
+	 * Coefficient counts are read in place. The buffer is coherent and is
+	 * not rebuilt until after adaptation. eob[..][0] is the eob-branch
+	 * total and eob[..][1] the EOB-model count, entry 3 of the node counts.
+	 */
+	for (i = 0; i < 4; i++)
+		for (j = 0; j < 2; j++)
+			for (k = 0; k < 2; k++)
+				for (l = 0; l < 6; l++)
+					for (m = 0; m < 6; m++) {
+						u32 *coef = (u32 *)hw->coef[i][j][k][l][m];
+
+						s->coeff[i][j][k][l][m] = (u32 (*)[3])coef;
+						s->eob[i][j][k][l][m][0] =
+							(u32 *)&hw->eob[i][j][k][l][m];
+						s->eob[i][j][k][l][m][1] = &coef[3];
+					}
+}
+
+static void copy_tx_and_skip(struct v4l2_vp9_frame_context *dst,
+			     const struct v4l2_vp9_frame_context *src)
+{
+	memcpy(dst->tx8, src->tx8, sizeof(src->tx8));
+	memcpy(dst->tx16, src->tx16, sizeof(src->tx16));
+	memcpy(dst->tx32, src->tx32, sizeof(src->tx32));
+	memcpy(dst->skip, src->skip, sizeof(src->skip));
+}
+
+/*
+ * 6.1.2 refresh_probs() for the frame that just left the engine, as rkvdec
+ * does it in its done hook.
+ */
+static void cedrus_vp9_finish(struct cedrus_ctx *ctx)
+{
+	struct cedrus_vp9_ctx *vp9 = ctx->codec.vp9.priv;
+	struct cedrus_vp9_frame_info *cur = &vp9->cur;
+	struct v4l2_vp9_frame_context *probs = &vp9->probs;
+	unsigned int fctx_idx = cur->frame_context_idx;
+
+	if (!vp9->pending)
+		return;
+	vp9->pending = false;
+
+	if (!vp9->ok) {
+		/* nothing it produced -- counts, MVs, segment ids -- is trusted */
+		vp9->last_valid = false;
+		return;
+	}
+
+	if (cur->segmentation)
+		memcpy(vp9->seg_map, vp9->prob_buf + CEDRUS_VP9_SEG_MAP,
+			      vp9->seg_map_size);
+
+	if (!(cur->flags & V4L2_VP9_FRAME_FLAG_REFRESH_FRAME_CTX))
+		goto out_update_last;
+
+	if (!(cur->flags & V4L2_VP9_FRAME_FLAG_PARALLEL_DEC_MODE)) {
+		bool frame_is_intra = cur->flags &
+			(V4L2_VP9_FRAME_FLAG_KEY_FRAME |
+			 V4L2_VP9_FRAME_FLAG_INTRA_ONLY);
+		struct v4l2_vp9_frame_context tx_skip;
+
+		cedrus_vp9_counts_from_hw(vp9);
+
+		if (frame_is_intra)
+			copy_tx_and_skip(&tx_skip, probs);
+		*probs = vp9->frame_context[fctx_idx];
+		if (frame_is_intra)
+			copy_tx_and_skip(probs, &tx_skip);
+
+		v4l2_vp9_adapt_coef_probs(probs, &vp9->symbols,
+					  !vp9->last_valid ||
+					  vp9->last.flags & V4L2_VP9_FRAME_FLAG_KEY_FRAME,
+					  frame_is_intra);
+		if (!frame_is_intra)
+			v4l2_vp9_adapt_noncoef_probs(probs, &vp9->symbols,
+						     cur->reference_mode,
+						     cur->interpolation_filter,
+						     cur->tx_mode, cur->flags);
+	}
+
+	vp9->frame_context[fctx_idx] = *probs;
+
+out_update_last:
+	vp9->last = *cur;
+	vp9->last_valid = true;
+}
+
+static void cedrus_vp9_write_probs(u8 *p, const struct v4l2_vp9_frame_context *fc,
+				   const struct v4l2_vp9_segmentation *seg)
+{
+	unsigned int i, j, k, l, m;
+
+	for (i = 0; i < 2; i++) {
+		p[P_TX8 + i] = fc->tx8[i][0];
+		for (j = 0; j < 2; j++)
+			p[P_TX16 + 4 * i + j] = fc->tx16[i][j];
+		for (j = 0; j < 3; j++)
+			p[P_TX32 + 4 * i + j] = fc->tx32[i][j];
+	}
+
+	for (i = 0; i < 4; i++)
+		for (j = 0; j < 2; j++)
+			for (k = 0; k < 2; k++)
+				for (l = 0; l < 6; l++)
+					for (m = 0; m < 6; m++)
+						memcpy(&p[P_COEF + i * 576 + j * 288 +
+							  k * 144 + l * 24 + m * 4],
+						       fc->coef[i][j][k][l][m], 3);
+
+	memcpy(&p[P_SKIP], fc->skip, 3);
+	for (i = 0; i < 7; i++)
+		memcpy(&p[P_INTER_MODE + 4 * i], fc->inter_mode[i], 3);
+	for (i = 0; i < 4; i++)
+		memcpy(&p[P_INTERP + 4 * i], fc->interp_filter[i], 2);
+	memcpy(&p[P_IS_INTER], fc->is_inter, 4);
+	memcpy(&p[P_COMP_MODE], fc->comp_mode, 5);
+	memcpy(&p[P_COMP_REF], fc->comp_ref, 5);
+	for (i = 0; i < 5; i++)
+		memcpy(&p[P_SINGLE_REF + 4 * i], fc->single_ref[i], 2);
+	for (i = 0; i < 4; i++)
+		memcpy(&p[P_Y_MODE + 16 * i], fc->y_mode[i], 9);
+	for (i = 0; i < 10; i++)
+		memcpy(&p[P_UV_MODE + 16 * i], fc->uv_mode[i], 9);
+	for (i = 0; i < 16; i++)
+		memcpy(&p[P_PARTITION + 4 * i], fc->partition[i], 3);
+
+	memcpy(&p[P_MV_JOINT], fc->mv.joint, 3);
+	for (i = 0; i < 2; i++) {
+		u8 *c = &p[P_MV_COMP(i)];
+
+		c[0] = fc->mv.sign[i];
+		c[1] = fc->mv.class0_bit[i];
+		c[2] = fc->mv.class0_hp[i];
+		c[3] = fc->mv.hp[i];
+		for (j = 0; j < 2; j++)
+			memcpy(&c[4 + 4 * j], fc->mv.class0_fr[i][j], 3);
+		memcpy(&c[0x0c], fc->mv.classes[i], 10);
+		memcpy(&c[0x1c], fc->mv.bits[i], 10);
+		memcpy(&c[0x28], fc->mv.fr[i], 3);
+	}
+
+	memcpy(&p[P_SEG_TREE], seg->tree_probs, 7);
+	memcpy(&p[P_SEG_PRED], seg->pred_probs, 3);
+}
+
+/* libvpx get_tile_offset(): a tile edge, in 8x8 units */
+static unsigned int cedrus_vp9_tile_offset(unsigned int idx, unsigned int mis,
+					   unsigned int log2)
+{
+	unsigned int sbs = (mis + 7) >> 3;
+	unsigned int offset = ((idx * sbs) >> log2) << 3;
+
+	return min(offset, mis);
+}
+
+static void cedrus_vp9_tile_regs(unsigned int mi_rows, unsigned int mi_cols,
+				 unsigned int log2_rows, unsigned int log2_cols,
+				 unsigned int row, unsigned int col,
+				 u32 *start, u32 *end)
+{
+	unsigned int r0 = cedrus_vp9_tile_offset(row, mi_rows, log2_rows);
+	unsigned int r1 = cedrus_vp9_tile_offset(row + 1, mi_rows, log2_rows);
+	unsigned int c0 = cedrus_vp9_tile_offset(col, mi_cols, log2_cols);
+	unsigned int c1 = cedrus_vp9_tile_offset(col + 1, mi_cols, log2_cols);
+
+	*start = (c0 >> 3) | (r0 >> 3) << 16;
+	if (r0 == r1 || c0 == c1)
+		*start |= BIT(31);	/* empty tile */
+	*end = ((c1 - 1) >> 3) | ((r1 - 1) >> 3) << 16;
+}
+
+static int cedrus_vp9_lf_level(const struct v4l2_ctrl_vp9_frame *f,
+			       unsigned int seg, unsigned int ref,
+			       unsigned int mode)
+{
+	const struct v4l2_vp9_loop_filter *lf = &f->lf;
+	int lvl = lf->level;
+	int shift;
+
+	if ((f->seg.flags & V4L2_VP9_SEGMENTATION_FLAG_ENABLED) &&
+	    (f->seg.feature_enabled[seg] &
+	     V4L2_VP9_SEGMENT_FEATURE_ENABLED(V4L2_VP9_SEG_LVL_ALT_L))) {
+		int data = f->seg.feature_data[seg][V4L2_VP9_SEG_LVL_ALT_L];
+
+		lvl = (f->seg.flags & V4L2_VP9_SEGMENTATION_FLAG_ABS_OR_DELTA_UPDATE) ?
+		      data : lvl + data;
+		lvl = clamp(lvl, 0, 63);
+	}
+
+	if (!(lf->flags & V4L2_VP9_LOOP_FILTER_FLAG_DELTA_ENABLED))
+		return lvl;
+
+	shift = lvl >> 5;
+	lvl += lf->ref_deltas[ref] * (1 << shift);
+	if (ref)
+		lvl += lf->mode_deltas[mode] * (1 << shift);
+
+	return clamp(lvl, 0, 63);
+}
+
+static void cedrus_vp9_sram(struct cedrus_ctx *ctx,
+			    const struct v4l2_ctrl_vp9_frame *f)
+{
+	struct cedrus_dev *dev = ctx->dev;
+	const struct v4l2_vp9_quantization *q = &f->quant;
+	bool seg_on = f->seg.flags & V4L2_VP9_SEGMENTATION_FLAG_ENABLED;
+	u32 y[8], uv[8];
+	unsigned int s;
+
+	for (s = 0; s < 8; s++) {
+		int qi = q->base_q_idx;
+
+		if (seg_on && (f->seg.feature_enabled[s] &
+			       V4L2_VP9_SEGMENT_FEATURE_ENABLED(V4L2_VP9_SEG_LVL_ALT_Q))) {
+			int data = f->seg.feature_data[s][V4L2_VP9_SEG_LVL_ALT_Q];
+
+			qi = (f->seg.flags &
+			      V4L2_VP9_SEGMENTATION_FLAG_ABS_OR_DELTA_UPDATE) ?
+			     data : qi + data;
+		}
+		qi = clamp(qi, 0, 255);
+
+		y[s] = dc_qlookup[clamp(qi + q->delta_q_y_dc, 0, 255)] |
+		       ac_qlookup[qi] << 16;
+		uv[s] = dc_qlookup[clamp(qi + q->delta_q_uv_dc, 0, 255)] |
+			ac_qlookup[clamp(qi + q->delta_q_uv_ac, 0, 255)] << 16;
+	}
+
+	cedrus_write(dev, VE_DEC_H265_SRAM_OFFSET, VE_DEC_VP9_SRAM_DEQUANT);
+	for (s = 0; s < 8; s++)
+		cedrus_write(dev, VE_DEC_H265_SRAM_DATA, y[s]);
+	for (s = 0; s < 8; s++)
+		cedrus_write(dev, VE_DEC_H265_SRAM_DATA, uv[s]);
+
+	cedrus_write(dev, VE_DEC_H265_SRAM_OFFSET, VE_DEC_VP9_SRAM_LF);
+	for (s = 0; s < 8; s++) {
+		/* intra mode 1 is never used and its byte stays zero */
+		cedrus_write(dev, VE_DEC_H265_SRAM_DATA,
+			     cedrus_vp9_lf_level(f, s, 0, 0) |
+			     cedrus_vp9_lf_level(f, s, 1, 0) << 16 |
+			     cedrus_vp9_lf_level(f, s, 1, 1) << 24);
+		cedrus_write(dev, VE_DEC_H265_SRAM_DATA,
+			     cedrus_vp9_lf_level(f, s, 2, 0) |
+			     cedrus_vp9_lf_level(f, s, 2, 1) << 8 |
+			     cedrus_vp9_lf_level(f, s, 3, 0) << 16 |
+			     cedrus_vp9_lf_level(f, s, 3, 1) << 24);
+	}
+}
+
+static u32 cedrus_vp9_scale(unsigned int ref, unsigned int cur)
+{
+	u32 fp = 1 << 14;
+
+	/* vp9_setup_scale_factors_for_frame(): invalid ratios read as 1:1 */
+	if (2 * cur >= ref && cur <= 16 * ref)
+		fp = (ref << 14) / cur;
+
+	return (fp & 0xffff) << 5 | (((fp >> 10) - 1) & 0x1f);
+}
+
+static int cedrus_vp9_setup(struct cedrus_ctx *ctx, struct cedrus_run *run)
+{
+	struct cedrus_vp9_ctx *vp9 = ctx->codec.vp9.priv;
+	const struct v4l2_ctrl_vp9_frame *f = run->vp9.frame;
+	const struct v4l2_ctrl_vp9_compressed_hdr *hdr = run->vp9.compressed_hdr;
+	struct cedrus_dev *dev = ctx->dev;
+	struct vb2_queue *cap_q;
+	struct cedrus_buffer *dst_cbuf = vb2_v4l2_to_cedrus_buffer(run->dst);
+	unsigned int width = f->frame_width_minus_1 + 1;
+	unsigned int height = f->frame_height_minus_1 + 1;
+	unsigned int mi_cols = DIV_ROUND_UP(width, 8);
+	unsigned int mi_rows = DIV_ROUND_UP(height, 8);
+	unsigned int log2c = f->tile_cols_log2, log2r = f->tile_rows_log2;
+	bool intra = f->flags & (V4L2_VP9_FRAME_FLAG_KEY_FRAME |
+				 V4L2_VP9_FRAME_FLAG_INTRA_ONLY);
+	bool seg_on = f->seg.flags & V4L2_VP9_SEGMENTATION_FLAG_ENABLED;
+	bool lossless, prev_mvs;
+	dma_addr_t src_addr;
+	unsigned int hdr_bytes, payload, fctx_idx, r, c, i;
+	u32 reg, *tile;
+
+	if (f->bit_depth != 8 || f->profile != 0 ||
+	    !(f->flags & V4L2_VP9_FRAME_FLAG_X_SUBSAMPLING) ||
+	    !(f->flags & V4L2_VP9_FRAME_FLAG_Y_SUBSAMPLING))
+		return -EINVAL;
+	if (width > ctx->src_fmt.width || height > ctx->src_fmt.height)
+		return -EINVAL;
+	if (cedrus_vp9_sb64(width) * cedrus_vp9_sb64(height) * 32 >
+	    CEDRUS_VP9_SEG_MAP_MAX)
+		return -EINVAL;
+
+	/* The previous frame is off the engine: adapt and save its context. */
+	cedrus_vp9_finish(ctx);
+
+	/*
+	 * An inter frame of a different size from the frame before it predicts
+	 * from scaled references, which this engine is not programmed for:
+	 * run anyway, it reads past its reference buffers (IOMMU faults, then
+	 * the watchdog). Refuse the frame; the next key frame recovers.
+	 */
+	if (!intra && (!vp9->last_valid || width != vp9->last.width ||
+		       height != vp9->last.height))
+		return -EINVAL;
+
+	cap_q = v4l2_m2m_get_vq(ctx->fh.m2m_ctx, V4L2_BUF_TYPE_VIDEO_CAPTURE);
+
+	/* 6.1 frame(): the parts of uncompressed_header() userspace left us */
+	fctx_idx = v4l2_vp9_reset_frame_ctx(f, vp9->frame_context);
+	vp9->probs = vp9->frame_context[fctx_idx];
+	v4l2_vp9_fw_update_probs(&vp9->probs, hdr, f);
+
+	lossless = !f->quant.base_q_idx && !f->quant.delta_q_y_dc &&
+		   !f->quant.delta_q_uv_dc && !f->quant.delta_q_uv_ac;
+
+	/* libvpx use_prev_frame_mvs */
+	prev_mvs = vp9->last_valid &&
+		   !(f->flags & V4L2_VP9_FRAME_FLAG_ERROR_RESILIENT) &&
+		   width == vp9->last.width && height == vp9->last.height &&
+		   !(vp9->last.flags & V4L2_VP9_FRAME_FLAG_INTRA_ONLY) &&
+		   (vp9->last.flags & V4L2_VP9_FRAME_FLAG_SHOW_FRAME);
+
+	/*
+	 * The engine writes no motion vectors for an intra frame, so after a
+	 * mid-stream key frame the buffer still holds the frame before it --
+	 * and the next frame, which may use them, predicts from stale vectors
+	 * (measured: bit-exact up to the second key frame, drifting after).
+	 * Zero reads as intra, which is what the stream's first frame gets.
+	 */
+	if (intra)
+		memset(vp9->mv_buf, 0, vp9->mv_size);
+
+	/* The segment map starts over wherever the spec resets the past. */
+	vp9->seg_map_size = cedrus_vp9_sb64(width) * cedrus_vp9_sb64(height) * 32;
+	if (intra || (f->flags & V4L2_VP9_FRAME_FLAG_ERROR_RESILIENT) ||
+	    width != vp9->last.width || height != vp9->last.height)
+		memset(vp9->seg_map, 0, CEDRUS_VP9_SEG_MAP_MAX);
+
+	/* The buffer: tile table, probabilities, zeroed counts, segment map. */
+	memset(vp9->prob_buf, 0, CEDRUS_VP9_SEG_MAP);
+	tile = (u32 *)vp9->prob_buf;
+	for (r = 0; r < (1u << log2r); r++)
+		for (c = 0; c < (1u << log2c); c++) {
+			u32 start, end;
+
+			if (!r && !c)
+				continue;
+			cedrus_vp9_tile_regs(mi_rows, mi_cols, log2r, log2c,
+					     r, c, &start, &end);
+			tile[2] = start;
+			tile[3] = end;
+			tile += 4;
+		}
+	cedrus_vp9_write_probs(vp9->prob_buf + CEDRUS_VP9_PROBS, &vp9->probs,
+			       &f->seg);
+	if (seg_on)
+		memcpy(vp9->prob_buf + CEDRUS_VP9_SEG_MAP, vp9->seg_map,
+		       vp9->seg_map_size);
+	else
+		memset(vp9->prob_buf + CEDRUS_VP9_SEG_MAP, 0, vp9->seg_map_size);
+
+	/* What the finish of this frame needs to know about it. */
+	vp9->cur = (struct cedrus_vp9_frame_info) {
+		.flags = f->flags,
+		.width = width,
+		.height = height,
+		.frame_context_idx = fctx_idx,
+		.reference_mode = f->reference_mode,
+		.interpolation_filter = f->interpolation_filter,
+		.tx_mode = hdr->tx_mode,
+		.segmentation = seg_on,
+	};
+	dst_cbuf->codec.vp9.width = width;
+	dst_cbuf->codec.vp9.height = height;
+
+	cedrus_engine_enable(ctx);
+
+	/* frame header */
+	reg = VE_DEC_VP9_HDR_ALWAYS |
+	      VE_DEC_VP9_HDR_BIT_DEPTH(f->bit_depth) |
+	      VE_DEC_VP9_HDR_INTERP(f->interpolation_filter) |
+	      VE_DEC_VP9_HDR_SHARPNESS(f->lf.sharpness) |
+	      VE_DEC_VP9_HDR_TX_MODE(hdr->tx_mode) |
+	      VE_DEC_VP9_HDR_REF_MODE(f->reference_mode);
+	if ((1 << log2c << log2r) > 1)
+		reg |= VE_DEC_VP9_HDR_MULTI_TILE;
+	if (!intra)
+		reg |= VE_DEC_VP9_HDR_INTER;
+	/* V4L2_VP9_SIGN_BIAS_LAST/GOLDEN/ALT are bits 0..2 */
+	for (i = 1; i <= 3; i++)
+		if (f->ref_frame_sign_bias & BIT(i - 1))
+			reg |= VE_DEC_VP9_HDR_SIGN_BIAS(i);
+	if (f->flags & V4L2_VP9_FRAME_FLAG_ALLOW_HIGH_PREC_MV)
+		reg |= VE_DEC_VP9_HDR_ALLOW_HP;
+	if (f->lf.level && (f->lf.flags & V4L2_VP9_LOOP_FILTER_FLAG_DELTA_ENABLED))
+		reg |= VE_DEC_VP9_HDR_LF_DELTA;
+	if (lossless)
+		reg |= VE_DEC_VP9_HDR_LOSSLESS;
+	if (seg_on)
+		reg |= VE_DEC_VP9_HDR_SEG_ENABLED;
+	if (f->seg.flags & V4L2_VP9_SEGMENTATION_FLAG_UPDATE_MAP)
+		reg |= VE_DEC_VP9_HDR_SEG_UPDATE_MAP;
+	if (f->seg.flags & V4L2_VP9_SEGMENTATION_FLAG_TEMPORAL_UPDATE)
+		reg |= VE_DEC_VP9_HDR_SEG_TEMPORAL;
+	if (prev_mvs)
+		reg |= VE_DEC_VP9_HDR_PREV_MVS;
+	if (!(f->flags & (V4L2_VP9_FRAME_FLAG_ERROR_RESILIENT |
+			  V4L2_VP9_FRAME_FLAG_PARALLEL_DEC_MODE)))
+		reg |= VE_DEC_VP9_HDR_COUNT;
+	cedrus_write(dev, VE_DEC_VP9_HDR, reg);
+
+	cedrus_write(dev, VE_DEC_VP9_PIC_SIZE,
+		     VE_DEC_H265_DEC_PIC_SIZE_WIDTH(width) |
+		     VE_DEC_H265_DEC_PIC_SIZE_HEIGHT(height));
+
+	/* references */
+	if (intra) {
+		cedrus_write(dev, VE_DEC_VP9_REF_SCALE1(0),
+			     VE_DEC_VP9_LAST_SCALE1_ALIGN);
+	} else {
+		const u64 ts[3] = { f->last_frame_ts, f->golden_frame_ts,
+				    f->alt_frame_ts };
+
+		for (i = 0; i < 3; i++) {
+			struct vb2_buffer *ref = vb2_find_buffer(cap_q, ts[i]);
+			unsigned int rw = width, rh = height;
+			u32 scale1;
+
+			if (ref) {
+				struct cedrus_buffer *rb = vb2_to_cedrus_buffer(ref);
+
+				rw = rb->codec.vp9.width ?: width;
+				rh = rb->codec.vp9.height ?: height;
+			} else {
+				/* a missing reference predicts from this frame */
+				ref = &run->dst->vb2_buf;
+			}
+
+			cedrus_write(dev, cedrus_vp9_ref_luma[i],
+				     VE_DEC_VP9_ADDR(cedrus_dst_buf_addr(ctx, ref, 0)));
+			cedrus_write(dev, cedrus_vp9_ref_chroma[i],
+				     VE_DEC_VP9_ADDR(cedrus_dst_buf_addr(ctx, ref, 1)));
+			cedrus_write(dev, VE_DEC_VP9_REF_SIZE(i),
+				     VE_DEC_H265_DEC_PIC_SIZE_WIDTH(rw) |
+				     VE_DEC_H265_DEC_PIC_SIZE_HEIGHT(rh));
+			cedrus_write(dev, VE_DEC_VP9_REF_SCALE0(i),
+				     cedrus_vp9_scale(rw, width));
+			scale1 = cedrus_vp9_scale(rh, height);
+			if (!i)
+				scale1 |= VE_DEC_VP9_LAST_SCALE1_ALIGN;
+			/*
+			 * Golden's y scale is at [31:16], not [20:5] like the
+			 * other five fields. The vendor writes it there, and
+			 * the [20:5] placement corrupts every golden-predicted
+			 * block even at 1:1 (measured: frame 3 of any stream,
+			 * the first whose golden differs from last).
+			 */
+			if (i == 1)
+				scale1 = ((scale1 >> 5) & 0xffff) << 16 | (scale1 & 0x1f);
+			cedrus_write(dev, VE_DEC_VP9_REF_SCALE1(i), scale1);
+			if (vp9_debug & 1)
+				dev_info(dev->dev, "vp9 ref%u ts=%llu %s idx=%d %ux%u y=%pad\n",
+					 i, ts[i], ref == &run->dst->vb2_buf ? "MISSING" : "found",
+					 ref->index, rw, rh, &(dma_addr_t){ cedrus_dst_buf_addr(ctx, ref, 0) });
+		}
+	}
+
+	/* segmentation features */
+	reg = 0;
+	if (seg_on)
+		for (i = 0; i < 8; i++) {
+			u8 en = f->seg.feature_enabled[i];
+
+			if (en & V4L2_VP9_SEGMENT_FEATURE_ENABLED(V4L2_VP9_SEG_LVL_REF_FRAME))
+				reg |= BIT(i) |
+				       (f->seg.feature_data[i][V4L2_VP9_SEG_LVL_REF_FRAME] & 3)
+				       << (16 + 2 * i);
+			if (en & V4L2_VP9_SEGMENT_FEATURE_ENABLED(V4L2_VP9_SEG_LVL_SKIP))
+				reg |= BIT(8 + i);
+		}
+	cedrus_write(dev, VE_DEC_VP9_SEG_FEATURE, reg);
+
+	cedrus_vp9_sram(ctx, f);
+
+	/* buffers */
+	cedrus_write(dev, VE_DEC_VP9_NEIGHBOR_ADDR, VE_DEC_VP9_ADDR(vp9->neighbor_dma));
+	cedrus_write(dev, VE_DEC_VP9_PROB_ADDR, VE_DEC_VP9_ADDR(vp9->prob_dma));
+	cedrus_vp9_tile_regs(mi_rows, mi_cols, log2r, log2c, 0, 0, &reg, &i);
+	cedrus_write(dev, VE_DEC_VP9_TILE_START, reg);
+	cedrus_write(dev, VE_DEC_VP9_TILE_END, i);
+	cedrus_write(dev, VE_DEC_VP9_COL_MV_ADDR, VE_DEC_VP9_ADDR(vp9->mv_dma));
+
+	if (vp9_debug & 1)
+		dev_info(dev->dev, "vp9 frame ts=%llu dst idx=%d flags=%#x %ux%u fctx=%u tx=%u interp=%u\n",
+			 run->dst->vb2_buf.timestamp, run->dst->vb2_buf.index, f->flags,
+			 width, height, fctx_idx, hdr->tx_mode, f->interpolation_filter);
+	cedrus_write(dev, VE_DEC_VP9_CUR_LUMA,
+		     VE_DEC_VP9_ADDR(cedrus_dst_buf_addr(ctx, &run->dst->vb2_buf, 0)));
+	cedrus_write(dev, VE_DEC_VP9_CUR_CHROMA,
+		     VE_DEC_VP9_ADDR(cedrus_dst_buf_addr(ctx, &run->dst->vb2_buf, 1)));
+	cedrus_write(dev, VE_DEC_VP9_SD_CTRL, 0);
+
+	/* bitstream: the tile data only, past both headers */
+	src_addr = vb2_dma_contig_plane_dma_addr(&run->src->vb2_buf, 0);
+	payload = vb2_get_plane_payload(&run->src->vb2_buf, 0);
+	hdr_bytes = f->uncompressed_header_size + f->compressed_header_size;
+	if (hdr_bytes >= payload)
+		return -EINVAL;
+
+	cedrus_wait_for(dev, VE_DEC_H265_STATUS, VE_DEC_H265_STATUS_BS_DMA_BUSY);
+	cedrus_write(dev, VE_DEC_H265_BITS_OFFSET, hdr_bytes * 8);
+	cedrus_write(dev, VE_DEC_H265_BITS_LEN, (payload - hdr_bytes) * 8);
+	cedrus_write(dev, VE_DEC_H265_BITS_END_ADDR,
+		     VE_DEC_VP9_ADDR(src_addr +
+				     vb2_plane_size(&run->src->vb2_buf, 0)));
+	cedrus_write(dev, VE_DEC_H265_BITS_ADDR,
+		     VE_DEC_H265_BITS_ADDR_BASE(src_addr) |
+		     VE_DEC_H265_BITS_ADDR_VALID_SLICE_DATA |
+		     VE_DEC_H265_BITS_ADDR_LAST_SLICE_DATA |
+		     VE_DEC_H265_BITS_ADDR_FIRST_SLICE_DATA);
+
+	/* the vendor sets DDR consistency for one narrow width band only */
+	reg = VE_DEC_H265_CTRL_IRQ_MASK;
+	if (width > 128 && width <= 192 && height > 64)
+		reg |= VE_DEC_H265_CTRL_DDR_CONSISTENCY_EN;
+	cedrus_write(dev, VE_DEC_H265_CTRL, reg);
+
+	vp9->pending = true;
+	vp9->ok = false;
+
+	return 0;
+}
+
+static void cedrus_vp9_trigger(struct cedrus_ctx *ctx)
+{
+	struct cedrus_dev *dev = ctx->dev;
+
+	cedrus_write(dev, VE_DEC_H265_TRIGGER, VE_DEC_H265_TRIGGER_INIT_SWDEC);
+	cedrus_write(dev, VE_DEC_H265_TRIGGER, VE_DEC_H265_TRIGGER_DEC_SLICE);
+}
+
+static void cedrus_vp9_free(struct cedrus_ctx *ctx)
+{
+	struct cedrus_vp9_ctx *vp9 = ctx->codec.vp9.priv;
+	struct device *d = ctx->dev->dev;
+
+	if (!vp9)
+		return;
+	if (vp9->prob_buf)
+		dma_free_coherent(d, CEDRUS_VP9_PROB_BUF_SIZE, vp9->prob_buf,
+				  vp9->prob_dma);
+	if (vp9->neighbor_buf)
+		dma_free_attrs(d, CEDRUS_VP9_NEIGHBOR_BUF_SIZE, vp9->neighbor_buf,
+			       vp9->neighbor_dma, DMA_ATTR_NO_KERNEL_MAPPING);
+	if (vp9->mv_buf)
+		dma_free_coherent(d, vp9->mv_size, vp9->mv_buf, vp9->mv_dma);
+	kfree(vp9->seg_map);
+	kfree(vp9);
+	ctx->codec.vp9.priv = NULL;
+}
+
+static int cedrus_vp9_start(struct cedrus_ctx *ctx)
+{
+	struct device *d = ctx->dev->dev;
+	struct cedrus_vp9_ctx *vp9;
+
+	vp9 = kzalloc(sizeof(*vp9), GFP_KERNEL);
+	if (!vp9)
+		return -ENOMEM;
+	ctx->codec.vp9.priv = vp9;
+
+	vp9->prob_buf = dma_alloc_coherent(d, CEDRUS_VP9_PROB_BUF_SIZE,
+					   &vp9->prob_dma, GFP_KERNEL);
+	vp9->neighbor_buf = dma_alloc_attrs(d, CEDRUS_VP9_NEIGHBOR_BUF_SIZE,
+					    &vp9->neighbor_dma, GFP_KERNEL,
+					    DMA_ATTR_NO_KERNEL_MAPPING);
+	vp9->mv_size = cedrus_vp9_mv_size(ctx->src_fmt.width,
+					  ctx->src_fmt.height);
+	/* The engine reads the previous frame's MVs from it: start clean. */
+	vp9->mv_buf = dma_alloc_coherent(d, vp9->mv_size, &vp9->mv_dma,
+					 GFP_KERNEL);
+	vp9->seg_map = kzalloc(CEDRUS_VP9_SEG_MAP_MAX, GFP_KERNEL);
+
+	if (!vp9->prob_buf || !vp9->neighbor_buf || !vp9->mv_buf ||
+	    !vp9->seg_map) {
+		cedrus_vp9_free(ctx);
+		return -ENOMEM;
+	}
+
+	/* The first frame is a key frame; this is only a safe default. */
+	vp9->probs = v4l2_vp9_default_probs;
+
+	return 0;
+}
+
+static void cedrus_vp9_stop(struct cedrus_ctx *ctx)
+{
+	cedrus_vp9_free(ctx);
+}
+
+struct cedrus_dec_ops cedrus_dec_ops_vp9 = {
+	.irq_clear	= cedrus_vp9_irq_clear,
+	.irq_disable	= cedrus_vp9_irq_disable,
+	.irq_status	= cedrus_vp9_irq_status,
+	.setup		= cedrus_vp9_setup,
+	.start		= cedrus_vp9_start,
+	.stop		= cedrus_vp9_stop,
+	.trigger	= cedrus_vp9_trigger,
+};
