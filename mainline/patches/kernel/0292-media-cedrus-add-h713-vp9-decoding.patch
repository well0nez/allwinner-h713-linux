@@ -0,0 +1,976 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Cedrus VPU driver: VP9 decoding (Allwinner H713)
+ *
+ * The H713 VE decodes VP9 with the H.265 engine's register block (VE+0x500)
+ * in H.265 mode: the control, trigger, status and bitstream registers are
+ * the H.265 ones, and the rest of the block takes a VP9 meaning. Nothing
+ * about it is documented; the interface was recovered from the vendor's
+ * libawvp9HwAL.so -- its register shadows are exported under names carrying
+ * their offsets, and the packing, the probability buffer layout and the
+ * symbol count layout were mapped by running the library's own routines
+ * under emulation. See docs/reference/vp9-ve-register-interface.md.
+ *
+ * The engine parses no header. It is handed the tile data only, every
+ * probability through one DMA buffer, and it writes the symbol counts back
+ * into the same buffer; forward updates, backward adaptation and the frame
+ * contexts are the CPU's, through the v4l2-vp9 helpers, exactly as for
+ * rkvdec. Adaptation of a frame runs at the next frame's setup, in process
+ * context, since this driver completes jobs from the hard interrupt.
+ */
+
+#include <linux/delay.h>
+#include <linux/slab.h>
+#include <linux/types.h>
+
+#include <media/v4l2-mem2mem.h>
+#include <media/v4l2-vp9.h>
+
+#include "cedrus.h"
+#include "cedrus_hw.h"
+#include "cedrus_regs.h"
+
+static unsigned int vp9_debug;
+module_param(vp9_debug, uint, 0644);
+MODULE_PARM_DESC(vp9_debug, "VP9: bit0 log each frame's references");
+
+#define VE_DEC_VP9_HDR			(VE_ENGINE_DEC_H265 + 0x04)
+#define VE_DEC_VP9_HDR_MULTI_TILE	BIT(0)
+#define VE_DEC_VP9_HDR_INTER		BIT(1)
+#define VE_DEC_VP9_HDR_BIT_DEPTH(d)	(((d) & 0x7) << 2)
+#define VE_DEC_VP9_HDR_SIGN_BIAS(r)	BIT(4 + (r))	/* r = 1..3 */
+#define VE_DEC_VP9_HDR_ALLOW_HP		BIT(8)
+#define VE_DEC_VP9_HDR_INTERP(f)	(((f) & 0x7) << 9)
+#define VE_DEC_VP9_HDR_LF_DELTA		BIT(12)
+#define VE_DEC_VP9_HDR_SHARPNESS(s)	(((s) & 0x7) << 13)
+#define VE_DEC_VP9_HDR_LOSSLESS		BIT(16)
+#define VE_DEC_VP9_HDR_SEG_ENABLED	BIT(17)
+#define VE_DEC_VP9_HDR_SEG_UPDATE_MAP	BIT(18)
+#define VE_DEC_VP9_HDR_SEG_TEMPORAL	BIT(19)
+#define VE_DEC_VP9_HDR_TX_MODE(m)	(((m) & 0x7) << 20)
+#define VE_DEC_VP9_HDR_REF_MODE(m)	(((m) & 0x3) << 23)
+#define VE_DEC_VP9_HDR_PREV_MVS		BIT(25)
+#define VE_DEC_VP9_HDR_ALWAYS		(BIT(26) | BIT(31))
+#define VE_DEC_VP9_HDR_COUNT		BIT(27)
+
+#define VE_DEC_VP9_PIC_SIZE		(VE_ENGINE_DEC_H265 + 0x08)
+/* last, golden, altref: size at 0x0c + 4 * i, scale pair at 0x18 + 8 * i */
+#define VE_DEC_VP9_REF_SIZE(i)		(VE_ENGINE_DEC_H265 + 0x0c + 4 * (i))
+#define VE_DEC_VP9_REF_SCALE0(i)	(VE_ENGINE_DEC_H265 + 0x18 + 8 * (i))
+#define VE_DEC_VP9_REF_SCALE1(i)	(VE_ENGINE_DEC_H265 + 0x1c + 8 * (i))
+/* log2(vendor frame alignment / 8); the vendor's alignment is 16. */
+#define VE_DEC_VP9_LAST_SCALE1_ALIGN	(1 << 28)
+
+#define VE_DEC_VP9_SEG_FEATURE		(VE_ENGINE_DEC_H265 + 0x5c)
+#define VE_DEC_VP9_NEIGHBOR_ADDR	(VE_ENGINE_DEC_H265 + 0x60)
+#define VE_DEC_VP9_PROB_ADDR		(VE_ENGINE_DEC_H265 + 0x64)
+#define VE_DEC_VP9_TILE_START		(VE_ENGINE_DEC_H265 + 0x68)
+#define VE_DEC_VP9_TILE_END		(VE_ENGINE_DEC_H265 + 0x6c)
+#define VE_DEC_VP9_COL_MV_ADDR		(VE_ENGINE_DEC_H265 + 0x78)
+#define VE_DEC_VP9_CUR_LUMA		(VE_ENGINE_DEC_H265 + 0x90)
+#define VE_DEC_VP9_CUR_CHROMA		(VE_ENGINE_DEC_H265 + 0x94)
+#define VE_DEC_VP9_SD_CTRL		(VE_ENGINE_DEC_H265 + 0x50)
+
+/* The altref chroma register is out of line, at 0x7c, not 0xac. */
+static const u32 cedrus_vp9_ref_luma[3] = {
+	VE_ENGINE_DEC_H265 + 0x98, VE_ENGINE_DEC_H265 + 0xa0,
+	VE_ENGINE_DEC_H265 + 0xa8,
+};
+static const u32 cedrus_vp9_ref_chroma[3] = {
+	VE_ENGINE_DEC_H265 + 0x9c, VE_ENGINE_DEC_H265 + 0xa4,
+	VE_ENGINE_DEC_H265 + 0x7c,
+};
+
+/* Every buffer address the VP9 block takes is (addr >> 10) << 2. */
+#define VE_DEC_VP9_ADDR(a)		((u32)(((a) >> 10) << 2))
+
+#define VE_DEC_VP9_SRAM_DEQUANT		0x000
+#define VE_DEC_VP9_SRAM_LF		0x100
+
+/*
+ * The one buffer behind VE_DEC_VP9_PROB_ADDR: the tile table, the
+ * probabilities, the symbol counts the engine writes back, and the segment
+ * map it reads and writes in place.
+ */
+#define CEDRUS_VP9_PROB_BUF_SIZE	0x88000
+#define CEDRUS_VP9_PROBS		0x4000
+#define CEDRUS_VP9_COUNTS		0x4b00
+#define CEDRUS_VP9_SEG_MAP		0x8000
+#define CEDRUS_VP9_SEG_MAP_MAX		(CEDRUS_VP9_PROB_BUF_SIZE - CEDRUS_VP9_SEG_MAP)
+#define CEDRUS_VP9_NEIGHBOR_BUF_SIZE	0x1f4000
+
+/* Probability layout, relative to CEDRUS_VP9_PROBS. */
+#define P_TX8		0x000
+#define P_TX16		0x004
+#define P_TX32		0x00c
+#define P_COEF		0x014
+#define P_SKIP		0x914
+#define P_INTER_MODE	0x918
+#define P_INTERP	0x934
+#define P_IS_INTER	0x944
+#define P_COMP_MODE	0x948
+#define P_COMP_REF	0x950
+#define P_SINGLE_REF	0x958
+#define P_Y_MODE	0x970
+#define P_UV_MODE	0x9b0
+#define P_PARTITION	0xa50
+#define P_MV_JOINT	0xa90
+#define P_MV_COMP(c)	(0xac4 - 0x30 * (c))
+#define P_SEG_TREE	0xaf0
+#define P_SEG_PRED	0xaf8
+
+/* Symbol count layout (u32 words), relative to CEDRUS_VP9_COUNTS. */
+struct cedrus_vp9_hw_mv_counts {
+	u32 sign[2];
+	u32 class0[2];
+	u32 class0_hp[2];
+	u32 hp[2];
+	u32 classes[11];
+	u32 bits[10][2];
+	u32 class0_fp[2][4];
+	u32 fp[4];
+} __packed;
+
+struct cedrus_vp9_hw_counts {
+	u32 tx8p[2][2];
+	u32 tx16p[2][3];
+	u32 tx32p[2][4];
+	u32 eob[4][2][2][6][6];
+	u32 coef[4][2][2][6][6][4];
+	u32 skip[3][2];
+	u32 inter_mode[7][4];
+	u32 interp[4][3];
+	u32 intra_inter[4][2];
+	u32 comp_inter[5][2];
+	u32 comp_ref[5][2];
+	u32 single_ref[5][2][2];
+	u32 y_mode[4][10];
+	u32 uv_mode[10][10];
+	u32 partition[16][4];
+	u32 joints[4];
+	/* component 1 comes first */
+	struct cedrus_vp9_hw_mv_counts comp[2];
+} __packed;
+
+static_assert(sizeof(struct cedrus_vp9_hw_counts) == 0x3398);
+
+/* The counts, in the shapes the v4l2-vp9 helpers take. */
+struct cedrus_vp9_counts {
+	u32 partition[16][4];
+	u32 skip[3][2];
+	u32 intra_inter[4][2];
+	u32 tx32p[2][4];
+	u32 tx16p[2][4];
+	u32 tx8p[2][2];
+	u32 y_mode[4][10];
+	u32 uv_mode[10][10];
+	u32 comp[5][2];
+	u32 comp_ref[5][2];
+	u32 single_ref[5][2][2];
+	u32 mv_mode[7][4];
+	u32 filter[4][3];
+	u32 mv_joint[4];
+	u32 sign[2][2];
+	u32 classes[2][11];
+	u32 class0[2][2];
+	u32 bits[2][10][2];
+	u32 class0_fp[2][2][4];
+	u32 fp[2][4];
+	u32 class0_hp[2][2];
+	u32 hp[2][2];
+};
+
+struct cedrus_vp9_frame_info {
+	u32 flags;
+	u16 width;
+	u16 height;
+	u8 frame_context_idx;
+	u8 reference_mode;
+	u8 interpolation_filter;
+	u8 tx_mode;
+	bool segmentation;
+};
+
+struct cedrus_vp9_ctx {
+	u8 *prob_buf;
+	dma_addr_t prob_dma;
+	void *neighbor_buf;
+	dma_addr_t neighbor_dma;
+	void *mv_buf;
+	dma_addr_t mv_dma;
+	size_t mv_size;
+	u8 *seg_map;
+	size_t seg_map_size;
+
+	struct v4l2_vp9_frame_context frame_context[4];
+	struct v4l2_vp9_frame_context probs;
+
+	struct cedrus_vp9_counts counts;
+	struct v4l2_vp9_frame_symbol_counts symbols;
+
+	/* the frame on the engine, finished at the next setup */
+	struct cedrus_vp9_frame_info cur;
+	bool pending;
+	bool ok;
+
+	/* the last frame finished */
+	struct cedrus_vp9_frame_info last;
+	bool last_valid;
+};
+
+/* Standard VP9 quantizer lookup, 8-bit (spec section 8.6.1). */
+static const u16 dc_qlookup[256] = {
+	4, 8, 8, 9, 10, 11, 12, 12, 13, 14, 15, 16, 17, 18, 19, 19, 20, 21,
+	22, 23, 24, 25, 26, 26, 27, 28, 29, 30, 31, 32, 32, 33, 34, 35, 36,
