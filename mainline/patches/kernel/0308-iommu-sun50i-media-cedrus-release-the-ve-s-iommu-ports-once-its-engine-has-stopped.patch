+static inline int sunxi_ve_reset_pulse_and(struct reset_control *rstc,
+					   int (*fn)(void *data), void *data)
+{
+	int ret = reset_control_assert(rstc);
+
+	if (!ret && fn)
+		ret = fn(data);
+	return reset_control_deassert(rstc) ?: ret;
+}
 
 #endif
 
