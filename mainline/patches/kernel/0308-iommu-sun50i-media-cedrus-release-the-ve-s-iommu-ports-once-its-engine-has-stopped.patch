---
--- a/drivers/iommu/sun50i-iommu.c
+++ b/drivers/iommu/sun50i-iommu.c
@@ -25,6 +25,7 @@
 #include <linux/sizes.h>
 #include <linux/slab.h>
 #include <linux/spinlock.h>
+#include <linux/sun50i-iommu.h>
 #include <linux/types.h>
 
 #include "iommu-pages.h"
@@ -1075,6 +1076,59 @@
 	return IRQ_HANDLED;
 }
 
+/**
+ * sun50i_iommu_reset_client() - release a client's ports once its engine stopped
+ * @dev: a device whose "iommus" property points at a sun50i IOMMU
+ *
+ * After a page fault the interrupt handler resets the faulting master's
+ * port at once, while the master is still running. An engine that keeps
+ * reading leaves the port blocked again: its job times out, the next jobs'
+ * bit reader times out in setup, and every later job of every codec fails
+ * until a reboot. Only the client knows when its engine has stopped (its
+ * own reset); it calls this afterwards, and the ports of all its masters
+ * are reset once more. Measured on the H713 (arbeit/medien/B6-mythos):
+ * with the engine idle this pulse brings a dead video engine back every
+ * time, from user space and from here.
+ *
+ * Nothing else is touched. The fault stays on display in
+ * IOMMU_L1PG_INT_REG/IOMMU_L2PG_INT_REG and the error address register:
+ * only the undocumented bits 16 and 17 of IOMMU_RESET_REG clear those, and
+ * they reset units shared by all masters - the AV1 core on master 5 then
+ * loses frames (arbeit/medien/B6-diagnose §14). The display has no effect
+ * on the port; the vendor's driver never clears it either.
+ *
+ * Return: 0, or -ENODEV if @dev is not a client of this driver.
+ */
+int sun50i_iommu_reset_client(struct device *dev)
+{
+	struct iommu_fwspec *fwspec = dev_iommu_fwspec_get(dev);
+	struct sun50i_iommu *iommu;
+	unsigned long flags;
+	unsigned int i;
+	u32 mask = 0;
+
+	if (!fwspec || !dev->iommu || !dev->iommu->iommu_dev ||
+	    dev->iommu->iommu_dev->ops != &sun50i_iommu_ops)
+		return -ENODEV;
+
+	iommu = container_of(dev->iommu->iommu_dev, struct sun50i_iommu, iommu);
+
+	for (i = 0; i < fwspec->num_ids; i++)
+		mask |= BIT(fwspec->ids[i]);
+	mask &= sun50i_iommu_master_mask(iommu);
+	if (!mask)
+		return -ENODEV;
+
+	spin_lock_irqsave(&iommu->iommu_lock, flags);
+	iommu_write(iommu, IOMMU_RESET_REG, ~mask);
+	iommu_read(iommu, IOMMU_RESET_REG);
+	iommu_write(iommu, IOMMU_RESET_REG, IOMMU_RESET_RELEASE_ALL);
+	spin_unlock_irqrestore(&iommu->iommu_lock, flags);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(sun50i_iommu_reset_client);
+
 static int sun50i_iommu_probe(struct platform_device *pdev)
 {
 	struct sun50i_iommu *iommu;
