@@ -65,12 +67,51 @@
 EXPORT_SYMBOL_GPL(sunxi_ve_reset_release);
 
 /*
+ * A borrower has a stream open (its core powered, frames to come) or has
+ * closed it. While a stream is open, sunxi_ve_reset_pulse_and() pulses the
+ * line but leaves @fn out: on the H713 the owner's IOMMU port release next
+ * to a decoding AV1 core cost AV1 frames or stopped the SoC - before, after
+ * or during the bus reset, guarded or not (arbeit/medien/B6-mythos). The
+ * release waits until the borrower is gone; the engine lives with its
+ * blocked port until then.
+ */
+void sunxi_ve_reset_stream_begin(void)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&sunxi_ve_reset_lock, flags);
+	sunxi_ve_reset_streams++;
+	spin_unlock_irqrestore(&sunxi_ve_reset_lock, flags);
+}
+EXPORT_SYMBOL_GPL(sunxi_ve_reset_stream_begin);
+
+void sunxi_ve_reset_stream_end(void)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&sunxi_ve_reset_lock, flags);
+	if (!WARN_ON_ONCE(!sunxi_ve_reset_streams))
+		sunxi_ve_reset_streams--;
+	spin_unlock_irqrestore(&sunxi_ve_reset_lock, flags);
+}
+EXPORT_SYMBOL_GPL(sunxi_ve_reset_stream_end);
+
+/*
  * Pulse the line (assert, 10 us, deassert, as the CCU does it) with nobody
- * holding it. A holder ends its frame within its own watchdog's 2 s; one
- * that does not is given up on after 3 s and the pulse happens anyway,
- * since the alternative is an engine that never comes back.
+ * holding it; @fn, if given, runs while the line is asserted - the engine
+ * is dead then, nothing of it is on the bus - and only while no borrower
+ * has a stream open (see sunxi_ve_reset_stream_begin()). @fn runs with the
+ * guard's spinlock held and interrupts off; it must not sleep. Returns 0
+ * when the line was pulsed and @fn ran (or there was none), 1 when the
+ * line was pulsed but @fn was left out for an open stream, negative when
+ * the pulse itself failed.
+ *
+ * A holder ends its frame within its own watchdog's 2 s; one that does not
+ * is given up on after 3 s and the pulse happens anyway, since the
+ * alternative is an engine that never comes back.
  */
-int sunxi_ve_reset_pulse(struct reset_control *rstc)
+int sunxi_ve_reset_pulse_and(struct reset_control *rstc,
+			     int (*fn)(void *data), void *data)
 {
 	unsigned long flags;
 	int ret;
@@ -92,9 +133,28 @@
 		}
 		spin_unlock_irqrestore(&sunxi_ve_reset_lock, flags);
 	}
-	ret = reset_control_reset(rstc);
+	ret = reset_control_assert(rstc);
+	if (!ret) {
+		int fret = 0;
+
+		udelay(10);
+		if (fn && !sunxi_ve_reset_streams)
+			fret = fn(data);
+		else if (fn)
+			fret = 1;
+		udelay(10);
+		ret = reset_control_deassert(rstc);
+		if (!ret)
+			ret = fret;
+	}
 	spin_unlock_irqrestore(&sunxi_ve_reset_lock, flags);
 
 	return ret;
 }
+EXPORT_SYMBOL_GPL(sunxi_ve_reset_pulse_and);
+
+int sunxi_ve_reset_pulse(struct reset_control *rstc)
+{
+	return sunxi_ve_reset_pulse_and(rstc, NULL, NULL);
+}
 EXPORT_SYMBOL_GPL(sunxi_ve_reset_pulse);
