+
+/*
+ * After a job that ended in error (its error interrupt, a failed setup,
+ * the watchdog). A read from an unmapped address - a damaged stream can
+ * send the engine there - leaves the engine's IOMMU ports blocked: the
+ * IOMMU resets them in its fault interrupt while the engine still reads,
+ * and they block again; the engine then stays dead until a reboot. The
+ * ports are released while the engine is held in reset, inside the guard:
+ * nothing of the engine is on the bus then, and no AV1 frame is in flight.
+ * Released next to a live engine, or next to a running AV1 frame, the
+ * release cost AV1 frames or stopped the SoC (measured on the H713,
+ * arbeit/medien/B6-mythos). Without a sun50i IOMMU the release is a stub.
+ * Process context only, like cedrus_ve_reset().
+ */
+void cedrus_recover(struct cedrus_dev *dev)
+{
+	int ret = sunxi_ve_reset_pulse_and(dev->rstc, cedrus_release_ports, dev);
+
+	if (ret == 1)
+		dev_info_ratelimited(dev->dev, "IOMMU ports left blocked while the AV1 core decodes\n");
+	else if (ret && ret != -ENODEV)
+		dev_err_ratelimited(dev->dev, "recovery failed: %d\n", ret);
+}
+
