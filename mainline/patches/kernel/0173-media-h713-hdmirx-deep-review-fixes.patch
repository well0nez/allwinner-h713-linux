media: h713-hdmirx: deep-review fixes - the cap takes record 27, ENUM_DV_TIMINGS lists only what locks, stale totals are a change in flight (27.09.2026)

Record 27 (640x480@59.94) fills to 25,174,800 Hz, below the old floor, so VIC 1 was refused
although offered; the enumeration now runs every table record through the same cap that
S_DV_TIMINGS applies (28 of 119 were listed and refused); an unlisted raster with totals
not above the record's active size is a change in flight, not a name. Findings 2, 3, N2 of
umbau/work/_deepreview/hdmi. Applies after 0136zb.
---
diff --git a/drivers/media/platform/sunxi/sun50i-h713-hdmirx/sun50i-h713-hdmirx.c b/drivers/media/platform/sunxi/sun50i-h713-hdmirx/sun50i-h713-hdmirx.c
--- a/drivers/media/platform/sunxi/sun50i-h713-hdmirx/sun50i-h713-hdmirx.c
+++ b/drivers/media/platform/sunxi/sun50i-h713-hdmirx/sun50i-h713-hdmirx.c
@@ -3242,7 +3242,7 @@ static const struct v4l2_dv_timings_cap h713_hdmirx_timings_cap = {
 		.max_width	= 4096,
 		.min_height	= 480,
 		.max_height	= 2160,
-		.min_pixelclock	= 25175000,
+		.min_pixelclock	= 25174000,	/* record 27: 800 x 525 x 59.94 = 25,174,800 */
 		.max_pixelclock	= 297000000,
 		.standards	= V4L2_DV_BT_STD_CEA861 | V4L2_DV_BT_STD_DMT,
 		.capabilities	= V4L2_DV_BT_CAP_PROGRESSIVE |
@@ -3808,6 +3808,9 @@ static int h713_hdmirx_unlisted_record(struct h713_hdmirx *rx,
 				       unsigned int htotal, unsigned int vtotal,
 				       struct v4l2_dv_timings *t)
 {
+	/* stale totals under a fresh record: a change in flight, not a raster */
+	if (htotal <= sig->h_size || vtotal <= sig->v_size)
+		return -ENOLCK;
 	memset(t, 0, sizeof(*t));
 	t->type = V4L2_DV_BT_656_1120;
 	t->bt.width = sig->h_size;
@@ -4339,12 +4342,17 @@ static int h713_hdmirx_enum_dv_timings(struct file *file, void *priv,
 	for (i = 0; i < rx->tse_count; i++) {
 		const struct h713_hdmirx_tse_mode *m = &rx->tse_modes[i];
 
-		if (!m->h_active || !m->v_active || n++ != t->index)
+		struct v4l2_dv_timings dt = { .type = V4L2_DV_BT_656_1120 };
+
+		if (!m->h_active || !m->v_active)
+			continue;
+		/* only what S_DV_TIMINGS would take: the cap filters the table */
+		h713_hdmirx_tse_fill(m, &dt);
+		if (!v4l2_valid_dv_timings(&dt, &h713_hdmirx_timings_cap, NULL, NULL) ||
+		    n++ != t->index)
 			continue;
 		memset(t->reserved, 0, sizeof(t->reserved));
-		memset(&t->timings, 0, sizeof(t->timings));
-		t->timings.type = V4L2_DV_BT_656_1120;
-		h713_hdmirx_tse_fill(m, &t->timings);
+		t->timings = dt;
 		return 0;
 	}
 
