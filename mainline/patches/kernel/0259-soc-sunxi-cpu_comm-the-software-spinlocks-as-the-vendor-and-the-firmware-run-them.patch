+void comm_SpinLockForgetArm(void)
+{
+	void __iomem *e;
+	int id;
+
+	for (id = 0; id <= SPINLOCK_MAX_ID; id++) {
+		e = spin_entry(id);
+		if (readb(e + SPINLOCK_OFF_CRIT) == CPU_ID_ARM) {
+			pr_warn("cpu_comm: lock %d: a former ARM run was in its critical section -- released\n", id);
+			writeb(SPINLOCK_FREE, e + SPINLOCK_OFF_CRIT);
+		}
+		if (readb(e + SPINLOCK_OFF_CPU) != CPU_ID_ARM || enterCritical(id))
+			continue;
+		if (readb(e + SPINLOCK_OFF_CPU) == CPU_ID_ARM) {
+			pr_warn("cpu_comm: lock %d: held by a former ARM run (ref %d thread 0x%08x) -- released\n",
