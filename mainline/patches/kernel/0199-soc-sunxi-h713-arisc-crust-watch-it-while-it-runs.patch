@@ -431,6 +433,13 @@ struct h713_arisc {
 
 	struct dentry		*debugfs;
 	char			last_cmd[160];
+
+	/* supervision of a running crust, arisc_watch() */
+	struct delayed_work	watch;
+	u32			seen_inits;	/* starts and exception at the */
+	u32			seen_exc;	/* handshake */
+	u32			err_seen;	/* error bits already reported */
+	u32			cnt_seen[2];	/* CNT0, CNT1[15:0] reported */
 };
 
 /*
@@ -516,6 +525,15 @@ static u8 hpd_counter(struct h713_arisc *a, unsigned int port)
 	return sram_rb(a, a->off.hpd_counter + port);
 }
 
+/* Every 10 s, in prepare and right after a command timed out. */
+#define ARISC_WATCH_MS		10000
+
+static void arisc_watch_soon(struct h713_arisc *a)
+{
+	if (a->off.crust)
+		mod_delayed_work(system_freezable_wq, &a->watch, 0);
+}
+
 static void arisc_report(struct h713_arisc *a, const char *fmt, ...)
 {
 	va_list args;
@@ -1647,6 +1665,7 @@ static int arisc_send(struct h713_arisc *a, u16 sub_cmd, u8 arg1, u8 arg2,
 	u8 payload[PAYLOAD_MAX] = { };
 	ktime_t start;
 	size_t i;
+	int ret;
 
 	if ((sub_cmd & 0xff) < SUB_CMD_LO_MIN || (sub_cmd & 0xff) > SUB_CMD_LO_MAX)
 		return -EINVAL;
@@ -1670,6 +1689,7 @@ static int arisc_send(struct h713_arisc *a, u16 sub_cmd, u8 arg1, u8 arg2,
 			dev_err(a->dev,
 				"Msgbox user1 port 0 is not being drained -- sub-command 0x%04x not sent\n",
 				sub_cmd);
+			arisc_watch_soon(a);
 			return -EBUSY;
 		}
 		usleep_range(1000, 2000);
@@ -1691,7 +1711,10 @@ static int arisc_send(struct h713_arisc *a, u16 sub_cmd, u8 arg1, u8 arg2,
 	if ((sub_cmd & 0xff) != 0x11)
 		return 0;
 
-	return arisc_wait_handler(a, payload);
+	ret = arisc_wait_handler(a, payload);
+	if (ret)
+		arisc_watch_soon(a);
