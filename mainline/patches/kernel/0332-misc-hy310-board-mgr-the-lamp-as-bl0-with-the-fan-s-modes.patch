 /* -------------------------------------------------------------------------
+ * sysfs: lamp_mode, lamp_modes, thermal_mode -- only with a bl0 lamp
+ * ------------------------------------------------------------------------- */
+
+static ssize_t lamp_mode_show(struct device *dev,
+			      struct device_attribute *attr, char *buf)
+{
+	struct hy310_board_mgr *priv = dev_get_drvdata(dev);
+	u32 mode;
+
+	mutex_lock(&priv->lock);
+	mode = priv->user_mode;
+	mutex_unlock(&priv->lock);
+
+	if (mode < priv->lamp.num_names)
+		return sysfs_emit(buf, "%s\n", priv->lamp.names[mode]);
+	return sysfs_emit(buf, "%u\n", mode);
+}
+
+/*
+ * A mode chosen while the thermal mode holds is kept and set when it ends:
+ * the lamp does not get brighter while the box is hot.
+ */
+static ssize_t lamp_mode_store(struct device *dev,
+			       struct device_attribute *attr,
+			       const char *buf, size_t count)
+{
+	struct hy310_board_mgr *priv = dev_get_drvdata(dev);
+	int mode;
+
+	mode = __sysfs_match_string(priv->lamp.names, priv->lamp.num_names, buf);
+	if (mode < 0)
+		return mode;
+
+	mutex_lock(&priv->lock);
+	priv->user_mode = mode;
+	if (!priv->thermal_active) {
+		priv->current_mode = mode;
+		hy310_apply_mode(priv);
+	}
+	mutex_unlock(&priv->lock);
+	return count;
+}
+static DEVICE_ATTR_RW(lamp_mode);
+
+static ssize_t lamp_modes_show(struct device *dev,
+			       struct device_attribute *attr, char *buf)
+{
+	struct hy310_board_mgr *priv = dev_get_drvdata(dev);
+	int i, len = 0;
+
+	for (i = 0; i < priv->lamp.num_names; i++)
+		len += sysfs_emit_at(buf, len, "%s%s", i ? " " : "",
+				     priv->lamp.names[i]);
+	len += sysfs_emit_at(buf, len, "\n");
+	return len;
+}
+static DEVICE_ATTR_RO(lamp_modes);
+
+static ssize_t thermal_mode_show(struct device *dev,
+				 struct device_attribute *attr, char *buf)
+{
+	struct hy310_board_mgr *priv = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%d\n", priv->thermal_active);
+}
+static DEVICE_ATTR_RO(thermal_mode);
+
+static struct attribute *hy310_board_mgr_attrs[] = {
+	&dev_attr_lamp_mode.attr,
+	&dev_attr_lamp_modes.attr,
+	&dev_attr_thermal_mode.attr,
+	NULL
+};
+
+static umode_t hy310_board_mgr_attr_visible(struct kobject *kobj,
+					    struct attribute *attr, int n)
+{
+	struct hy310_board_mgr *priv = dev_get_drvdata(kobj_to_dev(kobj));
+
+	if (!priv || !priv->has_lamp || !priv->lamp.num_names)
+		return 0;
+	if (attr == &dev_attr_thermal_mode.attr && !priv->has_thermal_mode)
+		return 0;
+	return attr->mode;
+}
+
+static const struct attribute_group hy310_board_mgr_group = {
+	.attrs      = hy310_board_mgr_attrs,
+	.is_visible = hy310_board_mgr_attr_visible,
+};
+
+static const struct attribute_group *hy310_board_mgr_groups[] = {
+	&hy310_board_mgr_group,
+	NULL
+};
+
+/* -------------------------------------------------------------------------
  * Platform driver registration
  * ------------------------------------------------------------------------- */
 
@@ -1581,6 +1875,7 @@
 		.name           = "hy310-board-mgr",
 		.of_match_table = hy310_board_mgr_of_match,
 		.pm             = pm_sleep_ptr(&hy310_board_mgr_pm_ops),
+		.dev_groups     = hy310_board_mgr_groups,
 	},
