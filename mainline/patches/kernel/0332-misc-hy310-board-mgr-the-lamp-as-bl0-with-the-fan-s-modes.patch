+/**
+ * hy310_lamp_apply - set the lamp's duty for current_mode
+ * @priv: driver private data
+ *
+ * The lamp's PWM is never disabled here: every mode has a duty.
+ */
+static void hy310_lamp_apply(struct hy310_board_mgr *priv)
+{
+	struct hy310_lamp *lamp = &priv->lamp;
+	struct pwm_state state;
+	u32 duty;
+	int ret;
+
+	if (!priv->has_lamp)
+		return;
+
+	if (priv->current_mode < lamp->num_modes)
+		duty = lamp->duty_array[priv->current_mode];
+	else
+		duty = lamp->duty_array[lamp->num_modes - 1];
+	if (duty > 100)
+		duty = 100;
+
+	pwm_get_state(lamp->pwm, &state);
+	state.period = lamp->period_ns;
+	state.polarity = PWM_POLARITY_NORMAL;
+	state.duty_cycle = (u64)lamp->period_ns * duty / 100;
+	state.enabled = true;
+
+	ret = pwm_apply_might_sleep(lamp->pwm, &state);
+	if (ret)
+		dev_warn(priv->dev, "bl0: PWM apply failed: %d\n", ret);
+}
+
+/**
+ * hy310_apply_mode - set fans and lamp for current_mode (caller holds lock)
+ * @priv: driver private data
+ */
+static void hy310_apply_mode(struct hy310_board_mgr *priv)
+{
+	hy310_update_all_fan_duties(priv);
+	hy310_lamp_apply(priv);
+}
