+/**
+ * hy310_parse_lamp - the bl0 subnode: duty-array, dft_period_ns, lamp-mode-names
+ * @priv:      driver private data
+ * @np:        the board manager's node
+ * @period_ns: the fans' pwm_period_ns, used when bl0 has no dft_period_ns
+ *
+ * Optional: only a tree with a bl0 node and a PWM named "bl0" gets a lamp
+ * here (the L018); every other board keeps its lamp with pwm-backlight or
+ * has none. thermal-mode, the index the NTC falls back to, comes with it,
+ * because the stock thermal mode dims the lamp; it also needs temp_resume.
+ *
+ * Return: 0, or -EPROBE_DEFER while the PWM controller is not there yet.
+ */
+static int hy310_parse_lamp(struct hy310_board_mgr *priv,
+			    struct device_node *np, u32 period_ns)
+{
+	struct hy310_lamp *lamp = &priv->lamp;
+	struct device *dev = priv->dev;
+	struct device_node *bl_np;
+	int ret = 0;
+	int n;
+
+	bl_np = of_get_child_by_name(np, "bl0");
+	if (!bl_np)
+		return 0;
+
+	n = of_property_count_u32_elems(bl_np, "duty-array");
+	if (n <= 0) {
+		dev_warn(dev, "bl0: no duty-array, no lamp control\n");
+		goto out;
+	}
+	if (n > HY310_MAX_MODES)
+		n = HY310_MAX_MODES;
+	if (of_property_read_u32_array(bl_np, "duty-array",
+				       lamp->duty_array, n)) {
+		dev_warn(dev, "bl0: duty-array unreadable, no lamp control\n");
+		goto out;
+	}
+	lamp->num_modes = n;
+
+	if (of_property_read_u32(bl_np, "dft_period_ns", &lamp->period_ns))
+		lamp->period_ns = period_ns;
+
+	n = of_property_read_string_array(bl_np, "lamp-mode-names",
+					  lamp->names, HY310_MAX_MODES);
+	lamp->num_names = n > 0 ? min_t(int, n, lamp->num_modes) : 0;
+
+	lamp->pwm = devm_pwm_get(dev, "bl0");
+	if (IS_ERR(lamp->pwm)) {
+		ret = PTR_ERR(lamp->pwm);
+		lamp->pwm = NULL;
+		if (ret == -EPROBE_DEFER)
+			goto out;
+		dev_warn(dev, "bl0: PWM not found (%d), no lamp control\n", ret);
+		ret = 0;
+		goto out;
+	}
+	priv->has_lamp = true;
+	dev_info(dev, "bl0: lamp on PWM bl0, %u modes, %d by name, period %u ns\n",
+		 lamp->num_modes, lamp->num_names, lamp->period_ns);
+
+	if (!of_property_read_u32(np, "thermal-mode", &priv->thermal_mode)) {
+		if (priv->thermal_mode >= lamp->num_modes ||
+		    priv->temp_resume_c == INT_MIN) {
+			dev_warn(dev,
+				 "thermal-mode %u ignored: needs an index below %u and temp_resume\n",
+				 priv->thermal_mode, lamp->num_modes);
+		} else {
+			priv->has_thermal_mode = true;
+			dev_info(dev, "thermal mode %u above %d C, back at %d C\n",
+				 priv->thermal_mode, priv->temp_warn_c,
+				 priv->temp_resume_c);
+		}
+	}
+out:
+	of_node_put(bl_np);
+	return ret;
+}
+
 /* -------------------------------------------------------------------------
  * Probe
