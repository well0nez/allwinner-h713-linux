From: well0nez <8986239+well0nez@users.noreply.github.com>
Subject: arm64: dts: h713: add the L018 board dts

The L018 (stock Android 11 of 2025-05-14, Projector05141211) has the
HY310's DRAM words, panel (project 0x30) and display firmware, so its tree
is the HY310's with what this board's own stock device tree and its pin
state under stock (read on a running unit, 24.10.2026) say differently:

- PH4/PH5 are twi2 here, the accelerometer's bus: twi2 (from the stock
  tree: SPI 9, 100 kHz, the dtsi's twi1 clock and reset plus one) with the
  LSM6DSV at 0x6a the stock firmware bound, no interrupt line.
- The focus motor on this board's own pins: phases PF0..PF3 (the SD
  card's, sdmmc is off), end switch PB1, motor-cycle 3; the rest as the
  HY310's, as in the stock tree. The driver's homing and end switch
  pull-up are measured on the HY310 only.
- twi1 off: PH2/PH3 are disabled under stock.
- The power key's two LEDs as gpio-leds at the levels the stock fan
  driver sets at probe: PL0 high, PL1 (active low) low.
- The fan tacho is PH13, as on the HY200 QZ713DF A1.
- Lamp and fan belong to the board manager, as under stock (patch 0332):
  PWM0 on PH17 is the fan's speed, PWM2 on PB4 the lamp's dimmer, which
  dims as the duty rises, both 25 kHz with the stock pin groups. One mode
  index sets both, the stock tables: std 0 = lamp 50 % / fan 70 %, low
  1 = 75 / 60, high 2 = 30 / 95 (switched and measured on the running
  unit, 24.10.2026), and 3, the stock thermal mode (75 / 70), which the
  NTC selects above temp_warn until temp_resume. The dtsi's pwm-backlight
  is disabled, it would be a second owner of PWM2. U-Boot's
  CONFIG_H713_BOARD_L018 sets the stock std before Linux.
- The NTC: the L018 has one (stock ntc_num 1, GPADC channel 1), the HY310
  none; its own gpadc-table (0..55 C) and thresholds (warn 41, power off
  51, resume 34 C), verbatim from the stock tree.
- The vendor ARISC firmware, as on the HY300 Pro.

Booted on the L018 since 24.10.2026 (test image test2, then quick
deploys of U-Boot and the kernel FIT).

diff -ruN a/arch/arm64/boot/dts/allwinner/Makefile b/arch/arm64/boot/dts/allwinner/Makefile
--- a/arch/arm64/boot/dts/allwinner/Makefile
+++ b/arch/arm64/boot/dts/allwinner/Makefile
@@ -59,6 +59,7 @@
 dtb-$(CONFIG_ARCH_SUNXI) += sun50i-h713-hy200-qz713-v2.dtb
 dtb-$(CONFIG_ARCH_SUNXI) += sun50i-h713-hy310.dtb
 dtb-$(CONFIG_ARCH_SUNXI) += sun50i-h713-hy300-pro.dtb
+dtb-$(CONFIG_ARCH_SUNXI) += sun50i-h713-l018.dtb
 dtb-$(CONFIG_ARCH_SUNXI) += sun55i-a527-cubie-a5e.dtb
 dtb-$(CONFIG_ARCH_SUNXI) += sun55i-h728-x96qpro+.dtb
 dtb-$(CONFIG_ARCH_SUNXI) += sun55i-t527-avaota-a1.dtb
diff -ruN a/arch/arm64/boot/dts/allwinner/sun50i-h713-l018.dts b/arch/arm64/boot/dts/allwinner/sun50i-h713-l018.dts
--- /dev/null
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h713-l018.dts
@@ -0,0 +1,208 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+/*
+ * L018 projector (Allwinner H713; stock Android 11 of 2025-05-14,
+ * Projector05141211).
+ *
+ * The HY310's tree, held against this board's own stock device tree (the
+ * kernel's in vendor_boot and U-Boot's in the sunxi package are the same
+ * here) and against its pin state under stock (24.10.2026). The DRAM words,
+ * the panel (project 0x30) and the display firmware are the HY310's. What
+ * differs, and what this file does about it:
+ *
+ *  - PH4/PH5 are twi2 on this board, the bus of its accelerometer (lsm6dsv
+ *    at 0x6a), and PH6/PH7 are on function 2: twi2 and the sensor are
+ *    described below. The focus motor has its own pins here (phases
+ *    PF0..PF3, end switch PB1) and motor-cycle 3.
+ *  - twi1 (PH2/PH3, the HY310's SC7A20) is disabled under stock: off here.
+ *  - The fan: the tacho is PH13 (stock fan0 fg-gpio, on EINT under stock) -
+ *    the board manager powers off when it counts too little, so it has to
+ *    count the right pin. Its speed is PWM0 on PH17.
+ *  - The lamp: PWM2 on PB4, and it dims as the duty rises. Lamp and fan
+ *    belong to the board manager, set together from the stock modes (std,
+ *    low, high and the thermal mode); pwm-backlight is off.
+ *  - The NTC on GPADC channel 1 with this board's table and thresholds.
+ *  - PB5 enables lamp and fan as on the HY310 (stock fan0 fan-power-gpio,
+ *    output high under stock); the board manager keeps it.
+ *  - The two LEDs of the power key (PL0, PL1) at the levels the stock kernel
+ *    sets.
+ *  - The vendor ARISC firmware, as on the HY300 Pro: crust has run on the
+ *    HY310 only.
+ *
+ * The camera is USB and needs nothing here. The board has no keys but the
+ * power key (PL4, as on the HY310); the stock tree's seven LRADC keys are its
+ * template.
+ */
+
+#include "sun50i-h713-hy310.dts"
+
+/ {
+	model = "L018 (Allwinner H713)";
+	compatible = "magcubic,l018", "allwinner,sun50i-h713";
+
+	/*
+	 * The two LEDs of the power key. The stock fan driver drives them at
+	 * probe as its tree says: power-led-gpio PL0 (flags 0) to 1,
+	 * status-led-gpio PL1 (flags 1, active low) to 0 (pwm_fan_probe,
+	 * read off the stock kernel 25.10.2026). Both "on" here gives the same
+	 * levels. standby_param names PL0 the red and PL1 the blue LED; which
+	 * colour the owner then sees is not measured.
+	 */
+	leds {
+		compatible = "gpio-leds";
+
+		led-power {
+			label = "l018:power";
+			gpios = <&r_pio 0 0 GPIO_ACTIVE_HIGH>;	/* PL0 */
+			default-state = "on";
+		};
+
+		led-status {
+			label = "l018:status";
+			gpios = <&r_pio 0 1 GPIO_ACTIVE_LOW>;	/* PL1 */
+			default-state = "on";
+		};
+	};
+};
+
+/*
+ * twi2 with the accelerometer the stock firmware bound, an LSM6DSV at 0x6a
+ * (the stock tree also lists an LSM6DSR at 0x6b and an ICM42600 at 0x68 for
+ * other assemblies). Controller from the stock tree: SPI 9, 100 kHz; the
+ * clock and reset are the dtsi's twi1 ones plus one, as stock twi1 (SPI 8,
+ * clock 0x46, reset 0x1c) and twi2 (SPI 9, 0x47, 0x1d) are. No interrupt
+ * line: st_lsm6dsx then has no buffer, h713-keystone reads through sysfs.
+ */
+&{/soc} {
+	twi2: i2c@2502800 {
+		compatible = "allwinner,sun50i-h6-i2c",
+			     "allwinner,sun6i-a31-i2c";
+		reg = <0x02502800 0x400>;
+		interrupts = <GIC_SPI 9 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&ccu CLK_BUS_TWI2>;
+		resets = <&ccu RST_BUS_TWI2>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&l018_twi2_pins>;
+		clock-frequency = <100000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+		status = "okay";
+
+		accelerometer@6a {
+			compatible = "st,lsm6dsv";
+			reg = <0x6a>;
+		};
+	};
+};
+
+&twi1 {
+	status = "disabled";
+};
+
+/*
+ * The focus motor, with this board's own pins and timing from its stock tree:
+ * phases PF0..PF3 (the SD card's pins - sdmmc is off in both stock trees),
+ * the upper end switch PB1, motor-cycle 3 (the HY310's is 2). The tables,
+ * step-num, the delays and active_level are the HY310's, as in the stock tree.
+ * motor-step-type 4 is copied but moves nothing: the stock driver only stores
+ * and shows it (motor_step_num in sysfs), none of its move functions reads it.
+ * The driver homes at probe and pulls the end switch up, both measured on the
+ * HY310 only; the first test on this board loads it with homing=0.
+ */
+&motor_ctr {
+	motor-gpio-phase0 = <&pio 5 0 0>;	/* PF0 */
+	motor-gpio-phase1 = <&pio 5 1 0>;	/* PF1 */
+	motor-gpio-phase2 = <&pio 5 2 0>;	/* PF2 */
+	motor-gpio-phase3 = <&pio 5 3 0>;	/* PF3 */
+	limiter-up-gpio = <&pio 1 1 0>;		/* PB1 */
+	motor-cycle = <3>;
+	motor-step-type = <4>;
+};
+
+/* The stock L018's own pin groups for the two PWMs and twi2 (all 10 mA). */
+&pio {
+	l018_twi2_pins: l018-twi2-pins {
+		pins = "PH4", "PH5";
+		function = "twi2";
+		drive-strength = <10>;
+		bias-pull-up;
+	};
+
+	l018_pwm0_pin: l018-pwm0-pin {
+		pins = "PH17";
+		function = "pwm0";
+		drive-strength = <10>;
+		bias-pull-down;
+	};
+
+	l018_pwm2_pin: l018-pwm2-pin {
+		pins = "PB4";
+		function = "pwm2";
+		drive-strength = <10>;
+		bias-pull-up;
+	};
+};
+
+&board_mgr {
+	/*
+	 * Lamp and fan as the stock driver owns them, one mode index for both
+	 * (stock fan node, fan_policy 1; measured on the running unit
+	 * 24.10.2026): std 0 = lamp 50 % / fan 70 %, low 1 = 75 / 60,
+	 * high 2 = 30 / 95; the lamp dims as PWM2's duty rises. 3 is the stock
+	 * thermal mode (75 / 70): above temp_warn for long the lamp dims, the
+	 * chosen mode is kept and comes back at temp_resume.
+	 */
+	pinctrl-names = "default";
+	pinctrl-0 = <&l018_pwm0_pin>, <&l018_pwm2_pin>;
+	pwms = <&pwm 0 40000 0>, <&pwm 2 40000 0>;
+	pwm-names = "fan0", "bl0";
+	thermal-mode = <3>;
+
+	/*
+	 * The L018 has an NTC (stock ntc_num = 1; ntc0: source 1 = GPADC,
+	 * channel 1 - the dtsi's ntc0 says the same), the HY310 none (stock
+	 * ntc_num = 0). Its own table and thresholds, verbatim from its stock
+	 * tree: 38 pairs <degrees C, mV> from 0 to 55 C (the HY310's runs to
+	 * 80 C), warn 41, power off 51, resume 34 C. The stock vmlinux of both
+	 * boards converts with the same code (get_adc_data, get_temp_data,
+	 * search_table_gpadc, sunxi_gpadc_read_*: the same sizes). Below the
+	 * last node both clamp to 55 C, which is above temp_poweroff, so a
+	 * hotter box still counts towards the shutdown. temp_resume ends the
+	 * thermal mode.
+	 */
+	io-channels = <&gpadc 1>;
+	gpadc-table = <
+		0x0 0x5E6 0x5 0x5B4 0x14 0x4F8 0x15 0x4EA 0x16 0x4DC 0x17 0x4CD
+		0x18 0x4BF 0x19 0x4B0 0x1A 0x4A1 0x1B 0x492 0x1C 0x483 0x1D 0x474
+		0x1E 0x464 0x1F 0x455 0x20 0x446 0x21 0x437 0x22 0x427 0x23 0x418
+		0x24 0x408 0x25 0x3F9 0x26 0x3E9 0x27 0x3D9 0x28 0x3CA 0x29 0x3BA
+		0x2A 0x3AB 0x2B 0x39B 0x2C 0x38C 0x2D 0x37D 0x2E 0x36D 0x2F 0x35E
+		0x30 0x34F 0x31 0x340 0x32 0x331 0x33 0x323 0x34 0x314 0x35 0x306
+		0x36 0x2F8 0x37 0x2E9>;
+	temp_warn = <41>;
+	temp_poweroff = <51>;
+	temp_resume = <34>;
+
+	fan0 {
+		duty-array-policy1 = <70 60 95 70>;	/* stock */
+		fg-gpio = <&pio 7 13 GPIO_ACTIVE_HIGH>;	/* PH13, stock fan0 fg-gpio */
+	};
+
+	bl0 {
+		duty-array = <50 75 30 75>;		/* stock */
+		dft_period_ns = <40000>;		/* stock, 25 kHz */
+		lamp-mode-names = "std", "low", "high";
+	};
+
+	ntc {
+		ntc_num = <1>;
+	};
+};
+
+/* The board manager owns PWM2 here (bl0); two owners would fight over it. */
+&backlight {
+	status = "disabled";
+};
+
+&arisc {
+	firmware-name = "h713-arisc.bin", "hy310-edid.bin";
+};
