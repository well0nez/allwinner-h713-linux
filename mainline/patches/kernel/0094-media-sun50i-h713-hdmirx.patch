+/* ------------------------------------------------------------------ *
+ * Probe
+ * ------------------------------------------------------------------ */
+
+static struct device_node *h713_hdmirx_region(struct device *dev,
+					      const char *name)
+{
+	int idx = of_property_match_string(dev->of_node, "memory-region-names",
+					   name);
+
+	if (idx < 0)
+		return NULL;
+
+	return of_parse_phandle(dev->of_node, "memory-region", idx);
+}
+
+static int h713_hdmirx_get_region(struct device *dev, const char *name,
+				  phys_addr_t *base, phys_addr_t *size)
+{
+	struct device_node *np;
+	struct resource res;
+	int ret;
+
+	np = h713_hdmirx_region(dev, name);
+	if (!np)
+		return dev_err_probe(dev, -EINVAL,
+				     "memory-region \"%s\" fehlt\n", name);
+
+	ret = of_address_to_resource(np, 0, &res);
+	of_node_put(np);
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "memory-region \"%s\" unbrauchbar\n",
+				     name);
+	if (upper_32_bits(res.end))
+		return dev_err_probe(dev, -ERANGE,
+				     "memory-region \"%s\" liegt oberhalb 4 GiB -- der MIPS sieht sie nicht\n",
+				     name);
+
+	*base = res.start;
+	*size = resource_size(&res);
+
+	return 0;
+}
+
+/* Every ring slot has to lie inside the region the device tree named. */
+static int h713_hdmirx_check_ring(struct h713_hdmirx *rx)
+{
+	unsigned int i;
+
+	for (i = 0; i < H713_HDMIRX_SLOTS; i++) {
+		phys_addr_t y = h713_hdmirx_slot_y[i];
+		phys_addr_t c = h713_hdmirx_slot_c[i];
+
+		if (!h713_hdmirx_in_ring(rx, y) ||
+		    !h713_hdmirx_in_ring(rx, y + H713_HDMIRX_SLOT_PITCH - 1) ||
+		    !h713_hdmirx_in_ring(rx, c) ||
+		    !h713_hdmirx_in_ring(rx, c + H713_HDMIRX_SLOT_PITCH - 1))
+			return dev_err_probe(rx->dev, -ERANGE,
+					     "Slot %u (%pa/%pa) liegt nicht in der hdmi-ring-Region\n",
+					     i, &y, &c);
+	}
+
+	return 0;
+}
+
+/*
+ * The two routines the firmware calls back into. Registering them is not
+ * only a matter of this driver: cpu_comm_register_callback() installs a
+ * descriptor for the name in the routine table in shared memory, and
+ * without that descriptor the firmware's own name lookup fails and it
+ * never sends the call.
+ *
+ * Which is also why this is the *last* thing the probe does. The
+ * descriptor is what arms the sender, so from the moment it is in the
+ * table the firmware can call in, on the cpu_comm receive work item, in
+ * parallel with whatever this driver is doing. Registering first -- which
+ * is what the first version of this did, and what the userspace bring-up
+ * script does -- puts that incoming call in the middle of the bring-up
+ * chain: twenty-two synchronous RPCs to the MIPS, then the ARISC EDID and
+ * hotplug sequence. On 07.09. one delivered callback was enough to break
+ * that chain, in a different place on each of two cold starts (step 15
+ * timed out on one, the ARISC refused the port map on the other).
+ *
+ * Nothing is lost by registering late, and that is not a judgement call:
+ * both handlers end in h713_hdmirx_src_change(), which queues a V4L2
+ * source-change event, and a V4L2 event goes to subscribed file handles.
+ * Before video_register_device() there is no video node, so there is no
+ * handle and no subscription, and every event queued until then would be
+ * dropped anyway. The window that is really given up is the few
+ * microseconds between video_register_device() and here.
+ */
+#define H713_HDMIRX_CB_SIGNAL	"MipsHalCallback_SignalChange"
+#define H713_HDMIRX_CB_HOTPLUG	"MipsHalCallback_HdmiHotPlugByPortHandler"
+
+static int h713_hdmirx_register_callbacks(struct h713_hdmirx *rx)
+{
+	int ret;
+
+	ret = cpu_comm_register_callback(H713_HDMIRX_CB_SIGNAL,
+					 h713_hdmirx_signal_cb, rx);
+	if (ret)
+		return ret;
+
+	ret = cpu_comm_register_callback(H713_HDMIRX_CB_HOTPLUG,
+					 h713_hdmirx_hotplug_cb, rx);
+	if (ret) {
+		cpu_comm_unregister_callback(H713_HDMIRX_CB_SIGNAL,
+					     h713_hdmirx_signal_cb);
+		return ret;
+	}
+
+	return 0;
+}
+
+static void h713_hdmirx_unregister_callbacks(struct h713_hdmirx *rx)
+{
+	cpu_comm_unregister_callback(H713_HDMIRX_CB_SIGNAL,
+				     h713_hdmirx_signal_cb);
+	cpu_comm_unregister_callback(H713_HDMIRX_CB_HOTPLUG,
+				     h713_hdmirx_hotplug_cb);
+}
+
+static int h713_hdmirx_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct h713_afbd_flip flip;
+	struct h713_hdmirx *rx;
+	struct vb2_queue *q;
+	int ret;
+
+	rx = devm_kzalloc(dev, sizeof(*rx), GFP_KERNEL);
+	if (!rx)
+		return -ENOMEM;
+
+	rx->dev = dev;
+	rx->slot_source = &h713_hdmirx_vsync;
+	rx->flip_nb.notifier_call = h713_hdmirx_flip_notify;
+	rx->timings = h713_hdmirx_timings;
+	rx->last_slot = -1;
+	mutex_init(&rx->lock);
+	spin_lock_init(&rx->slot_lock);
+	spin_lock_init(&rx->event_lock);
+
+	rx->id_setsource = cpu_comm_name2id("THal_Vp_SetSource",
+					    CPU_COMM_CPU_MIPS);
+	if (!rx->id_setsource)
+		return -EINVAL;
+
+	/*
+	 * The display driver is where the finished-slot events come from, and
+	 * it is the only place they can come from on this SoC. Ask it for the
+	 * flip pair once, before anything is registered: -EPROBE_DEFER means
+	 * display@5600000 has not bound yet, -ENODEV that the driver is not in
+	 * this kernel at all, and -EAGAIN only that there is no signal on the
+	 * input right now, which is none of this driver's business at probe.
+	 */
+	ret = h713_afbd_read_flip(&flip);
+	if (ret == -EPROBE_DEFER || ret == -ENODEV)
+		return dev_err_probe(dev, ret,
+				     "kein AFBD-Vsync-Notifier -- ohne sun50i-h713-afbd gibt es kein Slot-Ereignis\n");
+
+	ret = h713_hdmirx_get_region(dev, "hdmi-ring", &rx->ring_base,
+				     &rx->ring_size);
+	if (ret)
+		return ret;
+
+	ret = h713_hdmirx_check_ring(rx);
+	if (ret)
+		return ret;
+
+	ret = h713_hdmirx_get_region(dev, "cpu-comm-shmem", &rx->shm_base,
+				     &rx->shm_size);
+	if (ret)
+		return ret;
+	if (rx->shm_size < H713_SHM_VP_INIT)
+		return dev_err_probe(dev, -ERANGE,
+				     "cpu-comm-shmem ist zu klein fuer den Vp_Init-Puffer\n");
+
+	/*
+	 * Only the two pages that hold call arguments are mapped. Write
+	 * combining, and written word by word: this region is shared with a
+	 * co-processor and a wide unaligned store into it has faulted before.
+	 */
+	rx->shm = devm_ioremap_wc(dev, rx->shm_base + H713_SHM_HDCP22,
+				  H713_SHM_WINDOW);
+	if (!rx->shm)
+		return dev_err_probe(dev, -ENOMEM,
+				     "cpu_comm-Shmem-Fenster nicht abbildbar\n");
+
+	/* Stage 3: the firmware bring-up sequence. */
+	ret = h713_hdmirx_run_init_seq(rx);
+	if (ret) {
+		/*
+		 * -EAGAIN means the co-processor has not reached application
+		 * readiness yet, -ENODEV that cpu_comm has not bound its own
+		 * device yet -- this node has no phandle to it, so nothing
+		 * orders the two probes. Both are a reason to come back, not
+		 * to fail.
+		 */
+		if (ret == -EAGAIN || ret == -ENODEV)
+			ret = -EPROBE_DEFER;
+		return dev_err_probe(dev, ret,
+				     "Init-Sequenz fehlgeschlagen\n");
+	}
+
+	/*
+	 * Stage 4: EDID into the receiver and hotplug up. This is the ARISC's
+	 * job and it takes the ten seconds the hotplug pulse needs, which is
+	 * why this driver probes asynchronously.
+	 */
+	ret = arisc_hdmi_edid_init(H713_HDMI_PORT, NULL, 0);
+	if (ret) {
+		if (ret == -ENODEV)
+			ret = -EPROBE_DEFER;
+		return dev_err_probe(dev, ret,
+				     "EDID/HPD-Sequenz fehlgeschlagen\n");
+	}
+
+	q = &rx->queue;
+	q->type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+	q->io_modes = VB2_MMAP;
+	q->drv_priv = rx;
+	q->buf_struct_size = sizeof(struct h713_hdmirx_buffer);
+	q->ops = &h713_hdmirx_qops;
+	q->mem_ops = &h713_hdmirx_mem_ops;
+	q->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_MONOTONIC;
+	q->lock = &rx->lock;
+	q->dev = dev;
+	/*
+	 * Not max_num_buffers: vb2_core_queue_init() refuses any value below
+	 * VB2_MAX_FRAME. The count is pinned to the three slots in
+	 * h713_hdmirx_queue_setup() and h713_hdmirx_alloc() instead.
+	 */
+	q->min_queued_buffers = 1;
+
+	ret = vb2_queue_init(q);
+	if (ret)
+		return ret;
+
+	ret = v4l2_device_register(dev, &rx->v4l2_dev);
+	if (ret)
+		return ret;
+
+	rx->vdev.fops = &h713_hdmirx_fops;
+	rx->vdev.ioctl_ops = &h713_hdmirx_ioctl_ops;
+	rx->vdev.v4l2_dev = &rx->v4l2_dev;
+	rx->vdev.queue = q;
+	rx->vdev.lock = &rx->lock;
+	rx->vdev.release = video_device_release_empty;
+	rx->vdev.device_caps = V4L2_CAP_VIDEO_CAPTURE_MPLANE |
+			       V4L2_CAP_STREAMING;
+	strscpy(rx->vdev.name, H713_HDMIRX_NAME, sizeof(rx->vdev.name));
+	video_set_drvdata(&rx->vdev, rx);
+
+	ret = video_register_device(&rx->vdev, VFL_TYPE_VIDEO, -1);
+	if (ret)
+		goto err_v4l2;
+
+	/*
+	 * Stage 5, and deliberately the last one: tell the firmware where to
+	 * call. Everything above talks to the two co-processors and cannot
+	 * take a call from one of them while it does; from here on the driver
+	 * is idle and there is a video node for the events to reach. See
+	 * h713_hdmirx_register_callbacks().
+	 *
+	 * -ENODEV cannot mean "cpu_comm has not bound yet" at this point --
+	 * twenty-two calls have just gone through it -- so there is nothing
+	 * to defer for and the probe fails instead.
+	 */
+	ret = h713_hdmirx_register_callbacks(rx);
+	if (ret) {
+		dev_err_probe(dev, ret, "Callbacks nicht registrierbar\n");
+		goto err_vdev;
+	}
+
+	rx->debugfs = debugfs_create_dir(H713_HDMIRX_NAME, NULL);
+	debugfs_create_file("status", 0444, rx->debugfs, rx,
+			    &h713_hdmirx_status_fops);
+
+	platform_set_drvdata(pdev, rx);
+	dev_info(dev, "/dev/video%d, Slot-Quelle: %s\n", rx->vdev.num,
+		 rx->slot_source->name);
+
+	return 0;
+
+err_vdev:
+	vb2_video_unregister_device(&rx->vdev);
+err_v4l2:
+	v4l2_device_unregister(&rx->v4l2_dev);
+
+	return ret;
+}
+
+static void h713_hdmirx_remove(struct platform_device *pdev)
+{
+	struct h713_hdmirx *rx = platform_get_drvdata(pdev);
+
+	debugfs_remove_recursive(rx->debugfs);
+	vb2_video_unregister_device(&rx->vdev);
+	v4l2_device_unregister(&rx->v4l2_dev);
+	h713_hdmirx_unregister_callbacks(rx);
+}
+
+static const struct of_device_id h713_hdmirx_of_match[] = {
+	{ .compatible = "allwinner,sun50i-h713-hdmirx" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, h713_hdmirx_of_match);
+
+static struct platform_driver h713_hdmirx_driver = {
+	.probe	= h713_hdmirx_probe,
+	.remove	= h713_hdmirx_remove,
+	.driver	= {
+		.name		= H713_HDMIRX_NAME,
+		.of_match_table	= h713_hdmirx_of_match,
+		/*
+		 * The EDID/hotplug part of the bring-up holds the pin low for
+		 * ten seconds. That must not sit in the middle of the boot.
+		 */
+		.probe_type	= PROBE_PREFER_ASYNCHRONOUS,
+	},
+};
+module_platform_driver(h713_hdmirx_driver);
+
+MODULE_DESCRIPTION("Allwinner H713 HDMI receiver");
+MODULE_AUTHOR("well0nez <well0nez@users.noreply.github.com>");
+MODULE_LICENSE("GPL");
+MODULE_FIRMWARE(H713_FW_HDCP22);
