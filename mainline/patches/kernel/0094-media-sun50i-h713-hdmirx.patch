+
+static int h713_hdmirx_queue_setup(struct vb2_queue *q, unsigned int *nbuffers,
+				   unsigned int *nplanes, unsigned int sizes[],
+				   struct device *alloc_devs[])
+{
+	/*
+	 * Three buffers, never more and never fewer: there are three slots and
+	 * buffer i is slot i. A smaller queue would throw away every frame
+	 * that lands in a slot with no buffer behind it, and there is nothing
+	 * a larger one could point at.
+	 */
+	*nbuffers = H713_HDMIRX_SLOTS;
+
+	if (*nplanes) {
+		if (*nplanes != H713_HDMIRX_PLANES ||
+		    sizes[0] < H713_HDMIRX_PLANE_SIZE ||
+		    sizes[1] < H713_HDMIRX_PLANE_SIZE)
+			return -EINVAL;
+		return 0;
+	}
+
+	*nplanes = H713_HDMIRX_PLANES;
+	sizes[0] = H713_HDMIRX_PLANE_SIZE;
+	sizes[1] = H713_HDMIRX_PLANE_SIZE;
+
+	return 0;
+}
+
+static int h713_hdmirx_buf_prepare(struct vb2_buffer *vb)
+{
+	unsigned int i;
+
+	if (vb->index >= H713_HDMIRX_SLOTS)
+		return -EINVAL;
+
+	for (i = 0; i < H713_HDMIRX_PLANES; i++)
+		if (vb2_plane_size(vb, i) < H713_HDMIRX_PLANE_SIZE)
+			return -EINVAL;
+
+	return 0;
+}
+
+static void h713_hdmirx_buf_queue(struct vb2_buffer *vb)
+{
+	struct h713_hdmirx *rx = vb2_get_drv_priv(vb->vb2_queue);
+	struct vb2_v4l2_buffer *vbuf = to_vb2_v4l2_buffer(vb);
+	unsigned long flags;
+
+	spin_lock_irqsave(&rx->slot_lock, flags);
+	rx->slot_buf[vb->index] = vbuf;
+	spin_unlock_irqrestore(&rx->slot_lock, flags);
+}
+
+static int h713_hdmirx_start_streaming(struct vb2_queue *q, unsigned int count)
+{
+	struct h713_hdmirx *rx = vb2_get_drv_priv(q);
+	unsigned long flags;
+	unsigned int i;
+	int ret;
+
+	spin_lock_irqsave(&rx->slot_lock, flags);
+	rx->sequence = 0;
+	rx->last_slot = -1;
+	rx->last_flip_y = 0;
+	rx->last_flip_c = 0;
+	memset(&rx->stat, 0, sizeof(rx->stat));
+	spin_unlock_irqrestore(&rx->slot_lock, flags);
+
+	ret = rx->slot_source->start(rx);
+	if (ret)
+		goto err;
+
+	return 0;
+
+err:
+	spin_lock_irqsave(&rx->slot_lock, flags);
+	for (i = 0; i < H713_HDMIRX_SLOTS; i++) {
+		struct vb2_v4l2_buffer *vbuf = rx->slot_buf[i];
+
+		rx->slot_buf[i] = NULL;
+		if (vbuf)
+			vb2_buffer_done(&vbuf->vb2_buf, VB2_BUF_STATE_QUEUED);
+	}
+	spin_unlock_irqrestore(&rx->slot_lock, flags);
+
+	return ret;
+}
+
+static void h713_hdmirx_stop_streaming(struct vb2_queue *q)
+{
+	struct h713_hdmirx *rx = vb2_get_drv_priv(q);
+	unsigned long flags;
+	unsigned int i;
+
+	rx->slot_source->stop(rx);
+
+	spin_lock_irqsave(&rx->slot_lock, flags);
+	for (i = 0; i < H713_HDMIRX_SLOTS; i++) {
+		struct vb2_v4l2_buffer *vbuf = rx->slot_buf[i];
+
+		rx->slot_buf[i] = NULL;
+		if (vbuf)
+			vb2_buffer_done(&vbuf->vb2_buf, VB2_BUF_STATE_ERROR);
+	}
+	spin_unlock_irqrestore(&rx->slot_lock, flags);
+
+	dev_dbg(rx->dev,
+		"Streaming beendet: %u Vsync-Ereignisse, %u geliefert, %u ohne Puffer, %u uebersprungen, %u unveraendert, %u fremd\n",
+		rx->stat.events, rx->stat.delivered, rx->stat.no_buffer,
+		rx->stat.skipped, rx->stat.unchanged, rx->stat.stray);
+}
+
+static const struct vb2_ops h713_hdmirx_qops = {
