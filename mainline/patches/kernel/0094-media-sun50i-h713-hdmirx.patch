+
+/* ------------------------------------------------------------------ */
+
+struct h713_hdmirx;
+
+/**
+ * struct h713_hdmirx_slot_source - where "this slot is finished" comes from
+ * @name: shown in the log and in debugfs, so a run says which one was used
+ * @start: begin delivering events, called from start_streaming()
+ * @stop: stop delivering them, called from stop_streaming(); after it returns
+ *	no further event may arrive
+ *
+ * Every implementation funnels into h713_hdmirx_slot_event(), which is where
+ * all of the queue handling lives; a slot source is nothing but the clock.
+ * Today there is exactly one, the display driver's vsync notifier. The seam
+ * stays because a real capture interrupt could still turn up on the MIPS side
+ * (RE question K2, doku/84) and would need nothing from the rest of this
+ * driver but its own start/stop.
+ */
+struct h713_hdmirx_slot_source {
+	const char *name;
+	int (*start)(struct h713_hdmirx *rx);
+	void (*stop)(struct h713_hdmirx *rx);
+};
+
+struct h713_hdmirx_buffer {
+	struct vb2_v4l2_buffer vb;
+};
+
+/**
+ * struct h713_hdmirx_plane - one plane of one buffer, permanently a ring slot
+ * @rx: back pointer
+ * @phys: physical address of the slot
+ * @size: usable length of the slot
+ * @refcount: number of live mmaps, tracked by vb2_common_vm_ops
+ * @handler: what vb2_common_vm_ops needs to do that
+ */
+struct h713_hdmirx_plane {
+	struct h713_hdmirx *rx;
+	phys_addr_t phys;
+	unsigned long size;
+	refcount_t refcount;
+	struct vb2_vmarea_handler handler;
+};
+
+struct h713_hdmirx {
+	struct device *dev;
+	struct v4l2_device v4l2_dev;
+	struct video_device vdev;
+	struct vb2_queue queue;
+	struct mutex lock;		/* serialises ioctl and queue */
+	struct dentry *debugfs;
+
+	void __iomem *shm;		/* cpu_comm shared memory window */
+	phys_addr_t shm_base;		/* base of the whole shared memory */
+	phys_addr_t shm_size;
+	phys_addr_t ring_base;		/* the firmware's framebuffer region */
+	phys_addr_t ring_size;
+
+	u32 id_setsource;
+
+	struct v4l2_dv_timings timings;
+
+	/* slot bookkeeping, all of it under slot_lock */
+	spinlock_t slot_lock;
+	struct vb2_v4l2_buffer *slot_buf[H713_HDMIRX_SLOTS];
+	u32 last_flip_y;
+	u32 last_flip_c;
+	int last_slot;
+	u32 sequence;
+	struct {
+		u32 events;
+		u32 delivered;
+		u32 no_buffer;
+		u32 unchanged;
+		u32 skipped;
+		u32 stray;
+	} stat;
+
+	const struct h713_hdmirx_slot_source *slot_source;
+	struct notifier_block flip_nb;
+
+	/* last callback payloads, for debugfs and the source change event */
+	spinlock_t event_lock;
+	u32 signal_args[CPU_COMM_MAX_ARGS];
+	unsigned int signal_nargs;
+	u32 signal_count;
+	u32 hotplug_args[CPU_COMM_MAX_ARGS];
+	unsigned int hotplug_nargs;
+	u32 hotplug_count;
+
+	u8 edid[ARISC_HDMI_EDID_SIZE];
+	bool edid_valid;
+};
+
+/* ------------------------------------------------------------------ *
+ * The firmware bring-up sequence
+ * ------------------------------------------------------------------ */
+
+static int h713_hdmirx_call(struct h713_hdmirx *rx, const char *name,
+			    const u32 *args, unsigned int nargs,
+			    unsigned int timeout_ms)
+{
+	u32 id = cpu_comm_name2id(name, CPU_COMM_CPU_MIPS);
+	int ret;
+
+	if (!id)
+		return -EINVAL;
+
+	ret = cpu_comm_call(id, args, nargs, NULL, 0, timeout_ms);
+	if (ret < 0)
+		return ret;
+
+	return 0;
+}
+
+/*
+ * Write the two window rectangles and the aspect selector into shared memory
+ * and hand back their addresses. The shared memory is mapped write combining;
+ * it is written word by word because a wide unaligned access into this region
+ * has faulted before (doku/67).
+ */
+static void h713_hdmirx_wce_args(struct h713_hdmirx *rx, u32 *args)
+{
+	static const u32 window[4] = {
+		0, H713_HDMIRX_WIDTH, 0, H713_HDMIRX_HEIGHT,
+	};
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(window); i++) {
+		writel(window[i], rx->shm + H713_MAP_WCE + H713_WCE_SRC + i * 4);
+		writel(window[i], rx->shm + H713_MAP_WCE + H713_WCE_DST + i * 4);
+	}
+	writel(H713_WCE_ASPECT_16_9, rx->shm + H713_MAP_WCE + H713_WCE_ASPECT);
+
+	args[0] = rx->shm_base + H713_SHM_WCE + H713_WCE_SRC;
+	args[1] = rx->shm_base + H713_SHM_WCE + H713_WCE_DST;
+	args[2] = rx->shm_base + H713_SHM_WCE + H713_WCE_ASPECT;
+}
+
+/*
+ * Put the HDCP 2.2 key where the firmware expects it. The key itself is
+ * vendor material and is not in this tree; it is loaded as firmware, and
+ * without it the step is skipped. Copied as words for the same reason as
+ * above.
+ */
+static int h713_hdmirx_load_hdcp_key(struct h713_hdmirx *rx, u32 *args)
+{
+	const struct firmware *fw;
+	unsigned int i;
+	int ret;
+
+	ret = request_firmware(&fw, H713_FW_HDCP22, rx->dev);
+	if (ret)
+		return ret;
+
+	if (fw->size != H713_HDCP22_SIZE) {
+		dev_err(rx->dev, "%s ist %zu Byte gross, erwartet sind %d\n",
+			H713_FW_HDCP22, fw->size, H713_HDCP22_SIZE);
+		release_firmware(fw);
+		return -EINVAL;
+	}
+
+	for (i = 0; i < H713_HDCP22_SIZE / 4; i++)
+		writel(get_unaligned_le32(fw->data + i * 4),
+		       rx->shm + H713_MAP_HDCP22 + i * 4);
+
+	release_firmware(fw);
+
+	args[0] = rx->shm_base + H713_SHM_HDCP22;
+	args[1] = H713_HDCP22_SIZE;
+
+	return 0;
+}
+
+static int h713_hdmirx_run_init_seq(struct h713_hdmirx *rx)
+{
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < ARRAY_SIZE(h713_hdmirx_init_seq); i++) {
+		const struct h713_hdmirx_step *s = &h713_hdmirx_init_seq[i];
+		u32 args[3] = { 0, 0, 0 };
+
+		switch (s->kind) {
+		case H713_STEP_PLAIN:
+			memcpy(args, s->args, sizeof(args));
+			break;
+		case H713_STEP_VP_INIT:
+			args[2] = rx->shm_base + H713_SHM_VP_INIT;
+			break;
+		case H713_STEP_WCE:
+			h713_hdmirx_wce_args(rx, args);
+			break;
+		case H713_STEP_HDCP:
+			ret = h713_hdmirx_load_hdcp_key(rx, args);
+			if (ret) {
+				dev_warn(rx->dev,
+					 "Schritt %u %s uebersprungen: %s nicht ladbar (%d)\n",
+					 i, s->name, H713_FW_HDCP22, ret);
+				continue;
+			}
+			break;
+		}
+
+		ret = h713_hdmirx_call(rx, s->name, args, s->nargs,
+				       s->timeout_ms);
+		if (ret) {
+			dev_err(rx->dev,
+				"Schritt %u %s (Stock-Session %u) fehlgeschlagen: %d\n",
+				i, s->name, s->session, ret);
+			return ret;
+		}
+	}
+
+	dev_info(rx->dev, "Init-Sequenz vollstaendig (%zu Aufrufe)\n",
+		 ARRAY_SIZE(h713_hdmirx_init_seq));
+
+	return 0;
+}
+
+/*
+ * Stage 5 of the source change. Two things about it are worth knowing and
+ * both are measured: if the firmware's active source already is HDMI-1 this
+ * is a null change and moves nothing, which is normal and not an error; and
+ * a real change away and back does not make the capture run again by itself
+ * (doku/78 appendix A.5, open point A.6 item 1).
+ */
+static int h713_hdmirx_set_source(struct h713_hdmirx *rx)
+{
+	u32 arg = H713_SOURCE_HDMI1;
+
+	return cpu_comm_call(rx->id_setsource, &arg, 1, NULL, 0, 0);
+}
+
+/* ------------------------------------------------------------------ *
+ * Callbacks from the firmware
+ * ------------------------------------------------------------------ */
+
+static void h713_hdmirx_src_change(struct h713_hdmirx *rx)
+{
+	static const struct v4l2_event ev = {
+		.type = V4L2_EVENT_SOURCE_CHANGE,
+		.u.src_change.changes = V4L2_EVENT_SRC_CH_RESOLUTION,
+	};
+
+	/*
+	 * video_register_device() is what initialises vdev->fh_list and
+	 * vdev->fh_lock, so queueing an event before it walks a list whose
+	 * head is still NULL. The callbacks are registered after that call
+	 * for exactly this reason among others, which leaves this guard for
+	 * the other end: h713_hdmirx_remove() takes the video node down
+	 * before it unregisters the callbacks, so a call the firmware had
+	 * already put on the wire can still arrive here afterwards.
+	 */
+	if (!video_is_registered(&rx->vdev))
+		return;
+
+	v4l2_event_queue(&rx->vdev, &ev);
+}
+
+/*
+ * MipsHalCallback_SignalChange. Measured behaviour (doku/nachtlog/K4): the
+ * firmware fires this by itself both when the signal goes away and when it
+ * comes back, so the V4L2 source change event can hang straight off it.
+ *
+ * Para[0] is the source id, 3 for HDMI-1. Para[2] is a physical pointer to a
+ * 44 byte signal information record in shared memory. Only one field of that
+ * record is decoded so far (+16 is the frame descriptor's colour format plus
+ * one, doku/84), which is why this handler stores the raw words for debugfs
+ * instead of pretending to parse them.
+ */
+static void h713_hdmirx_signal_cb(u32 comp_id, const u32 *args,
+				  unsigned int nargs, void *ctx)
+{
+	struct h713_hdmirx *rx = ctx;
+	unsigned long flags;
+
+	spin_lock_irqsave(&rx->event_lock, flags);
+	rx->signal_nargs = min_t(unsigned int, nargs, CPU_COMM_MAX_ARGS);
+	if (args)
+		memcpy(rx->signal_args, args, rx->signal_nargs * sizeof(*args));
+	rx->signal_count++;
+	spin_unlock_irqrestore(&rx->event_lock, flags);
+
+	dev_dbg(rx->dev, "SignalChange source=%u nargs=%u\n",
+		nargs ? args[0] : 0, nargs);
+
+	h713_hdmirx_src_change(rx);
+}
+
+/* MipsHalCallback_HdmiHotPlugByPortHandler. Para[0] is the port. */
+static void h713_hdmirx_hotplug_cb(u32 comp_id, const u32 *args,
+				   unsigned int nargs, void *ctx)
+{
+	struct h713_hdmirx *rx = ctx;
+	unsigned long flags;
+
+	spin_lock_irqsave(&rx->event_lock, flags);
+	rx->hotplug_nargs = min_t(unsigned int, nargs, CPU_COMM_MAX_ARGS);
+	if (args)
+		memcpy(rx->hotplug_args, args,
+		       rx->hotplug_nargs * sizeof(*args));
+	rx->hotplug_count++;
+	spin_unlock_irqrestore(&rx->event_lock, flags);
+
+	dev_dbg(rx->dev, "HdmiHotPlugByPort port=%u\n", nargs ? args[0] : 0);
+
+	h713_hdmirx_src_change(rx);
+}
+
+/* ------------------------------------------------------------------ *
+ * The ring: which slot has just been finished
+ * ------------------------------------------------------------------ */
+
+static bool h713_hdmirx_in_ring(struct h713_hdmirx *rx, u32 addr)
+{
+	return addr >= rx->ring_base && addr < rx->ring_base + rx->ring_size;
+}
+
+static int h713_hdmirx_slot_of(u32 y)
+{
+	unsigned int i;
+
+	for (i = 0; i < H713_HDMIRX_SLOTS; i++)
+		if (h713_hdmirx_slot_y[i] == y)
+			return i;
+
+	return -1;
+}
+
+/**
+ * h713_hdmirx_slot_event() - a slot has been finished, hand it on
+ * @rx: the device
+ * @flip: the flip pointer pair the producer sampled, already whole and already
+ *	known to point into the capture ring
+ *
+ * The single entry point every slot source funnels into. Safe from atomic
+ * context -- it runs in the display's vsync interrupt today. Counts what it
+ * could not do rather than dropping it silently: a rate mismatch has to be
+ * visible.
+ */
+static void h713_hdmirx_slot_event(struct h713_hdmirx *rx,
+				   const struct h713_afbd_flip *flip)
+{
+	struct vb2_v4l2_buffer *vbuf;
+	unsigned long flags;
+	u32 y = flip->y;
+	int slot;
+
+	spin_lock_irqsave(&rx->slot_lock, flags);
+
+	rx->stat.events++;
+	rx->last_flip_c = flip->c;
+
+	/*
+	 * The producer only reports a pair that changed, so this is a
+	 * belt-and-braces test: it firing means the two ends disagree about
+	 * what "changed" is, and that is worth seeing in debugfs.
+	 */
+	if (y == rx->last_flip_y) {
+		rx->stat.unchanged++;
+		goto out;
+	}
+
+	slot = h713_hdmirx_slot_of(y);
+	if (slot < 0) {
+		rx->stat.stray++;
+		goto out;
+	}
+
+	if (rx->last_slot >= 0) {
+		int gap = slot - rx->last_slot;
+
+		if (gap <= 0)
+			gap += H713_HDMIRX_SLOTS;
+		rx->stat.skipped += gap - 1;
+	}
+	rx->last_flip_y = y;
+	rx->last_slot = slot;
+
+	vbuf = rx->slot_buf[slot];
+	if (!vbuf) {
+		rx->stat.no_buffer++;
+		goto out;
+	}
+	rx->slot_buf[slot] = NULL;
+
+	vbuf->vb2_buf.timestamp = ktime_get_ns();
+	vbuf->sequence = rx->sequence++;
+	vbuf->field = V4L2_FIELD_NONE;
+	vb2_set_plane_payload(&vbuf->vb2_buf, 0, H713_HDMIRX_PLANE_SIZE);
+	vb2_set_plane_payload(&vbuf->vb2_buf, 1, H713_HDMIRX_PLANE_SIZE);
+	rx->stat.delivered++;
+
+	spin_unlock_irqrestore(&rx->slot_lock, flags);
+	vb2_buffer_done(&vbuf->vb2_buf, VB2_BUF_STATE_DONE);
+	return;
+
+out:
+	spin_unlock_irqrestore(&rx->slot_lock, flags);
+}
+
+/*
+ * The one slot source: the display driver's vsync.
+ *
+ * There used to be a 120 Hz timer here that sampled the flip pair itself. It
+ * is gone rather than kept as a fallback. It sampled a register pair this
+ * driver had no business mapping, at a rate unrelated to the event it was
+ * looking for -- half of its wakeups found nothing and the other half found a
+ * slot that had been finished up to 8 ms earlier. A sampling clock running
+ * quietly beside the real event is exactly the kind of quirk this tree does
+ * not keep, and there is no configuration in which it would be the better of
+ * the two: without sun50i-h713-afbd there is no display, no plane, no
+ * descriptor and no ring bounds either, so the driver has nothing to fall
+ * back to.
+ */
+static int h713_hdmirx_flip_notify(struct notifier_block *nb,
+				   unsigned long action, void *data)
+{
+	struct h713_hdmirx *rx = container_of(nb, struct h713_hdmirx, flip_nb);
+
+	if (action != H713_AFBD_EVENT_FLIP)
+		return NOTIFY_DONE;
+
+	h713_hdmirx_slot_event(rx, data);
+
+	return NOTIFY_OK;
+}
+
+static int h713_hdmirx_vsync_start(struct h713_hdmirx *rx)
+{
+	return h713_afbd_register_flip_notifier(&rx->flip_nb);
+}
+
+static void h713_hdmirx_vsync_stop(struct h713_hdmirx *rx)
+{
+	h713_afbd_unregister_flip_notifier(&rx->flip_nb);
+}
+
+static const struct h713_hdmirx_slot_source h713_hdmirx_vsync = {
+	.name = "AFBD vsync notifier (GIC 142)",
+	.start = h713_hdmirx_vsync_start,
+	.stop = h713_hdmirx_vsync_stop,
+};
+
+/*
+ * Is there a signal? On signal loss the flip pointers stop moving and the
+ * last picture stays on screen -- measured, doku/nachtlog/K4-hotplug.md. So
+ * this looks at them for a bit more than one frame period instead of trusting
+ * a cached flag. A still picture is not a still ring: the pointers rotate at
+ * 60 Hz whatever the content is.
+ *
+ * This is the one question that cannot wait for the next notifier call --
+ * ENUM_INPUT and QUERY_DV_TIMINGS are answered while nothing is streaming --
+ * so it asks the display driver for the pair instead of reading it. Same two
+ * registers, same owner, no second mapping.
+ */
+static bool h713_hdmirx_signal_present(struct h713_hdmirx *rx)
+{
+	struct h713_afbd_flip a, b;
+
+	if (h713_afbd_read_flip(&a))
+		return false;
+
+	usleep_range(20000, 25000);
+
+	if (h713_afbd_read_flip(&b))
+		return false;
+
+	return a.y != b.y;
+}
+
+/* ------------------------------------------------------------------ *
+ * Buffers: buffer i is slot i, for the whole life of the queue
+ * ------------------------------------------------------------------ */
+
+static void h713_hdmirx_plane_put(void *arg)
+{
+	struct h713_hdmirx_plane *p = arg;
+
+	if (refcount_dec_and_test(&p->refcount))
+		kfree(p);
+}
+
+/*
+ * vb2 does not tell an allocator which plane it is being called for: it walks
+ * the planes of one buffer in order and stores each result in
+ * vb->planes[plane].mem_priv as it goes (__vb2_buf_mem_alloc()). The plane
+ * being allocated is therefore the first one that still has none.
+ */
+static int h713_hdmirx_plane_index(struct vb2_buffer *vb)
+{
+	unsigned int i;
+
+	for (i = 0; i < vb->num_planes; i++)
+		if (!vb->planes[i].mem_priv)
+			return i;
+
+	return -EINVAL;
+}
+
+static void *h713_hdmirx_alloc(struct vb2_buffer *vb, struct device *dev,
+			       unsigned long size)
+{
+	struct h713_hdmirx *rx = vb2_get_drv_priv(vb->vb2_queue);
+	struct h713_hdmirx_plane *p;
+	int plane;
+
+	plane = h713_hdmirx_plane_index(vb);
+	if (plane < 0)
+		return ERR_PTR(plane);
+
+	/*
+	 * vb2 rounds the plane length up to a page, so the check is against
+	 * the slot pitch and not against the payload size.
+	 */
+	if (vb->index >= H713_HDMIRX_SLOTS || plane >= H713_HDMIRX_PLANES ||
+	    size > H713_HDMIRX_SLOT_PITCH)
+		return ERR_PTR(-EINVAL);
+
+	p = kzalloc(sizeof(*p), GFP_KERNEL);
+	if (!p)
+		return ERR_PTR(-ENOMEM);
+
+	p->rx = rx;
+	p->phys = plane ? h713_hdmirx_slot_c[vb->index]
+			: h713_hdmirx_slot_y[vb->index];
+	p->size = size;
+	refcount_set(&p->refcount, 1);
+	p->handler.refcount = &p->refcount;
+	p->handler.put = h713_hdmirx_plane_put;
+	p->handler.arg = p;
+
+	return p;
+}
+
+static void h713_hdmirx_put(void *buf_priv)
+{
+	h713_hdmirx_plane_put(buf_priv);
+}
+
+static unsigned int h713_hdmirx_num_users(void *buf_priv)
+{
+	struct h713_hdmirx_plane *p = buf_priv;
+
+	return refcount_read(&p->refcount);
+}
+
+/*
+ * Hand the slot itself to userspace. Write combining, not cached: the writer
+ * is a co-processor whose stores never pass through this CPU's caches, so a
+ * cached mapping would show whatever was in the cache line.
+ */
+static int h713_hdmirx_mmap(void *buf_priv, struct vm_area_struct *vma)
+{
+	struct h713_hdmirx_plane *p = buf_priv;
+	int ret;
+
+	vma->vm_page_prot = pgprot_writecombine(vma->vm_page_prot);
+
+	ret = vm_iomap_memory(vma, p->phys, p->size);
+	if (ret)
+		return ret;
+
+	vma->vm_ops = &vb2_common_vm_ops;
+	vma->vm_private_data = &p->handler;
+	vma->vm_ops->open(vma);
+
+	return 0;
+}
+
