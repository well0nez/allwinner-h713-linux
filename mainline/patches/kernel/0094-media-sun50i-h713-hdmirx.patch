+/* ------------------------------------------------------------------ *
+ * debugfs
+ *
+ * One file. It exists because the board has neither v4l2-ctl nor modetest,
+ * so an acceptance run needs a way to see the state that does not depend on
+ * userspace tooling -- and because the signal information record still has to
+ * be decoded, and its raw words have to come from somewhere.
+ * ------------------------------------------------------------------ */
+
+static void h713_hdmirx_show_signal_info(struct seq_file *s,
+					 struct h713_hdmirx *rx, u32 phys)
+{
+	const u32 *info;
+	unsigned int i;
+
+	if (phys < rx->shm_base || phys + 44 > rx->shm_base + rx->shm_size) {
+		seq_printf(s, "signal-info: %#010x liegt nicht im cpu_comm-Shmem\n",
+			   phys);
+		return;
+	}
+
+	info = memremap(phys, 44, MEMREMAP_WC);
+	if (!info) {
+		seq_printf(s, "signal-info: %#010x nicht abbildbar\n", phys);
+		return;
+	}
+
+	seq_printf(s, "signal-info %#010x:", phys);
+	for (i = 0; i < 11; i++)
+		seq_printf(s, " %08x", info[i]);
+	seq_puts(s, "\n");
+
+	memunmap((void *)info);
+}
+
+static int h713_hdmirx_status_show(struct seq_file *s, void *unused)
+{
+	struct h713_hdmirx *rx = s->private;
+	struct h713_afbd_flip flip;
+	unsigned long flags;
+	unsigned int i;
+	int ret;
+	u32 y;
+
+	seq_printf(s, "input:        HDMI-1 (SetSource %u)\n",
+		   H713_SOURCE_HDMI1);
+	seq_printf(s, "format:       NV16M %ux%u, 2 Ebenen a %u Byte\n",
+		   H713_HDMIRX_WIDTH, H713_HDMIRX_HEIGHT,
+		   H713_HDMIRX_PLANE_SIZE);
+	seq_printf(s, "slot-quelle:  %s\n", rx->slot_source->name);
+
+	ret = h713_afbd_read_flip(&flip);
+	if (!ret)
+		seq_printf(s, "flip:         y=%#010x c=%#010x slot=%d\n",
+			   flip.y, flip.c, h713_hdmirx_slot_of(flip.y));
+	else
+		seq_printf(s, "flip:         nicht lesbar (%d)\n", ret);
+
+	seq_printf(s, "signal:       %s\n",
+		   h713_hdmirx_signal_present(rx) ? "vorhanden (Flip-Zeiger wandern)"
+						  : "kein Signal (Flip-Zeiger stehen)");
+	seq_printf(s, "timings:      %ux%u%s\n",
+		   rx->timings.bt.width, rx->timings.bt.height,
+		   rx->timings.bt.interlaced ? "i" : "p");
+	seq_printf(s, "streaming:    %s\n",
+		   vb2_is_streaming(&rx->queue) ? "ja" : "nein");
+
+	spin_lock_irqsave(&rx->slot_lock, flags);
+	seq_printf(s,
+		   "vsync:        %u Ereignisse, zuletzt y=%#010x c=%#010x slot=%d\n",
+		   rx->stat.events, rx->last_flip_y, rx->last_flip_c,
+		   rx->last_slot);
+	seq_printf(s,
+		   "frames:       %u geliefert, %u ohne Puffer, %u uebersprungen, %u unveraendert, %u fremd\n",
+		   rx->stat.delivered, rx->stat.no_buffer, rx->stat.skipped,
+		   rx->stat.unchanged, rx->stat.stray);
+	spin_unlock_irqrestore(&rx->slot_lock, flags);
+
+	spin_lock_irqsave(&rx->event_lock, flags);
+	seq_printf(s, "SignalChange: %u mal, Para[]", rx->signal_count);
+	for (i = 0; i < rx->signal_nargs; i++)
+		seq_printf(s, " %#010x", rx->signal_args[i]);
+	seq_puts(s, "\n");
+	seq_printf(s, "HotPlug:      %u mal, Para[]", rx->hotplug_count);
+	for (i = 0; i < rx->hotplug_nargs; i++)
+		seq_printf(s, " %#010x", rx->hotplug_args[i]);
+	seq_puts(s, "\n");
+	y = rx->signal_nargs > 2 ? rx->signal_args[2] : 0;
+	spin_unlock_irqrestore(&rx->event_lock, flags);
+
+	if (y)
+		h713_hdmirx_show_signal_info(s, rx, y);
+
+	for (i = 0; i < H713_HDMIRX_SLOTS; i++)
+		seq_printf(s, "slot %u:       y=%#010llx c=%#010llx\n", i,
+			   (u64)h713_hdmirx_slot_y[i],
+			   (u64)h713_hdmirx_slot_c[i]);
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(h713_hdmirx_status);
