+/*
+ * The EDID store behind this is not a plain EDID: the firmware wants the
+ * HDMI 1.4 block and the HDMI 2.0 block back to back, 512 bytes in total, and
+ * publishes nothing until the last of its eight fragments has arrived. V4L2
+ * sees that as one four-block EDID. It also patches the physical address byte
+ * and the checksum itself, so a read-back is not byte-identical to what was
+ * written.
+ */
+static int h713_hdmirx_g_edid(struct file *file, void *priv,
+			      struct v4l2_edid *edid)
+{
+	struct h713_hdmirx *rx = video_drvdata(file);
+	u8 buf[ARISC_HDMI_EDID_SIZE];
+	unsigned int blocks;
+	int ret;
+
+	if (edid->pad)
+		return -EINVAL;
+
+	blocks = ARISC_HDMI_EDID_SIZE / 128;
+
+	if (!edid->start_block && !edid->blocks) {
+		edid->blocks = blocks;
+		return 0;
+	}
+	if (edid->start_block >= blocks)
+		return -EINVAL;
+	if (edid->start_block + edid->blocks > blocks)
+		edid->blocks = blocks - edid->start_block;
+
+	ret = arisc_hdmi_get_edid(H713_HDMI_PORT, buf, sizeof(buf));
+	if (ret < (int)((edid->start_block + edid->blocks) * 128)) {
+		/*
+		 * The read-back is short or the co-processor did not answer.
+		 * What was written last is still the truth about the store,
+		 * so serve that rather than a half record.
+		 */
+		if (!rx->edid_valid)
+			return ret < 0 ? ret : -ENODATA;
+		memcpy(buf, rx->edid, sizeof(buf));
+	}
+
+	memcpy(edid->edid, buf + edid->start_block * 128, edid->blocks * 128);
+
+	return 0;
+}
+
+static int h713_hdmirx_s_edid(struct file *file, void *priv,
+			      struct v4l2_edid *edid)
+{
+	struct h713_hdmirx *rx = video_drvdata(file);
+	int ret;
+
+	if (edid->pad)
+		return -EINVAL;
+	if (edid->start_block)
+		return -EINVAL;
+
+	/* blocks == 0 means "no EDID": pull the hotplug pin low and stop. */
+	if (!edid->blocks) {
+		rx->edid_valid = false;
+		return arisc_hdmi_hpd(H713_HDMI_PORT, ARISC_HDMI_HPD_DOWN);
+	}
+
+	if (edid->blocks != ARISC_HDMI_EDID_SIZE / 128) {
+		edid->blocks = ARISC_HDMI_EDID_SIZE / 128;
+		return -E2BIG;
+	}
+
+	memcpy(rx->edid, edid->edid, ARISC_HDMI_EDID_SIZE);
+
+	ret = arisc_hdmi_edid_init(H713_HDMI_PORT, rx->edid,
+				   ARISC_HDMI_EDID_SIZE);
+	if (ret)
+		return ret;
+
+	rx->edid_valid = true;
+
+	return 0;
+}
