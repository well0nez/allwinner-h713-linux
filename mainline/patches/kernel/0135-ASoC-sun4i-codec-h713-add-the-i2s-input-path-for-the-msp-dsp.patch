+#define SUN50I_H713_I2S_FMT0_SAMPLE_RES			GENMASK(6, 4)
+#define SUN50I_H713_I2S_FMT0_BCLK_POLARITY		BIT(7)
+#define SUN50I_H713_I2S_FMT0_LRCK_PERIOD		GENMASK(17, 8)
+#define SUN50I_H713_I2S_FMT0_LRCK_POLARITY		BIT(19)
+#define SUN50I_H713_I2S_FMT0_FRAME_TYPE			BIT(30)
+#define SUN50I_H713_I2S_FMT1			(0x08)
+#define SUN50I_H713_I2S_FMT1_SIGN_EXTEND		GENMASK(5, 4)
+#define SUN50I_H713_I2S_FMT1_TX_MSB_FIRST		BIT(6)
+#define SUN50I_H713_I2S_FMT1_RX_MSB_FIRST		BIT(7)
+#define SUN50I_H713_I2S_CLKDIV			(0x24)
+/* Divider codes, not dividers: 4 means /6 and 8 means /24 (S25 §1). */
+#define SUN50I_H713_I2S_CLKDIV_MCLK			GENMASK(3, 0)
+#define SUN50I_H713_I2S_CLKDIV_MCLK_DIV6		4
+#define SUN50I_H713_I2S_CLKDIV_BCLK			GENMASK(7, 4)
+#define SUN50I_H713_I2S_CLKDIV_BCLK_DIV24		8
+#define SUN50I_H713_I2S_CLKDIV_MCLK_OUT			BIT(8)
+#define SUN50I_H713_I2S_CHCFG			(0x30)
+#define SUN50I_H713_I2S_CHCFG_TX_SLOT_NUM		GENMASK(3, 0)
+#define SUN50I_H713_I2S_CHCFG_RX_SLOT_NUM		GENMASK(7, 4)
+#define SUN50I_H713_I2S_TX0CHSEL		(0x34)
+#define SUN50I_H713_I2S_TX0CHMAP1		(0x48)
+#define SUN50I_H713_I2S_RXCHSEL			(0x64)
+#define SUN50I_H713_I2S_RXCHMAP3		(0x74)
+/* Shared by TX0CHSEL and RXCHSEL */
+#define SUN50I_H713_I2S_CHSEL_SLOT_EN			GENMASK(15, 0)
+#define SUN50I_H713_I2S_CHSEL_CHAN_NUM			GENMASK(19, 16)
+#define SUN50I_H713_I2S_MAX_REG			(0x7c)
+
