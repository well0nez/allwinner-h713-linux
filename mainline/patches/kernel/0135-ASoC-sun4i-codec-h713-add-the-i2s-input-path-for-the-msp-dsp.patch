+/*
+ * The DAC can also be fed from the second register window instead of from the
+ * APB FIFO: an I2S receiver that the SoC's audio DSP writes into. That is how
+ * the HDMI audio reaches the speaker, and it carries no PCM of its own -- the
+ * DSP is a separate island with no path into DRAM, so there is nothing for
+ * ALSA to open. Two controls drive it:
+ *
+ *   "DAC Source"  {APB, I2S}             which side the DAC listens to
+ *   "I2S Rate"    {32000, 44100, 48000}  the rate the receiver is clocked for
+ *
+ * The rate cannot be recovered from the incoming stream: this block is the
+ * clock master (S25 §1) and its dividers are fixed, so whoever knows the rate
+ * of the HDMI source has to say so. Getting it wrong is silent, not merely
+ * detuned -- on 08.09.2026 a 32 kHz source stayed inaudible while the codec
+ * was left at 48 kHz, and came back at 79.6 dB once the codec was moved to
+ * 32 kHz as well (S16 20:45).
+ */
+struct sun50i_h713_i2s_write {
+	unsigned int reg;
+	unsigned int mask;
+	unsigned int val;
+};
+
+/*
+ * sunxi_codec_i2s_init() @0xc0845230, all 21 writes in the vendor's order and
+ * with the vendor's values (S25 §2). There are no delays in the sequence. The
+ * values are constants here for the same reason they are constants there: the
+ * vendor's probe reads none of the DT properties that would describe them,
+ * and two of them disagree with its own device tree anyway (24 bit slots, not
+ * 32; MCLK /6, not /4).
+ */
+static const struct sun50i_h713_i2s_write sun50i_h713_i2s_init_seq[] = {
+	/* 1: leave reset */
+	{ SUN50I_H713_I2S_CTL, SUN50I_H713_I2S_CTL_GEN,
+	  SUN50I_H713_I2S_CTL_GEN },
+	/* 2: one frame per LRCK edge pair */
+	{ SUN50I_H713_I2S_FMT0, SUN50I_H713_I2S_FMT0_FRAME_TYPE, 0 },
+	/* 3: LRCK period 32 BCLKs */
+	{ SUN50I_H713_I2S_FMT0, SUN50I_H713_I2S_FMT0_LRCK_PERIOD,
+	  FIELD_PREP_CONST(SUN50I_H713_I2S_FMT0_LRCK_PERIOD, 32 - 1) },
+	/* 4: 24 bit slots, encoded as slot_width / 4 - 1 */
+	{ SUN50I_H713_I2S_FMT0, SUN50I_H713_I2S_FMT0_SLOT_WIDTH,
+	  FIELD_PREP_CONST(SUN50I_H713_I2S_FMT0_SLOT_WIDTH, 24 / 4 - 1) },
+	/* 5: MCLK = module clock / 6 */
+	{ SUN50I_H713_I2S_CLKDIV, SUN50I_H713_I2S_CLKDIV_MCLK,
+	  FIELD_PREP_CONST(SUN50I_H713_I2S_CLKDIV_MCLK,
+			   SUN50I_H713_I2S_CLKDIV_MCLK_DIV6) },
+	/* 6: drive MCLK out */
+	{ SUN50I_H713_I2S_CLKDIV, SUN50I_H713_I2S_CLKDIV_MCLK_OUT,
+	  SUN50I_H713_I2S_CLKDIV_MCLK_OUT },
+	/* 7: I2S/left-justified framing */
+	{ SUN50I_H713_I2S_CTL, SUN50I_H713_I2S_CTL_MODE_SEL,
+	  FIELD_PREP_CONST(SUN50I_H713_I2S_CTL_MODE_SEL,
+			   SUN50I_H713_I2S_CTL_MODE_SEL_I2S) },
+	/* 8: LRCK inverted */
+	{ SUN50I_H713_I2S_FMT0, SUN50I_H713_I2S_FMT0_LRCK_POLARITY,
+	  SUN50I_H713_I2S_FMT0_LRCK_POLARITY },
+	/* 9: BCLK not inverted */
+	{ SUN50I_H713_I2S_FMT0, SUN50I_H713_I2S_FMT0_BCLK_POLARITY, 0 },
+	/* 10: BCLK = module clock / 24 */
+	{ SUN50I_H713_I2S_CLKDIV, SUN50I_H713_I2S_CLKDIV_BCLK,
+	  FIELD_PREP_CONST(SUN50I_H713_I2S_CLKDIV_BCLK,
+			   SUN50I_H713_I2S_CLKDIV_BCLK_DIV24) },
+	/* 11, 12: MSB first both ways */
+	{ SUN50I_H713_I2S_FMT1, SUN50I_H713_I2S_FMT1_TX_MSB_FIRST, 0 },
+	{ SUN50I_H713_I2S_FMT1, SUN50I_H713_I2S_FMT1_RX_MSB_FIRST, 0 },
+	/* 13: sign extend short samples */
+	{ SUN50I_H713_I2S_FMT1, SUN50I_H713_I2S_FMT1_SIGN_EXTEND,
+	  FIELD_PREP_CONST(SUN50I_H713_I2S_FMT1_SIGN_EXTEND, 3) },
+	/* 14: 24 bit samples, encoded as bits / 4 - 1 */
+	{ SUN50I_H713_I2S_FMT0, SUN50I_H713_I2S_FMT0_SAMPLE_RES,
+	  FIELD_PREP_CONST(SUN50I_H713_I2S_FMT0_SAMPLE_RES, 24 / 4 - 1) },
+	/* 15: RX slot to channel map, written whole by the vendor */
+	{ SUN50I_H713_I2S_RXCHMAP3, U32_MAX, 0x00000100 },
+	/* 16, 17: receive two channels in two slots */
+	{ SUN50I_H713_I2S_RXCHSEL, SUN50I_H713_I2S_CHSEL_CHAN_NUM,
+	  FIELD_PREP_CONST(SUN50I_H713_I2S_CHSEL_CHAN_NUM, 2 - 1) },
+	{ SUN50I_H713_I2S_CHCFG, SUN50I_H713_I2S_CHCFG_RX_SLOT_NUM,
+	  FIELD_PREP_CONST(SUN50I_H713_I2S_CHCFG_RX_SLOT_NUM, 2 - 1) },
+	/* 18: TX slot to channel map, written whole by the vendor */
+	{ SUN50I_H713_I2S_TX0CHMAP1, U32_MAX, 0x00003210 },
+	/* 19, 20, 21: transmit two channels in the first two slots */
+	{ SUN50I_H713_I2S_TX0CHSEL, SUN50I_H713_I2S_CHSEL_CHAN_NUM,
+	  FIELD_PREP_CONST(SUN50I_H713_I2S_CHSEL_CHAN_NUM, 2 - 1) },
+	{ SUN50I_H713_I2S_CHCFG, SUN50I_H713_I2S_CHCFG_TX_SLOT_NUM,
+	  FIELD_PREP_CONST(SUN50I_H713_I2S_CHCFG_TX_SLOT_NUM, 2 - 1) },
+	{ SUN50I_H713_I2S_TX0CHSEL, SUN50I_H713_I2S_CHSEL_SLOT_EN,
+	  FIELD_PREP_CONST(SUN50I_H713_I2S_CHSEL_SLOT_EN, 0x3) },
+};
+
+static int sun50i_h713_codec_i2s_init(struct sun4i_codec *scodec)
+{
+	size_t i;
+	int ret;
+
+	for (i = 0; i < ARRAY_SIZE(sun50i_h713_i2s_init_seq); i++) {
+		const struct sun50i_h713_i2s_write *w =
+			&sun50i_h713_i2s_init_seq[i];
+
+		ret = regmap_update_bits(scodec->regmap_i2s, w->reg, w->mask,
+					 w->val);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+/*
+ * Map the second window and leave the receiver in the shape the vendor's own
+ * probe leaves it in. A device tree that describes only the DAC window is not
+ * an error: it just has no I2S input, and the two controls stay away.
+ */
+static void sun50i_h713_codec_i2s_regmap_exit(void *data)
+{
+	regmap_exit(data);
+}
+
+static int sun50i_h713_codec_i2s_probe(struct platform_device *pdev,
+				       struct sun4i_codec *scodec,
+				       const struct regmap_config *config)
+{
+	struct regmap *regmap;
+	void __iomem *base;
+	int ret;
+
+	mutex_init(&scodec->i2s_lock);
+	scodec->i2s_rate = 48000;
+
+	base = devm_platform_ioremap_resource_byname(pdev, "i2s");
+	if (IS_ERR(base)) {
+		dev_warn(&pdev->dev,
+			 "No \"i2s\" register window, no I2S input path\n");
+		return 0;
+	}
+
+	/*
+	 * Deliberately not devm_regmap_init_mmio(&pdev->dev, ...): ASoC finds
+	 * the component's regmap with dev_get_regmap(dev, NULL), which returns
+	 * the *newest* regmap attached to the device -- a second one, even a
+	 * named one, would silently replace the codec map (max_register 0x328)
+	 * with this 0x7c window. Measured on 08.09.2026: every DAPM write above
+	 * 0x7c failed with -EIO and the analog side never came up. So the I2S
+	 * map lives without a device and is torn down by a devm action.
+	 */
+	regmap = regmap_init_mmio(NULL, base, config);
+	if (IS_ERR(regmap)) {
+		dev_err(&pdev->dev, "Failed to create the I2S regmap\n");
+		return PTR_ERR(regmap);
+	}
+
+	ret = devm_add_action_or_reset(&pdev->dev,
+				       sun50i_h713_codec_i2s_regmap_exit, regmap);
+	if (ret)
+		return ret;
+
+	scodec->regmap_i2s = regmap;
+
+	return sun50i_h713_codec_i2s_init(scodec);
+}
+
+/*
+ * Set the codec up for one rate exactly as hw_params() and prepare() do it
+ * for an APB stream, minus everything that only concerns the FIFO. The 44.1
+ * kHz family runs the module clock at 45.1584 MHz and the rest at 49.152 MHz;
+ * both were read back from the clock tree while a tone from the HDMI source
+ * was audible at 32000, 44100 and 48000 (S16 20:45). The I2S dividers do not
+ * change with the rate -- CLKDIV stayed at 0x184 throughout.
+ */
+static int sun50i_h713_codec_i2s_set_rate(struct sun4i_codec *scodec,
+					  unsigned int rate)
+{
+	unsigned long clk_freq;
+	int hwrate, ret;
+
+	clk_freq = sun4i_codec_get_mod_freq(rate);
+	if (!clk_freq)
+		return -EINVAL;
+
+	hwrate = sun4i_codec_get_hw_rate(rate);
+	if (hwrate < 0)
+		return hwrate;
+
+	ret = clk_set_rate(scodec->clk_module,
+			   clk_freq * scodec->mod_freq_mult);
+	if (ret)
+		return ret;
+
+	regmap_field_update_bits(scodec->reg_dac_fifoc,
+				 7 << SUN4I_CODEC_DAC_FIFOC_DAC_FS,
+				 hwrate << SUN4I_CODEC_DAC_FIFOC_DAC_FS);
+
+	/* The FIR choice sun4i_codec_prepare_playback() makes. */
+	regmap_field_update_bits(scodec->reg_dac_fifoc,
+				 BIT(SUN4I_CODEC_DAC_FIFOC_FIR_VERSION),
+				 rate > 32000 ? 0 :
+				 BIT(SUN4I_CODEC_DAC_FIFOC_FIR_VERSION));
+
+	/*
+	 * The receiver always delivers two channels, so undo the mono mode a
+	 * one-channel APB stream may have left behind.
+	 */
+	regmap_field_clear_bits(scodec->reg_dac_fifoc,
+				BIT(SUN4I_CODEC_DAC_FIFOC_MONO_EN));
+
+	return 0;
+}
+
+/*
+ * Point the DAC at the I2S receiver, in the order the vendor's
+ * media-speaker-i2s mixer path uses (S25 §4.2): clocks and rate, then the
+ * receiver, then the selector, and the analog side last.
+ *
+ * The analog side is not written here. DAC_DPC's DAC_EN, the two halves of
+ * the DAC, the amplifier the speaker hangs off and the PA GPIO all have DAPM
+ * widgets already, and DAPM only powers them for a running PCM. So the path
+ * gets a signal generator in front of the DACs which this forces on: DAPM
+ * then brings up exactly what it brings up for playback, and -- because it
+ * counts every reason a widget is needed -- it keeps the path alive for
+ * whichever of the two, PCM or I2S input, still wants it when the other ends.
+ */
+static int sun50i_h713_codec_i2s_arm(struct snd_soc_component *component,
+				     struct sun4i_codec *scodec)
+{
+	struct snd_soc_dapm_context *dapm =
+		snd_soc_component_get_dapm(component);
+	int ret;
+
+	/*
+	 * The module clock is the one thing the two paths cannot share: a
+	 * stream that is already running would have its pitch pulled along.
+	 */
+	if (snd_soc_component_active(component) && scodec->pcm_rate &&
+	    scodec->pcm_rate != scodec->i2s_rate)
+		return -EBUSY;
+
+	ret = clk_prepare_enable(scodec->clk_module);
+	if (ret)
+		return ret;
+
+	ret = sun50i_h713_codec_i2s_set_rate(scodec, scodec->i2s_rate);
+	if (ret) {
+		clk_disable_unprepare(scodec->clk_module);
+		return ret;
+	}
+
+	/* This block drives BCLK and LRCK; the DSP on the far side follows. */
+	regmap_update_bits(scodec->regmap_i2s, SUN50I_H713_I2S_CTL,
+			   SUN50I_H713_I2S_CTL_BCLK_IN, 0);
+	regmap_update_bits(scodec->regmap_i2s, SUN50I_H713_I2S_CTL,
+			   SUN50I_H713_I2S_CTL_LRCK_IN, 0);
+	regmap_update_bits(scodec->regmap_i2s, SUN50I_H713_I2S_CTL,
+			   SUN50I_H713_I2S_CTL_RXEN,
+			   SUN50I_H713_I2S_CTL_RXEN);
+
+	regmap_update_bits(scodec->regmap, SUN4I_CODEC_DAC_DPC,
+			   SUN50I_H713_DAC_DPC_SRC_I2S_PREP_MASK,
+			   SUN50I_H713_DAC_DPC_SRC_I2S_PREP_MASK);
+	regmap_update_bits(scodec->regmap, SUN4I_CODEC_DAC_DPC,
+			   SUN50I_H713_DAC_DPC_SRC_I2S_MASK,
+			   SUN50I_H713_DAC_DPC_SRC_I2S_MASK);
+
+	scodec->i2s_armed = true;
+
+	snd_soc_dapm_force_enable_pin(dapm, "I2S In");
+	snd_soc_dapm_sync(dapm);
+
+	return 0;
+}
+
+static void sun50i_h713_codec_i2s_disarm(struct snd_soc_component *component,
+					 struct sun4i_codec *scodec)
+{
+	struct snd_soc_dapm_context *dapm =
+		snd_soc_component_get_dapm(component);
+
+	/*
+	 * Going back to the FIFO clears the selector and nothing else. The
+	 * vendor leaves its companion bit and the whole receiver standing
+	 * (S25 §4.2), and there is no reason found so far to differ.
+	 */
+	regmap_update_bits(scodec->regmap, SUN4I_CODEC_DAC_DPC,
+			   SUN50I_H713_DAC_DPC_SRC_I2S_MASK, 0);
+
+	scodec->i2s_armed = false;
+
+	/* Powers the analog side down only if no PCM is holding it up. */
+	snd_soc_dapm_disable_pin(dapm, "I2S In");
+	snd_soc_dapm_sync(dapm);
+
+	clk_disable_unprepare(scodec->clk_module);
+}
