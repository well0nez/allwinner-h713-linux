+/*
+ * The controls describe a register window that an older device tree does not
+ * mention, so they appear only when that window is really there.
+ */
+static int sun50i_h713_codec_add_controls(struct snd_soc_component *component)
+{
+	struct sun4i_codec *scodec =
+		snd_soc_card_get_drvdata(component->card);
+
+	if (!scodec->regmap_i2s)
+		return 0;
+
+	return snd_soc_add_component_controls(component,
+			sun50i_h713_codec_i2s_controls,
+			ARRAY_SIZE(sun50i_h713_codec_i2s_controls));
+}
