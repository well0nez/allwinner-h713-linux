+#define SUN50I_H713_I2S_CTL_GEN				BIT(0)
+#define SUN50I_H713_I2S_CTL_RXEN			BIT(1)
+#define SUN50I_H713_I2S_CTL_MODE_SEL			GENMASK(5, 4)
+#define SUN50I_H713_I2S_CTL_MODE_SEL_I2S		1
