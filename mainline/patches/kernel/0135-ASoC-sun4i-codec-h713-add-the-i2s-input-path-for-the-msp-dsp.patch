+/*
+ * The three rates the HDMI receiver hands on as PCM and the three that were
+ * measured end to end (S16 18:10 and 20:45). Higher rates are not refused by
+ * anything in the codec; they are simply not part of what has been shown to
+ * work, so they are left out until they are.
+ */
+static const char * const sun50i_h713_codec_i2s_rate_text[] = {
+	"32000", "44100", "48000"
+};
+
+static const unsigned int sun50i_h713_codec_i2s_rates[] = {
+	32000, 44100, 48000
+};
+
+static SOC_ENUM_SINGLE_EXT_DECL(sun50i_h713_codec_i2s_rate_enum,
+				sun50i_h713_codec_i2s_rate_text);
+
+static int sun50i_h713_codec_dac_src_get(struct snd_kcontrol *kcontrol,
+					 struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component =
+		snd_soc_kcontrol_component(kcontrol);
+	struct sun4i_codec *scodec =
+		snd_soc_card_get_drvdata(component->card);
+
+	ucontrol->value.enumerated.item[0] = scodec->i2s_armed;
+
+	return 0;
+}
+
+static int sun50i_h713_codec_dac_src_put(struct snd_kcontrol *kcontrol,
+					 struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component =
+		snd_soc_kcontrol_component(kcontrol);
+	struct sun4i_codec *scodec =
+		snd_soc_card_get_drvdata(component->card);
+	unsigned int item = ucontrol->value.enumerated.item[0];
+	int ret = 0;
+
+	if (item >= ARRAY_SIZE(sun50i_h713_codec_dac_src_text))
+		return -EINVAL;
+
+	mutex_lock(&scodec->i2s_lock);
+
+	if (item == scodec->i2s_armed)
+		goto out;
+
+	if (item)
+		ret = sun50i_h713_codec_i2s_arm(component, scodec);
+	else
+		sun50i_h713_codec_i2s_disarm(component, scodec);
+
+	if (!ret)
+		ret = 1;
+out:
+	mutex_unlock(&scodec->i2s_lock);
+
+	return ret;
+}
+
+static int sun50i_h713_codec_i2s_rate_get(struct snd_kcontrol *kcontrol,
+					  struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component =
+		snd_soc_kcontrol_component(kcontrol);
+	struct sun4i_codec *scodec =
+		snd_soc_card_get_drvdata(component->card);
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(sun50i_h713_codec_i2s_rates) - 1; i++)
+		if (sun50i_h713_codec_i2s_rates[i] == scodec->i2s_rate)
+			break;
+
+	ucontrol->value.enumerated.item[0] = i;
+
+	return 0;
+}
+
+static int sun50i_h713_codec_i2s_rate_put(struct snd_kcontrol *kcontrol,
+					  struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component =
+		snd_soc_kcontrol_component(kcontrol);
+	struct sun4i_codec *scodec =
+		snd_soc_card_get_drvdata(component->card);
+	unsigned int item = ucontrol->value.enumerated.item[0];
+	unsigned int rate;
+	int ret = 0;
+
+	if (item >= ARRAY_SIZE(sun50i_h713_codec_i2s_rates))
+		return -EINVAL;
+
+	rate = sun50i_h713_codec_i2s_rates[item];
+
+	mutex_lock(&scodec->i2s_lock);
+
+	if (rate == scodec->i2s_rate)
+		goto out;
+
+	/* Only the armed path is programmed; otherwise this just takes note. */
+	if (scodec->i2s_armed) {
+		if (snd_soc_component_active(component) && scodec->pcm_rate &&
+		    scodec->pcm_rate != rate) {
+			ret = -EBUSY;
+			goto out;
+		}
+
+		ret = sun50i_h713_codec_i2s_set_rate(scodec, rate);
+		if (ret)
+			goto out;
+	}
+
+	scodec->i2s_rate = rate;
+	ret = 1;
+out:
+	mutex_unlock(&scodec->i2s_lock);
+
+	return ret;
+}
