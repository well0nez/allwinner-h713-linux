diff -ruN a/include/linux/soc/sunxi/h713-cpu-comm.h b/include/linux/soc/sunxi/h713-cpu-comm.h
--- a/include/linux/soc/sunxi/h713-cpu-comm.h	1970-01-01 01:00:00.000000000 +0100
+++ b/include/linux/soc/sunxi/h713-cpu-comm.h	2026-09-07 09:23:57.496360999 +0200
@@ -0,0 +1,232 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * In-kernel API for the H713 ARM <-> MIPS IPC (cpu_comm).
+ *
+ * The MIPS co-processor of the H713 owns the whole HDMI-RX and picture
+ * pipeline. Everything it can do is reachable as a THal_Vp_* remote
+ * procedure over the shared-memory IPC that drivers/soc/sunxi/cpu_comm
+ * implements. Until now the only way in was the /dev/cpu_comm character
+ * device, so a kernel driver that needed the co-processor -- the HDMI-RX
+ * V4L2 driver, the ARISC HDMI driver -- had to be driven from userspace.
+ *
+ * This header is the way in from the kernel. The character devices keep
+ * working unchanged; both interfaces talk to the same protocol state and
+ * are serialised against each other.
+ *
+ *
+ * Component IDs
+ * =============
+ *
+ * A routine is addressed by a 32-bit @comp_id, not by name. The id is a
+ * CRC-32 (LSB-first, polynomial 0xedb88320, no pre- or post-inversion)
+ * over the full routine name, seeded with 0x00123456:
+ *
+ *	"<base name>_<cpu that implements it, 1 hex digit>_<pid, 3 hex digits>"
+ *
+ * so THal_Vp_SetSource, implemented on the MIPS (cpu 1), with the pid
+ * field 0 that every stock routine uses, hashes "THal_Vp_SetSource_1_000"
+ * to 0xeaf13de5. cpu_comm_name2id() does exactly this. The seed comes from
+ * Trid_Util_Name2ID in the vendor libUtility.so; the derivation reproduces
+ * every named entry in Documentation-side docs/reference/cpu-comm-call-table.md.
+ *
+ * Callbacks that the MIPS makes back into the ARM (MipsHalCallback_*) are
+ * hashed the same way with cpu 0.
+ *
+ *
+ * Registering a callback registers a routine
+ * ==========================================
+ *
+ * A MipsHalCallback_* routine only exists for the co-processor once its
+ * descriptor sits in the routine table in shared memory. The firmware
+ * resolves the callback by that table -- SendComm2CPUEx() looks the
+ * component id up with FindRoutine() and gives up with -3 when there is
+ * no entry, so a callback nobody registered is never put on the wire at
+ * all. That is why cpu_comm_register_callback() takes the routine's
+ * *name*: the descriptor carries the name, and the id is only its hash.
+ *
+ * The other side of that coin is a rule for the caller, and it was
+ * learned the expensive way. Registering is not a passive act: writing
+ * the descriptor is what makes the co-processor start sending, so the
+ * first call can arrive the moment cpu_comm_register_callback() returns.
+ * A driver must therefore register *last* -- when it is done bringing the
+ * co-processor up and can take a call -- and not first. Registering at
+ * the top of a probe that then runs a chain of outgoing calls means the
+ * incoming call lands in the middle of that chain, and on 07.09. one
+ * single delivered callback was enough to break the HDMI-RX probe, in
+ * two different places on two cold starts.
+ *
+ *
+ * Argument passing
+ * ================
+ *
+ * Arguments and results are arrays of 32-bit words, at most
+ * CPU_COMM_MAX_ARGS of them -- that limit is the protocol's, the vendor's
+ * own wrapper checks it too. There is no type information on the wire: a
+ * routine that takes a buffer takes the *physical* address of that buffer
+ * as a plain u32, and the buffer has to live somewhere the MIPS can see
+ * it (the cpu_comm reserved region, or another carveout it has been told
+ * about). See the THal_Vp_Init staging buffer or the HDCP key for
+ * examples.
+ *
+ * Results come back the same way: a count plus that many words.
+ *
+ *
+ * Timeouts
+ * ========
+ *
+ * cpu_comm_call() is synchronous. It returns only when the MIPS has
+ * answered, when the wait ran out, or when the message could not be sent
+ * at all. A call that timed out returns -ETIMEDOUT. It never reports
+ * success with an empty result -- that failure mode cost this project a
+ * lot of debugging on the character-device path, where a missing RETURN
+ * looks exactly like a routine that returns nothing.
+ *
+ * Do not call cpu_comm_call() from a callback: callbacks run on the
+ * receive path that also delivers your answer.
+ */
+
+#ifndef __LINUX_SOC_SUNXI_H713_CPU_COMM_H
+#define __LINUX_SOC_SUNXI_H713_CPU_COMM_H
+
+#include <linux/errno.h>
+#include <linux/types.h>
+
+/* Maximum number of argument or result words in one call. */
+#define CPU_COMM_MAX_ARGS		10
+
+/* Seed of the routine-name hash (Trid_Util_Name2ID). */
+#define CPU_COMM_NAME2ID_SEED		0x00123456u
+
+/* Used when cpu_comm_call() is given timeout_ms == 0. */
+#define CPU_COMM_CALL_TIMEOUT_MS	500
+
+/* The CPU that implements a routine, for cpu_comm_name2id(). */
+#define CPU_COMM_CPU_ARM		0
+#define CPU_COMM_CPU_MIPS		1
+
+/**
+ * typedef cpu_comm_cb_t - handler for a call the MIPS makes into the ARM
+ * @comp_id: component id the MIPS addressed, as registered
+ * @args: argument words, @nargs of them, or NULL if there are none
+ * @nargs: number of valid words in @args, at most CPU_COMM_MAX_ARGS
+ * @ctx: the context pointer passed to cpu_comm_register_callback()
+ *
+ * Runs in process context on the cpu_comm receive workqueue. It may
+ * sleep, but it delays the acknowledgement the MIPS is waiting for while
+ * it does, so keep it short and hand real work to your own queue. It must
+ * not call cpu_comm_call().
+ */
+typedef void (*cpu_comm_cb_t)(u32 comp_id, const u32 *args,
+			      unsigned int nargs, void *ctx);
+
+#if IS_ENABLED(CONFIG_HY310_CPU_COMM)
+
+/**
+ * cpu_comm_call() - run a routine on the MIPS and wait for its answer
+ * @comp_id: component id of the routine, see cpu_comm_name2id()
+ * @args: argument words, or NULL when @nargs is 0
+ * @nargs: number of argument words, at most CPU_COMM_MAX_ARGS
+ * @ret: buffer for the result words, or NULL when @nret is 0
+ * @nret: capacity of @ret in words, at most CPU_COMM_MAX_ARGS
+ * @timeout_ms: how long to wait for the answer, 0 for
+ *	CPU_COMM_CALL_TIMEOUT_MS
+ *
+ * Sends one call, waits for the acknowledgement and then for the return,
+ * and copies up to @nret result words into @ret. Words of @ret that the
+ * MIPS did not fill are zeroed. May sleep; must not be called from
+ * interrupt context or from a cpu_comm callback.
+ *
+ * Return: the number of result words written to @ret (0..@nret), or a
+ * negative errno: -ETIMEDOUT if the co-processor did not answer in time,
+ * -ENODEV if the IPC is not up or the routine is not registered,
+ * -EAGAIN if the co-processor has not reached application readiness,
+ * -EBUSY if the call-slot pool is exhausted, -EINVAL on bad arguments.
+ */
+int cpu_comm_call(u32 comp_id, const u32 *args, unsigned int nargs,
+		  u32 *ret, unsigned int nret, unsigned int timeout_ms);
+
+/**
+ * cpu_comm_register_callback() - receive calls the MIPS makes into the ARM
+ * @base_name: routine name without the "_<cpu>_<pid>" suffix, e.g.
+ *	"MipsHalCallback_SignalChange". At most 58 characters, so that the
+ *	full name still fits the descriptor's 64-byte name field.
+ * @fn: handler, see cpu_comm_cb_t
+ * @ctx: opaque pointer handed back to @fn
+ *
+ * Installs a routine descriptor for @base_name in the shared routine
+ * table -- without it the co-processor cannot resolve the callback and
+ * never sends it -- and registers @fn for the component id that name
+ * hashes to. One handler per component id. The handler is called in
+ * addition to the existing /dev/cpu_comm delivery, which is left
+ * untouched: a reader of the character device and a kernel handler both
+ * see the same event.
+ *
+ * Call this when the caller is ready to be called, not before: the
+ * descriptor is what arms the sender, so the first call can arrive as
+ * soon as this returns. See "Registering a callback registers a routine"
+ * above for what that cost once.
+ *
+ * Return: 0 on success, -EBUSY if the id already has a handler, -ENOSPC
+ * if the handler table or the routine table is full, -ENODEV if the IPC
+ * is not up yet, -EINVAL on bad arguments.
+ */
+int cpu_comm_register_callback(const char *base_name, cpu_comm_cb_t fn,
+			       void *ctx);
+
+/**
+ * cpu_comm_unregister_callback() - drop a handler again
+ * @base_name: the name the handler was registered under
+ * @fn: the same handler that was registered
+ *
+ * Removes the routine descriptor again -- but only if it is still the one
+ * this API installed, so a userspace daemon that registered the same
+ * routine keeps its entry -- and drops the handler. Waits for a handler
+ * that is currently running to return, so it is safe to free @ctx
+ * afterwards. Call this before unloading a module that registered a
+ * handler.
+ *
+ * Return: 0 on success, -ENOENT if no such handler is registered.
+ */
+int cpu_comm_unregister_callback(const char *base_name, cpu_comm_cb_t fn);
+
+/**
+ * cpu_comm_name2id() - hash a routine name into its component id
+ * @base_name: routine name without the "_<cpu>_<pid>" suffix, e.g.
+ *	"THal_Vp_SetSource"
+ * @target_cpu: CPU_COMM_CPU_MIPS for a THal_Vp_* routine,
+ *	CPU_COMM_CPU_ARM for a MipsHalCallback_* one
+ *
+ * Return: the component id, or 0 if the name is unusable.
+ */
+u32 cpu_comm_name2id(const char *base_name, unsigned int target_cpu);
+
+#else /* !CONFIG_HY310_CPU_COMM */
+
+static inline int cpu_comm_call(u32 comp_id, const u32 *args,
+				unsigned int nargs, u32 *ret,
+				unsigned int nret, unsigned int timeout_ms)
+{
+	return -ENODEV;
+}
+
+static inline int cpu_comm_register_callback(const char *base_name,
+					     cpu_comm_cb_t fn, void *ctx)
+{
+	return -ENODEV;
+}
+
+static inline int cpu_comm_unregister_callback(const char *base_name,
+					       cpu_comm_cb_t fn)
+{
+	return -ENODEV;
+}
+
+static inline u32 cpu_comm_name2id(const char *base_name,
+				   unsigned int target_cpu)
+{
+	return 0;
+}
+
+#endif /* CONFIG_HY310_CPU_COMM */
+
+#endif /* __LINUX_SOC_SUNXI_H713_CPU_COMM_H */
