 			dbg[0], dbg[1], dbg[4], dbg[5], dbg[6]);
-		pr_info("cpu_comm: TX slot idx=%u @%p (erwartet %p)\n",
+		pr_debug("cpu_comm: TX slot idx=%u @%p (erwartet %p)\n",
 			slot_idx, call_slot,
