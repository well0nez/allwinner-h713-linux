-		pr_info("cpu_comm: TX chan=0x%04x dst_cpu=%u pid=0x%08x comp_id=0x%08x "
+		pr_debug("cpu_comm: TX chan=0x%04x dst_cpu=%u pid=0x%08x comp_id=0x%08x "
 			"nparams=%u (key 0x%08x)\n",
 			*(u16 *)(m + 0x00), *(u16 *)(m + 0x02),
 			*(u32 *)(m + 0x10), *(u32 *)(m + 0x28),
@@ -568,7 +568,7 @@
 				break;
 			udelay(100);
 		}
-		pr_info("cpu_comm: TX nach Doorbell: SENT-Bit %s (nach %d x 100us), "
+		pr_debug("cpu_comm: TX nach Doorbell: SENT-Bit %s (nach %d x 100us), "
 			"share_seq+0x08=0x%02x\n",
 			(share_seq_w[8] & MSG_FLAG_SENT) ? "STEHT NOCH -- Firmware hat nicht zugegriffen"
 							 : "geloescht -- Firmware hat gelesen",
