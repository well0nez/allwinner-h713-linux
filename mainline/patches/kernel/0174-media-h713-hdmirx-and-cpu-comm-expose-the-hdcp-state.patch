 }
 
+/* ------------------------------------------------------------------ *
+ * HDCP, for the status file and the hdcp file
+ *
+ * Read afresh at every look, like the audio bytes: a measurement is taken by
+ * reading the file before and after a protected source is plugged in.
+ * ------------------------------------------------------------------ */
+
+struct h713_hdmirx_hdcp {
+	unsigned int key14;	/* +0x093 */
+	unsigned int linkstat;	/* +0x06d */
+	unsigned int hold;	/* +0x161 */
+	unsigned int mode;	/* +0x3c0 */
+	unsigned int cap;	/* +0x41a */
+	unsigned int rx_lo;	/* +0x41b */
+	unsigned int rx_hi;	/* +0x41c */
+	unsigned int session;	/* +0x422 */
+};
+
+static int h713_hdmirx_read_hdcp(struct h713_hdmirx *rx,
+				 struct h713_hdmirx_hdcp *h)
+{
+	const struct {
+		unsigned int reg;
+		unsigned int *val;
+	} regs[] = {
+		{ H713_LINK_HDCP14_KEY, &h->key14 },
+		{ H713_LINK_LINKSTAT, &h->linkstat },
+		{ H713_LINK_HDCP22_HOLD, &h->hold },
+		{ H713_LINK_HDCP22_MODE, &h->mode },
+		{ H713_LINK_HDCP22_CAP, &h->cap },
+		{ H713_LINK_HDCP22_RXSTATUS_LO, &h->rx_lo },
+		{ H713_LINK_HDCP22_RXSTATUS_HI, &h->rx_hi },
+		{ H713_LINK_HDCP22_SESSION, &h->session },
+	};
+	unsigned int i;
+	int ret;
+
+	memset(h, 0, sizeof(*h));
+	if (!rx->link)
+		return -ENODEV;
+	for (i = 0; i < ARRAY_SIZE(regs); i++) {
+		ret = regmap_read(rx->link, regs[i].reg, regs[i].val);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+/*
+ * The verdict both files share. The reset value of the two AKE_Init marks
+ * is not known; the boot baseline (the file read before a source is
+ * plugged in) says what they read when nothing has happened yet.
+ */
+static const char *h713_hdmirx_hdcp_version(const struct h713_hdmirx_hdcp *h)
+{
+	if (h->session & H713_LINK_HDCP22_SESSION_ON)
+		return "2.2 (session stands)";
+	if (h->mode & H713_LINK_HDCP22_MODE_BIT)
+		return "2.2 begun, no session (AKE_Init marks set; compare with the boot baseline)";
+	if (!(h->key14 & H713_LINK_HDCP14_KEY_LOADED))
+		return "none (no 2.2 exchange since boot; 1.4 is impossible without its key)";
+	return "none or 1.4 (no 2.2 exchange since boot; a 1.4 pass leaves no readable status)";
+}
+
+static const char *h713_hdmirx_hdcp_key22(const struct h713_hdmirx *rx)
+{
+	switch (rx->hdcp22_key) {
+	case H713_HDCP22_KEY_SENT:
+		return "handed over";
+	case H713_HDCP22_KEY_SKIPPED:
+		return "skipped";
+	default:
+		return "not yet";
+	}
+}
+
+/* One line in the status file; the hdcp file has the whole picture. */
+static void h713_hdmirx_show_hdcp_brief(struct seq_file *s,
+					struct h713_hdmirx *rx)
+{
+	struct h713_hdmirx_hdcp h;
+	int ret;
+
+	ret = h713_hdmirx_read_hdcp(rx, &h);
+	if (ret) {
+		seq_printf(s, "hdcp:         not readable (%d)\n", ret);
+		return;
+	}
+	seq_printf(s, "hdcp:         %s; key 1.4 %s, key 2.2 %s\n",
+		   h713_hdmirx_hdcp_version(&h),
+		   h.key14 & H713_LINK_HDCP14_KEY_LOADED ? "loaded" : "not loaded",
+		   h713_hdmirx_hdcp_key22(rx));
+}
+
+/*
+ * The newest line of the firmware's own log that mentions HDCP. The
+ * firmware logs its 2.2 success ("HDCP Process cost tick") and its failures
+ * at its error level, so they are in the ring at the default level; a 1.4
+ * pass is an INFO line and is not.
+ */
+static int h713_hdmirx_hdcp_firmware(char *buf, int at)
+{
+	char line[H713_HDCP_LOG_LINE];
+	u32 wp = 0;
+	int ret;
+
+	ret = cpu_comm_elog_last("hdcp", line, sizeof(line), &wp);
+	if (ret >= 0)
+		return sysfs_emit_at(buf, at, "firmware:      %s (ring write pointer %u)\n",
+				     line, wp);
+	if (ret == -ENOENT)
+		return sysfs_emit_at(buf, at, "firmware:      no HDCP line in the firmware log (ring write pointer %u)\n",
+				     wp);
+	return sysfs_emit_at(buf, at, "firmware:      firmware log not readable (%d)\n",
+			     ret);
+}
+
+/*
+ * The sysfs file "hdcp" of the platform device, read-only: five lines, in
+ * the order a test reads them - what was negotiated, whether a session
+ * stands, the two keys, the firmware's last word. Nothing here is key
+ * material, only status bits. Sysfs and not debugfs because the release
+ * kernel has no debugfs; one file and not five because the lines are one
+ * measurement: the verdict of the first and the bits of the second come out
+ * of the same register read, and a source in the middle of an exchange
+ * changes them between two reads. Userspace reaches it through the video
+ * node's parent, /sys/class/video4linux/videoN/device/hdcp; h713-tv ctl
+ * hdcp copies the lines through unchanged, so every line stays well under
+ * 250 bytes.
+ */
+static ssize_t hdcp_show(struct device *dev, struct device_attribute *attr,
+			 char *buf)
+{
+	struct h713_hdmirx *rx = dev_get_drvdata(dev);
+	struct h713_hdmirx_hdcp h;
+	const char *cap;
+	int at = 0, ret;
+
+	ret = h713_hdmirx_read_hdcp(rx, &h);
+	if (ret) {
+		at += sysfs_emit_at(buf, at, "version:       not readable (%d%s)\n", ret,
+				    ret == -ENODEV ? ": no LINK window, allwinner,hdmirx-link is missing" : "");
+		at += sysfs_emit_at(buf, at, "authenticated: not readable\n");
+		at += sysfs_emit_at(buf, at, "key-1.4:       not readable\n");
+		cap = "not readable";
+	} else {
+		/* FIELD_GET() yields an unsigned long; the line prints a %u */
+		unsigned int msg_size = h.rx_lo |
+			((unsigned int)FIELD_GET(H713_LINK_HDCP22_RXSTATUS_SIZE_HI, h.rx_hi) << 8);
+
+		at += sysfs_emit_at(buf, at, "version:       %s -- LINK 0x422=0x%02x 0x3c0=0x%02x 0x161=0x%02x\n",
+				    h713_hdmirx_hdcp_version(&h), h.session, h.mode,
+				    h.hold);
+		at += sysfs_emit_at(buf, at, "authenticated: %s (2.2 session, LINK 0x422[0]) -- rxstatus 0x41b/0x41c=0x%02x 0x%02x: message size %u, READY %s, REAUTH_REQ %s; link 0x6d=0x%02x, link 0 %s\n",
+				    h.session & H713_LINK_HDCP22_SESSION_ON ? "yes" : "no",
+				    h.rx_lo, h.rx_hi, msg_size,
+				    h.rx_hi & H713_LINK_HDCP22_RXSTATUS_READY ? "1" : "0",
+				    h.rx_hi & H713_LINK_HDCP22_RXSTATUS_REAUTH ? "1" : "0",
+				    h.linkstat,
+				    h.linkstat & H713_LINK_LINKSTAT_LINK0 ? "connected" : "not connected");
+		at += sysfs_emit_at(buf, at, "key-1.4:       %s (LINK 0x93=0x%02x)\n",
+				    h.key14 & H713_LINK_HDCP14_KEY_LOADED ? "loaded" :
+				    "not loaded -- nothing loads it before the firmware starts, its LoadKey times out at boot (doku/112)",
+				    h.key14);
+		cap = h.cap & H713_LINK_HDCP22_CAP_BIT ? "1" : "0";
+	}
+	switch (rx->hdcp22_key) {
+	case H713_HDCP22_KEY_SENT:
+		at += sysfs_emit_at(buf, at, "key-2.2:       handed over at probe (THal_Vp_SetHDCP22Key accepted; 2.2 advertised to the source, LINK 0x41a[2]=%s)\n",
+				    cap);
+		break;
+	case H713_HDCP22_KEY_SKIPPED:
+		at += sysfs_emit_at(buf, at, "key-2.2:       skipped at probe (%s not loadable, %d): no 2.2 this boot\n",
+				    H713_FW_HDCP22, rx->hdcp22_key_err);
+		break;
+	default:
+		at += sysfs_emit_at(buf, at, "key-2.2:       the init sequence has not reached the step\n");
+		break;
+	}
+	at += h713_hdmirx_hdcp_firmware(buf, at);
+
+	return at;
+}
+static DEVICE_ATTR_RO(hdcp);
+
+static struct attribute *h713_hdmirx_attrs[] = {
+	&dev_attr_hdcp.attr,
+	NULL,
+};
+ATTRIBUTE_GROUPS(h713_hdmirx);
