+/*
+ * The newest line of the firmware's log that contains a word
+ * ===========================================================
+ *
+ * The display firmware logs into a 100 KiB ring inside its own memory (mode
+ * 1, doku/63-mips-elog.md): text from offset 0 upwards, the write pointer an
+ * offset into the ring that wraps at its end. Nobody moves the read pointer
+ * on our boards, so the firmware stops writing once the ring is full - which
+ * at the default log level takes a long time, the boot leaves under two
+ * kilobytes in it. This function does not move the read pointer either: it
+ * is a look, not a consumer, and the boot history the probe dumps into dmesg
+ * stays where it is.
+ *
+ * The walk goes backwards from the write pointer, so the first line that
+ * matches is the newest one. A NUL is memory the firmware never wrote and
+ * ends the walk. A line longer than the buffer is compared on, and returned
+ * as, its tail. The comparison ignores case because the firmware spells its
+ * modules HdcpRx, HDCP22 and hdcp22 in the same breath; bytes that are not
+ * printable are blanked in the copy.
+ *
+ * The first caller maps the ring and the control block; they stay mapped
+ * until the module goes. The mutex serialises the mapping and the walk.
+ */
+#define CPU_COMM_ELOG_RING_SIZE		102400
+#define CPU_COMM_ELOG_CTL_SIZE		0x500
+#define CPU_COMM_ELOG_MODE		0x09b	/* u8: 1 = the 100 KiB ring */
+#define CPU_COMM_ELOG_WRITE		0x4a8	/* u32: offset into the ring */
+#define CPU_COMM_ELOG_LINE		200
+
+static DEFINE_MUTEX(cpu_comm_elog_lock);
+static void __iomem *cpu_comm_elog_ctl;
+static void __iomem *cpu_comm_elog_ring;
+
+static bool cpu_comm_elog_has(const char *s, size_t len, const char *needle,
+			      size_t nlen)
+{
+	size_t i;
+
+	if (!nlen || nlen > len)
+		return false;
+	for (i = 0; i + nlen <= len; i++)
+		if (!strncasecmp(s + i, needle, nlen))
+			return true;
+
+	return false;
+}
+
+int cpu_comm_elog_last(const char *needle, char *buf, size_t len,
+		       u32 *write_ptr)
+{
+	char rev[CPU_COMM_ELOG_LINE];	/* the line at hand, newest byte first */
+	size_t nlen, l = 0, i;
+	u32 pos, scanned;
+	int ret;
+
+	if (!needle || !buf || len < 2)
+		return -EINVAL;
+	nlen = strlen(needle);
+	buf[0] = '\0';
+
+	mutex_lock(&cpu_comm_elog_lock);
+	if (!cpu_comm_elog_ctl)
+		cpu_comm_elog_ctl = ioremap(elog_ctl_addr, CPU_COMM_ELOG_CTL_SIZE);
+	if (!cpu_comm_elog_ring)
+		cpu_comm_elog_ring = ioremap(elog_ring_addr, CPU_COMM_ELOG_RING_SIZE);
+	if (!cpu_comm_elog_ctl || !cpu_comm_elog_ring) {
+		ret = -ENODEV;
+		goto out;
+	}
+	if (readb(cpu_comm_elog_ctl + CPU_COMM_ELOG_MODE) != 1) {
+		ret = -ENODEV;
+		goto out;
+	}
+	pos = readl(cpu_comm_elog_ctl + CPU_COMM_ELOG_WRITE);
+	if (write_ptr)
+		*write_ptr = pos;
+	if (pos >= CPU_COMM_ELOG_RING_SIZE) {
+		ret = -ENODEV;
+		goto out;
+	}
+
+	ret = -ENOENT;
+	for (scanned = 0; scanned <= CPU_COMM_ELOG_RING_SIZE; scanned++) {
+		u8 c = 0;
+
+		if (scanned < CPU_COMM_ELOG_RING_SIZE) {
+			pos = pos ? pos - 1 : CPU_COMM_ELOG_RING_SIZE - 1;
+			c = readb(cpu_comm_elog_ring + pos);
+		}
+		if (c && c != '\n') {
+			if (l < sizeof(rev))
+				rev[l++] = (c >= 0x20 && c < 0x7f) ? c : ' ';
+			continue;
+		}
+		/* a line boundary, the ring's start, or its unwritten part */
+		for (i = 0; i < l && i < len - 1; i++)
+			buf[i] = rev[l - 1 - i];
+		buf[i] = '\0';
+		if (l && cpu_comm_elog_has(buf, i, needle, nlen)) {
+			ret = (int)i;
+			break;
+		}
+		l = 0;
+		if (!c)
+			break;
+	}
+	if (ret < 0)
+		buf[0] = '\0';
+out:
+	mutex_unlock(&cpu_comm_elog_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(cpu_comm_elog_last);
+
+static void cpu_comm_elog_unmap(void)
+{
+	mutex_lock(&cpu_comm_elog_lock);
+	if (cpu_comm_elog_ring)
+		iounmap(cpu_comm_elog_ring);
+	if (cpu_comm_elog_ctl)
+		iounmap(cpu_comm_elog_ctl);
+	cpu_comm_elog_ring = NULL;
+	cpu_comm_elog_ctl = NULL;
+	mutex_unlock(&cpu_comm_elog_lock);
+}
