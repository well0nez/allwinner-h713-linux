+
+static struct {
+	unsigned long base;
+	size_t size;
+} cc_arenas[CC_REF_ARENA_MAX];
+
+static int cc_arena_count;
+
+int cc_arena_register(void *base, size_t size)
+{
+	int i;
+
+	if (WARN_ON(!base || !size))
+		return -EINVAL;
+
+	/*
+	 * The offset has to fit in the bits the tag leaves behind. Both
+	 * arenas are tens of kilobytes, so this is a guard against a
+	 * future caller rather than a live constraint.
