+	pr_debug("cpu_comm: arena %d = %p..%p (%zu bytes)\n",
+		 i, base, (u8 *)base + size, size);
+	return i;
+}
+
+void cc_arena_reset(void)
+{
+	memset(cc_arenas, 0, sizeof(cc_arenas));
+	cc_arena_count = 0;
