--- a/drivers/media/platform/sunxi/sun50i-h713-hdmirx/sun50i-h713-hdmirx.c
+++ b/drivers/media/platform/sunxi/sun50i-h713-hdmirx/sun50i-h713-hdmirx.c
@@ -195,11 +195,59 @@
  * each. So lines are not "one width apart", they are one rowbyte apart, and
  * that is what the format reports as bytesperline and what the plane
  * programs as the stride. Both take it from here, so they agree.
+ *
+ * The rowbyte is also the one register that says how WIDE the ring is. INCAP
+ * active (+0x874) is the capture's input window -- the source -- and on a
+ * board whose panel is smaller than the source the firmware scales inside its
+ * capture path, so the ring holds fewer pixels than the source sends. Measured
+ * on the HY300 Pro (1280x720 panel), 19.09.2026, with a 1920x1080 source:
+ * active 0x07800438 (1920x1080) but rowbyte 0x00360036, 54 * 16 = 864 bytes per
+ * line, and 864 bytes of NV16 luma are 864 pixels, not 1920. On the HY310
+ * (1920x1080 panel) the rowbyte is ALIGN(width, 16) for every source seen. So
+ * the rule in h713_hdmirx_ring_geometry(): rowbyte * 16 == ALIGN(width, 16)
+ * means the ring is the source; a smaller pitch means the firmware scales and
+ * the pitch names the ring's width.
  */
 #define H713_INCAP_ROWBYTE	0x924
 #define H713_INCAP_ROWBYTE_UNIT	16
 
 /*
+ * The display engine's picture scaler at 0x05180000, and why it is only a
+ * cross-check. Its input window, +0x34 (width [31:16], height [15:0]), is the
+ * size the scaler reads the ring at -- 0x035401de = 852x478 on the HY300 Pro
+ * for the case above, where the rowbyte says 864 = ALIGN(852, 16). It names
+ * the ring exactly where the rowbyte can only name it to within 16 pixels.
+ *
+ * But the firmware writes it only when it rebuilds its window chain, which is
+ * at the first lock of a boot and whenever the display side republishes the
+ * VidDec descriptor (0117) -- not on every source change. Measured on the HY310,
+ * 20.09.2026 (dev17): after 720p -> 1080p the window still read 1280x720 while
+ * INCAP active and the rowbyte had long moved to 1920x1080 / 0x78. Taking that
+ * register as the ring's size reported a 1280x720 ring with a 1920-byte pitch:
+ * a sheared picture, then the console, not recoverable by replugging. So it is
+ * consulted only after the rowbyte has said that the firmware scales, only
+ * when what it says agrees with the rowbyte (ALIGN(width, 16) == pitch) and
+ * with the source's aspect ratio, and only through an optional phandle: a
+ * device tree without allwinner,scaler leaves the arithmetic alone in charge.
+ */
+#define H713_SCALER_IN_WIN	0x34
+
+/**
+ * struct h713_hdmirx_ring_geometry - what the capture writes into a ring slot
+ * @width: pixels per line the plane may show (NV16 luma: bytes = pixels)
+ * @height: lines
+ * @pitch: bytes from one line to the next, one NV16 plane; INCAP rowbyte * 16
+ *
+ * This is what G_FMT reports and what the plane is programmed with. It is the
+ * source signal only where the firmware does not scale in its capture path.
+ */
+struct h713_hdmirx_ring_geometry {
+	unsigned int width;
+	unsigned int height;
+	unsigned int pitch;
+};
+
+/*
  * The capture output enables, one for luma and one for chroma. Bit 31 of each
  * is what the firmware's memory_agent_onoff clears for its mask 0x008
  * (re/notes/color-csc-blocker.md), and clearing it is how a descriptor
@@ -979,7 +1027,9 @@
 	u32 id_setsource;
 	u32 id_setvideorange;
 
-	struct v4l2_dv_timings timings;
+	struct v4l2_dv_timings timings;	/* the source signal (QUERY_DV_TIMINGS) */
+	u32 ring_width;			/* the ring: what the capture writes -- */
+	u32 ring_height;		/* the source, unless the firmware scales */
 	u32 stride;			/* bytes per ring line, INCAP rowbyte * 16 */
 	u32 plane_size;			/* bytes per plane of the current format */
 
@@ -990,6 +1040,7 @@
 	 * read on demand, under sig_lock, through a mapping made on first use.
 	 */
 	struct regmap *incap;
+	struct regmap *scaler;		/* DE picture scaler, read only, optional */
 	struct mutex sig_lock;
 	void __iomem *sig_map;
 	phys_addr_t sig_map_base;
