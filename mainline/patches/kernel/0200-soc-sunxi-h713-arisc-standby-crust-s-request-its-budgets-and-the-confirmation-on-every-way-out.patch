+/*
+ * A new event TF-A left in its word (contract 5), decoded: a refused
+ * SYSTEM_SUSPEND with the checks that failed, a late crust at boot, an
+ * R_WDOG found armed, a suspend crust did not take.
+ */
+static void arisc_tfa_report(struct h713_arisc *a)
+{
+	static const char * const events[] = {
+		"?", "SYSTEM_SUSPEND denied", "crust late at boot",
+		"R_WDOG found armed", "suspend not taken, reset",
+	};
+	static const char * const checks[H713_DENY_CHECKS] = {
+		"magic", "version", "vdd-sys", "unmeasured", "phase", "net",
+		"running", "heartbeat", "aff0",
+	};
+	u32 w = crust_rd(a, H713_TFA_WORD);
+	char failed[96] = "";
+	unsigned int i, n = 0;
+
+	if (!w || w == a->tfa_seen)
+		return;
+	a->tfa_seen = w;
+	if (h713_tfa_event(w) == H713_TFA_DENIED)
+		for (i = 0; i < H713_DENY_CHECKS; i++)
+			if (h713_tfa_detail(w) & BIT(i))
+				n += scnprintf(failed + n, sizeof(failed) - n,
+					       " %s", checks[i]);
+	dev_warn(a->dev, "TF-A: %s (word 0x%08x)%s%s\n",
+		 events[h713_tfa_event(w) < ARRAY_SIZE(events) ?
+			h713_tfa_event(w) : 0], w,
+		 n ? ", failed:" : "", failed);
+}
