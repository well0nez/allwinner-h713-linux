 }
 
+/*
+ * Why standby to RAM cannot go to the firmware now, or NULL: the checks that
+ * need no exchange.
+ *
+ * The vendor firmware leaves the DRAM's self-refresh with the dram_para it
+ * finds at arisc_para (0x145b0 -> 0x14004 -> 0x13884: clock, type, zq, odt,
+ * para1/2, mr, tpr), and this driver puts zeros and the message pool there:
+ * clock 0 goes into PLL_DDR and the lock poll at 0x13644 never ends. Until
+ * the block carries the board's real dram_para, standby to RAM is crust's
+ * only - a crust of contract 5, which takes a request, budgets and a
+ * confirmation. Of the deep variants none is offered: Linux restores nothing
+ * of the main domain after the VDD_SYS step, and the PLL LDO and AVCC steps
+ * are not measured. A crust built with the sleep net needs the link that
+ * orders the SoC watchdog's noirq behind ours. And crust takes a request
+ * only once it has released the last one (phase off or released).
+ */
+static const char *arisc_standby_refusal(struct h713_arisc *a)
+{
+	unsigned int phase;
+	u32 build;
+
+	if (!a->running)
+		return "the firmware is not running";
+	if (!a->off.crust)
+		return "the vendor firmware would wake the DRAM with an empty dram_para";
+	if (!crust_accept(a, CRUST_STANDBY_MIN))
+		return "crust's contract is older than 5";
+	build = crust_rd(a, H713_DIAG_BUILD);
+	if (build & H713_BUILD_VDD_SYS)
+		return "crust is built with the VDD_SYS step";
+	if (build & (H713_BUILD_PLL_LDO | H713_BUILD_AVCC))
+		return "crust is built with an unmeasured deep step";
+	if (build & H713_BUILD_SLEEP_NET && !a->wdt_link)
+		return "crust's sleep net needs the link to the watchdog";
+	if (crust_rd(a, H713_NET_REQ))
+		return "a standby request is still on the page";
+	/*
+	 * crust takes a request only in these two phases and reads the
+	 * confirmation only in the two it releases from, so noirq may clear
+	 * the confirmation before the request (the order in suspend_noirq).
+	 */
+	phase = h713_sb_phase(crust_rd(a, H713_SB_STATE));
+	if (phase != H713_PHASE_OFF && phase != H713_PHASE_RELEASED)
+		return "crust has not released its last standby";
+	return NULL;
+}
+
+/*
+ * prepare: refuse before any other driver has quiesced anything (the late
+ * and noirq callbacks come after the damage: cpu_comm parks the display MIPS
+ * in its suspend_late). The checks, the supervision, and one round trip on
+ * port 3 - the clear frame 0x25, which arms nothing while no request is on
+ * the page. Only the real standby is ours; s2idle ("mem" on a BL31 without
+ * SYSTEM_SUSPEND) passes through untouched.
+ */
+static int h713_arisc_prepare(struct device *dev)
+{
+	struct h713_arisc *a = dev_get_drvdata(dev);
+	const char *why;
+	int ret;
+
+	if (pm_suspend_target_state != PM_SUSPEND_MEM)
+		return 0;
+	mutex_lock(&a->lock);
+	a->slept = false;	/* until this cycle's 0x11 says otherwise */
+	why = arisc_standby_refusal(a);
+	if (!why && !arisc_watch(a))
+		why = "crust does not serve";
+	ret = why ? -EOPNOTSUPP : arisc_sb_wake_timer(a, 0);
+	mutex_unlock(&a->lock);
+	if (why)
+		dev_err(dev, "standby refused: %s\n", why);
+	return ret;
+}
+
+/*
+ * The budgets crust gets for the phases on both sides of the sleep: until
+ * TF-A's request, and from the wake until the confirmation. Not measured;
+ * crust caps both at 120 s.
+ */
+#define NET_PRESLEEP_S		15
+#define NET_RESUMING_S		60
+#define NET_RELEASE_MS		100
+
+static void arisc_net_confirm(struct h713_arisc *a)
+{
+	crust_wr(a, h713_net_confirm(a->net_cycle), H713_NET_CONFIRM);
+}
+
+/*
+ * noirq: the last stop before TF-A's "cpu op req". The request goes on the
+ * page - budgets first, then the request with the cycle crust will count -
+ * and the round trip on port 3 hands it over; crust takes it into PRESLEEP
+ * (and arms its sleep net, where it is built) before it answers. The request
+ * word is cleared on every way out. Anything but the state asked for refuses
+ * the standby, and a confirmation for the cycle releases what crust took.
+ */
+static int h713_arisc_suspend_noirq(struct device *dev)
+{
+	struct h713_arisc *a = dev_get_drvdata(dev);
+	u32 cycle, sb, want;
+	int ret;
+
+	if (pm_suspend_target_state != PM_SUSPEND_MEM)
+		return 0;
+	if (!a->running || !a->off.crust) {
+		dev_err(dev, "standby refused: the firmware stopped after prepare\n");
+		return -EOPNOTSUPP;
+	}
+
+	mutex_lock(&a->lock);
+	cycle = crust_rd(a, H713_CYCLE) + 1;
+	/*
+	 * The contract's order for every request: NET_CONFIRM := 0, then
+	 * NET_BUDGET, then NET_REQ. Clearing the confirmation is a rule, not
+	 * tidiness: one left from a request crust did not take names the very
+	 * cycle this request asks for (CYCLE did not move), crust would
+	 * release it as soon as it took it, and every refusal would refuse
+	 * the next standby too. prepare made sure crust is off or released,
+	 * where it does not read the word.
+	 */
+	crust_wr(a, 0, H713_NET_CONFIRM);
+	crust_wr(a, h713_net_budget(NET_PRESLEEP_S, NET_RESUMING_S),
+		 H713_NET_BUDGET);
+	crust_wr(a, h713_net_req(cycle), H713_NET_REQ);
+	a->net_cycle = cycle;
+	a->net_pending = true;
+	a->woken = (u8)(crust_rd(a, H713_CNT2) >> 8);
+	ret = arisc_sb_wake_timer(a, 0);
+	crust_wr(a, 0, H713_NET_REQ);
+
+	sb = crust_rd(a, H713_SB_STATE);
+	want = H713_SB_ACCEPTED;
+	if (crust_rd(a, H713_DIAG_BUILD) & H713_BUILD_SLEEP_NET)
+		want |= H713_SB_NET_ARMED;
+	if (!ret && (h713_sb_phase(sb) != H713_PHASE_PRESLEEP ||
+		     (sb & want) != want || h713_sb_cycle(sb) != (u8)cycle))
+		ret = -EIO;
+	if (ret) {
+		dev_err(dev, "standby %u refused: crust state 0x%08x (phase %s), err 0x%x, net read back 0x%08x (%d)\n",
+			cycle, sb, crust_phase(sb), crust_rd(a, H713_ERR),
+			crust_rd(a, H713_NET_RB), ret);
+		arisc_net_confirm(a);
+		ret = -EIO;
+	} else if (sb & H713_SB_NET_ARMED) {
+		dev_info(dev, "standby %u: net armed, R_WDOG mode 0x%04x cfg 0x%04x\n",
+			 cycle, crust_rd(a, H713_NET_RB) & 0xffff,
+			 crust_rd(a, H713_NET_RB) >> 16);
+	} else {
+		dev_info(dev, "standby %u: net none\n", cycle);
+	}
+	mutex_unlock(&a->lock);
+	return ret;
+}
+
+static int h713_arisc_resume_noirq(struct device *dev)
+{
+	struct h713_arisc *a = dev_get_drvdata(dev);
+
+	if (pm_suspend_target_state != PM_SUSPEND_MEM)
+		return 0;
+	mutex_lock(&a->lock);
+	a->resume_ns = ktime_get_boottime_ns();
+	arisc_sb_restore_notify(a);
+	mutex_unlock(&a->lock);
+	return 0;
+}
+
+/*
+ * After every standby crust took a request for, whatever way it ended: the
+ * confirmation, which ends crust's resuming budget and its net, a short wait
+ * for crust to release, and one line for the cycle. Anything new crust or
+ * TF-A recorded is a warning (arisc_watch()).
+ */
+static void arisc_standby_done(struct h713_arisc *a)
+{
+	unsigned int phase;
+	ktime_t start;
+	bool woke;
+	s64 ms;
+	u32 sb;
+
+	mutex_lock(&a->lock);
+	if (!a->net_pending)
+		goto out;
+	arisc_net_confirm(a);
+	start = ktime_get();
+	for (;;) {
+		sb = crust_rd(a, H713_SB_STATE);
+		phase = h713_sb_phase(sb);
+		ms = ktime_ms_delta(ktime_get(), start);
+		if (phase < H713_PHASE_PRESLEEP || phase > H713_PHASE_RESUMING ||
+		    ms >= NET_RELEASE_MS)
+			break;
+		usleep_range(1000, 2000);
+	}
+	a->net_pending = false;
+	/*
+	 * crust counts every wake (CNT2[15:8]): a sleep whose 0x11 found no
+	 * answer, or got 0 from a crust that restarted while resuming, is a
+	 * wake with an unknown source, not "did not sleep".
+	 */
+	woke = (u8)(crust_rd(a, H713_CNT2) >> 8) != a->woken;
+	/* A request crust never took has no cycle of its own: noirq said why. */
+	if (h713_sb_cycle(sb) == (u8)a->net_cycle) {
+		if (phase != H713_PHASE_RELEASED)
+			dev_warn(a->dev, "standby %u: crust not released after %lld ms (state 0x%08x, phase %s)\n",
+				 a->net_cycle, ms, sb, crust_phase(sb));
+		else if (a->slept || woke)
