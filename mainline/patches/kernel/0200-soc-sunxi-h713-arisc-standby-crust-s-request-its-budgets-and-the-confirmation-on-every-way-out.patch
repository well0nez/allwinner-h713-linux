+/* 0x95 power key, 0x9b IR, 0xc0000000 timer (report 2.4); 10 CEC, 147 RTC are the vendor's. */
+static const char *arisc_wake_name(struct h713_arisc *a)
+{
+	if (!a->slept)
+		return "none";
+	switch (a->wake_reason) {
+	case 0x95:
+		return "key";
+	case 0x9b:
+		return "ir";
+	case 0xc0000000:
+		return "timer";
+	default:
+		return "none";
+	}
+}
