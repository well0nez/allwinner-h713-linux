-#include <linux/reset.h>
+#include <linux/delay.h>
+#include <linux/moduleparam.h>
 #include <media/v4l2-device.h>
 #include <media/v4l2-ioctl.h>
 #include <media/v4l2-event.h>
@@ -22,6 +23,49 @@
 #include "cedrus.h"
 #include "cedrus_dec.h"
 #include "cedrus_hw.h"
+#include "cedrus_regs.h"
+
+/*
+ * EXPERIMENT (package C-reset, 13.10.2026): which reset does a codec switch
+ * need? 1 = the bus reset through the guard (what 0298 did, now arbitrated),
+ * 2 = the engine mode cycled through VE_MODE_DISABLED, 3 = switch_reset_val
+ * written to the VE top register at 0x04 (the vendor's "vecore_reset") and
+ * cleared, 0 = none (control arm). Both 0x04 and the mode cycle leave the
+ * shared line alone. To be measured, then the knob goes.
+ */
+static unsigned int switch_reset = 1;
+module_param(switch_reset, uint, 0644);
+MODULE_PARM_DESC(switch_reset, "reset at a codec switch: 0 none, 1 bus reset (guarded), 2 mode cycle, 3 VE+0x04");
+static unsigned int switch_reset_val = 1;
+module_param(switch_reset_val, uint, 0644);
+MODULE_PARM_DESC(switch_reset_val, "value written to VE+0x04 for switch_reset=3");
+
+static void cedrus_switch_reset(struct cedrus_dev *dev)
+{
+	u32 before, held, after;
+
+	switch (switch_reset) {
+	case 0:
+		break;
+	case 2:
+		cedrus_write(dev, VE_MODE, VE_MODE_DISABLED);
+		udelay(10);
+		break;
+	case 3:
+		before = cedrus_read(dev, 0x04);
+		cedrus_write(dev, 0x04, switch_reset_val);
+		held = cedrus_read(dev, 0x04);
+		udelay(10);
+		cedrus_write(dev, 0x04, 0);
+		after = cedrus_read(dev, 0x04);
+		dev_info_ratelimited(dev->dev, "VE+0x04: %08x, wrote %08x reads %08x, cleared reads %08x\n",
+				     before, switch_reset_val, held, after);
+		break;
+	default:
+		cedrus_ve_reset(dev);
+		break;
+	}
+}
 
 void cedrus_device_run(void *priv)
 {
@@ -112,7 +156,7 @@
 	 * each job (VP9's adaptation is the CPU's), so nothing is lost.
 	 */
 	if (dev->last_pixfmt && dev->last_pixfmt != ctx->src_fmt.pixelformat)
-		reset_control_reset(dev->rstc);
+		cedrus_switch_reset(dev);
 	dev->last_pixfmt = ctx->src_fmt.pixelformat;
 
