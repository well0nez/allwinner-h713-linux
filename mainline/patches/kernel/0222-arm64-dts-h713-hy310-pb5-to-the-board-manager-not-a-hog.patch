 };
 
+/* PB5 stays the dtsi's hog here, not the board manager's (see above). */
+&fan_power_hog {
+	status = "okay";
+};
+
 &hdmirx {
 	allwinner,backlight-pwm-info = <5 1 40000 1 1 100>;
 };
@@ -53,6 +58,7 @@
