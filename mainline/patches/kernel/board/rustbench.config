# rustbench.config: the release defconfig (CONFIG_RUST=y since 7.3.1) with its own kernel release, <version>-rust, so a
# second Rust kernel lives next to the release kernel on one device: /boot/h713-kernel-rust.fit and
# /lib/modules/<version>-rust, never in the release's /lib/modules/<version>. For bench boots of modules with a Rust
# part (docs/kernel-rust.md, "A Rust kernel next to the release"). Developer fragment: KERNEL_CONFIG=rustbench
# build.sh kernel, never an image.
CONFIG_RUST=y
CONFIG_LOCALVERSION="-rust"
