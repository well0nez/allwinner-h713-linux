# Expose the RTC over sysfs (/sys/class/rtc/rtc0/{time,date,since_epoch}) and
# emulate the once-per-second update interrupt in software. sun6i-rtc provides
# no hardware UIE, so without these `hwclock -r` select()-times-out and the
# sysfs time files are absent; with them `hwclock`/`timedatectl` read the clock.
CONFIG_RTC_INTF_SYSFS=y
CONFIG_RTC_INTF_DEV=y
CONFIG_RTC_INTF_DEV_UIE_EMUL=y
# CONFIG_RTC_INTF_PROC is not set
CONFIG_RTC_NVMEM=y
CONFIG_RTC_DRV_AC100=y
# H713 RTC (H6-compatible block @ 0x07090000): real timekeeping, the canonical
