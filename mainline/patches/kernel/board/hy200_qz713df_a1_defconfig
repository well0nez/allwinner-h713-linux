# The kernel configuration of the image, for every board (KERNEL_DEFCONFIG in mainline/config/versions.env).
# build.sh copies it into arch/arm64/configs/ and runs make with it; the fragments next to it in this directory
# are for developer kernels only (patches/kernel/README.md). Every line counts into the kernel tree's digest.

# --- General, CPU frequency, modules
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_CGROUPS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_PERF_EVENTS=y
CONFIG_ARCH_SUNXI=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_UCLAMP_TASK=y
CONFIG_CPUFREQ_DT=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_CMA=y

# --- Network and Bluetooth
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_IP_PNP_BOOTP=y
# CONFIG_INET_DIAG is not set
CONFIG_CAN=y
CONFIG_BT=y
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_H4=y

# The stock BLE remote: bluez' HID over GATT hands its reports to the kernel through uhid.
CONFIG_UHID=y

# Its microphone: report 0x1E (60 bytes every 8 ms, scrambled SBC) reaches userspace only through /dev/hidraw
# (h713-mic, TODO 2.51).
CONFIG_HIDRAW=y

# The fix-up of that remote's consumer report descriptor (kernel 0169).
CONFIG_HID_H713_REMOTE=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y

# --- Drivers of the board and the SoC
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# The board manager: the NTC temperature through the LRADC's IIO channel and the fan's tacho on PH17 through
# hwmon. A module, so that it can be unloaded. The fan itself is switched by the PB5 line (0030), not by this
# driver. Its thermal power-off stays off (thermal_shutdown=0) until the NTC curve is checked (0141).
CONFIG_HY310_BOARD_MGR=m
CONFIG_HWMON=y

# The focus stepper (motor_ctr) as a module: its probe can run a homing drive that moves the optics, so it is
# loaded on purpose and not built in.
CONFIG_HY310_FOCUS_MOTOR=m
# CONFIG_SUNXI_NSI is not set
# CONFIG_SUNXI_TVTOP is not set

# DECD, the vendor's way of handing pictures to AFBD, as a module: it loads after U-Boot's picture and can be
# unloaded; its probe does not touch the display hardware.
CONFIG_SUNXI_DECD=m
CONFIG_SUNXI_SCANOUT_DMABUF=m

# --- Storage and wired network
CONFIG_BLK_DEV_SD=y
CONFIG_ATA=y
CONFIG_AHCI_SUNXI=y
CONFIG_NETDEVICES=y
CONFIG_SUN4I_EMAC=y
# CONFIG_NET_VENDOR_ARC is not set
# CONFIG_NET_VENDOR_BROADCOM is not set
# CONFIG_NET_VENDOR_INTEL is not set
# CONFIG_NET_VENDOR_MARVELL is not set
# CONFIG_NET_VENDOR_MICREL is not set
# CONFIG_NET_VENDOR_MICROCHIP is not set
# CONFIG_NET_VENDOR_NATSEMI is not set
# CONFIG_NET_VENDOR_SAMSUNG is not set
# CONFIG_NET_VENDOR_SEEQ is not set
# CONFIG_NET_VENDOR_SMSC is not set
CONFIG_STMMAC_ETH=y
# CONFIG_NET_VENDOR_VIA is not set
# CONFIG_NET_VENDOR_WIZNET is not set
CONFIG_MICREL_PHY=y
CONFIG_REALTEK_PHY=y

# zram as swap belongs in the image kernel: the rootfs unit needs these four. Measured on the device: 461.8 MiB
# of swap with zstd, swappiness 180, page-cluster 0 (doku/107 section 4.2). Until 11.09.2026 they were only in
# a fragment and missing from the release.
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y

# The USB gigabit adapter is the only wired network, so its driver is built in; usbnet stays a module. (A
# reason given here once, getrandom, was wrong: the hang came from the board manager, doku/60.)
CONFIG_USB_RTL8152=y
CONFIG_USB_USBNET=m
CONFIG_USB_NET_SMSC95XX=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_RTL8XXXU=m
CONFIG_RTL8XXXU_UNTESTED=y

# --- Input, serial, buses, power, thermal
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_ADC=m
CONFIG_KEYBOARD_GPIO=y
CONFIG_KEYBOARD_SUN4I_LRADC=y
# CONFIG_INPUT_MOUSE is not set
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_SUN4I=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_AXP20X_PEK=y
CONFIG_SERIO_SUN4I_PS2=y
# CONFIG_LEGACY_PTYS is not set
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=8
CONFIG_SERIAL_8250_RUNTIME_UARTS=8
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y
# CONFIG_HW_RANDOM is not set
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_MV64XXX=y
CONFIG_SPI=y
CONFIG_SPI_SUN4I=y
CONFIG_SPI_SUN6I=y
CONFIG_CHARGER_AXP20X=y
CONFIG_BATTERY_AXP20X=y
CONFIG_AXP20X_POWER=y
CONFIG_THERMAL=y
CONFIG_CPU_THERMAL=y
CONFIG_SUN8I_THERMAL=y
CONFIG_DEVFREQ_THERMAL=y
CONFIG_WATCHDOG=y
CONFIG_SUNXI_WATCHDOG=y
CONFIG_MFD_AC100=y
CONFIG_MFD_AXP20X_I2C=y
CONFIG_MFD_AXP20X_RSB=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_AXP20X=y
CONFIG_REGULATOR_GPIO=y
CONFIG_REGULATOR_PWM=y

# --- Infrared, media, display
CONFIG_RC_CORE=y
CONFIG_LIRC=y
CONFIG_RC_DECODERS=y
CONFIG_IR_NEC_DECODER=y
CONFIG_IR_RC5_DECODER=y
CONFIG_IR_RC6_DECODER=y
CONFIG_RC_DEVICES=y
CONFIG_IR_SUNXI=y
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y

# The built-in camera (Realtek 0bda:5803, UVC on USB port 1, two interfaces) binds only with these three; stock
# uses it for the autofocus (doku/94). The class driver is a module.
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=m
CONFIG_V4L_PLATFORM_DRIVERS=y
CONFIG_V4L_MEM2MEM_DRIVERS=y
CONFIG_VIDEO_SUN4I_CSI=y
CONFIG_VIDEO_SUN6I_CSI=y
CONFIG_VIDEO_SUN8I_DEINTERLACE=y
CONFIG_VIDEO_SUN8I_ROTATE=y

# The AV1 decoder (hantro's H713 variant, 0303, at 0x01c0d000, IOMMU master 5, clocked from the video engine)
# stays off for now (14.10.2026, 0310); its code, 0300-0307, stays in the series.
# CONFIG_VIDEO_HANTRO is not set
CONFIG_DRM=y

# fbdev emulation gives the AFBD KMS driver /dev/fb0 and a console on the projector: the cheapest proof that
# the picture runs.
CONFIG_DRM_FBDEV_EMULATION=y

# KMS on the AFBD scanout (0037/0038) as a module: it takes over the picture U-Boot set up, loading it late costs
# nothing, and a bad version is undone without a new kernel.
CONFIG_DRM_SUN50I_H713_AFBD=m
CONFIG_DRM_SUN4I=y
CONFIG_DRM_PANEL_LVDS=y
CONFIG_DRM_PANEL_EDP=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_DRM_SIMPLE_BRIDGE=y
CONFIG_DRM_PANFROST=m
CONFIG_FB=y
CONFIG_FB_VIRTUAL=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y

# --- Sound, USB, MMC, LEDs
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SUN4I_CODEC=y
CONFIG_SND_SUN50I_H713_MSP=m
CONFIG_SND_SUN8I_CODEC=y
CONFIG_SND_SUN8I_CODEC_ANALOG=y
CONFIG_SND_SUN4I_I2S=m
CONFIG_SND_SUN4I_SPDIF=m
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_USB_STORAGE=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_SUNXI=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_USB_GADGET=y
CONFIG_MMC=y
CONFIG_MMC_SUNXI=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_DEFAULT_ON=y

# --- RTC, DMA, the H713's own drivers
CONFIG_RTC_CLASS=y

# The RTC through sysfs, and the update interrupt emulated in software: sun6i-rtc has none in hardware, and
# without it hwclock -r runs into a timeout and the time files in sysfs are missing.
CONFIG_RTC_INTF_SYSFS=y
CONFIG_RTC_INTF_DEV=y
CONFIG_RTC_INTF_DEV_UIE_EMUL=y
# CONFIG_RTC_INTF_PROC is not set
CONFIG_RTC_NVMEM=y
CONFIG_RTC_DRV_AC100=y

# The H713's RTC, an H6-like block at 0x07090000: time keeping, the osc32k/iosc clock, and the general
# purpose registers as nvmem (GP7 carries the "reboot to fastboot" request).
CONFIG_RTC_DRV_SUN6I=y
CONFIG_DMADEVICES=y
CONFIG_DMA_SUN6I=y
CONFIG_STAGING=y
CONFIG_STAGING_MEDIA=y
CONFIG_VIDEO_SUNXI=y
CONFIG_VIDEO_SUNXI_CEDRUS=m
CONFIG_HWSPINLOCK=y
CONFIG_HWSPINLOCK_SUN6I=y
CONFIG_MAILBOX=y

# The video decoders sit behind the IOMMU: the video engine is master 0 and 1 (0042); the display stays physical
# (the H713 variant, 0041, passes every master nobody claimed).
CONFIG_SUN50I_IOMMU=y
CONFIG_HY310_CPU_COMM=m

# Restarts the display MIPS from Linux, also out of the standby's park position; owns its clock and resets.
CONFIG_SUN50I_H713_MIPS=m
CONFIG_SUN50I_H713_ARISC=m
CONFIG_VIDEO_SUN50I_H713_HDMIRX=m
CONFIG_SUN50I_H713_PPU=y

# Keeps the TVFE/TVCAP power domains and capture clocks on from the start, so built in: the firmware locks an
# HDMI signal only into a receiver that is powered and clocked, and the display and receiver drivers are
# modules and would come too late for the first plug-in (0096a, issue #1).
CONFIG_SUN50I_H713_TVCAP=y
CONFIG_IIO=y
CONFIG_IIO_ST_ACCEL_3AXIS=m
CONFIG_IIO_ST_ACCEL_I2C_3AXIS=m

# The keystone's accelerometer has no interrupt line: its buffer runs on an hrtimer trigger, which h713-keystone
# creates through configfs. So the sensor stays on while it is read, instead of being switched on and off for
# every value in sysfs (about 45 ms each time).
CONFIG_IIO_BUFFER=y
CONFIG_IIO_SW_TRIGGER=y
CONFIG_IIO_HRTIMER_TRIGGER=y
CONFIG_AXP20X_ADC=y
CONFIG_SUN20I_GPADC=y
CONFIG_SUN50I_H713_LRADC=y
CONFIG_PWM=y
CONFIG_PWM_SUN8I=y
CONFIG_PHY_SUN4I_USB=y
CONFIG_PHY_SUN9I_USB=y
CONFIG_NVMEM_SUNXI_SID=y

# --- File systems
CONFIG_AUTOFS_FS=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_TMPFS=y
CONFIG_NFS_FS=y
CONFIG_NFS_V3_ACL=y
CONFIG_NFS_V4=y
CONFIG_ROOT_NFS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# The Crypto Engine stays off on purpose - do not "complete" it. Mainline's sun8i-ce cannot drive the H713's CE
# (another task descriptor format, the vendor's two-bank block with 5-byte address fields; every algorithm
# fails its self test; no TRNG). The A53 cores have the ARMv8 crypto extensions and are faster. The one thing
# only the CE can do, the RSSK eFuse key for HDCP 1.4, needs a way of its own (doku/114).
# CONFIG_CRYPTO_DEV_SUN8I_CE is not set

# --- Debugging, kept small
CONFIG_DMA_CMA=y
CONFIG_PRINTK_TIME=y

# No debugfs in the release (12.09.2026): it closes /sys/kernel/debug/cpu_comm/call (any RPC to the display
# firmware), the writable tx_delay_* files and the write side of cpu_comm/watch, all of which sit under
# CONFIG_DEBUG_FS in the driver; the read-only status files go with them. h713-tv reports the missing path and
# "ctl rpc" says why; nothing in the rootfs reads debugfs. No enabled symbol selects DEBUG_FS, so "is not set"
# survives olddefconfig (checked 12.09.2026); DYNAMIC_DEBUG has no control file without debugfs. Developer
# kernels take board/debug.config.
# CONFIG_DYNAMIC_DEBUG is not set
# CONFIG_DEBUG_FS is not set

# "Reboot to fastboot" through the nvmem cell RTC GP7 (the reboot-mode node of the dtsi). It replaces an older
# syscon window that overlapped the RTC's registers.
CONFIG_NVMEM_REBOOT_MODE=y

# A measuring module for the CE's descriptor format, not a replacement for sun8i-ce: it registers nothing with
# the crypto core and runs exactly one task in the vendor's format (AES-128, ECB or CBC with a zero IV, key
# select 0, the key from memory, 16 bytes, to DRAM), compared with the FIPS-197 vector. It touches no key
# material of the device, binds through the device tree and runs only when asked through debugfs (doku/114
# section 7, step 3). A release may drop this line.
CONFIG_H713_CE_TEST=m

# Magic SysRq in the image kernel (doku/124): when the eMMC stops answering, reboot and systemctl hang and
# systemd holds /dev/watchdog0, while echo b > /proc/sysrq-trigger and a break on the UART need no file
# system. It does not help when every CPU hangs.
CONFIG_MAGIC_SYSRQ=y
CONFIG_MAGIC_SYSRQ_SERIAL=y
CONFIG_MAGIC_SYSRQ_DEFAULT_ENABLE=0x1

# /sys/power/pm_wakeup_irq (with PM_SLEEP_DEBUG): h713-power reads which interrupt broke off a standby
# (TODO 5.14); pm_test comes with it.
CONFIG_PM_DEBUG=y
