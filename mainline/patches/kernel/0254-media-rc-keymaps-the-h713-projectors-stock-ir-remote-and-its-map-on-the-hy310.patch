+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * The stock IR remote of the H713 projectors HY310 and HY300PRO-G-EU: NEC,
+ * customer code 0xfd02 (address 0x02), scancode = address << 8 | command.
+ *
+ * The table is the vendor's customer_ir_fd02.kl; the Linux names follow the
+ * Bluetooth side of the same remote (hid-h713-remote): Home is KEY_HOMEPAGE,
+ * focus up KEY_F4, focus down KEY_F5. Measured on the HY310 (doku/134): all
+ * keys decode; the mouse and the microphone key both send 0x66, which the
+ * vendor names PRJ_BRC_PAIR - over IR they ask for the Bluetooth pairing,
+ * their own functions run over Bluetooth only - and 0x45 (MOUSE in the
+ * table) never came. Measured again on 11.10.2026: both keys 0x66, and a
+ * second later the remote offered itself for pairing. Not KEY_BLUETOOTH:
+ * the rfkill input handler would read that as "switch Bluetooth on/off".
+ * Which of 0x50/0x51 is focus up was measured both ways (02.10. and
+ * 03.10.); the table's naming is kept until it is settled.
+ */
+
+#include <linux/module.h>
+#include <media/rc-map.h>
+
+static struct rc_map_table h713_fd02[] = {
+	{ 0x021d, KEY_POWER },
+	{ 0x0202, KEY_MUTE },
+	{ 0x0215, KEY_VOLUMEUP },
+	{ 0x0211, KEY_VOLUMEDOWN },
+	{ 0x0209, KEY_UP },
+	{ 0x0201, KEY_DOWN },
+	{ 0x020a, KEY_LEFT },
+	{ 0x0208, KEY_RIGHT },
+	{ 0x020b, KEY_OK },
+	{ 0x021f, KEY_BACK },
+	{ 0x021e, KEY_MENU },		/* SETTINGS */
+	{ 0x020d, KEY_HOMEPAGE },
+	{ 0x0245, KEY_F3 },		/* MOUSE in the table, never seen */
+	{ 0x0266, KEY_F6 },		/* PRJ_BRC_PAIR: mouse and microphone */
+	{ 0x0251, KEY_F4 },		/* PRJ_FOCUS_UP */
+	{ 0x0250, KEY_F5 },		/* PRJ_FOCUS_DN */
+};
+
+static struct rc_map_list h713_fd02_map = {
+	.map = {
+		.scan	  = h713_fd02,
+		.size	  = ARRAY_SIZE(h713_fd02),
+		.rc_proto = RC_PROTO_NEC,
+		.name	  = RC_MAP_H713_FD02,
+	}
+};
+
+static int __init init_rc_map_h713_fd02(void)
+{
+	return rc_map_register(&h713_fd02_map);
+}
+
+static void __exit exit_rc_map_h713_fd02(void)
+{
+	rc_map_unregister(&h713_fd02_map);
+}
+
+module_init(init_rc_map_h713_fd02)
+module_exit(exit_rc_map_h713_fd02)
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("H713 projectors' stock IR remote (NEC 0xfd02) keytable");
