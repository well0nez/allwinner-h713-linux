--- a/drivers/misc/sunxi_decd/decd_types.h
+++ b/drivers/misc/sunxi_decd/decd_types.h
@@ -182,6 +182,7 @@
 	spinlock_t ready_lock;
 	struct list_head ready_list;
 	u32 ready_count;
+	u32 repeating;
