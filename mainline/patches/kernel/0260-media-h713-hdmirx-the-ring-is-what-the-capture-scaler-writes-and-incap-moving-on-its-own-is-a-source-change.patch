+/*
  * Drop the remembered timing (struct h713_hdmirx). Everything that can mean
  * another source does this: both firmware callbacks, a ring that has stopped
  * moving, and INCAP reading other words than it read at the measurement.
@@ -3696,57 +3737,44 @@
 
 /*
  * The ring's geometry from the capture block, with the source's active size
- * (@src_w x @src_h, INCAP +0x874) and the rowbyte word (+0x924) already read.
- *
- * The rule, in this order and with the rowbyte as the only primary source:
- *
- *  1. pitch = rowbyte * 16. A rowbyte of zero, or a luma pitch that differs
- *     from the chroma pitch, is not a ring this driver knows how to describe;
- *     then ALIGN(src_w, 16) stands in -- the rounding rule measured for every
- *     width so far -- with a line in the log.
+ * (@src_w x @src_h, INCAP +0x874), the rowbyte word (+0x924) and the capture
+ * scaler's output size (+0x86c, +0x870) already read.
  *
+ *  1. pitch = rowbyte * 16 (0136f). A rowbyte of zero, or a luma pitch that
+ *     differs from the chroma pitch, is not a ring this driver knows how to
+ *     describe; then ALIGN(src_w, 16) stands in, with a line in the log.
  *  2. pitch >= ALIGN(src_w, 16): the firmware does not scale, the ring is the
- *     source, src_w x src_h. This is every case on the HY310 (1920x1080 panel):
- *     1920 for 1920, 1280 for 1280, 1376 for 1366 (doku/nachtlog/E4, 08.09.).
- *     A pitch above the rounded width has never been measured as a steady
- *     state; it is what a change in flight can leave for a moment (active
- *     rewritten, rowbyte not yet), and it is reported as today: the source's
- *     size with the pitch as read, a valid format with padding.
- *
- *  3. pitch < ALIGN(src_w, 16): the firmware scales down in its capture path
- *     (HY300 Pro, 1280x720 panel, 1920x1080 source: rowbyte 0x36 -> 864). The
- *     ring's width is the pitch -- NV16 luma bytes are pixels, and 864 is the
- *     tightest width the pitch admits; the true width lies in (pitch - 15,
- *     pitch] and only the picture scaler's window below can name it exactly.
- *     The height follows the source's aspect ratio, rounded DOWN to an even
- *     count: 852 * 1080 / 1920 = 479.25 was measured as 478, not 479 or 480
- *     (19.09.2026), and the plane refuses an odd height in any case
- *     (sun50i-h713-afbd atomic_check, fb->height % 2). With the pitch as the
- *     width that is 864 x 486 for the case above.
- *
- *  4. Cross-check, only in case 3 and only with allwinner,scaler in the tree:
- *     the picture scaler's input window (H713_SCALER_IN_WIN) is taken instead
- *     of the arithmetic when it is consistent with what the rowbyte and the
- *     source already said -- a non-empty window no wider than the pitch whose
- *     rounded width IS the pitch (ALIGN(852, 16) == 864) and whose height is
- *     within two lines of the source's aspect ratio applied to its width. Then
- *     the ring is 852 x 478, exactly. A stale window fails the first test
- *     (1280x720 against a pitch of 864 or 1920) or the second (another
- *     source's shape) and is ignored; the arithmetic stands. The register is
- *     never consulted when the rowbyte says the ring is the source, so on the
- *     HY310 it is never read at all.
- *
- * One ratelimited line when the ring is not the source, none when it is:
- * "source 1920x1080, ring 852x478 pitch 864 - the firmware scales".
- */
-static void h713_hdmirx_ring_geometry(struct h713_hdmirx *rx,
-				      unsigned int src_w, unsigned int src_h,
-				      u32 rowbyte,
-				      struct h713_hdmirx_ring_geometry *ring)
+ *     source -- every HY310 case, byte-identical to 0136f.
+ *  3. pitch < ALIGN(src_w, 16): the firmware scales, and the ring is what its
+ *     capture scaler writes, +0x86c x +0x870. Measured 12.10.2026 on the
+ *     HY300PRO-G-EU (1280x720 panel), the registers and the slots' fill
+ *     height alike (arbeit/wurzeln-20261012): 1280x1024 -> 900x720, pitch
+ *     912; 1024x768 -> 960x720, pitch 960; 1360x768 -> 1274x720, pitch 1280;
+ *     1366x768 -> 1280x718, pitch 1280; 1920x1080 -> 1280x720, pitch 1280.
+ *     The scaler keeps the aspect, bounded by both panel sides (1366x768 is
+ *     bounded by the width: 718 lines), and the pitch is the width rounded
+ *     up to 16. The output words have to agree with the rowbyte and with
+ *     the source: 0 < out_w <= src_w, ALIGN(out_w, 16) == pitch,
+ *     0 < out_h <= src_h. Otherwise INCAP is mid-change -- its words move one
+ *     after another (0136v) -- and the answer is -ENOLCK, not a guess.
+ *
+ * Until 12.10.2026 rule 3 derived the height from the aspect ratio,
+ * src_h * pitch / src_w, and took the pitch as the width: 912x728 for
+ * 1280x1024 and 1280x722 for 1360x768, both taller than the panel and both
+ * refused by the display side, the console for two common PC modes (TODO
+ * 2.69). The DE picture scaler's input window (syscon@5180000 +0x34) served
+ * as a cross-check for the same information and is not consulted any more:
+ * the firmware writes it only when it rebuilds its window chain, and it read
+ * 1280x720 while INCAP already captured 1280x1024.
+ *
+ * One ratelimited line when the ring is not the source, none when it is.
+ */
+static int h713_hdmirx_ring_geometry(struct h713_hdmirx *rx,
+				     unsigned int src_w, unsigned int src_h,
+				     u32 rowbyte, u32 out_w, u32 out_h,
+				     struct h713_hdmirx_ring_geometry *ring)
 {
 	unsigned int pitch = (rowbyte & 0xffff) * H713_INCAP_ROWBYTE_UNIT;
-	const char *how = "by the rowbyte";
-	u32 win;
 
 	if (!pitch || (rowbyte >> 16) != (rowbyte & 0xffff)) {
 		dev_warn_ratelimited(rx->dev,
@@ -3759,29 +3787,27 @@
 	if (pitch >= ALIGN(src_w, H713_INCAP_ROWBYTE_UNIT)) {
 		ring->width = src_w;
 		ring->height = src_h;
-		return;
+		return 0;
 	}
 
-	ring->width = pitch;
-	ring->height = (src_h * pitch / src_w) & ~1U;
-
-	if (rx->scaler && !regmap_read(rx->scaler, H713_SCALER_IN_WIN, &win)) {
-		unsigned int w = win >> 16, h = win & 0xffff;
-		unsigned int expect = w ? src_h * w / src_w : 0;
-
-		if (w && h && w <= pitch &&
-		    ALIGN(w, H713_INCAP_ROWBYTE_UNIT) == pitch &&
-		    h <= expect + 2 && h + 2 >= expect) {
-			ring->width = w;
-			ring->height = h;
-			how = "by the picture scaler";
-		}
+	out_w &= 0xffff;
+	out_h &= 0xffff;
+	if (!out_w || out_w > src_w ||
+	    ALIGN(out_w, H713_INCAP_ROWBYTE_UNIT) != pitch ||
+	    !out_h || out_h > src_h) {
+		dev_info_ratelimited(rx->dev,
+				     "source %ux%u, pitch %u, but the capture scaler says %ux%u -- INCAP is mid-change\n",
+				     src_w, src_h, pitch, out_w, out_h);
+		return -ENOLCK;
 	}
+	ring->width = out_w;
+	ring->height = out_h;
 
 	dev_info_ratelimited(rx->dev,
-			     "source %ux%u, ring %ux%u pitch %u - the firmware scales (%s)\n",
-			     src_w, src_h, ring->width, ring->height, ring->pitch,
-			     how);
+			     "source %ux%u, ring %ux%u pitch %u - the firmware scales\n",
+			     src_w, src_h, ring->width, ring->height, ring->pitch);
+
+	return 0;
 }
 
