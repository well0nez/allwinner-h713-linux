 static const char * const h713_hdmirx_pq_steps[] = {
@@ -1319,7 +1306,6 @@
 	 * read on demand, under sig_lock, through a mapping made on first use.
 	 */
 	struct regmap *incap;
-	struct regmap *scaler;		/* DE picture scaler, read only, optional */
 
 	/*
 	 * The firmware's mode table, copied out of the TSE window at probe:
@@ -1367,6 +1353,11 @@
 	 */
 	struct regmap *link;
 	struct delayed_work audio_work;
+
+	/* the geometry poll: INCAP moving without a firmware callback (2.68) */
+	struct delayed_work geometry_work;
+	u32 seen_active, seen_rowbyte, seen_out;
+	bool seen_looked;
 	struct h713_hdmirx_audio audio_last;
 	/*
 	 * Set for good when this instance finds the display MIPS not running
@@ -2026,6 +2017,56 @@
 }
 
 /*
+ * INCAP moves on its own. After a mode change the firmware's record names the
+ * new source at once, the capture block follows only when the firmware has
+ * rebuilt its capture chain, seconds later at times, and that step comes with
+ * no callback: a client that asked in between holds a ring that is no longer
+ * written, and nothing tells it. Measured 12.10.2026 on the HY300PRO-G-EU with
+ * h713-warp streaming (TODO 2.68, arbeit/wurzeln-20261012): INCAP read
+ * 1152x720 of the previous 1440x900 for a 720x480 source through three
+ * callbacks, then moved to 720x480 without one; the warp kept drawing
+ * 1152x720 slots of a 720-byte ring until the next mode change.
+ *
+ * So the block is looked at ten times a second, and when its active size,
+ * rowbyte or scaler output differ from what the driver saw at its last
+ * detection, that is a source change and is reported as one. The client
+ * stops its queue and asks again (QUERY_DV_TIMINGS), as for every other
+ * source change event; a block mid-change answers -ENOLCK there and is asked
+ * again. A block that reads zero (the TVCAP domain off) is not a change.
+ */
+static void h713_hdmirx_geometry_work(struct work_struct *work)
+{
+	struct h713_hdmirx *rx = container_of(to_delayed_work(work),
+					      struct h713_hdmirx, geometry_work);
+	u32 active, rowbyte, out_w, out_h, out;
+
+	if (READ_ONCE(rx->seen_looked) && video_is_registered(&rx->vdev) &&
+	    !regmap_read(rx->incap, H713_INCAP_ACTIVE, &active) &&
+	    !regmap_read(rx->incap, H713_INCAP_ROWBYTE, &rowbyte) &&
+	    !regmap_read(rx->incap, H713_INCAP_OUT_W, &out_w) &&
+	    !regmap_read(rx->incap, H713_INCAP_OUT_H, &out_h) &&
+	    active && rowbyte) {
+		out = out_w << 16 | (out_h & 0xffff);
+		if (active != READ_ONCE(rx->seen_active) ||
+		    rowbyte != READ_ONCE(rx->seen_rowbyte) ||
+		    out != READ_ONCE(rx->seen_out)) {
+			WRITE_ONCE(rx->seen_active, active);
+			WRITE_ONCE(rx->seen_rowbyte, rowbyte);
+			WRITE_ONCE(rx->seen_out, out);
+			dev_info_ratelimited(rx->dev,
+					     "INCAP moved without a callback: active %ux%u, scaler out %ux%u, pitch %u -- source change reported\n",
+					     active >> 16, active & 0xffff,
+					     out_w & 0xffff, out_h & 0xffff,
+					     (rowbyte & 0xffff) * H713_INCAP_ROWBYTE_UNIT);
+			h713_hdmirx_src_change(rx);
+		}
+	}
+
+	queue_delayed_work(system_wq, &rx->geometry_work,
+			   msecs_to_jiffies(H713_GEOMETRY_POLL_MS));
+}
