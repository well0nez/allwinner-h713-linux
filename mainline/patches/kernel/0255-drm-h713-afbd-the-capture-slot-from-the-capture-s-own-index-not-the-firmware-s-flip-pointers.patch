 /*
+ * Which word names the slot to show: the firmware's flip pointers (0), or the
+ * capture's own index of the slot it is writing (1, the default wherever the
+ * INCAP syscon is reachable).
+ *
+ * The pointers are what stock's channel follows, and with a source at the
+ * panel's size they name the slot being filled, a few hundred lines behind the
+ * capture, and every frame reaches the panel. With a 1080p60 source scaled
+ * down to a 720p panel they do not: the pointer then names a slot finished one
+ * to three frames earlier, holds it for two vsyncs every fourth or fifth frame
+ * and skips the next -- 43 to 57 of 60 frames shown, and the loss grows over
+ * hours (doku/197, 198). The capture itself writes all 60 frames in strict
+ * rotation, so the slot can be chosen from its index instead, with no help
+ * from the firmware's publisher (doku/200).
+ */
+static unsigned int ring_select = 1;
+module_param(ring_select, uint, 0644);
+MODULE_PARM_DESC(ring_select,
+		 "capture slot to show: 0 the firmware's flip pointers, 1 the capture's own write index (default)");
+
+/* One entry of the capture's slot table, as a flip pair, checked against the ring. */
+static bool h713_afbd_slot_pair(struct h713_afbd *h, unsigned int slot,
+				struct h713_afbd_flip *f)
+{
+	u32 y, c;
+
+	if (regmap_read(h->incap, H713_INCAP_SLOT_Y + 4 * slot, &y) ||
+	    regmap_read(h->incap, H713_INCAP_SLOT_C + 4 * slot, &c))
+		return false;
+	f->y = y << H713_INCAP_ADDR_SHIFT;
+	f->c = c << H713_INCAP_ADDR_SHIFT;
+
+	return h713_afbd_in_ring(h, f->y) && h713_afbd_in_ring(h, f->c);
+}
+
+/*
+ * Choose the slots from the capture's index. Two answers, because the two
+ * consumers read at different times:
+ *
+ *   @done  the slot the capture finished at the last frame boundary, the
+ *          index minus one. Whole now, and the capture does not come back to
+ *          it for two more frame periods. This is what the notifier gets: its
+ *          consumer (the warp, through the capture driver) reads the slot
+ *          within a few milliseconds.
+ *
+ *   @next  the slot for the plane. Addresses written into the pool-1 queue
+ *          during a frame are fetched from the next vsync on, and the fetch
+ *          then takes a whole panel period. For a source at least about as
+ *          fast as the panel that is the slot being written NOW: it is
+ *          finished by the next vsync -- at worst the fetch starts a few lines
+ *          behind the capture, which it never overtakes -- and the capture
+ *          returns to it two frame periods later, when the fetch is at the
+ *          bottom. The finished slot would be wrong here: for a stretch of
+ *          vsyncs in every beat of the two clocks its fetch would start just
+ *          as the capture starts overwriting it, and the faster capture would
+ *          tear it. For a slow source (30 Hz into a 60 Hz panel) it is the
+ *          other way round: the slot being written is not finished by the
+ *          next vsync and the fetch overtakes the capture, while the finished
+ *          one stays whole for three of its periods.
+ *
+ * The rate test: source frames against vsyncs, accumulated over 32 vsyncs;
+ * below 0.8 the source counts as slow. Until the first window is complete the
+ * source is taken as fast -- the common case, and the one with the worse
+ * failure when got wrong. The caller holds ring_lock.
+ */
+static bool h713_afbd_pick_slots(struct h713_afbd *h,
+				 struct h713_afbd_flip *done,
+				 struct h713_afbd_flip *next)
+{
+	unsigned int idx, prev;
+	u32 frame;
+
+	if (regmap_read(h->incap, H713_INCAP_WRITING, &idx) ||
+	    regmap_read(h->incap, H713_INCAP_FRAME, &frame))
+		return false;
+	if (idx >= H713_INCAP_RING_SLOTS)
+		return false;
+
+	frame >>= 16;
+	h->ring_rate_sum += (frame - h->ring_frame) & 0xffff;
+	h->ring_frame = frame;
+	if (++h->ring_rate_n == 32) {
+		h->ring_slow = h->ring_rate_sum * 5 < 32 * 4;
+		h->ring_rate_n = 0;
+		h->ring_rate_sum = 0;
+	}
+
+	prev = (idx + H713_INCAP_RING_SLOTS - 1) % H713_INCAP_RING_SLOTS;
+	if (!h713_afbd_slot_pair(h, prev, done))
+		return false;
+	if (h->ring_slow) {
+		*next = *done;
+		return true;
+	}
+
+	return h713_afbd_slot_pair(h, idx, next);
+}
