+static int msp_switch_get(struct snd_kcontrol *kcontrol,
+			  struct snd_ctl_elem_value *ucontrol)
+{
+	struct h713_msp *msp = snd_kcontrol_chip(kcontrol);
+
+	mutex_lock(&msp->lock);
+	ucontrol->value.integer.value[0] = msp->input_on;
+	mutex_unlock(&msp->lock);
+	return 0;
+}
+
+static int msp_switch_put(struct snd_kcontrol *kcontrol,
+			  struct snd_ctl_elem_value *ucontrol)
+{
+	struct h713_msp *msp = snd_kcontrol_chip(kcontrol);
+	bool on = !!ucontrol->value.integer.value[0];
+	int ret = 0;
+
+	mutex_lock(&msp->lock);
+	if (msp->input_on == on) {
+		mutex_unlock(&msp->lock);
+		return 0;
+	}
+	msp->input_on = on;
+
+	if (msp->state == MSP_STATE_RUNNING) {
+		ret = msp_dsp_update(msp, DSP_I2SIN1_CFG, 0x8000, on ? 0x8000 : 0);
+		if (ret)
+			msp_mailbox_failed(msp, ret);
+	}
+	mutex_unlock(&msp->lock);
+
+	return ret ? -EIO : 1;
+}
+
+static int msp_mute_get(struct snd_kcontrol *kcontrol,
+			struct snd_ctl_elem_value *ucontrol)
+{
+	struct h713_msp *msp = snd_kcontrol_chip(kcontrol);
+
+	mutex_lock(&msp->lock);
+	ucontrol->value.integer.value[0] = msp->mute;
+	mutex_unlock(&msp->lock);
+	return 0;
+}
+
+static int msp_mute_put(struct snd_kcontrol *kcontrol,
+			struct snd_ctl_elem_value *ucontrol)
+{
+	struct h713_msp *msp = snd_kcontrol_chip(kcontrol);
+	bool mute = !!ucontrol->value.integer.value[0];
+	u16 val = mute ? MSP_MUTE_VALUE : 0;
+	int ret = 0;
+
+	mutex_lock(&msp->lock);
+	if (msp->mute == mute) {
+		mutex_unlock(&msp->lock);
+		return 0;
+	}
+	msp->mute = mute;
+
+	if (msp->state == MSP_STATE_RUNNING) {
+		ret = msp_dsp_update(msp, DSP_MASTER_VOL_L, MSP_VOL_MASK, val);
+		if (!ret)
+			ret = msp_dsp_update(msp, DSP_MASTER_VOL_R,
+					     MSP_VOL_MASK, val);
+		if (ret)
+			msp_mailbox_failed(msp, ret);
+	}
+	mutex_unlock(&msp->lock);
+
+	return ret ? -EIO : 1;
+}
+
+static int msp_volume_info(struct snd_kcontrol *kcontrol,
+			   struct snd_ctl_elem_info *uinfo)
+{
+	uinfo->type = SNDRV_CTL_ELEM_TYPE_INTEGER;
+	uinfo->count = 1;
+	uinfo->value.integer.min = 0;
+	uinfo->value.integer.max = MSP_VOL_MAX;
+	uinfo->value.integer.step = 1;
+	return 0;
+}
+
+static int msp_volume_get(struct snd_kcontrol *kcontrol,
+			  struct snd_ctl_elem_value *ucontrol)
+{
+	struct h713_msp *msp = snd_kcontrol_chip(kcontrol);
+
+	mutex_lock(&msp->lock);
+	ucontrol->value.integer.value[0] = msp->volume;
+	mutex_unlock(&msp->lock);
+	return 0;
+}
+
+static int msp_volume_put(struct snd_kcontrol *kcontrol,
+			  struct snd_ctl_elem_value *ucontrol)
+{
+	struct h713_msp *msp = snd_kcontrol_chip(kcontrol);
+	long value = ucontrol->value.integer.value[0];
+	u16 reg;
+	int ret = 0;
+
+	if (value < 0 || value > MSP_VOL_MAX)
+		return -EINVAL;
+
+	mutex_lock(&msp->lock);
+	if (msp->volume == value) {
+		mutex_unlock(&msp->lock);
+		return 0;
+	}
+	msp->volume = value;
+	reg = msp_volume_to_reg(value);
+
+	if (msp->state == MSP_STATE_RUNNING) {
+		ret = msp_dsp_update(msp, DSP_VOLUME_L, MSP_VOL_MASK, reg);
+		if (!ret)
+			ret = msp_dsp_update(msp, DSP_VOLUME_R, MSP_VOL_MASK, reg);
+		if (ret)
+			msp_mailbox_failed(msp, ret);
+	}
+	mutex_unlock(&msp->lock);
+
+	return ret ? -EIO : 1;
+}
