+
+static ssize_t state_show(struct device *dev, struct device_attribute *attr,
+			  char *buf)
+{
+	struct h713_msp *msp = dev_get_drvdata(dev);
+	ssize_t len;
+
+	mutex_lock(&msp->lock);
+	len = sysfs_emit(buf, "%s\n", msp_state_names[msp->state]);
+	mutex_unlock(&msp->lock);
+
+	return len;
+}
+static DEVICE_ATTR_RO(state);
+
+/*
+ * QPEAK, the DSP's own level meter (S25 section 8). Its two inputs are
+ * pointed at I2SIN1.out0/out1 on every read, because Mute_All_Modules zeroes
+ * them and because a caller that just healed would otherwise measure a
+ * module that is no longer connected. A read costs about 50 ms.
+ */
+static int msp_read_levels(struct h713_msp *msp, u16 *left, u16 *right)
+{
+	u16 scratch;
+	int ret;
+
+	ret = msp_dsp_write(msp, DSP_QPEAK_IN0, DSP_PORT_I2SIN1_OUT0);
+	if (!ret)
+		ret = msp_dsp_read(msp, DSP_CLOCK, &scratch);
+	if (!ret)
+		ret = msp_dsp_write(msp, DSP_QPEAK_IN1, DSP_PORT_I2SIN1_OUT1);
+	if (!ret)
+		ret = msp_dsp_read(msp, DSP_CLOCK, &scratch);
+	if (ret)
+		return ret;
+
+	msleep(MSP_QPEAK_SETTLE_MS);
+
+	ret = msp_dsp_read(msp, DSP_QPEAK_L, left);
+	if (!ret)
+		ret = msp_dsp_read(msp, DSP_QPEAK_R, right);
+
+	return ret;
+}
+
+static ssize_t levels_show(struct device *dev, struct device_attribute *attr,
+			   char *buf)
+{
+	struct h713_msp *msp = dev_get_drvdata(dev);
+	u16 left = 0, right = 0;
+	int ret;
+
+	mutex_lock(&msp->lock);
+	if (msp->state != MSP_STATE_PATCHED && msp->state != MSP_STATE_RUNNING) {
+		mutex_unlock(&msp->lock);
+		return -ENODEV;
+	}
+
+	ret = msp_read_levels(msp, &left, &right);
+	if (ret)
+		msp_mailbox_failed(msp, ret);
+	mutex_unlock(&msp->lock);
+
+	if (ret)
+		return ret;
+
+	return sysfs_emit(buf, "%u %u\n", left, right);
+}
+static DEVICE_ATTR_RO(levels);
+
+/*
+ * 0 means PCM or no valid signal, 1 means an IEC 61937 stream. Bit 7 of
+ * 0x800A gates the word, bit 5 says compressed and bits 4:0 name the type;
+ * the full decode is in debugfs, because a sysfs attribute holds one value.
+ */
+static ssize_t compressed_show(struct device *dev,
+			       struct device_attribute *attr, char *buf)
+{
+	struct h713_msp *msp = dev_get_drvdata(dev);
+	u16 status = 0;
+	int ret;
+
+	mutex_lock(&msp->lock);
+	if (msp->state != MSP_STATE_RUNNING) {
+		mutex_unlock(&msp->lock);
+		return -ENODEV;
+	}
+
+	ret = msp_dsp_read(msp, DSP_SPDIFRX2_STATUS, &status);
+	if (ret)
+		msp_mailbox_failed(msp, ret);
+	mutex_unlock(&msp->lock);
+
+	if (ret)
+		return ret;
+
+	return sysfs_emit(buf, "%u\n",
+			  (status & DSP_NONPCM_VALID) &&
+			  (status & DSP_NONPCM_COMPRESSED) ? 1 : 0);
+}
+static DEVICE_ATTR_RO(compressed);
+
+/*
+ * Synchronous on purpose: "echo 1 > reset" is the acceptance step, and a
+ * caller that can hear the result wants to know when it is done. Takes about
+ * a second.
+ */
+static ssize_t reset_store(struct device *dev, struct device_attribute *attr,
+			   const char *buf, size_t count)
+{
+	struct h713_msp *msp = dev_get_drvdata(dev);
+	bool go;
+	int ret;
+
+	ret = kstrtobool(buf, &go);
+	if (ret)
+		return ret;
+	if (!go)
+		return count;
+
+	cancel_work_sync(&msp->heal);
+
+	mutex_lock(&msp->lock);
+	msp->heal_count = 0;
+	ret = msp_bringup(msp);
+	mutex_unlock(&msp->lock);
+
+	if (ret)
+		return ret;
+
+	return count;
+}
+static DEVICE_ATTR_WO(reset);
+
+static struct attribute *msp_attrs[] = {
+	&dev_attr_state.attr,
+	&dev_attr_levels.attr,
+	&dev_attr_compressed.attr,
+	&dev_attr_reset.attr,
+	NULL,
+};
