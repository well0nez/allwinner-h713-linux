+	MSP_CLK_CIP_TSP,	/* 0xd30 */
+	MSP_CLK_TSA_TSP,	/* 0xd34 */
+	MSP_CLK_CIP27,		/* 0xd38 */
+	MSP_CLK_CIP_MTS0,	/* 0xd40 */
