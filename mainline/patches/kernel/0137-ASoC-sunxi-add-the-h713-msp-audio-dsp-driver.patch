+
+static u16 msp_volume_to_reg(long value)
+{
+	int quarter_db = (int)value - MSP_VOL_MAX;
+
+	return (u16)((quarter_db & 0x3ff) << MSP_VOL_SHIFT);
+}
+
+static long msp_reg_to_volume(u16 reg)
+{
+	int quarter_db = sign_extend32(reg >> MSP_VOL_SHIFT, MSP_VOL_BITS - 1);
+
+	return clamp(quarter_db + MSP_VOL_MAX, 0, MSP_VOL_MAX);
+}
+
+static int msp_apply_controls(struct h713_msp *msp)
+{
+	u16 volume = msp_volume_to_reg(msp->volume);
+	u16 mute = msp->mute ? MSP_MUTE_VALUE : 0;
+	int ret;
+
+	ret = msp_dsp_update(msp, DSP_I2SIN1_CFG, 0x8000,
+			     msp->input_on ? 0x8000 : 0);
+	if (!ret)
+		ret = msp_dsp_update(msp, DSP_VOLUME_L, MSP_VOL_MASK, volume);
+	if (!ret)
+		ret = msp_dsp_update(msp, DSP_VOLUME_R, MSP_VOL_MASK, volume);
+	if (!ret)
+		ret = msp_dsp_update(msp, DSP_MASTER_VOL_L, MSP_VOL_MASK, mute);
+	if (!ret)
+		ret = msp_dsp_update(msp, DSP_MASTER_VOL_R, MSP_VOL_MASK, mute);
+
+	return ret;
+}
+
+static int msp_build_graph(struct h713_msp *msp)
+{
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < ARRAY_SIZE(msp_graph); i++) {
+		const struct msp_graph_step *step = &msp_graph[i];
+
+		ret = msp_dsp_update(msp, step->addr, step->mask, step->val);
+		if (ret) {
+			dev_err(msp->dev, "Graph-Schritt \"%s\" (%#06x) gescheitert (%d)\n",
+				step->what, step->addr, ret);
+			return ret;
+		}
+	}
+
+	return 0;
+}
+
+/* ------------------------------------------------------------------------ */
+/* State machine                                                             */
+/* ------------------------------------------------------------------------ */
+
+static int msp_bringup(struct h713_msp *msp)
+{
+	int ret;
+
+	lockdep_assert_held(&msp->lock);
+
+	msp->state = MSP_STATE_BOOTING;
+
+	msp_island_down(msp);
+	ret = msp_island_up(msp);
+	if (ret)
+		goto fail;
+
+	ret = msp_selftest(msp);
+	if (ret)
+		goto fail;
+
+	ret = msp_download(msp);
+	if (ret)
+		goto fail;
+	msp->state = MSP_STATE_PATCHED;
+
+	ret = msp_build_graph(msp);
+	if (ret)
+		goto fail;
+
+	ret = msp_apply_controls(msp);
+	if (ret)
+		goto fail;
+
+	msp->state = MSP_STATE_RUNNING;
+	dev_info(msp->dev, "MSP laeuft: HDMI -> I2SIN1 -> VOLUME -> I2SOUT1\n");
+	return 0;
+
+fail:
+	msp->state = MSP_STATE_ERROR;
+	return ret;
+}
+
+/*
+ * Self-healing. Every mailbox timeout outside the bring-up lands here; the
+ * bring-up itself already loops in this worker. Three attempts, then the
+ * state stays "error" until somebody writes the sysfs attribute "reset".
+ */
+static void msp_heal_work(struct work_struct *work)
+{
+	struct h713_msp *msp = container_of(work, struct h713_msp, heal);
+
+	mutex_lock(&msp->lock);
+
+	if (msp->state != MSP_STATE_ERROR)
+		goto out;
+
+	while (msp->heal_count < MSP_HEAL_MAX) {
+		msp->heal_count++;
+		dev_warn(msp->dev, "Selbstheilung %u/%u: Insel-Reset und Neuaufbau\n",
+			 msp->heal_count, MSP_HEAL_MAX);
+
+		if (!msp_bringup(msp)) {
+			msp->heal_count = 0;
+			goto out;
+		}
+	}
+
+	dev_err(msp->dev,
+		"Selbstheilung nach %u Versuchen aufgegeben -- Zustand bleibt \"error\", \"echo 1 > reset\" versucht es erneut\n",
+		MSP_HEAL_MAX);
+out:
+	mutex_unlock(&msp->lock);
+}
+
+/* Called with the lock held, from every path that is not the bring-up. */
+static void msp_mailbox_failed(struct h713_msp *msp, int ret)
+{
+	if (ret != -ETIMEDOUT || msp->state == MSP_STATE_ERROR)
+		return;
+
+	msp->state = MSP_STATE_ERROR;
+	schedule_work(&msp->heal);
+}
