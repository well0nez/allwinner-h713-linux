diff -Nur a/sound/soc/sunxi/sun50i-h713-msp.c b/sound/soc/sunxi/sun50i-h713-msp.c
--- a/sound/soc/sunxi/sun50i-h713-msp.c	1970-01-01 01:00:00.000000000 +0100
+++ b/sound/soc/sunxi/sun50i-h713-msp.c	2026-09-08 18:27:48.192307790 +0200
@@ -0,0 +1,1591 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * sun50i-h713-msp.c -- the MSP audio DSP of the Allwinner H713: island
+ * bring-up, patch download over the mailbox, the HDMI-to-speaker graph, and
+ * an ALSA card that carries nothing but the three controls that graph needs.
+ *
+ * The H713 routes HDMI audio through a Trident "MSP" DSP that sits on the
+ * demodulator bus at 0x0614xxxx, next to CIP and the demux. Nothing on the
+ * ARM owns that block on a vendor system either: the stock kernel module
+ * snd_alsa_trid.ko has no clk_get, no reset_control_*, no pm_runtime at all
+ * (doku/nachtlog/S17), the island is brought up by sunxi_tvtop, and the
+ * mailbox is driven from user space through libmspdriver.so. This driver
+ * does all of it in one place, because on mainline there is no tvtop and no
+ * vendor HAL.
+ *
+ * There is no PCM device here on purpose. Nothing streams through the ARM:
+ * the receiver's I2S goes into the DSP, the DSP's I2SOUT1 goes into the
+ * codec's I2S window, and the only thing left for software is to switch the
+ * input on, set the volume and mute. That is a control-only card
+ * (doku/101-plan-audio-treiber.md section 2).
+ *
+ * Bring-up, measured on a HY310 on 08.09.2026 and written down in
+ * doku/101-plan-audio-treiber.md section 3.5 (reference implementation
+ * re/captures/weltneuheit/s16-audio-20260908/dsp_island2.py):
+ *
+ *   1. bus-demod gate off, bus-demod reset asserted, 10 ms
+ *   2. reset deasserted, gate on, 20 ms  -- the whole Trident front-end
+ *      address space reads 0 without this (S17 section 2c)
+ *   3. TVFE router 0x06700000 := 0x003003FF, 12 ms
+ *   4. audio top 0x0614A000 |= 0x700; 0x0614A00C := (old & 0xFF000000) |
+ *      0x001A5E00; then |= 0x01000000; 50 ms
+ *   5. 300 ms for the DSP's ROM boot, and only then the first mailbox access
+ *
+ * Mailbox protocol (S16 20:15, reference tool mbx.c). Every deviation from
+ * it produced a hang on the device -- reads inside a block wipe the latch,
+ * no reads at all leave the DSP in download mode:
+ *
+ *   write   wait for busy bit 4 in +0x00 to clear, then addr<<16 | val
+ *           into +0x0C. Eight-bit registers are addressed as addr | 0x8000.
+ *   read    addr<<16 into +0x10; done when ready bit 5 is set *and* bit 31
+ *           of +0x10 is clear, and only after the pending sign (bit 31 set
+ *           or ready clear) has been seen once. Bit 31 comes up
+ *           synchronously with the request, so there is no fast path and no
+ *           "accept after 2 us" -- that is what desynchronised the answers.
+ *   patch   write a whole MSPM block without any read, then exactly one read
+ *           of 0x00EE at the block boundary as a wake-up call, then the next
+ *           block. The full stream including the DSP2 blocks: 20/20 runs
+ *           took the patch, 15 ms each.
+ *
+ * Every mailbox timeout is fatal to the current state: the driver goes to
+ * "error", resets the island and builds everything again, at most three
+ * times in a row. The island reset revived the DSP in 65 of 65 cases where
+ * it had wedged (S16 18:20), so this is a measured recovery, not a hope.
+ * After three failures the state stays "error" and a write to the sysfs
+ * attribute "reset" is the way back.
+ */
+
+#define pr_fmt(fmt) "h713-msp: " fmt
+
+#include <linux/bitops.h>
+#include <linux/clk.h>
+#include <linux/debugfs.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/err.h>
+#include <linux/firmware.h>
+#include <linux/io.h>
+#include <linux/kstrtox.h>
+#include <linux/ktime.h>
+#include <linux/mfd/syscon.h>
+#include <linux/minmax.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/regmap.h>
+#include <linux/reset.h>
+#include <linux/sched.h>
+#include <linux/seq_file.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/sysfs.h>
+#include <linux/unaligned.h>
+#include <linux/workqueue.h>
+
+#include <sound/core.h>
+#include <sound/control.h>
+#include <sound/initval.h>
+#include <sound/tlv.h>
+
+#define MSP_FW_NAME		"h713/msp-patch.bin"
+
+/* ---- mailbox window, 0x06144000 ----------------------------------------- */
+#define MSP_MB_STATUS		0x00
+#define MSP_MB_DSP1_WRITE	0x0c
+#define MSP_MB_DSP1_READ	0x10
+#define MSP_MB_DSP2_WRITE	0x14
+#define MSP_MB_DSP2_READ	0x18
+
+#define MSP_ST_DSP1_WBUSY	BIT(4)
+#define MSP_ST_DSP1_RREADY	BIT(5)
+#define MSP_ST_DSP2_WBUSY	BIT(7)
+#define MSP_ST_DSP2_RREADY	BIT(8)
+/* The data register carries "request outstanding" in bit 31 (S16 18:20). */
+#define MSP_DATA_PENDING	BIT(31)
+#define MSP_DATA_VALUE		0xffff
+
+/* ---- audio top window, 0x0614a000 (S17 steps 11-13) --------------------- */
+#define MSP_TOP_CTL		0x00
+#define MSP_TOP_CTL_CLK		0x700
+#define MSP_TOP_CFG		0x0c
+#define MSP_TOP_CFG_KEEP	0xff000000
+#define MSP_TOP_CFG_DIVIDERS	0x001a5e00
+#define MSP_TOP_CFG_ENABLE	BIT(24)
+
+/* ---- control window, 0x06142000 ----------------------------------------- */
+/*
+ * +0x44 is the high-address control: bits 3:0 are the top address bits of
+ * the AUDBRG input stream, bits 7:4 those of the output stream (S17 section
+ * 3, S26 section 3). It is only ever *read* here. S17's step 14 proposed a
+ * 0x5a write-read-write probe on it to prove the block is alive; the same
+ * nibbles select the DRAM window of the running HDMI capture ring, so this
+ * driver proves liveness with the mailbox self-test instead, which costs
+ * nothing and touches nothing.
+ */
+#define MSP_CTRL_HIGH_ADDR	0x44
+
+/* ---- AUDIF window, 0x06146000 (read only, S23 section 6.2 / S25 section 6) */
+#define MSP_AUDIF_IRQ_STATUS	0x00
+#define MSP_AUDIF_FRAME_LEN	0x1c
+#define MSP_AUDIF_SPDI1_STATUS	0x3c
+#define MSP_AUDIF_SPDI2_STATUS	0x4c
+
+/* ---- TVFE router, 0x06700000, one word behind a syscon phandle ---------- */
+/*
+ * The value stock's tvtop_tvfe_enable writes (S17 section 2e). Reading zero
+ * here means the demod bus is still dead -- with bus-demod on it reads 0x7ff
+ * before the write. The field meaning is not known; the value is taken over
+ * whole.
+ */
+#define MSP_TVFE_ROUTER_ON	0x003003ff
+
+/* ---- DSP registers (16 bit; an address with bit 15 set is an 8-bit one) -- */
+#define DSP_BOOT_MARK		0x0000	/* download reset partner of 0xFFF7 */
+#define DSP_VERSION		0x0001	/* 0x0C19 once the patch is in */
+#define DSP_GLOBAL_ENABLE	0x0002	/* bit 15 (S20 step 6) */
+#define DSP_SPDIFRX2_CFG	0x0008	/* bit 15 = non-PCM detector (S27 4.1) */
+#define DSP_I2SIN1_CFG		0x0012	/* bit 15 enable, format (S25 section 8) */
+#define DSP_I2SIN1_PREGAIN	0x0013	/* mask 0xFF00, shift 8 */
+#define DSP_I2SOUT1_FORMAT	0x001e	/* cfg & 0x37FF (S23 section 6.1) */
+#define DSP_I2SOUT1_CFG		0x001f	/* (cfg >> 16) & 0xF93F */
+#define DSP_I2SOUT1_SOURCE	0x0020	/* two source ports, one per byte */
+#define DSP_DELAY1_SOURCE	0x0036
+#define DSP_MASTER_VOL_L	0x0050	/* 0x8000 = muted, 0 = 0 dB (S16 18:00) */
+#define DSP_MASTER_VOL_R	0x0051
+#define DSP_VOLUME_L		0x0052	/* quarter dB in bits 15:6 (S16 18:00) */
+#define DSP_VOLUME_R		0x0053
+#define DSP_PEQST2_SOURCE	0x0090
+#define DSP_TONECTL_SOURCE	0x0096
+#define DSP_QPEAK_L		0x00b2	/* level of QPEAK input 0 (S25 section 8) */
+#define DSP_QPEAK_R		0x00b3
+#define DSP_CLOCK		0x00ee	/* mask 0x7F80 = DSP clock step */
+#define DSP_FW_MINOR		0x00fc	/* 0x21FF once the patch is in */
+#define DSP_I2SIN1_SOURCE	0x0118	/* I2SIN1.out0/1 -> DRC1/DRC2 */
+#define DSP_HDMI_MUTE		0x8017	/* bit 0 = mute the HDMI I2S input */
+#define DSP_HDMI_RX_ENABLE	0x8034	/* mask 0x90 (S20 step 7) */
+#define DSP_PEQST1_SOURCE_L	0x8052
+#define DSP_PEQST1_SOURCE_R	0x8053
+#define DSP_DRC_SOURCE_L	0x8062
+#define DSP_DRC_SOURCE_R	0x8063
+#define DSP_QPEAK_IN0		0x80b2	/* source port of QPEAK input 0 */
+#define DSP_QPEAK_IN1		0x80b3
+#define DSP_SPDIFRX2_STATUS	0x800a	/* bit 7 valid, bit 5 compressed */
+#define DSP_PATCH_FLAG		0x80ff	/* 1 once the patch is in */
+#define DSP_DOWNLOAD_RESET	0xfff7
+
+/* Source ports used here, from the module descriptors in S23 section 4.2. */
+#define DSP_PORT_I2SIN1_OUT0	0x16
+#define DSP_PORT_I2SIN1_OUT1	0x17
+
+/* DSP clock: mask 0x7F80, step 3 -- the rate mbx.c downloads at (-s 3). */
+#define DSP_CLOCK_MASK		0x7f80
+#define DSP_CLOCK_STEP3		0x0180
+/* What a healthy monitor answers to a read of 0x00EE between blocks. */
+#define DSP_ALIVE_ANSWER	0x0180
+
+/* Success criteria of the download (plan section 3.3). */
+#define DSP_PATCH_FLAG_OK	0x0001
+#define DSP_VERSION_OK		0x0c19
+
+/* Non-PCM decode of 0x800A (S27 section 4.1). */
+#define DSP_NONPCM_VALID	BIT(7)
+#define DSP_NONPCM_COMPRESSED	BIT(5)
+#define DSP_NONPCM_TYPE		0x001f
+
+/* ---- firmware stream ---------------------------------------------------- */
+/* Block header of the MSPM container: the pair 0x4D53 0x504D, "MSPM". */
+#define MSP_FW_MAGIC_ADDR	0x4d53
+#define MSP_FW_MAGIC_VAL	0x504d
+#define MSP_FW_EXPECTED_SIZE	2896	/* re/work/audio/patch_msp.bin, S20 3.1 */
+
+/* ---- timing ------------------------------------------------------------- */
+#define MSP_MBOX_TIMEOUT_MS	50	/* plan section 3.1 and 3.2 */
+#define MSP_MBOX_SPINS		2000	/* ~100 us of spinning before sleeping */
+#define MSP_KICK_TIMEOUT_MS	500	/* wake-up call at a block boundary */
+#define MSP_READ_REISSUE_US	50	/* no outstanding sign: request was dropped */
+#define MSP_READ_REISSUE_MAX	40	/* ~2 ms of re-issuing before a timeout */
+#define MSP_RESET_HOLD_US	10000
+#define MSP_BUS_SETTLE_US	20000
+#define MSP_ROUTER_SETTLE_US	12000
+#define MSP_TOP_SETTLE_US	50000
+#define MSP_ROM_BOOT_MS		300	/* plan section 3.5 */
+#define MSP_DL_RESET_MS		200	/* plan section 3.3 */
+#define MSP_DL_SETTLE_MS	300	/* before reading the success registers */
+#define MSP_QPEAK_SETTLE_MS	50
+#define MSP_HEAL_MAX		3	/* plan section 1, package B */
+
+/* ---- volume ------------------------------------------------------------- */
+/*
+ * 0x0052/0x0053 hold a quarter-dB value in bits 15:6, two's complement:
+ * 0xFB00 is -20 quarter dB = -5 dB and measured -4.9 dB (S16 18:00). The
+ * control runs 0..400 for -100..0 dB, so the register value is
+ * (ctl - 400) in ten signed bits, shifted up by six.
+ */
+#define MSP_VOL_MAX		400
+#define MSP_VOL_MASK		0xffc0
+#define MSP_VOL_SHIFT		6
+#define MSP_VOL_BITS		10
+/* Master volume 0x0050/0x0051: bit 15 alone is the mute the stock HAL uses. */
+#define MSP_MUTE_VALUE		0x8000
