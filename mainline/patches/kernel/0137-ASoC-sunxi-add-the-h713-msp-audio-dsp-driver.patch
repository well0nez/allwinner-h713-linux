+			     const char *name, u16 addr)
+{
+	u16 val;
+
+	if (msp_dsp_read(msp, addr, &val))
+		seq_printf(s, "%-18s %#06x = timeout\n", name, addr);
+	else
+		seq_printf(s, "%-18s %#06x = %#06x\n", name, addr, val);
+}
