+static int msp_status_show(struct seq_file *s, void *unused)
+{
+	struct h713_msp *msp = s->private;
+	unsigned int router = 0;
+
+	mutex_lock(&msp->lock);
+
+	seq_printf(s, "state: %s\n", msp_state_names[msp->state]);
+	seq_printf(s, "heal_count: %u von %u\n", msp->heal_count, MSP_HEAL_MAX);
+	seq_printf(s, "mbox_timeouts: %u\n", msp->mbox_timeouts);
+	seq_printf(s, "mbox_reissues: %u\n", msp->mbox_reissues);
+	seq_printf(s, "firmware: %s, %zu Byte, %u Bloecke\n",
+		   MSP_FW_NAME, msp->fw_size, msp->blocks);
+	seq_printf(s, "controls: switch=%u volume=%ld (%d mdB) mute=%u\n",
+		   msp->input_on, msp->volume,
+		   (int)(msp->volume - MSP_VOL_MAX) * 25, msp->mute);
+
+	if (regmap_read(msp->router, 0, &router))
+		router = 0;
+	seq_printf(s, "tvfe_router: %#010x\n", router);
+	seq_printf(s, "audio_top: ctl %#010x cfg %#010x\n",
+		   readl(msp->top + MSP_TOP_CTL), readl(msp->top + MSP_TOP_CFG));
+	seq_printf(s, "high_addr_ctl: %#010x\n",
+		   readl(msp->ctrl + MSP_CTRL_HIGH_ADDR));
+	seq_printf(s, "audif: irq %#010x framelen %#010x spdi1 %#010x spdi2 %#010x\n",
+		   readl(msp->audif + MSP_AUDIF_IRQ_STATUS),
+		   readl(msp->audif + MSP_AUDIF_FRAME_LEN),
+		   readl(msp->audif + MSP_AUDIF_SPDI1_STATUS),
+		   readl(msp->audif + MSP_AUDIF_SPDI2_STATUS));
+	seq_printf(s, "mbox_status: %#010x\n", readl(msp->mbox + MSP_MB_STATUS));
+
+	if (msp->state == MSP_STATE_PATCHED || msp->state == MSP_STATE_RUNNING) {
+		u16 nonpcm, volume;
+
+		msp_show_dsp_reg(s, msp, "patch_flag", DSP_PATCH_FLAG);
+		msp_show_dsp_reg(s, msp, "version", DSP_VERSION);
+		msp_show_dsp_reg(s, msp, "fw_minor", DSP_FW_MINOR);
+		msp_show_dsp_reg(s, msp, "clock", DSP_CLOCK);
+		msp_show_dsp_reg(s, msp, "i2sin1_cfg", DSP_I2SIN1_CFG);
+		msp_show_dsp_reg(s, msp, "i2sout1_format", DSP_I2SOUT1_FORMAT);
+		msp_show_dsp_reg(s, msp, "i2sout1_source", DSP_I2SOUT1_SOURCE);
+		msp_show_dsp_reg(s, msp, "master_vol_l", DSP_MASTER_VOL_L);
+
+		/* The value the DSP really holds, back in control units. */
+		if (!msp_dsp_read(msp, DSP_VOLUME_L, &volume))
+			seq_printf(s, "%-18s %#06x = %#06x (%ld)\n", "volume_l",
+				   DSP_VOLUME_L, volume,
+				   msp_reg_to_volume(volume));
+
+		if (!msp_dsp_read(msp, DSP_SPDIFRX2_STATUS, &nonpcm))
+			seq_printf(s,
+				   "%-18s %#06x = %#06x (gueltig %u, komprimiert %u, Typ %#04x)\n",
+				   "nonpcm", DSP_SPDIFRX2_STATUS, nonpcm,
+				   !!(nonpcm & DSP_NONPCM_VALID),
+				   !!(nonpcm & DSP_NONPCM_COMPRESSED),
+				   nonpcm & DSP_NONPCM_TYPE);
+	}
+
+	mutex_unlock(&msp->lock);
+	return 0;
+}
