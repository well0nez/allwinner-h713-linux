+static int msp_create_card(struct h713_msp *msp)
+{
+	struct snd_card *card;
+	unsigned int i;
+	int ret;
+
+	ret = snd_devm_card_new(msp->dev, SNDRV_DEFAULT_IDX1, "hy310hdmi",
+				THIS_MODULE, 0, &card);
+	if (ret)
+		return ret;
+
+	strscpy(card->driver, "H713-MSP", sizeof(card->driver));
+	strscpy(card->shortname, "hy310hdmi", sizeof(card->shortname));
+	strscpy(card->longname, "HY310 HDMI Audio", sizeof(card->longname));
+	strscpy(card->mixername, "H713 MSP DSP", sizeof(card->mixername));
+
+	for (i = 0; i < ARRAY_SIZE(msp_controls); i++) {
+		ret = snd_ctl_add(card, snd_ctl_new1(&msp_controls[i], msp));
+		if (ret)
+			return ret;
+	}
+
+	ret = snd_card_register(card);
+	if (ret)
+		return ret;
+
+	msp->card = card;
+	return 0;
+}
