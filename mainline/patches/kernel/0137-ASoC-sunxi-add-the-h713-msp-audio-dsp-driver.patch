+
+/* ------------------------------------------------------------------------ */
+/* Mailbox                                                                   */
+/* ------------------------------------------------------------------------ */
+
+/*
+ * Wait until @mask in the status word has the value @set. The busy bit falls
+ * after ~20 us for the special words of the patch stream and after ~120 us
+ * for an ordinary one (S16 18:20), so the first ~100 us are spun and only
+ * then does the loop sleep. Never called from atomic context.
+ */
+static int msp_wait_status(struct h713_msp *msp, u32 mask, bool set)
+{
+	ktime_t deadline = ktime_add_ms(ktime_get(), MSP_MBOX_TIMEOUT_MS);
+	unsigned int spins = 0;
+
+	for (;;) {
+		u32 status = readl(msp->mbox + MSP_MB_STATUS);
+
+		if (!!(status & mask) == set)
+			return 0;
+		if (ktime_after(ktime_get(), deadline))
+			return -ETIMEDOUT;
+		if (spins++ < MSP_MBOX_SPINS)
+			cpu_relax();
+		else
+			usleep_range(20, 50);
+	}
+}
+
+static void msp_note_timeout(struct h713_msp *msp, const char *what, u16 addr)
+{
+	msp->mbox_timeouts++;
+	dev_warn_ratelimited(msp->dev,
+			     "Mailbox-Timeout beim %s von %#06x (Status %#010x, insgesamt %u)\n",
+			     what, addr, readl(msp->mbox + MSP_MB_STATUS),
+			     msp->mbox_timeouts);
+}
+
+/* Plan section 3.1: wait for busy bit 4, then addr<<16 | val into +0x0C. */
+static int msp_dsp_write(struct h713_msp *msp, u16 addr, u16 val)
+{
+	int ret;
+
+	ret = msp_wait_status(msp, MSP_ST_DSP1_WBUSY, false);
+	if (ret) {
+		msp_note_timeout(msp, "Schreiben", addr);
+		return ret;
+	}
+
+	writel(((u32)addr << 16) | val, msp->mbox + MSP_MB_DSP1_WRITE);
+	return 0;
+}
+
+/*
+ * Plan section 3.2. The answer is complete when the ready bit is set *and*
+ * bit 31 of the data register is clear -- but only once the outstanding sign
+ * has been seen, otherwise the previous answer is read back. There is no
+ * shortcut: accepting an answer that never showed the outstanding sign is
+ * exactly what shifted every answer by one register during the download
+ * (S16 19:30).
+ *
+ * The outstanding sign appears synchronously with the request. A request
+ * that shows no sign within MSP_READ_REISSUE_US was not registered by the
+ * monitor at all -- it happens now and then, most often right after the
+ * 8-bit writes of the level meter (S16 00:05, "mbx -x") -- and is simply
+ * written again. Never during the download: there the one wake-up read per
+ * block must stay one read, so a dropped request is left to the timeout.
+ */
+static int msp_dsp_read(struct h713_msp *msp, u16 addr, u16 *val)
+{
+	bool pending_seen = false;
+	unsigned int spins = 0, reissues = 0;
+	ktime_t deadline, issued;
+	int ret;
+
+	ret = msp_wait_status(msp, MSP_ST_DSP1_WBUSY, false);
+	if (ret) {
+		msp_note_timeout(msp, "Lesen (busy)", addr);
+		return ret;
+	}
+
+	writel((u32)addr << 16, msp->mbox + MSP_MB_DSP1_READ);
+	issued = ktime_get();
+	deadline = ktime_add_ms(issued, MSP_MBOX_TIMEOUT_MS);
+
+	for (;;) {
+		u32 data = readl(msp->mbox + MSP_MB_DSP1_READ);
+		u32 status = readl(msp->mbox + MSP_MB_STATUS);
+
+		if ((data & MSP_DATA_PENDING) ||
+		    !(status & MSP_ST_DSP1_RREADY)) {
+			pending_seen = true;
+		} else if (pending_seen) {
+			*val = data & MSP_DATA_VALUE;
+			return 0;
+		} else if (!msp->downloading &&
+			   reissues < MSP_READ_REISSUE_MAX &&
+			   ktime_us_delta(ktime_get(), issued) >
+					MSP_READ_REISSUE_US) {
+			writel((u32)addr << 16, msp->mbox + MSP_MB_DSP1_READ);
+			issued = ktime_get();
+			reissues++;
+			msp->mbox_reissues++;
+			continue;
+		}
+
+		if (ktime_after(ktime_get(), deadline)) {
+			msp_note_timeout(msp, "Lesen", addr);
+			return -ETIMEDOUT;
+		}
+
+		/*
+		 * Answers come back in 1..60 us, mean 20 us (S16 18:20), so
+		 * the normal case never leaves the spin. Sleeping later only
+		 * keeps a timeout from burning a CPU for 50 ms; it does not
+		 * change the protocol -- what broke the download was accepting
+		 * an answer early, not waiting longer.
+		 */
+		if (spins++ < MSP_MBOX_SPINS)
+			cpu_relax();
+		else
+			usleep_range(20, 50);
+	}
+}
+
+static int msp_dsp_update(struct h713_msp *msp, u16 addr, u16 mask, u16 val)
+{
+	u16 old;
+	int ret;
+
+	ret = msp_dsp_read(msp, addr, &old);
+	if (ret)
+		return ret;
+
+	return msp_dsp_write(msp, addr, (old & ~mask) | (val & mask));
+}
+
+/*
+ * The wake-up call of plan section 3.3: exactly one read of 0x00EE at a
+ * block boundary, repeated until the monitor answers 0x0180. mbx.c -K notes
+ * a stubborn answer and carries on rather than aborting, and so does this --
+ * the download itself decides success, not this poll.
+ */
+static int msp_kick(struct h713_msp *msp, int block)
+{
+	ktime_t deadline = ktime_add_ms(ktime_get(), MSP_KICK_TIMEOUT_MS);
+	unsigned int reads = 0;
+	u16 val;
+	int ret;
+
+	for (;;) {
+		ret = msp_dsp_read(msp, DSP_CLOCK, &val);
+		if (ret)
+			return ret;
+		reads++;
+		if (val == DSP_ALIVE_ANSWER)
+			return 0;
+		if (ktime_after(ktime_get(), deadline)) {
+			dev_warn(msp->dev,
+				 "Weckruf nach Block %d: 0x00EE bleibt %#06x nach %u Lesungen\n",
+				 block, val, reads);
+			return 0;
+		}
+		fsleep(100);
+	}
+}
+
+/* ------------------------------------------------------------------------ */
+/* Island                                                                    */
+/* ------------------------------------------------------------------------ */
+
+static void msp_island_down(struct h713_msp *msp)
+{
+	/* dsp_island2.py: 0xd64 &= ~0x00010001 -- bus gate off, reset held. */
+	if (msp->bus_on) {
+		clk_disable_unprepare(msp->bus);
+		msp->bus_on = false;
+	}
+	reset_control_assert(msp->rst);
+	fsleep(MSP_RESET_HOLD_US);
+}
+
+static int msp_island_up(struct h713_msp *msp)
+{
+	unsigned int router;
+	u32 ctl, cfg;
+	int ret;
+
+	/* dsp_island2.py: 0xd64 |= 0x10001, then 20 ms. */
+	ret = reset_control_deassert(msp->rst);
+	if (ret) {
+		dev_err(msp->dev, "bus-demod-Reset nicht loesbar (%d)\n", ret);
+		return ret;
+	}
+	ret = clk_prepare_enable(msp->bus);
+	if (ret) {
+		dev_err(msp->dev, "bus-demod-Takt nicht einschaltbar (%d)\n", ret);
+		return ret;
+	}
+	msp->bus_on = true;
+	fsleep(MSP_BUS_SETTLE_US);
+
+	/*
+	 * Gate check before the router write: without bus-demod the whole
+	 * Trident front-end space reads zero, and writing into it would tell
+	 * us nothing (S17 section 3, step 8).
+	 */
+	ret = regmap_read(msp->router, 0, &router);
+	if (ret) {
+		dev_err(msp->dev, "TVFE-Router nicht lesbar (%d)\n", ret);
+		return ret;
+	}
+	if (!router) {
+		dev_err(msp->dev,
+			"TVFE-Top liest 0 -- der Demod-Bus ist tot, Insel nicht erreichbar\n");
+		return -ENODEV;
+	}
+
+	ret = regmap_write(msp->router, 0, MSP_TVFE_ROUTER_ON);
+	if (ret) {
+		dev_err(msp->dev, "TVFE-Router nicht schreibbar (%d)\n", ret);
+		return ret;
+	}
+	fsleep(MSP_ROUTER_SETTLE_US);
+
+	/* Audio top clock: CTL bits 10:8, then the divider word, then enable. */
+	ctl = readl(msp->top + MSP_TOP_CTL);
+	writel(ctl | MSP_TOP_CTL_CLK, msp->top + MSP_TOP_CTL);
+
+	cfg = readl(msp->top + MSP_TOP_CFG);
+	writel((cfg & MSP_TOP_CFG_KEEP) | MSP_TOP_CFG_DIVIDERS,
+	       msp->top + MSP_TOP_CFG);
+	cfg = readl(msp->top + MSP_TOP_CFG);
+	writel(cfg | MSP_TOP_CFG_ENABLE, msp->top + MSP_TOP_CFG);
+	fsleep(MSP_TOP_SETTLE_US);
+
+	ctl = readl(msp->top + MSP_TOP_CTL);
+	if ((ctl & MSP_TOP_CTL_CLK) != MSP_TOP_CTL_CLK) {
+		dev_err(msp->dev,
+			"Audio-Top-Takt haelt nicht (0x0614a000 = %#010x)\n", ctl);
+		return -ENODEV;
+	}
+
+	/* The DSP boots out of its ROM; the mailbox answers nothing before. */
+	msleep(MSP_ROM_BOOT_MS);
+	return 0;
+}
+
+/* ------------------------------------------------------------------------ */
+/* Patch download                                                            */
+/* ------------------------------------------------------------------------ */
+
+static int msp_selftest(struct h713_msp *msp)
+{
+	u16 val;
+	int ret;
+
+	ret = msp_dsp_read(msp, DSP_CLOCK, &val);
+	if (ret) {
+		dev_err(msp->dev,
+			"Mailbox-Selbsttest gescheitert: 0x00EE antwortet nicht (Status %#010x)\n",
+			readl(msp->mbox + MSP_MB_STATUS));
+		return ret;
+	}
+
+	dev_dbg(msp->dev, "Mailbox lebt, 0x00EE = %#06x\n", val);
+	return 0;
+}
+
+static int msp_download(struct h713_msp *msp)
+{
+	size_t pairs = msp->fw_size / 4;
+	int block = -1;
+	u16 flag, version;
+	size_t i;
+	int ret;
+
+	/* Plan section 3.3, in this order: clock step, download reset, 200 ms. */
+	ret = msp_dsp_update(msp, DSP_CLOCK, DSP_CLOCK_MASK, DSP_CLOCK_STEP3);
+	if (ret)
+		return ret;
+	ret = msp_dsp_write(msp, DSP_DOWNLOAD_RESET, 0);
+	if (ret)
+		return ret;
+	ret = msp_dsp_write(msp, DSP_BOOT_MARK, 0);
+	if (ret)
+		return ret;
+	msleep(MSP_DL_RESET_MS);
+
+	msp->downloading = true;
+	for (i = 0; i < pairs; i++) {
+		u16 addr = get_unaligned_be16(msp->fw + 4 * i);
+		u16 val = get_unaligned_be16(msp->fw + 4 * i + 2);
+
+		/*
+		 * One read between the blocks, none inside them. The stream
+		 * also carries 24-bit writes as a 0xFFFF latch word followed
+		 * by the register itself (plan section 3.4); they are just
+		 * two more pairs here, and the rule "no read inside a block"
+		 * is what keeps the latch intact.
+		 */
+		if (addr == MSP_FW_MAGIC_ADDR && val == MSP_FW_MAGIC_VAL) {
+			if (block >= 0) {
+				ret = msp_kick(msp, block);
+				if (ret) {
+					msp->downloading = false;
+					return ret;
+				}
+			}
+			block++;
+		}
+
+		ret = msp_dsp_write(msp, addr, val);
+		if (ret) {
+			dev_err(msp->dev,
+				"Download bricht bei Paar %zu (%#06x = %#06x, Block %d) ab\n",
+				i, addr, val, block);
+			msp->downloading = false;
+			return ret;
+		}
+
+		if (!(i % 64))
+			cond_resched();
+	}
+
+	ret = msp_kick(msp, block);
+	msp->downloading = false;
+	if (ret)
+		return ret;
+	msp->blocks = block + 1;
+
+	msleep(MSP_DL_SETTLE_MS);
+
+	ret = msp_dsp_read(msp, DSP_PATCH_FLAG, &flag);
+	if (ret)
+		return ret;
+	ret = msp_dsp_read(msp, DSP_VERSION, &version);
+	if (ret)
+		return ret;
+
+	if (flag != DSP_PATCH_FLAG_OK || version != DSP_VERSION_OK) {
+		dev_err(msp->dev,
+			"Patch nicht angenommen: 0x80FF = %#06x (erwartet %#06x), 0x0001 = %#06x (erwartet %#06x)\n",
+			flag, DSP_PATCH_FLAG_OK, version, DSP_VERSION_OK);
+		return -EIO;
+	}
+
+	dev_info(msp->dev, "Patch geladen: %zu Paare, %u Bloecke, 0x80FF = 1, 0x0001 = %#06x\n",
+		 pairs, msp->blocks, version);
+	return 0;
+}
