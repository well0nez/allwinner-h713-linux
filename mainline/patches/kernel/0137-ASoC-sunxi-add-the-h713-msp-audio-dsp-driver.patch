+/* Graph                                                                     */
+/* ------------------------------------------------------------------------ */
+
+struct msp_graph_step {
+	u16 addr;
+	u16 mask;
+	u16 val;
+	const char *what;
+};
+
+/*
+ * Path 0xC1 "HDMI2PCM_TO_SPEAKER" without DELAY1, in the order stock builds
+ * it (S23 section 4.4 plus the ground state of section 4.3, measured as
+ * dsp_graph_only.py and confirmed at the microphone with 1001 Hz at 75.9 dB
+ * over the noise floor, S16 18:00). DELAY1 is not broken -- it is simply off
+ * and would need the DRAM loop of S26; the HY310 runs it with spk_delay = 0,
+ * so bypassing it costs the 2 ms of lip sync stock spends and nothing else.
+ */
+static const struct msp_graph_step msp_graph[] = {
+	{ DSP_GLOBAL_ENABLE,	0x8000, 0x8000, "globales Enable" },
+	{ DSP_HDMI_RX_ENABLE,	0x0090, 0x0010, "HDMI-Rx ein" },
+	{ DSP_I2SIN1_CFG,	0xa3ff, 0x8180, "I2SIN1 Freigabe und Format" },
+	{ DSP_I2SIN1_PREGAIN,	0xff00, 0x2000, "I2SIN1 Vorverstaerkung 32" },
+	{ DSP_I2SIN1_SOURCE,	0xffff, 0x1617, "I2SIN1 -> DRC1/DRC2" },
+	{ DSP_DRC_SOURCE_L,	0x00ff, 0x0092, "DRC1 -> TONECONTROL1.in0" },
+	{ DSP_DRC_SOURCE_R,	0x00ff, 0x0093, "DRC2 -> TONECONTROL1.in1" },
+	{ DSP_TONECTL_SOURCE,	0xffff, 0x7273, "TONECONTROL1 -> PEQST2" },
+	{ DSP_PEQST2_SOURCE,	0xffff, 0x9a9b, "PEQST2 -> PEQST1" },
+	{ DSP_PEQST1_SOURCE_L,	0x00ff, 0x0098, "PEQST1 -> VOLUME1" },
+	{ DSP_PEQST1_SOURCE_R,	0x00ff, 0x0099, "PEQST1 -> VOLUME2" },
+	{ DSP_DELAY1_SOURCE,	0xffff, 0x6263, "VOLUME1/2 -> DELAY1" },
