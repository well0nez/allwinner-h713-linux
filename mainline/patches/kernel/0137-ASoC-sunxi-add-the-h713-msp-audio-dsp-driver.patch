+/* ------------------------------------------------------------------------ */
+/* Probe                                                                     */
+/* ------------------------------------------------------------------------ */
+
+/*
+ * The four windows of this node are claimed exclusively: nothing else in the
+ * tree maps 0x0614xxxx today (the vs,trid-audio-bridge node is a placeholder
+ * without a driver), so a second claimant is a mistake worth a loud probe
+ * failure. The one window that really is shared -- the TVFE router at
+ * 0x06700000, inside tvtop's second reg entry -- is not a resource here at
+ * all but a syscon phandle; see the probe.
+ */
+static int msp_map(struct platform_device *pdev, const char *name,
+		   void __iomem **out)
+{
+	void __iomem *base;
+
+	base = devm_platform_ioremap_resource_byname(pdev, name);
+	if (IS_ERR(base))
+		return dev_err_probe(&pdev->dev, PTR_ERR(base),
+				     "reg-Eintrag \"%s\" nicht abbildbar\n",
+				     name);
+
+	*out = base;
+	return 0;
+}
+
+static int msp_load_firmware(struct h713_msp *msp)
+{
+	const char *name = MSP_FW_NAME;
+	const struct firmware *fw;
+	void *copy;
+	int ret;
+
+	of_property_read_string(msp->dev->of_node, "firmware-name", &name);
+
+	ret = request_firmware(&fw, name, msp->dev);
+	if (ret)
+		return dev_err_probe(msp->dev, ret,
+				     "MSP-Firmware \"%s\" nicht ladbar\n", name);
+
+	if (!fw->size || fw->size % 4 ||
+	    get_unaligned_be16(fw->data) != MSP_FW_MAGIC_ADDR ||
+	    get_unaligned_be16(fw->data + 2) != MSP_FW_MAGIC_VAL) {
+		dev_err(msp->dev,
+			"\"%s\" ist kein MSPM-Strom (%zu Byte, Kopf %#06x %#06x)\n",
+			name, fw->size,
+			fw->size >= 4 ? get_unaligned_be16(fw->data) : 0,
+			fw->size >= 4 ? get_unaligned_be16(fw->data + 2) : 0);
+		release_firmware(fw);
+		return -EINVAL;
+	}
+
+	if (fw->size != MSP_FW_EXPECTED_SIZE)
+		dev_warn(msp->dev,
+			 "\"%s\" ist %zu Byte, erwartet werden %u (re/work/audio/patch_msp.bin)\n",
+			 name, fw->size, MSP_FW_EXPECTED_SIZE);
+
+	/*
+	 * Kept for the lifetime of the device: the self-healing path has to
+	 * download again and must not depend on a file system being there.
+	 */
+	copy = devm_kmemdup(msp->dev, fw->data, fw->size, GFP_KERNEL);
+	if (!copy) {
+		release_firmware(fw);
+		return -ENOMEM;
+	}
+
+	msp->fw = copy;
+	msp->fw_size = fw->size;
+	release_firmware(fw);
+	return 0;
+}
+
+static int msp_get_clocks(struct h713_msp *msp)
+{
+	struct device *dev = msp->dev;
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < MSP_NUM_TVFE_CLOCKS; i++)
+		msp->tvfe[i].id = msp_tvfe_clocks[i];
+
+	ret = devm_clk_bulk_get(dev, MSP_NUM_TVFE_CLOCKS, msp->tvfe);
+	if (ret)
+		return dev_err_probe(dev, ret, "TVFE-Takte fehlen\n");
+
+	msp->bus = devm_clk_get(dev, "bus-demod");
+	if (IS_ERR(msp->bus))
+		return dev_err_probe(dev, PTR_ERR(msp->bus),
+				     "Takt \"bus-demod\" fehlt\n");
+
+	/*
+	 * Exclusive, although S17 recommended a shared reset for the whole
+	 * front-end: the island reset has to be a real pulse, and the shared
+	 * flavour of the API refuses an assert that no deassert paid for and
+	 * fires reset_control_reset() only once per control. CONFIG_SUNXI_TVTOP
+	 * is off in this tree; if it is ever turned on, the demod reset (and
+	 * the TVFE router below) belong to it and have to leave this driver.
+	 */
+	msp->rst = devm_reset_control_get_exclusive(dev, "bus-demod");
+	if (IS_ERR(msp->rst))
+		return dev_err_probe(dev, PTR_ERR(msp->rst),
+				     "Reset \"bus-demod\" fehlt\n");
+
+	for (i = 0; i < ARRAY_SIZE(msp_assigned_rates); i++) {
+		struct clk *clk = msp->tvfe[msp_assigned_rates[i].index].clk;
+		unsigned long rate = msp_assigned_rates[i].rate;
+
+		ret = clk_set_rate(clk, rate);
+		if (ret)
+			dev_warn(dev, "%s laesst sich nicht auf %lu Hz setzen (%d)\n",
+				 msp->tvfe[msp_assigned_rates[i].index].id,
+				 rate, ret);
+	}
+
+	ret = clk_bulk_prepare_enable(MSP_NUM_TVFE_CLOCKS, msp->tvfe);
+	if (ret)
+		return dev_err_probe(dev, ret, "TVFE-Takte nicht einschaltbar\n");
+
+	/*
+	 * Take a reference on the demod bus gate right away, even though the
+	 * bring-up drops it again: U-Boot may have left the gate on, and only
+	 * a reference the clock framework knows about lets the first
+	 * clk_disable_unprepare() really clear the bit.
+	 */
+	ret = clk_prepare_enable(msp->bus);
+	if (ret) {
+		clk_bulk_disable_unprepare(MSP_NUM_TVFE_CLOCKS, msp->tvfe);
+		return dev_err_probe(dev, ret, "bus-demod nicht einschaltbar\n");
+	}
+	msp->bus_on = true;
+
+	return 0;
+}
+
+static void msp_clocks_off(struct h713_msp *msp)
+{
+	if (msp->bus_on) {
+		clk_disable_unprepare(msp->bus);
+		msp->bus_on = false;
+	}
+	clk_bulk_disable_unprepare(MSP_NUM_TVFE_CLOCKS, msp->tvfe);
+}
+
+static int msp_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct h713_msp *msp;
+	int ret;
+
+	msp = devm_kzalloc(dev, sizeof(*msp), GFP_KERNEL);
+	if (!msp)
+		return -ENOMEM;
+
+	msp->dev = dev;
+	msp->state = MSP_STATE_OFF;
+	msp->input_on = true;
+	msp->volume = MSP_VOL_MAX;	/* 0 dB, what the graph sets anyway */
+	INIT_WORK(&msp->heal, msp_heal_work);
+	platform_set_drvdata(pdev, msp);
+
+	ret = devm_mutex_init(dev, &msp->lock);
+	if (ret)
+		return ret;
+
+	ret = msp_map(pdev, "mailbox", &msp->mbox);
+	if (ret)
+		return ret;
+	ret = msp_map(pdev, "audio-top", &msp->top);
+	if (ret)
+		return ret;
+	ret = msp_map(pdev, "ctrl", &msp->ctrl);
+	if (ret)
+		return ret;
+	ret = msp_map(pdev, "audif", &msp->audif);
+	if (ret)
+		return ret;
+
+	/*
+	 * The TVFE router is one word at 0x06700000 and it sits inside the
+	 * second reg entry of tvtop@5700000. A syscon phandle, not a resource
+	 * of this node: that names the sharing in the device tree instead of
+	 * hiding it, and it is the same shape the HDMI receiver uses for
+	 * INCAP.
+	 */
+	msp->router = syscon_regmap_lookup_by_phandle(dev->of_node,
+						      "allwinner,tvfe-router");
+	if (IS_ERR(msp->router))
+		return dev_err_probe(dev, PTR_ERR(msp->router),
+				     "kein Zugriff auf den TVFE-Router (allwinner,tvfe-router)\n");
+
+	ret = msp_load_firmware(msp);
+	if (ret)
+		return ret;
+
+	/*
+	 * The audio island hangs on pd_tvfe. The domain is on since U-Boot on
+	 * this board, so this is a reference, not a power-up -- but a
+	 * reference is what keeps a later genpd from taking it away.
+	 */
+	pm_runtime_enable(dev);
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret) {
+		pm_runtime_disable(dev);
+		return dev_err_probe(dev, ret, "pd_tvfe nicht einschaltbar\n");
+	}
+
+	ret = msp_get_clocks(msp);
+	if (ret)
+		goto err_pm;
+
+	ret = msp_create_card(msp);
+	if (ret) {
+		dev_err(dev, "ALSA-Karte nicht anlegbar (%d)\n", ret);
+		goto err_clocks;
+	}
+
+	msp->debugfs = debugfs_create_dir("h713-msp", NULL);
+	debugfs_create_file("status", 0400, msp->debugfs, msp,
+			    &msp_status_fops);
+
+	mutex_lock(&msp->lock);
+	ret = msp_bringup(msp);
+	mutex_unlock(&msp->lock);
+	if (ret) {
+		/*
+		 * Not fatal for the bind. The card and the sysfs attributes
+		 * are the only way to see why and to try again, and the
+		 * self-healing worker gets its chance below.
+		 */
+		dev_err(dev,
+			"Inbetriebnahme gescheitert (%d) -- Zustand \"error\", Selbstheilung laeuft an\n",
+			ret);
+		schedule_work(&msp->heal);
+	}
+
+	return 0;
+
+err_clocks:
+	msp_clocks_off(msp);
+err_pm:
+	pm_runtime_put(dev);
+	pm_runtime_disable(dev);
+	return ret;
+}
+
+static void msp_remove(struct platform_device *pdev)
+{
+	struct h713_msp *msp = platform_get_drvdata(pdev);
+
+	cancel_work_sync(&msp->heal);
+	debugfs_remove_recursive(msp->debugfs);
+
+	/*
+	 * Put the island back where a cold start leaves it: reset asserted,
+	 * demod bus gate off. A reload then runs exactly the sequence that
+	 * has been measured, instead of finding a half-configured DSP.
+	 */
+	mutex_lock(&msp->lock);
+	msp_island_down(msp);
+	msp->state = MSP_STATE_OFF;
+	mutex_unlock(&msp->lock);
+
+	msp_clocks_off(msp);
+	pm_runtime_put(&pdev->dev);
+	pm_runtime_disable(&pdev->dev);
+}
+
+static const struct of_device_id msp_of_match[] = {
+	{ .compatible = "allwinner,sun50i-h713-msp" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, msp_of_match);
+
+static struct platform_driver msp_driver = {
+	.probe	= msp_probe,
+	.remove	= msp_remove,
+	.driver	= {
+		.name		= "sun50i-h713-msp",
+		.of_match_table	= msp_of_match,
+		.dev_groups	= msp_groups,
+	},
+};
+module_platform_driver(msp_driver);
+
+MODULE_DESCRIPTION("Allwinner H713 MSP audio DSP (HDMI audio path)");
+MODULE_AUTHOR("HY310 Mainline Port");
+MODULE_LICENSE("GPL");
+MODULE_FIRMWARE(MSP_FW_NAME);
