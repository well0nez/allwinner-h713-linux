+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * In-kernel interface to the ARISC co-processor of the Allwinner H713.
+ *
+ * The HDMI receiver front end of this SoC -- hotplug pin, EDID store, the
+ * +5V detect flag and the DDC RAM -- belongs to the ARISC, a small OpenRISC
+ * core that owns the R_ peripherals. The ARM cannot drive any of it
+ * directly; reading the hotplug register 0x07091014 from the ARM hangs the
+ * SoC hard while the block is unclocked. The only supported path is to ask
+ * the firmware running on the ARISC, which is what sun50i-h713-arisc does.
+ *
+ * These functions exist for the HDMI receive path (sun50i-h713-hdmirx) to
+ * implement VIDIOC_S_EDID/G_EDID and its hotplug handling on top of. They
+ * may sleep, they take a driver-internal mutex, and they return a real
+ * error when the co-processor does not answer -- never a silent success.
+ *
+ * Ordering rule that this interface enforces: the aux register block at
+ * 0x0709xxxx does not exist for the ARM until the ARISC has processed
+ * ResetEDIDModule; a read before that hangs the SoC. Every function below
+ * except arisc_hdmi_reset_edid() therefore fails with -EAGAIN until that
+ * command has been acknowledged, and a consumer that wants to touch the
+ * aux block has to call arisc_hdmi_reset_edid() first and honour its
+ * return value.
+ */
+#ifndef __LINUX_SOC_SUNXI_H713_ARISC_H
+#define __LINUX_SOC_SUNXI_H713_ARISC_H
+
+#include <linux/errno.h>
+#include <linux/types.h>
+
+/* The firmware knows three HDMI ports; this board has one socket (port 0). */
+#define ARISC_HDMI_PORTS		3
+
+/*
+ * The EDID the firmware expects is both versions back to back: fragments
+ * 0..3 are the HDMI 1.4 block, fragments 4..7 the HDMI 2.0 block. It only
+ * publishes an EDID once fragment 7 has arrived, so the two halves cannot
+ * be uploaded separately.
+ */
+#define ARISC_HDMI_EDID_SIZE		512
+
+/* PullHotPlug values, firmware case 7 */
+enum arisc_hdmi_hpd_action {
+	ARISC_HDMI_HPD_UP	= 1,	/* raise the pin (via the tick counter) */
+	ARISC_HDMI_HPD_DOWN	= 2,	/* pull the pin low immediately */
+	ARISC_HDMI_HPD_RESET	= 3,	/* pin low, then raise after ~840 ms */
+};
+
+#if IS_ENABLED(CONFIG_SUN50I_H713_ARISC)
+
+int arisc_hdmi_reset_edid(void);
+int arisc_hdmi_set_portmap(const u8 *map, size_t count);
+int arisc_hdmi_set_edid(const void *edid, size_t len);
+int arisc_hdmi_get_edid(unsigned int port, void *buf, size_t len);
+int arisc_hdmi_audio_mode(unsigned int port, u8 mode);
+int arisc_hdmi_5v(unsigned int port, bool on);
+int arisc_hdmi_hpd(unsigned int port, enum arisc_hdmi_hpd_action action);
+int arisc_hdmi_edid_init(unsigned int port, const void *edid, size_t len);
+
+#else
+
+static inline int arisc_hdmi_reset_edid(void)
+{
+	return -ENODEV;
+}
+
+static inline int arisc_hdmi_set_portmap(const u8 *map, size_t count)
+{
+	return -ENODEV;
+}
+
+static inline int arisc_hdmi_set_edid(const void *edid, size_t len)
+{
+	return -ENODEV;
+}
+
+static inline int arisc_hdmi_get_edid(unsigned int port, void *buf, size_t len)
+{
+	return -ENODEV;
+}
+
+static inline int arisc_hdmi_audio_mode(unsigned int port, u8 mode)
+{
+	return -ENODEV;
+}
+
+static inline int arisc_hdmi_5v(unsigned int port, bool on)
+{
+	return -ENODEV;
+}
+
+static inline int arisc_hdmi_hpd(unsigned int port,
+				 enum arisc_hdmi_hpd_action action)
+{
+	return -ENODEV;
+}
+
+static inline int arisc_hdmi_edid_init(unsigned int port, const void *edid,
+				       size_t len)
+{
+	return -ENODEV;
+}
+
+#endif /* CONFIG_SUN50I_H713_ARISC */
+
+#endif /* __LINUX_SOC_SUNXI_H713_ARISC_H */
