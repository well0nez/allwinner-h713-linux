drm: h713-afbd: expose the display aspect mode

A 1280x1024 source came out stretched to the panel. That is the firmware's
own rule: its window manager classifies a source by 1000*h/v and knows
1:1, 4:3 and 2.21:1 -- everything else is 16:9 and fills the panel; 5:4
and 16:10 fall through (read from the firmware on 08.09.2026,
doku/nachtlog/S15). The shell command and the RPC that look like they
would change it are stubs. What lives is word 35 of the VidDec descriptor,
which the window manager reads into m_aspect_ratio at every signal event
and which this driver always wrote as 0 ("auto", that rule).

Setting the word to 1 (KeepSourceAr) on the live page while 1280x1024 was
up gave display_cfg [285, 0, 1350, 1080] and a 5:4 picture with bars on
the wall, measured. So the plane gets an "aspect" enum property with the
firmware's six modes, defaulting to proportional -- identity for 16:9,
the same pillarbox as before for 4:3, bars for 5:4 and 16:10 -- and writes
it into word 35. A change takes effect with the next publication; hy310-tv
takes the plane down and up for it, the path every geometry change uses.

diff --git a/drivers/gpu/drm/tiny/sun50i-h713-afbd.c b/drivers/gpu/drm/tiny/sun50i-h713-afbd.c
--- a/drivers/gpu/drm/tiny/sun50i-h713-afbd.c
+++ b/drivers/gpu/drm/tiny/sun50i-h713-afbd.c
@@ -211,6 +211,7 @@ struct h713_afbd {
 	dma_addr_t video_info_dma;
 	bool video_info_published;
 	struct drm_property *prop_hdmi_ring;
+	struct drm_property *prop_aspect;
 	u32 ring_base;
 	u32 ring_size;
 	/* Serialises the pool-1 address queue against the vsync handler. */
@@ -236,12 +237,46 @@ struct h713_afbd {
 };
 
 /*
- * Plane state. "hdmi-ring" and "saturation" are driver-private plane
- * properties; both must survive duplicate/reset like any other atomic state.
+ * The firmware's display aspect modes, as its window manager reads them from
+ * word 35 of the VidDec descriptor (kHalDisplayAspectRatio_*, read from the
+ * firmware on 08.09.2026, doku/nachtlog/S15). "auto" is the firmware's own
+ * rule, which knows 1:1, 4:3 and 2.21:1 and stretches everything else to the
+ * panel -- 5:4 and 16:10 included. "proportional" (KeepSourceAr) maps the
+ * source into the panel at its own ratio: identity for 16:9, the same
+ * pillarbox as auto for 4:3, and for 1280x1024 the window [285, 0, 1350, 1080]
+ * with bars, measured through the descriptor page and on the wall. That is
+ * why it is the default here; "auto" stays selectable for the record.
+ * Shell and RPC paths for this setting are stubs in the firmware; the
+ * descriptor word is the only one that lives.
+ */
+enum h713_aspect {
+	H713_ASPECT_AUTO = 0,
+	H713_ASPECT_PROPORTIONAL = 1,
+	H713_ASPECT_FULL = 2,
+	H713_ASPECT_16_9 = 3,
+	H713_ASPECT_4_3 = 4,
+	H713_ASPECT_ZOOM = 5,
+};
+
+#define H713_ASPECT_DEFAULT	H713_ASPECT_PROPORTIONAL
+
+static const struct drm_prop_enum_list h713_aspect_names[] = {
+	{ H713_ASPECT_AUTO, "auto" },
+	{ H713_ASPECT_PROPORTIONAL, "proportional" },
+	{ H713_ASPECT_FULL, "full" },
+	{ H713_ASPECT_16_9, "16:9" },
+	{ H713_ASPECT_4_3, "4:3" },
+	{ H713_ASPECT_ZOOM, "zoom" },
+};
+
+/*
+ * Plane state. "hdmi-ring" and "aspect" are driver-private plane properties;
+ * both must survive duplicate/reset like any other atomic state.
  */
 struct h713_plane_state {
 	struct drm_plane_state base;
 	bool hdmi_ring;
+	enum h713_aspect aspect;
 };
 
 static inline struct h713_afbd *to_h713(struct drm_device *drm)
@@ -297,7 +332,8 @@ static u32 h713_video_block_m1(unsigned int w, unsigned int h)
  */
 static void h713_afbd_build_video_info(u32 *rec, unsigned int w,
 				       unsigned int h, unsigned int stride,
-				       unsigned int win_w, unsigned int win_h)
+				       unsigned int win_w, unsigned int win_h,
+				       enum h713_aspect aspect)
 {
 	memset(rec, 0, H713_VIDEO_INFO_WORDS * sizeof(*rec));
 
@@ -336,6 +372,15 @@ static void h713_afbd_build_video_info(u32 *rec, unsigned int w,
 	rec[30] = win_h * 16;
 	rec[32] = win_w * 16;
 	rec[34] = win_h * 16;
+	/*
+	 * The display aspect mode, raw (not 1/16): the window manager reads it
+	 * straight into m_aspect_ratio at every signal event and CompareFrameInfo
+	 * counts a change of this word alone as a new frame (S15). Setting it to
+	 * 1 on the live page while 1280x1024 was up gave "aspect_ratio : 1",
+	 * display_cfg [285, 0, 1350, 1080] and the scaler 0x3200f2b9; measured
+	 * 08.09.2026.
+	 */
+	rec[35] = aspect;
 }
 
 /*
@@ -436,7 +481,7 @@ static int h713_afbd_wait_wce(struct h713_afbd *h)
  */
 static bool h713_afbd_publish_video_info(struct h713_afbd *h, unsigned int w,
 					 unsigned int hgt, unsigned int stride,
-					 bool ring)
+					 bool ring, enum h713_aspect aspect)
 {
 	u32 rec[H713_VIDEO_INFO_WORDS];
 	u32 ptr = lower_32_bits(h->video_info_dma);
@@ -446,7 +491,7 @@ static bool h713_afbd_publish_video_info(struct h713_afbd *h, unsigned int w,
 	new_ptr = readl(h->regs + AFBD_VIDEO_INFO0) != ptr;
 	h713_afbd_build_video_info(rec, w, hgt, stride,
 				   ring ? h->mode.hdisplay : w,
-				   ring ? h->mode.vdisplay : hgt);
+				   ring ? h->mode.vdisplay : hgt, aspect);
 	differs = memcmp(h->video_info, rec, sizeof(rec)) != 0;
 	write_record = differs && (!h->video_info_published || ring);
 	if (differs && h->video_info_published && !ring)
@@ -974,7 +1019,8 @@ static void h713_afbd_video_atomic_update(struct drm_plane *plane,
 		if (nv16)
 			writel(0, h->regs + AFBD_VIDEO_C_STRIDE);
 		published = h713_afbd_publish_video_info(h, w, hgt,
-							 fb->pitches[0], ring);
+							 fb->pitches[0], ring,
+							 s->aspect);
 		if (published && nv16 && h713_afbd_wait_wce(h))
 			drm_err(&h->drm,
 				"firmware did not reprogram the chroma stride within %u ms of the descriptor; source 0 is programmed anyway, so this enable may come up with a halved chroma stride\n",
@@ -1108,6 +1154,7 @@ static void h713_afbd_video_reset(struct drm_plane *plane)
 	s = kzalloc(sizeof(*s), GFP_KERNEL);
 	if (!s)
 		return;
+	s->aspect = H713_ASPECT_DEFAULT;
 	__drm_atomic_helper_plane_reset(plane, &s->base);
 }
 
@@ -1125,6 +1172,7 @@ h713_afbd_video_duplicate_state(struct drm_plane *plane)
 	__drm_atomic_helper_plane_duplicate_state(plane, &s->base);
 	old = to_h713_plane_state(plane->state);
 	s->hdmi_ring = old->hdmi_ring;
+	s->aspect = old->aspect;
 
 	return &s->base;
 }
@@ -1141,6 +1189,10 @@ static int h713_afbd_video_set_property(struct drm_plane *plane,
 		s->hdmi_ring = !!val;
 		return 0;
 	}
+	if (property == h->prop_aspect) {
+		s->aspect = val;
+		return 0;
+	}
 
 	return -EINVAL;
 }
@@ -1158,6 +1210,10 @@ static int h713_afbd_video_get_property(struct drm_plane *plane,
 		*val = s->hdmi_ring;
 		return 0;
 	}
+	if (property == h->prop_aspect) {
+		*val = s->aspect;
+		return 0;
+	}
 
 	return -EINVAL;
 }
@@ -1181,6 +1237,13 @@ static const struct drm_plane_funcs h713_afbd_video_funcs = {
  *                 ring itself: the framebuffer then only carries format and
  *                 geometry and the addresses come from the firmware's flip
  *                 pointers. It goes away once dma-buf import exists.
+ *
+ * "aspect"     -- how the firmware's window manager fits a source that is not
+ *                 the panel's shape (enum h713_aspect). It is descriptor word
+ *                 35 and takes effect with the next publication, i.e. when
+ *                 the plane comes up; a change on a live plane is applied by
+ *                 taking the plane down and up again, which is what a
+ *                 geometry change does anyway.
  */
 static int h713_afbd_video_create_properties(struct h713_afbd *h)
 {
@@ -1192,6 +1255,14 @@ static int h713_afbd_video_create_properties(struct h713_afbd *h)
 		return -ENOMEM;
 	drm_object_attach_property(&plane->base, h->prop_hdmi_ring, 0);
 
+	h->prop_aspect = drm_property_create_enum(&h->drm, 0, "aspect",
+						  h713_aspect_names,
+						  ARRAY_SIZE(h713_aspect_names));
+	if (!h->prop_aspect)
+		return -ENOMEM;
+	drm_object_attach_property(&plane->base, h->prop_aspect,
+				   H713_ASPECT_DEFAULT);
+
 	return 0;
 }
 
