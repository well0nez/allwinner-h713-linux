+static void sunxi_mmc_set_v5p3x_delays(struct sunxi_mmc_host *host,
+					struct mmc_ios *ios,
+					unsigned long rate)
+{
+	u32 cmd_drv = 1, dat_drv = 0, sample_phase = 0;
+	u32 rval;
+
+	if (!host->cfg->v5p3x)
+		return;
+
+	/*
+	 * Reproduce sunxi_mmc_set_clk_dly() from the stock v5p3x driver.
+	 * Its low-speed defaults differ from its final UHS state:
+	 *
+	 *   <= 26 MHz: cmd drive 1, data drive 0, sample phase 0
+	 *   <= 52 MHz SDR: cmd/data drive 1, sample phase 1
+	 *
+	 * The remaining entries are the stock H713 five-cell DT tables, whose
+	 * last cell is the shared command/data sample phase:
+	 *
+	 *   52M DDR4 <1 0 0 0 2>
+	 *   104M     <1 1 0 0 1>
+	 *   208M     <1 0 0 0 1>
+	 *
+	 * The previous experiment forced the 50 MHz result at every rate, so it
+	 * never tested the vendor's enumeration-to-UHS transition.
+	 */
+	if (rate > 26000000 && rate <= 52000000) {
+		if (ios->bus_width == MMC_BUS_WIDTH_4 &&
+		    ios->timing == MMC_TIMING_UHS_DDR50) {
+			dat_drv = 0;
+			sample_phase = 2;
+		} else {
+			dat_drv = 1;
+			sample_phase = 1;
+		}
+	} else if (rate > 52000000 && rate <= 104000000) {
+		dat_drv = 1;
+		sample_phase = 1;
+	} else if (rate > 104000000) {
+		dat_drv = 0;
+		sample_phase = 1;
+	}
+
+	rval = readl(host->reg_base + SDXC_REG_DRV_DL);
+	rval &= ~(SDXC_V5P3X_DRV_CMD_EN | SDXC_V5P3X_DRV_DAT_EN);
+	if (cmd_drv)
+		rval |= SDXC_V5P3X_DRV_CMD_EN;
+	if (dat_drv)
+		rval |= SDXC_V5P3X_DRV_DAT_EN;
+	writel(rval, host->reg_base + SDXC_REG_DRV_DL);
+
+	rval = mmc_readl(host, REG_SD_NTSR);
+	rval &= ~(SDXC_V5P3X_CMD_PHASE_MASK | SDXC_V5P3X_DAT_PHASE_MASK);
+	rval |= (sample_phase << SDXC_V5P3X_CMD_PHASE_SHIFT) &
+		SDXC_V5P3X_CMD_PHASE_MASK;
+	rval |= (sample_phase << SDXC_V5P3X_DAT_PHASE_SHIFT) &
+		SDXC_V5P3X_DAT_PHASE_MASK;
+	mmc_writel(host, REG_SD_NTSR, rval);
+
+	writel(SDXC_V5P3X_DL_DEFAULT,
+	       host->reg_base + SDXC_REG_SAMP_DL_REG);
+	writel(SDXC_V5P3X_DL_DEFAULT,
+	       host->reg_base + SDXC_REG_DS_DL_REG);
+
+	dev_info(mmc_dev(host->mmc),
+		 "v5p3x delay: rate=%lu timing=%u width=%u DRV=%08x NTSR=%08x\n",
+		 rate, ios->timing, 1U << ios->bus_width,
+		 readl(host->reg_base + SDXC_REG_DRV_DL),
+		 mmc_readl(host, REG_SD_NTSR));
+}
