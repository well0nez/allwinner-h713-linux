+static void sunxi_mmc_thld_ctl_v5p3x(struct sunxi_mmc_host *host,
+				     struct mmc_data *data)
+{
+	u32 rval;
+	bool high_speed_timing;
+
+	if (!host->cfg->v5p3x)
+		return;
+
+	rval = readl(host->reg_base + SDXC_REG_THLD);
+	rval &= ~(SDXC_THLD_SIZE_MASK | SDXC_THLD_READ_EN);
+
+	high_speed_timing = host->mmc->ios.timing == MMC_TIMING_UHS_SDR50 ||
+			    host->mmc->ios.timing == MMC_TIMING_UHS_SDR104 ||
+			    host->mmc->ios.timing == MMC_TIMING_MMC_HS200;
+
+	/*
+	 * Recovered from sunxi_mmc_thld_ctl_for_sdmmc_v5p3x in the stock
+	 * ARM32 kernel.  The controller's threshold applies only to reads,
+	 * carries the block size in bits [27:16], and is enabled only for
+	 * SDR50, SDR104, or HS200.  The AIC8800 uses 512-byte CMD53 blocks,
+	 * matching the live stock value THLD=0x02000001.
+	 */
+	if ((data->flags & MMC_DATA_READ) && data->blksz < 4096 &&
+	    data->blksz <= 1024 && high_speed_timing)
+		rval |= (data->blksz << 16) | SDXC_THLD_READ_EN;
+
+	writel(rval, host->reg_base + SDXC_REG_THLD);
+}
