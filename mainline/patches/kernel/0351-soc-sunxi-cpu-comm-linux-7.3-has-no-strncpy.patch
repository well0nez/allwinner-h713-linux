@@ -1177,7 +1177,7 @@ void InitCommShareSeqMem(u32 cpu_id, u32 direction)
 
 		/* Name at offset 152 (0x98) from share_seq */
 		name = (i == 0) ? "FreeCall" : "FreeReturn";
-		strncpy((char *)(seq + 152), name, 32);
+		cpu_comm_strncpy((char *)(seq + 152), name, 32);
 
 		/* Clear field_b8 */
 		*(u32 *)(seq + 184) = 0;
