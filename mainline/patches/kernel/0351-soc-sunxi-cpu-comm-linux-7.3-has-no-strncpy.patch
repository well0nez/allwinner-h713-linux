soc: sunxi: cpu_comm: Linux 7.3 has no strncpy()

The driver fills fixed-width, zero-padded name fields in the rings it shares with the display firmware.
cpu_comm_strncpy() is the 6.18 strncpy() with byte stores: those rings are device memory, and the first
version of this patch (memcpy_and_pad()) died there with an alignment fault in InitCommSeqMem on the
HY320's first 7.3.1 boot (03.11.2026); a watchdog reset brought the release kernel back.

diff --git a/drivers/soc/sunxi/cpu_comm/cpu_comm.h b/drivers/soc/sunxi/cpu_comm/cpu_comm.h
index b295df774..9bc78cf6d 100644
--- a/drivers/soc/sunxi/cpu_comm/cpu_comm.h
+++ b/drivers/soc/sunxi/cpu_comm/cpu_comm.h
@@ -851,4 +851,21 @@ void cpu_comm_kernel_deliver(const void *msg);
 void cpu_comm_api_init(void);
 void cpu_comm_api_exit(void);
 
+
+/*
+ * strncpy() as the 6.18 kernel had it, one byte store at a time: Linux 7.3 has no strncpy(), and the
+ * destinations are the shared rings the display firmware reads - device memory, where the wide unaligned
+ * stores of memcpy() fault (an alignment fault in InitCommSeqMem on the HY320, 03.11.2026).
+ */
+static inline void cpu_comm_strncpy(void *dest, const char *src, size_t n)
+{
+	volatile u8 *d = dest;
+	size_t i = 0;
+
+	for (; i < n && src[i]; i++)
+		d[i] = src[i];
+	for (; i < n; i++)
+		d[i] = 0;
+}
+
 #endif /* _CPU_COMM_H_ */
diff --git a/drivers/soc/sunxi/cpu_comm/cpu_comm_dev.c b/drivers/soc/sunxi/cpu_comm/cpu_comm_dev.c
index d4623cddc..78b110b83 100644
--- a/drivers/soc/sunxi/cpu_comm/cpu_comm_dev.c
+++ b/drivers/soc/sunxi/cpu_comm/cpu_comm_dev.c
@@ -746,7 +746,7 @@ static long comm_fd_ioctl(struct file *file, unsigned int cmd, unsigned long arg
 				u8 *entry   = comp_pool + COMP_POOL_ENTRY_SIZE * slot;
 				u32 *entry32 = (u32 *)entry;
 
-				strncpy((char *)(entry + 11), (char *)name, 15);
+				cpu_comm_strncpy((char *)(entry + 11), (char *)name, 15);
 				entry[8]  = 1;        /* attach_count = 1 */
 				entry[9]  = 1;        /* registered_flag */
 				entry[10] = (u8)slot; /* component_index */
@@ -1173,7 +1173,7 @@ static long comm_fd_ioctl(struct file *file, unsigned int cmd, unsigned long arg
 					if (!msg_pool[idx + 258]) {
 						msg_pool[idx + 258] = 1; /* mark registered */
 						/* event name at msg_pool+8 + idx*32 */
-						strncpy((char *)((u8 *)msg_pool + 8 + idx * 32),
+						cpu_comm_strncpy((char *)((u8 *)msg_pool + 8 + idx * 32),
 							(char *)buf, 32);
 						ret = idx;
 						break;
diff --git a/drivers/soc/sunxi/cpu_comm/cpu_comm_fifo.c b/drivers/soc/sunxi/cpu_comm/cpu_comm_fifo.c
index d890329ba..0ff3cf38a 100644
--- a/drivers/soc/sunxi/cpu_comm/cpu_comm_fifo.c
+++ b/drivers/soc/sunxi/cpu_comm/cpu_comm_fifo.c
@@ -43,7 +43,7 @@ void InitMsgFIFO(void *fifo_ptr, const char *prefix, const char *suffix,
 	char *name = (char *)f;
 
 	/* Build name: prefix + suffix, max 48 chars */
-	strncpy(name, prefix, FIFO_NAME_LEN);
+	cpu_comm_strncpy(name, prefix, FIFO_NAME_LEN);
 	strlcat(name, suffix, FIFO_NAME_LEN);
 
 	/* f[12] = mode (offset 0x30) */
