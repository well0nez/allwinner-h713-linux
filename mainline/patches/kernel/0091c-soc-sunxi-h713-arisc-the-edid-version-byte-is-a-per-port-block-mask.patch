 /*
+ * SetEDIDVersion: a bitmask over the firmware's three ports, bit N set
+ * serving port N the second of the two blocks. The name is the firmware's,
+ * not a description. The handler masks it to four bits, stores it at
+ * g_Data + 4 and republishes only the ports whose bit changed; an unchanged
+ * value returns at 0x125f0 having published nothing (AP3l 1).
+ */
+static int arisc_edid_mask_locked(struct h713_arisc *a, u8 mask)
+{
+	int ret = arisc_send(a, SUB_SET_EDID_VERSION, mask, 0, NULL, 0);
+
+	if (ret)
+		dev_err(a->dev, "SetEDIDVersion 0x%02x not processed (%d)\n",
+			mask, ret);
+	return ret;
+}
+
+int arisc_hdmi_edid_mask(u8 mask)
+{
+	struct h713_arisc *a = arisc_get(true);
+	int ret;
+
+	if (IS_ERR(a))
+		return PTR_ERR(a);
+	if (mask > ARISC_HDMI_EDID_MASK_MAX)
+		return -EINVAL;
+
+	mutex_lock(&a->lock);
+	ret = arisc_edid_mask_locked(a, mask);
+	if (!ret)
+		a->edid_mask = mask;
+	arisc_report(a, "edid-version 0x%02x rc=%d\n", mask, ret);
+	mutex_unlock(&a->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(arisc_hdmi_edid_mask);
+
