+		sram_wb(a, PORTMAP_POISON, rec + PORTMAP_PIN_BIT);
 	}
 
 	/*
@@ -1685,10 +1730,9 @@ static int arisc_arm_portmap_probe(struct h713_arisc *a, u8 *saved)
 	 * complete by now, so the caller can undo whatever did land.
 	 */
 	for (i = 0; i < ARISC_HDMI_PORTS; i++) {
