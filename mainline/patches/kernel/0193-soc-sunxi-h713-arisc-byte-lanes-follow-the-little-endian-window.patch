soc: sunxi: h713-arisc: byte lanes follow the little-endian window

The vendor firmware opens a little-endian window over [RTC GP3, +1 MiB)
at its start. With GP3 pointing into DRAM - at the parameter tree of the
vendor's own standby - the window is spent there, the SRAM keeps
big-endian lanes and every ARM byte access to firmware data must go to
off ^ 3. This driver does not write GP3, so it cannot know the lanes
beforehand: it learns them from the startup notify, which carries the
image's describe string in one byte order or the other. A notify that
matches neither is logged and taken as little-endian, as before.

crust closes the window at its start and keeps its own byte order, so its
lane is 0 without the comparison (which would only warn).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
--- a/drivers/soc/sunxi/sun50i-h713-arisc.c
+++ b/drivers/soc/sunxi/sun50i-h713-arisc.c
@@ -427,6 +427,7 @@ struct h713_arisc {
 
 	struct h713_arisc_offsets off;		/* resolved from the image */
 	char			image_version[64];	/* its git describe */
+	u8			lane;		/* 0 or 3, see arisc_notify_version() */
 
 	u8			edid[ARISC_HDMI_EDID_SIZE];
 	bool			edid_valid;
@@ -453,9 +454,25 @@ static void __iomem *sram_at(struct h713_arisc *a, unsigned long off)
 	return a->sram + off;
 }
 
+/*
+ * Byte access to data the firmware owns. The core is big endian and the
+ * SRAM word stays the same integer on both sides, so the byte the firmware
+ * calls @off is ARM byte @off ^ 3 -- unless its little-endian window (0x45b0)
+ * covers the SRAM, then it is @off. Words are never affected.
+ */
+static u8 sram_rb(struct h713_arisc *a, unsigned long off)
+{
+	return readb(a->sram + (off ^ a->lane));
+}
+
+static void sram_wb(struct h713_arisc *a, u8 val, unsigned long off)
+{
+	writeb(val, a->sram + (off ^ a->lane));
+}
+
 static u8 hpd_counter(struct h713_arisc *a, unsigned int port)
 {
-	return readb(sram_at(a, a->off.hpd_counter) + port);
+	return sram_rb(a, a->off.hpd_counter + port);
 }
 
 static void arisc_report(struct h713_arisc *a, const char *fmt, ...)
@@ -1121,32 +1138,61 @@ static int arisc_read_frame(struct h713_arisc *a, unsigned int ch, u32 *words,
 }
 
 /*
- * Decode the version string out of the notify. The firmware sends the words
- * from an address that is off by one byte, so in bus order the text appears
- * shifted by one and reversed within every group of four.
+ * Decode the version string out of the notify, and learn from it how the
+ * firmware sees its SRAM. The firmware copies the string (0x14d4b) byte by
+ * byte into a buffer and sends that buffer word by word (0x76a8), so what
+ * arrives depends on the lanes of its byte accesses:
+ *
+ *   little-endian window over the SRAM (RTC GP3 stale or 0, as before the
+ *   tree): the bytes are the ARM's view of the ROM string, which is stored
+ *   word-reversed -- off by one byte and reversed within every group of
+ *   four, "rojector-...", @lane 0;
+ *   big-endian lanes (GP3 = a tree in DRAM, the window is spent on it): the
+ *   string as written, reversed within every group of four, @lane 3.
+ *
+ * The image's own describe string (arisc_image_version()) tells which one
+ * this boot is. Nothing else is trusted: a tree that did not load leaves GP3
+ * as it was, and whatever it held decides the lanes.
  */
+static void arisc_notify_decode(const u8 *raw, unsigned int nb, unsigned int skew,
+				char *p, size_t len)
+{
+	unsigned int m;
+
+	for (m = 0; m + skew < nb && m + 1 < len; m++) {
+		unsigned int idx = skew + 4 * (m / 4) + (3 - m % 4);
+		char c = idx < nb ? raw[idx] : 0;
+
+		if (c < 0x20 || c >= 0x7f)
+			break;
+		*p++ = c;
+	}
+	*p = '\0';
+}
+
 static void arisc_notify_version(struct h713_arisc *a, const u32 *words,
 				 unsigned int n)
 {
 	u8 raw[4 * NOTIFY_MAX_WORDS];
-	unsigned int i, nb = 0, m;
-	char *p = a->notify_version;
+	char be[sizeof(a->notify_version)];
+	unsigned int i, nb = 0;
 
 	for (i = 2; i < n; i++) {
 		put_unaligned_le32(words[i], raw + nb);
 		nb += 4;
 	}
 
-	for (m = 0; m + 1 < nb &&
-	     p < a->notify_version + sizeof(a->notify_version) - 1; m++) {
-		unsigned int idx = 1 + 4 * (m / 4) + (3 - m % 4);
-		char c = idx < nb ? raw[idx] : 0;
-
-		if (c < 0x20 || c >= 0x7f)
-			break;
-		*p++ = c;
+	arisc_notify_decode(raw, nb, 0, be, sizeof(be));
+	arisc_notify_decode(raw, nb, 1, a->notify_version,
+			    sizeof(a->notify_version));
+	if (strlen(be) >= 16 && !strncmp(be, a->image_version, strlen(be))) {
+		a->lane = 3;
+		strscpy(a->notify_version, be, sizeof(a->notify_version));
+	} else if (strncmp(a->notify_version, a->image_version + 1,
+			   strlen(a->notify_version)) || strlen(a->notify_version) < 16) {
+		dev_warn(a->dev, "startup notify \"%s\" is not the image's \"%s\" in either byte order -- assuming little-endian lanes\n",
+			 a->notify_version, a->image_version);
 	}
-	*p = '\0';
 }
 
