+
+		/*
+		 * The incoming side, the pool the MIPS draws from for its
+		 * callbacks to us (share sequence local=ARM, remote=MIPS). The
+		 * CallCmd ring at +32 is where stock parks the references for a
+		 * reader; with the kernel releasing directly it must stay empty
+		 * ("ungelesen 0"), and the FreeCall ring at +120 must keep its
+		 * slots ("frei" 19 or 20). Before that fix "ungelesen" grew by
+		 * one per callback and the MIPS hung at 19 (doku/nachtlog/S10).
+		 */
+		fifo = (u32 *)(getShareSeqR(1, 0) + 32);
+		in_rd = fifo[0]; in_wr = fifo[1]; in_cap = fifo[4];
+		if (in_cap && in_rd < in_cap && in_wr < in_cap)
+			in_pend = (in_wr + in_cap - in_rd) % in_cap;
+		fifo = (u32 *)(getShareSeqR(1, 0) + 120);
+		ifc_rd = fifo[0]; ifc_wr = fifo[1]; ifc_cap = fifo[4];
+		if (ifc_cap && ifc_rd < ifc_cap && ifc_wr < ifc_cap)
+			ifc_free = (ifc_wr + ifc_cap - ifc_rd) % ifc_cap;
 	}
 	cpu_comm_read_rt_lock(&lock);
 
