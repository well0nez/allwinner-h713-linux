 	bool heiss = erste && READ_ONCE(rx->hotplug_count);
 	bool wechsel = false;
 
-	rx->desc_seen = true;
+	WRITE_ONCE(rx->desc_seen, true);
 	if (erste)
 		dev_info(rx->dev,
 			 "Freigabe: erste Veroeffentlichung%s -- Capture wird direkt freigegeben, Quellenwechsel nur als Rueckfall\n",
@@ -3589,6 +3589,16 @@ static int h713_hdmirx_detect_timings(struct h713_hdmirx *rx,
 	 * (74.25 MHz). Its rate is not the signal's; take the rate from the
 	 * ring instead, as for a missing record.
 	 *
+	 * The test also asks whether a descriptor was ever published. The two
+	 * record fields alone would call a genuine 30.00 Hz source with colour
+	 * format 0 our own record and drop its rate, and the firmware cannot
+	 * be echoing a descriptor that was never written: before the first
+	 * publication of a boot there IS no own record. That is the whole of
+	 * the second distinguishing feature this driver can be sure of - the
+	 * record carries no source field, and where the firmware does not
+	 * scale its geometry is the source's geometry as well, so on the HY310
+	 * nothing in the record itself tells the two apart (0136o).
+	 *
 	 * Nor is its geometry the signal's: the descriptor carries the RING
 	 * that h713-tv put on the plane, so the record echoes the ring, and
 	 * the ring is not the source where the firmware scales (852x478 for a
@@ -3599,7 +3609,8 @@ static int h713_hdmirx_detect_timings(struct h713_hdmirx *rx,
 	 * before the comparison, and takes no part in it.
 	 */
 	own_record = have_sig && sig.color_format == 0 &&
-		     sig.frame_rate_x100 == H713_OWN_RECORD_FPS_X100;
+		     sig.frame_rate_x100 == H713_OWN_RECORD_FPS_X100 &&
+		     READ_ONCE(rx->desc_seen);
 
 	ret = regmap_read(rx->incap, H713_INCAP_ACTIVE, &active);
 	if (!ret)
@@ -3987,6 +3998,7 @@ static int h713_hdmirx_s_dv_timings(struct file *file, void *priv,
 	ring.width = t->bt.width;
 	ring.height = t->bt.height;
 	ring.pitch = ALIGN(t->bt.width, H713_INCAP_ROWBYTE_UNIT);
+
 	h713_hdmirx_set_timings(rx, t, &ring);
 
 	return 0;
