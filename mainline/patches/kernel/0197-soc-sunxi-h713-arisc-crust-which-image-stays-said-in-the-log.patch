-/* A live crust: the page's magic, its running bit and a moving heartbeat. */
+/*
+ * A live crust: the page's magic, its running bit and a heartbeat that moves
+ * within CRUST_ALIVE_MS. TF-A samples 10 ms; a main loop pass that takes
+ * longer must not make this driver reset a working crust.
+ */
+#define CRUST_ALIVE_MS		100
+
 static bool arisc_crust_running(struct h713_arisc *a)
 {
-	u32 s0, s1;
+	ktime_t start = ktime_get();
+	u32 s0;
 
 	if (crust_rd(a, H713_MAGIC) != H713_MAGIC_VALUE)
 		return false;
 	s0 = crust_rd(a, H713_STATUS);
-	usleep_range(5000, 6000);
-	s1 = crust_rd(a, H713_STATUS);
-	return (s0 & H713_ST_RUNNING) && s1 != s0;
+	if (!(s0 & H713_ST_RUNNING))
+		return false;
+	do {
+		usleep_range(1000, 2000);
+		if ((crust_rd(a, H713_STATUS) ^ s0) & H713_ST_HEARTBEAT)
+			return true;
+	} while (ktime_ms_delta(ktime_get(), start) < CRUST_ALIVE_MS);
+	return false;
+}
+
+/*
+ * No file, but a crust TF-A started whose page this driver reads: keep it
+ * rather than lose HDMI with the file. Without the image nothing can load
+ * it again.
+ */
+static bool arisc_keep_without_file(struct h713_arisc *a, const char *name,
+				    int err)
+{
+	if (a->sram_size < CRUST_PAGE_END || !arisc_crust_running(a) ||
+	    !crust_accept(a, CRUST_HDMI_MIN) || arisc_crust_offsets(a))
+		return false;
+	dev_warn(a->dev, "ARISC firmware \"%s\" cannot be loaded (%d) -- keeping the running crust (build 0x%08x)\n",
+		 name, err, crust_rd(a, H713_DIAG_BUILD));
+	return true;
 }
 
