+/*
+ * crust's addresses are its contract page's, the same for every build. The
+ * page lies beyond the 0x23000 bytes the vendor image needs; the DT declares
+ * the window up to its end, and this driver maps nothing the DT does not
+ * describe.
+ */
+static int arisc_crust_offsets(struct h713_arisc *a)
+{
+	struct h713_arisc_offsets o = { .para = SRAM_PARA, .crust = true };
+
+	if (a->sram_size < CRUST_PAGE_END) {
+		dev_err(a->dev, "\"sram\" window is 0x%llx bytes, crust's contract page needs 0x%x\n",
+			(unsigned long long)a->sram_size, CRUST_PAGE_END);
+		return -EINVAL;
+	}
+	o.load_base = CRUST_LOAD_BASE;
+	o.gdata = H713_PAGE + H713_GDATA;
+	o.rpm_state = H713_PAGE + H713_PUMP;
+	o.rpm_buf = o.rpm_state + PUMP_BUF;
+	o.hpd_counter = o.gdata + GDATA_HPD_COUNTER;
+	o.edid_ready = o.gdata + GDATA_EDID_READY;
+	o.edid_gate = o.gdata + GDATA_EDID_GATE;
+	o.edid_version = o.gdata + GDATA_EDID_VERSION;
+	o.portmap = o.gdata + GDATA_PORTMAP;
+	o.scratch = o.gdata + GDATA_SCRATCH;
+	o.bss_start = H713_PAGE;
+	o.bss_end = o.stack_top = CRUST_PAGE_END;
+	strscpy(a->image_version, "crust-h713 (contract page)",
+		sizeof(a->image_version));
+	a->off = o;
+	return 0;
+}
