+/*
+ * Runs on fw->data before anything is written to SRAM. On success a->off is
+ * the address set of this image; on failure nothing has been touched and the
+ * message says which step refused.
+ */
+static int arisc_resolve_offsets(struct h713_arisc *a, const u8 *data,
+				 const char *name)
+{
+	struct h713_arisc_offsets o = { .para = SRAM_PARA };
+	unsigned int hits;
+	u32 cross, rom;
+
+	arisc_image_version(data, a->image_version, sizeof(a->image_version));
+
+	hits = arisc_sig_scan(data, SIG_GDATA, 0, &o.gdata);
+	if (hits != 1)
+		return dev_err_probe(a->dev, -ENOEXEC,
+			"\"%s\" (%s): g_Data anchor matches %u times, not once -- unknown build, refusing to guess its addresses\n",
+			name, a->image_version, hits);
+	hits = arisc_sig_scan(data, SIG_PUMP, 0, &o.rpm_state);
+	if (hits != 1)
+		return dev_err_probe(a->dev, -ENOEXEC,
+			"\"%s\" (%s): pump anchor matches %u times, not once -- unknown build, refusing to guess its addresses\n",
+			name, a->image_version, hits);
+
+	o.hpd_counter = o.gdata + GDATA_HPD_COUNTER;
+	o.edid_ready = o.gdata + GDATA_EDID_READY;
+	o.edid_gate = o.gdata + GDATA_EDID_GATE;
+	o.portmap = o.gdata + GDATA_PORTMAP;
+	o.scratch = o.gdata + GDATA_SCRATCH;
+	o.rpm_buf = o.rpm_state + PUMP_BUF;
+
+	hits = arisc_sig_scan(data, SIG_SCRATCH, 0, &cross);
+	if (hits != 1 || cross != o.scratch)
+		return dev_err_probe(a->dev, -ENOEXEC,
+			"\"%s\": handler scratch 0x%05x (%u hits), g_Data + %d is 0x%05x -- the image's own layout disagrees with the anchor\n",
+			name, cross, hits, GDATA_SCRATCH, o.scratch);
+
+	rom = arisc_sig_rom_table(data);
+	if (!rom)
+		return dev_err_probe(a->dev, -ENOEXEC,
+			"\"%s\": ROM port map table not in this image exactly once -- port map not cross-checkable\n",
+			name);
+	hits = arisc_sig_scan(data, SIG_PORTMAP, rom, &cross);
+	if (hits != 1 || cross != o.portmap)
+		return dev_err_probe(a->dev, -ENOEXEC,
+			"\"%s\": init copier writes the port map at 0x%05x (%u hits), g_Data + %d is 0x%05x -- the image's own layout disagrees with the anchor\n",
+			name, cross, hits, GDATA_PORTMAP, o.portmap);
+
+	if (!arisc_sig_memory_map(data, &o) || o.bss_start >= o.bss_end ||
+	    o.bss_end > o.stack_top || o.stack_top > SRAM_IMAGE_SIZE)
+		return dev_err_probe(a->dev, -ENOEXEC,
+			"\"%s\": no usable memory map in the image (BSS 0x%05x..0x%05x, stack top 0x%05x)\n",
+			name, o.bss_start, o.bss_end, o.stack_top);
+
+	if (!arisc_in_bss(&o, o.hpd_counter, ARISC_HDMI_PORTS) ||
+	    !arisc_in_bss(&o, o.edid_ready, 1) ||
+	    !arisc_in_bss(&o, o.edid_gate, 1) ||
+	    !arisc_in_bss(&o, o.portmap, ARISC_HDMI_PORTS * PORTMAP_STRIDE) ||
+	    !arisc_in_bss(&o, o.scratch, SCRATCH_LEN) ||
+	    !arisc_in_bss(&o, o.rpm_state, sizeof(u32)) ||
+	    !arisc_in_bss(&o, o.rpm_buf, PAYLOAD_MAX))
+		return dev_err_probe(a->dev, -ENOEXEC,
+			"\"%s\": payload 0x%05x / scratch 0x%05x leave the BSS 0x%05x..0x%05x -- refusing to write into the firmware's stack 0x%05x..0x%05x\n",
+			name, o.rpm_buf, o.scratch, o.bss_start, o.bss_end - 1,
+			o.bss_end, o.stack_top - 1);
+
+	if (!strcmp(a->image_version, FW_VERSION_HY310) &&
+	    !arisc_offsets_equal(&o, &arisc_hy310_expected))
+		return dev_err_probe(a->dev, -ENOEXEC,
+			"\"%s\" is the HY310 build but resolves g_Data 0x%05x, pump 0x%05x instead of 0x%05x, 0x%05x -- the resolver has drifted\n",
+			name, o.gdata, o.rpm_state, arisc_hy310_expected.gdata,
+			arisc_hy310_expected.rpm_state);
+
+	a->off = o;
+	dev_info(a->dev,
+		 "\"%s\" (%s): g_Data 0x%05x, pump 0x%05x, scratch 0x%05x, port map 0x%05x, BSS 0x%05x..0x%05x, stack 0x%05x..0x%05x\n",
+		 name, a->image_version, o.gdata, o.rpm_state, o.scratch,
+		 o.portmap, o.bss_start, o.bss_end - 1, o.bss_end,
+		 o.stack_top - 1);
+	return 0;
+}
