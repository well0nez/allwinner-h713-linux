+/* ------------------------------------------------------------------------ */
+/* The bridge PCM                                                            */
+/* ------------------------------------------------------------------------ */
+
+/*
+ * The ring in DRAM is read by the AUDBRG's input-stream channel (an RLB, the
+ * "read line buffer") and handed to the AUDIF's I2S transmitter ABPO(n+1),
+ * which sends it into the DSP. Three things are fixed in silicon and in the
+ * vendor module and are taken over as they are:
+ *
+ *  - Input stream n and ABPO(n+1) are a pair (Trid_Audio_Output_Istream_Open:
+ *    0 -> abpo1, 1 -> abpo2, 2 -> abpo3). There is no routing register.
+ *  - The channel has no enable bit. It fetches once START/END/STEP/CFG stand,
+ *    the flush has been pulsed and UMACREQ has been kicked
+ *    (alsa_audbrg_istream_start), and it interrupts every STEP bytes
+ *    (Handle_RLB_Interrupt). STEP is one ALSA period here, so the STEP
+ *    interrupt is the period interrupt; the ALSA pointer is the channel's
+ *    own read pointer, so the accounting does not depend on it.
+ *  - The ABPO is fed frame by frame. Its DATA register takes a word that
+ *    names the frame length; the transmitter interrupts at the end of a
+ *    frame and expects the word for the next one (AudIf_i2so_Interrupt, or
+ *    the vendor's Write path when the queue was empty). Frame length here is
+ *    one period as well, and the word is the same every time, so the
+ *    interrupt handler only writes it again. A frame word that is not
+ *    re-armed stops the transmitter ("I2S output buffer underrun" in the
+ *    vendor's words); a ring the channel has stopped reading is caught by the
+ *    stall timer below and reported as an xrun instead of a hang.
+ *
+ * All of it runs only while the island is up. The interrupt lines are
+ * disabled around every island reset (msp_pcm_island_lost), because an AUDIF
+ * access with the audio top clock down hangs the CPU (S21).
+ */
+
+static const struct snd_pcm_hardware msp_pcm_hw = {
+	.info			= SNDRV_PCM_INFO_MMAP |
+				  SNDRV_PCM_INFO_MMAP_VALID |
+				  SNDRV_PCM_INFO_INTERLEAVED |
+				  SNDRV_PCM_INFO_BLOCK_TRANSFER,
+	.formats		= SNDRV_PCM_FMTBIT_S16_LE,
+	.rates			= SNDRV_PCM_RATE_48000,
+	.rate_min		= 48000,
+	.rate_max		= 48000,
+	.channels_min		= 2,
+	.channels_max		= 2,
+	.buffer_bytes_max	= MSP_BRG_RING_MAX,
+	.period_bytes_min	= 256,
+	.period_bytes_max	= MSP_BRG_RING_MAX / 2,
+	.periods_min		= 2,
+	.periods_max		= 64,
+};
+
+#define MSP_PCM_STALL_MS	2000
+
+static void msp_brg_pulse(struct h713_msp *msp, unsigned int reg)
+{
+	writel(1, msp->brg + reg);
+	writel(0, msp->brg + reg);
+}
+
+/* the substream to wake, or NULL - under pcm_lock, so a closing stream is safe */
+static struct snd_pcm_substream *msp_pcm_active(struct h713_msp *msp)
+{
+	struct snd_pcm_substream *sub = NULL;
+	unsigned long flags;
+
+	spin_lock_irqsave(&msp->pcm_lock, flags);
+	if (msp->pcm_running)
+		sub = msp->pcm_sub;
+	spin_unlock_irqrestore(&msp->pcm_lock, flags);
+
+	return sub;
+}
+
+/* SPI 115: the input-stream channel has read another STEP of the ring */
+static irqreturn_t msp_brg_irq(int irq, void *data)
+{
+	struct h713_msp *msp = data;
+	struct snd_pcm_substream *sub;
+	u32 status;
+
+	status = readl(msp->brg + MSP_BRG_IRQ_STATUS) & MSP_BRG_IRQ_ALL;
+	if (!status)
+		return IRQ_NONE;
+	writel(status, msp->brg + MSP_BRG_IRQ_STATUS);
+	msp->brg_irqs++;
+
+	if (status & MSP_BRG_ISTREAM_IRQ(msp->pcm_istream)) {
+		sub = msp_pcm_active(msp);
+		if (sub)
+			snd_pcm_period_elapsed(sub);
+	}
+
+	return IRQ_HANDLED;
+}
+
+/*
+ * SPI 113: the ABPO has sent a frame. Everything pending is acknowledged,
+ * as the vendor's Handle_AudIf_ISR_interrupt does - the line is level
+ * triggered and sources nobody listens to must not keep it up.
+ */
+static irqreturn_t msp_audif_irq(int irq, void *data)
+{
+	struct h713_msp *msp = data;
+	unsigned int n = msp->pcm_istream;
+	struct snd_pcm_substream *sub;
+	unsigned long flags;
+	u32 status, err;
+
+	status = readl(msp->audif + MSP_AUDIF_IRQ_STATUS);
+	if (!status)
+		return IRQ_NONE;
+	writel(status, msp->audif + MSP_AUDIF_IRQ_STATUS);
+
+	if (status & MSP_AUDIF_ABPO_IRQ(n)) {
+		spin_lock_irqsave(&msp->pcm_lock, flags);
+		if (msp->pcm_running) {
+			writel(msp->frame_word,
+			       msp->audif + MSP_AUDIF_ABPO_DATA(n));
+			msp->frames_sent++;
+		}
+		spin_unlock_irqrestore(&msp->pcm_lock, flags);
+
+		/* the frame is a period too; a second wake-up per period is harmless */
+		sub = msp_pcm_active(msp);
+		if (sub)
+			snd_pcm_period_elapsed(sub);
+	}
+
+	/* status bits 14/13/12: SCC error of stream 1/2/3 (AudIf_i2so_Interrupt) */
+	if (status & BIT(14 - n)) {
+		err = readl(msp->audif + MSP_AUDIF_ERR_STATUS);
+		writel(err & MSP_AUDIF_ABPO_ERR(n),
+		       msp->audif + MSP_AUDIF_ERR_STATUS);
+		msp->abpo_errors++;
+		dev_warn_ratelimited(msp->dev,
+				     "ABPO%u SCC %s (err %#010x, %u so far)\n",
+				     n + 1, err & (0x2 << (2 * n)) ? "overflow" :
+				     "underflow", err, msp->abpo_errors);
+	}
+
+	return IRQ_HANDLED;
+}
+
+static u32 msp_pcm_hw_ptr(struct h713_msp *msp)
+{
+	u64 phys;
+
+	phys = (u64)(readl(msp->ctrl + MSP_CTRL_HIGH_ADDR) &
+		     MSP_CTRL_HIGH_ADDR_RLB) << 28;
+	phys |= (u64)(readl(msp->brg + MSP_BRG_ISTREAM(msp->pcm_istream) +
+			    MSP_BRG_PTR) & 0xffffff) << 4;
+
+	return (u32)(phys - msp->ring_dma);
+}
+
+/*
+ * A channel that stopped reading leaves aplay waiting for ever, with nothing
+ * in the log. Two seconds without movement of the read pointer is reported
+ * as an xrun with the state that tells the two failure modes apart: the
+ * frame count says whether the ABPO is still taking frames, the error word
+ * whether it starved.
+ */
+static void msp_pcm_stall_timer(struct timer_list *t)
+{
+	struct h713_msp *msp = timer_container_of(msp, t, stall_timer);
+	struct snd_pcm_substream *sub = msp_pcm_active(msp);
+	u32 ptr;
+
+	if (!sub)
+		return;
+	ptr = msp_pcm_hw_ptr(msp);
+	if (ptr != msp->stall_ptr) {
+		msp->stall_ptr = ptr;
+		mod_timer(&msp->stall_timer,
+			  jiffies + msecs_to_jiffies(MSP_PCM_STALL_MS));
+		return;
+	}
+	msp->stalls++;
+	dev_warn(msp->dev,
+		 "bridge PCM stalled: input stream %u read pointer %#x unchanged for %u ms, %u frames sent, AUDIF err %#010x, AUDBRG status %#010x\n",
+		 msp->pcm_istream, ptr, MSP_PCM_STALL_MS, msp->frames_sent,
+		 readl(msp->audif + MSP_AUDIF_ERR_STATUS),
+		 readl(msp->brg + MSP_BRG_IRQ_STATUS));
+	snd_pcm_stop_xrun(sub);
+}
+
+static int msp_pcm_open(struct snd_pcm_substream *substream)
+{
+	struct h713_msp *msp = snd_pcm_substream_chip(substream);
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	unsigned long flags;
+	int ret = 0;
+
+	mutex_lock(&msp->lock);
+	if (graph == MSP_GRAPH_HDMI_ONLY) {
+		dev_warn_ratelimited(msp->dev,
+				     "bridge PCM opened with graph=0: that graph has no bridge input\n");
+		ret = -ENXIO;
+	} else if (msp->state != MSP_STATE_RUNNING) {
+		dev_warn_ratelimited(msp->dev,
+				     "bridge PCM opened while the DSP is \"%s\"\n",
+				     msp_state_names[msp->state]);
+		ret = -ENXIO;
+	}
+	mutex_unlock(&msp->lock);
+	if (ret)
+		return ret;
+
+	runtime->hw = msp_pcm_hw;
+	/* STEP and START/END count in 16-byte units; the ring holds whole periods */
+	ret = snd_pcm_hw_constraint_step(runtime, 0,
+					 SNDRV_PCM_HW_PARAM_PERIOD_BYTES,
+					 MSP_BRG_ALIGN);
+	if (ret < 0)
+		return ret;
+	ret = snd_pcm_hw_constraint_integer(runtime, SNDRV_PCM_HW_PARAM_PERIODS);
+	if (ret < 0)
+		return ret;
+
+	spin_lock_irqsave(&msp->pcm_lock, flags);
+	msp->pcm_sub = substream;
+	msp->pcm_running = false;
+	spin_unlock_irqrestore(&msp->pcm_lock, flags);
+
+	return 0;
+}
+
+static int msp_pcm_close(struct snd_pcm_substream *substream)
+{
+	struct h713_msp *msp = snd_pcm_substream_chip(substream);
+	unsigned long flags;
+
+	timer_delete_sync(&msp->stall_timer);
+	spin_lock_irqsave(&msp->pcm_lock, flags);
+	msp->pcm_running = false;
+	msp->pcm_sub = NULL;
+	spin_unlock_irqrestore(&msp->pcm_lock, flags);
+
+	return 0;
+}
+
+/*
+ * Program the ring: audbrg_istream_config @0x32e8 register for register,
+ * with the ALSA buffer as the ring and one period as STEP, then open the
+ * ABPO the way AudIf_i2so_Open does. Nothing moves yet: the channel has no
+ * data request before UMACREQ, the transmitter no frame word.
+ */
+static int msp_pcm_prepare(struct snd_pcm_substream *substream)
+{
+	struct h713_msp *msp = snd_pcm_substream_chip(substream);
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	unsigned int n = msp->pcm_istream;
+	void __iomem *ch = msp->brg + MSP_BRG_ISTREAM(n);
+	dma_addr_t dma = runtime->dma_addr;
+	size_t bytes = snd_pcm_lib_buffer_bytes(substream);
+	size_t period = snd_pcm_lib_period_bytes(substream);
+	u32 v;
+
+	/*
+	 * START/END/PTR carry A[27:4], the top nibble comes from 0x06142044
+	 * and is shared by every input stream: the ring has to be 16-byte
+	 * aligned, below 4 GiB and inside one 256 MiB window.
+	 */
+	if (upper_32_bits(dma) || (dma & (MSP_BRG_ALIGN - 1)) ||
+	    (bytes & (MSP_BRG_ALIGN - 1)) ||
+	    (dma >> 28) != ((dma + bytes - 1) >> 28)) {
+		dev_err(msp->dev,
+			"bridge ring %pad + %zu is not usable: needs 16-byte alignment, 32 bits and one 256 MiB window\n",
+			&dma, bytes);
+		return -EINVAL;
+	}
+	if (runtime->period_size > MSP_ABPO_WORD_LEN)
+		return -EINVAL;
+
+	msp->ring_dma = dma;
+	msp->ring_bytes = bytes;
+	msp->frame_word = MSP_ABPO_WORD_RUN | MSP_ABPO_WORD_CHANNEL(n) |
+			  (u32)runtime->period_size;
+
+	v = readl(msp->ctrl + MSP_CTRL_HIGH_ADDR);
+	writel((v & ~MSP_CTRL_HIGH_ADDR_RLB) |
+	       ((lower_32_bits(dma) >> 28) & MSP_CTRL_HIGH_ADDR_RLB),
+	       msp->ctrl + MSP_CTRL_HIGH_ADDR);
+	writel((lower_32_bits(dma) >> 4) & 0xffffff, ch + MSP_BRG_START);
+	writel((lower_32_bits(dma + bytes - 1) >> 4) & 0xffffff, ch + MSP_BRG_END);
+	writel(period >> 4, ch + MSP_BRG_STEP);
+	writel(MSP_BRG_CFG_S16_STEREO, ch + MSP_BRG_CFG);
+	writel(0, msp->brg + MSP_BRG_STREAM_SYNC);
+	msp_brg_pulse(msp, MSP_BRG_ISTREAM(n) + MSP_BRG_FLUSH);
+
+	/* the channel interrupt: acknowledge, unmask, enable the block's line */
+	writel(MSP_BRG_ISTREAM_IRQ(n), msp->brg + MSP_BRG_IRQ_STATUS);
+	v = readl(msp->brg + MSP_BRG_IRQ_MASK);
+	writel(v | MSP_BRG_ISTREAM_IRQ(n), msp->brg + MSP_BRG_IRQ_MASK);
+	v = readl(msp->brg + MSP_BRG_GLOBAL_IRQ_EN);
+	writel(v | BIT(0), msp->brg + MSP_BRG_GLOBAL_IRQ_EN);
+
+	/* AudIf_i2so_Open: acknowledge, clear the SCC errors, unmask */
+	writel(MSP_AUDIF_ABPO_IRQ(n), msp->audif + MSP_AUDIF_IRQ_STATUS);
+	writel(MSP_AUDIF_ABPO_ERR(n), msp->audif + MSP_AUDIF_ERR_STATUS);
+	v = readl(msp->audif + MSP_AUDIF_IRQ_MASK);
+	writel(v | MSP_AUDIF_ABPO_IRQ(n), msp->audif + MSP_AUDIF_IRQ_MASK);
+
+	return 0;
+}
+
+static int msp_pcm_trigger(struct snd_pcm_substream *substream, int cmd)
+{
+	struct h713_msp *msp = snd_pcm_substream_chip(substream);
+	unsigned int n = msp->pcm_istream;
+	void __iomem *ch = msp->brg + MSP_BRG_ISTREAM(n);
+	unsigned long flags;
+	u32 div, v;
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+		spin_lock_irqsave(&msp->pcm_lock, flags);
+		msp->pcm_running = true;
+		spin_unlock_irqrestore(&msp->pcm_lock, flags);
+
+		/* alsa_audbrg_istream_start: the fetch request, ring already flushed */
+		msp_brg_pulse(msp, MSP_BRG_ISTREAM(n) + MSP_BRG_UMACREQ);
+
+		/*
+		 * AudIf_i2so_activate: the first frame word, then the clock
+		 * (324 MHz / Fs in 8.8 fixed point, shifted up by eight), then
+		 * the next frame word is primed the way the vendor's Write path
+		 * primes it as soon as a second frame exists.
+		 */
+		writel(msp->frame_word | MSP_ABPO_WORD_FIRST,
+		       msp->audif + MSP_AUDIF_ABPO_DATA(n));
+		div = (MSP_ABPO_REF_HZ / 48000) << 8;
+		div += ((((MSP_ABPO_REF_HZ % 48000) << 9) / 48000) + 1) >> 1;
+		writel(div << 8, msp->audif + MSP_AUDIF_ABPO_CLK(n));
+		writel(msp->frame_word, msp->audif + MSP_AUDIF_ABPO_DATA(n));
+
+		msp->stall_ptr = msp_pcm_hw_ptr(msp);
+		mod_timer(&msp->stall_timer,
+			  jiffies + msecs_to_jiffies(MSP_PCM_STALL_MS));
+		return 0;
+
+	case SNDRV_PCM_TRIGGER_STOP:
+		spin_lock_irqsave(&msp->pcm_lock, flags);
+		msp->pcm_running = false;
+		spin_unlock_irqrestore(&msp->pcm_lock, flags);
+		/* not _sync: STOP may arrive from the timer's own xrun */
+		timer_delete(&msp->stall_timer);
+
+		/* AudIf_i2so_Close: clock off, frame word without its valid bit */
+		writel(0, msp->audif + MSP_AUDIF_ABPO_CLK(n));
+		writel(msp->frame_word & ~BIT(31),
+		       msp->audif + MSP_AUDIF_ABPO_DATA(n));
+		v = readl(msp->audif + MSP_AUDIF_IRQ_MASK);
+		writel(v & ~MSP_AUDIF_ABPO_IRQ(n), msp->audif + MSP_AUDIF_IRQ_MASK);
+
+		/* audbrg_istream_stop: request off, flush, interrupt masked */
+		writel(0, ch + MSP_BRG_UMACREQ);
+		msp_brg_pulse(msp, MSP_BRG_ISTREAM(n) + MSP_BRG_FLUSH);
+		v = readl(msp->brg + MSP_BRG_IRQ_MASK);
+		writel(v & ~MSP_BRG_ISTREAM_IRQ(n), msp->brg + MSP_BRG_IRQ_MASK);
+		return 0;
+
+	default:
+		return -EINVAL;
+	}
+}
+
+static snd_pcm_uframes_t msp_pcm_pointer(struct snd_pcm_substream *substream)
+{
+	struct h713_msp *msp = snd_pcm_substream_chip(substream);
+	u32 off = msp_pcm_hw_ptr(msp);
+
