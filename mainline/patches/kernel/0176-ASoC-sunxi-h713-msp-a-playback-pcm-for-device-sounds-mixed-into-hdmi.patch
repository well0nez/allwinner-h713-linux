+	spin_lock_init(&msp->pcm_lock);
+	timer_setup(&msp->stall_timer, msp_pcm_stall_timer, 0);
+
+	base = devm_platform_ioremap_resource_byname(pdev, "audbrg");
+	msp->irq_brg = platform_get_irq_byname_optional(pdev, "audbrg");
+	msp->irq_audif = platform_get_irq_byname_optional(pdev, "audif");
+	if (IS_ERR(base) || msp->irq_brg < 0 || msp->irq_audif < 0) {
+		dev_info(dev,
+			 "no \"audbrg\" window or interrupts in the device tree: no bridge PCM\n");
+		return 0;
+	}
+	if (istream >= MSP_BRG_NUM_ISTREAMS) {
+		dev_warn(dev, "istream=%u is not one of 0..2, using 0\n", istream);
+		istream = 0;
+	}
+	if (graph > MSP_GRAPH_MIXED_DIRECT) {
+		dev_warn(dev, "graph=%u is not one of 0..2, using 1\n", graph);
+		graph = MSP_GRAPH_MIXED;
+	}
+	msp->pcm_istream = istream;
+
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret)
+		return ret;
+
+	/* IRQF_NO_AUTOEN: the lines stay off until the island is up */
+	ret = devm_request_irq(dev, msp->irq_brg, msp_brg_irq, IRQF_NO_AUTOEN,
+			       "h713-msp-audbrg", msp);
+	if (ret)
+		return dev_err_probe(dev, ret, "AUDBRG interrupt not available\n");
+	ret = devm_request_irq(dev, msp->irq_audif, msp_audif_irq,
+			       IRQF_NO_AUTOEN, "h713-msp-audif", msp);
+	if (ret)
+		return dev_err_probe(dev, ret, "AUDIF interrupt not available\n");
+
+	msp->brg = base;
+	dev_info(dev, "bridge PCM: input stream %u -> ABPO%u, graph %s\n",
+		 istream, istream + 1, msp_graph_names[graph]);
+	return 0;
+}
