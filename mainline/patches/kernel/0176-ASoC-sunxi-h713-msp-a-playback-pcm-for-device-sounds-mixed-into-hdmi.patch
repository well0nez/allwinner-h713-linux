+static int msp_input_mute_get(struct snd_kcontrol *kcontrol,
+			      struct snd_ctl_elem_value *ucontrol)
+{
+	struct h713_msp *msp = snd_kcontrol_chip(kcontrol);
+
+	mutex_lock(&msp->lock);
+	ucontrol->value.integer.value[0] = msp->input_mute;
+	mutex_unlock(&msp->lock);
+	return 0;
+}
+
+static int msp_input_mute_put(struct snd_kcontrol *kcontrol,
+			      struct snd_ctl_elem_value *ucontrol)
+{
+	struct h713_msp *msp = snd_kcontrol_chip(kcontrol);
+	bool mute = !!ucontrol->value.integer.value[0];
+	int ret = 0;
+
+	mutex_lock(&msp->lock);
+	if (msp->input_mute == mute) {
+		mutex_unlock(&msp->lock);
+		return 0;
+	}
+	msp->input_mute = mute;
+
+	if (msp->state == MSP_STATE_RUNNING) {
+		ret = msp_dsp_update(msp, DSP_HDMI_MUTE, 0x0001, mute ? 0x0001 : 0);
+		if (ret)
+			msp_mailbox_failed(msp, ret);
+	}
+	mutex_unlock(&msp->lock);
+
+	return ret ? -EIO : 1;
+}
