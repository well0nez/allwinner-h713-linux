+/*
+ * Called with the lock held before the island goes down: a stream that is
+ * running has lost its ring and its transmitter, and the interrupt handlers
+ * must not touch a block that is about to hang the CPU.
+ */
+static void msp_pcm_island_lost(struct h713_msp *msp)
+{
+	struct snd_pcm_substream *sub;
+	unsigned long flags;
+
+	if (!msp->brg)
+		return;
+	if (msp->irqs_live) {
+		disable_irq(msp->irq_brg);
+		disable_irq(msp->irq_audif);
+		msp->irqs_live = false;
+	}
+	timer_delete_sync(&msp->stall_timer);
+
+	spin_lock_irqsave(&msp->pcm_lock, flags);
+	sub = msp->pcm_running ? msp->pcm_sub : NULL;
+	msp->pcm_running = false;
+	spin_unlock_irqrestore(&msp->pcm_lock, flags);
+	if (sub) {
+		dev_warn(msp->dev, "bridge PCM stopped: the island is being reset\n");
+		snd_pcm_stop_xrun(sub);
+	}
+}
+
+/* Called with the lock held once the island is up: quiet both blocks, listen. */
+static void msp_pcm_island_ready(struct h713_msp *msp)
+{
+	if (!msp->brg)
+		return;
+	writel(0, msp->brg + MSP_BRG_GLOBAL_IRQ_EN);
+	writel(0, msp->brg + MSP_BRG_IRQ_MASK);
+	writel(MSP_BRG_IRQ_ALL, msp->brg + MSP_BRG_IRQ_STATUS);
+	writel(0, msp->audif + MSP_AUDIF_IRQ_MASK);
+	writel(readl(msp->audif + MSP_AUDIF_IRQ_STATUS),
+	       msp->audif + MSP_AUDIF_IRQ_STATUS);
+	if (!msp->irqs_live) {
+		enable_irq(msp->irq_brg);
+		enable_irq(msp->irq_audif);
+		msp->irqs_live = true;
+	}
+}
