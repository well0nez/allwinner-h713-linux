 };
@@ -251,6 +267,27 @@ static int h713_mips_tvtop(struct h713_mips *m)
 			     readl(m->tvtop + H713_TVTOP_GATE), readl(m->tvtop + H713_TVTOP_RST));
 }
 
+/* "RUN1" -> "STBY" for a standby, "STBY" -> "RUN1" when it is over; any other word is left. */
+static void h713_mips_gate(struct h713_mips *m, bool standby)
+{
+	u32 from = standby ? H713_GATE_RUN1 : H713_GATE_STBY, now;
+
+	if (!m->gate)
+		return;
+	now = readl(m->gate);
+	if (now != from) {
+		if (standby)
+			dev_info(m->dev, "standby: gate word 0x%08x, not RUN1: left alone\n", now);
+		return;
+	}
+	writel(standby ? H713_GATE_STBY : H713_GATE_RUN1, m->gate);
+	if (standby)
+		dev_info(m->dev, "standby: a reset until the core runs again ends in the power gate (0x%08x)\n",
+			 readl(m->gate));
+	else
+		dev_info(m->dev, "standby over: a reset boots again (0x%08x)\n", readl(m->gate));
+}
+
 static int h713_mips_start(struct h713_mips *m, bool uboot)
 {
 	const char *how = uboot ? "U-Boot" : "vendor";
@@ -281,8 +318,11 @@ static int h713_mips_start(struct h713_mips *m, bool uboot)
 	ret = cpu_comm_firmware_start(H713_MIPS_READY_MS);
 	if (!ret)
 		m->state = H713_MIPS_RUNNING;
-	return h713_mips_say(m, ret, "%s start: status 0x%08x, %sready", how,
-			     readl(m->regs + H713_MIPS_STATUS), ret ? "NOT " : "");
+	h713_mips_say(m, ret, "%s start: status 0x%08x, %sready", how,
+		      readl(m->regs + H713_MIPS_STATUS), ret ? "NOT " : "");
+	if (!ret)
+		h713_mips_gate(m, false);
+	return ret;
 }
 
 static int h713_mips_restart(struct h713_mips *m, const char *path)
@@ -415,6 +455,33 @@ static void h713_mips_unown(void *ctx)
 			 h713_mips_state_name[m->state]);
 }
 
+/* Mark the standby; after it, only a parked core keeps the mark until its start. */
+static int h713_mips_pm(struct notifier_block *nb, unsigned long ev, void *unused)
+{
+	struct h713_mips *m = container_of(nb, struct h713_mips, pm_nb);
+
+	mutex_lock(&m->lock);
+	if (ev == PM_SUSPEND_PREPARE)
+		h713_mips_gate(m, true);
+	else if (ev == PM_POST_SUSPEND && m->state != H713_MIPS_PARKED)
+		h713_mips_gate(m, false);
+	mutex_unlock(&m->lock);
+	return NOTIFY_DONE;
+}
+
+/* A reboot asked for boots. No lock: a start that hangs must not hold the reboot. */
+static int h713_mips_reboot(struct notifier_block *nb, unsigned long action, void *unused)
+{
+	if (action == SYS_RESTART)
+		h713_mips_gate(container_of(nb, struct h713_mips, reboot_nb), false);
+	return NOTIFY_DONE;
+}
+
+static void h713_mips_unpm(void *ctx)
+{
+	unregister_pm_notifier(ctx);
+}
