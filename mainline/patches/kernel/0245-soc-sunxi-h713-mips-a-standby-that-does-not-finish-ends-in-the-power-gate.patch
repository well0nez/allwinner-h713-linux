 static int h713_mips_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -440,6 +507,11 @@ static int h713_mips_probe(struct platform_device *pdev)
 	m->tvtop = res && resource_size(res) >= 0xc ? devm_ioremap(dev, res->start, 0xc) : NULL;
 	if (!m->tvtop)
