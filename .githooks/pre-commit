#!/bin/sh
# Only the project's GitHub identity goes into commits. 05.10.2026: 19 commits carried the owner's
# private address, taken from a session's environment and noticed just before the push.
ok='well0nez@users.noreply.github.com'
for e in "$(git config user.email)" "${GIT_AUTHOR_EMAIL:-}" "${GIT_COMMITTER_EMAIL:-}"; do
	case "$e" in ''|"$ok"|*"+$ok") ;; *) echo "pre-commit: identity '$e' is not the project's noreply address -- set git config user.email (see AGENTS.md)" >&2; exit 1 ;; esac
done
