# Build output -- everything under mainline/build except the build scripts
mainline/build/*
!mainline/build/build.sh
!mainline/build/uboot-build.sh
!mainline/build/uboot-prove-fragments.sh
mainline/patches-snapshots/
# Kernel trees, rootfs staging and local scratch directly under mainline/
mainline/linux-*/
mainline/rootfs-build/
mainline/local/
# Installer / rootfs output and run logs
installer/out/
installer/logs/
installer/tmp/
installer/sunxi-fel
installer/u-boot-sunxi-with-spl.bin
rootfs/out/
rootfs/out.*/
# A personal WLAN file next to build-rootfs.sh (the public default lives in overlay/)
rootfs/wifi.env
# Cross-built binaries (release/build-all.sh)
userspace/h713-tv/h713-tv
userspace/h713-tv/*.aarch64-linux-gnu
userspace/h713-tv/*.aarch64-linux-gnu.*
userspace/h713-autofocus/h713-afmetric
userspace/h713-autofocus/*.aarch64-linux-gnu
userspace/h713-autofocus/*.aarch64-linux-gnu.*
# Out-of-tree kernel module build products (mainline/tools/rshim-demo, make ... M=)
mainline/tools/rshim-demo/.*
mainline/tools/rshim-demo/*.o
mainline/tools/rshim-demo/*.ko
mainline/tools/rshim-demo/*.mod
mainline/tools/rshim-demo/*.mod.c
mainline/tools/rshim-demo/Module.symvers
mainline/tools/rshim-demo/modules.order
# Never: images, dumps, keys, vendor blobs (release/sperr-scan.py enforces this before a push)
*.img
*.ext4
*.simg
*.fex
*.bundle
hy310-sicherung*/
h713-dump*/
re/
__pycache__/
*.pyc
*.orig
*.rej

# MemPalace per-project files (issue #185)
mempalace.yaml
entities.json

# Graphify-Ausgabe (lokaler Code-Graph, graphify extract --code-only)
graphify-out/
