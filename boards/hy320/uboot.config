# HY320 board fragment -- the record of what hy320_defconfig says about the board (boards/README.md).
#
# DRAM: DDR3 (type 3), 792 MHz. The 24 words of the vendor boot0 header at LBA 16 of the owner's own
# eMMC dump (31.10.2026), as in installer/h713/profiles/hy320.py ("dram"). The block is the HY350
# image's word for word.

CONFIG_DRAM_CLK=792
CONFIG_SUNXI_DRAM_H713_DDR3_STOCK=y
# not this board's: DX_ODT, DX_DRI and CA_DRI are not part of the 24-word boot0
# block. These are the values every H713 defconfig in the fork carries.
CONFIG_DRAM_SUNXI_DX_ODT=0x03030303
CONFIG_DRAM_SUNXI_DX_DRI=0x0e0e0e0e
CONFIG_DRAM_SUNXI_CA_DRI=0x1c12
CONFIG_DRAM_SUNXI_ODT_EN=0x1
CONFIG_DRAM_SUNXI_ZQ=0x007b7bfb
CONFIG_DRAM_SUNXI_PARA1=0x000010f4
# The boot0 at LBA 16 says para2 = 0x00000000, the copy at LBA 256 of the same
# eMMC says 0x04000000 - the value every working base in the fork runs.
CONFIG_DRAM_SUNXI_PARA2=0x04000000
CONFIG_DRAM_SUNXI_MR0=0x00001c70
CONFIG_DRAM_SUNXI_MR1=0x00000040
CONFIG_DRAM_SUNXI_MR2=0x00000018
CONFIG_DRAM_SUNXI_MR3=0x00000000
# tpr0..tpr2 are this board's own, but they do not reach the hardware on the
# DDR3 path: iw12_set_timing() computes the DDR3 timing registers from
# CONFIG_DRAM_CLK (arch/arm/mach-sunxi/dram_sun50iw12.c).
CONFIG_DRAM_SUNXI_TPR0=0x004a2195
CONFIG_DRAM_SUNXI_TPR1=0x02423190
CONFIG_DRAM_SUNXI_TPR2=0x0008b061
CONFIG_DRAM_SUNXI_TPR3=0xb4787896
CONFIG_DRAM_SUNXI_TPR4=0x00000000
CONFIG_DRAM_SUNXI_TPR5=0x48484848
CONFIG_DRAM_SUNXI_TPR6=0x00000048
CONFIG_DRAM_SUNXI_TPR7=0x1620121e
CONFIG_DRAM_SUNXI_TPR8=0x00000000
CONFIG_DRAM_SUNXI_TPR9=0x00000000
CONFIG_DRAM_SUNXI_TPR10=0x00000000
# per-board PHY tuning, this board's own (HY310, same clock: 0x44340000 / 0x00006666)
CONFIG_DRAM_SUNXI_TPR11=0x44440000
CONFIG_DRAM_SUNXI_TPR12=0x00005555
# The boot0 at LBA 16 says tpr13 = 0x34010100, the copy at LBA 256 says
# 0xb4016103 - again the value every working base in the fork runs.
CONFIG_DRAM_SUNXI_TPR13=0xb4016103

CONFIG_DEFAULT_DEVICE_TREE="allwinner/sun50i-h713-hy320"
CONFIG_IDENT_STRING=" HY320"
# The board's own panel row for project 0x30 (2200x1125, PLL n 47 as its stock U-Boot computes for
# 164 MHz) and its panel lines (PH16 pulsed, PH19/PH15 high, PF6 - its SD card detect - and PH8/PH9
# left alone, as its stock tvtop node names them): arch/arm/mach-sunxi/h713_mips.c
CONFIG_H713_BOARD_HY320=y
