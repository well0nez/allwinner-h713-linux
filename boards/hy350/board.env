# HY350 -- described from a stock OTA image, never run by anyone here.
# No image is ever built for this board: STATUS is not "verified" (doku/121 section 5).
BOARD_ID=hy350
STATUS=profile-only
VERIFIED_BY=
PROFILE=hy350
IMAGE_NAME=h713-hy350
# empty: we have no device tree for this board, so nothing may go into a FIT for it
KERNEL_DTB=
UBOOT_BOARD=hy350
