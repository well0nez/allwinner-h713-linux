# HY310 board fragment (silkscreen HY260_QZ713_V3.1).
#
# DRAM: DDR3, 1 GiB, 792 MHz. The values below are the ones that boot: they are
# the DRAM block of configs/hy310_qz713_v3_1_defconfig, the build behind
# v0.5-beta and 20/20 cold starts (analyse/boot/r5-20-kaltstarts-20260910.txt).
# Five of them differ from the board's own boot0 header as the installer profile
# records it (installer/h713/profiles/hy310.py, "dram", read from
# boot0_sdcard.fex+0x38 of update.img) -- each difference is marked below.

CONFIG_DRAM_CLK=792
CONFIG_SUNXI_DRAM_H713_DDR3_STOCK=y
CONFIG_DRAM_SUNXI_DX_ODT=0x03030303
CONFIG_DRAM_SUNXI_DX_DRI=0x0e0e0e0e
CONFIG_DRAM_SUNXI_CA_DRI=0x1c12
CONFIG_DRAM_SUNXI_ODT_EN=0x1
CONFIG_DRAM_SUNXI_ZQ=0x007b7bfb
CONFIG_DRAM_SUNXI_PARA1=0x000010f4
# not this board's boot0 value: the image AND the device's own boot0 say
# 0x00000000 (installer/h713/profiles/hy310.py "dram"). 0x04000000 is the
# defconfig value the shipped build boots with -- 20/20 cold starts -- and why
# the two differ is not written down anywhere (doku/10, correction of 14.09.).
CONFIG_DRAM_SUNXI_PARA2=0x04000000
CONFIG_DRAM_SUNXI_MR0=0x00001c70
CONFIG_DRAM_SUNXI_MR1=0x00000040
CONFIG_DRAM_SUNXI_MR2=0x00000018
CONFIG_DRAM_SUNXI_MR3=0x00000000
# not this board's boot0 values: tpr0..tpr2 here are the HY200 bench board's
# (0x4a2195 / 0x2423190 / 0x8b061 on the HY310). They never reach the hardware
# on the DDR3 path -- iw12_set_timing() computes the DDR3 timing registers from
# CONFIG_DRAM_CLK and does not read tpr0..tpr2, mr0 or mr2
# (arch/arm/mach-sunxi/dram_sun50iw12.c). Kept as they are in the config that
# shipped, so the fragment reproduces the released binary bit for bit.
CONFIG_DRAM_SUNXI_TPR0=0x00482151
CONFIG_DRAM_SUNXI_TPR1=0x01b1a94c
CONFIG_DRAM_SUNXI_TPR2=0x0006e04d
CONFIG_DRAM_SUNXI_TPR3=0xb4787896
CONFIG_DRAM_SUNXI_TPR4=0x00000000
CONFIG_DRAM_SUNXI_TPR5=0x48484848
CONFIG_DRAM_SUNXI_TPR6=0x00000048
CONFIG_DRAM_SUNXI_TPR7=0x1620121e
CONFIG_DRAM_SUNXI_TPR8=0x00000000
CONFIG_DRAM_SUNXI_TPR9=0x00000000
CONFIG_DRAM_SUNXI_TPR10=0x00000000
# per-board PHY tuning, this board's own (HY200 bench: 0x44340000 too, HY350: 0x44440000)
CONFIG_DRAM_SUNXI_TPR11=0x44340000
CONFIG_DRAM_SUNXI_TPR12=0x00006666
# not this board's boot0 value: the image and the device's boot0 say 0x34010100;
# the value below is the defconfig's, and it boots (see para2 above).
CONFIG_DRAM_SUNXI_TPR13=0xb4016103

CONFIG_DEFAULT_DEVICE_TREE="allwinner/sun50i-h713-hy310"
CONFIG_IDENT_STRING=" HY310 (HY260_QZ713_V3.1)"
