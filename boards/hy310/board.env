# HY310 -- the board this repository is built and tested on.
# Silkscreen HY260_QZ713_V3.1; DDR3 at 792 MHz, 1 GiB (docs/hardware.md).
BOARD_ID=hy310
STATUS=verified
VERIFIED_BY="well0nez, HY310, v0.9-beta, 22.09.2026"
PROFILE=hy310
IMAGE_NAME=h713-hy310
KERNEL_DTB=sun50i-h713-hy310
UBOOT_BOARD=hy310
# KERNEL_DEFCONFIG / UBOOT_DEFCONFIG are not set: the kernel defconfig comes from
# mainline/config/versions.env (shared with the HY200 boards) and the U-Boot base
# defconfig is hy310_defconfig, derived from UBOOT_BOARD.
# Optional hardware (boards/README.md, FEATURES), all three measured on this board: the
# focus motor (bound, raw=1 act=1) and the camera (uvcvideo, YUYV 640x480) on 12.09.2026
# (analyse/boot/abnahme-v08-20260912.txt), the SC7A20 accelerometer by its three-pose
# measurement on 22.09.2026 (docs/tools/h713-keystone.md).
FEATURES="camera accelerometer focus-motor"
