# HY310 -- the board this repository is built and tested on.
# Silkscreen HY260_QZ713_V3.1; DDR3 at 792 MHz, 1 GiB (docs/hardware.md).
BOARD_ID=hy310
STATUS=verified
VERIFIED_BY="well0nez, HY310, v0.8-beta, 16.09.2026"
PROFILE=hy310
IMAGE_NAME=h713-hy310
KERNEL_DTB=sun50i-h713-hy310
UBOOT_BOARD=hy310
# KERNEL_DEFCONFIG / UBOOT_DEFCONFIG are not set: the kernel defconfig comes from
# mainline/config/versions.env (shared with the HY200 boards) and the U-Boot base
# defconfig is hy310_defconfig, derived from UBOOT_BOARD.
