# HY300 Pro board fragment. Probe builds only -- we have never held this board.
#
# Only three values below are this board's own. They come from the UART log in
# issue #1 (13.09.2026), lines 127-133, as recorded in
# installer/h713/profiles/hy300_pro.py ("dram"): DRAM CLK = 636 MHz, Type = 3
# (DDR3), ZQ = 0x7b7bfb, SIZE = 1024 M. No boot0 dump of this device was ever
# posted, so the other 21 words are borrowed -- see the block comment below.

CONFIG_DRAM_CLK=636
CONFIG_SUNXI_DRAM_H713_DDR3_STOCK=y
CONFIG_DRAM_SUNXI_ZQ=0x007b7bfb

# ---------------------------------------------------------------------------
# not this board's: everything from here to CONFIG_DRAM_SUNXI_TPR13 is the
# shared H713 DDR3 value set of the HY200 bench board and the HY310 -- the same
# set configs/h713_probe_defconfig runs an unknown board with. It is a starting
# value, not a measurement. What makes it defensible rather than a guess: the
# owner ran our HY310 installer U-Boot (this set, at 792 MHz) over FEL on his
# device, the SPL trained and `ums` served the eMMC for 17 minutes under load
# (issue #1, section "what went right"). That proves "enough for a dump",
# not "stable in operation" -- and it says nothing about tpr11/tpr12, per-board
# PHY tuning that cannot be derived from anything (docs/tools/h713-probe.md).
# Replace the whole block from this board's own boot0 header, which one
# h713_probe log prints.
# ---------------------------------------------------------------------------
CONFIG_DRAM_SUNXI_DX_ODT=0x03030303
CONFIG_DRAM_SUNXI_DX_DRI=0x0e0e0e0e
CONFIG_DRAM_SUNXI_CA_DRI=0x1c12
CONFIG_DRAM_SUNXI_ODT_EN=0x1
CONFIG_DRAM_SUNXI_PARA1=0x000010f4
CONFIG_DRAM_SUNXI_PARA2=0x04000000
CONFIG_DRAM_SUNXI_MR0=0x00001c70
CONFIG_DRAM_SUNXI_MR1=0x00000040
CONFIG_DRAM_SUNXI_MR2=0x00000018
CONFIG_DRAM_SUNXI_MR3=0x00000000
CONFIG_DRAM_SUNXI_TPR0=0x00482151
CONFIG_DRAM_SUNXI_TPR1=0x01b1a94c
CONFIG_DRAM_SUNXI_TPR2=0x0006e04d
CONFIG_DRAM_SUNXI_TPR3=0xb4787896
CONFIG_DRAM_SUNXI_TPR4=0x00000000
CONFIG_DRAM_SUNXI_TPR5=0x48484848
CONFIG_DRAM_SUNXI_TPR6=0x00000048
CONFIG_DRAM_SUNXI_TPR7=0x1620121e
CONFIG_DRAM_SUNXI_TPR8=0x00000000
CONFIG_DRAM_SUNXI_TPR9=0x00000000
CONFIG_DRAM_SUNXI_TPR10=0x00000000
CONFIG_DRAM_SUNXI_TPR11=0x44340000
CONFIG_DRAM_SUNXI_TPR12=0x00006666
CONFIG_DRAM_SUNXI_TPR13=0xb4016103

# not this board's: we have no DTS for the HY300 Pro. A probe build never drives
# the panel, and no release is built from this fragment (STATUS=partial).
CONFIG_DEFAULT_DEVICE_TREE="allwinner/sun50i-h713-hy200-qz713df-a1"
CONFIG_IDENT_STRING=" HY300 Pro (probe, untested board)"
