# Variant ota20240419 of boards/hy300-t08: the stock OTA image HY300_T08_OTA_2024-04-19-2028.img (U-Boot
# 2024-04-15, ARISC 2024-04-19). No unit with this boot package has been seen; everything comes from the image
# (installer profile, J). Read after ../../board.env; a key here wins.
VARIANT=ota20240419
# nobody has run our firmware on a unit with this firmware: TEST images only
STATUS=profile-only
VERIFIED_BY=
IMAGE_NAME=h713-hy300-t08-ota20240419
# the clock of this firmware's boot0 (boot0_sdcard.fex)
DRAM_CLK=640
