# Variant fw20250221 of boards/hy300-t08: the second owner's unit (issue #10, GitHub `tgiorgio`, 05.11.2026):
# boot package of 2023-08 (U-Boot 2023-08-08, ARISC 2023-08-12, its own device tree e0ee997e...) under a
# 2025-02-21 Android 11 userland (32-bit); display data and DRAM block are the OTA's; the eMMC has
# 14 942 208 sectors (T22708), so the image's GPT copy and root file system are cut for that size.
# Read after ../../board.env; a key here wins.
VARIANT=fw20250221
# nothing of ours has booted on it: TEST images only. Our T08 installer U-Boot trained its DRAM over FEL (his
# report). The owner has the stock IR remote (kernel 0329 carries its map), ADB and a dd of the whole eMMC.
STATUS=profile-only
VERIFIED_BY=
IMAGE_NAME=h713-hy300-t08-fw20250221
# the clock of his boot0 at LBA 16 (the OTA's block)
DRAM_CLK=640
