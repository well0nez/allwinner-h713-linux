# Variant projector09220931 of boards/hy200-qz713df-a1: the "HY300 Pro+" (2025, DDR3), stock
# Android 11 of 2025-09-22. No unit of ours: everything comes from the update.img in the firmware
# archive (installer profile, J). Read after ../../board.env; a key here wins.
VARIANT=projector09220931
# nobody has run our firmware on a unit with this firmware: TEST images only
STATUS=profile-only
VERIFIED_BY=
IMAGE_NAME=h713-hy200-qz713df-a1-projector09220931
# the clock of this firmware's boot0 (boot0_sdcard.fex), and cstenger's on his bench
DRAM_CLK=624
# FEATURES: the board's, none confirmed. This firmware's stock tree drives a focus motor (motor_ctr
# okay, the HY310's step tables) that the board's tree leaves off; no sensor or camera measured.
# the name in the network (TODO 5.18, the owner 11.10.2026: the name on the box)
HOSTNAME_BOARD=hy300proplus
