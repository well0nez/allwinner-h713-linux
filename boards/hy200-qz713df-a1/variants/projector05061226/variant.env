# Variant projector05061226 of boards/hy200-qz713df-a1: the HY300PRO-G-EU, stock Android 11 of
# 2025-05-06, the maintainer's own unit (doku/136). Read after ../../board.env; a key here wins.
VARIANT=projector05061226
# A TEST image of ours booted on it (doku/136), no green report yet: TEST images only.
STATUS=profile-only
VERIFIED_BY=
IMAGE_NAME=h713-hy200-qz713df-a1-projector05061226
# the clock of this firmware's boot0 (its own eMMC, LBA 16), and the one our TEST image booted at
DRAM_CLK=792
# measured on this unit (doku/136 section 1): the SC7A20 at 0x18 answers as an IIO device. No
# camera (no capture device), no focus motor (owner; its stock tree's motor_ctr is disabled).
FEATURES=accelerometer
