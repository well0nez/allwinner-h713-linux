# HY200 QZ713DF_A1 -- cstenger's bench board, the board the mainline port was brought up on.
# Old name of this board: BOARD=ddr3, still accepted by build/build.sh as an alias.
BOARD_ID=hy200-qz713df-a1
STATUS=verified
VERIFIED_BY="cstenger, HY200 QZ713DF_A1 bench board (mainline/README.md; kernel 6.18.38 boot-good, config/versions.env)"
# empty: there is no installer profile for this board -- no stock image of it was ever
# analysed here, so no release image can be built for it even though it is verified.
PROFILE=
IMAGE_NAME=h713-hy200-qz713df-a1
KERNEL_DTB=sun50i-h713-hy200-qz713df-a1
UBOOT_BOARD=hy200-qz713df-a1
# as today: both defconfigs are the ones config/versions.env names for BOARD=ddr3.
KERNEL_DEFCONFIG=hy200_qz713df_a1_defconfig
UBOOT_DEFCONFIG=hy200_qz713df_a1_defconfig
