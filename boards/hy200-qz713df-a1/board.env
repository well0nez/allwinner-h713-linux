# HY200 QZ713DF_A1 -- cstenger's bench board, the board the mainline port was brought up on.
# Old name of this board: BOARD=ddr3, still accepted by build/build.sh as an alias.
BOARD_ID=hy200-qz713df-a1
# STATUS is about OUR firmware on this board, and nobody has run that. What cstenger verified is
# his own kernel tree on his own bench board: mainline/README.md, "All FEL/bring-up runs on this
# one"; config/versions.env records Linux 6.18.38 as boot-good on HY200 QZ713DF_A1. That is his
# run, not ours, so VERIFIED_BY stays empty and this board gets no image (doku/121 section 5).
STATUS=profile-only
VERIFIED_BY=
# The stock image of this board was analysed in package F1: the 2025-09-22 "HY300 Pro+" DDR3 image
# carries this board's DRAM block (624 MHz, type 3, tpr11/12 0x44340000/0x6666) and the display.bin
# h713_mips_fw_revs[] already lists under "HY200 QZ713DF_A1".
PROFILE=hy200_qz713df_a1
IMAGE_NAME=h713-hy200-qz713df-a1
KERNEL_DTB=sun50i-h713-hy200-qz713df-a1
UBOOT_BOARD=hy200-qz713df-a1
# as today: both defconfigs are the ones config/versions.env names for BOARD=ddr3.
KERNEL_DEFCONFIG=hy200_qz713df_a1_defconfig
UBOOT_DEFCONFIG=hy200_qz713df_a1_defconfig
