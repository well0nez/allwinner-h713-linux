# HY200 QZ713DF A1 board fragment -- what configs/hy200_qz713df_a1_defconfig says about the board.
#
# DRAM: DDR3. The words are those of both stock firmwares of the board: the HY300PRO-G-EU's own
# boot0 at LBA 16 (identify row of 2026-10-02) and boot0_sdcard.fex of the 2025-09-22 update.img,
# equal word for word except the clock and the para2/tpr13 pair the flashing tool patches; the
# patched pair below was read off the running HY300PRO-G-EU and cstenger's running bench alike.
# tpr0..tpr2 are both firmwares' (cstenger's old defconfig carried others); the DDR3 path of
# dram_sun50iw12.c never reads them.
#
# The clock is the firmware's, not the board's: 792 MHz in the 2025-05 boot0, 624 MHz in the
# 2025-09 one. Each variant names its own (variants/<name>/variant.env, DRAM_CLK) and
# build/uboot-build.sh merges it over the base. The base runs 624, so a build that names no
# variant gets the lower clock, never the higher (README.md, "The DRAM clock").

CONFIG_DRAM_CLK=624
CONFIG_SUNXI_DRAM_H713_DDR3_STOCK=y
# not this board's: DX_ODT/DX_DRI/CA_DRI are not among the 24 boot0 words. These are the
# values every H713 defconfig carries; dram_sun50iw12.c does not read them.
CONFIG_DRAM_SUNXI_DX_ODT=0x03030303
CONFIG_DRAM_SUNXI_DX_DRI=0x0e0e0e0e
CONFIG_DRAM_SUNXI_CA_DRI=0x1c12
CONFIG_DRAM_SUNXI_ODT_EN=0x1
CONFIG_DRAM_SUNXI_ZQ=0x007b7bfb
CONFIG_DRAM_SUNXI_PARA1=0x000010f4
CONFIG_DRAM_SUNXI_PARA2=0x04000000
CONFIG_DRAM_SUNXI_MR0=0x00001c70
CONFIG_DRAM_SUNXI_MR1=0x00000040
CONFIG_DRAM_SUNXI_MR2=0x00000018
CONFIG_DRAM_SUNXI_MR3=0x00000000
CONFIG_DRAM_SUNXI_TPR0=0x004a2195
CONFIG_DRAM_SUNXI_TPR1=0x02423190
CONFIG_DRAM_SUNXI_TPR2=0x0008b061
CONFIG_DRAM_SUNXI_TPR3=0xb4787896
CONFIG_DRAM_SUNXI_TPR4=0x00000000
CONFIG_DRAM_SUNXI_TPR5=0x48484848
CONFIG_DRAM_SUNXI_TPR6=0x00000048
CONFIG_DRAM_SUNXI_TPR7=0x1620121e
CONFIG_DRAM_SUNXI_TPR8=0x00000000
CONFIG_DRAM_SUNXI_TPR9=0x00000000
CONFIG_DRAM_SUNXI_TPR10=0x00000000
CONFIG_DRAM_SUNXI_TPR11=0x44340000
CONFIG_DRAM_SUNXI_TPR12=0x00006666
CONFIG_DRAM_SUNXI_TPR13=0xb4016103

# the U-Boot base tree that sun50i-h713-hy310.dts includes, under the board's own name
CONFIG_DEFAULT_DEVICE_TREE="allwinner/sun50i-h713-hy200-qz713df-a1"
CONFIG_IDENT_STRING=" HY200 QZ713DF A1"
