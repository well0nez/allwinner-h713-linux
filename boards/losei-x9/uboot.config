# LOSEI X9 board fragment. Probe builds only -- no release is built from it (STATUS=partial).
#
# DRAM: DDR3 (type 3), 744 MHz. The values are the 24 words of the vendor boot0 header at
# LBA 16 + 0x38, read off the device by h713_probe over FEL and printed a second time by
# h713-install identify from the owner's dump -- both agree (issue #3, 25.10.2026).
#
# para2 = 0 and tpr13 = 0x34010100 are what his eMMC carries, and bit for bit the HY300 T08
# image's unpatched pair. Our SPL reads bits of both that differ from the pair it has trained
# memory with (0x04000000 / 0xb4016103), so they are this board's words but not yet a form our
# SPL is known to run: the probe build for this board keeps the proven pair and changes the clock
# alone (h713_probe_x9_defconfig in the U-Boot fork).
#
# His probe log shows the SPL training this RAM at the probe's 624 MHz with the probe's own DRAM
# set, and U-Boot coming up with 1 GiB -- a working DRAM init, not a measurement of this fragment
# (TODO 4.13).

CONFIG_DRAM_CLK=744
CONFIG_SUNXI_DRAM_H713_DDR3_STOCK=y
# not this board's: DX_ODT, DX_DRI and CA_DRI are not part of the 24-word boot0 block. These are
# the values every H713 defconfig in the fork carries.
CONFIG_DRAM_SUNXI_DX_ODT=0x03030303
CONFIG_DRAM_SUNXI_DX_DRI=0x0e0e0e0e
CONFIG_DRAM_SUNXI_CA_DRI=0x1c12
CONFIG_DRAM_SUNXI_ODT_EN=0x1
CONFIG_DRAM_SUNXI_ZQ=0x007b7bfb
CONFIG_DRAM_SUNXI_PARA1=0x000010f4
CONFIG_DRAM_SUNXI_PARA2=0x00000000
CONFIG_DRAM_SUNXI_MR0=0x00001c70
CONFIG_DRAM_SUNXI_MR1=0x00000040
CONFIG_DRAM_SUNXI_MR2=0x00000018
CONFIG_DRAM_SUNXI_MR3=0x00000000
# tpr0..tpr2 are this board's own, but they do not reach the hardware on the DDR3 path:
# iw12_set_timing() computes the DDR3 timing registers from CONFIG_DRAM_CLK
# (arch/arm/mach-sunxi/dram_sun50iw12.c).
CONFIG_DRAM_SUNXI_TPR0=0x004a2195
CONFIG_DRAM_SUNXI_TPR1=0x02423190
CONFIG_DRAM_SUNXI_TPR2=0x0008b061
CONFIG_DRAM_SUNXI_TPR3=0xb4787896
CONFIG_DRAM_SUNXI_TPR4=0x00000000
CONFIG_DRAM_SUNXI_TPR5=0x48484848
CONFIG_DRAM_SUNXI_TPR6=0x00000048
CONFIG_DRAM_SUNXI_TPR7=0x1620121e
CONFIG_DRAM_SUNXI_TPR8=0x00000000
CONFIG_DRAM_SUNXI_TPR9=0x00000000
CONFIG_DRAM_SUNXI_TPR10=0x00000000
# per-board PHY tuning, this board's own -- the same pair the HY310 carries, while the HY300 T08
# image has 0x44440000 / 0x00005555
CONFIG_DRAM_SUNXI_TPR11=0x44340000
CONFIG_DRAM_SUNXI_TPR12=0x00006666
CONFIG_DRAM_SUNXI_TPR13=0x34010100

# not this board's: we have no DTS for the LOSEI X9, and its pin map is not the HY200's (fan PB4,
# lamp enable PB6). A probe build never drives the panel, the fan or the lamp.
CONFIG_DEFAULT_DEVICE_TREE="allwinner/sun50i-h713-hy200-qz713df-a1"
CONFIG_IDENT_STRING=" LOSEI X9 (probe, untested board)"
