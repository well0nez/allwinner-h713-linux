# LOSEI X9 -- the board of issue #3 (owner GitHub cosmonet-fr, 25.10.2026). PCB MTL-H713-Z10-V1.0,
# sold on Amazon EU. No stock image and no dump here; everything comes from what its owner posted
# (his h713-install identify row, his h713-extract report, his read-only h713_probe log over FEL).
# STATUS=partial because the description has holes, not because a run failed: see README.md.
BOARD_ID=losei-x9
STATUS=partial
VERIFIED_BY=
PROFILE=losei_x9
IMAGE_NAME=h713-losei-x9
# empty: we have no device tree for this board, so nothing may go into a FIT for it. Its pin map
# differs from every tree we have (fan on PB4, lamp enable on PB6) -- README.md section 3.
KERNEL_DTB=
UBOOT_BOARD=losei-x9
