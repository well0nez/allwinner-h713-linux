# HY200 QZ713_V2 board fragment (cstenger's "projector" board, old name: BOARD=lpddr3).
#
# DRAM: LPDDR3, 1 GiB, 720 MHz. Every line is taken verbatim from cstenger's
# configs/hy200_qz713_v2_defconfig in the U-Boot fork; his comment there says the
# values are that board's stock BT0 (clk=720, type=7, zq=0x003f3ffb, odt/flags
# 0x31, para1=0x10f410f4, para2=0x04000000). Nothing is borrowed here -- but
# nothing has been booted either: docs/hardware.md records the LPDDR3
# attribution as assumed and never verified on hardware.
#
# This is the one H713 board on the LPDDR3 path, where the packed timing words
# matter: iw12_set_timing() uses tpr0..tpr2 (and requires tpr13 bit 1) for
# LPDDR3, while the DDR3 boards compute their timings from the clock
# (arch/arm/mach-sunxi/dram_sun50iw12.c).

CONFIG_DRAM_CLK=720
CONFIG_SUNXI_DRAM_H713_LPDDR3_STOCK=y
CONFIG_DRAM_SUNXI_DX_ODT=0x03030303
CONFIG_DRAM_SUNXI_DX_DRI=0x0e0e0e0e
CONFIG_DRAM_SUNXI_CA_DRI=0x1c12
CONFIG_DRAM_SUNXI_ODT_EN=0x31
CONFIG_DRAM_SUNXI_ZQ=0x003f3ffb
CONFIG_DRAM_SUNXI_PARA1=0x10f410f4
CONFIG_DRAM_SUNXI_PARA2=0x04000000
CONFIG_DRAM_SUNXI_MR0=0x00000000
CONFIG_DRAM_SUNXI_MR1=0x000000c3
CONFIG_DRAM_SUNXI_MR2=0x0000000a
CONFIG_DRAM_SUNXI_MR3=0x00000002
CONFIG_DRAM_SUNXI_TPR0=0x0049225a
CONFIG_DRAM_SUNXI_TPR1=0x01b1b1d0
CONFIG_DRAM_SUNXI_TPR2=0x0004c02c
CONFIG_DRAM_SUNXI_TPR3=0xb4787896
CONFIG_DRAM_SUNXI_TPR4=0x00000000
CONFIG_DRAM_SUNXI_TPR5=0x48484848
CONFIG_DRAM_SUNXI_TPR6=0x00000048
CONFIG_DRAM_SUNXI_TPR7=0x1621121e
CONFIG_DRAM_SUNXI_TPR8=0x00000000
CONFIG_DRAM_SUNXI_TPR9=0x00000000
CONFIG_DRAM_SUNXI_TPR10=0x00007767
CONFIG_DRAM_SUNXI_TPR11=0x44650000
CONFIG_DRAM_SUNXI_TPR12=0x00005544
CONFIG_DRAM_SUNXI_TPR13=0xb4036223

CONFIG_DEFAULT_DEVICE_TREE="allwinner/sun50i-h713-hy200-qz713-v2"
CONFIG_IDENT_STRING=" HY200 QZ713_V2 (untested)"
