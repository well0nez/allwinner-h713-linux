# HY200 QZ713_V2 -- the "projector" board of cstenger's tree. Described by his defconfig,
# never booted by anyone here; mainline/README.md and config/versions.env both mark it
# untested on hardware, so STATUS stays below "verified" and no image is built for it.
# Old name of this board: BOARD=lpddr3, still accepted by build/build.sh as an alias.
BOARD_ID=hy200-qz713-v2
STATUS=profile-only
VERIFIED_BY=
# The stock image of this board was analysed in package F1: the 2025-07-10 "HY300 Pro+" LPDDR3
# image carries this board's DRAM block (720 MHz, type 7, tpr11/12 0x44650000/0x5544).
PROFILE=hy200_qz713_v2
IMAGE_NAME=h713-hy200-qz713-v2
KERNEL_DTB=sun50i-h713-hy200-qz713-v2
UBOOT_BOARD=hy200-qz713-v2
# as today: both defconfigs are the ones config/versions.env names for BOARD=lpddr3
# (the kernel defconfig is shared -- there is no separate one for this board).
KERNEL_DEFCONFIG=hy200_qz713df_a1_defconfig
UBOOT_DEFCONFIG=hy200_qz713_v2_defconfig
