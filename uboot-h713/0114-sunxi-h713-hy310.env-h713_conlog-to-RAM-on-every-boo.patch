From de89fe8a04d5c8fa6d2253cb28190893790b5991 Mon Sep 17 00:00:00 2001
From: minpeter <62207008+minpeter@users.noreply.github.com>
Date: Thu, 5 Nov 2026 13:26:08 +0900
Subject: [PATCH 114/115] sunxi: h713: hy310.env - h713_conlog to RAM on every
 boot, to the eMMC only with h713_conlog_emmc=1

A normal boot no longer writes the console record to the tail of
hy310-uboot; set h713_conlog_emmc=1 by hand to keep it there for Linux.

Co-authored-by: sisyphus-dev-ai <sisyphus-dev-ai@users.noreply.github.com>
---
 board/sunxi/hy310.env | 16 ++++++++++------
 1 file changed, 10 insertions(+), 6 deletions(-)

diff --git a/board/sunxi/hy310.env b/board/sunxi/hy310.env
index 3fe671554c2..ad4ee569669 100644
--- a/board/sunxi/hy310.env
+++ b/board/sunxi/hy310.env
@@ -61,10 +61,12 @@ boot_net=
 	tftpboot 0x60000000 ${serverip}:${bootfile};
 	bootm 0x60000000
 /* A board whose base records U-Boot's console (CONFIG_CONSOLE_RECORD, the
- * HY320's: no UART) leaves every boot's record in the unused tail of
- * hy310-uboot, LBA 10240..11263, for Linux to read (h713_conlog,
- * boards/hy320/README.md in the h713 repository) - after the display init, so
- * that the record has its lines, whichever stack it chose. */
+ * HY320's: no UART) copies every boot's record to RAM at 0x45000000
+ * (h713_conlog, boards/hy320/README.md in the h713 repository) - after the
+ * display init, so that the record has its lines, whichever stack it chose.
+ * Only with h713_conlog_emmc=1, set by hand, is the record also written to
+ * the unused tail of hy310-uboot, LBA 10240..11263, for Linux to read: a
+ * normal boot writes nothing to the eMMC. */
 bootcmd=
 	if test "${h713_display}" = clean; then
 		h713_disp init ${h713_project} noboot logo;
@@ -75,8 +77,10 @@ bootcmd=
 	fi;
 #ifdef CONFIG_CONSOLE_RECORD
 	h713_conlog 0x45000000;
-	mmc dev 1;
-	mmc write 0x45000000 0x2800 0x400;
+	if test "${h713_conlog_emmc}" = 1; then
+		mmc dev 1;
+		mmc write 0x45000000 0x2800 0x400;
+	fi;
 #endif
 	run boot_${h713_boot};
 	run boot_net
