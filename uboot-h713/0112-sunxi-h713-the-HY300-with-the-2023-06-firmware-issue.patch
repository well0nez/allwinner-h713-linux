From 212454b3952fda8054ba6cbfcc315434429b0e9e Mon Sep 17 00:00:00 2001
From: well0nez <8986239+well0nez@users.noreply.github.com>
Date: Thu, 5 Nov 2026 14:11:49 +0100
Subject: [PATCH 112/112] sunxi: h713: the HY300 with the 2023-06 firmware
 (issue #8) - its display.bin row, board base defconfig and device tree

A sixth display.bin revision, read off the owner's partition files by h713-extract: size 0x131a10, digest 1e3e518f..., the HDCP wait site at 0x4b13cf00 found by the search; the four firmware addresses stay zero, as the documented meaning of zero allows. hy300_2023_defconfig is hy300_pro_defconfig with the HY350 family's DRAM block at 792 MHz (the owner's boot0, read on his device), its device tree name and its identification string; the tree includes the bench board's. No shared file changes its meaning for another board: the row is one more entry in the table, the rest are new files. Nobody here has the board; a TEST image over FEL for its owner is the only build.

Co-Authored-By: Claude Mythos 5.1 <noreply@anthropic.com>
---
 arch/arm/mach-sunxi/h713_mips.c               | 29 ++++++
 configs/hy300_2023_defconfig                  | 91 +++++++++++++++++++
 .../allwinner/sun50i-h713-hy300-2023.dts      | 27 ++++++
 3 files changed, 147 insertions(+)
 create mode 100644 configs/hy300_2023_defconfig
 create mode 100644 dts/upstream/src/arm64/allwinner/sun50i-h713-hy300-2023.dts

diff --git a/arch/arm/mach-sunxi/h713_mips.c b/arch/arm/mach-sunxi/h713_mips.c
index cb9978bfc88..c8b56685fad 100644
--- a/arch/arm/mach-sunxi/h713_mips.c
+++ b/arch/arm/mach-sunxi/h713_mips.c
@@ -716,6 +716,35 @@ static const struct h713_mips_fw_rev h713_mips_fw_revs[] = {
 			0xc7, 0x3f, 0x1f, 0xad, 0x81, 0xe8, 0x0c, 0x2c,
 		},
 	},
+	{
+		/*
+		 * The MagCubic HY300 of issue #8 (the classic case, 720p, project
+		 * 0x34) on the oldest ADT-3 firmware reported so far: U-Boot and
+		 * ARISC of 2023-06-25. Its display.bin is 272 bytes short of the
+		 * "ADT-3 2024" image and 256 short of the LOSEI X9's; none of the
+		 * other rows' digests match it. Read off the owner's partition
+		 * files by h713-extract (04.11.2026): size, digest, and the wait
+		 * site found by the same search this code runs (file offset
+		 * 0x3cf00). The four firmware addresses stay zero: they come from
+		 * a disassembly of the image or a device run, and this board had
+		 * neither. The readers of these fields refuse while they are
+		 * zero, which is the documented meaning of zero here.
+		 *
+		 * The name is the firmware's date, not a board's: the owner
+		 * cannot open the unit, the silkscreen is unknown.
+		 */
+		.board = "ADT-3 2023-06",
+		.size = 0x131a10,
+		.hdcp_wait_va = 0x4b13cf00,
+		.cpuid_va = 0, .comm_dev_ptr = 0,
+		.elog_ring = 0, .elog_wr = 0,
+		.digest = {
+			0x1e, 0x3e, 0x51, 0x8f, 0xe0, 0xa6, 0xa2, 0x50,
+			0xa0, 0x01, 0x1f, 0x2d, 0xd6, 0x06, 0xcc, 0x14,
+			0x5d, 0x01, 0x50, 0xb5, 0x0f, 0xc8, 0x43, 0xc5,
+			0x87, 0x03, 0x1e, 0x3a, 0x82, 0xaf, 0x0e, 0x34,
+		},
+	},
 };
 
 /* Set by h713_mips_verify() once the image is identified. */
diff --git a/configs/hy300_2023_defconfig b/configs/hy300_2023_defconfig
new file mode 100644
index 00000000000..98db8c18c29
--- /dev/null
+++ b/configs/hy300_2023_defconfig
@@ -0,0 +1,91 @@
+# HY300 (2023 firmware) -- board base. Reported in issue #8 of well0nez/allwinner-h713-linux
+# by its owner (GitHub `erfrizzera`); nobody here has ever held this board, and its owner
+# cannot open it, so the silkscreen is unknown and the board is named after its firmware.
+#
+# Same shape as hy300_pro_defconfig: this file says what the hardware is, a role fragment
+# in configs/fragments/ says what a build is for, and build/uboot-build.sh merges the two
+# (docs/uboot/README.md, "Which defconfig"). Everything outside the DRAM block, the device
+# tree name and the identification string is the HY310 base, unchanged.
+#
+# **No image is shipped for this board.** It is below `verified`; a TEST image for its
+# owner is the only build (boards/hy300-2023, doku/121 section 5).
+#
+# DRAM: DDR3 (type 3), 792 MHz. The 24 words of the owner's vendor boot0 at LBA 16, read
+# by h713-install identify on his device (02.11.2026; LBA 256 carries the same block), as
+# recorded in installer/h713/profiles/hy300_2023.py ("dram") and boards/hy300-2023/uboot.config.
+#   - It is the HY350 profile's block word for word: tpr0..tpr2 0x004a2195 / 0x02423190 /
+#     0x0008b061, tpr11/tpr12 0x44440000 / 0x00005555 (not the HY300 Pro's 0x482151 /
+#     0x1b1a94d / 0x7004e at 636 MHz).
+#   - para2 0x04000000 and tpr13 0xb4016103 are the pair the flashing tool writes; here they
+#     are read off the device, so they are this unit's own.
+#   - CONFIG_DRAM_CLK=792 is his boot0's clock. Measured by the owner: our HY300 Pro U-Boot
+#     (636 MHz, the HY300 Pro's block) trained this DRAM for UMS and a full partition dump
+#     (04.11.2026). Not measured: this block from our SPL.
+#
+# Panel: project 0x34, 1280x720 (identify; the timings are not posted). The display firmware
+# is a revision of its own, row "ADT-3 2023-06" in h713_mips.c (the four firmware addresses
+# at zero). The lamp's PWM words are the HY300 Pro's.
+CONFIG_ARM=y
+CONFIG_ARCH_SUNXI=y
+CONFIG_DEFAULT_DEVICE_TREE="allwinner/sun50i-h713-hy300-2023"
+CONFIG_DRAM_CLK=792
+CONFIG_SPL=y
+CONFIG_IDENT_STRING=" HY300 2023"
+CONFIG_DRAM_SUNXI_DX_ODT=0x03030303
+CONFIG_DRAM_SUNXI_DX_DRI=0x0e0e0e0e
+CONFIG_DRAM_SUNXI_CA_DRI=0x1c12
+CONFIG_DRAM_SUNXI_ODT_EN=0x1
+CONFIG_DRAM_SUNXI_ZQ=0x007b7bfb
+CONFIG_DRAM_SUNXI_PARA1=0x000010f4
+CONFIG_DRAM_SUNXI_PARA2=0x04000000
+CONFIG_DRAM_SUNXI_MR0=0x00001c70
+CONFIG_DRAM_SUNXI_MR1=0x00000040
+CONFIG_DRAM_SUNXI_MR2=0x00000018
+CONFIG_DRAM_SUNXI_MR3=0x00000000
+CONFIG_DRAM_SUNXI_TPR0=0x004a2195
+CONFIG_DRAM_SUNXI_TPR1=0x02423190
+CONFIG_DRAM_SUNXI_TPR2=0x0008b061
+CONFIG_DRAM_SUNXI_TPR3=0xb4787896
+CONFIG_DRAM_SUNXI_TPR4=0x00000000
+CONFIG_DRAM_SUNXI_TPR5=0x48484848
+CONFIG_DRAM_SUNXI_TPR6=0x00000048
+CONFIG_DRAM_SUNXI_TPR7=0x1620121e
+CONFIG_DRAM_SUNXI_TPR8=0x00000000
+CONFIG_DRAM_SUNXI_TPR9=0x00000000
+CONFIG_DRAM_SUNXI_TPR10=0x00000000
+CONFIG_DRAM_SUNXI_TPR11=0x44440000
+CONFIG_DRAM_SUNXI_TPR12=0x00005555
+CONFIG_DRAM_SUNXI_TPR13=0xb4016103
+CONFIG_MACH_SUN50I_H713=y
+CONFIG_H713_POWERON_LIGHT_FAN=y
+CONFIG_H713_MIPS_BOOT=y
+CONFIG_SUNXI_DRAM_H713_DDR3_STOCK=y
+CONFIG_MMC_SUNXI_SLOT_EXTRA=2
+CONFIG_MMC0_CD_PIN=""
+# CONFIG_SYS_MALLOC_CLEAR_ON_INIT is not set
+CONFIG_SUPPORT_EMMC_BOOT=y
+CONFIG_USB_EHCI_HCD=y
+CONFIG_USB_OHCI_HCD=y
+# CONFIG_WATCHDOG is not set
+CONFIG_WDT=y
+CONFIG_USB_MUSB_GADGET=y
+CONFIG_CMD_USB_MASS_STORAGE=y
+# CONFIG_USB_ETHER is not set
+CONFIG_CONSOLE_MUX=y
+CONFIG_SYS_CONSOLE_IS_IN_ENV=y
+CONFIG_USB_FUNCTION_ACM=y
+# CONFIG_USB_FUNCTION_ACM_WAIT_FOR_CONNECTION is not set
+CONFIG_SYSRESET=y
+CONFIG_SYSRESET_PSCI=y
+CONFIG_CMD_POWEROFF=y
+CONFIG_FASTBOOT_CMD_OEM_POWEROFF=y
+CONFIG_PREBOOT="if itest.l *0x0709011c == 0xfa57b007; then mw.l 0x0709011c 0; run fastboot_mode; elif itest.l *0x0709011c == 0xb007c0de; then mw.l 0x0709011c 0; setenv bootdelay -1; fi"
+# CONFIG_ENV_IS_IN_FAT is not set
+CONFIG_ENV_IS_IN_MMC=y
+CONFIG_ENV_OFFSET=0x700000
+CONFIG_ENV_MMC_DEVICE_INDEX=1
+CONFIG_SYS_MMCSD_RAW_MODE_U_BOOT_SECTOR=0x800
+CONFIG_SYS_MMCSD_RAW_MODE_U_BOOT_DATA_PART_OFFSET=0x0
+CONFIG_H713_VENDOR_CHAINLOAD=y
+CONFIG_CMD_WDT=y
+CONFIG_CMD_GPIO=y
diff --git a/dts/upstream/src/arm64/allwinner/sun50i-h713-hy300-2023.dts b/dts/upstream/src/arm64/allwinner/sun50i-h713-hy300-2023.dts
new file mode 100644
index 00000000000..3da173629a3
--- /dev/null
+++ b/dts/upstream/src/arm64/allwinner/sun50i-h713-hy300-2023.dts
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * MagCubic "HY300" with the 2023-06 ADT-3 firmware, reported in issue #8 of
+ * well0nez/allwinner-h713-linux by its owner. Nobody here has held one; its
+ * owner cannot open it, so the silkscreen is unknown.
+ *
+ * Like the HY300 Pro's tree, this is an include of the bench board's rather
+ * than a copy, for the same reason: a board should boot a device tree named
+ * after itself, so that a boot log says which board it is running on. The
+ * DRAM clock and words that distinguish this board (792 MHz, the HY350
+ * family's block) live in configs/hy300_2023_defconfig, not here.
+ *
+ * What is *not* claimed by this file: the panel. It declares project id 0x34,
+ * 1280x720; no node here describes a panel, the display coprocessor drives it
+ * from its own tables, and its firmware is a revision of its own ("ADT-3
+ * 2023-06" in h713_mips.c).
+ *
+ * Nothing about this board has been measured as different from the bench
+ * board's tree, so nothing else is overridden.
+ */
+
+#include "sun50i-h713-hy200-qz713df-a1.dts"
+
+/ {
+	model = "MagCubic HY300 (2023 firmware)";
+	compatible = "magcubic,hy300-2023", "allwinner,sun50i-h713";
+};
