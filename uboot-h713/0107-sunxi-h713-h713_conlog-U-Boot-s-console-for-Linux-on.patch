 arch/arm/mach-sunxi/h713_conlog.c | 61 +++++++++++++++++++++++++++++++
 configs/hy320_defconfig           |  6 +++
 3 files changed, 70 insertions(+)
 create mode 100644 arch/arm/mach-sunxi/h713_conlog.c

