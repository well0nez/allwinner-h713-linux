diff --git a/configs/fragments/h713_felmmc.config b/configs/fragments/h713_felmmc.config
new file mode 100644
index 00000000000..fc50e26c38f
--- /dev/null
+++ b/configs/fragments/h713_felmmc.config
@@ -0,0 +1,20 @@
+# Role: felmmc -- not a bootable image.
+#
+# An SPL that writes the original vendor boot0 back to the eMMC over FEL, for
+# the one case where the first boot stage has to be restored. That is why this
+# is the only role with SPL_MMC_WRITE and why its SPL may be 80 KiB; U-Boot
+# proper is never reached, so it carries no boot command at all.
+#
+# The four lines that put values back are not decoration: they are Kconfig
+# defaults the base overrides, and this role predates our layout. It writes to
+# a device that still has the vendor's boot chain on it, so it must not take
+# our U-Boot sector, our environment slot or our chainload with it.
+# CONFIG_H713_POWER_GATE is not set
+CONFIG_ENV_OFFSET=0x400000
+CONFIG_ENV_MMC_DEVICE_INDEX=0
+CONFIG_SYS_MMCSD_RAW_MODE_U_BOOT_SECTOR=0x40
+CONFIG_SYS_MMCSD_RAW_MODE_U_BOOT_DATA_PART_OFFSET=0x10
+# CONFIG_H713_VENDOR_CHAINLOAD is not set
+CONFIG_H713_SPL_FORCE_MMC=y
+CONFIG_SPL_MMC_WRITE=y
+CONFIG_SPL_MAX_SIZE=0x14000
diff --git a/configs/fragments/h713_host.config b/configs/fragments/h713_host.config
new file mode 100644
index 00000000000..849cb350f5a
--- /dev/null
+++ b/configs/fragments/h713_host.config
@@ -0,0 +1,20 @@
+# Role: host -- bench development.
+#
+# Makes the USB-A socket a host instead of a gadget, which is what the
+# internal camera needs, and changes nothing else: eMMC environment, vendor
+# chainload, no networking, and no boot command of its own, so the built-in
+# default runs and stops at the prompt. Gate off.
+#
+# The four lines after USB_GADGET are that switch-off finished by hand. Each
+# of those symbols took its value from the gadget the base has -- implied
+# (CMD_BIND), defaulted (ANDROID_BOOT_IMAGE, USB_MUSB_PIO_ONLY) or selected
+# (CIRCBUF) -- and Kconfig does not lower a symbol again when the thing that
+# raised it goes away. Only unmet dependencies do that, and these four have
+# none. So they are named.
+# CONFIG_H713_POWER_GATE is not set
+# CONFIG_USB_MUSB_SUNXI is not set
+# CONFIG_USB_GADGET is not set
+# CONFIG_CMD_BIND is not set
+# CONFIG_ANDROID_BOOT_IMAGE is not set
+# CONFIG_USB_MUSB_PIO_ONLY is not set
+# CONFIG_CIRCBUF is not set
diff --git a/configs/fragments/h713_installer.config b/configs/fragments/h713_installer.config
new file mode 100644
index 00000000000..a6151f5fd7f
--- /dev/null
+++ b/configs/fragments/h713_installer.config
@@ -0,0 +1,15 @@
+# Role: installer -- exposes the eMMC as a USB drive, from FEL.
+#
+# Started over FEL by hy310-install, so it must not read or write an
+# environment on the device it is about to write: ENV_IS_NOWHERE, which also
+# drops ENV_OFFSET and ENV_MMC_DEVICE_INDEX from the base. And it must not
+# boot anything -- the boot command ends in ums and stays there, with no delay
+# in front of it. Gate off: the board is on a bench with a cable in it.
+#
+# The message is German because it is the one the installer ships today;
+# translating it is a text change, not a config change (REPORT.txt, E3b).
+CONFIG_BOOTDELAY=0
+# CONFIG_H713_POWER_GATE is not set
+# CONFIG_ENV_IS_IN_MMC is not set
+CONFIG_ENV_IS_NOWHERE=y
+CONFIG_BOOTCOMMAND="echo HY310 installer: eMMC wird als USB-Laufwerk freigegeben; ums 0 mmc 1"
diff --git a/configs/fragments/h713_netboot.config b/configs/fragments/h713_netboot.config
new file mode 100644
index 00000000000..31f475907e2
--- /dev/null
+++ b/configs/fragments/h713_netboot.config
@@ -0,0 +1,33 @@
+# Role: netboot -- development, boots over TFTP/NFS.
+#
+# The USB-A socket becomes a host so a USB ethernet adapter can live in it,
+# and that costs the gadget: no ums, no fastboot, no ACM console. Everything
+# the base hangs off USB_GADGET by a dependency follows on its own.
+#
+# The four lines after USB_GADGET are that switch-off finished by hand. Each
+# of those symbols took its value from the gadget the base has -- implied
+# (CMD_BIND), defaulted (ANDROID_BOOT_IMAGE, USB_MUSB_PIO_ONLY) or selected
+# (CIRCBUF) -- and Kconfig does not lower a symbol again when the thing that
+# raised it goes away. Only unmet dependencies do that, and these four have
+# none. So they are named.
+#
+# The environment still comes from the eMMC, so a netbooted board keeps the
+# settings of the installed one. Gate off: a bench board should come up when
+# it is powered.
+# CONFIG_H713_POWER_GATE is not set
+# CONFIG_USB_MUSB_SUNXI is not set
+# CONFIG_USB_GADGET is not set
+# CONFIG_CMD_BIND is not set
+# CONFIG_ANDROID_BOOT_IMAGE is not set
+# CONFIG_USB_MUSB_PIO_ONLY is not set
+# CONFIG_CIRCBUF is not set
+CONFIG_NET=y
+CONFIG_CMD_NET=y
+CONFIG_CMD_DHCP=y
+CONFIG_CMD_PING=y
+CONFIG_CMD_NFS=y
+CONFIG_NET_RANDOM_ETHADDR=y
+CONFIG_USB_HOST_ETHER=y
+CONFIG_USB_ETHER_RTL8152=y
+CONFIG_ENV_SOURCE_FILE="hy310"
+CONFIG_BOOTCOMMAND="h713_disp init ${h713_project}; run boot_${h713_boot}; run boot_net"
diff --git a/configs/fragments/h713_netboot_gate.config b/configs/fragments/h713_netboot_gate.config
new file mode 100644
index 00000000000..38e2325ab0b
--- /dev/null
+++ b/configs/fragments/h713_netboot_gate.config
@@ -0,0 +1,26 @@
+# Role: netboot_gate -- netboot with the power gate compiled in.
+#
+# h713_netboot.config plus CONFIG_H713_POWER_GATE=y, and kept as a full copy
+# rather than a delta on it: uboot-build.sh applies exactly one role, and a
+# fragment that only makes sense stacked on another is a trap for whoever
+# reads it next. It exists because the gate had to be proven before it was
+# allowed into the shipping build, and a netboot round trip is a much cheaper
+# way to fail than an eMMC write. h713_netboot.config explains the four
+# switch-off lines that follow USB_GADGET.
+CONFIG_H713_POWER_GATE=y
+# CONFIG_USB_MUSB_SUNXI is not set
+# CONFIG_USB_GADGET is not set
+# CONFIG_CMD_BIND is not set
+# CONFIG_ANDROID_BOOT_IMAGE is not set
+# CONFIG_USB_MUSB_PIO_ONLY is not set
+# CONFIG_CIRCBUF is not set
+CONFIG_NET=y
+CONFIG_CMD_NET=y
+CONFIG_CMD_DHCP=y
+CONFIG_CMD_PING=y
+CONFIG_CMD_NFS=y
+CONFIG_NET_RANDOM_ETHADDR=y
+CONFIG_USB_HOST_ETHER=y
+CONFIG_USB_ETHER_RTL8152=y
+CONFIG_ENV_SOURCE_FILE="hy310"
+CONFIG_BOOTCOMMAND="h713_disp init ${h713_project}; run boot_${h713_boot}; run boot_net"
diff --git a/configs/fragments/h713_release.config b/configs/fragments/h713_release.config
new file mode 100644
index 00000000000..2a89fa68a2b
--- /dev/null
+++ b/configs/fragments/h713_release.config
@@ -0,0 +1,10 @@
+# Role: release -- the shipping build (release/build-all.sh).
+#
+# The base already is this build except for three lines, and these are they:
+# the environment file the board boots from, the command that runs it, and the
+# power gate. The gate is on in exactly one shipping role, because this is the
+# only one where the projector stands in a room and has to decide for itself
+# whether mains-on means "start".
+CONFIG_H713_POWER_GATE=y
+CONFIG_ENV_SOURCE_FILE="hy310"
+CONFIG_BOOTCOMMAND="h713_disp init ${h713_project}; run boot_${h713_boot}; run boot_net"
