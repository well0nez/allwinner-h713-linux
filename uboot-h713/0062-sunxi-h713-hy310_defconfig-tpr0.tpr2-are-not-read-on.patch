From f38476a9932dfe861049e050c3f0939d1040b3f8 Mon Sep 17 00:00:00 2001
From: well0nez <well0nez@users.noreply.github.com>
Date: Tue, 15 Sep 2026 10:15:36 +0200
Subject: [PATCH 62/82] sunxi: h713: hy310_defconfig, tpr0..tpr2 are not read
 on the DDR3 path

The comment said they are computed from the clock; dram_sun50iw12.c never
unpacks them for DDR3 (F2a, reading of 15.09.). The values are inert
either way.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 configs/hy310_defconfig | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/configs/hy310_defconfig b/configs/hy310_defconfig
index 96793be6c68..2a77ed39324 100644
--- a/configs/hy310_defconfig
+++ b/configs/hy310_defconfig
@@ -18,9 +18,10 @@ CONFIG_DEFAULT_DEVICE_TREE="allwinner/sun50i-h713-hy310"
 CONFIG_DRAM_CLK=792
 CONFIG_SPL=y
 # DDR3 (type 3). The value set below is the bench board's; only the clock
-# differs (bench 624, this board 792). tpr0..tpr2 are computed from the clock,
-# para2 and tpr13 are what the flash tool writes; the rest is this board's own
-# boot0. See docs/tools/h713-probe.md.
+# differs (bench 624, this board 792). tpr0..tpr2 are never read on the DDR3
+# path of dram_sun50iw12.c (only the LPDDR3 arm unpacks them), para2 and tpr13
+# are what the flash tool writes; the rest is this board's own boot0. See
+# docs/tools/h713-probe.md.
 CONFIG_DRAM_SUNXI_DX_ODT=0x03030303
 CONFIG_DRAM_SUNXI_DX_DRI=0x0e0e0e0e
 CONFIG_DRAM_SUNXI_CA_DRI=0x1c12
