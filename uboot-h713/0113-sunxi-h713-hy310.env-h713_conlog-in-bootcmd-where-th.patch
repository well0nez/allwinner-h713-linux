From 543a06d7e013652df1e218bcdc7829c06ac75f27 Mon Sep 17 00:00:00 2001
From: minpeter <62207008+minpeter@users.noreply.github.com>
Date: Wed, 4 Nov 2026 19:37:28 +0900
Subject: [PATCH 113/115] sunxi: h713: hy310.env - h713_conlog in bootcmd where
 the base records the console

A base with CONFIG_CONSOLE_RECORD (today hy320_defconfig: no UART) gets
h713_conlog 0x45000000; mmc dev 1; mmc write 0x45000000 0x2800 0x400 after
the h713_display branch of bootcmd, so that its image logs every boot to the
unused tail of hy310-uboot (LBA 10240..11263) for Linux to read, whichever
display stack the boot chose, and keeps the branch on h713_display that the
hand-set HY320 bootcmd lacked. The other bases' bootcmd is unchanged.
---
 board/sunxi/hy310.env | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/board/sunxi/hy310.env b/board/sunxi/hy310.env
index 7e0136307f8..3fe671554c2 100644
--- a/board/sunxi/hy310.env
+++ b/board/sunxi/hy310.env
@@ -60,6 +60,11 @@ boot_net=
 	setenv bootargs "${bootargs_base} earlycon root=/dev/nfs rw nfsroot=${serverip}:${nfsroot},vers=3,tcp ip=dhcp ${h713_display_args}";
 	tftpboot 0x60000000 ${serverip}:${bootfile};
 	bootm 0x60000000
+/* A board whose base records U-Boot's console (CONFIG_CONSOLE_RECORD, the
+ * HY320's: no UART) leaves every boot's record in the unused tail of
+ * hy310-uboot, LBA 10240..11263, for Linux to read (h713_conlog,
+ * boards/hy320/README.md in the h713 repository) - after the display init, so
+ * that the record has its lines, whichever stack it chose. */
 bootcmd=
 	if test "${h713_display}" = clean; then
 		h713_disp init ${h713_project} noboot logo;
@@ -68,5 +73,10 @@ bootcmd=
 		h713_disp init ${h713_project} logo;
 		setenv h713_display_args "module_blacklist=h713_drm";
 	fi;
+#ifdef CONFIG_CONSOLE_RECORD
+	h713_conlog 0x45000000;
+	mmc dev 1;
+	mmc write 0x45000000 0x2800 0x400;
+#endif
 	run boot_${h713_boot};
 	run boot_net
