From afc8271c13e7f9a65b057b6a5d8ed6d4c00fbf8f Mon Sep 17 00:00:00 2001
From: minpeter <62207008+minpeter@users.noreply.github.com>
Date: Thu, 5 Nov 2026 14:14:44 +0900
Subject: [PATCH 115/115] sunxi: h713: hy310.env - the opt-in console record
 write only after mmc dev 1 succeeded

mmc dev 1 && mmc write: if selecting the eMMC fails, nothing is written to the device that
happens to be current.

Co-authored-by: sisyphus-dev-ai <sisyphus-dev-ai@users.noreply.github.com>
---
 board/sunxi/hy310.env | 7 +++----
 1 file changed, 3 insertions(+), 4 deletions(-)

diff --git a/board/sunxi/hy310.env b/board/sunxi/hy310.env
index ad4ee569669..2c02dc5c29d 100644
--- a/board/sunxi/hy310.env
+++ b/board/sunxi/hy310.env
@@ -65,8 +65,8 @@ boot_net=
  * (h713_conlog, boards/hy320/README.md in the h713 repository) - after the
  * display init, so that the record has its lines, whichever stack it chose.
  * Only with h713_conlog_emmc=1, set by hand, is the record also written to
- * the unused tail of hy310-uboot, LBA 10240..11263, for Linux to read: a
- * normal boot writes nothing to the eMMC. */
+ * the unused tail of hy310-uboot, LBA 10240..11263, for Linux to read - and
+ * only once mmc dev 1 succeeded. A normal boot writes nothing to the eMMC. */
 bootcmd=
 	if test "${h713_display}" = clean; then
 		h713_disp init ${h713_project} noboot logo;
@@ -78,8 +78,7 @@ bootcmd=
 #ifdef CONFIG_CONSOLE_RECORD
 	h713_conlog 0x45000000;
 	if test "${h713_conlog_emmc}" = 1; then
-		mmc dev 1;
-		mmc write 0x45000000 0x2800 0x400;
+		mmc dev 1 && mmc write 0x45000000 0x2800 0x400;
 	fi;
 #endif
 	run boot_${h713_boot};
