diff --git a/plat/allwinner/sun50i_h713/tsp/h713_tsp_hdcp.c b/plat/allwinner/sun50i_h713/tsp/h713_tsp_hdcp.c
new file mode 100644
index 000000000..c56abc6a0
--- /dev/null
+++ b/plat/allwinner/sun50i_h713/tsp/h713_tsp_hdcp.c
@@ -0,0 +1,284 @@
+/*
+ * FB-HDCP14i: the HDCP 1.4 key path, our own, running at S-EL1.
+ *
+ * WHY, AND WHAT IS OURS
+ * ---------------------
+ * The device's HDCP 1.4 key set lives in its own secure storage, wrapped with a
+ * key that exists only inside the SoC's Crypto Engine. Making that licence
+ * usable again on hardware the manufacturer has abandoned means asking the
+ * engine to unwrap it and to hand the result to the HDMI receiver's key sink -
+ * there is no software path, the key never becomes visible to software, and we
+ * neither want it nor look for it. What is reimplemented here is the ENGINE's
+ * interface: the task descriptor layout and the start handshake, both dictated
+ * by the hardware. Not one line is taken from the vendor's binary; the register
+ * addresses and field offsets are facts about the chip (§ 69e UrhG, Art. 6
+ * RL 2009/24/EG - reverse engineering for interoperability on one's own device;
+ * § 903 BGB; RL (EU) 2024/1799).
+ *
+ * WHY S-EL1
+ * ---------
+ * From EL3 the engine refuses the key-select-3 task with ESR 0x11, while the
+ * vendor's Trusted OS gets the identical task through at S-EL1 - measured in one
+ * session, seconds apart, with identical descriptor, start sequence, channel,
+ * length, buffer location and source content (FB-HDCP14h/REPORT.txt). The bus
+ * cannot tell the two exception levels apart, so something else must; this
+ * payload is how we find out, and if the engine accepts it here, the whole path
+ * becomes ours.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#include <string.h>
+
+#include <arch_helpers.h>
+#include <common/debug.h>
+#include <lib/mmio.h>
+#include <lib/utils.h>
+#include <platform_def.h>
+#include <sunxi_mmap.h>
+
+/* The engine's secure channel, and the sink the receiver reads its key set from. */
+#define CE_BASE			SUNXI_CE_S_BASE
+#define CE_TDA			(CE_BASE + 0x00)	/* task descriptor address */
+#define CE_ICR			(CE_BASE + 0x08)	/* interrupt control */
+#define CE_ISR			(CE_BASE + 0x0c)	/* interrupt status */
+#define CE_TLR			(CE_BASE + 0x10)	/* task load */
+#define CE_ESR			(CE_BASE + 0x18)	/* error status */
+#define CE_DONE_OR_ERROR	U(3)
+
+#define SINK			SUNXI_HDCP14_SINK
+#define KEYSET_LEN		U(288)		/* 40 device keys x 7 B + KSV + pad */
+#define AES_BLOCK		U(16)
+
+/* Descriptor field offsets; addresses are five bytes, the engine is 40-bit. */
+#define D_CHAN			0x00
+#define D_COMMON		0x04
+#define D_SYM			0x08
+#define D_KEY			0x10
+#define D_IV			0x15
+#define D_LEN			0x20
+#define D_SRC			0x24
+#define D_DST			0x29
+#define D_SRC_LEN		0x30
+#define D_DST_LEN		0x34
+
+#define COMMON_GO		BIT_32(31)
+#define COMMON_DECRYPT		BIT_32(8)
+#define SYM_KEYSEL(n)		((uint32_t)(n) << 20)	/* 3 = the engine's own key */
+
+/* Clock gates we refuse to proceed without: a gated engine hangs the bus. */
+#define CCU_CE_CLK		(SUNXI_CCU_BASE + 0x680)
+#define CCU_CE_BGR		(SUNXI_CCU_BASE + 0x68c)
+#define CCU_MBUS_GATE		(SUNXI_CCU_BASE + 0x804)
+
+/* Results, deliberately distinguishable from the engine's own ESR byte. */
+#define H713_TSP_OK		U(0)
+#define H713_TSP_E_CLOCK	U(0x21)
+#define H713_TSP_E_LOAD		U(0x22)
+#define H713_TSP_E_TIMEOUT	U(0x23)
+#define H713_TSP_E_ESR		U(0x100)
+
+/*
+ * One scratch block, 64-byte aligned, laid out so the descriptor and everything
+ * it points at sit in one cache-flushable run.
+ */
+#define SCRATCH_DESC		0x000
+#define SCRATCH_KEY		0x100
+#define SCRATCH_IV		0x140
+#define SCRATCH_SRC		0x180
+#define SCRATCH_DST		0x2c0
+#define SCRATCH_SIZE		0x400
+
+static uint8_t scratch[SCRATCH_SIZE] __aligned(64);
+
+static void field(unsigned int off, uint64_t v, unsigned int bytes)
+{
+	unsigned int i;
+
+	for (i = 0; i < bytes; i++)
+		scratch[off + i] = (uint8_t)(v >> (8U * i));
+}
+
+static bool engine_clocked(void)
+{
+	return (mmio_read_32(CCU_CE_CLK) & BIT_32(31)) != 0U &&
+	       (mmio_read_32(CCU_CE_BGR) & 0x30003U) == 0x30003U &&
+	       (mmio_read_32(CCU_MBUS_GATE) & BIT_32(2)) != 0U;
+}
+
+/*
+ * Build one task and run it. @dst is either our own result buffer or the sink;
+ * the sink is a register bank, so it is addressed physically and never cached.
+ */
+static uint32_t run_task(bool decrypt, unsigned int keysel, unsigned int len,
+			 uintptr_t dst)
+{
+	uintptr_t base = (uintptr_t)scratch;
+	unsigned int spins;
+	uint32_t status, esr;
+
+	if (!engine_clocked())
+		return H713_TSP_E_CLOCK;
+
+	zeromem(scratch + SCRATCH_DESC, 0x100);
+	zeromem(scratch + SCRATCH_IV, AES_BLOCK);
+	if (dst != SINK)
+		zeromem(scratch + SCRATCH_DST, SCRATCH_SIZE - SCRATCH_DST);
+
+	field(D_COMMON, COMMON_GO | (decrypt ? COMMON_DECRYPT : 0U), 4);
+	field(D_SYM, SYM_KEYSEL(keysel), 4);
+	field(D_KEY, base + SCRATCH_KEY, 5);
+	field(D_IV, base + SCRATCH_IV, 5);
+	field(D_LEN, len, 4);
+	field(D_SRC, base + SCRATCH_SRC, 5);
+	field(D_DST, dst, 5);
+	field(D_SRC_LEN, len, 4);
+	field(D_DST_LEN, len, 4);
+
+	/* The engine reads DRAM, not our dirty lines. */
+	flush_dcache_range(base, SCRATCH_SIZE);
+
+	mmio_write_32(CE_TDA, (uint32_t)(base + SCRATCH_DESC));
+	mmio_setbits_32(CE_ICR, BIT_32(0));
+
+	/*
+	 * Counted, not timed. The generic timer is of no use to this payload (a
+	 * 288-byte task waited on a deadline that never arrived and only the
+	 * watchdog ended it, measured 05.10. 05:22), and a secure payload must
+	 * never be able to hang the machine. A few hundred thousand reads of a
+	 * device register take well over the microseconds the engine needs.
+	 */
+	for (spins = 0U; (mmio_read_32(CE_TLR) & BIT_32(0)) != 0U; spins++) {
+		if (spins > 200000U) {
+			mmio_write_32(CE_ICR, 0);
+			mmio_write_32(CE_TDA, 0);
+			return H713_TSP_E_LOAD;
+		}
+	}
+	mmio_setbits_32(CE_TLR, BIT_32(0));
+
+	for (spins = 0U; spins <= 2000000U; spins++) {
+		status = mmio_read_32(CE_ISR);
+		if ((status & CE_DONE_OR_ERROR) != 0U)
+			break;
+	}
+
+	esr = mmio_read_32(CE_ESR) & 0xffU;
+	mmio_write_32(CE_ISR, CE_DONE_OR_ERROR | (status & 0xffU));
+	mmio_write_32(CE_ICR, 0);
+	mmio_write_32(CE_TLR, 0);
+	mmio_write_32(CE_TDA, 0);
+
+	if (dst != SINK)
+		inv_dcache_range(base + SCRATCH_DST, SCRATCH_SIZE - SCRATCH_DST);
+	if ((status & CE_DONE_OR_ERROR) == 0U)
+		return H713_TSP_E_TIMEOUT;
+	return (esr != 0U) ? (H713_TSP_E_ESR | esr) : H713_TSP_OK;
+}
+
+/*
+ * Does this exception level get to use the engine's own key at all? One task of
+ * @len bytes with key-select 3 into our own buffer. Only the verdict leaves the
+ * payload; whatever the engine produced is wiped here, because we are after the
+ * interface, not the material.
+ */
+uint32_t h713_tsp_keysel3_probe(unsigned int len)
+{
+	uint32_t ret;
+
+	if (len == 0U || len > (SCRATCH_SIZE - SCRATCH_DST) ||
+	    (len & (AES_BLOCK - 1U)) != 0U)
+		return H713_TSP_E_LOAD;
+	zeromem(scratch + SCRATCH_KEY, 64);
+	zeromem(scratch + SCRATCH_SRC, len);
+	ret = run_task(true, 3, len, (uintptr_t)scratch + SCRATCH_DST);
+	zeromem(scratch + SCRATCH_DST, len);
+	NOTICE("H713 TSP: key-select 3 at S-EL1, %u bytes: 0x%x\n", len, ret);
+	return ret;
+}
+
+/*
+ * A control that must pass whatever happens to key-select 3: the same engine,
+ * the same channel, the same descriptor, but a key we supply ourselves. If this
+ * fails, the payload's own plumbing is wrong and nothing else it says counts.
+ */
+uint32_t h713_tsp_selftest(void)
+{
+	uint32_t ret;
+
+	zeromem(scratch + SCRATCH_KEY, 64);
+	zeromem(scratch + SCRATCH_SRC, AES_BLOCK);
+	ret = run_task(false, 0, AES_BLOCK, (uintptr_t)scratch + SCRATCH_DST);
+	NOTICE("H713 TSP: self-test (own key, encrypt one block): 0x%x\n", ret);
+	return ret;
+}
+
+/*
+ * The real thing: take the wrapped key set the caller has placed at @src_pa,
+ * unwrap it with the engine's own key and let the engine write the result
+ * straight into the receiver's sink. The plaintext never touches memory we can
+ * read, and it is never returned.
+ */
+uint32_t h713_tsp_push_keyset(uintptr_t src_pa)
+{
+	uint32_t ret;
+
+	/* Only out of the one window we map, and 64-byte aligned like the engine wants. */
+	if ((src_pa & 0x3fU) != 0U || src_pa < H713_TSP_IN_BASE ||
+	    src_pa + KEYSET_LEN > H713_TSP_IN_BASE + H713_TSP_IN_SIZE)
+		return H713_TSP_E_LOAD;
+	zeromem(scratch + SCRATCH_KEY, 64);
+	inv_dcache_range(src_pa, KEYSET_LEN);
+	memcpy(scratch + SCRATCH_SRC, (const void *)src_pa, KEYSET_LEN);
+	ret = run_task(true, 3, KEYSET_LEN, SINK);
+	zeromem(scratch + SCRATCH_SRC, KEYSET_LEN);
+	NOTICE("H713 TSP: key set into the sink: 0x%x\n", ret);
+	return ret;
+}
+
+/*
+ * The whole chain, inside the payload: take the device's stored record out of the
+ * one input window, let the engine unwrap it with its own key into our scratch,
+ * and let the engine push the key set from there into the receiver's sink.
+ *
+ * Two tasks, because that is how the hardware is built: the stored form is bound
+ * to this chip and only the engine can open it, and the sink is written by the
+ * engine's DMA, not by software. The unwrapped bytes live in the payload's own
+ * memory for the length of one call, are never returned and are wiped before we
+ * leave - we need the licence usable, not the key.
+ *
+ * @src_pa  the stored record, 64-byte aligned, inside the input window
+ * @in_len  how much of it to unwrap (the record is 320 bytes, the key set 288)
+ */
+uint32_t h713_tsp_install_keyset(uintptr_t src_pa, unsigned int in_len)
+{
+	uint32_t ret;
+
+	if ((src_pa & 0x3fU) != 0U || in_len == 0U ||
+	    (in_len & (AES_BLOCK - 1U)) != 0U ||
+	    in_len > (SCRATCH_SIZE - SCRATCH_DST) || in_len < KEYSET_LEN ||
+	    src_pa < H713_TSP_IN_BASE ||
+	    src_pa + in_len > H713_TSP_IN_BASE + H713_TSP_IN_SIZE)
+		return H713_TSP_E_LOAD;
+
+	/* Step one: unwrap into our own buffer. */
+	zeromem(scratch + SCRATCH_KEY, 64);
+	inv_dcache_range(src_pa, in_len);
+	memcpy(scratch + SCRATCH_SRC, (const void *)src_pa, in_len);
+	ret = run_task(true, 3, in_len, (uintptr_t)scratch + SCRATCH_DST);
+	zeromem(scratch + SCRATCH_SRC, in_len);
+	if (ret != H713_TSP_OK) {
+		zeromem(scratch + SCRATCH_DST, in_len);
+		NOTICE("H713 TSP: unwrap of %u bytes: 0x%x\n", in_len, ret);
+		return ret;
+	}
+
+	/* Step two: the first KEYSET_LEN bytes of the result go into the sink. */
+	memmove(scratch + SCRATCH_SRC, scratch + SCRATCH_DST, KEYSET_LEN);
+	zeromem(scratch + SCRATCH_DST, in_len);
+	ret = run_task(true, 3, KEYSET_LEN, SINK);
+	zeromem(scratch + SCRATCH_SRC, KEYSET_LEN);
+	NOTICE("H713 TSP: unwrapped %u bytes, key set into the sink: 0x%x\n",
+	       in_len, ret);
+	return ret;
+}
diff --git a/plat/allwinner/sun50i_h713/tsp/h713_tsp_setup.c b/plat/allwinner/sun50i_h713/tsp/h713_tsp_setup.c
new file mode 100644
index 000000000..162764698
--- /dev/null
+++ b/plat/allwinner/sun50i_h713/tsp/h713_tsp_setup.c
@@ -0,0 +1,80 @@
+/*
+ * FB-HDCP14i: platform glue for our own secure payload at S-EL1 on the H713.
+ *
+ * Why this exists: the Crypto Engine answers our key-select-3 task from EL3 with
+ * ESR 0x11 while the vendor's Trusted OS gets the identical task through at
+ * S-EL1 seconds later - identical descriptor, identical start sequence, same
+ * channel, same buffers, measured. S-EL1 is the one context we never tried, so
+ * this port gives us one, built from TF-A's own payload and our own code rather
+ * than from the vendor's binary.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#include <drivers/arm/gicv2.h>
+#include <drivers/console.h>
+#include <drivers/generic_delay_timer.h>
+#include <drivers/ti/uart/uart_16550.h>
+#include <common/debug.h>
+#include <lib/xlat_tables/xlat_tables_v2.h>
+#include <platform_def.h>
+#include <platform_tsp.h>
+#include <sunxi_def.h>
+#include <sunxi_mmap.h>
+
+static console_t console;
+
+/* The same interrupt controller BL31 drives; the payload only needs its own view. */
+static const interrupt_prop_t h713_tsp_irqs[] = {
+	INTR_PROP_DESC(TSP_IRQ_SEC_PHY_TIMER, GIC_HIGHEST_SEC_PRIORITY,
+		       GICV2_INTR_GROUP0, GIC_INTR_CFG_LEVEL),
+};
+
+static const gicv2_driver_data_t h713_tsp_gic = {
+	.gicd_base = SUNXI_GICD_BASE,
+	.gicc_base = SUNXI_GICC_BASE,
+	.interrupt_props = h713_tsp_irqs,
+	.interrupt_props_num = ARRAY_SIZE(h713_tsp_irqs),
+};
+
+void tsp_early_platform_setup(u_register_t arg0, u_register_t arg1,
+			      u_register_t arg2, u_register_t arg3)
+{
+	console_16550_register(SUNXI_UART0_BASE, SUNXI_UART0_CLK_IN_HZ,
+			       SUNXI_UART0_BAUDRATE, &console);
+	console_set_scope(&console, CONSOLE_FLAG_BOOT | CONSOLE_FLAG_RUNTIME |
+			  CONSOLE_FLAG_CRASH);
+	/*
+	 * Say so before the MMU goes on. Everything after this point runs with
+	 * translation enabled, and a mapping mistake there is silent - this line
+	 * is what tells the two failure modes apart on the next run.
+	 */
+	NOTICE("H713 TSP: payload entered, console up, MMU still off\n");
+}
+
+void tsp_plat_arch_setup(void)
+{
+	/*
+	 * No MMU, on purpose. This payload is 24 KB of straight-line code that
+	 * touches its own buffers and a handful of engine registers, all by
+	 * physical address - translation would buy it nothing and cost a whole
+	 * class of silent failure (an execute-never mapping over its own code,
+	 * an attribute clash with the coherent region, a region limit). With
+	 * translation off every access is device-order and uncached, which is
+	 * exactly what talking to a DMA engine wants: what we write is in memory
+	 * before the engine looks, without a single cache maintenance call.
+	 *
+	 * Measured on 05.10.: with the section-wise mapping the payload died
+	 * silently inside mmap_add_region, before any marker after the first.
+	 */
+	NOTICE("H713 TSP: running with the MMU off, physical addresses only\n");
+}
+
+void tsp_platform_setup(void)
+{
+	generic_delay_timer_init();
+	gicv2_driver_init(&h713_tsp_gic);
+	gicv2_cpuif_enable();
+	NOTICE("H713 TSP: our own secure payload is up at S-EL1\n");
+	console_switch_state(CONSOLE_FLAG_RUNTIME);
+}
diff --git a/plat/allwinner/sun50i_h713/tsp/tsp-sun50i_h713.mk b/plat/allwinner/sun50i_h713/tsp/tsp-sun50i_h713.mk
new file mode 100644
index 000000000..a5b13e5be
--- /dev/null
+++ b/plat/allwinner/sun50i_h713/tsp/tsp-sun50i_h713.mk
@@ -0,0 +1,16 @@
+#
+# FB-HDCP14i: TSP port for the H713 - our own secure payload at S-EL1.
+#
+# SPDX-License-Identifier: BSD-3-Clause
+#
+
+BL32_SOURCES	+=	plat/common/${ARCH}/platform_mp_stack.S		\
+			drivers/ti/uart/${ARCH}/16550_console.S		\
+			drivers/arm/gic/common/gic_common.c		\
+			drivers/arm/gic/v2/gicv2_main.c			\
