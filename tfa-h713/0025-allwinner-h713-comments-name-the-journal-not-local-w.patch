From 7f00c0009ba15a68fafcadffc0b138f783714d95 Mon Sep 17 00:00:00 2001
From: well0nez <8986239+well0nez@users.noreply.github.com>
Date: Thu, 8 Oct 2026 00:17:40 +0200
Subject: [PATCH 25/32] allwinner: h713: comments name the journal, not local
 work folders

Three comments named the local folder of the crust package or the ids of
its review, which a reader of this tree cannot open: the watchdog reset
helper, the record of the last run and the SCP staging note. They name
the journal entries now (doku/162 for the package, doku/164 for the
watchdog), and the R_WDOG switch in platform.mk says "measured on the
device" instead of a stage name of that package. Comments only.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 plat/allwinner/common/sunxi_native_pm.c         | 6 +++---
 plat/allwinner/common/sunxi_pm.c                | 2 +-
 plat/allwinner/sun50i_h713/include/sunxi_mmap.h | 2 +-
 plat/allwinner/sun50i_h713/platform.mk          | 2 +-
 4 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/plat/allwinner/common/sunxi_native_pm.c b/plat/allwinner/common/sunxi_native_pm.c
index 5887a2aa7..4957bc98d 100644
--- a/plat/allwinner/common/sunxi_native_pm.c
+++ b/plat/allwinner/common/sunxi_native_pm.c
@@ -157,9 +157,9 @@ static void sunxi_system_off(void)
  *
  * Rewriting MODE does not restart the counter: on a watchdog that is already
  * running past the new interval the write is swallowed, and with it the net
- * that was running (doku/164, TFA-1 in crust-20261007). Feed it before and
- * after, then wait twice the interval; should nothing happen, say what the
- * registers read and try again rather than park the cores for good.
+ * that was running (doku/164). Feed it before and after, then wait twice the
+ * interval; should nothing happen, say what the registers read and try again
+ * rather than park the cores for good.
  */
 #define SUNXI_WDOG_CTRL_REG		(SUNXI_WDOG_BASE + 0x000c)
 #define SUNXI_WDOG_CFG_REG		(SUNXI_WDOG_BASE + 0x0010)
diff --git a/plat/allwinner/common/sunxi_pm.c b/plat/allwinner/common/sunxi_pm.c
index f5996fb34..9b2f20507 100644
--- a/plat/allwinner/common/sunxi_pm.c
+++ b/plat/allwinner/common/sunxi_pm.c
@@ -111,7 +111,7 @@ static inline uint32_t sunxi_r_wdog_check(void)
  * The record of the run before this boot (P), written on every boot before
  * the page is zeroed: what crust (D, K), the kernel and TF-A (A) left there,
  * when the page holds contract 5 or later, else an empty record. The kernel
- * reports it at probe when the checksum holds (CS-04, TFA-14).
+ * reports it at probe when the checksum holds.
  */
 static void sunxi_scp_record(uint32_t rwdog)
 {
diff --git a/plat/allwinner/sun50i_h713/include/sunxi_mmap.h b/plat/allwinner/sun50i_h713/include/sunxi_mmap.h
index 8487ce743..69e1544eb 100644
--- a/plat/allwinner/sun50i_h713/include/sunxi_mmap.h
+++ b/plat/allwinner/sun50i_h713/include/sunxi_mmap.h
@@ -67,7 +67,7 @@
 #define SUNXI_CPUCFG_BASE		0x09010000
 
 /*
- * crust (FB-CRUST, crust-20261007): the SPL stages scp.bin in DRAM where the
+ * crust (FB-CRUST, doku/162): the SPL stages scp.bin in DRAM where the
  * vendor's boot package puts it (it cannot load it into SRAM A2, it runs
  * there itself: 0x00104000 + 0x14000); BL31, running from DRAM, copies it to
  * AR100 0x10000 once the SPL is gone and starts the AR100. The exception
diff --git a/plat/allwinner/sun50i_h713/platform.mk b/plat/allwinner/sun50i_h713/platform.mk
index cfa3b2e41..07b6fc9de 100644
--- a/plat/allwinner/sun50i_h713/platform.mk
+++ b/plat/allwinner/sun50i_h713/platform.mk
@@ -25,7 +25,7 @@ $(eval $(call assert_boolean,SUNXI_STANDBY_UNMEASURED))
 $(eval $(call add_define,SUNXI_STANDBY_UNMEASURED))
 
 # Disarm an R_WDOG (0x07020400) a reset left armed, at every boot. Off until
-# its feed register is measured (stage S0 of the crust standby).
+# its feed register is measured on the device.
 H713_R_WDOG_CHECK	?=	0
 $(eval $(call assert_boolean,H713_R_WDOG_CHECK))
 $(eval $(call add_define,H713_R_WDOG_CHECK))
