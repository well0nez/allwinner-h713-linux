From 47ee829f745f7c87273192b26c92dbd8f78b4ab1 Mon Sep 17 00:00:00 2001
From: Christopher Stenger <chris.h.stenger@gmail.com>
Date: Tue, 14 Jul 2026 00:37:40 -0700
Subject: [PATCH 04/27] feat(allwinner): implement PSCI CPU_SUSPEND for the
 native power ops

The native (non-SCPI) sunxi PSCI ops implemented CPU_ON/OFF and system
off/reset but not CPU_SUSPEND, so PSCI_FEATURES reported it unsupported
and cpuidle was unavailable. Add:

- validate_power_state: a CPU-level WFI retention state and powerdown
  states from CPU up to the requested affinity level
- cpu_standby: dsb + wfi for the retention state
- pwr_domain_suspend / _finish: a CPU-level powerdown reuses the proven
  cpu-off primitive (gicv2_cpuif_disable + sunxi_cpu_power_off_self via
  the CPUIDLE hardware) and restores the GIC on resume, mirroring the
  existing pwr_domain_off / on_finish that ship for CPU_OFF/ON

Hardware-checked on H713: PSCI_FEATURES(CPU_SUSPEND) now reports
supported, and a secondary core issued CPU_SUSPEND (standby) enters the
state and halts in WFI as expected. Wake-on-interrupt and powerdown
resume follow the same GIC/CPUIDLE paths as the already-working
CPU_OFF/ON, exercised by the kernel's cpuidle once GIC per-CPU state is
configured.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 plat/allwinner/common/sunxi_native_pm.c | 59 +++++++++++++++++++++++++
 1 file changed, 59 insertions(+)

diff --git a/plat/allwinner/common/sunxi_native_pm.c b/plat/allwinner/common/sunxi_native_pm.c
index ca82284c5..f78eebf77 100644
--- a/plat/allwinner/common/sunxi_native_pm.c
+++ b/plat/allwinner/common/sunxi_native_pm.c
@@ -38,6 +38,61 @@ static void sunxi_pwr_domain_on_finish(const psci_power_state_t *target_state)
 	gicv2_cpuif_enable();
 }
 
+static int sunxi_validate_power_state(unsigned int power_state,
+				      psci_power_state_t *req_state)
+{
+	unsigned int power_level = psci_get_pstate_pwrlvl(power_state);
+	unsigned int type = psci_get_pstate_type(power_state);
+	unsigned int i;
+
+	if (power_level > PLAT_MAX_PWR_LVL) {
+		return PSCI_E_INVALID_PARAMS;
+	}
+
+	if (type == PSTATE_TYPE_STANDBY) {
+		/* Only a CPU-level WFI retention state is supported. */
+		if (power_level != MPIDR_AFFLVL0) {
+			return PSCI_E_INVALID_PARAMS;
+		}
+		req_state->pwr_domain_state[MPIDR_AFFLVL0] =
+			PLAT_MAX_RET_STATE;
+	} else {
+		/* Power down this level and everything below it. */
+		for (i = MPIDR_AFFLVL0; i <= power_level; i++) {
+			req_state->pwr_domain_state[i] = PLAT_MAX_OFF_STATE;
+		}
+	}
+
+	return PSCI_E_SUCCESS;
+}
+
+static void sunxi_cpu_standby(plat_local_state_t cpu_state)
+{
+	/*
+	 * WFI wakes on a pending physical interrupt regardless of the PSTATE
+	 * mask, so no SCR_EL3 changes are needed here.
+	 */
+	dsb();
+	wfi();
+}
+
+static void sunxi_pwr_domain_suspend(const psci_power_state_t *target_state)
+{
+	/* A CPU-level powerdown suspend is the same as turning the CPU off. */
+	if (is_local_state_off(target_state->pwr_domain_state[MPIDR_AFFLVL0])) {
+		gicv2_cpuif_disable();
+		sunxi_cpu_power_off_self();
+	}
+}
+
+static void sunxi_pwr_domain_suspend_finish(const psci_power_state_t *target_state)
+{
+	if (is_local_state_off(target_state->pwr_domain_state[MPIDR_AFFLVL0])) {
+		gicv2_pcpu_distif_init();
+		gicv2_cpuif_enable();
+	}
+}
+
 static void sunxi_system_off(void)
 {
 	gicv2_cpuif_disable();
@@ -77,9 +132,13 @@ static void __dead2 sunxi_system_reset(void)
 }
 
 static const plat_psci_ops_t sunxi_native_psci_ops = {
+	.cpu_standby			= sunxi_cpu_standby,
 	.pwr_domain_on			= sunxi_pwr_domain_on,
 	.pwr_domain_off			= sunxi_pwr_domain_off,
 	.pwr_domain_on_finish		= sunxi_pwr_domain_on_finish,
+	.pwr_domain_suspend		= sunxi_pwr_domain_suspend,
+	.pwr_domain_suspend_finish	= sunxi_pwr_domain_suspend_finish,
+	.validate_power_state		= sunxi_validate_power_state,
 	.system_off			= sunxi_system_off,
 	.system_reset			= sunxi_system_reset,
 	.validate_ns_entrypoint		= sunxi_validate_ns_entrypoint,
