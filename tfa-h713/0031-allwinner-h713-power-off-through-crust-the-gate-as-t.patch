From 1dd0373449df6239b7c13a8d7b40f0eb2d656532 Mon Sep 17 00:00:00 2001
From: well0nez <8986239+well0nez@users.noreply.github.com>
Date: Sat, 10 Oct 2026 11:18:32 +0200
Subject: [PATCH 31/31] allwinner: h713: power off through crust, the gate as
 the fallback

SYSTEM_OFF still writes "GATE" into RTC GP5 first, then asks crust
(sunxi_scp_off.c): type 0x19 on msgbox port 3, the vendor's fake poweroff,
only of a running crust that says it can (contract v5, BUILD2 bit 24) and
is not inside a standby. crust confirms with its phase POWEROFF within
20 ms; the cores are then parked for its cluster reset, and crust cuts the
board's rails and resets into a warm start on the key (doku/187). Without
the confirmation the reset into U-Boot's gate as before, with TFA_WORD
event 5 saying why. Built, not yet measured on a device.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 plat/allwinner/common/include/sunxi_private.h |   2 +
 .../sun50i_h713/include/sunxi_mmap.h          |   2 +
 plat/allwinner/sun50i_h713/platform.mk        |   3 +-
 plat/allwinner/sun50i_h713/sunxi_power.c      |  12 ++
 plat/allwinner/sun50i_h713/sunxi_scp_off.c    | 156 ++++++++++++++++++
 5 files changed, 174 insertions(+), 1 deletion(-)
 create mode 100644 plat/allwinner/sun50i_h713/sunxi_scp_off.c

diff --git a/plat/allwinner/common/include/sunxi_private.h b/plat/allwinner/common/include/sunxi_private.h
index a3ee8fe46..d8251e80f 100644
--- a/plat/allwinner/common/include/sunxi_private.h
+++ b/plat/allwinner/common/include/sunxi_private.h
@@ -29,6 +29,8 @@ extern uintptr_t sunxi_sec_entrypoint;
 
 /* An event for the kernel in the SCP firmware's contract page (H713). */
 void sunxi_scp_event(unsigned int event, unsigned int detail);
+/* SYSTEM_OFF through crust (H713): true once crust took it. */
+bool sunxi_scp_power_off(void);
 
 #if SUNXI_SYSTEM_SUSPEND
 bool sunxi_system_suspend_possible(void);
diff --git a/plat/allwinner/sun50i_h713/include/sunxi_mmap.h b/plat/allwinner/sun50i_h713/include/sunxi_mmap.h
index 1e74cde44..2e3771f96 100644
--- a/plat/allwinner/sun50i_h713/include/sunxi_mmap.h
+++ b/plat/allwinner/sun50i_h713/include/sunxi_mmap.h
@@ -111,6 +111,7 @@
 #define SCP_SH_BUILD			0x23c	/* variant bits 24..31 */
 #define SCP_SH_K			0x260	/* K, 24 words */
 #define SCP_SH_COMPAT			0x260	/* 7..0 oldest reader it suits */
+#define SCP_SH_BUILD2			0x264	/* 24: power off (0x19) */
 #define SCP_SH_SB_STATE			0x268	/* standby phase, 3..0 */
 #define SCP_SH_NET_MS			0x274
 #define SCP_SH_ERR			0x27c
@@ -149,5 +150,6 @@
 #define SCP_EV_START			2	/* crust not running in time */
 #define SCP_EV_R_WDOG			3	/* R_WDOG found armed at boot */
 #define SCP_EV_RESET			4	/* suspend not accepted, reset */
+#define SCP_EV_OFF_GATE			5	/* power off not taken, the gate */
 
 #endif /* SUNXI_MMAP_H */
diff --git a/plat/allwinner/sun50i_h713/platform.mk b/plat/allwinner/sun50i_h713/platform.mk
