diff --git a/plat/allwinner/common/sunxi_bl31_setup.c b/plat/allwinner/common/sunxi_bl31_setup.c
index 4dba1796d..dba9144b7 100644
--- a/plat/allwinner/common/sunxi_bl31_setup.c
+++ b/plat/allwinner/common/sunxi_bl31_setup.c
@@ -33,6 +33,12 @@ static console_t console;
 
 static void *fdt;
 
+/* The DTB U-Boot carries, once found; NULL before that or without one. */
+void *sunxi_get_dtb(void)
+{
+	return fdt;
+}
+
 static const gicv2_driver_data_t sunxi_gic_data = {
 	.gicd_base = SUNXI_GICD_BASE,
 	.gicc_base = SUNXI_GICC_BASE,
@@ -83,12 +89,63 @@ void bl31_early_platform_setup2(u_register_t arg0, u_register_t arg1,
 	/* Initialize the debug console as soon as possible */
 	console_16550_register(SUNXI_UART0_BASE, SUNXI_UART0_CLK_IN_HZ,
 			       SUNXI_UART0_BAUDRATE, &console);
+	/* FB-HDCP14h: the diagnosis NOTICEs happen at run time */
+	console_set_scope(&console, CONSOLE_FLAG_BOOT | CONSOLE_FLAG_RUNTIME |
+			  CONSOLE_FLAG_CRASH);
 
 #ifdef BL32_BASE
 	/* Populate entry point information for BL32 */
 	SET_PARAM_HEAD(&bl32_image_ep_info, PARAM_EP, VERSION_1, 0);
 	SET_SECURITY_STATE(bl32_image_ep_info.h.attr, SECURE);
 	bl32_image_ep_info.pc = BL32_BASE;
+#ifdef H713_BL32_AARCH32
+	/*
+	 * The vendor's OP-TEE (header version 3.7, "arm" in its own banner) is a
+	 * 32-bit image: enter it in AArch32 SVC, as the vendor monitor does. Our
+	 * own payload (FB-HDCP14i, plat/.../tsp) is AArch64 and its dispatcher
+	 * sets the entry state itself, so this whole block is for the vendor
+	 * image only - built with -DH713_BL32_AARCH32.
+	 */
+	bl32_image_ep_info.spsr = SPSR_MODE32(MODE32_svc, SPSR_T_ARM,
+					      SPSR_E_LITTLE,
+					      DISABLE_ALL_EXCEPTIONS);
+	/*
+	 * opteed takes the payload's execution state from args.arg0, NOT from the
+	 * SPSR (opteed_setup(), default handoff branch: opteed_rw =
+	 * optee_ep_info->args.arg0). Left at zero that is OPTEE_AARCH64, so a
+	 * 32-bit OP-TEE gets started as AArch64 and dies on its first instruction
+	 * without a word - measured on 04.10., the handover showed spsr 0x3c5
+	 * (EL1h, AArch64) although this file had set 0x1d3.
+	 */
+	bl32_image_ep_info.args.arg0 = MODE_RW_32;
+#endif /* H713_BL32_AARCH32 */
+#ifdef H713_WDOG_BRINGUP
+	/*
+	 * Bring-up safety net. A hang inside the secure payload otherwise needs
+	 * someone to pull the plug AND press the power key, because this board does
+	 * not come up from mains on its own. With the watchdog armed the SoC resets
+	 * itself and boot0 brings the stock chain back, so a failed probe costs
+	 * nothing. Key-protected layout of the H713: CFG at +0x10, MODE at +0x14,
+	 * writes ignored without the key. Timeout code 0x9 << 4 = about 11 s, which
+	 * is long enough for a working hand-over to show U-Boot first.
+	 */
+	mmio_write_32(SUNXI_WDOG_BASE + 0x10, SUNXI_WDOG_KEY | 1);
+	mmio_write_32(SUNXI_WDOG_BASE + 0x14, SUNXI_WDOG_KEY | (0x9 << 4) | 1);
+	NOTICE("BL31: watchdog armed (~11 s) for the BL32 bring-up\n");
+#endif
+	/*
+	 * Bring-up aid: is the image actually where the FIT says? Only meaningful
+	 * when a BL32 was really loaded - BL32_BASE is defined in the headers even
+	 * when it was not, and then this printed the contents of an empty address
+	 * every boot and read like a fault ("BL32 at 0x48600000: f0003a40 ...").
+	 */
+#if defined(H713_WITH_BL32)
+	NOTICE("BL31: BL32 at 0x%x: %08x %08x %08x, run addr %08x, spsr %08x\n",
+	       (unsigned int)BL32_BASE,
+	       mmio_read_32(BL32_BASE), mmio_read_32(BL32_BASE + 4),
+	       mmio_read_32(BL32_BASE + 8), mmio_read_32(BL32_BASE + 0x2c),
+	       (unsigned int)bl32_image_ep_info.spsr);
+#endif
 #endif
 
 	/* Populate entry point information for BL33 */
diff --git a/plat/allwinner/common/sunxi_prepare_dtb.c b/plat/allwinner/common/sunxi_prepare_dtb.c
index 0f689744a..ede4591ba 100644
--- a/plat/allwinner/common/sunxi_prepare_dtb.c
+++ b/plat/allwinner/common/sunxi_prepare_dtb.c
@@ -34,6 +34,24 @@ void sunxi_prepare_dtb(void *fdt)
 	}
 #endif
 
+#if defined(BL32_BASE) && defined(H713_WITH_BL32)
+	/*
+	 * Reserve the secure payload's memory too. Without this the kernel is
+	 * uncompressed over it (it lands at 0x48000000 and is some 20 MB), and
+	 * then every PSCI CPU_ON erets into overwritten code: the secondary cores
+	 * never come up and the board runs on one (measured 05.10., three cores
+	 * lost). The vendor's own device tree reserves exactly this window, which
+	 * is why stock keeps all four. Guarded by H713_WITH_BL32 and not by
+	 * BL32_BASE alone: that macro is defined in every configuration, so the
+	 * reservation also appeared in builds WITHOUT a payload and then blocked
+	 * the kernel's own window (measured 05.10. 06:1x).
+	 */
+	if (fdt_add_reserved_memory(fdt, "optee@48600000", BL32_BASE,
+				    BL32_LIMIT - BL32_BASE)) {
+		WARN("Failed to reserve the BL32 window in the DT.\n");
+	}
+#endif
+
 	sunxi_soc_fdt_fixup(fdt);
 
 	if (sunxi_psci_is_scpi()) {
diff --git a/plat/allwinner/common/sunxi_security.c b/plat/allwinner/common/sunxi_security.c
index 98b91c39f..6a539070f 100644
--- a/plat/allwinner/common/sunxi_security.c
+++ b/plat/allwinner/common/sunxi_security.c
@@ -24,6 +24,50 @@ void sunxi_security_setup(void)
 {
 	int i;
 
+#ifdef H713_VENDOR_SECURITY_SETUP
+	/*
+	 * FB-HDCP14h: the sequence of this board's own vendor BL31, register for
+	 * register (monitor.bin 0x48001430 and its helper 0x480013f8). It differs
+	 * from the mainline one in five ways, and this platform keeps a secure OS
+	 * while mainline assumes none:
+	 *   - a second port block at 0x07002004.. that mainline does not know
+	 *   - 0x07010290 is read-modify-written with |= 7, not blindly set to 1
+	 *   - 0x07002400/04/08 are explicitly zeroed
+	 *   - the DMA word gets 0xff, not 0xffff
+	 *   - 0x020008e0 = 3, 0x02001750 = 0x10000 then 0x10001, 0x03060008 = 0
+	 */
+	INFO("Vendor SPC/bus security setup (FB-HDCP14h)\n");
+	for (uintptr_t a = 0x02000804; a != 0x020008e4; a += 16)
+		mmio_write_32(a, 0xffffffff);
+	mmio_write_32(0x07002400, 0);
+	mmio_write_32(0x07002404, 0);
+	mmio_write_32(0x07002408, 0);
+	mmio_write_32(0x02001f00, 7);
+	for (uintptr_t a = 0x07002004; a != 0x070020e4; a += 16)
+		mmio_write_32(a, 0xffffffff);
+	mmio_setbits_32(0x07010290, 0x7);
+	mmio_write_32(0x03002020, 0xff);
+	mmio_write_32(0x020008e0, 3);
+	mmio_write_32(0x02001750, 0x10000);
+	mmio_write_32(0x02001750, 0x10001);
+	mmio_write_32(0x03060008, 0);
+	return;
+#endif
+#ifdef H713_SKIP_SECURITY_SETUP
+	/*
+	 * FB-HDCP14h bring-up probe. The vendor BL31 of this board (0x48001430)
+	 * does NOT write this file's R_PRCM word (our 0x07010290 = 0x1; it zeroes
+	 * 0x07002400/04/08 instead), writes 0xff to the DMA word where we write
+	 * 0xffff, and additionally sets 0x020008e0 = 3, 0x02002150 = 0x10000 then
+	 * 0x10001 and 0x03060008 = 0. Its CCU word (0x02001f00 = 7) is the same as
+	 * ours. Since the vendor keeps a secure OS and we hand more to the
+	 * non-secure world, skip the whole setup once and see whether the vendor
+	 * OP-TEE then gets through its own start-up.
+	 */
+	INFO("Skipping SPC/bus security setup (FB-HDCP14h probe)\n");
+	return;
+#endif
+
 	INFO("Configuring SPC Controller\n");
 	/* SPC setup: set all devices to non-secure */
 	for (i = 0; i < SUNXI_SPC_NUM_PORTS; i++)
diff --git a/plat/allwinner/sun50i_h713/include/sunxi_mmap.h b/plat/allwinner/sun50i_h713/include/sunxi_mmap.h
index 0f365de47..d830f4315 100644
--- a/plat/allwinner/sun50i_h713/include/sunxi_mmap.h
+++ b/plat/allwinner/sun50i_h713/include/sunxi_mmap.h
@@ -26,6 +26,10 @@
 #define SUNXI_CCU_BASE			0x02001000
 #define SUNXI_DMA_BASE			0x03002000
 #define SUNXI_SID_BASE			0x03006000
+/* Crypto Engine: non-secure bank, secure bank, and the HDCP 1.4 key sink. */
+#define SUNXI_CE_NS_BASE		0x03040000
+#define SUNXI_CE_S_BASE			0x03040800
+#define SUNXI_HDCP14_SINK		0x03041400
 #define SUNXI_SPC_BASE			0x03008000
 #define SUNXI_WDOG_BASE			0x02051000
 #define SUNXI_PIO_BASE			0x02000000
diff --git a/plat/allwinner/sun50i_h713/platform.mk b/plat/allwinner/sun50i_h713/platform.mk
index 668491173..bade27257 100644
--- a/plat/allwinner/sun50i_h713/platform.mk
+++ b/plat/allwinner/sun50i_h713/platform.mk
@@ -24,3 +24,54 @@ BL31_SOURCES		+=	common/fdt_wrappers.c			\
 				drivers/allwinner/sunxi_rsb.c		\
 				drivers/mentor/i2c/mi2cv.c		\
 				${AW_PLAT}/${PLAT}/sunxi_h713_dtb.c
+
+# FB-HDCP14h: the vendor's own OP-TEE 3.7 as BL32. Its sunxi file header gives the run
+# address 0x48600000 (offset 0x2c) and the vendor DTS reserves 1 MiB there. The SPL loads
+# it from the FIT, so BL31 only has to enter it.
+# The vendor OP-TEE variant needs the AArch32 hand-over; our own TSP does not.
+# The slot the vendor DTS reserves for a Trusted OS; our own payload uses it too.
+# This must be a -D: platform_def.h carries an older "#ifndef BL32_BASE ->
+# SUNXI_DRAM_BASE" fallback that would otherwise win and send BL31 to 0x40000000
+# (measured 05.10. 05:12 - BL31 jumped into nothing and the watchdog reset the board).
+# Only when there IS a secure payload. Our own HDCP chain runs entirely in BL31 and
+# needs none - and without BL32_BASE there is no reserved window either, which
+# matters: the kernel is uncompressed to 0x48000000 and is some 20 MB, so a
+# reservation at 0x48600000 makes U-Boot refuse the allocation outright
+# ("Unable to allocate memory 0x48000000 for loading OS", measured 05.10. 06:1x).
+# Explicit, never derived: at the time this file is included SPD is still EMPTY,
+# not "none", so "ifneq (${SPD},none)" was always true and the reservation below
+# kept blocking the kernel's own window (measured 05.10. 06:1x - reserved[1]
+# 0x48600000..0x486fffff no-map, and bootm refused 0x48000000).
+ifeq (${H713_WITH_BL32},1)
+BL31_CPPFLAGS		+=	-DBL32_BASE=0x48600000
+BL31_CPPFLAGS		+=	-DH713_WITH_BL32
+endif
+
+# The vendor OP-TEE is a 32-bit image and must be entered in AArch32 SVC; our own
+# payload is AArch64. Explicit on the command line, not derived from SPD - deriving
+# it silently produced an AArch64 hand-over to the 32-bit image (spsr 0x3c5,
+# measured 05.10. 05:34) and the vendor OS died without a word.
+ifeq (${H713_BL32_AARCH32},1)
+BL31_CPPFLAGS		+=	-DH713_BL32_AARCH32
+endif
+BL31_CPPFLAGS		+=	-DH713_VENDOR_SECURITY_SETUP
+BL31_CPPFLAGS		+=	-DH713_WDOG_BRINGUP
+
+# The workbench probes in the SiP (and the CE dump) are off by default: a release
+# image carries only the version call and PUSH_FROM. Turn them on deliberately with
+# H713_HDCP_RESEARCH=1, and never ship that image (sunxi_h713_sip.c, doku/148 §2).
+H713_HDCP_RESEARCH	?=	0
+ifeq (${H713_HDCP_RESEARCH},1)
+BL31_CPPFLAGS		+=	-DH713_HDCP_RESEARCH=1
+# read-only CE dump from EL3 - diagnosis only
+BL31_SOURCES		+=	${AW_PLAT}/${PLAT}/sunxi_h713_cedump.c
+endif
+
+# FB-HDCP14i: our own HDCP 1.4 path from EL3 (the CE task the engine refuses so far).
+# Built INTO the image that also brings up the vendor BL32, so the same run can do
+# "our task - vendor task - our task again" and tell state apart from descriptor.
+# the SiP maps the caller's page on demand
+PLAT_XLAT_TABLES_DYNAMIC	:=	1
+BL31_CPPFLAGS		+=	-DPLAT_XLAT_TABLES_DYNAMIC=1
+
+BL31_SOURCES		+=	${AW_PLAT}/${PLAT}/sunxi_h713_sip.c
diff --git a/plat/allwinner/sun50i_h713/sunxi_h713_cedump.c b/plat/allwinner/sun50i_h713/sunxi_h713_cedump.c
new file mode 100644
index 000000000..f1efb0e2f
--- /dev/null
+++ b/plat/allwinner/sun50i_h713/sunxi_h713_cedump.c
@@ -0,0 +1,171 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * FB-HDCP14h, diagnosis only: read the Crypto Engine's secure bank and the task
+ * descriptor the last task used, from EL3, and print them.
+ *
+ * Why this exists: the vendor Trusted OS gets the engine to accept key-select 3
+ * (measured: op 5 returns 0 and the key lands in the receiver's sink), while the
+ * same operation issued from our own EL3 is refused with ESR 0x11. The engine's
+ * secure bank reads as zero from the non-secure world, so U-Boot cannot show the
+ * difference. This service reads it after a successful vendor task, so the two
+ * descriptors can be compared field by field.
+ *
+ * It prints CONTROL fields and ADDRESSES only - the first 0x40 bytes of the
+ * descriptor. It never reads or prints the source data those addresses point at,
+ * because that is key material.
+ */
+
+#include <common/debug.h>
+#include <common/runtime_svc.h>
+#include <lib/mmio.h>
+#include <lib/xlat_tables/xlat_tables_v2.h>
+#include <sunxi_mmap.h>
+
+#define H713_SIP_CE_DUMP	U(0x82000020)
+#define CE_S			0x03040800
+#define CE_NS			0x03040000
+/*
+ * The key ladder's control/status block. 0x03041400 is the HDCP key SINK and is
+ * deliberately NOT read here: we need to know whether the ladder unlocks
+ * key-select 3, which is a control question, and never the key material.
+ */
+#define CE_LADDER		0x03041000
+#define CE_LADDER_LEN		0x100
+/*
+ * The secure-DRAM region block. Our sunxi_security.c mirrors the vendor BL31 and
+ * writes 0x02001750 = 0x10000 then 0x10001 there - region descriptor, then arm.
+ * If that region covers OP-TEE's TEE RAM and not BL31's 256 KiB, the hardware
+ * refuses key-select 3 on our buffers while key-select 0 passes. Control fields
+ * and bounds only.
+ */
+#define SEC_REGION		0x02001700
+#define SEC_REGION_LEN		0x80
+/*
+ * Where the vendor Trusted OS builds its task descriptors. Only TDA is cleared
+ * when a task finishes - the descriptor bytes stay in its memory, and from EL3
+ * we may read them. That is the one way to compare our request with the one the
+ * engine actually accepts, without a second core polling TDA in flight.
+ *
+ * Printed are control fields and addresses only. The bytes those addresses point
+ * at are the device's own key material: we need the interface, not the material
+ * (§ 69d/69e UrhG), and nothing dereferences them here.
+ */
+#define TEE_SCAN_BASE		0x48600000
+#define TEE_SCAN_MAP		0x600000
+#define TEE_SCAN_LEN		0x500000
+#define DESC_STRIDE		0x40
+#define SYM_KEYSEL(v)		(((v) >> 20) & 0xf)
+
+static void dump_bank(const char *what, uintptr_t base)
+{
+	unsigned int i;
+
+	for (i = 0; i < 0x30; i += 0x10)
+		NOTICE("CEdump %s+%02x: %08x %08x %08x %08x\n", what, i,
+		       mmio_read_32(base + i), mmio_read_32(base + i + 4),
+		       mmio_read_32(base + i + 8), mmio_read_32(base + i + 12));
+}
+
+/* Read a five-byte little-endian address field out of a descriptor. */
+static uint64_t desc_addr(uintptr_t d, unsigned int off)
+{
+	uint64_t v = 0;
+	unsigned int i;
+
+	for (i = 0; i < 5U; i++)
+		v |= (uint64_t)(*(volatile uint8_t *)(d + off + i)) << (8U * i);
+	return v;
+}
+
+/*
+ * Walk the Trusted OS's memory for anything that looks like a Crypto Engine task
+ * descriptor: the go bit set, a sane length, and either the HDCP key sink as its
+ * destination or key-select 3 - the two things we cannot get the engine to accept.
+ */
+static void h713_ce_find_descriptors(void)
+{
+	unsigned int found = 0U;
+	uintptr_t d;
+
+	if (mmap_add_dynamic_region(TEE_SCAN_BASE, TEE_SCAN_BASE, TEE_SCAN_MAP,
+				    MT_MEMORY | MT_RO | MT_SECURE |
+				    MT_EXECUTE_NEVER) != 0) {
+		NOTICE("CEscan: cannot map the Trusted OS's memory\n");
+		return;
+	}
+	for (d = TEE_SCAN_BASE; d < TEE_SCAN_BASE + TEE_SCAN_LEN;
+	     d += DESC_STRIDE) {
+		uint32_t common = mmio_read_32(d + 0x04);
+		uint32_t sym    = mmio_read_32(d + 0x08);
+		uint32_t len    = mmio_read_32(d + 0x20);
+		uint64_t dst    = desc_addr(d, 0x29);
+
+		if ((common & 0x80000000U) == 0U)
+			continue;
+		if (len == 0U || len > 0x1000U || (len & 0xfU) != 0U)
+			continue;
+		/*
+		 * Every plausible task, not just the sink one: the unwrap uses
+		 * key-select 0 into DRAM and was filtered away before, although
+		 * it is exactly the descriptor we need to copy (05.10. 06:3x,
+		 * our own unwrap differed from the vendor's in 287 of 288 bytes).
+		 */
+		if (len > 0x400U)
+			continue;
+		NOTICE("CEscan @%08lx: chan %08x common %08x sym %08x (keysel %u)\n",
+		       (unsigned long)d, mmio_read_32(d), common, sym,
+		       SYM_KEYSEL(sym));
+		NOTICE("CEscan @%08lx: len %08x src_len %08x dst_len %08x\n",
+		       (unsigned long)d, len, mmio_read_32(d + 0x30),
+		       mmio_read_32(d + 0x34));
+		NOTICE("CEscan @%08lx: key %010lx iv %010lx src %010lx dst %010lx\n",
+		       (unsigned long)d, (unsigned long)desc_addr(d, 0x10), (unsigned long)desc_addr(d, 0x15),
+		       (unsigned long)desc_addr(d, 0x24), (unsigned long)dst);
+		if (++found >= 10U)
+			break;
+	}
+	NOTICE("CEscan: %u candidate descriptor(s) in the Trusted OS's memory\n",
+	       found);
+	mmap_remove_dynamic_region(TEE_SCAN_BASE, TEE_SCAN_MAP);
+}
+
+uintptr_t h713_ce_dump(void)
+{
+	uint32_t tda = mmio_read_32(CE_S);
+	unsigned int i;
+
+	dump_bank("S ", CE_S);
+	dump_bank("NS", CE_NS);
+	NOTICE("CEdump ESR=%08x TSR=%08x (0x11 is what key-select 3 answers us)\n",
+	       mmio_read_32(CE_S + 0x18), mmio_read_32(CE_S + 0x14));
+	for (i = 0; i < CE_LADDER_LEN; i += 0x10)
+		NOTICE("CEdump LAD+%02x: %08x %08x %08x %08x\n", i,
+		       mmio_read_32(CE_LADDER + i),
+		       mmio_read_32(CE_LADDER + i + 4),
+		       mmio_read_32(CE_LADDER + i + 8),
+		       mmio_read_32(CE_LADDER + i + 12));
+	for (i = 0; i < SEC_REGION_LEN; i += 0x10)
+		NOTICE("CEdump SEC+%02x: %08x %08x %08x %08x\n", i,
+		       mmio_read_32(SEC_REGION + i),
+		       mmio_read_32(SEC_REGION + i + 4),
+		       mmio_read_32(SEC_REGION + i + 8),
+		       mmio_read_32(SEC_REGION + i + 12));
+	h713_ce_find_descriptors();
+	NOTICE("CEdump TDA=%08x (the descriptor of the last task)\n", tda);
+	if (tda >= SUNXI_DRAM_BASE && tda < (uintptr_t)(SUNXI_DRAM_BASE + 0x40000000ULL)) {
+		for (i = 0; i < 0x40; i += 0x10)
+			NOTICE("CEdump desc+%02x: %08x %08x %08x %08x\n", i,
+			       mmio_read_32(tda + i), mmio_read_32(tda + i + 4),
+			       mmio_read_32(tda + i + 8), mmio_read_32(tda + i + 12));
+	} else {
+		NOTICE("CEdump: TDA is not in DRAM, descriptor not shown\n");
+	}
+	return tda;
+}
