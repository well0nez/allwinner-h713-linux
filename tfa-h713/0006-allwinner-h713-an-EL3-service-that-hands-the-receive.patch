diff --git a/plat/allwinner/common/include/platform_def.h b/plat/allwinner/common/include/platform_def.h
index c9d075ac8..a9be8dfc5 100644
--- a/plat/allwinner/common/include/platform_def.h
+++ b/plat/allwinner/common/include/platform_def.h
@@ -18,7 +18,8 @@
 #define BL31_BASE			SUNXI_DRAM_BASE
 #define BL31_LIMIT			(SUNXI_DRAM_BASE + 0x40000)
 
-#define MAX_XLAT_TABLES			4
+/* 4 was exactly the static need; the SiP maps one scratch page dynamically. */
+#define MAX_XLAT_TABLES			8
 #define PLAT_VIRT_ADDR_SPACE_SIZE	(1ULL << 32)
 
 #define SUNXI_BL33_VIRT_BASE		PRELOADED_BL33_BASE
@@ -81,4 +82,30 @@
 #endif
 #endif
 
+
+/*
+ * FB-HDCP14i: our own secure payload at S-EL1. The vendor DTS reserves 1 MiB at
+ * 0x48600000 for a Trusted OS and the SPL already loads a "tee" image there from
+ * the FIT, so our payload takes the same slot - the only context in which the
+ * Crypto Engine's key-select 3 has never been tried.
+ */
+#ifndef BL32_BASE
+#define BL32_BASE			0x48600000
+#endif
+#define BL32_LIMIT			(BL32_BASE + 0x100000)
+#define TSP_SEC_MEM_BASE		BL32_BASE
+#define TSP_SEC_MEM_SIZE		(BL32_LIMIT - BL32_BASE)
+#define TSP_PROGBITS_LIMIT		BL32_LIMIT
+/* The secure physical timer's PPI - architectural, 29 on every GICv2 A53. */
+#define TSP_IRQ_SEC_PHY_TIMER		U(29)
+/*
+ * The one window through which the normal world hands the payload something to
+ * work on. Bounded and mapped on purpose: the payload maps its own memory and
+ * the device registers, nothing else, so a caller buffer anywhere in DRAM would
+ * fault. 2 MiB is one block at this granularity and far more than the 288 bytes
+ * a key set needs.
+ */
+#define H713_TSP_IN_BASE		U(0x4c000000)
+#define H713_TSP_IN_SIZE		U(0x200000)
+
 #endif /* PLATFORM_DEF_H */
