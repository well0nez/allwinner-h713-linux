+
+/*
+ * H713 SiP service: the HDCP 1.4 key through the Crypto Engine from EL3.
+ *
+ * Road 6b of doku/112: the 288-byte key item (AES-128 ECB under the RSSK, the
+ * eFuse key behind key-select 3) is decrypted by the engine straight into the
+ * HDMI receiver's key sink 0x03041400, as OP-TEE does it on the stock chain
+ * (sunxi_load_hdcp_key 0x4860caf0 -> sunxi_aes_with_hardware 0x4860c578) -
+ * from EL3 on the secure bank CE_S, for the case that the non-secure bank does
+ * not serve key-select 3 to the Linux driver h713-ce. Same vendor descriptor
+ * (doku/nachtlog/S49), same gate (doku/112 0 rule 4: the KAT before the first
+ * key-select 3 task of a boot, BL31's own RSSK probe before the first sink
+ * transfer). The engine only touches BL31's DRAM; the caller's buffer is read
+ * by the CPU once, through the static BL33 window or a temporary page
+ * mapping, and the caller cleans its cache first. No plaintext reaches DRAM.
+ *
+ * SMC32 fast calls, owner SiP: 0x82000010 HDCP14_LOAD (x1 = phys of the
+ * ciphertext, 64-byte aligned NS DRAM, x2 = 288); 0x82000011 HDCP14_PROBE
+ * (x1 = phys of a 16-byte result buffer, x2 = 16: the RSSK probe, its result
+ * copied to x1 for the caller to classify, never printed); 0x8200ff03
+ * SIP_SVC_VERSION (1, 0). x0 on return: 0; SMC_UNK for an unknown call, a bad
+ * address or length; an H713_SIP_E_* code; or 0x100 | the ESR byte. The two
+ * success lines are NOTICE so that a DEBUG=0 build shows them on the UART.
+ */
+
+#include <string.h>
+
+#include <platform_def.h>
+
+#include <arch_helpers.h>
+#include <common/debug.h>
+#include <common/runtime_svc.h>
+#include <drivers/delay_timer.h>
+#include <lib/mmio.h>
+#include <lib/spinlock.h>
+#include <libfdt.h>
+#include <common/fdt_wrappers.h>
+#include <sunxi_private.h>
+#include <lib/utils.h>
+#include <lib/xlat_tables/xlat_tables_v2.h>
+
+#include <sunxi_mmap.h>
+
+/*
+ * The services below fall into two groups. Only two of them are needed to run a
+ * device: the version call and PUSH_FROM, which puts a staged key set into the
+ * receiver's sink. Everything else exists because we had to find out HOW this
+ * engine behaves - probes that run engine tasks with caller-chosen key slots,
+ * lengths and addresses, dump descriptors, or read eFuse flags.
+ *
+ * Those belong on a workbench, not in a shipped image: they let the normal world
+ * drive the Crypto Engine far more freely than booting a projector requires, and
+ * every one of them is attack surface for no gain. They are compiled only with
+ * H713_HDCP_RESEARCH=1 and are absent from a release build.
+ *
+ * What remains reachable is deliberate and bounded: PUSH_FROM accepts one source
+ * address inside the Trusted OS window, with a fixed length, and the destination
+ * is always the key sink. The worst a caller can do is install a key set that
+ * does not authenticate - it can never read one back, because the engine refuses
+ * the hardware key towards readable memory by design (doku/148 §0).
+ */
+#ifndef H713_HDCP_RESEARCH
+#define H713_HDCP_RESEARCH	0
+#endif
+
+#define H713_SIP_HDCP14_LOAD	U(0x82000010)
+#define H713_SIP_HDCP14_PROBE	U(0x82000011)
+#define H713_SIP_EFUSE_FLAGS	U(0x82000012)
+#define H713_SIP_SVC_VERSION	U(0x8200ff03)
+#define H713_SIP_CE_DUMP	U(0x82000020)
+/*
+ * FB-HDCP14i: does key-select 3 refuse every length, or only the short one our
+ * own probe uses? ce_rssk_probe() runs ONE AES block (16 B) and gates the
+ * 288-byte push on it - but the vendor never issues a short key-select-3 task,
+ * it always issues 288 bytes. If the engine answers 16 bytes with ESR 0x11 and
+ * 288 bytes with 0, then our gate has been refusing the operation, not the
+ * engine. Result to DRAM, not the sink; the plaintext stays inside BL31 and is
+ * never returned or printed - only the error code leaves this function.
+ */
+#define H713_SIP_CE_KS3_LEN	U(0x82000013)
+#define H713_SIP_CE_KS3_AT	U(0x82000014)
+#define H713_SIP_SID_FLAGS	U(0x82000015)
+/*
+ * Does the engine let us write the sink at all, or only with its own key? op 5's
+ * input is already PLAINTEXT, so the key-select field there may not touch the data
+ * path at all. If a key-select-0 task into the sink is accepted, delivering the key
+ * set is ours and only the unwrap stays hardware-bound.
+ */
+#define H713_SIP_SINK_KS0	U(0x82000016)
+/*
+ * The sharpest experiment available: the vendor Trusted OS leaves its finished
+ * task descriptor in memory, with the buffers it points at. We start THAT
+ * descriptor from our own code - same fields, same addresses, same buffers, only
+ * a different issuer. Works -> the engine does not care who asks, and the
+ * difference is a property of our buffers. Fails -> the hardware really does
+ * distinguish, which is a fact worth having.
+ *
+ * Guarded to exactly the shape we are after: destination the HDCP key sink,
+ * length 288, key-select 3. Nothing here reads the buffers; we re-run an
+ * operation the device itself prepared for its own licence.
+ */
+#define H713_SIP_RERUN		U(0x82000017)
+/*
+ * The whole chain in one call, ours end to end: unwrap the device's stored record
+ * with the wrapping key the caller points at (key-select 0, sym_ctl 0x100 - the
+ * engine's own key is NOT involved here), then hand the key set to the receiver's
+ * sink with key-select 3. The plaintext exists only inside this function, is never
+ * returned and is wiped before it leaves.
+ */
+#define H713_SIP_HDCP14_FULL	U(0x82000018)
+/*
+ * Diagnosis only, and only while a vendor Trusted OS is around to serve as an
+ * oracle: unwrap the record with our own parameters and compare the result,
+ * byte for byte, with the plaintext the vendor produced. Reported is the NUMBER
+ * of differing bytes and nothing else - we need to know whether our unwrap is
+ * right, not what it contains. Both buffers are wiped before returning.
+ */
+#define H713_SIP_UNWRAP_CMP	U(0x82000019)
+/*
+ * The same comparison, but over the whole small space of unknowns in one call:
+ * sym_ctl candidates x input length x direction. The call site at 0x48626214
+ * pushes 0x10 / 0x100 / 1 onto the stack and the shared task function reads them
+ * as [r7,#0xb8/0xbc/0xc0] - which slot is which is an assumption, so rather than
+ * spend a device run per guess, try them all against the oracle and print only
+ * the number of differing bytes per combination.
+ */
+#define H713_SIP_UNWRAP_SWEEP	U(0x8200001a)
+/*
+ * Plain byte comparison of 288 bytes at two addresses, reporting only how many
+ * differ. Used to ask the one question left: are the bytes we read out of the
+ * secure storage the same ones the vendor's task hands to the sink? No content
+ * is printed - a count is not the material.
+ */
+#define H713_SIP_CMP_PLAIN	U(0x8200001b)
+/*
+ * The same sink push, but with the descriptor's source pointing where the caller
+ * says - specifically into the Trusted OS's window. Our data is byte-identical to
+ * the vendor's (0 of 288 differ, measured 05.10. 07:1x) and the engine answers 0x0
+ * either way, yet only the vendor's push authenticates. The one structural
+ * difference left is the region the DMA reads from, and this asks that question.
+ */
+#define H713_SIP_PUSH_FROM	U(0x8200001c)
+#define KEYBOX_WRAP_SYM		U(0x100)	/* key-select 0, bit 8 as the vendor sets it */
+#define KEYBOX_WRAP_KEYLEN	U(16)
+#define KEYBOX_RECORD_LEN	U(320)
+
+uintptr_t h713_ce_dump(void);
+#define H713_SIP_E_KAT		U(0x10)	/* BL31's known-answer test failed */
+#define H713_SIP_E_BUSY		U(0x11)	/* the task never loaded (TLR busy) */
+#define H713_SIP_E_TIMEOUT	U(0x12)	/* no completion within 200 ms */
+#define H713_SIP_E_MAP		U(0x13)	/* the caller's page cannot be mapped */
+#define H713_SIP_E_RSSK		U(0x14)	/* BL31's own RSSK probe did not pass */
+#define H713_SIP_E_CLOCK	U(0x15)	/* the CE clocks or resets are off */
+#define H713_SIP_E_OVERRUN	U(0x16)	/* the engine wrote past the length */
+#define H713_SIP_E_ESR		U(0x100)
+
+/* CE_S registers as OP-TEE programs them (0x4860c2ac..0x4860c360), channel 0. */
+#define CE_S_TDA		(SUNXI_CE_S_BASE + 0x00)
+#define CE_S_ICR		(SUNXI_CE_S_BASE + 0x08)
+#define CE_S_ISR		(SUNXI_CE_S_BASE + 0x0c)
+#define CE_S_TLR		(SUNXI_CE_S_BASE + 0x10)
+#define CE_S_ESR		(SUNXI_CE_S_BASE + 0x18)
+#define CE_ISR_PAIR		U(3)		/* done, error */
+/* CCU: CE clock enable bit 31; bus gates 1:0 and resets 17:16; mbus-ce bit 2 */
+#define CCU_CE_CLK_REG		(SUNXI_CCU_BASE + 0x680)
+#define CCU_CE_BGR_REG		(SUNXI_CCU_BASE + 0x68c)
+#define CCU_MBUS_GATE_REG	(SUNXI_CCU_BASE + 0x804)
+
+/*
+ * Read-only eFuse sense as stock BL31 (monitor.bin 0x4800237c): the burned-
+ * flags word (direct shadow 0x03006240, eFuse byte offset 0x40) read through
+ * the SID_PRCTL path with the 0xac02 READ trigger only - never the 0xac01
+ * program trigger, never the eFuse HV at R_PRCM 0x07090204 (the write
+ * primitive 0x480022f8). Returned: only the burned bits 16/17/21
+ * (SSK/RSSK/hdcppkf), the two shadow words and, as control, the word at 0x48
+ * (shadow 0x03006248); no key byte, no other offset.
+ */
+#define SID_PRCTL		(SUNXI_SID_BASE + 0x40)
+#define SID_PRD			(SUNXI_SID_BASE + 0x60)
+#define SID_PRCTL_RD		U(0xac02)	/* key 0xac, read-enable bit 1 */
+#define SID_FLAGS_OFF		U(0x40)		/* the burned-flags word */
+#define SID_CTRL_OFF		U(0x48)		/* control: its shadow 0x03006248 is non-zero */
+#define SID_FLAGS_SHADOW	(SUNXI_SID_BASE + 0x240)
+#define SID_FLAGS_SHADOW2	(SUNXI_SID_BASE + 0x248)
+#define SID_BURNED_BITS		(BIT_32(16) | BIT_32(17) | BIT_32(21))
+
+#define AES_BLOCK		16
+#define HDCP14_LEN		288
+/* One 64-byte aligned block, the layout of the Linux driver h713-ce. */
+#define BUF_DESC		0x000	/* the 0x100-byte task descriptor */
+#define BUF_KEY			0x100
+#define BUF_IV			0x140
+#define BUF_SRC			0x180
+#define BUF_DST			0x2c0
+#define BUF_SIZE		0x400
+
+static uint8_t ce_buf_own[BUF_SIZE] __aligned(64);
+/*
+ * Normally BL31's own block. The last untested difference to the vendor is WHERE the
+ * descriptor and buffers live: OP-TEE builds them on its stack in the TEE RAM area
+ * (0x486xxxxx), ours sit in BL31's 256 KiB (measured CE_S +0x20 = 0x4001225c). FID
+ * 0x82000014 points this at a caller-given page so the very same task can be issued
+ * from the vendor's own memory region; everything else stays identical.
+ */
+static uint8_t *ce_buf = ce_buf_own;
+static spinlock_t ce_lock;
+static bool kat_passed, rssk_passed;
+
+/* FIPS-197 C.1, and AES-128 decryption of zero under the all-zero key. */
+static const uint8_t kat_key[AES_BLOCK] = {
+	0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
+	0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f };
+static const uint8_t kat_plain[AES_BLOCK] = {
+	0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77,
+	0x88, 0x99, 0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff };
+static const uint8_t kat_cipher[AES_BLOCK] = {
+	0x69, 0xc4, 0xe0, 0xd8, 0x6a, 0x7b, 0x04, 0x30,
+	0xd8, 0xcd, 0xb7, 0x80, 0x70, 0xb4, 0xc5, 0x5a };
+static const uint8_t zero_key_decrypt_of_zero[AES_BLOCK] = {
+	0x14, 0x0f, 0x0f, 0x10, 0x11, 0xb5, 0x22, 0x3d,
+	0x79, 0x58, 0x77, 0x17, 0xff, 0xd9, 0xec, 0x3a };
+/* The zero block decrypted under the KAT key: an engine that kept the last software key. */
+static const uint8_t kat_key_decrypt_of_zero[AES_BLOCK] = {
+	0x7b, 0x1d, 0x29, 0xa1, 0x6c, 0xf8, 0xcc, 0xab,
+	0x84, 0xf0, 0xb8, 0xa5, 0x98, 0xe4, 0x2f, 0xa6 };
+
+static void put_bytes(unsigned int off, uint64_t v, unsigned int n)
+{
+	unsigned int i;
+
+	for (i = 0; i < n; i++)
+		ce_buf[BUF_DESC + off + i] = (uint8_t)(v >> (8 * i));
+}
+
+/*
+ * One task on CE_S in the order of OP-TEE 0x4860c6a6..0x4860c6d4: TDA, ICR,
+ * TLR; poll ISR; acknowledge; clear. Caller holds ce_lock and has filled key
+ * and source; @dst is BL31's result buffer or the sink. The clocks are on
+ * from the SPL and held by Linux's h713-ce; a gated engine would hang the bus.
+ */
+/*
+ * The engine's key select lives in bits 23:20 of sym_ctl, but the vendor's unwrap
+ * also sets bit 8 (sym_ctl 0x100 with key-select 0, read out of its own code at
+ * 0x48626214). So the field is passed through whole rather than derived from a
+ * key-select number alone.
+ */
+static uint32_t ce_run_full(bool decrypt, uint32_t sym_ctl, unsigned int len,
+			    uintptr_t src, uintptr_t dst)
+{
+	uintptr_t buf = (uintptr_t)ce_buf;
+	uint64_t timeout;
+	uint32_t isr, esr;
+
+	if ((mmio_read_32(CCU_CE_CLK_REG) & BIT_32(31)) == 0 ||
+	    (mmio_read_32(CCU_CE_BGR_REG) & 0x30003) != 0x30003 ||
+	    (mmio_read_32(CCU_MBUS_GATE_REG) & BIT_32(2)) == 0)
+		return H713_SIP_E_CLOCK;
+	memset(ce_buf + BUF_DESC, 0, 0x100);
+	memset(ce_buf + BUF_IV, 0, AES_BLOCK);
+	if (dst != SUNXI_HDCP14_SINK)
+		memset(ce_buf + BUF_DST, 0, BUF_SIZE - BUF_DST);
+	put_bytes(0x04, BIT_32(31) | (decrypt ? BIT_32(8) : 0), 4); /* comm_ctl */
+	put_bytes(0x08, sym_ctl, 4);			/* sym_ctl as given */
+	put_bytes(0x10, buf + BUF_KEY, 5);		/* five-byte addresses */
+	put_bytes(0x15, buf + BUF_IV, 5);
+	put_bytes(0x20, len, 4);			/* data_len */
+	put_bytes(0x24, src, 5);
+	put_bytes(0x29, dst, 5);
+	put_bytes(0x30, len, 4);			/* src_len, dst_len */
+	put_bytes(0x34, len, 4);
+	/* The engine reads DRAM, not our cache: clean and invalidate the block. */
+	flush_dcache_range(buf, BUF_SIZE);
+
+	mmio_write_32(CE_S_TDA, (uint32_t)(buf + BUF_DESC));
+	mmio_setbits_32(CE_S_ICR, BIT_32(0));
+	timeout = timeout_init_us(10000);
+	while ((mmio_read_32(CE_S_TLR) & BIT_32(0)) != 0) {
+		if (timeout_elapsed(timeout)) {
+			mmio_write_32(CE_S_ICR, 0);
+			mmio_write_32(CE_S_TDA, 0);
+			return H713_SIP_E_BUSY;
+		}
+	}
+	mmio_setbits_32(CE_S_TLR, BIT_32(0));
+	timeout = timeout_init_us(200000);
+	do {
+		isr = mmio_read_32(CE_S_ISR);
+	} while ((isr & CE_ISR_PAIR) == 0 && !timeout_elapsed(timeout));
+	esr = mmio_read_32(CE_S_ESR) & 0xff;
+	mmio_write_32(CE_S_ISR, CE_ISR_PAIR | (isr & 0xff));
+	mmio_write_32(CE_S_ICR, 0);
+	mmio_write_32(CE_S_TLR, 0);
+	mmio_write_32(CE_S_TDA, 0);
+	if (dst != SUNXI_HDCP14_SINK)
+		inv_dcache_range(buf + BUF_DST, BUF_SIZE - BUF_DST);
+	if ((isr & CE_ISR_PAIR) == 0)
+		return H713_SIP_E_TIMEOUT;
+	if (dst != SUNXI_HDCP14_SINK) {
+		unsigned int i;
+
+		for (i = BUF_DST + len; i < BUF_SIZE; i++)
+			if (ce_buf[i] != 0)
+				return H713_SIP_E_OVERRUN;
+	}
+	return (esr != 0) ? (H713_SIP_E_ESR | esr) : 0;
+}
+
+static uint32_t ce_run_sym(bool decrypt, uint32_t sym_ctl, unsigned int len,
+			   uintptr_t dst)
+{
+	return ce_run_full(decrypt, sym_ctl, len,
+			   (uintptr_t)ce_buf + BUF_SRC, dst);
+}
+
+static uint32_t ce_run(bool decrypt, unsigned int keysel, unsigned int len,
+		       uintptr_t dst)
+{
+	return ce_run_sym(decrypt, (uint32_t)keysel << 20, len, dst);
+}
+
+/* Three tasks with key-select 0 to DRAM; the vectors are public. */
+static uint32_t ce_kat(void)
+{
+	static const unsigned int repeats[3] = { 1, 1, HDCP14_LEN / AES_BLOCK };
+	unsigned int i, r;
+	uint32_t ret;
+
+	kat_passed = false;
+	memcpy(ce_buf + BUF_KEY, kat_key, AES_BLOCK);
+	for (i = 0; i < 3; i++) {
+		const uint8_t *in = (i != 0) ? kat_cipher : kat_plain;
+		const uint8_t *want = (i != 0) ? kat_plain : kat_cipher;
+
+		for (r = 0; r < repeats[i]; r++)
+			memcpy(ce_buf + BUF_SRC + r * AES_BLOCK, in, AES_BLOCK);
+		ret = ce_run(i != 0, 0, repeats[i] * AES_BLOCK,
+			     (uintptr_t)ce_buf + BUF_DST);
+		for (r = 0; ret == 0 && r < repeats[i]; r++)
+			if (memcmp(ce_buf + BUF_DST + r * AES_BLOCK, want, AES_BLOCK) != 0)
+				ret = H713_SIP_E_KAT;
+		if (ret != 0) {
+			ERROR("H713 SiP: KAT step %u: 0x%x\n", i, ret);
+			return H713_SIP_E_KAT;
+		}
+	}
+	zeromem(ce_buf + BUF_KEY, 64);
+	kat_passed = true;
+	NOTICE("H713 SiP: KAT passed on CE_S (encrypt 16, decrypt 16, decrypt 288, key-select 0)\n");
+	return 0;
+}
+
+/* 16 zero bytes, key-select 3, to DRAM; classified, never printed. */
+static uint32_t __unused ce_rssk_probe(void)
+{
+	static const uint8_t zero[AES_BLOCK];
+	const uint8_t *got = ce_buf + BUF_DST;
+	uint32_t ret;
+
+	rssk_passed = false;
+	zeromem(ce_buf + BUF_KEY, 64);
+	memset(ce_buf + BUF_SRC, 0, AES_BLOCK);
+	ret = ce_run(true, 3, AES_BLOCK, (uintptr_t)ce_buf + BUF_DST);
+	if (ret == 0)
+		rssk_passed = memcmp(got, zero, AES_BLOCK) != 0 &&
+			      memcmp(got, zero_key_decrypt_of_zero, AES_BLOCK) != 0 &&
+			      memcmp(got, kat_key_decrypt_of_zero, AES_BLOCK) != 0;
+	if (!rssk_passed)
+		ERROR("H713 SiP: RSSK probe on CE_S not passed (0x%x)\n", ret);
+	return ret;
+}
+
+/*
+ * The end of the populated DRAM, from the /memory node of the DTB U-Boot
+ * carries: the sunxi DRAM window aliases above the fitted size, so 4 GiB is
+ * no bound. Without a usable node the smallest fitted size, 1 GiB, is the
+ * bound (deep review 27.09.2026).
+ */
+static uintptr_t sunxi_dram_end(void)
+{
+	static uintptr_t end;
+	const void *dtb = sunxi_get_dtb();
+	uint32_t reg[4];
+	int node;
+
+	if (end != 0)
+		return end;
+	end = SUNXI_DRAM_BASE + (1U << 30);
+	if (dtb == NULL)
+		return end;
+	node = fdt_path_offset(dtb, "/memory");
+	if (node < 0)
+		node = fdt_node_offset_by_prop_value(dtb, -1, "device_type",
+						     "memory", 7);
+	if (node >= 0 && fdt_read_uint32_array(dtb, node, "reg", 4, reg) == 0) {
+		uint64_t base = ((uint64_t)reg[0] << 32) | reg[1];
+		uint64_t size = ((uint64_t)reg[2] << 32) | reg[3];
+
+		if (base == SUNXI_DRAM_BASE && size >= (256U << 20) &&
+		    base + size <= (1ULL << 32))
+			end = (uintptr_t)(base + size);
+	}
+	return end;
+}
+
+/*
+ * The caller's buffer: DRAM only, outside BL31, 64-byte aligned. Inside the
+ * BL33 window the static mapping serves, elsewhere one or two pages are
+ * mapped for the copy and unmapped again.
+ */
+/*
+ * One key-select-3 task of @len bytes into BL31's own buffer. Only the engine's
+ * verdict is returned; the bytes the engine produces are zeroed again here, so
+ * nothing derived from the hardware key leaves this function.
+ */
+/*
+ * The same 288-byte key-select-3 task, but with descriptor and buffers in the page
+ * at @pa (one 64-byte-aligned, BUF_SIZE-sized scratch area, caller's choice). Only
+ * the engine's verdict is returned and the scratch area is wiped again.
+ */
+static uint32_t __unused ce_ks3_at(u_register_t pa, u_register_t len, u_register_t keep)
+{
+	uintptr_t page = pa & ~PAGE_SIZE_MASK;
+	size_t mapped = round_up(pa + BUF_SIZE, PAGE_SIZE) - page;
+	uint32_t ret;
+
+	if ((pa & 0x3fUL) != 0UL || pa < SUNXI_DRAM_BASE ||
+	    (pa < BL31_LIMIT && pa + BUF_SIZE > BL31_BASE))
+		return (uint32_t)SMC_UNK;
+	if (len == 0UL || len > (BUF_SIZE - BUF_DST) ||
+	    (len & (AES_BLOCK - 1)) != 0UL)
+		return (uint32_t)SMC_UNK;
+	spin_lock(&ce_lock);
+	/*
+	 * The static mapping already serves the BL33 window; asking for a dynamic
+	 * region inside it collides and answers E_MAP (cost me one run, 01:06).
+	 */
+	if (pa >= PRELOADED_BL33_BASE &&
+	    pa + BUF_SIZE <= PRELOADED_BL33_BASE + SUNXI_DRAM_MAP_SIZE) {
+		mapped = 0;
+	} else if (mmap_add_dynamic_region(page, page, mapped,
+					   MT_MEMORY | MT_RW | MT_SECURE |
+					   MT_EXECUTE_NEVER) != 0) {
+		spin_unlock(&ce_lock);
+		return H713_SIP_E_MAP;
+	}
+	ce_buf = (uint8_t *)pa;
+	if (keep != 0UL) {
+		/*
+		 * Leave BUF_SRC as the caller placed it. Every key-select-3 probe
+		 * so far fed ZEROS, while the vendor's task feeds the real keybox
+		 * block - if the ladder inspects its input, zeros are exactly what
+		 * it would answer "not supported" to. ce_run clears descriptor and
+		 * IV itself, so only key and destination are wiped here.
+		 */
+		zeromem(ce_buf + BUF_KEY, 64);
+		zeromem(ce_buf + BUF_DST, BUF_SIZE - BUF_DST);
+	} else {
+		zeromem(ce_buf, BUF_SIZE);
+	}
+	ret = ce_run(true, 3, (unsigned int)len, pa + BUF_DST);
+	zeromem(ce_buf + BUF_DST, BUF_SIZE - BUF_DST);
+	ce_buf = ce_buf_own;
+	if (mapped != 0)
+		mmap_remove_dynamic_region(page, mapped);
+	spin_unlock(&ce_lock);
+	NOTICE("H713 SiP: key-select 3, %u bytes at 0x%lx, source %s: 0x%x\n",
+	       (unsigned int)len, (unsigned long)pa,
+	       (keep != 0UL) ? "as placed" : "zeroed", ret);
+	return ret;
+}
+
+/*
+ * A 288-byte task into the HDCP key sink with key-select 0 - our own key, not the
+ * engine's. The source is zeroed, so nothing meaningful is delivered; this asks one
+ * question only: does the engine accept a write to the sink from us at all?
+ */
+/* Five-byte little-endian address field out of a descriptor. */
+static uint64_t desc_field_addr(uintptr_t d, unsigned int off)
+{
+	uint64_t v = 0;
+	unsigned int i;
+
+	for (i = 0; i < 5U; i++)
+		v |= (uint64_t)(*(volatile uint8_t *)(d + off + i)) << (8U * i);
+	return v;
+}
+
+/*
+ * @record_pa  the stored 320-byte record, 64-byte aligned, in the BL33 window
+ * @key_pa     the 16-byte wrapping key, same window. The caller reads it out of
+ *             the device's own Trusted OS image; it is never kept here and never
+ *             written into this source.
+ */
+/*
+ * @skip  how many bytes of the unwrapped 320 to step over before the 288 that go
+ *        into the sink. The stored record is 320 bytes, the key set 288 (40 device
+ *        keys of 7 bytes, the KSV, three bytes of padding - doku/112), so 32 bytes
+ *        are header or tag, and which end they sit on is a measurement, not a guess.
+ */
+/*
+ * @record_pa the stored record, @key_pa our wrapping key, @ref_pa the vendor's
+ * plaintext (its own buffer, read only). Returns the number of differing bytes,
+ * or 0x1xx on an engine error.
+ */
+static u_register_t push_from(uintptr_t src_pa)
+{
+	uint32_t ret;
+
+	if ((src_pa & 0x3fUL) != 0UL || src_pa < 0x48600000UL ||
+	    src_pa + HDCP14_LEN > 0x48b00000UL)
+		return (u_register_t)SMC_UNK;
+	spin_lock(&ce_lock);
+	if (mmap_add_dynamic_region(src_pa & ~PAGE_SIZE_MASK,
+				    src_pa & ~PAGE_SIZE_MASK, PAGE_SIZE,
+				    MT_MEMORY | MT_RW | MT_SECURE |
+				    MT_EXECUTE_NEVER) != 0) {
+		spin_unlock(&ce_lock);
+		return H713_SIP_E_MAP;
+	}
+	zeromem(ce_buf + BUF_KEY, 64);
+	flush_dcache_range((uintptr_t)ce_buf, BUF_SIZE);
+	flush_dcache_range(src_pa, HDCP14_LEN);
+	ret = ce_run_full(true, (uint32_t)3U << 20, HDCP14_LEN, src_pa,
+			  SUNXI_HDCP14_SINK);
+	NOTICE("H713 SiP: key set from 0x%lx into the sink: 0x%x\n",
+	       (unsigned long)src_pa, ret);
+	mmap_remove_dynamic_region(src_pa & ~PAGE_SIZE_MASK, PAGE_SIZE);
+	spin_unlock(&ce_lock);
+	return ret;
+}
+
+static u_register_t __unused plain_compare(uintptr_t a_pa, uintptr_t b_pa)
+{
+	unsigned int diff = 0U, i;
+
+	if (b_pa < 0x48600000UL || b_pa >= 0x48b00000UL)
+		return (u_register_t)SMC_UNK;
+	spin_lock(&ce_lock);
+	if (mmap_add_dynamic_region(b_pa & ~PAGE_SIZE_MASK,
+				    b_pa & ~PAGE_SIZE_MASK, PAGE_SIZE,
+				    MT_MEMORY | MT_RO | MT_SECURE |
+				    MT_EXECUTE_NEVER) != 0) {
+		spin_unlock(&ce_lock);
+		return H713_SIP_E_MAP;
+	}
+	inv_dcache_range(a_pa, HDCP14_LEN);
+	for (i = 0U; i < HDCP14_LEN; i++) {
+		if (*(volatile uint8_t *)(a_pa + i) !=
+		    *(volatile uint8_t *)(b_pa + i))
+			diff++;
+	}
+	NOTICE("H713 SiP: the stored bytes differ from the vendor's source in "
+	       "%u of %u\n", diff, HDCP14_LEN);
+	mmap_remove_dynamic_region(b_pa & ~PAGE_SIZE_MASK, PAGE_SIZE);
+	spin_unlock(&ce_lock);
+	return diff;
+}
+
+static unsigned int unwrap_once(uintptr_t record_pa, uintptr_t key_pa,
+				uintptr_t ref_pa, uint32_t sym, bool dec,
+				unsigned int keylen, unsigned int inlen,
+				unsigned int skip, uint32_t *err)
+{
+	unsigned int diff = 0U, i;
+
+	zeromem(ce_buf + BUF_KEY, 64);
+	memcpy(ce_buf + BUF_KEY, (const void *)key_pa, keylen);
+	memcpy(ce_buf + BUF_SRC, (const void *)record_pa, inlen);
+	*err = ce_run_sym(dec, sym, inlen, (uintptr_t)ce_buf + BUF_DST);
+	zeromem(ce_buf + BUF_KEY, 64);
+	zeromem(ce_buf + BUF_SRC, inlen);
+	if (*err != 0U) {
+		zeromem(ce_buf + BUF_DST, KEYBOX_RECORD_LEN);
+		return HDCP14_LEN;
+	}
+	for (i = 0U; i < HDCP14_LEN; i++) {
+		if (ce_buf[BUF_DST + skip + i] !=
+		    *(volatile uint8_t *)(ref_pa + i))
+			diff++;
+	}
+	zeromem(ce_buf + BUF_DST, KEYBOX_RECORD_LEN);
+	return diff;
+}
+
+/* Walks the candidates and reports the best match it found. */
+static u_register_t __unused unwrap_sweep(uintptr_t record_pa, uintptr_t key_pa,
+				 uintptr_t ref_pa)
+{
+	static const uint32_t syms[] = { 0x100U, 0x10U, 0x0U, 0x200U, 0x1000U,
+					 0x300000U, 0x101U };
+	unsigned int best = HDCP14_LEN, a, b, c, d;
+	uint32_t err;
+
+	if ((record_pa & 0x3fUL) != 0UL || (key_pa & 0x3fUL) != 0UL ||
+	    ref_pa < 0x48600000UL || ref_pa >= 0x48700000UL)
+		return (u_register_t)SMC_UNK;
+	spin_lock(&ce_lock);
+	if (mmap_add_dynamic_region(ref_pa & ~PAGE_SIZE_MASK,
+				    ref_pa & ~PAGE_SIZE_MASK, PAGE_SIZE,
+				    MT_MEMORY | MT_RO | MT_SECURE |
+				    MT_EXECUTE_NEVER) != 0) {
+		spin_unlock(&ce_lock);
+		return H713_SIP_E_MAP;
+	}
+	inv_dcache_range(key_pa, 64);
+	inv_dcache_range(record_pa, KEYBOX_RECORD_LEN);
+	for (a = 0U; a < ARRAY_SIZE(syms); a++) {
+		for (b = 0U; b < 2U; b++) {		/* decrypt / encrypt */
+			for (c = 0U; c < 2U; c++) {	/* 16 / 32 byte key */
+				unsigned int keylen = (c == 0U) ? 16U : 32U;
+
+				for (d = 0U; d < 2U; d++) {
+					unsigned int inlen = (d == 0U) ?
+						KEYBOX_RECORD_LEN : HDCP14_LEN;
+					unsigned int skip = (d == 0U) ? 0U : 0U;
+					unsigned int diff;
+
+					diff = unwrap_once(record_pa, key_pa,
+							   ref_pa, syms[a],
+							   b == 0U, keylen,
+							   inlen, skip, &err);
+					if (diff < best)
+						best = diff;
+					if (diff <= 8U || err != 0U) {
+						NOTICE("H713 sweep: sym %06x %s key %u in %u -> %s %u\n",
+						       syms[a],
+						       (b == 0U) ? "dec" : "enc",
+						       keylen, inlen,
+						       (err != 0U) ? "err" : "diff",
+						       (err != 0U) ? err : diff);
+					}
+				}
+			}
+		}
+	}
+	NOTICE("H713 sweep: best match %u of %u bytes\n", best, HDCP14_LEN);
+	mmap_remove_dynamic_region(ref_pa & ~PAGE_SIZE_MASK, PAGE_SIZE);
+	spin_unlock(&ce_lock);
+	return best;
+}
+
+static u_register_t __unused unwrap_compare(uintptr_t record_pa, uintptr_t key_pa,
+				   uintptr_t ref_pa)
+{
+	unsigned int diff = 0U, i;
+	uint32_t ret;
+
+	/*
+	 * The key may sit anywhere, including unaligned inside the Trusted OS's
+	 * own data (the vendor copies 16 bytes from such a pointer), so no
+	 * alignment is required of it - only of the record the engine reads.
+	 */
+	if ((record_pa & 0x3fUL) != 0UL ||
+	    ref_pa < 0x48600000UL || ref_pa >= 0x48700000UL)
+		return (u_register_t)SMC_UNK;
+	spin_lock(&ce_lock);
+	if (mmap_add_dynamic_region(0x48600000UL, 0x48600000UL, 0x100000UL,
+				    MT_MEMORY | MT_RO | MT_SECURE |
+				    MT_EXECUTE_NEVER) != 0) {
+		spin_unlock(&ce_lock);
+		return H713_SIP_E_MAP;
+	}
+	inv_dcache_range(key_pa, KEYBOX_WRAP_KEYLEN);
+	inv_dcache_range(record_pa, KEYBOX_RECORD_LEN);
+	zeromem(ce_buf + BUF_KEY, 64);
+	memcpy(ce_buf + BUF_KEY, (const void *)key_pa, KEYBOX_WRAP_KEYLEN);
+	memcpy(ce_buf + BUF_SRC, (const void *)record_pa, KEYBOX_RECORD_LEN);
+	ret = ce_run_sym(true, KEYBOX_WRAP_SYM, KEYBOX_RECORD_LEN,
+			 (uintptr_t)ce_buf + BUF_DST);
+	zeromem(ce_buf + BUF_KEY, 64);
+	zeromem(ce_buf + BUF_SRC, KEYBOX_RECORD_LEN);
+	if (ret == 0U) {
+		for (i = 0U; i < HDCP14_LEN; i++) {
+			if (ce_buf[BUF_DST + i] !=
+			    *(volatile uint8_t *)(ref_pa + i))
+				diff++;
+		}
+		NOTICE("H713 SiP: our unwrap differs from the vendor's in "
+		       "%u of %u bytes\n", diff, HDCP14_LEN);
+	} else {
+		NOTICE("H713 SiP: unwrap for the comparison failed: 0x%x\n",
+		       ret);
+	}
+	zeromem(ce_buf + BUF_DST, KEYBOX_RECORD_LEN);
+	mmap_remove_dynamic_region(0x48600000UL, 0x100000UL);
+	spin_unlock(&ce_lock);
+	return (ret != 0U) ? ret : diff;
+}
+
+static u_register_t __unused hdcp14_full(uintptr_t record_pa, uintptr_t key_pa,
+				u_register_t skip)
+{
+	uint32_t ret;
+
+	if ((record_pa & 0x3fUL) != 0UL || (key_pa & 0x3fUL) != 0UL ||
+	    record_pa < PRELOADED_BL33_BASE ||
+	    record_pa + KEYBOX_RECORD_LEN >
+		    PRELOADED_BL33_BASE + SUNXI_DRAM_MAP_SIZE ||
+	    key_pa < PRELOADED_BL33_BASE ||
+	    key_pa + KEYBOX_WRAP_KEYLEN >
+		    PRELOADED_BL33_BASE + SUNXI_DRAM_MAP_SIZE)
+		return (u_register_t)SMC_UNK;
+
+	spin_lock(&ce_lock);
+	if (!kat_passed) {
+		ret = ce_kat();
+		if (ret != 0U) {
+			spin_unlock(&ce_lock);
+			return ret;
+		}
+	}
+
+	/* Step one: unwrap with the caller's key. No hardware key involved. */
+	inv_dcache_range(key_pa, KEYBOX_WRAP_KEYLEN);
+	inv_dcache_range(record_pa, KEYBOX_RECORD_LEN);
+	zeromem(ce_buf + BUF_KEY, 64);
+	memcpy(ce_buf + BUF_KEY, (const void *)key_pa, KEYBOX_WRAP_KEYLEN);
+	memcpy(ce_buf + BUF_SRC, (const void *)record_pa, KEYBOX_RECORD_LEN);
+	ret = ce_run_sym(true, KEYBOX_WRAP_SYM, KEYBOX_RECORD_LEN,
+			 (uintptr_t)ce_buf + BUF_DST);
+	zeromem(ce_buf + BUF_KEY, 64);
+	zeromem(ce_buf + BUF_SRC, KEYBOX_RECORD_LEN);
+	if (ret != 0U) {
+		zeromem(ce_buf + BUF_DST, KEYBOX_RECORD_LEN);
+		NOTICE("H713 SiP: unwrap of the stored record: 0x%x\n", ret);
+		spin_unlock(&ce_lock);
+		return ret;
+	}
+
+	/* Step two: the key set itself, into the sink, with the engine's own key. */
+	if (skip > (KEYBOX_RECORD_LEN - HDCP14_LEN)) {
+		zeromem(ce_buf + BUF_DST, KEYBOX_RECORD_LEN);
+		spin_unlock(&ce_lock);
+		return (u_register_t)SMC_UNK;
+	}
+	memmove(ce_buf + BUF_SRC, ce_buf + BUF_DST + skip, HDCP14_LEN);
+	zeromem(ce_buf + BUF_DST, KEYBOX_RECORD_LEN);
+	ret = ce_run(true, 3, HDCP14_LEN, SUNXI_HDCP14_SINK);
+	zeromem(ce_buf + BUF_SRC, HDCP14_LEN);
+	NOTICE("H713 SiP: unwrapped, key set at +%u into the sink: 0x%x\n",
+	       (unsigned int)skip, ret);
+	spin_unlock(&ce_lock);
+	return ret;
+}
+
+static uint32_t __unused ce_rerun_descriptor(u_register_t tda)
+{
+	uintptr_t page = (uintptr_t)tda & ~PAGE_SIZE_MASK;
+	uint32_t isr, esr, common, sym, len;
+	uint64_t deadline;
+	uint32_t ret = 0U;
+
+	if ((tda & 0x3fUL) != 0UL || tda < 0x48600000UL || tda >= 0x48700000UL)
+		return (uint32_t)SMC_UNK;
+	spin_lock(&ce_lock);
+	if (mmap_add_dynamic_region(page, page, PAGE_SIZE,
+				    MT_MEMORY | MT_RO | MT_SECURE |
+				    MT_EXECUTE_NEVER) != 0) {
+		spin_unlock(&ce_lock);
+		return H713_SIP_E_MAP;
+	}
+	common = mmio_read_32(tda + 0x04);
+	sym    = mmio_read_32(tda + 0x08);
+	len    = mmio_read_32(tda + 0x20);
+	if ((common & BIT_32(31)) == 0U || len != HDCP14_LEN ||
+	    ((sym >> 20) & 0xfU) != 3U ||
+	    desc_field_addr(tda, 0x29) != SUNXI_HDCP14_SINK) {
+		mmap_remove_dynamic_region(page, PAGE_SIZE);
+		spin_unlock(&ce_lock);
+		return (uint32_t)SMC_UNK;
+	}
+	if ((mmio_read_32(CCU_CE_CLK_REG) & BIT_32(31)) == 0U) {
+		mmap_remove_dynamic_region(page, PAGE_SIZE);
+		spin_unlock(&ce_lock);
+		return H713_SIP_E_CLOCK;
+	}
+
+	mmio_write_32(CE_S_TDA, (uint32_t)tda);
+	mmio_setbits_32(CE_S_ICR, BIT_32(0));
+	deadline = timeout_init_us(10000);
+	while ((mmio_read_32(CE_S_TLR) & BIT_32(0)) != 0U) {
+		if (timeout_elapsed(deadline)) {
+			mmio_write_32(CE_S_ICR, 0);
+			mmio_write_32(CE_S_TDA, 0);
+			mmap_remove_dynamic_region(page, PAGE_SIZE);
+			spin_unlock(&ce_lock);
+			return H713_SIP_E_BUSY;
+		}
+	}
+	mmio_setbits_32(CE_S_TLR, BIT_32(0));
+	deadline = timeout_init_us(200000);
+	do {
+		isr = mmio_read_32(CE_S_ISR);
+	} while ((isr & CE_ISR_PAIR) == 0U && !timeout_elapsed(deadline));
+	esr = mmio_read_32(CE_S_ESR) & 0xffU;
+	mmio_write_32(CE_S_ISR, CE_ISR_PAIR | (isr & 0xffU));
+	mmio_write_32(CE_S_ICR, 0);
+	mmio_write_32(CE_S_TLR, 0);
+	mmio_write_32(CE_S_TDA, 0);
+	if ((isr & CE_ISR_PAIR) == 0U)
+		ret = H713_SIP_E_TIMEOUT;
+	else if (esr != 0U)
+		ret = H713_SIP_E_ESR | esr;
+	NOTICE("H713 SiP: re-ran the vendor's own descriptor at 0x%lx: 0x%x\n",
+	       (unsigned long)tda, ret);
+	mmap_remove_dynamic_region(page, PAGE_SIZE);
+	spin_unlock(&ce_lock);
+	return ret;
+}
+
+static uint32_t __unused ce_sink_ks0(u_register_t len)
+{
+	uint32_t ret;
+
+	if (len == 0UL || len > HDCP14_LEN || (len & (AES_BLOCK - 1U)) != 0UL)
+		return (uint32_t)SMC_UNK;
+	spin_lock(&ce_lock);
+	zeromem(ce_buf + BUF_KEY, 64);
+	memset(ce_buf + BUF_SRC, 0, len);
+	ret = ce_run(true, 0, (unsigned int)len, SUNXI_HDCP14_SINK);
+	zeromem(ce_buf + BUF_SRC, len);
+	spin_unlock(&ce_lock);
+	NOTICE("H713 SiP: %u bytes into the sink with key-select 0: 0x%x\n",
+	       (unsigned int)len, ret);
+	return ret;
+}
+
+static uint32_t __unused ce_ks3_len_probe(u_register_t len)
+{
+	uint32_t ret;
+
+	if (len == 0UL || len > (BUF_SIZE - BUF_DST) ||
+	    (len & (AES_BLOCK - 1)) != 0UL)
+		return (uint32_t)SMC_UNK;
+	spin_lock(&ce_lock);
+	zeromem(ce_buf + BUF_KEY, 64);
+	memset(ce_buf + BUF_SRC, 0, len);
+	ret = ce_run(true, 3, (unsigned int)len, (uintptr_t)ce_buf + BUF_DST);
+	zeromem(ce_buf + BUF_DST, len);
+	spin_unlock(&ce_lock);
+	NOTICE("H713 SiP: key-select 3 with %u bytes: 0x%x\n",
+	       (unsigned int)len, ret);
+	return ret;
+}
+
+static u_register_t __unused hdcp14_op(uintptr_t pa, size_t len, bool load)
+{
+	uintptr_t page = pa & ~PAGE_SIZE_MASK;
+	size_t mapped = 0;
+	uint32_t ret;
+
+	if (len != (load ? HDCP14_LEN : AES_BLOCK) || (pa & 0x3f) != 0 ||
+	    pa < SUNXI_DRAM_BASE || pa + len > sunxi_dram_end() ||
+	    (pa < BL31_LIMIT && pa + len > BL31_BASE))
+		return (u_register_t)SMC_UNK;
+	spin_lock(&ce_lock);
+	if (pa < PRELOADED_BL33_BASE ||
+	    pa + len > PRELOADED_BL33_BASE + SUNXI_DRAM_MAP_SIZE) {
+		mapped = round_up(pa + len, PAGE_SIZE) - page;
+		if (mmap_add_dynamic_region(page, page, mapped, MT_NON_CACHEABLE |
+					    MT_RW | MT_NS | MT_EXECUTE_NEVER) != 0) {
+			spin_unlock(&ce_lock);
+			return H713_SIP_E_MAP;
+		}
+	}
+	ret = kat_passed ? 0 : ce_kat();
+	/*
+	 * No RSSK probe before a load any more. The probe ran one key-select-3
+	 * block into DRAM and gated the push on it - but the engine refuses the
+	 * hardware key into readable memory BY DESIGN and answers ESR 0x11, which
+	 * is exactly right: that write would hand out the key. Measured 05.10.:
+	 * the vendor's own descriptor, re-run from this very code, returns 0 with
+	 * the sink as its destination, while every length into DRAM returns 0x11.
+	 * So the probe can never pass, and gating on it blocked the one task that
+	 * works. The load path below writes to the sink and needs no permission
+	 * slip from a task that must fail.
+	 */
+	if (ret == 0 && !load)
+		ret = ce_rssk_probe();
+	if (ret == 0 && !load) {
+		memcpy((void *)pa, ce_buf + BUF_DST, AES_BLOCK);
+		if (mapped == 0)	/* the static window is cacheable, the caller's buffer is not */
+			flush_dcache_range(pa, AES_BLOCK);
+	}
+	if (ret == 0 && load) {
+		if (mapped == 0)	/* no stale lines of ours over the caller's fresh bytes */
+			inv_dcache_range(pa, HDCP14_LEN);
+		memcpy(ce_buf + BUF_SRC, (const void *)pa, HDCP14_LEN);
+		ret = ce_run(true, 3, HDCP14_LEN, SUNXI_HDCP14_SINK);
+		zeromem(ce_buf + BUF_SRC, HDCP14_LEN);
+		NOTICE("H713 SiP: HDCP 1.4 transfer into the key sink: 0x%x\n", ret);
+	}
+	zeromem(ce_buf + BUF_DST, HDCP14_LEN);
+	if (mapped != 0)
+		mmap_remove_dynamic_region(page, mapped);
+	spin_unlock(&ce_lock);
+	return ret;
+}
+
+/*
+ * The monitor.bin 0x4800237c sequence: insert the offset, trigger 0xac02, poll
+ * the read-enable bit, read SID_PRD. A bounded wait replaces the stock's open
+ * poll so a stuck SID cannot hang the SMC; false then, @out = 0.
+ */
+static bool sid_prctl_read(unsigned int off, uint32_t *out)
+{
+	uint32_t reg = (mmio_read_32(SID_PRCTL) & 0xfe00fffc) | (off << 16);
+	uint64_t timeout = timeout_init_us(1000);
+
+	*out = 0;
+	mmio_write_32(SID_PRCTL, reg);
+	mmio_write_32(SID_PRCTL, (reg & 0xffff00fc) | SID_PRCTL_RD);
+	while ((mmio_read_32(SID_PRCTL) & BIT_32(1)) != 0) {
+		if (timeout_elapsed(timeout)) {
+			mmio_write_32(SID_PRCTL, reg & 0xfe0000fc);
+			return false;
+		}
+	}
+	mmio_write_32(SID_PRCTL, reg & 0xfe0000fc);
+	*out = mmio_read_32(SID_PRD);
+	return true;
+}
+
+/*
+ * FB-HDCP14d. x0 status (0, or E_TIMEOUT if a PRCTL read never completed),
+ * x1 the burned bits of the sensed flag word, x2/x3 the two direct shadows,
+ * x4 the sensed word at 0x48: the control that the PRCTL path reads fuses at
+ * all (a working path returns the shadow's non-zero value there).
+ */
+/*
+ * Which SID word really carries the burned-flags? monitor.bin's own table says the
+ * vendor's flags area is 0x03006200 + 0x40, which ENDS at 0x0300623f - our
+ * h713_efuse_flags reads 0x03006240/0x48, right next to it but outside. doku/112 §3
+ * asks for one bit ("RSSK burned"), so that is all this prints: for each word, which
+ * of bits 16/17/21 are set and how many bits are set at all. No word is printed, so
+ * nothing that might be key material leaves the monitor - we want the flag, not the
+ * material (§ 69d/69e UrhG).
+ */
+static uintptr_t __unused h713_sid_flag_scan(void)
+{
+	static const struct { uintptr_t base; unsigned int len; } area[] = {
+		{ SUNXI_SID_BASE + 0x200, 0x40 },
+		{ SUNXI_SID_BASE + 0x2e4, 0x80 },
+	};
+	unsigned int a, i, set = 0;
+
+	for (a = 0; a < ARRAY_SIZE(area); a++) {
+		for (i = 0; i < area[a].len; i += 4) {
+			uint32_t v = mmio_read_32(area[a].base + i);
+			/*
+			 * Counted by hand on purpose: __builtin_popcount
+			 * becomes a call to __popcountdi2, and with LTO that
+			 * compiler-rt object does not make it into the link
+			 * ("undefined reference", research build 05.10. 08:0x).
+			 */
+			unsigned int pop = 0, b;
+
+			for (b = 0; b < 32U; b++)
+				pop += (v >> b) & 1U;
+
+			if (v == 0)
+				continue;
+			set++;
+			NOTICE("SIDscan %08lx: bits set %2u%s%s%s\n",
+			       (unsigned long)(area[a].base + i), pop,
+			       ((v & BIT_32(16)) != 0) ? "  bit16" : "",
+			       ((v & BIT_32(17)) != 0) ? "  bit17" : "",
+			       ((v & BIT_32(21)) != 0) ? "  bit21" : "");
+		}
+	}
+	NOTICE("SIDscan: %u non-zero word(s) in 0x%x+0x40 and 0x%x+0x80\n", set,
+	       (unsigned int)(SUNXI_SID_BASE + 0x200),
+	       (unsigned int)(SUNXI_SID_BASE + 0x2e4));
+	return 0;
+}
+
+static uintptr_t __unused h713_efuse_flags(void *handle)
+{
+	uint32_t prctl, ctrl, s240, s248;
+	bool ok;
+
+	spin_lock(&ce_lock);
+	ok = sid_prctl_read(SID_FLAGS_OFF, &prctl);
+	ok = sid_prctl_read(SID_CTRL_OFF, &ctrl) && ok;
+	s240 = mmio_read_32(SID_FLAGS_SHADOW);
+	s248 = mmio_read_32(SID_FLAGS_SHADOW2);
+	spin_unlock(&ce_lock);
+	SMC_RET5(handle, ok ? 0 : H713_SIP_E_TIMEOUT,
+		 prctl & SID_BURNED_BITS, s240, s248, ctrl);
+}
+
+static uintptr_t h713_sip_handler(uint32_t smc_fid, u_register_t x1,
+				  u_register_t x2, u_register_t x3,
+				  u_register_t x4, void *cookie, void *handle,
+				  u_register_t flags)
+{
+	if (!is_caller_non_secure(flags))
+		SMC_RET1(handle, SMC_UNK);
+	/* SMC32 calls: the arguments are 32-bit values, the upper halves are noise. */
+	x1 = (uint32_t)x1;
+	x2 = (uint32_t)x2;
+	switch (smc_fid) {
+	case H713_SIP_SVC_VERSION:
+		SMC_RET2(handle, 1, 0);
+	case H713_SIP_PUSH_FROM:
+		SMC_RET1(handle, push_from(x1));
+#if H713_HDCP_RESEARCH
+	case H713_SIP_HDCP14_LOAD:
+		SMC_RET1(handle, hdcp14_op(x1, x2, true));
+	case H713_SIP_HDCP14_PROBE:
+		SMC_RET1(handle, hdcp14_op(x1, x2, false));
+	case H713_SIP_EFUSE_FLAGS:
+		return h713_efuse_flags(handle);
+	case H713_SIP_CE_DUMP:
+		SMC_RET1(handle, h713_ce_dump());
+	case H713_SIP_CE_KS3_LEN:
+		SMC_RET1(handle, ce_ks3_len_probe(x1));
+	case H713_SIP_CE_KS3_AT:
+		SMC_RET1(handle, ce_ks3_at(x1, x2, x3));
+	case H713_SIP_SID_FLAGS:
+		SMC_RET1(handle, h713_sid_flag_scan());
+	case H713_SIP_SINK_KS0:
+		SMC_RET1(handle, ce_sink_ks0(x1));
+	case H713_SIP_RERUN:
+		SMC_RET1(handle, ce_rerun_descriptor(x1));
+	case H713_SIP_HDCP14_FULL:
+		SMC_RET1(handle, hdcp14_full(x1, x2, x3));
+	case H713_SIP_UNWRAP_CMP:
+		SMC_RET1(handle, unwrap_compare(x1, x2, x3));
+	case H713_SIP_UNWRAP_SWEEP:
+		SMC_RET1(handle, unwrap_sweep(x1, x2, x3));
+	case H713_SIP_CMP_PLAIN:
+		SMC_RET1(handle, plain_compare(x1, x2));
+#endif
+	default:
+		SMC_RET1(handle, SMC_UNK);
+	}
+}
+
+DECLARE_RT_SVC(h713_sip_svc, OEN_SIP_START, OEN_SIP_END, SMC_TYPE_FAST, NULL,
+	       h713_sip_handler);
