diff --git a/plat/allwinner/common/allwinner-common.mk b/plat/allwinner/common/allwinner-common.mk
index c96a2ca53..01c7ec787 100644
--- a/plat/allwinner/common/allwinner-common.mk
+++ b/plat/allwinner/common/allwinner-common.mk
@@ -58,6 +58,12 @@ BL31_SOURCES		+=	drivers/allwinner/sunxi_msgbox.c	\
 				${AW_PLAT}/common/sunxi_scpi_pm.c
 endif
 
+# System suspend handed to the management processor by a platform hook
+# (sunxi_system_suspend_enter/finish); only the H713 provides one so far.
+SUNXI_SYSTEM_SUSPEND	?=	0
+$(eval $(call assert_boolean,SUNXI_SYSTEM_SUSPEND))
+$(eval $(call add_define,SUNXI_SYSTEM_SUSPEND))
+
 SUNXI_SETUP_REGULATORS	?=	1
 $(eval $(call assert_boolean,SUNXI_SETUP_REGULATORS))
 $(eval $(call add_define,SUNXI_SETUP_REGULATORS))
diff --git a/plat/allwinner/common/include/sunxi_private.h b/plat/allwinner/common/include/sunxi_private.h
index 93ccb8121..3e19101b1 100644
--- a/plat/allwinner/common/include/sunxi_private.h
+++ b/plat/allwinner/common/include/sunxi_private.h
@@ -20,6 +20,22 @@ void sunxi_cpu_power_off_others(void);
 void sunxi_cpu_power_off_self(void);
 void sunxi_power_down(void);
 
+/* The warm boot entry point every CPU's RVBAR was programmed with. */
+extern uintptr_t sunxi_sec_entrypoint;
+
+#if SUNXI_SYSTEM_SUSPEND
+int sunxi_system_suspend_enter(void);
+void sunxi_system_suspend_finish(void);
+#else
+static inline int sunxi_system_suspend_enter(void)
+{
+	return -1;
+}
+static inline void sunxi_system_suspend_finish(void)
+{
+}
+#endif
+
 #if SUNXI_PSCI_USE_NATIVE
 void sunxi_set_native_psci_ops(const plat_psci_ops_t **psci_ops);
 #else
diff --git a/plat/allwinner/common/sunxi_native_pm.c b/plat/allwinner/common/sunxi_native_pm.c
index f78eebf77..632a05961 100644
--- a/plat/allwinner/common/sunxi_native_pm.c
+++ b/plat/allwinner/common/sunxi_native_pm.c
@@ -18,6 +18,8 @@
 #define SUNXI_WDOG0_CFG_REG		(SUNXI_R_WDOG_BASE + 0x0014)
 #define SUNXI_WDOG0_MODE_REG		(SUNXI_R_WDOG_BASE + 0x0018)
 
+static void __dead2 sunxi_system_reset(void);
+
 static int sunxi_pwr_domain_on(u_register_t mpidr)
 {
 	sunxi_cpu_on(mpidr);
@@ -79,20 +81,49 @@ static void sunxi_cpu_standby(plat_local_state_t cpu_state)
 static void sunxi_pwr_domain_suspend(const psci_power_state_t *target_state)
 {
 	/* A CPU-level powerdown suspend is the same as turning the CPU off. */
-	if (is_local_state_off(target_state->pwr_domain_state[MPIDR_AFFLVL0])) {
-		gicv2_cpuif_disable();
-		sunxi_cpu_power_off_self();
+	if (!is_local_state_off(target_state->pwr_domain_state[MPIDR_AFFLVL0]))
+		return;
+
+	gicv2_cpuif_disable();
+
+	/*
+	 * The whole system: the management processor takes it from here and
+	 * releases this CPU at sunxi_sec_entrypoint when a wake source fires.
+	 * If it cannot be told, sleeping would be a hang with nothing to wake
+	 * us; reset instead, and the boot loader finds RUN1 in GP5.
+	 */
+	if (is_local_state_off(target_state->pwr_domain_state[PLAT_MAX_PWR_LVL]) &&
+	    sunxi_system_suspend_enter() != 0) {
+		ERROR("PSCI: system suspend not accepted, resetting\n");
+		sunxi_system_reset();
 	}
+
+	sunxi_cpu_power_off_self();
 }
 
 static void sunxi_pwr_domain_suspend_finish(const psci_power_state_t *target_state)
 {
+	if (is_local_state_off(target_state->pwr_domain_state[PLAT_MAX_PWR_LVL])) {
+		gicv2_distif_init();
+		sunxi_system_suspend_finish();
+	}
 	if (is_local_state_off(target_state->pwr_domain_state[MPIDR_AFFLVL0])) {
 		gicv2_pcpu_distif_init();
 		gicv2_cpuif_enable();
 	}
 }
 
+#if SUNXI_SYSTEM_SUSPEND
+/* Offered as PSCI SYSTEM_SUSPEND: every level down, nothing retained. */
+static void sunxi_get_sys_suspend_power_state(psci_power_state_t *req_state)
+{
+	unsigned int i;
+
+	for (i = 0; i <= PLAT_MAX_PWR_LVL; i++)
+		req_state->pwr_domain_state[i] = PLAT_MAX_OFF_STATE;
+}
+#endif
+
 static void sunxi_system_off(void)
 {
 	gicv2_cpuif_disable();
@@ -142,6 +173,9 @@ static const plat_psci_ops_t sunxi_native_psci_ops = {
 	.system_off			= sunxi_system_off,
 	.system_reset			= sunxi_system_reset,
 	.validate_ns_entrypoint		= sunxi_validate_ns_entrypoint,
+#if SUNXI_SYSTEM_SUSPEND
+	.get_sys_suspend_power_state	= sunxi_get_sys_suspend_power_state,
+#endif
 };
 
 void sunxi_set_native_psci_ops(const plat_psci_ops_t **psci_ops)
