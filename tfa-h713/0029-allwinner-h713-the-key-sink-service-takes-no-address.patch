@@ -47,27 +59,25 @@
 #include <sunxi_mmap.h>
 
 /*
- * The services below fall into two groups. Only two of them are needed to run a
- * device: the version call and PUSH_FROM, which puts a staged key set into the
- * receiver's sink. Everything else exists because we had to find out HOW this
- * engine behaves - probes that run engine tasks with caller-chosen key slots,
- * lengths and addresses, dump descriptors, or read eFuse flags.
- *
- * Those belong on a workbench, not in a shipped image: they let the normal world
- * drive the Crypto Engine far more freely than booting a projector requires, and
- * every one of them is attack surface for no gain. They are compiled only with
- * H713_HDCP_RESEARCH=1 and are absent from a release build.
- *
- * What remains reachable is deliberate and bounded: PUSH_FROM accepts one source
- * address inside the Trusted OS window, with a fixed length, and the destination
- * is always the key sink. The worst a caller can do is install a key set that
- * does not authenticate - it can never read one back, because the engine refuses
- * the hardware key towards readable memory by design (doku/148 §0).
+ * Everything else in this file is workbench: probes that run engine tasks with
+ * caller-chosen key slots, lengths and addresses, dump descriptors, read eFuse
+ * flags, or push from a caller-chosen address in the window (PUSH_FROM, the
+ * release call until 07.10.2026). They exist because we had to find out HOW this
+ * engine behaves, and they let the normal world drive it far more freely than
+ * booting a projector requires. They are compiled only with H713_HDCP_RESEARCH=1
+ * and are absent from a release build.
  */
 #ifndef H713_HDCP_RESEARCH
 #define H713_HDCP_RESEARCH	0
 #endif
 
+/* The release service, see the top of this file. */
+#define H713_SIP_HDCP14_STAGE	U(0x8200001d)
+#define H713_SIP_HDCP14_ONCE	U(0x8200001e)
+#define HDCP14_ONCE_KEY_SET	U(0)
+#define HDCP14_ONCE_ZEROS	U(1)
+#define HDCP14_ONCE_NOTHING	U(2)
+
 #define H713_SIP_HDCP14_LOAD	U(0x82000010)
 #define H713_SIP_HDCP14_PROBE	U(0x82000011)
 #define H713_SIP_EFUSE_FLAGS	U(0x82000012)
@@ -157,6 +167,8 @@ uintptr_t h713_ce_dump(void);
 #define H713_SIP_E_RSSK		U(0x14)	/* BL31's own RSSK probe did not pass */
 #define H713_SIP_E_CLOCK	U(0x15)	/* the CE clocks or resets are off */
 #define H713_SIP_E_OVERRUN	U(0x16)	/* the engine wrote past the length */
+#define H713_SIP_E_CLOSED	U(0x17)	/* HDCP14_ONCE was used or closed this boot */
+#define H713_SIP_E_FORMAT	U(0x18)	/* the staged item failed a structure check */
 #define H713_SIP_E_ESR		U(0x100)
 
 /* CE_S registers as OP-TEE programs them (0x4860c2ac..0x4860c360), channel 0. */
@@ -507,12 +519,12 @@ static uint64_t desc_field_addr(uintptr_t d, unsigned int off)
  * plaintext (its own buffer, read only). Returns the number of differing bytes,
  * or 0x1xx on an engine error.
  */
-static u_register_t push_from(uintptr_t src_pa)
+static u_register_t __unused push_from(uintptr_t src_pa)
 {
 	uint32_t ret;
 
-	if ((src_pa & 0x3fUL) != 0UL || src_pa < 0x48600000UL ||
-	    src_pa + HDCP14_LEN > 0x48b00000UL)
+	if ((src_pa & 0x3fUL) != 0UL || src_pa < SUNXI_TEE_WINDOW_BASE ||
+	    src_pa + HDCP14_LEN > SUNXI_TEE_WINDOW_LIMIT)
 		return (u_register_t)SMC_UNK;
 	spin_lock(&ce_lock);
 	if (mmap_add_dynamic_region(src_pa & ~PAGE_SIZE_MASK,
@@ -534,11 +546,154 @@ static u_register_t push_from(uintptr_t src_pa)
 	return ret;
 }
 
+/*
+ * The stage: the one place where the boot loader leaves the stored item for us -
+ * two secure-storage slots, the original and its copy, unchanged as they sit on
+ * the eMMC (layout measured in doku/148 §1; U-Boot's h713_hdcp14.c and
+ * installer/h713/hdcpitems.py read the same). 0x48a00000 is the address the push
+ * was measured with, and the 288 bytes for the engine are moved to its start,
+ * so the engine task is the measured one, byte for byte.
+ */
+#define HDCP14_STAGE		UL(0x48a00000)
+#define SS_SLOT_BYTES		U(4096)
+#define HDCP14_STAGE_SIZE	(2U * SS_SLOT_BYTES)
+#define SS_MAGIC		U(0x17253948)
+#define SS_NAME_OFF		U(0x08)
+#define SS_OUTER_LEN_OFF	U(0x60)
+#define SS_OUTER_DATA_OFF	U(0x64)
+#define SS_INNER_LEN_OFF	U(0x40)		/* relative to the outer payload */
+#define SS_INNER_DATA_OFF	U(0x4c)		/* relative to the outer payload */
+#define SS_ITEM_NAME		"hdcpkey"
+
+CASSERT((HDCP14_STAGE >= SUNXI_TEE_WINDOW_BASE) &&
+	(HDCP14_STAGE + HDCP14_STAGE_SIZE <= SUNXI_TEE_WINDOW_LIMIT) &&
+	((HDCP14_STAGE & PAGE_SIZE_MASK) == 0U), assert_hdcp14_stage_in_window);
+
+static bool hdcp14_closed;
+
+static uint32_t le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+	       ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static bool all_same(const uint8_t *p, unsigned int len, uint8_t v)
+{
+	unsigned int i;
+
+	for (i = 0U; i < len; i++)
+		if (p[i] != v)
+			return false;
+	return true;
+}
+
+/*
+ * One staged slot, checked the way U-Boot checks it before staging
+ * (slot_hdcp14_payload() and read_key_set() in h713_hdcp14.c): the magic, the
+ * name in both headers, NUL-terminated; an outer length that fits the slot; an
+ * inner length that is the outer one minus the inner header and holds a key
+ * set; and a key set that is not all 0x00 or all 0xff. Returns the key set, or
+ * NULL with the failed check named.
+ */
+static const uint8_t *stage_key_set(const uint8_t *slot, unsigned int n)
+{
+	static const char name[] = SS_ITEM_NAME;
+	const uint8_t *data = slot + SS_OUTER_DATA_OFF;
+	const uint8_t *key = data + SS_INNER_DATA_OFF;
+	uint32_t outer = le32(slot + SS_OUTER_LEN_OFF);
+	uint32_t inner = le32(data + SS_INNER_LEN_OFF);
+	const char *bad = NULL;
+
+	if (le32(slot) != SS_MAGIC ||
+	    memcmp(slot + SS_NAME_OFF, name, sizeof(name)) != 0)
+		bad = "magic or name";
+	else if (outer == 0U || outer > SS_SLOT_BYTES - SS_OUTER_DATA_OFF)
+		bad = "outer length";
+	else if (memcmp(data, name, sizeof(name)) != 0)
+		bad = "inner name";
+	else if (outer < SS_INNER_DATA_OFF ||
+		 inner != outer - SS_INNER_DATA_OFF || inner < HDCP14_LEN)
+		bad = "inner length";
+	else if (all_same(key, HDCP14_LEN, 0x00U) ||
+		 all_same(key, HDCP14_LEN, 0xffU))
+		bad = "no key set";
+	if (bad != NULL) {
+		ERROR("H713 SiP: staged copy %u: %s\n", n, bad);
+		return NULL;
+	}
+	return key;
+}
+
+/*
+ * The one sink write of this boot. Whatever it is and however it ends, the
+ * service is closed afterwards: a second call - from U-Boot's prompt or from an
+ * OS - gets E_CLOSED, and HDCP14_STAGE no longer answers. The stage is wiped
+ * either way.
+ */
+static u_register_t hdcp14_once(u_register_t what)
+{
+	uint8_t *stage = (uint8_t *)HDCP14_STAGE;
+	const uint8_t *a, *b;
+	uint32_t ret = 0U;
+
+	if (what > HDCP14_ONCE_NOTHING)
+		return (u_register_t)SMC_UNK;
+	spin_lock(&ce_lock);
+	if (hdcp14_closed) {
+		spin_unlock(&ce_lock);
+		return H713_SIP_E_CLOSED;
+	}
+	hdcp14_closed = true;
+	if (what == HDCP14_ONCE_NOTHING) {
+		spin_unlock(&ce_lock);
+		return 0;
+	}
+	if (mmap_add_dynamic_region(HDCP14_STAGE, HDCP14_STAGE, HDCP14_STAGE_SIZE,
+				    MT_MEMORY | MT_RW | MT_SECURE |
+				    MT_EXECUTE_NEVER) != 0) {
+		spin_unlock(&ce_lock);
+		return H713_SIP_E_MAP;
+	}
+	if (what == HDCP14_ONCE_KEY_SET) {
+		/* U-Boot cleaned its cache over the stage before the call. */
+		inv_dcache_range(HDCP14_STAGE, HDCP14_STAGE_SIZE);
+		a = stage_key_set(stage, 0U);
+		b = stage_key_set(stage + SS_SLOT_BYTES, 1U);
+		if (a == NULL || b == NULL) {
+			ret = H713_SIP_E_FORMAT;
+		} else if (memcmp(a, b, HDCP14_LEN) != 0) {
+			ERROR("H713 SiP: the two staged copies differ\n");
+			ret = H713_SIP_E_FORMAT;
+		} else {
+			memmove(stage, a, HDCP14_LEN);
+		}
+	} else {
+		zeromem(stage, HDCP14_LEN);
+	}
+	if (ret == 0U) {
+		zeromem(ce_buf + BUF_KEY, 64);
+		flush_dcache_range((uintptr_t)ce_buf, BUF_SIZE);
+		flush_dcache_range(HDCP14_STAGE, HDCP14_LEN);
+		ret = ce_run_full(true, (uint32_t)3U << 20, HDCP14_LEN,
+				  HDCP14_STAGE, SUNXI_HDCP14_SINK);
+	}
+	zeromem(stage, HDCP14_STAGE_SIZE);
+	flush_dcache_range(HDCP14_STAGE, HDCP14_STAGE_SIZE);
+	mmap_remove_dynamic_region(HDCP14_STAGE, HDCP14_STAGE_SIZE);
+	spin_unlock(&ce_lock);
+	if (what == HDCP14_ONCE_KEY_SET)
+		NOTICE("H713 SiP: key set from the stage into the sink: 0x%x\n",
+		       ret);
+	else
+		NOTICE("H713 SiP: zeros into the sink: 0x%x\n", ret);
+	return ret;
+}
+
 static u_register_t __unused plain_compare(uintptr_t a_pa, uintptr_t b_pa)
 {
 	unsigned int diff = 0U, i;
 
-	if (b_pa < 0x48600000UL || b_pa >= 0x48b00000UL)
+	if (b_pa < SUNXI_TEE_WINDOW_BASE || b_pa >= SUNXI_TEE_WINDOW_LIMIT)
 		return (u_register_t)SMC_UNK;
 	spin_lock(&ce_lock);
 	if (mmap_add_dynamic_region(b_pa & ~PAGE_SIZE_MASK,
@@ -1006,10 +1161,16 @@ static uintptr_t h713_sip_handler(uint32_t smc_fid, u_register_t x1,
 	x2 = (uint32_t)x2;
 	switch (smc_fid) {
 	case H713_SIP_SVC_VERSION:
-		SMC_RET2(handle, 1, 0);
+		SMC_RET2(handle, 2, 0);
+	case H713_SIP_HDCP14_STAGE:
+		if (hdcp14_closed)
+			SMC_RET1(handle, H713_SIP_E_CLOSED);
+		SMC_RET3(handle, 0, HDCP14_STAGE, HDCP14_STAGE_SIZE);
+	case H713_SIP_HDCP14_ONCE:
+		SMC_RET1(handle, hdcp14_once(x1));
+#if H713_HDCP_RESEARCH
 	case H713_SIP_PUSH_FROM:
 		SMC_RET1(handle, push_from(x1));
-#if H713_HDCP_RESEARCH
 	case H713_SIP_HDCP14_LOAD:
 		SMC_RET1(handle, hdcp14_op(x1, x2, true));
 	case H713_SIP_HDCP14_PROBE:
