+/*
+ * The Trusted OS window of the vendor's memory map: its OP-TEE 3.7 runs at
+ * 0x48600000 (the vendor DTS reserves optee@48600000), and 0x48b00000 is the
+ * address its op 2 answered with (doku/146 §3). The Crypto Engine takes a
+ * key-select-3 task into the HDCP 1.4 key sink only with its DMA source in
+ * here - measured at 0x48a00000, doku/147 ch. 7 - and not from BL31's own
+ * memory. Nothing runs from it on this platform; it is plain DRAM that the
+ * kernel is later uncompressed over.
+ */
+#define SUNXI_TEE_WINDOW_BASE		0x48600000
+#define SUNXI_TEE_WINDOW_LIMIT		0x48b00000
 
 /* Memory-mapped devices */
 #define SUNXI_SYSCON_BASE		0x03000000
