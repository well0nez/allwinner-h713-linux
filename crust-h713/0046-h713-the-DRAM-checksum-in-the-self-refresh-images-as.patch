From 074f00938c0c223adf4768e945c8150cee78cbfc Mon Sep 17 00:00:00 2001
From: well0nez <8986239+well0nez@users.noreply.github.com>
Date: Wed, 7 Oct 2026 18:54:00 +0200
Subject: [PATCH 46/87] h713: the DRAM checksum in the self-refresh images, as
 error bit 14

crust's DEBUG_VERIFY_DRAM sums 48 words of the first 96 MiB of DRAM
before the self-refresh and after it and panics on a difference; the
vendor firmware checks a DRAM CRC on the way back too. On the H713 a
difference now sets error bit 14 with the sum read and the resume goes
on: the words lie in Linux's low memory, whether a DMA master writes
there between the save and the self-refresh is not measured, and a false
alarm must not reset a healthy system (release design C4). Whether it
becomes fatal is decided after the long device runs.

The two self-refresh defconfigs turn it on.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 common/debug/dram.c                | 22 ++++++++++++++++++++--
 configs/h713_hy300pro_sr_defconfig |  1 +
 configs/h713_hy310_sr_defconfig    |  1 +
 3 files changed, 22 insertions(+), 2 deletions(-)

diff --git a/common/debug/dram.c b/common/debug/dram.c
index bdc518e..99977cb 100644
--- a/common/debug/dram.c
+++ b/common/debug/dram.c
@@ -7,6 +7,10 @@
 #include <mmio.h>
 #include <steps.h>
 #include <util.h>
+#if CONFIG(PLATFORM_H713)
+#include <hdmi/sun50i-h713-hdmi.h>
+#include <platform/memory.h>
+#endif
 
 #define DRAM_BASE  0x40000000
 
@@ -39,7 +43,21 @@ dram_save_checksum(void)
 void
 dram_verify_checksum(void)
 {
+	uint32_t checksum;
+
 	record_step(STEP_RESUME_DRAM_CHECKSUM);
-	if (dram_calc_checksum() != saved_checksum)
-		panic("DRAM checksum mismatch!");
+	checksum = dram_calc_checksum();
+	if (checksum == saved_checksum)
+		return;
+#if CONFIG(PLATFORM_H713)
+	/*
+	 * A record, not yet a reset: the words lie in Linux's low memory, and
+	 * whether a DMA master writes there between the save and the
+	 * self-refresh is not measured. A false alarm must not reset a
+	 * healthy system; this becomes fatal once long runs show no mismatch.
+	 */
+	h713_err(H713_ERR_DRAM_SUM, 0, checksum);
+#else
+	panic("DRAM checksum mismatch!");
+#endif
 }
diff --git a/configs/h713_hy300pro_sr_defconfig b/configs/h713_hy300pro_sr_defconfig
index 981d52e..531e3d7 100644
--- a/configs/h713_hy300pro_sr_defconfig
+++ b/configs/h713_hy300pro_sr_defconfig
@@ -6,6 +6,7 @@ CONFIG_CIR_USE_OSC24M=y
 CONFIG_I2C_PINS_NONE=y
 # CONFIG_SERIAL is not set
 CONFIG_DEBUG_RECORD_STEPS=y
+CONFIG_DEBUG_VERIFY_DRAM=y
 CONFIG_H713_DRAM_SELF_REFRESH=y
 CONFIG_H713_DRAM_CLK=636
 CONFIG_H713_BOARD_ID=2
diff --git a/configs/h713_hy310_sr_defconfig b/configs/h713_hy310_sr_defconfig
index fe9fdd7..8aefe30 100644
--- a/configs/h713_hy310_sr_defconfig
+++ b/configs/h713_hy310_sr_defconfig
@@ -6,5 +6,6 @@ CONFIG_CIR_USE_OSC24M=y
 CONFIG_I2C_PINS_NONE=y
 # CONFIG_SERIAL is not set
 CONFIG_DEBUG_RECORD_STEPS=y
+CONFIG_DEBUG_VERIFY_DRAM=y
 CONFIG_H713_DRAM_SELF_REFRESH=y
 CONFIG_H713_BOARD_ID=1
