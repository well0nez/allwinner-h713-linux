diff --git a/drivers/css/css.c b/drivers/css/css.c
index 1b1a27b..f15cf9c 100644
--- a/drivers/css/css.c
+++ b/drivers/css/css.c
@@ -114,6 +114,25 @@ css_set_power_state(uint32_t cluster, uint32_t core, uint32_t core_state,
 	return SCPI_OK;
 }
 
+void
+css_power_off(void)
+{
+	/*
+	 * The H713's css_suspend_css() holds every core of the cluster in
+	 * reset (blob 0x4b28), the ones still looping included. A power off
+	 * ends in a SoC reset, so the per-core bookkeeping is only kept
+	 * consistent, not used again.
+	 */
+	record_step(STEP_SUSPEND_CSS);
+	css_suspend_css(SCPI_CSS_OFF);
+	for (uint32_t i = 0; i < css_get_cluster_count(); ++i) {
+		for (uint32_t j = 0; j < css_get_core_count(i); ++j)
+			power_state.core[i][j] = SCPI_CSS_OFF;
+		power_state.cluster[i] = SCPI_CSS_OFF;
+	}
+	power_state.css = SCPI_CSS_OFF;
+}
+
 static void
 css_wake_one_cpu(uint32_t cluster, uint32_t core)
 {
diff --git a/drivers/hdmi/sun50i-h713-hdmi.c b/drivers/hdmi/sun50i-h713-hdmi.c
index 5a85d13..c705397 100644
--- a/drivers/hdmi/sun50i-h713-hdmi.c
+++ b/drivers/hdmi/sun50i-h713-hdmi.c
@@ -168,6 +168,7 @@
 #define TYPE_CPU_OP     0x22 /* cpu op req: {mpidr, entry, 3, 3, 3} */
 #define TYPE_WAKE_CLR   0x25
 #define TYPE_WAKE_SET   0x26
+#define TYPE_POWEROFF   0x19 /* the vendor's fake poweroff req: {flags} */
 #define RESULT_UNKNOWN  0xfd
 #define HPD_RESET_TICKS 84    /* ~840 ms low, then the rising edge */
 #define HPD_TICK_US     10000
@@ -250,6 +251,28 @@ static const struct gpio_handle key_pin  = PL(CONFIG_H713_POWER_KEY_PIN, MODE_IN
 static const struct gpio_handle led_red  = PL(LED_PIN(LED_RED), MODE_OUTPUT, PULL_NONE);
 static const struct gpio_handle led_blue = PL(LED_PIN(LED_BLUE), MODE_OUTPUT, PULL_NONE);
 
+#if CONFIG(H713_POWER_OFF)
+/*
+ * Power off (doku/187, the vendor's 0xeaa8). PB5 (lamp and fan) and PL3
+ * (USB VBUS) are the two lines U-Boot's power gate keeps low; Linux may have
+ * left them high, and nothing resets the SoC before the rails go: they go
+ * low first. The rail enable runs the board high (stock standby_param).
+ * U-Boot's gate words in RTC GP5: TF-A writes GATE before it asks, U-Boot
+ * boots through RUN1.
+ */
+static const struct gpio_handle off_pb5 = {
+	.dev = &pio.dev, .id = SUNXI_GPIO_PIN(1, 5),
+	.drive = DRIVE_10mA, .mode = MODE_OUTPUT, .pull = PULL_NONE,
+};
+static const struct gpio_handle off_pl3   = PL(3, MODE_OUTPUT, PULL_NONE);
+static const struct gpio_handle off_rails = PL(CONFIG_H713_POWER_OFF_RAILS_PIN,
+                                               MODE_OUTPUT, PULL_NONE);
+#define RTC_GP5         (DEV_RTC + 0x114)
+#define GP5_GATE        0x47415445 /* "GATE": U-Boot waits for the key */
+#define GP5_RUN1        0x52554e31 /* "RUN1": U-Boot boots through */
+#define RAILS_UP_US     10000      /* the blob's 0x6b68(10) after PL6 high */
+#endif
+
 #if CONFIG(H713_IR_WAKE_NECX)
 /* cir_param of the HY310 and HY300 Pro vendor DTs, in crust's NECX order. */
 #define IR(addr, cmd) ((((addr) & 0xff) << 16) | ((addr) & 0xff00) | (cmd))
@@ -823,6 +846,40 @@ sb_reply(uint8_t type, uint8_t result, uint32_t *data, uint8_t count)
 		q_put(Q_NOTIFY, data[i]);
 }
 
+#if CONFIG(H713_POWER_OFF)
+/*
+ * TF-A's SYSTEM_OFF (attr 0, no answer; it parks the core). Taken only
+ * outside a standby: inside one TF-A sees no POWEROFF phase and resets into
+ * U-Boot's gate as before. The board lines go low while the main PIO still
+ * runs, the cluster goes down after TF-A had the time to reach WFI, and the
+ * state machine shuts down: DRAM to self-refresh, then the rails
+ * (system.c), and the wake ends in the reset (h713_power_off_reset()).
+ */
+static void
+power_off_request(void)
+{
+	uint8_t ph = mmio_read_32(H713_K_SB_STATE) & H713_SB_PHASE;
+
+	if (ph != H713_PH_OFF && ph != H713_PH_RELEASED) {
+		h713_err(H713_ERR_POWER_OFF, ph, sb_count ? sb_data[0] : 0);
+		return;
+	}
+	h713_sleep_event(H713_EV_POWER_OFF);
+	info("H713: power off req");
+	if (gpio_get(&off_pb5) == SUCCESS)
+		gpio_set_value(&off_pb5, false);
+	if (gpio_get(&off_pl3) == SUCCESS)
+		gpio_set_value(&off_pl3, false);
+#if CONFIG(H713_TEST) && CONFIG_H713_POWER_OFF_TEST_WAKE_S
+	mmio_write_32(H713_DIAG_WAKE_TIMER,
+	              CONFIG_H713_POWER_OFF_TEST_WAKE_S * 1000U);
+#endif
+	udelay(CPU_OP_DELAY_US);
+	css_power_off();
+	system_shutdown();
+}
+#endif
+
 static void
 sb_frame(void)
 {
@@ -885,6 +942,11 @@ sb_frame(void)
 		mmio_write_32(H713_DIAG_WAKE_TIMER, 0);
 		h713_sleep_request();
 		sb_reply(type, 0, NULL, 0); break;
+#if CONFIG(H713_POWER_OFF)
+	case TYPE_POWEROFF:	/* {flags}: none defined, CEC is not ours */
+		power_off_request();
+		break;
+#endif
 	default:
 		sb_reply(type, RESULT_UNKNOWN, NULL, 0); break;
 	}
@@ -908,7 +970,8 @@ sb_head(uint32_t w)
 	return (state == 0 || state == SB_STATE) &&
 	       (type == TYPE_RESTORE || type == TYPE_CPU_OP ||
 	        type == TYPE_WAKE_CLR || type == TYPE_WAKE_SET ||
-	        type == TYPE_NOTIFY);
+	        type == TYPE_NOTIFY ||
+	        (CONFIG(H713_POWER_OFF) && type == TYPE_POWEROFF));
 }
 
 static void
@@ -1043,7 +1106,8 @@ h713_init(void)
 	mmio_write_32(H713_K_COMPAT, H713_COMPAT);
 	mmio_write_32(H713_K_BUILD2, (BUILD2_DRAM_MHZ & 0xfff) |
 	              (CONFIG_H713_BOARD_ID & 0xf) << 12 |
-	              (BUILD2_NET_CODE & 0xff) << 16);
+	              (BUILD2_NET_CODE & 0xff) << 16 |
+	              (uint32_t)CONFIG(H713_POWER_OFF) << 24);
 	if (!acked)
 		portmap_init();
 	if (aux_clocked())	/* hardware state, also after a restart */
@@ -1297,3 +1361,33 @@ h713_resume_done(void)
 	mmio_write_32(H713_DIAG_WAKE_TIMER, 0);
 	info("H713: resumed, wake word %x", mmio_read_32(SH_WAKE));
 }
+
+void
+h713_power_off_rails(bool on)
+{
+#if CONFIG(H713_POWER_OFF)
+	if (gpio_get(&off_rails) != SUCCESS)
+		return;
+	gpio_set_value(&off_rails, on);
+	if (on)
+		udelay(RAILS_UP_US);
+#else
+	(void)on;
+#endif
+}
+
+void
+h713_power_off_reset(void)
+{
+#if CONFIG(H713_POWER_OFF)
+	/*
+	 * Only a power off TF-A handed over left GATE: a wake from it boots
+	 * through. Anything else (a restart inside a standby that ended up
+	 * off, STBY) keeps its word, and U-Boot decides as before.
+	 */
+	if (mmio_read_32(RTC_GP5) == GP5_GATE) {
+		mmio_write_32(RTC_GP5, GP5_RUN1);
+		info("H713: power off left, GP5 RUN1, reset");
+	}
+#endif
+}
diff --git a/drivers/hdmi/sun50i-h713-sleep.c b/drivers/hdmi/sun50i-h713-sleep.c
index 49d7a14..e3b1218 100644
--- a/drivers/hdmi/sun50i-h713-sleep.c
+++ b/drivers/hdmi/sun50i-h713-sleep.c
@@ -15,6 +15,8 @@
  *   RESUMING  CPU0 released, or 0x11 without a sleep: the budget again
  *   RELEASED  NET_CONFIRM with the cycle came: the net off
  *   RESET     inside h713_fail()
+ *   POWEROFF  0x19 taken (H713_POWER_OFF): rails off, the wake resets; a
+ *             restart here resets
  * A cpu op req without a request (a v4 TF-A and kernel) sleeps as before,
  * without net or budget, and goes straight to RELEASED after the wake.
  * The net is fed at step boundaries (record_step) and at most once a
@@ -226,7 +228,12 @@ h713_sleep_event(uint8_t ev)
 		set_phase(st, H713_PH_CPU_OP);
 		break;
 	case H713_EV_SUSPEND:
-		set_phase(st, H713_PH_SLEEP);
+		/* a power off keeps its own phase down to the reset */
+		if (ph != H713_PH_POWEROFF)
+			set_phase(st, H713_PH_SLEEP);
+		break;
+	case H713_EV_POWER_OFF:
+		set_phase(st, H713_PH_POWEROFF);
 		break;
 	case H713_EV_RESUMED:
 		h713_cnt(H713_CNT_WOKEN);
@@ -308,7 +315,8 @@ h713_restart_check(uint32_t exception)
 	 * there would run the boot initialisation under it; asleep, the state
 	 * machine would wait for a wake with the system half down. Both reset.
 	 */
-	if (ph == H713_PH_CPU_OP || ph == H713_PH_SLEEP || ph == H713_PH_RESET)
+	if (ph == H713_PH_CPU_OP || ph == H713_PH_SLEEP ||
+	    ph == H713_PH_RESET || ph == H713_PH_POWEROFF)
 		h713_fail(H713_CAUSE_RESTART, ph, exc);
 	if (ph != H713_PH_PRESLEEP && ph != H713_PH_RESUMING)
 		return;
diff --git a/include/drivers/css.h b/include/drivers/css.h
index e3fcccd..9411c5b 100644
--- a/include/drivers/css.h
+++ b/include/drivers/css.h
@@ -54,6 +54,13 @@ void css_init(void);
 int css_set_power_state(uint32_t cluster, uint32_t core, uint32_t core_state,
                         uint32_t cluster_state, uint32_t css_state);
 
+/**
+ * Take the whole CSS down for a power off, whatever the core states say: at
+ * a power off Linux parks CPU1..3 in a loop instead of turning them off
+ * through PSCI. No system suspend follows; the caller shuts down.
+ */
+void css_power_off(void);
+
 /**
  * Resume execution on the most recently active core in the CSS.
  */
diff --git a/include/drivers/hdmi/sun50i-h713-hdmi.h b/include/drivers/hdmi/sun50i-h713-hdmi.h
index a6cba3b..88f5069 100644
--- a/include/drivers/hdmi/sun50i-h713-hdmi.h
+++ b/include/drivers/hdmi/sun50i-h713-hdmi.h
@@ -15,6 +15,7 @@ enum {
 	H713_EV_RESTORE,        /* 0x11 */
 	H713_EV_SUSPEND,        /* the system state machine suspends */
 	H713_EV_RESUMED,        /* CPU0 released */
+	H713_EV_POWER_OFF,      /* 0x19 taken, the system shuts down */
 };
 
 #if CONFIG(H713_SLEEP_NET)
@@ -35,6 +36,10 @@ void h713_suspend_prepare(void);
 uint32_t h713_wake_poll(void);
 /** Resume: release the wake sources, LEDs. */
 void h713_resume_done(void);
+/** Power off: the board's rail enable low (false) or high again (true). */
+void h713_power_off_rails(bool on);
+/** The reset out of a power off: RTC GP5 "GATE" becomes "RUN1". */
+void h713_power_off_reset(void);
 /** Not fatal: set error bit @bit (platform/memory.h) with detail and data. */
 void h713_err(uint8_t bit, uint8_t detail, uint32_t data);
 /** Count one event in the counter byte at @at (H713_CNT_*), wrapping. */
@@ -65,6 +70,8 @@ static inline void h713_poll(void) {}
 static inline void h713_suspend_prepare(void) {}
 static inline uint32_t h713_wake_poll(void) { return 0; }
 static inline void h713_resume_done(void) {}
+static inline void h713_power_off_rails(bool on UNUSED) {}
+static inline void h713_power_off_reset(void) {}
 static inline void h713_err(uint8_t bit UNUSED, uint8_t detail UNUSED,
                             uint32_t data UNUSED) {}
 static inline void h713_cnt(uintptr_t at UNUSED) {}
diff --git a/platform/h713/Kconfig b/platform/h713/Kconfig
index d7b3851..4dda59c 100644
--- a/platform/h713/Kconfig
+++ b/platform/h713/Kconfig
@@ -132,6 +132,33 @@ config H713_DEEP_AVCC_GATING
 		TF-A and the kernel refuse such an image unless told
 		otherwise. Never for a release.
 
+config H713_POWER_OFF
+	bool "Power off through crust: the board rails off, the key wakes with a reset"
+	depends on H713_HDMI
+	help
+		The vendor's "fake poweroff" (blob 0xeaa8, doku/187): on
+		TF-A's SYSTEM_OFF request (port 3, type 0x19) the cluster
+		goes down and the system state machine shuts down instead of
+		suspending. On the way down the lamp/fan enable PB5 and the
+		USB VBUS enable PL3 go low, as U-Boot's power gate leaves
+		them, then the board's rail enable (stock standby_param:
+		vdd-cpu, vdd-sys, vcc-pll and vcc-dram all on one pin) goes
+		low. The power key or the remote wakes: the rail enable high,
+		10 ms, RTC GP5 from "GATE" to "RUN1" and the R_WDOG reset, a
+		warm start that U-Boot's gate boots through. BUILD2 bit 24
+		tells TF-A it may ask.
+
+config H713_POWER_OFF_RAILS_PIN
+	int "Port L pin of the board's rail enable"
+	depends on H713_POWER_OFF
+	default 6
+	range 0 31
+	help
+		PL6 on the HY310 and the HY200 QZ713DF A1 (both stock trees,
+		standby_param). High runs the board; low cuts vdd-cpu,
+		vdd-sys, vcc-pll and vcc-dram. The R domain (crust, R_PIO,
+		the RTC) stays powered - the blob keeps running after it.
+
 config H713_SLEEP_NET
 	bool "Sleep net: the R_WDOG armed from the standby request to Linux's confirm"
 	depends on DEBUG_RECORD_STEPS && WATCHDOG_SUN50I_H713_WDT
@@ -166,6 +193,16 @@ config H713_TEST_STARVE_NET
 	bool "Stop feeding the sleep net 2 s into the sleep (stage N2)"
 	depends on H713_SLEEP_NET
 
+config H713_POWER_OFF_TEST_WAKE_S
+	int "Power off: wake by itself after this many seconds (0 = never)"
+	depends on H713_POWER_OFF
+	default 0
+	range 0 3600
+	help
+		For the device test of the power off: the box comes back by
+		itself, which proves crust ran on through the rails off
+		without anybody at the key. Uses the standby timer word.
+
 config H713_TEST_PORT3_SILENT
 	bool "Stop reading port 3 once a request is taken (stage N4)"
 	help
diff --git a/platform/h713/include/platform/memory.h b/platform/h713/include/platform/memory.h
index a9088d7..5cada0a 100644
--- a/platform/h713/include/platform/memory.h
+++ b/platform/h713/include/platform/memory.h
@@ -107,7 +107,7 @@
 /* K: crust's own record, kept across its restarts. */
 #define H713_K_BASE          H713_PAGE(0x260)
 #define H713_K_COMPAT        H713_PAGE(0x260) /* 7..0 oldest reader version, 15..8 newest NET_REQ format */
-#define H713_K_BUILD2        H713_PAGE(0x264) /* 11..0 DRAM MHz, 15..12 board, 23..16 R_WDOG interval */
+#define H713_K_BUILD2        H713_PAGE(0x264) /* 11..0 DRAM MHz, 15..12 board, 23..16 R_WDOG interval, 24 power off */
 #define H713_K_SB_STATE      H713_PAGE(0x268) /* standby phase, see below */
 #define H713_K_NET_ACC       H713_PAGE(0x26c) /* budgets taken, s: 15..0 presleep, 31..16 resuming */
 #define H713_K_NET_RB        H713_PAGE(0x270) /* R_WDOG read back at arming: 15..0 MODE, 31..16 CFG */
@@ -210,6 +210,7 @@
 #define H713_PH_RESUMING     4  /* CPU0 released, or 0x11 without a sleep */
 #define H713_PH_RELEASED     5  /* confirmed, the net off */
 #define H713_PH_RESET        6  /* in h713_fail() */
+#define H713_PH_POWEROFF     7  /* power off (0x19) taken: rails off, a wake resets */
 #define H713_SB_PHASE        0x0000000f
 #define H713_SB_ARMED        0x00000010
 #define H713_SB_TAKEN        0x00000020
@@ -290,6 +291,7 @@
 #define H713_ERR_RWDOG_FOUND 15
 #define H713_ERR_RWDOG_RESET 16
 #define H713_ERR_RWDOG_DISARM 17 /* MODE still armed after a disarm: detail 0 release, 1 first start */
+#define H713_ERR_POWER_OFF   18 /* 0x19 refused inside a standby: detail the phase */
 
 /* Counter bytes for h713_cnt(), at the byte the ARM reads them from. */
 #define H713_CNT_SB_DROP     (H713_K_CNT0 + 0) /* port 3 words, partial frames dropped */
