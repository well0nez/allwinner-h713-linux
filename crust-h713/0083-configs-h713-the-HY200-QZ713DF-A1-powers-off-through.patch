From baef01109f0a5ac17346bcf3f9e7109d128af5d0 Mon Sep 17 00:00:00 2001
From: well0nez <8986239+well0nez@users.noreply.github.com>
Date: Sat, 10 Oct 2026 15:53:48 +0200
Subject: [PATCH 83/87] configs: h713: the HY200 QZ713DF A1 powers off through
 crust too, and its 60 s test build

PL6, PB5 and PL3 as on the HY310: its stock tree's standby_param names PL6
for all four rails, PB5 is the lamp and fan line (doku/185). Built, not
yet measured on a device.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 configs/h713_hy200_qz713df_a1_sr_defconfig       |  1 +
 .../h713_hy200_qz713df_a1_sr_off_test_defconfig  | 16 ++++++++++++++++
 2 files changed, 17 insertions(+)
 create mode 100644 configs/h713_hy200_qz713df_a1_sr_off_test_defconfig

diff --git a/configs/h713_hy200_qz713df_a1_sr_defconfig b/configs/h713_hy200_qz713df_a1_sr_defconfig
index a4daf01..d2cf396 100644
--- a/configs/h713_hy200_qz713df_a1_sr_defconfig
+++ b/configs/h713_hy200_qz713df_a1_sr_defconfig
@@ -11,3 +11,4 @@ CONFIG_H713_DRAM_SELF_REFRESH=y
 CONFIG_H713_BOARD_ID=3
 CONFIG_H713_LED_RED_PIN=0
 CONFIG_H713_LED_BLUE_PIN=1
+CONFIG_H713_POWER_OFF=y
diff --git a/configs/h713_hy200_qz713df_a1_sr_off_test_defconfig b/configs/h713_hy200_qz713df_a1_sr_off_test_defconfig
new file mode 100644
index 0000000..b2b6a66
--- /dev/null
+++ b/configs/h713_hy200_qz713df_a1_sr_off_test_defconfig
@@ -0,0 +1,16 @@
+CONFIG_PLATFORM_H713=y
+CONFIG_CIR=y
+CONFIG_CIR_PROTO_NECX=y
+CONFIG_CIR_WAKE_CODE=0x00ff14
+CONFIG_CIR_USE_OSC24M=y
+CONFIG_I2C_PINS_NONE=y
+# CONFIG_SERIAL is not set
+CONFIG_DEBUG_RECORD_STEPS=y
+# CONFIG_DEBUG_VERIFY_DRAM is not set
+CONFIG_H713_DRAM_SELF_REFRESH=y
+CONFIG_H713_BOARD_ID=3
+CONFIG_H713_LED_RED_PIN=0
+CONFIG_H713_LED_BLUE_PIN=1
+CONFIG_H713_POWER_OFF=y
+CONFIG_H713_TEST=y
+CONFIG_H713_POWER_OFF_TEST_WAKE_S=60
