diff --git a/platform/h713/include/platform/devices.h b/platform/h713/include/platform/devices.h
new file mode 100644
index 0000000..f66b1c3
--- /dev/null
+++ b/platform/h713/include/platform/devices.h
@@ -0,0 +1,45 @@
+/*
+ * Copyright © 2017-2026 The Crust Firmware Authors.
+ * SPDX-License-Identifier: BSD-3-Clause OR GPL-2.0-only
+ */
+
+#ifndef PLATFORM_DEVICES_H
+#define PLATFORM_DEVICES_H
+
+/*
+ * Allwinner H713 (sun50iw12). Every base below is either materialised by
+ * the vendor ARISC firmware (scp.bin, l.movhi/l.ori pairs; "blob") or
+ * defined by our TF-A sunxi_mmap.h / kernel device tree ("tfa", "dt").
+ */
+#define DEV_PIO              0x02000000 /* tfa; the blob touches none of it */
+#define DEV_CCU              0x02001000 /* blob 0x2001020/0x2001540/0x200171c */
+#define DEV_WDOG             0x02051000 /* tfa: main watchdog, key 0x16aa */
+#define DEV_UART0            0x02500000 /* tfa */
+#define DEV_SYSCON           0x03000000 /* blob 0x3000007 (byte) */
+#define DEV_MSGBOX           0x03003000 /* blob 0x300307c/0x300347c; dt msgbox */
+#define DEV_SPINLOCK         0x03004000 /* dt hwspinlock@3004000 */
+#define DEV_SID              0x03006000 /* blob 0x30060a0/0x3006200 */
+#define DEV_DRAMCOM          0x04002000 /* blob 0x4002000 (DRAM standby driver) */
+#define DEV_DRAMPHY_LO       0x04800000 /* blob 0x4800100.. (8 x 16 B copy, R4) */
+#define DEV_DRAMCTL          0x04810000 /* blob 0x4810008/14/50c */
+#define DEV_DRAMPHY          0x04820000 /* blob 0x4820002.. (25 registers) */
+#define DEV_TVTOP            0x05700000 /* blob 0x5700080 */
+#define DEV_RTC              0x07090000 /* blob GP words 0x7090100.. */
+#define DEV_R_CPUCFG         0x07000400 /* blob 0x7000440/450/470..47c/4a0; tfa */
+#define DEV_R_PRCM           0x07010000 /* blob 0x7010010..0x7010260; tfa */
+#define DEV_R_TIMER          0x07020000 /* guess from the R_WDOG offset */
+#define DEV_R_WDOG           0x07020400 /* blob 0x7020400/0x7020414 */
+#define DEV_R_PWM            0x07020c00 /* dt r_pwm@7020c00 */
+#define DEV_R_INTC           0x07021000 /* blob 0x7021000, base pointer 0x16f30 */
+#define DEV_R_PIO            0x07022000 /* blob 0x7022004/0x70221f4; dt */
+#define DEV_R_CIR_RX         0x07040000 /* blob 0x7040020/0x7040030; dt r_ir */
+#define DEV_R_UART           0x07080000 /* blob 0x7080080.. */
+#define DEV_R_I2C            0x07081400 /* tfa; not touched by the blob */
+#define DEV_R_RSB            0x07083000 /* tfa; not touched by the blob */
+#define DEV_HDMI_AUX         0x07091000 /* blob 0x7091014 HPD, 0x7091b04 gate, 0x7091c00 DDC */
+#define DEV_CPUSUBSYS        0x08100000 /* blob 0x8100044 ALT_RVBAR_HI; tfa */
+#define DEV_TIMESTAMP_STATUS 0x08110000 /* tfa/H6 layout; blob touches 0x0812000c/20 */
+#define DEV_TIMESTAMP_CTRL   0x08120000 /* blob 0x812000c/0x8120020 */
+#define DEV_CPUCFG           0x09010000 /* blob 0x9010014/60/6c/80; tfa */
+
+#endif /* PLATFORM_DEVICES_H */
diff --git a/platform/h713/include/platform/irq.h b/platform/h713/include/platform/irq.h
new file mode 100644
index 0000000..02f8ee6
--- /dev/null
+++ b/platform/h713/include/platform/irq.h
@@ -0,0 +1,28 @@
+/*
+ * Copyright © 2017-2026 The Crust Firmware Authors.
+ * SPDX-License-Identifier: BSD-3-Clause OR GPL-2.0-only
+ */
+
+#ifndef PLATFORM_IRQ_H
+#define PLATFORM_IRQ_H
+
+/*
+ * R_INTC line numbers of the ARISC, from the vendor firmware's wake-source
+ * table 0x15a40 ({ARISC irq, GIC SPI + 0x20}, FB-STANDBY excerpt F) and its
+ * ISR registrations (0x6058 callers). 96 lines in three registers.
+ */
+#define IRQ_NMI      0x00 /* SPI 140 */
+#define IRQ_R_TIMER0 0x01 /* guess, H6 numbering */
+#define IRQ_R_TIMER1 0x02
+#define IRQ_R_ALARM0 0x09 /* SPI 147, the RTC alarm */
+#define IRQ_R_PIO_PL 0x0e /* SPI 149: the power key on PL4 */
+#define IRQ_UNK_0F   0x0f /* SPI 148 */
+#define IRQ_R_PIO_PM 0x10 /* SPI 151: bt_powerkey */
+#define IRQ_UNK_11   0x11 /* SPI 150 */
+#define IRQ_USB      0x12 /* SPI 30..36, one line for all controllers */
+#define IRQ_R_CIR_RX 0x20 /* SPI 155 */
+#define IRQ_HDMI_CEC 0x28 /* registered at 0xff44 with handler 0x111b4 */
+
+#define IRQ_MSGBOX   0x13 /* guess, H6 numbering; the blob polls instead */
+
+#endif /* PLATFORM_IRQ_H */
diff --git a/platform/h713/include/platform/memory.h b/platform/h713/include/platform/memory.h
new file mode 100644
index 0000000..cf5a2e5
--- /dev/null
+++ b/platform/h713/include/platform/memory.h
@@ -0,0 +1,46 @@
+/*
+ * Copyright © 2017-2026 The Crust Firmware Authors.
+ * SPDX-License-Identifier: BSD-3-Clause OR GPL-2.0-only
+ */
+
+#ifndef PLATFORM_MEMORY_H
+#define PLATFORM_MEMORY_H
+
+/*
+ * The vendor blob occupies AR100 0x0000..0x23000 (vectors in the image,
+ * body from 0x4000). Crust takes the 64 KiB block above it instead, so the
+ * two images never overlap and a switch between them is a load, not a
+ * relayout. The linker forbids a 64 KiB boundary inside the firmware.
+ */
+#define FIRMWARE_BASE  0x00010000
+#define FIRMWARE_LIMIT 0x00020000
+#define FIRMWARE_SIZE  (FIRMWARE_LIMIT - FIRMWARE_BASE)
+
+/* Top 1 KiB: SCPI shared memory (crust ABI, two clients). */
+#define SCPI_MEM_BASE  (SRAM_A2_LIMIT - 0x400)
+#define SCPI_MEM_LIMIT SRAM_A2_LIMIT
+#define SCPI_MEM_SIZE  (SCPI_MEM_LIMIT - SCPI_MEM_BASE)
+
+/*
+ * SRAM A2 is 128 KiB at ARM 0x00104000 (TF-A sunxi_mmap.h, doku/68). The
+ * first 16 KiB of the AR100 address space (0x0000..0x3fff) are the vector
+ * area and a reserved block, as on the H6.
+ */
+#define SRAM_A2_BASE   0x00004000
+#define SRAM_A2_LIMIT  0x00024000
+#define SRAM_A2_SIZE   (SRAM_A2_LIMIT - SRAM_A2_BASE)
+
+/* Difference between SRAM_A2_BASE in the AR100 and ARM address spaces. */
+#define SRAM_A2_OFFSET 0x00100000
+
+/*
+ * Contract page (this port, tables/arisc-contract.csv): the variables the
+ * Linux driver sun50i-h713-arisc reads and writes, at fixed addresses
+ * instead of the vendor build's BSS. ARM address = these + 0x100000.
+ */
+#define H713_SHARED_BASE  0x00023800
+#define H713_SHARED_LIMIT SCPI_MEM_BASE
+
+#define STACK_SIZE     0x00000400
+
+#endif /* PLATFORM_MEMORY_H */
diff --git a/platform/h713/include/platform/prcm.h b/platform/h713/include/platform/prcm.h
new file mode 100644
index 0000000..c143acc
--- /dev/null
+++ b/platform/h713/include/platform/prcm.h
@@ -0,0 +1,72 @@
+/*
+ * Copyright © 2020-2026 The Crust Firmware Authors.
+ * SPDX-License-Identifier: BSD-3-Clause OR GPL-2.0-only
+ */
+
+#ifndef PLATFORM_PRCM_H
+#define PLATFORM_PRCM_H
+
+#include <util.h>
+#include <platform/devices.h>
+
+/*
+ * R_PRCM in the D1 layout (kernel sun20i-d1-r-ccu model for this SoC;
+ * gates confirmed by the blob's clock helper 0x5320: 0x11c, 0x1cc, 0x20c,
+ * 0x260, and by 0xdd20/0xdea8: 0x244, 0x250, 0x260).
+ */
+#define CPUS_CLK_REG                     (DEV_R_PRCM + 0x0000)
+#define CPUS_CLK_REG_CLK_SRC(x)          ((x) << 24)  /* 0 hosc 1 losc 2 iosc 3 pll */
+#define CPUS_CLK_REG_CLK_SRC_MASK        (0x3 << 24)
+#define CPUS_CLK_REG_DIV_P(x)            ((x) << 8)
+#define CPUS_CLK_REG_DIV_P_MASK          (0x3 << 8)
+#define CPUS_CLK_REG_PRE_DIV(x)          ((x) << 0)
+#define CPUS_CLK_REG_PRE_DIV_MASK        (0x1f << 0)
+
+#define R_APB0_CLK_REG                   (DEV_R_PRCM + 0x000c)
+#define R_APB0_CLK_REG_DIV_M(x)          ((x) << 0)
+#define R_APB0_CLK_REG_DIV_M_MASK        (0x3 << 0)
+
+/* Read by the blob at 0x59e4 (bits 31..24); TF-A/kernel do not name it. */
+#define R_APB2_CLK_REG                   (DEV_R_PRCM + 0x0010)
+
+/* boot0 "prcm cpus timer clock enable": bit 0 of these three (driver 0091). */
+#define R_CPUS_TIMER_GATE_REG(n)         (DEV_R_PRCM + 0x0110 + 4 * (n))
+
+#define R_TIMER_GATE_REG                 (DEV_R_PRCM + 0x011c)
+#define R_HDMI_AUX_GATE_REG              (DEV_R_PRCM + 0x0120) /* blob 0x120f0: 0, 5 ms, 0x10001 */
+#define R_HDMI_AUX_CLK_REG               (DEV_R_PRCM + 0x0124) /* blob 0x120f0: bit 31 */
+#define R_TWDOG_GATE_REG                 (DEV_R_PRCM + 0x012c)
+#define R_PWM_CLK_REG                    (DEV_R_PRCM + 0x0130)
+#define R_PWM_GATE_REG                   (DEV_R_PRCM + 0x013c)
+#define R_UART_GATE_REG                  (DEV_R_PRCM + 0x018c)
+#define R_I2C_GATE_REG                   (DEV_R_PRCM + 0x019c)
+#define R_PPU_GATE_REG                   (DEV_R_PRCM + 0x01ac)
+#define R_CIR_RX_CLK_REG                 (DEV_R_PRCM + 0x01c0) /* blob 0x8f14 */
+#define R_CIR_RX_GATE_REG                (DEV_R_PRCM + 0x01cc)
+#define R_RTC_GATE_REG                   (DEV_R_PRCM + 0x020c)
+#define R_CPUCFG_GATE_REG                (DEV_R_PRCM + 0x022c)
+
+/* blob 0xdd20: key 0xa7 << 24 written twice (H6 PLL_CTRL_REG1 shape). */
+#define PLL_CTRL_REG1                    (DEV_R_PRCM + 0x0244)
+#define PLL_CTRL_REG1_KEY                (0xa7 << 24)
+#define PLL_CTRL_REG1_KEY_FIELD          (0xff << 24)
+#define PLL_CTRL_REG1_PLL_LDO_OUT(x)     ((x) << 16)
+#define PLL_CTRL_REG1_PLL_LDO_OUT_MASK   (0x7 << 16)
+#define PLL_CTRL_REG1_PLL_IN_PWR_SEL     BIT(15)
+#define PLL_CTRL_REG1_CLKTEST_EN         BIT(3)
+#define PLL_CTRL_REG1_CRYSTAL_EN         BIT(2)
+#define PLL_CTRL_REG1_LDO_EN             BIT(0)
+
+/* blob 0xdea8: |= 4 and |= 0x100 on the way down (H6 names). */
+#define VDD_SYS_PWROFF_GATING_REG        (DEV_R_PRCM + 0x0250)
+#define VDD_CPUS_GATING                  BIT(3)
+#define AVCC_GATING                      BIT(2)
+#define UNK_GATING_BIT_08                BIT(8)
+
+#define GPU_PWROFF_GATING_REG            (DEV_R_PRCM + 0x0254) /* blob touches it */
+
+/* blob 0xdea8: &= ~1 on the way down. */
+#define VDD_SYS_RESET_REG                (DEV_R_PRCM + 0x0260)
+#define VDD_SYS_RESET                    BIT(0)
+
+#endif /* PLATFORM_PRCM_H */
