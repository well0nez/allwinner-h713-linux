From ecf2ddcd8babbbf3b80c316f2fd96e7e8fdaf65e Mon Sep 17 00:00:00 2001
From: well0nez <8986239+well0nez@users.noreply.github.com>
Date: Thu, 8 Oct 2026 11:23:20 +0200
Subject: [PATCH 80/81] h713: hdmi: a word without the marker is recorded,
 never dropped

302ee31 took the words without the marker outside a frame against a
budget (three per valid 0x16, at most six) and counted the rest in
MIPS_DROP. The blob has no such budget: it reads every such word and
drops it without a trace (0x80c4/0x80c8), in the path where it reports
all else it does not serve with an ERR line. The budget counted bursts
and orders that are no fault (two events with the words ahead of both
frames, or on another port: +3 and more in the emulator) and let up to
three words with no 0x16 at all pass. crust now follows the blob: such a
word never counts in MIPS_DROP, it is only recorded. MIPS_STRAY (+0x2b8)
holds the last one, MIPS_STRAY_INFO (+0x2bc) 7..0 its port, 15..8 such
words since the last valid 0x16 (saturating at 0xff), 23..16 such words
in all (8 bits, wrapping, as the counters), 31..24 zero. mips_spare,
MIPS_STRAYS, STRAY_TAKEN and STRAY_COUNTED are gone.

MIPS_DROP counts what the blob reports with ERR: len > 128, another
command, a port above 2, and now a 0x16 with an action not 1..3 (0x123ec
"Unknown Hotplug Type"). That one counted as MIPS_16 before and does no
longer; it is not served and does not start the words since a 0x16
anew. aux_ok() counts as before.

The comment on the 0x16 before the aux clock says again that the guard
is crust's own (0x12330 does not look at the clock); the fix went back
with the revert of 0cdf009.

memory.h: the layout of the three K words. The version stays 5: the
kernel and TF-A read none of them by name and copy K whole into P.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/hdmi/sun50i-h713-hdmi.c         | 70 +++++++++++++------------
 platform/h713/include/platform/memory.h | 25 ++++-----
 2 files changed, 50 insertions(+), 45 deletions(-)

diff --git a/drivers/hdmi/sun50i-h713-hdmi.c b/drivers/hdmi/sun50i-h713-hdmi.c
index b4f98a7..5a85d13 100644
--- a/drivers/hdmi/sun50i-h713-hdmi.c
+++ b/drivers/hdmi/sun50i-h713-hdmi.c
@@ -114,17 +114,13 @@
 #define MIPS_PASS_WORDS 16 /* per port and main loop pass */
 /*
  * Words without the marker outside a frame: the blob reads them and drops
- * them without a trace (0x80c4/0x80c8). The HY310's MIPS sends three with
- * every 0x16 (08.10.2026, R1 image: three 0x16, CNT1 0x03000900, no error
- * bit, DIAG_MIPS_N 3); where they sit is not measured, and on another port
- * they are read before or after their 0x16 as the poll finds them. So they
- * are taken as its companions against a budget, mips_spare: MIPS_STRAYS at
- * a start, MIPS_STRAYS more with each valid 0x16, never more than twice
- * that; taken ones are only recorded (MIPS_STRAY_INFO), the rest counts.
+ * them without a trace (0x80c4/0x80c8), in the path where it reports all
+ * else it does not serve with an ERR line. crust does the same: such a word
+ * never counts in MIPS_DROP, it is only recorded (mips_stray). The HY310's
+ * MIPS sends three with every 0x16 (08.10.2026, R1 image: three 0x16, CNT1
+ * 0x03000900, no error bit, DIAG_MIPS_N 3); where they sit is not measured,
+ * MIPS_STRAY and MIPS_STRAY_INFO show it on the device.
  */
-#define MIPS_STRAYS     3
-#define STRAY_TAKEN     (H713_K_MIPS_STRAY_INFO + 2)
-#define STRAY_COUNTED   (H713_K_MIPS_STRAY_INFO + 3)
 #define RX_PORT(p)      (2 * (p))      /* ARM -> ARISC, user1 port p */
 #define TX_CHAN(c)      (2 * (c) + 1)  /* ARISC -> ARM, user0 channel c */
 #define PORT_HDMI       RX_PORT(0)
@@ -236,7 +232,6 @@ static const struct device *cir;
 static struct {
 	uint8_t state, len, idx, buf[8];
 } mips[4];
-static int8_t   mips_spare;	/* the budget - MIPS_STRAYS, 0 at a start */
 
 #define PL(pin, m, p) { .dev = &r_pio.dev, .id = SUNXI_GPIO_PIN(0, pin), \
 	.drive = DRIVE_10mA, .mode = m, .pull = p }
@@ -702,52 +697,61 @@ mips_frame(uint8_t q, const uint8_t *p, uint8_t len)
 	mmio_write_32(DIAG_MIPS_LAST, p[0] | p[1] << 8 | p[2] << 16 |
 	              (uint32_t)p[3] << 24);
 	mmio_write_32(H713_K_MIPS_PORT, q);
-	if (len >= 3 && p[0] == 0x16 && p[1] < PORTS) {	/* 0x12330 */
+	if (len >= 3 && p[0] == 0x16 && p[1] < PORTS &&
+	    p[2] >= 1 && p[2] <= 3) {				/* 0x12330 */
 		uint8_t port = p[1], action = p[2];
 
 		h713_cnt(H713_CNT_MIPS_16);
-		mmio_write_32(H713_K_MIPS_STRAY_INFO,	/* its companions anew */
-		              mmio_read_32(H713_K_MIPS_STRAY_INFO) & ~0xff00U);
-		mips_spare = mips_spare > 0 ? MIPS_STRAYS :
-		             mips_spare + MIPS_STRAYS;
+		mmio_write_32(H713_K_MIPS_STRAY_INFO,	/* the words since it anew */
+		              mmio_read_32(H713_K_MIPS_STRAY_INFO) & 0x00ff00ffU);
 		/*
-		 * No aux clock before the first ResetEDIDModule: dropped as
-		 * the blob drops it, counted above with every 0x16 and not as
-		 * an error - the MIPS may well send it that early at boot.
+		 * No aux clock before the first ResetEDIDModule: dropped and
+		 * counted above with every 0x16, not as an error, as the MIPS
+		 * may well send it that early at boot. The guard is crust's
+		 * own, not the blob's: 0x12330 does not look at the clock;
+		 * here the pin access it leads to would be refused by aux_ok()
+		 * and counted as an error.
 		 */
 		if (!aux_clocked())
 			return;
 		if (action == 1)
 			sh_wr8(SH_HPD_COUNTER + port, sh_rd8(SH_HPD_COUNTER + port) + 1);
-		else if (action == 2 || action == 3)
+		else	/* 2 down, 3 reset */
 			hpd_pin(port, false),
 			sh_wr8(SH_HPD_COUNTER + port, action == 3 ? HPD_RESET_TICKS : 0);
 	} else if (len >= 1 && p[0] == 0x17) {			/* 0x120f0 */
 		h713_cnt(H713_CNT_MIPS_17);
 		reset_module();
 	} else {
+		/*
+		 * What the blob reports with ERR and does not serve: another
+		 * command (0x1242c), a port above 2 (0x12330), an action not
+		 * 1..3 (0x123ec "Unknown Hotplug Type"). Counted as well, as
+		 * before: a frame too short for its command (the blob reads
+		 * the stale buffer there).
+		 */
 		h713_cnt(H713_CNT_MIPS_DROP);
 	}
 }
 
-/* A word without the marker outside a frame on MIPS port @q (MIPS_STRAYS). */
+/*
+ * A word without the marker outside a frame on MIPS port @q: the blob drops
+ * it without a trace (0x80c4/0x80c8), crust only records it, never counts it
+ * in MIPS_DROP. MIPS_STRAY_INFO: 7..0 @q, 15..8 such words since the last
+ * valid 0x16 (saturating), 23..16 such words in all (wrapping), 31..24 0.
+ */
 static void
 mips_stray(uint8_t q, uint32_t w)
 {
-	uint32_t info = mmio_read_32(H713_K_MIPS_STRAY_INFO);
-	uint32_t n = (info >> 8 & 0xff) + 1;
+	uint32_t info  = mmio_read_32(H713_K_MIPS_STRAY_INFO);
+	uint32_t since = (info >> 8 & 0xff) + 1;
+	uint32_t total = (info >> 16) + 1;
 
-	if (n > 0xff)
-		n = 0xff;
+	if (since > 0xff)
+		since = 0xff;
 	mmio_write_32(H713_K_MIPS_STRAY, w);
-	mmio_write_32(H713_K_MIPS_STRAY_INFO, (info & 0xffff0000U) | n << 8 | q);
-	if (mips_spare > -MIPS_STRAYS) {
-		--mips_spare;
-		h713_cnt(STRAY_TAKEN);
-	} else {
-		h713_cnt(STRAY_COUNTED);
-		h713_cnt(H713_CNT_MIPS_DROP);
-	}
+	mmio_write_32(H713_K_MIPS_STRAY_INFO,
+	              (total & 0xff) << 16 | since << 8 | q);
 }
 
 /*
diff --git a/platform/h713/include/platform/memory.h b/platform/h713/include/platform/memory.h
index 248f0d3..a9088d7 100644
--- a/platform/h713/include/platform/memory.h
+++ b/platform/h713/include/platform/memory.h
@@ -129,21 +129,22 @@
 #define H713_K_WAKE_KEPT     H713_PAGE(0x2b0) /* the last resume's wake word, until 0x11 */
 #define H713_K_MIPS_HEAD     H713_PAGE(0x2b4) /* header word of the last DispMips frame, below */
 #define H713_K_MIPS_STRAY    H713_PAGE(0x2b8) /* the last DispMips word without the marker */
-#define H713_K_MIPS_STRAY_INFO H713_PAGE(0x2bc) /* where it came from, below */
+#define H713_K_MIPS_STRAY_INFO H713_PAGE(0x2bc) /* its port, how many, below */
 #define H713_K_LIMIT         H713_PAGE(0x2c0)
 
 /*
- * DispMips record, three words of K that were free (no new version: a
- * reader that does not know them reads zero there, as before).
+ * DispMips record, three words of K that were free (no new version: the
+ * kernel and TF-A read none of them by name, both copy K whole into P).
  * MIPS_HEAD: every header word crust takes off the MIPS sub-block, as it
- * came: 7..0 the marker 0xa5, 15..8 seq, 23..16 type (the blob serves 2
- * only), 31..24 len in bytes. MIPS_STRAY: the last word outside a frame
- * without the marker (the blob reads such words and drops them without a
- * trace, 0x80c4). MIPS_STRAY_INFO: 7..0 the port of that word; 15..8 such
- * words since the last valid 0x16 (saturating at 255); 23..16 such words
- * taken as the measured companions of a 0x16 (three per 0x16, the budget
- * in sun50i-h713-hdmi.c), 31..24 such words counted in MIPS_DROP (both
- * wrapping).
+ * came (also one with len > 128): 7..0 the marker 0xa5, 15..8 seq, 23..16
+ * type (the blob serves 2 only, 0x11828; crust does not look at it),
+ * 31..24 len in bytes.
+ * MIPS_STRAY: the last word without the marker outside a frame. The blob
+ * reads such words and drops them without a trace (0x80c4/0x80c8); crust
+ * only records them here, they never count in MIPS_DROP.
+ * MIPS_STRAY_INFO: 7..0 the port of that word; 15..8 such words since the
+ * last valid 0x16 (saturating at 0xff); 23..16 such words in all (8 bits,
+ * wrapping, as the counters); 31..24 zero.
  */
 
 /* A: written by the ARM, read by crust. */
@@ -296,7 +297,7 @@
 #define H713_CNT_ARM_UNKNOWN (H713_K_CNT0 + 2) /* ARM type, sub-command, no answer */
 #define H713_CNT_TXQ_FULL    (H713_K_CNT0 + 3) /* tx queue full, answer lost */
 #define H713_CNT_STALE_REPLY (H713_K_CNT1 + 0) /* reply nobody read */
-#define H713_CNT_MIPS_DROP   (H713_K_CNT1 + 1) /* DispMips words/frames dropped, aux unclocked */
+#define H713_CNT_MIPS_DROP   (H713_K_CNT1 + 1) /* DispMips frames the blob reports, aux unclocked */
 #define H713_CNT_MIPS_17     (H713_K_CNT1 + 2) /* DispMips ResetEDIDModule */
 #define H713_CNT_MIPS_16     (H713_K_CNT1 + 3) /* DispMips PullHotPlug */
 #define H713_CNT_TAKEN       (H713_K_CNT2 + 0) /* requests taken */
