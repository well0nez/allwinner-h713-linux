From 33b44f62d1a212522cc9e05530030817364e1db7 Mon Sep 17 00:00:00 2001
From: well0nez <8986239+well0nez@users.noreply.github.com>
Date: Wed, 7 Oct 2026 03:40:38 +0200
Subject: [PATCH 20/88] h713: the R_PIO in its D1-style layout: drive 4 bits
 per pin, pull at +0x24

The kernel's H713 R_PIO driver uses SUNXI_PINCTRL_NEW_REG_LAYOUT: 0x30 bytes
per port, drive 4 bits per pin from +0x14, pull registers from +0x24. crust's
sunxi-gpio assumed the H6 layout (2-bit drive, pull at +0x1c, 0x24 per
port), so every pin it took wrote its drive bits into another pin's field
and its pull into a drive register: PL4's pull-up never reached the pin
(the board pulls it up itself), PL4's drive bits landed in PL2's field
for the sleep, and the "PULL0" the standby saved and restored was DRV2.
sunxi-gpio takes the D1 layout on the H713 now; the standby keeps DRV0,
DRV1 (PL9, the IR pin) and PULL0 at their real offsets.

Review finding B27 (07.10.2026), confirmed against the kernel pinctrl.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/gpio/sunxi-gpio.c       | 24 +++++++++++++++++++-----
 drivers/hdmi/sun50i-h713-hdmi.c | 11 ++++++++---
 2 files changed, 27 insertions(+), 8 deletions(-)

diff --git a/drivers/gpio/sunxi-gpio.c b/drivers/gpio/sunxi-gpio.c
index 7a99e29..df6dc5b 100644
--- a/drivers/gpio/sunxi-gpio.c
+++ b/drivers/gpio/sunxi-gpio.c
@@ -15,24 +15,38 @@
 
 #include "gpio.h"
 
+#if CONFIG(PLATFORM_H713)
+/*
+ * The H713's PIO and R_PIO use the D1-style layout (kernel
+ * pinctrl-sun50i-h713-r.c, SUNXI_PINCTRL_NEW_REG_LAYOUT): 0x30 bytes per
+ * port, drive 4 bits per pin from +0x14, pull from +0x24.
+ */
+#define PORT_SIZE            0x30
+#define DRIVE_WIDTH          4
+#define PULL_OFFSET          0x24
+#else
+#define PORT_SIZE            0x24
+#define DRIVE_WIDTH          2
+#define PULL_OFFSET          0x1c
+#endif
+
 #define MODE_WIDTH           4
 #define MODE_PPW             (WORD_BIT / MODE_WIDTH)
-#define MODE_REG(port, pin)  (0x0000 + 0x24 * (port) + 4 * ((pin) / MODE_PPW))
+#define MODE_REG(port, pin)  (0x0000 + PORT_SIZE * (port) + 4 * ((pin) / MODE_PPW))
 #define MODE_BIT(pin)        (MODE_WIDTH * ((pin) % MODE_PPW))
 
 #define DATA_WIDTH           1
 #define DATA_PPW             (WORD_BIT / DATA_WIDTH)
-#define DATA_REG(port)       (0x0010 + 0x24 * (port))
+#define DATA_REG(port)       (0x0010 + PORT_SIZE * (port))
 #define DATA_BIT(pin)        (pin)
 
-#define DRIVE_WIDTH          2
 #define DRIVE_PPW            (WORD_BIT / DRIVE_WIDTH)
-#define DRIVE_REG(port, pin) (0x0014 + 0x24 * (port) + 4 * ((pin) / DRIVE_PPW))
+#define DRIVE_REG(port, pin) (0x0014 + PORT_SIZE * (port) + 4 * ((pin) / DRIVE_PPW))
 #define DRIVE_BIT(pin)       (DRIVE_WIDTH * ((pin) % DRIVE_PPW))
 
 #define PULL_WIDTH           2
 #define PULL_PPW             (WORD_BIT / PULL_WIDTH)
-#define PULL_REG(port, pin)  (0x001c + 0x24 * (port) + 4 * ((pin) / PULL_PPW))
+#define PULL_REG(port, pin)  (PULL_OFFSET + PORT_SIZE * (port) + 4 * ((pin) / PULL_PPW))
 #define PULL_BIT(pin)        (PULL_WIDTH * ((pin) % PULL_PPW))
 
 #define PINS_PER_PORT        32
diff --git a/drivers/hdmi/sun50i-h713-hdmi.c b/drivers/hdmi/sun50i-h713-hdmi.c
index 42fb11f..c3efbdb 100644
--- a/drivers/hdmi/sun50i-h713-hdmi.c
+++ b/drivers/hdmi/sun50i-h713-hdmi.c
@@ -112,8 +112,10 @@
 #define R_PIO_PL_CFG0   (DEV_R_PIO + 0x000)    /* PL0..PL7 function */
 #define R_PIO_PL_CFG1   (DEV_R_PIO + 0x004)    /* PL8..PL15 function */
 #define R_PIO_PL_DATA   (DEV_R_PIO + 0x010)
-#define R_PIO_PL_DRV0   (DEV_R_PIO + 0x014)    /* PL0..PL15 drive */
-#define R_PIO_PL_PULL0  (DEV_R_PIO + 0x01c)    /* PL0..PL15 pull */
+/* D1-style banks (kernel pinctrl-sun50i-h713-r.c): drive 4 bits per pin. */
+#define R_PIO_PL_DRV0   (DEV_R_PIO + 0x014)    /* PL0..PL7 drive */
+#define R_PIO_PL_DRV1   (DEV_R_PIO + 0x018)    /* PL8..PL15 drive */
+#define R_PIO_PL_PULL0  (DEV_R_PIO + 0x024)    /* PL0..PL15 pull */
 
 #define BOP_MARKER      0xa5
 #define BOP_MAX_LEN     128
@@ -174,7 +176,8 @@ static uint32_t pl_cfg_saved;
  * input and the LEDs for the sleep changes their function, drive and pull,
  * and gpio_put() gives none of that back.
  */
-static uint32_t pl_cfg0_saved, pl_drv0_saved, pl_pull0_saved, pl_data_saved;
+static uint32_t pl_cfg0_saved, pl_drv0_saved, pl_drv1_saved, pl_pull0_saved;
+static uint32_t pl_data_saved;
 static const struct device *cir;
 static struct {
 	uint8_t state, len, idx, buf[8];
@@ -741,6 +744,7 @@ h713_suspend_prepare(void)
 	pl_cfg_saved = mmio_read_32(R_PIO_PL_CFG1);	/* PL9's function */
 	pl_cfg0_saved  = mmio_read_32(R_PIO_PL_CFG0);
 	pl_drv0_saved  = mmio_read_32(R_PIO_PL_DRV0);
+	pl_drv1_saved  = mmio_read_32(R_PIO_PL_DRV1);	/* PL9, the IR pin */
 	pl_pull0_saved = mmio_read_32(R_PIO_PL_PULL0);
 	pl_data_saved  = mmio_read_32(R_PIO_PL_DATA);
 	cir = cir_get();
@@ -811,6 +815,7 @@ h713_resume_done(void)
 	mmio_clrset_32(R_PIO_PL_DATA, 0x3, pl_data_saved & 0x3);
 	mmio_write_32(R_PIO_PL_PULL0, pl_pull0_saved);
 	mmio_write_32(R_PIO_PL_DRV0, pl_drv0_saved);
+	mmio_write_32(R_PIO_PL_DRV1, pl_drv1_saved);
 	mmio_write_32(R_PIO_PL_CFG0, pl_cfg0_saved);
 	sh_status(0, ST_ASLEEP);
 	wake_timer_ms = 0;	/* one standby at a time, as the vendor's 0x26 */
