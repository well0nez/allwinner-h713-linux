From 819e90a51cbf9194260a32fc72abd0c67585f877 Mon Sep 17 00:00:00 2001
From: well0nez <8986239+well0nez@users.noreply.github.com>
Date: Wed, 7 Oct 2026 18:54:00 +0200
Subject: [PATCH 43/88] h713: dram: a PHY error after self-refresh resets
 before any CPU runs

When mctl_resume() found error bits in PGSR0, dram_resume() logged to a
serial port the release images do not have, skipped the rest of the
restore, and system.c went on to the mailbox, the pins and css_resume():
Linux woke on a DRAM the PHY had given up on, and nothing recorded it
(PRUEFUNG5 CS-03, DEEP-03).

mctl_resume() now returns PGSR0 when it has error bits (the blob's "no
error" flag from the same read at 0x13f44), dram_resume() keeps it, and
h713_dram_error() (new include/drivers/dram/sun50i-h713-dram.h) hands it
to system.c, which checks right after dram_resume() and takes the clean
reset: cause 3, error bit 6, PGSR0 as the data, step RESUME_DRAM. The
register accesses of dram_suspend and dram_resume are unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 common/system.c                         |  8 +++++++
 drivers/dram/sun50i-h713-dram.c         | 29 ++++++++++++++++++++-----
 include/drivers/dram/sun50i-h713-dram.h | 18 +++++++++++++++
 3 files changed, 50 insertions(+), 5 deletions(-)
 create mode 100644 include/drivers/dram/sun50i-h713-dram.h

diff --git a/common/system.c b/common/system.c
index e303a7e..62a5334 100644
--- a/common/system.c
+++ b/common/system.c
@@ -25,9 +25,11 @@
 #include <version.h>
 #include <watchdog.h>
 #include <clock/ccu.h>
+#include <dram/sun50i-h713-dram.h>
 #include <gpio/sunxi-gpio.h>
 #include <hdmi/sun50i-h713-hdmi.h>
 #include <msgbox/sunxi-msgbox.h>
+#include <platform/memory.h>
 
 #define NEXT_STATE (system_state + 2)
 
@@ -295,6 +297,12 @@ system_state_machine(uint32_t exception)
 			ccu_resume();
 			record_step(STEP_RESUME_DRAM);
 			dram_resume();
+#if CONFIG(PLATFORM_H713)
+			/* No mailbox and no CPU on a DRAM the PHY gave up on:
+			 * the clean reset, with PGSR0 for the next boot. */
+			if (h713_dram_error())
+				h713_fail(H713_CAUSE_DRAM, 0, h713_dram_error());
+#endif
 			dram_verify_checksum();
 
 			/* Release wakeup sources. */
diff --git a/drivers/dram/sun50i-h713-dram.c b/drivers/dram/sun50i-h713-dram.c
index 4eb5be0..7116837 100644
--- a/drivers/dram/sun50i-h713-dram.c
+++ b/drivers/dram/sun50i-h713-dram.c
@@ -40,6 +40,7 @@
 #include <mmio.h>
 #include <stdint.h>
 #include <util.h>
+#include <dram/sun50i-h713-dram.h>
 #include <hdmi/sun50i-h713-hdmi.h>
 #include <platform/devices.h>
 #include <platform/memory.h>
@@ -117,6 +118,8 @@ static struct {
 	uint32_t dxgtr[4];              /* +0x17c: 0x33c + 0x80 n */
 } save;
 
+static uint32_t phy_error;      /* PGSR0 of the last exit, if it had errors */
+
 /* The timing registers the enter side saves and 0x13af8.. puts back. */
 static const uint16_t tmg_reg[10] = {
 	0x058, 0x05c, 0x060, 0x064, 0x068, 0x06c, 0x078, 0x080, 0x050, 0x054,
@@ -237,11 +240,12 @@ restore_phy(void)
 	mmio_set_32(PGCR0, BIT(26));                              /* 0x134fc */
 }
 
-/* 0x13884: the controller back up around the self-refreshing DRAM. */
+/* 0x13884: the controller back up around the self-refreshing DRAM; the
+ * blob returns "no error", this PGSR0 if it has error bits, else 0. */
 static uint32_t
 mctl_resume(void)
 {
-	uint32_t clk, ctrl, trefi, trfc, odt, mode, pir, v;
+	uint32_t clk, ctrl, trefi, trfc, odt, mode, pir, v, err;
 
 	mmio_clr_32(DRAM_BGR, BIT(0));                            /* 0x138b0 */
 	mmio_clr_32(DRAM_BGR, BIT(16));                           /* 0x138cc */
@@ -352,7 +356,8 @@ mctl_resume(void)
 		mmio_write_32(PIR, 0x401);
 		poll_pgsr0_idone();
 	}
-	pir = !((mmio_read_32(PGSR0) >> 20) & 0xff);              /* 0x13f44: no error */
+	v = mmio_read_32(PGSR0);                                  /* 0x13f44: no error */
+	err = ((v >> 20) & 0xff) ? v : 0;
 	poll_reg(H713_POLL_DRAM_STATR, STATR, BIT(0), BIT(0));    /* 0x13f60 */
 	mmio_set_32(CTL(0x08c), BIT(31));                         /* 0x13f8c */
 	mmio_clr_32(CTL(0x08c), BIT(31));                         /* 0x13fa4 */
@@ -361,7 +366,7 @@ mctl_resume(void)
 	if (mode == 1)                                            /* 0x13fe4 */
 		mmio_clrset_32(CTL(0x11c), 0xc0, 0x40);
 
-	return pir;
+	return err;
 }
 
 /* 0x142dc. noinline: one place in the image, for skripte/dram_trace.py */
@@ -418,7 +423,9 @@ dram_resume(void)
 		mmio_set_32(SYSCFG(0x160), BIT(1));
 		mmio_set_32(SYSCFG(0x160), BIT(0));
 	}
-	if (!mctl_resume()) {                                     /* 0x14148 */
+	phy_error = mctl_resume();
+	if (phy_error) {                                          /* 0x14148 */
+		/* system.c resets (h713_dram_error) before any CPU runs */
 		error("DRAM: PHY reports an error after standby");
 		return;
 	}
@@ -443,6 +450,12 @@ dram_resume(void)
 		mmio_clrset_32(CTL(0x07c), 0x000f0000, 0x00010000);
 }
 
+uint32_t
+h713_dram_error(void)
+{
+	return phy_error;
+}
+
 #else /* !CONFIG(H713_DRAM_SELF_REFRESH): light standby, the DRAM stays on */
 
 void
@@ -455,6 +468,12 @@ dram_resume(void)
 {
 }
 
+uint32_t
+h713_dram_error(void)
+{
+	return 0;
+}
+
 #endif
 
 void
diff --git a/include/drivers/dram/sun50i-h713-dram.h b/include/drivers/dram/sun50i-h713-dram.h
new file mode 100644
index 0000000..831b369
--- /dev/null
+++ b/include/drivers/dram/sun50i-h713-dram.h
@@ -0,0 +1,18 @@
+/*
+ * Copyright © 2026 The Crust Firmware Authors.
+ * SPDX-License-Identifier: BSD-3-Clause OR GPL-2.0-only
+ */
+
+#ifndef DRIVERS_DRAM_SUN50I_H713_DRAM_H
+#define DRIVERS_DRAM_SUN50I_H713_DRAM_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+/**
+ * The last dram_resume(): PGSR0 if the PHY reported an error (bits 27..20),
+ * else 0. Always 0 without self-refresh.
+ */
+uint32_t h713_dram_error(void);
+
+#endif /* DRIVERS_DRAM_SUN50I_H713_DRAM_H */
