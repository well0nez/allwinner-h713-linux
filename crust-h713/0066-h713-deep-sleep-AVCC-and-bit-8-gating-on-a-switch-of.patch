From cc14d0fb7ff1e7891040b82dab915e666cdaf179 Mon Sep 17 00:00:00 2001
From: well0nez <8986239+well0nez@users.noreply.github.com>
Date: Wed, 7 Oct 2026 21:00:09 +0200
Subject: [PATCH 66/87] h713: deep sleep: AVCC and bit 8 gating on a switch of
 their own

H713_DEEP_VDD_SYS carried both halves of the blob's 0xdea8/0xe3a8: the
VDD_SYS reset and the R_PRCM 0x250 gating (AVCC, bit 8). The gating
upstream allows in a suspend (SD_AVCC) could not be tried without
resetting the main domain (PRUEFUNG5 DEEP-09).

H713_DEEP_AVCC_GATING (default n, depends on H713_DEEP_SLEEP) now takes
the gating; H713_DEEP_VDD_SYS keeps only the reset. With both on, the
writes and their order are the blob's as before. Build word bit 31
reports the gating, so TF-A and the kernel can refuse it like bit 28,
and h713_fail() ungates only in an image that gates. Every deep
defconfig says "is not set"; blobparity sets it, to stay the blob's.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 configs/h713_hy300pro_deep_defconfig         |  1 +
 configs/h713_hy310_deep_blobparity_defconfig |  1 +
 configs/h713_hy310_deep_d1a_defconfig        |  1 +
 configs/h713_hy310_deep_defconfig            |  1 +
 drivers/clock/sun50i-h713-r-ccu.c            |  9 ++++++++-
 drivers/hdmi/sun50i-h713-hdmi.c              |  3 ++-
 drivers/hdmi/sun50i-h713-sleep.c             |  4 ++--
 platform/h713/Kconfig                        | 19 ++++++++++++++++---
 platform/h713/include/platform/memory.h      |  4 ++--
 9 files changed, 34 insertions(+), 9 deletions(-)

diff --git a/configs/h713_hy300pro_deep_defconfig b/configs/h713_hy300pro_deep_defconfig
index a606f42..f59ae2e 100644
--- a/configs/h713_hy300pro_deep_defconfig
+++ b/configs/h713_hy300pro_deep_defconfig
@@ -12,4 +12,5 @@ CONFIG_H713_DEEP_SLEEP=y
 # CONFIG_H713_HOSC_IS_DCXO is not set
 # CONFIG_H713_DEEP_PLL_LDO is not set
 # CONFIG_H713_DEEP_VDD_SYS is not set
+# CONFIG_H713_DEEP_AVCC_GATING is not set
 CONFIG_H713_BOARD_ID=2
diff --git a/configs/h713_hy310_deep_blobparity_defconfig b/configs/h713_hy310_deep_blobparity_defconfig
index 2732bcc..722d78b 100644
--- a/configs/h713_hy310_deep_blobparity_defconfig
+++ b/configs/h713_hy310_deep_blobparity_defconfig
@@ -11,6 +11,7 @@ CONFIG_H713_DEEP_SLEEP=y
 CONFIG_H713_HOSC_IS_DCXO=y
 CONFIG_H713_DEEP_PLL_LDO=y
 CONFIG_H713_DEEP_VDD_SYS=y
+CONFIG_H713_DEEP_AVCC_GATING=y
 CONFIG_H713_BOARD_ID=1
 CONFIG_H713_LED_RED_PIN=0
 CONFIG_H713_LED_BLUE_PIN=1
diff --git a/configs/h713_hy310_deep_d1a_defconfig b/configs/h713_hy310_deep_d1a_defconfig
index 4099cb5..d477cf6 100644
--- a/configs/h713_hy310_deep_d1a_defconfig
+++ b/configs/h713_hy310_deep_d1a_defconfig
@@ -11,6 +11,7 @@ CONFIG_H713_DEEP_SLEEP=y
 # CONFIG_H713_HOSC_IS_DCXO is not set
 # CONFIG_H713_DEEP_PLL_LDO is not set
 # CONFIG_H713_DEEP_VDD_SYS is not set
+# CONFIG_H713_DEEP_AVCC_GATING is not set
 CONFIG_H713_BOARD_ID=1
 CONFIG_H713_LED_RED_PIN=0
 CONFIG_H713_LED_BLUE_PIN=1
diff --git a/configs/h713_hy310_deep_defconfig b/configs/h713_hy310_deep_defconfig
index 4099cb5..d477cf6 100644
--- a/configs/h713_hy310_deep_defconfig
+++ b/configs/h713_hy310_deep_defconfig
@@ -11,6 +11,7 @@ CONFIG_H713_DEEP_SLEEP=y
 # CONFIG_H713_HOSC_IS_DCXO is not set
 # CONFIG_H713_DEEP_PLL_LDO is not set
 # CONFIG_H713_DEEP_VDD_SYS is not set
+# CONFIG_H713_DEEP_AVCC_GATING is not set
 CONFIG_H713_BOARD_ID=1
 CONFIG_H713_LED_RED_PIN=0
 CONFIG_H713_LED_BLUE_PIN=1
diff --git a/drivers/clock/sun50i-h713-r-ccu.c b/drivers/clock/sun50i-h713-r-ccu.c
index 54f7f73..0f4ad21 100644
--- a/drivers/clock/sun50i-h713-r-ccu.c
+++ b/drivers/clock/sun50i-h713-r-ccu.c
@@ -415,6 +415,10 @@ r_ccu_suspend(uint8_t depth UNUSED)
 	 */
 	substep(H713_SUB_DOMAIN_OFF, 0);
 	mmio_clr_32(VDD_SYS_RESET_REG, VDD_SYS_RESET);
+#endif
+#if CONFIG(H713_DEEP_AVCC_GATING)
+	/* 0xdea8's gating, on its own switch (PRUEFUNG5 DEEP-09) */
+	substep(H713_SUB_DOMAIN_OFF, 1);
 	mmio_set_32(VDD_SYS_PWROFF_GATING_REG, AVCC_GATING);
 	mmio_set_32(VDD_SYS_PWROFF_GATING_REG, UNK_GATING_BIT_08);
 #endif
@@ -423,11 +427,14 @@ r_ccu_suspend(uint8_t depth UNUSED)
 void __attribute__((noinline))
 r_ccu_resume(void)
 {
-#if CONFIG(H713_DEEP_VDD_SYS)
 	/* 0xe3a8 */
+#if CONFIG(H713_DEEP_AVCC_GATING)
 	substep(H713_SUB_DOMAIN_ON, 0);
 	mmio_clr_32(VDD_SYS_PWROFF_GATING_REG, UNK_GATING_BIT_08);
 	mmio_clr_32(VDD_SYS_PWROFF_GATING_REG, AVCC_GATING);
+#endif
+#if CONFIG(H713_DEEP_VDD_SYS)
+	substep(H713_SUB_DOMAIN_ON, 1);
 	mmio_set_32(VDD_SYS_RESET_REG, VDD_SYS_RESET);
 #endif
 #if CONFIG(H713_DEEP_PLL_LDO)
diff --git a/drivers/hdmi/sun50i-h713-hdmi.c b/drivers/hdmi/sun50i-h713-hdmi.c
index 35b85bb..0f7bed5 100644
--- a/drivers/hdmi/sun50i-h713-hdmi.c
+++ b/drivers/hdmi/sun50i-h713-hdmi.c
@@ -988,7 +988,8 @@ h713_init(void)
 	              (uint32_t)CONFIG(H713_DEEP_VDD_SYS) << 27 |
 	              (uint32_t)CONFIG(H713_DEEP_PLL_LDO) << 28 |
 	              (uint32_t)CONFIG(H713_SLEEP_NET) << 29 |
-	              (uint32_t)CONFIG(H713_TEST) << 30);
+	              (uint32_t)CONFIG(H713_TEST) << 30 |
+	              (uint32_t)CONFIG(H713_DEEP_AVCC_GATING) << 31);
 	mmio_write_32(H713_K_COMPAT, H713_COMPAT);
 	mmio_write_32(H713_K_BUILD2, (BUILD2_DRAM_MHZ & 0xfff) |
 	              (CONFIG_H713_BOARD_ID & 0xf) << 12 |
diff --git a/drivers/hdmi/sun50i-h713-sleep.c b/drivers/hdmi/sun50i-h713-sleep.c
index 1511578..16bda85 100644
--- a/drivers/hdmi/sun50i-h713-sleep.c
+++ b/drivers/hdmi/sun50i-h713-sleep.c
@@ -346,11 +346,11 @@ h713_fail(uint8_t cause, uint8_t detail, uint32_t data)
 	 * design's order: VDD_SYS out of reset and ungated, the PLL LDO on,
 	 * the DRAM pad hold (dram.c) off. GP5 stays as it is.
 	 */
-	if (CONFIG(H713_DEEP_VDD_SYS)) {
+	if (CONFIG(H713_DEEP_VDD_SYS))
 		mmio_set_32(VDD_SYS_RESET_REG, VDD_SYS_RESET);
+	if (CONFIG(H713_DEEP_AVCC_GATING))
 		mmio_clr_32(VDD_SYS_PWROFF_GATING_REG,
 		            AVCC_GATING | UNK_GATING_BIT_08);
-	}
 	if (CONFIG(H713_DEEP_PLL_LDO)) {
 		uint32_t v = mmio_read_32(PLL_CTRL_REG1) | PLL_CTRL_REG1_KEY |
 		             PLL_CTRL_REG1_LDO_EN;
diff --git a/platform/h713/Kconfig b/platform/h713/Kconfig
index d47abfa..bf1d65b 100644
--- a/platform/h713/Kconfig
+++ b/platform/h713/Kconfig
@@ -83,7 +83,7 @@ config H713_DEEP_SLEEP
 		OSC24M, every PLL off, the RTC's LOSC not touched (only
 		read after the resume), and on the way back MBUS
 		reset and rebuilt with the NSI and display-bus gates
-		(sun50i-h713-ccu.c). The PLL LDO and the VDD_SYS steps of
+		(sun50i-h713-ccu.c). The PLL LDO, VDD_SYS and AVCC steps of
 		the blob come only with their own switches below. Ported,
 		offline model only; no device run.
 
@@ -109,16 +109,29 @@ config H713_DEEP_PLL_LDO
 		otherwise.
 
 config H713_DEEP_VDD_SYS
-	bool "Deep sleep: VDD_SYS reset and AVCC/bit 8 gating"
+	bool "Deep sleep: VDD_SYS reset"
 	depends on H713_DEEP_SLEEP
 	help
-		Blob 0xdea8 down, 0xe3a8 up. It resets the main domain - CCU
+		Blob 0xdea8 down, 0xe3a8 up, the reset alone (the gating has
+		its own switch below). It resets the main domain - CCU
 		gates, pin functions, UART0, the msgbox and the SoC watchdog
 		- and mainline Linux restores none of it (PRUEFUNG4 PD-1,
 		PD-3; PRUEFUNG5 design A: never in a suspend). Build word bit
 		27; TF-A and the kernel always refuse such an image. Only for
 		the trace comparison with the blob.
 
+config H713_DEEP_AVCC_GATING
+	bool "Deep sleep: AVCC and bit 8 gating (an experiment)"
+	depends on H713_DEEP_SLEEP
+	help
+		The gating half of blob 0xdea8/0xe3a8: R_PRCM 0x250 bit 2
+		(AVCC) and bit 8 set on the way down, cleared on the way up,
+		without the VDD_SYS reset. Upstream crust gates AVCC only
+		with OSC24M off, and the H713 sleeps on OSC24M; what bit 8
+		gates is not known (PRUEFUNG5 DEEP-09). Build word bit 31;
+		TF-A and the kernel refuse such an image unless told
+		otherwise. Never for a release.
+
 config H713_SLEEP_NET
 	bool "Sleep net: the R_WDOG armed from the standby request to Linux's confirm"
 	depends on DEBUG_RECORD_STEPS && WATCHDOG_SUN50I_H713_WDT
diff --git a/platform/h713/include/platform/memory.h b/platform/h713/include/platform/memory.h
index e5001d2..ba6a7dd 100644
--- a/platform/h713/include/platform/memory.h
+++ b/platform/h713/include/platform/memory.h
@@ -189,8 +189,8 @@
 #define H713_SUB_ROOT_OSC    2  /* root clock i to OSC24M (r-ccu.c root_clk[]) */
 #define H713_SUB_PLL_OFF     3  /* PLL i off (r-ccu.c pll_reg[]) */
 #define H713_SUB_LDO_OFF     4
-#define H713_SUB_DOMAIN_OFF  5  /* 0 VDD_SYS reset and gating */
-#define H713_SUB_DOMAIN_ON   6  /* 0 VDD_SYS ungated and out of reset */
+#define H713_SUB_DOMAIN_OFF  5  /* 0 VDD_SYS reset, 1 AVCC and bit 8 gated */
+#define H713_SUB_DOMAIN_ON   6  /* 0 AVCC and bit 8 ungated, 1 VDD_SYS reset off */
 #define H713_SUB_LDO_ON      7
 #define H713_SUB_PLL_ON      8  /* PLL i back */
 #define H713_SUB_ROOT_BACK   9  /* root clock i back to its source */
