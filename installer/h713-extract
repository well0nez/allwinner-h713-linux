#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""h713-extract — die proprietären Teile eines H713-Beamers (HY310, L018) aus der Stock-Firmware ziehen.

Geräteprofile: hy310 (Referenz = Netboot-Root des HY310) und l018 (eigene Referenzwerte, S42 Nachtrag). Das Gerät wird am
sha256 des Eingangs erkannt oder inhaltlich (scp/u-boot/dtb-Hashes, U-Boot- und ARISC-Kennung, Vendor-Fingerprint,
sunxi_version, vendor-Größe) — so lassen sich auch Einzelteile (--part, --fex-dir) einem Gerät zuordnen.

Eingänge (werden erkannt):
  * Allwinner-Firmware-Image (IMAGEWTY-Container, z. B. update.img)
  * roher eMMC-Dump (GPT + boot0 an LBA 16/256 + sunxi-package/TOC1 an LBA 24576/32800)
  * einzelne Partitions-/.fex-Dateien:  --part boot_package=DATEI  --part super=DATEI  --part vendor=DATEI
    --part bootloader_b=DATEI / --part boot-resource=DATEI (FAT16-Abbild mit mips/)
    oder ein Verzeichnis mit entpackten .fex:  --fex-dir VERZEICHNIS

Ausgabe (unter --out, Vorgabe ./h713-extract-out):
  lib/firmware/h713-arisc.bin        (= scp-Item des sunxi-package)
  lib/firmware/hy310-edid.bin        (= HDMI_EDID_14.bin + HDMI_EDID_20.bin, 512 B)
  lib/firmware/h713/msp-patch.bin    (= Symbol patch_msp aus libmspsound.so, MSPM-Blöcke)
  pq/…                               (die Dateien, die h713-pq liest)
  boot/mips/…                        (= MIPS-/Display-Artefakte aus bootloader_a/bootloader_b, was U-Boot liest)
  lib/firmware/aic8800_fw/SDIO/aic8800D80/…  (= WLAN-Firmware des AIC8800D80 aus vendor:/etc/firmware/aic8800d80/)
  MANIFEST.json, BERICHT.txt

Exit-Codes: 0 = bekanntes Gerät (hy310 oder l018), alles geprüft und referenzgleich; 1 = unbekanntes Image (kein Profil passt,
Best-Effort mit Abweichungsliste) oder fehlende/fehlerhafte Teile (Ausgabe liegt trotzdem); 2 = Fehler.

Nur Python-Standardbibliothek — auch ext4 (vendor) wird selbst gelesen, ohne debugfs/e2fsprogs; damit läuft das
Werkzeug auch unter Windows. Der alte Weg über `debugfs` bleibt als Gegenprobe erhalten: --use-debugfs.
Nie angefasst: HDCP-/DRM-Schlüssel, APKs, Android-System. Die WLAN-Firmware wird seit dem 12.09.2026 mitgenommen
(--no-wlan schaltet es ab): sie ist am Gerät geprüft, und weil sie aus dem Abzug des Nutzers kommt, muss nichts
Proprietäres ausgeliefert werden. Die BT-Firmware (fmacfwbt_*) liegt nicht in der vendor-Partition und bleibt offen.
"""

# Stage 1 of doku/121: h713-extract is a thin script over the h713 package (h713.extract.Run);
# every flag, every log line, MANIFEST.json and BERICHT.txt are unchanged (German until stage 3).

from __future__ import annotations

import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from h713.extract import VERSION, Run   # noqa: E402
from h713.log import Log                # noqa: E402


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="h713-extract", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("input", nargs="?", help="update.img (IMAGEWTY), roher eMMC-Dump, boot_package.fex, super.fex oder vendor-ext4")
    def part(s):
        if "=" not in s:
            raise argparse.ArgumentTypeError(f"--part erwartet NAME=DATEI, nicht '{s}'")
        return tuple(s.split("=", 1))

    ap.add_argument("--part", action="append", metavar="NAME=DATEI", type=part,
                    help="Einzelteil: boot_package=…, bootloader_a=…, bootloader_b=…, boot-resource=…, super=…, "
                         "vendor=…, emmc=… (mehrfach)")
    ap.add_argument("--fex-dir", metavar="DIR", help="Verzeichnis mit entpackten .fex (boot_package.fex, super.fex, boot-resource.fex)")
    ap.add_argument("-o", "--out", default="h713-extract-out", help="Ausgabeverzeichnis (Vorgabe: ./h713-extract-out)")
    ap.add_argument("--tmp", help="Verzeichnis für Zwischenstände (Vorgabe: <out>/tmp; wird am Ende gelöscht)")
    ap.add_argument("--keep-tmp", action="store_true", help="Zwischenstände nicht löschen")
    ap.add_argument("--no-hash", action="store_true", help="sha256 des Eingangs überspringen (Gerät wird dann nur inhaltlich erkannt)")
    ap.add_argument("--use-debugfs", action="store_true",
                    help="ext4 über debugfs (e2fsprogs) statt über den eingebauten Leser — Gegenprobe, braucht e2fsprogs")
    ap.add_argument("--no-pq", action="store_true", help="PQ-Dateien nicht kopieren")
    ap.add_argument("--no-mips", action="store_true", help="MIPS-/Display-Artefakte (boot/mips/…) nicht extrahieren")
    ap.add_argument("--no-wlan", action="store_true", help="WLAN-Firmware (lib/firmware/aic8800_fw/…) nicht extrahieren")
    ap.add_argument("-q", "--quiet", action="store_true", help="nur Ergebniszeilen")
    ap.add_argument("--version", action="version", version=f"h713-extract {VERSION}")
    args = ap.parse_args(argv)
    if not args.input and not args.part and not args.fex_dir:
        ap.error("Eingang fehlt (Datei, --part … oder --fex-dir …)")
    if args.input and (args.part or args.fex_dir):
        ap.error("entweder eine Eingangsdatei oder --part/--fex-dir")
    log = Log(args.quiet)
    log.heading(f"h713-extract {VERSION}")
    return Run(args, log).run()


if __name__ == "__main__":
    sys.exit(main())

