SEKTOR = 512


# --------------------------------------------------------------------------------------------------
# Protokoll
# --------------------------------------------------------------------------------------------------

class Log:
    def __init__(self, quiet: bool = False):
        self.zeilen: list[str] = []
        self.warnungen: list[str] = []
        self.quiet = quiet

    def _p(self, s: str):
        self.zeilen.append(s)
        if not self.quiet:
            print(s, flush=True)

    def info(self, s: str):
        self._p("  " + s)

    def kopf(self, s: str):
        self._p("")
        self._p("== " + s)

    def warn(self, s: str):
        self.warnungen.append(s)
        self._p("  WARNUNG: " + s)

    def fehler(self, s: str):
        self._p("  FEHLER: " + s)


class Abbruch(Exception):
    pass


def sha256_bytes(b: bytes) -> str:
    return hashlib.sha256(b).hexdigest()


def sha256_datei(pfad: Path, log: Log | None = None) -> str:
    h = hashlib.sha256()
    n = 0
    t0 = time.time()
    with open(pfad, "rb") as f:
        while True:
            b = f.read(16 << 20)
            if not b:
                break
            h.update(b)
            n += len(b)
    if log:
        log.info(f"sha256 über {n} B in {time.time() - t0:.1f} s")
    return h.hexdigest()


def hexdump_kurz(b: bytes, n: int = 16) -> str:
    return " ".join(f"{x:02x}" for x in b[:n])


# --------------------------------------------------------------------------------------------------
# Quellen: wahlfreier Lesezugriff auf Datei, Teilbereich, Sparse-Abbild, Extent-Kette
# --------------------------------------------------------------------------------------------------

class Quelle:
    size: int = 0
    name: str = "?"

    def read(self, off: int, n: int) -> bytes:
        raise NotImplementedError

    def backing(self):
        """(pfad, offset) wenn der Bereich zusammenhängend in einer echten Datei liegt, sonst None."""
        return None

    def sub(self, off: int, size: int, name: str) -> "Quelle":
        return TeilQuelle(self, off, size, name)


class DateiQuelle(Quelle):
    def __init__(self, pfad: Path):
        self.pfad = Path(pfad)
        self.fh = open(self.pfad, "rb")
        self.size = self.pfad.stat().st_size
        self.name = str(self.pfad)

    def read(self, off, n):
        if off < 0 or n < 0:
            raise ValueError("negativer Lesezugriff")
        self.fh.seek(off)
        return self.fh.read(n)

    def backing(self):
        return (str(self.pfad), 0)


class TeilQuelle(Quelle):
    def __init__(self, parent: Quelle, off: int, size: int, name: str):
        if off < 0 or off + size > parent.size:
            raise Abbruch(f"{name}: Bereich {off:#x}+{size:#x} liegt außerhalb von {parent.name} ({parent.size:#x} B)")
        self.parent, self.off, self.size, self.name = parent, off, size, name

    def read(self, off, n):
        if off >= self.size:
            return b""
        n = min(n, self.size - off)
        return self.parent.read(self.off + off, n)

    def backing(self):
        b = self.parent.backing()
        if b is None:
            return None
        return (b[0], b[1] + self.off)


class SparseQuelle(Quelle):
    """Android-Sparse-Abbild (simg) als logisches Abbild lesen — ohne simg2img."""
    MAGIC = 0xED26FF3A
    RAW, FILL, DONT_CARE, CRC = 0xCAC1, 0xCAC2, 0xCAC3, 0xCAC4

    @staticmethod
    def ist_sparse(q: Quelle) -> bool:
        return q.size >= 28 and struct.unpack("<I", q.read(0, 4))[0] == SparseQuelle.MAGIC

    def __init__(self, parent: Quelle, log: Log):
        self.parent = parent
        self.name = parent.name + " (sparse)"
        h = parent.read(0, 28)
        magic, maj, mi, fhs, chs, self.blk, self.total_blks, self.total_chunks, _cs = struct.unpack("<IHHHHIIII", h)
        if magic != self.MAGIC:
            raise Abbruch("kein Sparse-Abbild")
        if (maj, mi) != (1, 0) or fhs != 28 or chs != 12:
            log.warn(f"Sparse-Kopf ungewöhnlich: v{maj}.{mi}, Kopf {fhs}, Chunk-Kopf {chs}")
        self.size = self.blk * self.total_blks
        # Chunk-Karte: (logischer Start, Länge, Typ, Dateioffset|Füllwert)
        self.chunks: list[tuple[int, int, int, int]] = []
        off, lblk = fhs, 0
        typen = {self.RAW: 0, self.FILL: 0, self.DONT_CARE: 0, self.CRC: 0}
        for i in range(self.total_chunks):
            t, _r, csz, tsz = struct.unpack("<HHII", parent.read(off, 12))
            if t not in typen:
                raise Abbruch(f"Sparse-Chunk {i}: unbekannter Typ {t:#x}")
            typen[t] += 1
            lo, ln = lblk * self.blk, csz * self.blk
            if t == self.RAW:
                if tsz != 12 + ln:
                    raise Abbruch(f"Sparse-Chunk {i}: RAW-Länge passt nicht ({tsz} vs {12 + ln})")
                self.chunks.append((lo, ln, t, off + 12))
            elif t == self.FILL:
                fill = struct.unpack("<I", parent.read(off + 12, 4))[0]
                self.chunks.append((lo, ln, t, fill))
            elif t == self.DONT_CARE:
                self.chunks.append((lo, ln, t, 0))
            else:  # CRC: keine Blöcke
                csz = 0
            off += tsz
            lblk += csz
        if lblk != self.total_blks:
            log.warn(f"Sparse: Chunks decken {lblk} Blöcke, Kopf sagt {self.total_blks}")
        self.beschreibung = (f"Sparse v{maj}.{mi}, Block {self.blk}, {self.total_blks} Blöcke = {self.size} B logisch, "
                             f"{self.total_chunks} Chunks (RAW {typen[self.RAW]}, FILL {typen[self.FILL]}, "
                             f"DONT_CARE {typen[self.DONT_CARE]}, CRC {typen[self.CRC]})")

    def _finde(self, off: int) -> int:
        lo, hi = 0, len(self.chunks) - 1
        while lo <= hi:
            m = (lo + hi) // 2
            s, ln, _t, _d = self.chunks[m]
            if off < s:
                hi = m - 1
            elif off >= s + ln:
                lo = m + 1
            else:
                return m
        return -1

    def read(self, off, n):
        out = bytearray()
        while n > 0 and off < self.size:
            i = self._finde(off)
            if i < 0:
                break
            s, ln, t, d = self.chunks[i]
            k = min(n, s + ln - off)
            if t == self.RAW:
                out += self.parent.read(d + (off - s), k)
            elif t == self.FILL:
                pat = struct.pack("<I", d)
                start = (off - s) % 4
                out += (pat * (k // 4 + 2))[start:start + k]
            else:
                out += b"\0" * k
            off += k
            n -= k
        return bytes(out)

    def bereiche(self):
        """Für das Materialisieren: (logischer Start, Länge, Typ, Daten)."""
        return list(self.chunks)


class KettenQuelle(Quelle):
    """Mehrere Teilbereiche hintereinander (LP-Extents)."""

    def __init__(self, teile: list[Quelle], name: str):
        self.teile = teile
        self.name = name
        self.starts = []
        s = 0
        for t in teile:
            self.starts.append(s)
            s += t.size
        self.size = s

    def read(self, off, n):
        out = bytearray()
        for i, t in enumerate(self.teile):
            s = self.starts[i]
            if off >= s + t.size:
                continue
            if n <= 0:
                break
            k = min(n, s + t.size - off)
            out += t.read(off - s, k)
            off += k
            n -= k
        return bytes(out)

    def backing(self):
        if len(self.teile) == 1:
            return self.teile[0].backing()
        return None


def materialisiere(q: Quelle, ziel: Path, log: Log):
    """Quelle als normale Datei ablegen (Löcher für Nullbereiche)."""
    t0 = time.time()
    with open(ziel, "wb") as f:
        # Schneller Weg: Sparse-Bereiche direkt
        if isinstance(q, SparseQuelle):
            for s, ln, t, d in q.bereiche():
                if t == SparseQuelle.RAW:
                    f.seek(s)
                    rest, p = ln, d
                    while rest > 0:
                        k = min(rest, 8 << 20)
                        f.write(q.parent.read(p, k))
                        p += k
                        rest -= k
                elif t == SparseQuelle.FILL and d != 0:
                    f.seek(s)
                    f.write((struct.pack("<I", d) * (ln // 4)))
            f.truncate(q.size)
        else:
            off = 0
            while off < q.size:
                b = q.read(off, 8 << 20)
                if not b:
                    break
                if b.count(0) == len(b):
                    f.seek(off + len(b))
                else:
                    f.seek(off)
                    f.write(b)
                off += len(b)
            f.truncate(q.size)
    log.info(f"{q.name} -> {ziel.name}: {q.size} B in {time.time() - t0:.1f} s (Zwischenstand, wird gelöscht)")


