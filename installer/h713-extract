# GPT (roher eMMC-Dump)
# --------------------------------------------------------------------------------------------------

def crc32(b: bytes) -> int:
    import zlib
    return zlib.crc32(b) & 0xFFFFFFFF


class Gpt:
    @staticmethod
    def ist_gpt(q: Quelle) -> bool:
        return q.size >= 34 * SEKTOR and q.read(SEKTOR, 8) == b"EFI PART"

    def __init__(self, q: Quelle, log: Log):
        h = q.read(SEKTOR, 92)
        sig, rev, hsz, hcrc, _z, cur, bak, first, last = struct.unpack_from("<8sIIIIQQQQ", h, 0)
        pe_lba, pe_n, pe_sz, pe_crc = struct.unpack_from("<QIII", h, 72)
        hh = bytearray(h[:hsz])
        struct.pack_into("<I", hh, 16, 0)
        self.header_ok = crc32(bytes(hh)) == hcrc
        self.disk_guid = h[56:72]
        tab = q.read(pe_lba * SEKTOR, pe_n * pe_sz)
        self.tabelle_ok = crc32(tab) == pe_crc
        self.first, self.last, self.backup_lba = first, last, bak
        self.parts: dict[str, tuple[int, int]] = {}
        for i in range(pe_n):
            e = tab[i * pe_sz:(i + 1) * pe_sz]
            if len(e) < 128 or e[:16] == b"\0" * 16:
                continue
            s, en = struct.unpack_from("<QQ", e, 32)
            name = e[56:128].decode("utf-16le", "replace").rstrip("\0")
            self.parts[name] = (s, en - s + 1)
        log.info(f"GPT: Kopf-CRC {'ok' if self.header_ok else 'FALSCH'}, Tabellen-CRC {'ok' if self.tabelle_ok else 'FALSCH'}, "
                 f"{pe_n} Einträge à {pe_sz} B ab LBA {pe_lba}, nutzbar {first}..{last}, Backup-Kopf LBA {bak}")
        log.info("Partitionen: " + ", ".join(f"{n}@{s}+{c}" for n, (s, c) in self.parts.items()))

    def partition(self, q: Quelle, name: str) -> Quelle | None:
        p = self.parts.get(name)
        if not p:
            return None
        s, c = p
        if (s + c) * SEKTOR > q.size:
            return None
        return q.sub(s * SEKTOR, c * SEKTOR, f"Partition {name} (LBA {s}, {c} Sektoren)")


# --------------------------------------------------------------------------------------------------
# FAT12/16/32 mit VFAT-Langnamen (bootloader_a / bootloader_b / boot-resource.fex, Reserve0)
# --------------------------------------------------------------------------------------------------

class Fat:
    """Nur-Lese-FAT mit Langnamen (VFAT LFN).

    Gebraucht für die Vendor-Partitionen bootloader_a/bootloader_b (FAT16, 32 MiB): dort liegen die MIPS-/Display-
    Artefakte, und ihre 8.3-Kurznamen sind unbrauchbar — 'PR§÷pð~1.TSE' ist in Wahrheit 'ProjectID_0x0032.TSE'.
    Erst die LFN-Einträge (Attribut 0x0F, 13 UTF-16-Zeichen je Eintrag, rückwärts vor dem 8.3-Eintrag) ergeben den
    Namen, den U-Boot in h713_disp_read() erwartet.
    """

    ATTR_LFN = 0x0F
    ATTR_VOLUME = 0x08
    ATTR_DIR = 0x10

    @staticmethod
    def ist_fat(q: Quelle) -> bool:
        b = q.read(0, 512)
        if len(b) < 512 or b[510:512] != b"\x55\xaa" or b[0] not in (0xEB, 0xE9):
            return False
        bps = struct.unpack_from("<H", b, 11)[0]
        return bps in (512, 1024, 2048, 4096) and b[13] in (1, 2, 4, 8, 16, 32, 64, 128) and b[16] in (1, 2)

    def __init__(self, q: Quelle, log: Log, herkunft: str):
        self.q, self.log, self.herkunft = q, log, herkunft
        self.probleme: list[str] = []
        b = q.read(0, 512)
        if len(b) < 512:
            raise Abbruch(f"{herkunft}: zu klein für einen FAT-Bootsektor")
        self.bps = struct.unpack_from("<H", b, 11)[0]
        self.spc = b[13]
        self.reserved = struct.unpack_from("<H", b, 14)[0]
        self.nfats = b[16]
        self.root_entries = struct.unpack_from("<H", b, 17)[0]
        ts16 = struct.unpack_from("<H", b, 19)[0]
        fatsz16 = struct.unpack_from("<H", b, 22)[0]
        ts32 = struct.unpack_from("<I", b, 32)[0]
        if not self.bps or not self.spc or not self.nfats or not self.reserved:
            raise Abbruch(f"{herkunft}: kein brauchbarer FAT-BPB (bps {self.bps}, spc {self.spc}, fats {self.nfats})")
        self.total = ts16 or ts32
        self.fatsz = fatsz16 or struct.unpack_from("<I", b, 36)[0]
        self.root_cluster = 0 if fatsz16 else struct.unpack_from("<I", b, 44)[0]
        rootsec = (self.root_entries * 32 + self.bps - 1) // self.bps
        self.fat_start = self.reserved
        self.root_start = self.reserved + self.nfats * self.fatsz
        self.data_start = self.root_start + rootsec
        self.cluster_bytes = self.spc * self.bps
        self.cluster_zahl = max(0, (self.total - self.data_start) // self.spc)
        if self.cluster_zahl < 4085:
            self.typ, self.eoc = "FAT12", 0xFF8
        elif self.cluster_zahl < 65525:
            self.typ, self.eoc = "FAT16", 0xFFF8
        else:
            self.typ, self.eoc = "FAT32", 0x0FFFFFF8
        self.label = b[43:54].decode("latin1", "replace").strip() if fatsz16 else b[71:82].decode("latin1", "replace").strip()
        self.beschreibung = (f"{self.typ}, {self.bps} B/Sektor, {self.spc} Sektoren/Cluster ({self.cluster_bytes} B), "
                             f"{self.nfats} FATs à {self.fatsz} Sektoren, Wurzel {self.root_entries} Einträge, "
                             f"{self.total} Sektoren = {self.total * self.bps} B, {self.cluster_zahl} Cluster, "
                             f"Label '{self.label}'")
        log.info(f"{herkunft}: {self.beschreibung}")
        if self.total * self.bps > q.size:
            # bootloader_a/_b sind 32 MiB, der BPB behauptet 128 MiB; boot-resource.fex ist hinter den Nutzdaten
            # abgeschnitten. Beides ist harmlos, solange die belegten Cluster in der Quelle liegen — sonst schlägt
            # das Lesen der einzelnen Datei fehl und wird dort gemeldet.
            hinweis = (f"FAT-Volumen behauptet {self.total * self.bps} B, die Quelle hat {q.size} B — "
                       f"es wird nur gelesen, was vorhanden ist")
            self.probleme.append(hinweis)
            log.info("  " + hinweis)
        self._fat = q.read(self.fat_start * self.bps, min(self.fatsz * self.bps, max(0, q.size - self.fat_start * self.bps)))
        if len(self._fat) < 4:
            raise Abbruch(f"{herkunft}: FAT-Tabelle nicht lesbar")

    # ---- Clusterkette ---------------------------------------------------------------------------

    def _naechster(self, c: int) -> int:
        if self.typ == "FAT12":
            i = c + (c >> 1)
            if i + 2 > len(self._fat):
                return self.eoc
            v = struct.unpack_from("<H", self._fat, i)[0]
            return (v >> 4) if (c & 1) else (v & 0x0FFF)
        if self.typ == "FAT16":
            if c * 2 + 2 > len(self._fat):
                return self.eoc
            return struct.unpack_from("<H", self._fat, c * 2)[0]
        if c * 4 + 4 > len(self._fat):
            return self.eoc
        return struct.unpack_from("<I", self._fat, c * 4)[0] & 0x0FFFFFFF

    def kette(self, c: int, max_cluster: int | None = None) -> list[int]:
        out: list[int] = []
        gesehen: set[int] = set()
        while 2 <= c < self.eoc:
            if c in gesehen:
                raise Abbruch(f"{self.herkunft}: Clusterkette läuft im Kreis bei {c}")
            gesehen.add(c)
            out.append(c)
            if max_cluster is not None and len(out) >= max_cluster:
                break
            c = self._naechster(c)
        return out

    def _cluster_offset(self, c: int) -> int:
        return (self.data_start + (c - 2) * self.spc) * self.bps

    # ---- Verzeichnisse --------------------------------------------------------------------------

    @staticmethod
    def _lfn_teil(e: bytes) -> str:
        roh = e[1:11] + e[14:26] + e[28:32]
        s = roh.decode("utf-16le", "replace")
        for stop in ("￿", "\0"):
            i = s.find(stop)
            if i >= 0:
                s = s[:i]
        return s

    def _roh_verzeichnis(self, cluster: int) -> bytes:
        if cluster == 0:                    # feste Wurzel (FAT12/16)
            return self.q.read(self.root_start * self.bps, (self.data_start - self.root_start) * self.bps)
        return b"".join(self.q.read(self._cluster_offset(c), self.cluster_bytes) for c in self.kette(cluster))

    def eintraege(self, cluster: int = 0) -> list[dict]:
        """Einträge eines Verzeichnisses; 'name' ist der Langname (Rückfall: 8.3), 'kurz' immer der 8.3-Name."""
        data = self._roh_verzeichnis(cluster if cluster else (self.root_cluster if self.typ == "FAT32" else 0))
        out: list[dict] = []
        lfn: list[bytes] = []
        for i in range(0, len(data) - 31, 32):
            e = data[i:i + 32]
            if e[0] == 0x00:
                break
            if e[0] == 0xE5:                # gelöscht
                lfn = []
                continue
            attr = e[11]
            if attr == self.ATTR_LFN:
                lfn.append(e)
                continue
            basis = e[0:8].decode("latin1", "replace").rstrip()
            erw = e[8:11].decode("latin1", "replace").rstrip()
            kurz = basis + ("." + erw if erw else "")
            if kurz.startswith("\x05"):
                kurz = "\xe5" + kurz[1:]
            lang = ""
            if lfn:
                # Die LFN-Einträge stehen rückwärts vor dem 8.3-Eintrag; Bit 0x40 markiert den letzten (= höchste Folge).
                for teil in sorted(lfn, key=lambda x: x[0] & 0x3F):
                    lang += self._lfn_teil(teil)
            lfn = []
            if attr & self.ATTR_VOLUME:     # Datenträgerbezeichnung, keine Datei
                continue
            cl = struct.unpack_from("<H", e, 26)[0] | (struct.unpack_from("<H", e, 20)[0] << 16)
            groesse = struct.unpack_from("<I", e, 28)[0]
            name = lang or kurz
            if name in (".", ".."):
                continue
            out.append({"name": name, "kurz": kurz, "lang": bool(lang), "verzeichnis": bool(attr & self.ATTR_DIR),
                        "cluster": cl, "groesse": groesse, "attr": attr})
        return out

    def verzeichnis(self, pfad: str) -> list[dict] | None:
        """Einträge unter einem Pfad ('mips' oder 'mips/unter'), Namensvergleich ohne Groß-/Kleinschreibung."""
        cl = 0
        for teil in [t for t in pfad.split("/") if t]:
            treffer = [e for e in self.eintraege(cl) if e["verzeichnis"] and e["name"].lower() == teil.lower()]
            if not treffer:
                return None
            cl = treffer[0]["cluster"]
        return self.eintraege(cl)

    def lies(self, e: dict) -> bytes:
        if e["groesse"] == 0:
            return b""
        noetig = (e["groesse"] + self.cluster_bytes - 1) // self.cluster_bytes
        teile: list[bytes] = []
        gelesen = 0
        for c in self.kette(e["cluster"], noetig):
            if c - 2 >= self.cluster_zahl:
                raise Abbruch(f"{self.herkunft}: {e['name']}: Cluster {c} liegt außerhalb des Volumens")
            b = self.q.read(self._cluster_offset(c), self.cluster_bytes)
            if len(b) < self.cluster_bytes and gelesen + len(b) < e["groesse"]:
                raise Abbruch(f"{self.herkunft}: {e['name']}: Quelle endet mitten in Cluster {c} "
                              f"({gelesen + len(b)} von {e['groesse']} B) — Abbild abgeschnitten?")
            teile.append(b)
            gelesen += len(b)
        d = b"".join(teile)
        if len(d) < e["groesse"]:
            raise Abbruch(f"{self.herkunft}: {e['name']}: Clusterkette endet nach {len(d)} von {e['groesse']} B")
        return d[:e["groesse"]]


# --------------------------------------------------------------------------------------------------
# sunxi-package (Allwinner TOC1-Bootpaket: u-boot, monitor, scp, optee, dtb)
# --------------------------------------------------------------------------------------------------

class SunxiPackage:
    MAGIC = 0x89119800
    STAMP = 0x5F0A6C39
    NAME = b"sunxi-package"

    def __init__(self, q: Quelle, off: int, log: Log, herkunft: str):
        self.herkunft = herkunft
        self.off = off
        h = q.read(off, 0x40)
        if h[:13] != self.NAME:
            raise Abbruch(f"{herkunft}: kein sunxi-package bei {off:#x}")
        magic, add_sum, serial, status, items_nr, valid_len, vmain, vsub = struct.unpack_from("<8I", h, 16)
        self.probleme: list[str] = []
        if magic != self.MAGIC:
            self.probleme.append(f"Magic {magic:#x} statt 0x89119800")
        if h[0x3C:0x40] != b"MIE;":
            self.probleme.append(f"Kopf-Ende {h[0x3C:0x40]!r} statt 'MIE;'")
        if not (1 <= items_nr <= 32):
            raise Abbruch(f"{herkunft}: items_nr {items_nr} unplausibel")
        if valid_len < 0x40 + items_nr * 0x170 or off + valid_len > q.size:
            raise Abbruch(f"{herkunft}: valid_len {valid_len:#x} unplausibel")
        buf = bytearray(q.read(off, valid_len))
        struct.pack_into("<I", buf, 20, self.STAMP)
        n4 = len(buf) // 4
        summe = sum(struct.unpack_from(f"<{n4}I", buf, 0)) & 0xFFFFFFFF
        self.summe_ok = summe == add_sum
        if not self.summe_ok:
            self.probleme.append(f"add_sum {add_sum:#x}, gerechnet {summe:#x}")
        self.items: dict[str, tuple[int, int]] = {}
        for i in range(items_nr):
            o = 0x40 + i * 0x170
            e = buf[o:o + 0x170]
            name = bytes(e[:64]).split(b"\0")[0].decode("latin1", "replace")
            doff, dlen, enc, typ, run, idx = struct.unpack_from("<6I", e, 64)
            if bytes(e[0x16C:0x170]) != b"IIE;":
                self.probleme.append(f"Item {i} ({name}): Ende {bytes(e[0x16C:0x170])!r} statt 'IIE;'")
            if doff + dlen > valid_len:
                self.probleme.append(f"Item {name}: {doff:#x}+{dlen} überschreitet valid_len")
            if enc:
                self.probleme.append(f"Item {name}: encrypt={enc}")
            self.items[name] = (doff, dlen)
        self.q, self.valid_len, self.items_nr = q, valid_len, items_nr
        self.serial, self.status, self.vmain, self.vsub = serial, status, vmain, vsub
        log.info(f"{herkunft}: sunxi-package @{off:#x}, {items_nr} Items, valid_len {valid_len:#x}, "
                 f"Prüfsumme {'ok' if self.summe_ok else 'FALSCH'}: " +
                 ", ".join(f"{n}@{o:#x}+{l}" for n, (o, l) in self.items.items()))
        for p in self.probleme:
            log.warn(f"{herkunft}: {p}")

    def item(self, name: str) -> bytes | None:
        it = self.items.get(name)
        if not it:
            return None
        return self.q.read(self.off + it[0], it[1])


def suche_sunxi_packages(q: Quelle, log: Log, max_bytes: int | None = None) -> list[int]:
    """Byteweise Suche nach 'sunxi-package' (Chunks mit Überlappung) — grep taugt dafür nicht (doku/105 §6)."""
    treffer = []
    chunk, ueberlapp = 8 << 20, 32
    ende = q.size if max_bytes is None else min(q.size, max_bytes)
    off = 0
    while off < ende:
        b = q.read(off, min(chunk + ueberlapp, ende - off))
        i = b.find(SunxiPackage.NAME + b"\0")
        while i >= 0 and i < chunk:
            pos = off + i
            if struct.unpack_from("<I", b, i + 16)[0] == SunxiPackage.MAGIC if i + 20 <= len(b) else False:
                treffer.append(pos)
            i = b.find(SunxiPackage.NAME + b"\0", i + 1)
        off += chunk
    return treffer


def uboot_kennung(ub: bytes) -> str | None:
    """Versionsstring des Vendor-U-Boot ('U-Boot 2018.05-… (Jul 24 2025 - 10:17:21 +0800) Allwinner Technology')."""
    m = re.search(rb"U-Boot [0-9][ -~]{0,120}", ub)
    return m.group(0).decode("latin1") if m else None


def fdt_wurzel(dtb: bytes) -> dict[str, str]:
    """model/compatible der Wurzel eines Flattened Device Tree (nur Beobachtung, robust gegen Müll)."""
    try:
        magic, _total, off_struct, off_strings = struct.unpack_from(">IIII", dtb, 0)
        if magic != 0xD00DFEED:
            return {}
        p, tiefe, props = off_struct, 0, {}
        while p + 4 <= len(dtb):
            tok = struct.unpack_from(">I", dtb, p)[0]
            p += 4
            if tok == 1:      # BEGIN_NODE
                nm = dtb[p:dtb.index(b"\0", p)]
                p = (p + len(nm) + 1 + 3) & ~3
                tiefe += 1
            elif tok == 3:    # PROP
                ln, noff = struct.unpack_from(">II", dtb, p)
                p += 8
                val = dtb[p:p + ln]
                p = (p + ln + 3) & ~3
                pn = dtb[off_strings + noff:dtb.index(b"\0", off_strings + noff)].decode("latin1")
                if tiefe == 1 and pn in ("model", "compatible"):
                    props[pn] = " ".join(t.decode("latin1", "replace") for t in val.split(b"\0") if t)
            elif tok == 2:    # END_NODE
                tiefe -= 1
                if tiefe <= 0:
                    break
            elif tok == 4:    # NOP
                continue
            else:             # END oder Müll
                break
        return props
    except Exception:  # noqa: BLE001
        return {}


def pruefe_scp(scp: bytes, log: Log) -> list[str]:
    """Strukturprüfung des ARISC-Blobs (OR1K, wortweise gespiegelt gespeichert — analyse/arisc/BEFUND.md)."""
    befunde = []
    if len(scp) % 4:
        befunde.append(f"Länge {len(scp)} nicht durch 4 teilbar")
    if scp.count(0) == len(scp):
        befunde.append("Blob ist leer (nur Nullen)")
        return befunde
    if len(scp) >= 0x104:
        w = scp[0x100:0x104][::-1]  # entspiegelt
        op = w[0] >> 2
        if op == 0x00:
            ziel = 0x100 + (int.from_bytes(w, "big") & 0x3FFFFFF) * 4
            befunde.append(f"Reset-Vektor @0x100 = l.j {ziel:#x} (OR1K, plausibel)")
        else:
            befunde.append(f"Reset-Vektor @0x100 ist kein l.j (Opcode {op:#x}) — Byte-Ordnung oder Blob fraglich")
    if len(scp) >= 0x4008:
        kopf = scp[0x4000:0x4008]
        if kopf[4:8] == b"CPUs":
            befunde.append("Parameterkopf @0x4000: 'CPUs' vorhanden")
        else:
            befunde.append(f"Parameterkopf @0x4004 ist {kopf[4:8]!r}, nicht 'CPUs'")
    # Versionsstring (Strings liegen wortweise gespiegelt im Blob)
    gespiegelt = b"".join(scp[i:i + 4][::-1] for i in range(0, len(scp) - 3, 4))
    m = re.search(rb"[ -~]{0,40}ARISC[ -~]{0,60}", gespiegelt)
    if m:
        befunde.append("Versionsstring: '" + m.group(0).decode("latin1").strip() + "'")
    else:
        befunde.append("kein 'ARISC'-Versionsstring gefunden")
    # Anteil wortausgerichteter l.nop (0x15000000) nach Entspiegelung
    nops = 0
    for i in range(0, min(len(scp), 0x20000) - 3, 4):
        if scp[i:i + 4] == b"\x00\x00\x00\x15":
            nops += 1
    befunde.append(f"{nops} wortausgerichtete l.nop in den ersten 128 KiB")
    return befunde


# --------------------------------------------------------------------------------------------------
# LP-Metadaten (Android dynamic partitions, „super")
# --------------------------------------------------------------------------------------------------

class LpSuper:
    GEO_MAGIC = 0x616C4467
    HDR_MAGIC = 0x414C5030

    def __init__(self, q: Quelle, log: Log):
        self.q = q
        geo = None
        for goff in (4096, 8192):
            g = q.read(goff, 52)
            if len(g) == 52 and struct.unpack_from("<I", g, 0)[0] == self.GEO_MAGIC:
                struct_size = struct.unpack_from("<I", g, 4)[0]
                gg = bytearray(q.read(goff, struct_size))
                chk = bytes(gg[8:40])
                gg[8:40] = b"\0" * 32
                ok = hashlib.sha256(bytes(gg)).digest() == chk
                if ok:
                    geo = g
                    log.info(f"LP-Geometrie @{goff} gültig (sha256 ok)")
                    break
                log.warn(f"LP-Geometrie @{goff}: Prüfsumme falsch")
        if geo is None:
            raise Abbruch("keine gültige LP-Geometrie bei 4096/8192 — ist das eine 'super'-Partition?")
        self.metadata_max_size, self.slot_count, self.logical_block_size = struct.unpack_from("<III", geo, 40)
        log.info(f"LP: metadata_max_size {self.metadata_max_size}, Slots {self.slot_count}, logical_block {self.logical_block_size}")
        basis = 4096 + 2 * 4096
        kandidaten = [("primär", basis)] + [("backup", basis + self.slot_count * self.metadata_max_size)]
        self.parts: dict[str, dict] = {}
        gefunden = False
        for lage, moff in kandidaten:
            try:
                self._lies_metadaten(moff, log, lage)
                gefunden = True
                break
            except Abbruch as e:
                log.warn(f"LP-Metadaten {lage} @{moff}: {e}")
        if not gefunden:
            raise Abbruch("keine gültigen LP-Metadaten")

    def _lies_metadaten(self, moff: int, log: Log, lage: str):
        h = self.q.read(moff, 256)
        magic, major, minor, header_size = struct.unpack_from("<IHHI", h, 0)
        if magic != self.HDR_MAGIC:
            raise Abbruch(f"Magic {magic:#x}")
        if header_size not in (128, 256):
            raise Abbruch(f"header_size {header_size}")
        hdr = bytearray(h[:header_size])
        header_checksum = bytes(hdr[12:44])
        hdr[12:44] = b"\0" * 32
        if hashlib.sha256(bytes(hdr)).digest() != header_checksum:
            raise Abbruch("Kopf-Prüfsumme falsch")
        tables_size = struct.unpack_from("<I", h, 44)[0]
        tables_checksum = h[48:80]
        p_off, p_n, p_sz = struct.unpack_from("<III", h, 80)
        e_off, e_n, e_sz = struct.unpack_from("<III", h, 92)
        g_off, g_n, g_sz = struct.unpack_from("<III", h, 104)
        b_off, b_n, b_sz = struct.unpack_from("<III", h, 116)
        tab = self.q.read(moff + header_size, tables_size)
        if hashlib.sha256(tab).digest() != tables_checksum:
            raise Abbruch("Tabellen-Prüfsumme falsch")
        extents = []
        for i in range(e_n):
            e = tab[e_off + i * e_sz:e_off + (i + 1) * e_sz]
            num_sectors, target_type, target_data, target_source = struct.unpack_from("<QIQI", e, 0)
            extents.append((num_sectors, target_type, target_data, target_source))
        gruppen = []
        for i in range(g_n):
            g = tab[g_off + i * g_sz:g_off + (i + 1) * g_sz]
            gruppen.append(g[:36].split(b"\0")[0].decode("latin1"))
        geraete = []
        for i in range(b_n):
            b = tab[b_off + i * b_sz:b_off + (i + 1) * b_sz]
            first_sector, _al, _ao, size = struct.unpack_from("<QIIQ", b, 0)
            geraete.append((b[24:60].split(b"\0")[0].decode("latin1"), first_sector, size))
        for i in range(p_n):
            p = tab[p_off + i * p_sz:p_off + (i + 1) * p_sz]
            name = p[:36].split(b"\0")[0].decode("latin1")
            attrs, first_ext, n_ext, grp = struct.unpack_from("<IIII", p, 36)
            exts = extents[first_ext:first_ext + n_ext]
            groesse = sum(x[0] for x in exts) * SEKTOR
            self.parts[name] = {"attrs": attrs, "extents": exts, "size": groesse,
                                "gruppe": gruppen[grp] if grp < len(gruppen) else "?"}
        self.version = f"{major}.{minor}"
        self.lage = lage
        self.geraete = geraete
        log.info(f"LP-Metadaten {lage} @{moff}: v{major}.{minor}, header_size {header_size}, {p_n} Partitionen, {e_n} Extents, "
                 f"{g_n} Gruppen, Blockgeräte {', '.join(f'{n}({s} B)' for n, _f, s in geraete)}")
        for name, p in self.parts.items():
            ex = "; ".join((f"linear Sektor {d}+{n}" if t == 0 else f"zero {n}") for n, t, d, _s in p["extents"])
            log.info(f"  {name:20s} {p['size']:12d} B  attrs {p['attrs']:#x}  Gruppe {p['gruppe']}  [{ex or 'leer'}]")

    def partition(self, name: str, log: Log) -> Quelle | None:
        p = self.parts.get(name)
        if not p:
            return None
        teile = []
        for n, t, d, s in p["extents"]:
            if t == 0:
                teile.append(self.q.sub(d * SEKTOR, n * SEKTOR, f"{name} extent"))
            else:
                log.warn(f"LP {name}: Zero-Extent {n} Sektoren — als Nullen gelesen")
                teile.append(NullQuelle(n * SEKTOR))
        if not teile:
            return None
        return KettenQuelle(teile, f"LP-Partition {name}")


class NullQuelle(Quelle):
    def __init__(self, size):
        self.size, self.name = size, "zero"

    def read(self, off, n):
        return b"\0" * max(0, min(n, self.size - off))


# --------------------------------------------------------------------------------------------------
# ext4 — nur lesend, in reinem Python (Standardbibliothek); der alte Weg über debugfs bleibt als --use-debugfs
# --------------------------------------------------------------------------------------------------

class Ext4Basis:
    """Gemeinsame Oberfläche der beiden ext4-Leser (Python-Leser und debugfs-Rückfall).

    `existiert` und `gehe` stehen absichtlich nur hier: die Ausgabe des Werkzeugs hängt an der Reihenfolge,
    in der `gehe` läuft, und an den Feldnamen der Einträge — beides ist so für beide Wege garantiert gleich.
    Ein Eintrag ist {'name', 'ino', 'mode', 'size', 'typ'} mit 'typ' aus 'd' (Verzeichnis), 'l' (Symlink),
    'f' (alles andere); 'size' ist bei Verzeichnissen 0 (so gibt es debugfs `ls -p` aus).
    """

    beschreibung: str = ""

    def ls(self, pfad: str) -> list[dict]:
        raise NotImplementedError

    def lies(self, pfad: str, tmp: Path | None = None) -> bytes:
        raise NotImplementedError

    def existiert(self, pfad: str) -> dict | None:
        d, n = pfad.rsplit("/", 1)
        for e in self.ls(d or "/"):
            if e["name"] == n:
                return e
        return None

    def gehe(self, wurzel: str = "/", max_tiefe: int = 6):
        """Alle Dateien (Pfad, Eintrag) unterhalb wurzel."""
        offen = [(wurzel.rstrip("/") or "/", 0)]
        while offen:
            pfad, tiefe = offen.pop()
            for e in self.ls(pfad):
                voll = (pfad.rstrip("/") + "/" + e["name"])
                if e["typ"] == "d":
                    if tiefe < max_tiefe:
                        offen.append((voll, tiefe + 1))
                else:
                    yield voll, e


class Ext4(Ext4Basis):
    """Nur-Lese-ext2/3/4 in reinem Python — kein debugfs, kein Mount, kein e2fsprogs, läuft auch unter Windows.

    Gebraucht für die vendor-Partition (ext4, ~114 MB), aus der EDID, `libmspsound.so`, die PQ-Dateien und
    `panel_config.ini` kommen. Die Partition liegt nie am Dateianfang, sondern als Bereich in einer größeren
    Datei (IMAGEWTY → super → LP-Extent, oft zusätzlich Android-Sparse); deshalb liest der Leser über eine
    `Quelle` — die ist genau „(Datei, Startoffset, Länge)" und ersetzt das `?offset=` von debugfs. Ein
    Zwischenspeichern der Partition als Datei entfällt damit ganz.

    Kann: Superblock (Magic 0xEF53), Gruppendeskriptoren (32 und 64 B, INCOMPAT_64BIT), Inodes beliebiger
    Größe, Extents (Magic 0xF30A, auch Bäume mit Tiefe > 0, unbelegte Extents lesen als Nullen), die alten
    indirekten Blöcke (1./2./3. Stufe), lineare Verzeichnisse (auch in einem `dir_index`-Dateisystem: die
    Hash-Baum-Knoten sind als Einträge mit Inode 0 getarnt und werden übersprungen), Pfadauflösung mit
    Symlinks (schnelle im Inode wie langsame in Blöcken) und Dateien mit Löchern (sparse).

    Kann nicht (und braucht es hier nicht): schreiben, Journal-Wiedergabe, Verschlüsselung, `inline_data`,
    `bigalloc`, `meta_bg`. Jeder dieser Fälle wird erkannt und laut gemeldet, nicht stillschweigend falsch
    gelesen.
    """

    MAGIC = 0xEF53
    WURZEL = 2                              # Inode-Nummer der Wurzel

    INCOMPAT_COMPRESSION = 0x0001
    INCOMPAT_FILETYPE    = 0x0002
    INCOMPAT_META_BG     = 0x0010
    INCOMPAT_EXTENTS     = 0x0040
    INCOMPAT_64BIT       = 0x0080
    INCOMPAT_INLINE_DATA = 0x8000
    INCOMPAT_ENCRYPT     = 0x10000
    ROCOMPAT_BIGALLOC    = 0x0200

    FL_EXTENTS     = 0x00080000             # EXT4_EXTENTS_FL
    FL_INLINE_DATA = 0x10000000             # EXT4_INLINE_DATA_FL
    FL_ENCRYPT     = 0x00000800             # EXT4_ENCRYPT_FL

    EXT_MAGIC = 0xF30A                      # eh_magic im Extent-Kopf
    MAX_SYMLINK = 16                        # Symlink-Ketten je Pfad
    BLOCK_CHUNK = 8 << 20                   # größter Einzellesezugriff

    def __init__(self, q: Quelle, tmp: Path | None = None, label: str = "ext4", log: Log | None = None):
        self.q, self.label = q, label
        self.log = log or Log(quiet=True)
        self.probleme: list[str] = []
        sb = q.read(0x400, 0x400)
        if len(sb) < 0x100 or struct.unpack_from("<H", sb, 0x38)[0] != self.MAGIC:
            raise Abbruch(f"{label}: kein ext4-Superblock (Magic bei 0x438 fehlt) — erofs/f2fs? Nicht unterstützt.")
        u32 = lambda o: struct.unpack_from("<I", sb, o)[0]       # noqa: E731
        u16 = lambda o: struct.unpack_from("<H", sb, o)[0]       # noqa: E731
        self.inodes_count = u32(0x00)
        s_blocks_lo = u32(0x04)
        self.first_data_block = u32(0x14)
        log_bs = u32(0x18)
        if log_bs > 16:
            raise Abbruch(f"{label}: unsinnige Blockgröße im Superblock (s_log_block_size {log_bs})")
        self.block_size = 1024 << log_bs
        self.blocks_per_group = u32(0x20)
        self.clusters_per_group = u32(0x24)
        self.inodes_per_group = u32(0x28)
        self.rev_level = u32(0x4c)
        self.inode_size = u16(0x58) if self.rev_level >= 1 else 128
        self.feat_compat = u32(0x5c)
        self.feat_incompat = u32(0x60)
        self.feat_ro_compat = u32(0x64)
        self.uuid = sb[0x68:0x78].hex()
        vol = sb[0x78:0x88].split(b"\0")[0].decode("latin1", "replace")
        self.label_fs = vol
        desc_size = u16(0xfe)
        blocks_hi = u32(0x150) if (self.feat_incompat & self.INCOMPAT_64BIT) else 0
        self.blocks_count = s_blocks_lo | (blocks_hi << 32)
        # Wortlaut wie bisher — er steht so im Manifest (eingang.vendor_fs) und im Bericht.
        self.beschreibung = (f"ext4, Block {self.block_size}, {s_blocks_lo} Blöcke = {s_blocks_lo * self.block_size} B, "
                             f"Label '{vol}', feature_incompat {self.feat_incompat:#x}")
        self.log.info(f"{label}: {self.beschreibung}")

        if not self.inodes_per_group or not self.blocks_per_group or not self.inode_size:
            raise Abbruch(f"{label}: unbrauchbarer Superblock (inodes/Gruppe {self.inodes_per_group}, "
                          f"Blöcke/Gruppe {self.blocks_per_group}, Inode-Größe {self.inode_size})")
        if self.inode_size & (self.inode_size - 1) or self.inode_size < 128:
            raise Abbruch(f"{label}: unsinnige Inode-Größe {self.inode_size}")
        for bit, wie in ((self.INCOMPAT_COMPRESSION, "compression"), (self.INCOMPAT_ENCRYPT, "encrypt"),
                         (self.INCOMPAT_INLINE_DATA, "inline_data"), (self.INCOMPAT_META_BG, "meta_bg")):
            if self.feat_incompat & bit:
                raise Abbruch(f"{label}: ext4-Merkmal '{wie}' wird von diesem Leser nicht unterstützt "
                              f"(feature_incompat {self.feat_incompat:#x}) — mit --use-debugfs versuchen")
        if self.feat_ro_compat & self.ROCOMPAT_BIGALLOC:
            raise Abbruch(f"{label}: ext4-Merkmal 'bigalloc' wird von diesem Leser nicht unterstützt "
                          f"— mit --use-debugfs versuchen")

        self.hat_64bit = bool(self.feat_incompat & self.INCOMPAT_64BIT)
        self.desc_size = (desc_size or 32) if self.hat_64bit else 32
        if self.desc_size < 32 or self.desc_size > self.block_size:
            raise Abbruch(f"{label}: unsinnige Gruppendeskriptorgröße {self.desc_size}")
        self.hat_filetype = bool(self.feat_incompat & self.INCOMPAT_FILETYPE)
        self.gruppen = max(1, (self.blocks_count - self.first_data_block + self.blocks_per_group - 1)
                           // self.blocks_per_group)
        # Gruppendeskriptoren stehen im Block hinter dem Superblock
        gd_off = (self.first_data_block + 1) * self.block_size
        gd = q.read(gd_off, self.gruppen * self.desc_size)
        if len(gd) < self.gruppen * self.desc_size:
            raise Abbruch(f"{label}: Gruppendeskriptoren unvollständig ({len(gd)} von "
                          f"{self.gruppen * self.desc_size} B) — Bereich zu klein?")
        self.inode_tabelle: list[int] = []
        for g in range(self.gruppen):
            d = gd[g * self.desc_size:(g + 1) * self.desc_size]
            lo = struct.unpack_from("<I", d, 8)[0]
            hi = struct.unpack_from("<I", d, 40)[0] if (self.hat_64bit and self.desc_size >= 64) else 0
            self.inode_tabelle.append(lo | (hi << 32))
        self.aufbau = (f"{self.gruppen} Gruppe(n) à {self.blocks_per_group} Blöcke, {self.inodes_per_group} Inodes; "
                       f"Inode-Größe {self.inode_size}, Deskriptor {self.desc_size} B"
                       f"{' (64bit)' if self.hat_64bit else ''}, {self.inodes_count} Inodes, UUID {self.uuid}")

        self._inode_cache: dict[int, dict] = {}
        self._dir_cache: dict[int, list] = {}
        self._karten_cache: dict[int, list] = {}
        self._cache: dict[str, list] = {}
        # Zählwerk für den Bericht: welche ext4-Merkmale das Dateisystem wirklich benutzt
        self.stat = {"inodes": 0, "extent_inodes": 0, "indirekt_inodes": 0, "extent_max_tiefe": 0,
                     "extent_knoten": 0, "extents": 0, "unbelegte_extents": 0, "loecher": 0,
                     "symlink_schnell": 0, "symlink_block": 0, "verzeichnisse": 0, "htree_verzeichnisse": 0,
                     "gelesene_bytes": 0}

    # ---- Blöcke ---------------------------------------------------------------------------------

    def _block(self, nr: int, anzahl: int = 1) -> bytes:
        """Physische Blöcke lesen; Block 0 gibt es als Datenblock nicht (er heißt „Loch")."""
        if nr <= 0:
            return b"\0" * (self.block_size * anzahl)
        if nr + anzahl > self.blocks_count:
            raise Abbruch(f"{self.label}: Block {nr} liegt außerhalb des Dateisystems ({self.blocks_count} Blöcke)")
        out = bytearray()
        rest, p = anzahl * self.block_size, nr * self.block_size
        while rest > 0:
            k = min(rest, self.BLOCK_CHUNK)
            b = self.q.read(p, k)
            if len(b) < k:
                hinweis = (f"{self.label}: Quelle endet bei {p + len(b)} B, Block {nr}+{anzahl} reicht bis "
                           f"{(nr + anzahl) * self.block_size} B — fehlender Rest wird als Nullen gelesen")
                if hinweis not in self.probleme:
                    self.probleme.append(hinweis)
                    self.log.warn(hinweis)
                b += b"\0" * (k - len(b))
            out += b
            p += k
            rest -= k
        self.stat["gelesene_bytes"] += len(out)
        return bytes(out)

    # ---- Inodes ---------------------------------------------------------------------------------

    @staticmethod
    def _typ(mode: int) -> str:
        t = mode & 0o170000
        return "d" if t == 0o040000 else "l" if t == 0o120000 else "f"

    def inode(self, ino: int) -> dict:
        c = self._inode_cache.get(ino)
        if c is not None:
            return c
        if ino < 1 or ino > self.inodes_count:
            raise Abbruch(f"{self.label}: Inode {ino} liegt außerhalb des Dateisystems (1..{self.inodes_count})")
        g, idx = divmod(ino - 1, self.inodes_per_group)
        off = self.inode_tabelle[g] * self.block_size + idx * self.inode_size
        roh = self.q.read(off, self.inode_size)
        if len(roh) < 128:
            raise Abbruch(f"{self.label}: Inode {ino} nicht lesbar (Tabelle außerhalb der Quelle?)")
        mode, uid_lo, size_lo, _at, _ct, _mt, _dt, gid_lo, links, blocks_lo, flags = struct.unpack_from(
            "<HHIIIIIHHII", roh, 0)
        i_block = roh[40:100]
        file_acl = struct.unpack_from("<I", roh, 104)[0]
        size_hi = struct.unpack_from("<I", roh, 108)[0]
        typ = self._typ(mode)
        # debugfs `ls -p` gibt bei Verzeichnissen keine Größe aus (das Feld bleibt leer -> 0)
        groesse = size_lo | (size_hi << 32)
        d = {"ino": ino, "mode": mode, "typ": typ, "uid": uid_lo, "gid": gid_lo, "links": links,
             "flags": flags, "blocks_lo": blocks_lo, "file_acl": file_acl, "i_block": i_block,
             "groesse": size_lo if typ == "d" else groesse, "groesse_ls": 0 if typ == "d" else groesse}
        self._inode_cache[ino] = d
        self.stat["inodes"] += 1
        if flags & self.FL_EXTENTS:
            self.stat["extent_inodes"] += 1
        elif typ in ("d", "f") and groesse:
            self.stat["indirekt_inodes"] += 1
        if typ == "d":
            self.stat["verzeichnisse"] += 1
            if flags & 0x1000:              # EXT4_INDEX_FL — Hash-Baum, wird linear gelesen
                self.stat["htree_verzeichnisse"] += 1
        return d

    # ---- Blockabbildung: Extents und die alten indirekten Blöcke --------------------------------

    def _extent_knoten(self, roh: bytes, ino: int, out: list, tiefe: int = 0):
        if len(roh) < 12:
            raise Abbruch(f"{self.label}: Inode {ino}: Extent-Knoten zu kurz")
        magic, entries, _max, depth, _gen = struct.unpack_from("<HHHHI", roh, 0)
        if magic != self.EXT_MAGIC:
            raise Abbruch(f"{self.label}: Inode {ino}: Extent-Kopf ohne Magic 0xF30A (ist {magic:#06x})")
        self.stat["extent_knoten"] += 1
        self.stat["extent_max_tiefe"] = max(self.stat["extent_max_tiefe"], depth + tiefe)
        if 12 + entries * 12 > len(roh):
            raise Abbruch(f"{self.label}: Inode {ino}: {entries} Extent-Einträge passen nicht in den Knoten")
        for i in range(entries):
            o = 12 + i * 12
            if depth == 0:
                ee_block, ee_len, hi, lo = struct.unpack_from("<IHHI", roh, o)
                belegt = ee_len <= 32768
                laenge = ee_len if belegt else ee_len - 32768
                if not belegt:
                    self.stat["unbelegte_extents"] += 1
                self.stat["extents"] += 1
                # Unbelegte Extents (fallocate) lesen sich als Nullen — deshalb wie ein Loch behandeln.
                out.append((ee_block, laenge, (lo | (hi << 32)) if belegt else 0))
            else:
                ei_block, leaf_lo, leaf_hi, _u = struct.unpack_from("<IIHH", roh, o)
                kind = self._block(leaf_lo | (leaf_hi << 32))
                self._extent_knoten(kind, ino, out, tiefe + 1)

    def _indirekt(self, nr: int, stufe: int, start: int, karte: list, grenze: int):
        """Indirekte Blöcke (ext2/3-Art) rekursiv abklappern; `start` ist der erste logische Block darunter."""
        pro = self.block_size // 4
        spanne = pro ** (stufe - 1)
        if nr == 0:
            return
        tab = self._block(nr)
        for i in range(pro):
            lb = start + i * spanne
            if lb >= grenze:
                break
            p = struct.unpack_from("<I", tab, i * 4)[0]
            if stufe == 1:
                if p:
                    karte.append((lb, 1, p))
            else:
                self._indirekt(p, stufe - 1, lb, karte, grenze)

    def _karte(self, ino: int, inode: dict) -> list:
        """Liste (logischer Start, Anzahl Blöcke, physischer Start); was fehlt, ist ein Loch."""
        c = self._karten_cache.get(ino)
        if c is not None:
            return c
        if inode["flags"] & self.FL_INLINE_DATA:
            raise Abbruch(f"{self.label}: Inode {ino}: inline_data wird von diesem Leser nicht unterstützt")
        if inode["flags"] & self.FL_ENCRYPT:
            raise Abbruch(f"{self.label}: Inode {ino}: verschlüsselt — wird nicht gelesen")
        karte: list = []
        if inode["flags"] & self.FL_EXTENTS:
            self._extent_knoten(inode["i_block"], ino, karte)
        else:
            nb = (inode["groesse"] + self.block_size - 1) // self.block_size
            ib = struct.unpack_from("<15I", inode["i_block"], 0)
            for i in range(12):
                if i >= nb:
                    break
                if ib[i]:
                    karte.append((i, 1, ib[i]))
            pro = self.block_size // 4
            self._indirekt(ib[12], 1, 12, karte, nb)
            self._indirekt(ib[13], 2, 12 + pro, karte, nb)
            self._indirekt(ib[14], 3, 12 + pro + pro * pro, karte, nb)
        karte.sort()
        self._karten_cache[ino] = karte
        return karte

    def _daten(self, ino: int, inode: dict) -> bytes:
        groesse = inode["groesse"]
        if groesse == 0:
            return b""
        if inode["typ"] == "l" and self._ist_schneller_symlink(inode):
            return inode["i_block"][:groesse]
        out = bytearray(groesse)                        # Löcher bleiben Nullen (sparse)
        bs = self.block_size
        belegt = 0
        for lblk, ln, pblk in self._karte(ino, inode):
            if pblk == 0:
                continue
            off = lblk * bs
            if off >= groesse:
                continue
            n = min(ln * bs, groesse - off)
            out[off:off + n] = self._block(pblk, ln)[:n]
            belegt += n
        if belegt < groesse:
            self.stat["loecher"] += 1
        return bytes(out)

    def _ist_schneller_symlink(self, inode: dict) -> bool:
        """Schneller Symlink: das Ziel steht in i_block, es hängen keine Datenblöcke am Inode."""
        ea = (self.block_size >> 9) if inode["file_acl"] else 0
        return inode["blocks_lo"] - ea == 0 and inode["groesse"] <= 60

    def symlink_ziel(self, ino: int, inode: dict) -> str:
        if self._ist_schneller_symlink(inode):
            self.stat["symlink_schnell"] += 1
            roh = inode["i_block"][:inode["groesse"]]
        else:
            self.stat["symlink_block"] += 1
            roh = self._daten(ino, inode)
        return roh.split(b"\0")[0].decode("utf-8", "replace")

    # ---- Verzeichnisse (linear; Hash-Baum-Knoten tarnen sich als Einträge mit Inode 0) -----------

    def _verzeichnis(self, ino: int) -> list[tuple[str, int, int]]:
        c = self._dir_cache.get(ino)
        if c is not None:
            return c
        inode = self.inode(ino)
        daten = self._daten(ino, inode)
        out: list[tuple[str, int, int]] = []
        bs = self.block_size
        for bo in range(0, len(daten), bs):
            blk = daten[bo:bo + bs]
            off = 0
            while off + 8 <= len(blk):
                kind, rec_len, name_len, ftype = struct.unpack_from("<IHBB", blk, off)
                if rec_len < 8 or rec_len % 4 or off + rec_len > len(blk):
                    if kind or off == 0:
                        self.probleme.append(f"Inode {ino}: kaputter Verzeichniseintrag bei {bo + off} "
                                             f"(rec_len {rec_len})")
                    break
                nl = name_len if self.hat_filetype else (name_len | (ftype << 8))
                if kind and 8 + nl <= rec_len:
                    name = blk[off + 8:off + 8 + nl].decode("utf-8", "replace")
                    out.append((name, kind, ftype if self.hat_filetype else 0))
                off += rec_len
        self._dir_cache[ino] = out
        return out

    # ---- Pfade (mit Symlinks) --------------------------------------------------------------------

    def _kind(self, ino: int, name: str) -> int | None:
        for n, kino, _ft in self._verzeichnis(ino):
            if n == name:
                return kino
        return None

    def pfad_ino(self, pfad: str, folge_letzten: bool = True) -> int | None:
        """Inode-Nummer zu einem absoluten Pfad; Symlinks werden gefolgt (schnelle wie langsame)."""
        ino = self.WURZEL
        komp = [t for t in pfad.split("/") if t and t != "."]
        i, links = 0, 0
        while i < len(komp):
            name = komp[i]
            i += 1
            inode = self.inode(ino)
            if inode["typ"] != "d":
                return None
            kind = self._kind(ino, name)
            if kind is None:
                return None
            kinode = self.inode(kind)
            if kinode["typ"] == "l" and (folge_letzten or i < len(komp)):
                links += 1
                if links > self.MAX_SYMLINK:
                    raise Abbruch(f"{self.label}: {pfad}: Symlinks im Kreis (mehr als {self.MAX_SYMLINK} Stufen)")
                ziel = self.symlink_ziel(kind, kinode)
                rest = komp[i:]
                komp = [t for t in ziel.split("/") if t and t != "."] + rest
                i = 0
                if ziel.startswith("/"):
                    ino = self.WURZEL
                continue                                # relativ: `ino` bleibt das Elternverzeichnis
            ino = kind
        return ino

    # ---- Oberfläche (wie beim debugfs-Weg) -------------------------------------------------------

    def ls(self, pfad: str) -> list[dict]:
        if pfad in self._cache:
            return self._cache[pfad]
        eintraege: list[dict] = []
        ino = self.pfad_ino(pfad or "/")
        if ino is not None:
            inode = self.inode(ino)
            if inode["typ"] == "d":
                for name, kino, _ft in self._verzeichnis(ino):
                    if name in (".", ".."):
                        continue
                    ki = self.inode(kino)
                    eintraege.append({"name": name, "ino": kino, "mode": ki["mode"], "size": ki["groesse_ls"],
                                      "typ": ki["typ"]})
        self._cache[pfad] = eintraege
        return eintraege

    def lies(self, pfad: str, tmp: Path | None = None) -> bytes:
        ino = self.pfad_ino(pfad)
        if ino is None:
            raise Abbruch(f"{self.label}: {pfad} nicht gefunden")
        inode = self.inode(ino)
        if inode["typ"] == "d":
            raise Abbruch(f"{self.label}: {pfad} ist ein Verzeichnis")
        return self._daten(ino, inode)

    def statistik(self) -> str:
        s = self.stat
        return (f"{self.aufbau}; gelesen: {s['inodes']} Inodes ({s['extent_inodes']} mit Extents, "
                f"{s['indirekt_inodes']} indirekt), {s['extents']} Extents in {s['extent_knoten']} Knoten, "
                f"Baumtiefe max {s['extent_max_tiefe']}, {s['unbelegte_extents']} unbelegt, "
                f"{s['verzeichnisse']} Verzeichnisse ({s['htree_verzeichnisse']} mit dir_index-Flag), "
                f"{s['symlink_schnell']}+{s['symlink_block']} Symlinks (schnell+in Blöcken), "
                f"{s['loecher']} Dateien mit Löchern, {s['gelesene_bytes']} B aus der Quelle geholt")


class Ext4Debugfs(Ext4Basis):
    """Der alte Weg über `debugfs` aus e2fsprogs (`--use-debugfs`) — als Gegenprobe zum Python-Leser.

    Braucht ein installiertes e2fsprogs und läuft deshalb nicht überall (unter Windows gar nicht); kann die
    Partition außerdem nicht immer an Ort und Stelle lesen und legt sie dann als Datei zwischen.
    """

    def __init__(self, q: Quelle, tmp: Path, label: str, log: Log):
        self.log = log
        sb = q.read(0x400, 0x100)
        if len(sb) < 0x100 or struct.unpack_from("<H", sb, 0x38)[0] != 0xEF53:
            raise Abbruch(f"{label}: kein ext4-Superblock (Magic bei 0x438 fehlt) — erofs/f2fs? Nicht unterstützt.")
        s_blocks_lo = struct.unpack_from("<I", sb, 4)[0]
        log_bs = struct.unpack_from("<I", sb, 0x18)[0]
        self.block_size = 1024 << log_bs
        vol = sb[0x78:0x88].split(b"\0")[0].decode("latin1", "replace")
        feat_incompat = struct.unpack_from("<I", sb, 0x60)[0]
        self.beschreibung = (f"ext4, Block {self.block_size}, {s_blocks_lo} Blöcke = {s_blocks_lo * self.block_size} B, "
                             f"Label '{vol}', feature_incompat {feat_incompat:#x}")
        log.info(f"{label}: {self.beschreibung}")
        if shutil.which("debugfs") is None:
            raise Abbruch("debugfs (e2fsprogs) nicht gefunden — nötig für --use-debugfs (ohne die Option "
                          "liest h713-extract ext4 selbst)")
        b = q.backing()
        self.datei: Path | None = None
        if b is not None:
            self.dev = f"{b[0]}?offset={b[1]}"
            # Probe: kann diese debugfs-Version ?offset= ?
            if "Inode: 2" not in self._roh(["stat <2>"]).get("stat <2>", ""):
                log.info("debugfs kann '?offset=' hier nicht — Partition wird zwischengespeichert")
                b = None
        if b is None:
            self.datei = tmp / f"{label}.ext4"
            materialisiere(q, self.datei, log)
            self.dev = str(self.datei)
        self._cache: dict[str, list] = {}

    def _roh(self, cmds: list[str]) -> dict[str, str]:
        r = subprocess.run(["debugfs", "-f", "-", self.dev], input=("\n".join(cmds) + "\n").encode(),
                           capture_output=True)
        text = r.stdout.decode("utf-8", "replace")
        out: dict[str, str] = {}
        akt = None
        for line in text.splitlines():
            if line.startswith("debugfs: "):
                akt = line[len("debugfs: "):].strip()
                out.setdefault(akt, "")
            elif akt is not None:
                out[akt] += line + "\n"
        return out

    def ls(self, pfad: str) -> list[dict]:
        if pfad in self._cache:
            return self._cache[pfad]
        cmd = f"ls -p {pfad}"
        out = self._roh([cmd]).get(cmd, "")
        eintraege = []
        for line in out.splitlines():
            if not line.startswith("/"):
                continue
            f = line.split("/")
            # /ino/mode/uid/gid/name/size/
            if len(f) < 7:
                continue
            try:
                ino, mode = int(f[1]), int(f[2], 8)
                size = int(f[6]) if f[6] else 0
            except ValueError:
                continue
            name = f[5]
            if name in (".", ".."):
                continue
            eintraege.append({"name": name, "ino": ino, "mode": mode, "size": size,
                              "typ": "d" if (mode & 0o170000) == 0o040000 else "l" if (mode & 0o170000) == 0o120000 else "f"})
        self._cache[pfad] = eintraege
        return eintraege

    def lies(self, pfad: str, tmp: Path | None = None) -> bytes:
        ziel = Path(tmp) / ("dump-" + hashlib.md5(pfad.encode()).hexdigest())
        cmd = f"dump -p {pfad} {ziel}"
        self._roh([cmd])
        if not ziel.exists():
            raise Abbruch(f"debugfs konnte {pfad} nicht lesen")
        b = ziel.read_bytes()
        ziel.unlink()
        return b


# --------------------------------------------------------------------------------------------------
# ELF-Symbol (patch_msp in libmspsound.so) und MSPM-Prüfung
# --------------------------------------------------------------------------------------------------

def elf_symbol(data: bytes, symbol: str) -> tuple[int, int, str] | None:
    """(Dateioffset, Größe, Sektion) eines Symbols aus .dynsym/.symtab; Abbildung über die Sektion (sh_addr -> sh_offset)."""
    if data[:4] != b"\x7fELF":
        raise Abbruch("keine ELF-Datei")
    cls, endian = data[4], data[5]
    E = "<" if endian == 1 else ">"
    if cls == 1:
        e_shoff, = struct.unpack_from(E + "I", data, 0x20)
        e_shentsize, e_shnum, e_shstrndx = struct.unpack_from(E + "HHH", data, 0x2E)
        sh_fmt, sh_len = E + "IIIIIIIIII", 40
        sym_fmt, sym_len = E + "IIIBBH", 16
    else:
        e_shoff, = struct.unpack_from(E + "Q", data, 0x28)
        e_shentsize, e_shnum, e_shstrndx = struct.unpack_from(E + "HHH", data, 0x3A)
        sh_fmt, sh_len = E + "IIQQQQIIQQ", 64
        sym_fmt, sym_len = E + "IBBHQQ", 24
    sects = []
    for i in range(e_shnum):
        s = struct.unpack_from(sh_fmt, data, e_shoff + i * e_shentsize)
        if cls == 1:
            name, typ, flags, addr, off, size, link, info, align, entsize = s
        else:
            name, typ, flags, addr, off, size, link, info, align, entsize = s
        sects.append({"name": name, "type": typ, "addr": addr, "off": off, "size": size, "link": link, "entsize": entsize})
    shstr = sects[e_shstrndx] if e_shstrndx < len(sects) else None

    def sname(i):
        if shstr is None:
            return "?"
        o = shstr["off"] + i
        return data[o:data.find(b"\0", o)].decode("latin1", "replace")

    for s in sects:
        s["sname"] = sname(s["name"])
    for s in sects:
        if s["type"] not in (2, 11):  # SYMTAB, DYNSYM
            continue
        strtab = sects[s["link"]]
        n = s["size"] // sym_len
        for i in range(n):
            o = s["off"] + i * sym_len
            if cls == 1:
                st_name, st_value, st_size, st_info, st_other, st_shndx = struct.unpack_from(sym_fmt, data, o)
            else:
                st_name, st_info, st_other, st_shndx, st_value, st_size = struct.unpack_from(sym_fmt, data, o)
            no = strtab["off"] + st_name
            nm = data[no:data.find(b"\0", no)]
            if nm == symbol.encode():
                if st_shndx == 0 or st_shndx >= len(sects):
                    return None
                sec = sects[st_shndx]
                if sec["type"] == 8:  # NOBITS
                    return None
                return (sec["off"] + (st_value - sec["addr"]), st_size, sec["sname"])
    return None


def parse_mspm(blob: bytes) -> tuple[list[dict], list[str]]:
    """MSPM-Blockkette: 'MSPM' | u16 0 | u16 0x01TT | u32 BE (Länge<<8). Liefert Blöcke und Befunde."""
    bloecke, probleme = [], []
    o = 0
    while o < len(blob):
        h = blob[o:o + 12]
        if len(h) < 12 or h[:4] != b"MSPM":
            probleme.append(f"bei +{o:#x}: kein MSPM-Kopf ({h[:4]!r})")
            break
        z, ziel, raw = struct.unpack(">HHI", h[4:12])
        laenge = raw >> 8
        if z != 0 or (ziel >> 8) != 1 or (raw & 0xFF) != 0:
            probleme.append(f"Block {len(bloecke)} bei +{o:#x}: Kopffelder {z:#x} {ziel:#x} {raw:#x} unerwartet")
        if laenge % 4 or o + 12 + laenge > len(blob):
            probleme.append(f"Block {len(bloecke)} bei +{o:#x}: Länge {laenge} passt nicht")
            break
        dsp = {0x100: "DSP1", 0x102: "DSP2"}.get(ziel, f"?{ziel:#x}")
        bloecke.append({"offset": o, "ziel": dsp, "laenge": laenge, "paare": laenge // 4})
        o += 12 + laenge
    if o != len(blob):
        probleme.append(f"Kette endet bei +{o:#x}, Blob hat {len(blob)} B")
    if not bloecke:
        probleme.append("kein einziger MSPM-Block")
    return bloecke, probleme


def suche_mspm_kette(data: bytes) -> tuple[int, int] | None:
    """Rückfall ohne Symboltabelle: längste lückenlose MSPM-Kette in der Datei."""
    best = None
    i = data.find(b"MSPM")
    while i >= 0:
        o, n = i, 0
        while data[o:o + 4] == b"MSPM" and o + 12 <= len(data):
            raw = struct.unpack(">I", data[o + 8:o + 12])[0]
            ln = raw >> 8
            if ln % 4 or ln == 0 or o + 12 + ln > len(data):
                break
            o += 12 + ln
            n += 1
        if n >= 2 and (best is None or (o - i) > (best[1] - best[0])):
            best = (i, o)
        i = data.find(b"MSPM", i + 1)
    return best


