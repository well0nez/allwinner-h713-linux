def lies_ini(text: str) -> dict[str, list[tuple[str, str]]]:
    """Wie h713_pq/quellen.py: Vendor-INI mit doppelten Schlüsseln und ',\\'-Fortsetzungen."""
    sekt: dict[str, list[tuple[str, str]]] = {}
    akt: list[tuple[str, str]] = []
    for z in text.splitlines():
        z = z.strip()
        if not z or z[0] in "#;":
            continue
        if z.startswith("[") and z.endswith("]"):
            akt = sekt.setdefault(z[1:-1].strip(), [])
            continue
        if "=" in z:
            k, v = z.split("=", 1)
            akt.append((k.strip(), v.strip()))
    return sekt


def zahlen(v: str) -> list[int]:
    return [int(t) for t in v.rstrip("\\").split(",") if t.strip() != ""]


def pruefe_pq(name: str, data: bytes, tmp: Path) -> list[str]:
    """Leere Liste = ok. Sonst Befunde („hier drohen Probleme")."""
    p = []
    try:
        if name.endswith(".ini") or name.endswith(".cfg"):
            text = data.decode("utf-8", "replace")
        if name == "pq_picturemode.ini":
            s = lies_ini(text)
            cfg = dict(s.get("CONFIG", []))
            if "picture_mode" not in cfg:
                p.append("[CONFIG] picture_mode fehlt")
            modi = [m.strip() for m in cfg.get("picture_mode", "").split(",") if m.strip()]
            for eingang in ("HDMI1", "HDMI2", "HDMI3"):
                if eingang not in s:
                    p.append(f"Sektion [{eingang}] fehlt")
                    continue
                d = dict(s[eingang])
                for m in modi:
                    if m not in d:
                        p.append(f"[{eingang}] Modus {m} fehlt")
                    elif len(zahlen(d[m])) != 13:
                        p.append(f"[{eingang}] {m}: {len(zahlen(d[m]))} statt 13 Werte")
        elif name == "pq_factory_extern.ini":
            s = lies_ini(text)
            if "PQ_ENABLE" not in s:
                p.append("[PQ_ENABLE] fehlt")
            if "PICTURE_CURVE_HDMI" not in s:
                p.append("[PICTURE_CURVE_HDMI] fehlt")
            else:
                d = dict(s["PICTURE_CURVE_HDMI"])
                for i in range(1, 6):
                    k = f"PICTURE_CURVE_SETTINGS[{i}]"
                    if k not in d:
                        p.append(f"[PICTURE_CURVE_HDMI] {k} fehlt")
                    elif len(zahlen(d[k])) != 5:
                        p.append(f"[PICTURE_CURVE_HDMI] {k}: {len(zahlen(d[k]))} statt 5 Stützstellen")
        elif name == "pq_colortemp.ini":
            s = lies_ini(text)
            if "COLOR_TEMP_HDMI" not in s:
                p.append("[COLOR_TEMP_HDMI] fehlt")
            else:
                d = dict(s["COLOR_TEMP_HDMI"])
                for k in ("STANDARD", "COOL", "WARM", "USER"):
                    if k not in d:
                        p.append(f"[COLOR_TEMP_HDMI] {k} fehlt")
                    elif len(zahlen(d[k])) != 6:
                        p.append(f"[COLOR_TEMP_HDMI] {k}: {len(zahlen(d[k]))} statt 6 Werte")
        elif name == "pq_overscan_config.ini":
            s = lies_ini(text)
            if "HDMIOverscanSetting" not in s:
                p.append("[HDMIOverscanSetting] fehlt")
        elif name.endswith(".xml"):
            root = ET.fromstring(data)
            if name == "pqcontrol_config_setting.xml":
                items = [it for it in root.iter("item") if it.get("name") == "gamma"]
                if not items:
                    p.append("<transform><item name=\"gamma\"> fehlt")
                elif not all(items[0].get(f"level{i}") for i in range(5)):
                    p.append("gamma level0..level4 unvollständig")
        elif name == "tvpq.db":
            if data[:16] != b"SQLite format 3\0":
                p.append("kein SQLite-Kopf")
            else:
                dbp = tmp / "pruef-tvpq.db"
                dbp.write_bytes(data)
                try:
                    c = sqlite3.connect(f"file:{dbp}?mode=ro", uri=True)
                    tabellen = {r[0] for r in c.execute("select name from sqlite_master where type='table'")}
                    for t in ("Picture_Mode", "White_Balance_Mode", "Gamma_Point"):
                        if t not in tabellen:
                            p.append(f"Tabelle {t} fehlt")
                        else:
                            n = c.execute(f"select count(*) from {t}").fetchone()[0]
                            if n == 0:
                                p.append(f"Tabelle {t} leer")
                    c.close()
                finally:
                    dbp.unlink(missing_ok=True)
        elif name == "portmap.cfg":
            zeilen = [z.split() for z in text.splitlines() if z.strip() and not z.strip().startswith("#")]
            if not zeilen or any(len(z) < 3 for z in zeilen):
                p.append("keine dreispaltigen Port-Zeilen")
            elif not any(z[2].startswith("HDMI") for z in zeilen):
                p.append("kein HDMI-Port")
    except Exception as e:  # noqa: BLE001 — jede Unlesbarkeit ist ein Befund, kein Abbruch
        p.append(f"nicht lesbar: {e}")
    return p


