def tse_kopf(data: bytes) -> dict:
    """Der 16-B-TSE-Kopf: Magic 'TSE' und bei Offset 14 die Projekt-ID als u16 little-endian (Plan 108 §4.5)."""
    if len(data) < 16:
        return {"magic_ok": False, "id": None, "kopf": data.hex()}
    return {"magic_ok": data[:3] == TSE_MAGIC,
            "id": struct.unpack_from("<H", data, TSE_ID_OFFSET)[0],
            "kopf": data[:16].hex()}


def pruefe_tse(name: str, data: bytes) -> tuple[list[str], int | None]:
    """Befunde und die im Kopf stehende ID. Bei ProjectID_0x*.TSE muss der Dateiname zum ID-Feld passen."""
    befunde: list[str] = []
    k = tse_kopf(data)
    if not k["magic_ok"]:
        befunde.append(f"{name}: TSE-Magic fehlt (Kopf {k['kopf']})")
        return befunde, None
    m = MIPS_PROJECTID.match(name)
    if m:
        aus_name = int(m.group(1), 16)
        if k["id"] != aus_name:
            befunde.append(f"{name}: Kopf sagt ID {k['id']:#06x}, der Dateiname sagt {aus_name:#06x} — passt nicht zusammen")
        else:
            befunde.append(f"{name}: TSE-Kopf {k['kopf']}, ID {k['id']:#06x} = Dateiname")
    else:
        befunde.append(f"{name}: TSE-Kopf {k['kopf']}, ID-Feld {k['id']:#06x}")
    return befunde, k["id"]


def fw_rev_zu(data: bytes) -> dict | None:
    """display.bin über ihre sha256 in h713_mips_fw_revs[] wiederfinden — bestimmt die *benutzte* Projekt-ID."""
    h = sha256_bytes(data)
    for r in H713_MIPS_FW_REVS:
        if r["sha256"] == h:
            return r
    return None


def pruefe_display_cfg(data: bytes) -> list[str]:
    """display_cfg.xml parsen. Die Stock-Datei endet auf ein Null-Byte hinter </root> — das ist kein Fehler,
    U-Boot reicht die Datei ohnehin unverändert an die MIPS-Firmware weiter; es wird nur gemeldet."""
    hinweise = []
    roh = data
    if roh.rstrip(b"\r\n\t \0") != roh.rstrip():
        hinweise.append("display_cfg.xml: endet auf Null-Byte(s) hinter </root> (Stock-Eigenart, unverändert kopiert)")
    text = roh.rstrip(b"\r\n\t \0").decode("utf-8", "replace")
    try:
        wurzel = ET.fromstring(text)
    except ET.ParseError as e:
        return hinweise + [f"display_cfg.xml: nicht parsebar ({e})"]
    kinder = [k.tag for k in wurzel]
    return hinweise + [f"display_cfg.xml: wohlgeformt, Wurzel <{wurzel.tag}>, {len(kinder)} Kinder"
                       + (": " + ", ".join(sorted(set(kinder))[:8]) if kinder else "")]


def panel_config_id(text: str) -> int | None:
    """ProjectID aus panel_config.ini — dezimal in der Datei ('ProjectID = 48' = 0x30)."""
    for _sekt, paare in lies_ini(text).items():
        for k, v in paare:
            if k.strip().lower() == "projectid":
                try:
                    return int(v.split(";")[0].strip(), 0)
                except ValueError:
                    return None
    return None


class Lauf:
    def __init__(self, args, log: Log):
        self.args = args
        self.log = log
        self.out = Path(args.out)
        self.tmp = Path(args.tmp) if args.tmp else self.out / "tmp"
        self.artefakte: list[dict] = []
        self.beobachtungen: dict[str, object] = {}
        self.eingang: dict[str, object] = {}
        self.geraet: str | None = None        # Profilschlüssel: hy310 / l018 / None (unbekannt)
        self.geraet_fix = False               # True: über den Image-Fingerabdruck (sha256) erkannt, nicht mehr revidierbar
        self.erkennung: dict[str, object] = {"ueber": None, "merkmale": [], "hinweise": []}
        self.merkmale: dict[str, object] = {}  # was der Eingang über sich verrät (Hashes, Kennungen, Größen)
        self.referenzgeraet: str | None = None  # gegen welches Profil verglichen wurde (unbekannt: das ähnlichste)
        self.altes_geraet: str | None = None  # Gerät eines schon in <out> liegenden Manifests
        self.out_gesperrt = False             # True: <out> gehört einem anderen Gerät — nichts hineinschreiben
        self.offen: list[str] = []            # was nicht extrahiert werden konnte
        self.abweichungen: list[str] = []     # Unterschiede zum Stock des Referenzgeräts (unbekannt: „hier drohen Probleme")
        self.package: SunxiPackage | None = None
        self.packages: list[SunxiPackage] = []
        self.super_q: Quelle | None = None
        self.vendor_q: Quelle | None = None
        self.vendor: Ext4Basis | None = None
        self.quellen_offen: list[DateiQuelle] = []
        self.mips_quellen: list[tuple[str, Quelle]] = []   # FAT16-Abbilder mit mips/ (bootloader_b/_a, boot-resource.fex)
        self.mips: dict[str, object] = {}                  # Befunde fürs Manifest (Projekt-IDs, Quellen, Nichtextrahiertes)

    # ---- Eingänge -------------------------------------------------------------------------------

    def oeffne(self, pfad: str) -> DateiQuelle:
        p = Path(pfad)
        if not p.is_file():
            raise Abbruch(f"Eingang nicht gefunden: {pfad}")
        q = DateiQuelle(p)
        self.quellen_offen.append(q)
        return q

    def fingerabdruck(self, q: DateiQuelle, rolle: str):
        self.log.kopf(f"Fingerabdruck {rolle}: {q.pfad} ({q.size} B)")
        if self.args.no_hash:
            self.log.info("sha256 übersprungen (--no-hash) — Gerät wird nur inhaltlich erkannt")
            h = None
        else:
            h = sha256_datei(q.pfad, self.log)
            self.log.info(f"sha256 {h}")
        self.eingang.update({"pfad": str(q.pfad), "groesse": q.size, "sha256": h, "rolle": rolle})
        bekannt = BEKANNTE_IMAGES.get(h) if h else None
        if bekannt:
            self.eingang["bekannt_als"] = bekannt[1]
            self.log.info(f"BEKANNT: {bekannt[1]}")
            self.setze_geraet(bekannt[0], "sha256", fix=True)
        else:
            self.eingang["bekannt_als"] = None
            self.log.info("Image-Fingerabdruck unbekannt — Gerät wird inhaltlich bestimmt (Paket-Hashes, U-Boot/ARISC-Kennung, "
                          "Vendor-Fingerprint); passt kein Profil, bleibt das Image unbekannt (Best-Effort, Exit 1)")

    def eingang_imagewty(self, q: DateiQuelle):
        self.eingang["typ"] = "IMAGEWTY"
        self.log.kopf("IMAGEWTY-Container")
        img = Imagewty(q, self.log)
        self.eingang["imagewty"] = {"header_version": img.header_version, "num_files": img.num_files,
                                    "dateien": {n: {"maintype": e["maintype"], "subtype": e["subtype"], "offset": e["offset"],
                                                    "original": e["original"], "stored": e["stored"]}
                                                for n, e in img.eintraege.items()}}
        bp = img.datei("boot_package.fex")
        if bp is None:
            self.log.warn("boot_package.fex fehlt im Image — kein scp.bin aus diesem Eingang")
        else:
            self.paket_aus_quelle(bp, "boot_package.fex im Image")
        # toc1.fex ist in beiden Images nur ein 8-Byte-Platzhalter
        t1 = img.datei("toc1.fex")
        if t1 is not None:
            self.log.info(f"toc1.fex: {t1.size} B ({'Platzhalter' if t1.size < 1024 else 'echtes TOC1?'})")
        br = img.datei(MIPS_FEX)
        if br is None:
            self.log.warn(f"{MIPS_FEX} fehlt im Image — keine MIPS-/Display-Artefakte aus diesem Eingang")
        else:
            # boot-resource.fex ist genau das, was der Flasher nach bootloader_a und bootloader_b schreibt
            # (sys_partition.fex: downloadfile="boot-resource.fex" für beide).
            self.mips_quelle(br, f"{MIPS_FEX} im Image (= bootloader_a und bootloader_b)")
        sup = img.datei("super.fex")
        if sup is None:
            self.log.warn("super.fex fehlt im Image — kein EDID/MSP/PQ aus diesem Eingang")
        else:
            self.super_aus_quelle(sup)
        # Nebenbefunde für den Bericht
        for n in ("sys_partition.fex", "sunxi_version.fex"):
            d = img.datei(n)
            if d is not None and d.size < 65536:
                self.beobachtungen[n] = d.read(0, d.size).decode("utf-8", "replace")
        sv = (self.beobachtungen.get("sunxi_version.fex") or "").strip()
        if sv:
            self.merkmale["sunxi_version"] = sv
            self.log.info(f"sunxi_version.fex: {sv}")
            self.erkenne_geraet("sunxi_version.fex")

    def eingang_emmc(self, q: DateiQuelle):
        self.eingang["typ"] = "eMMC-Dump"
        self.log.kopf("Roher eMMC-Dump")
        gpt = Gpt(q, self.log)
        self.eingang["gpt"] = {n: {"start_lba": s, "sektoren": c} for n, (s, c) in gpt.parts.items()}
        for lba in (16, 256):
            b = q.read(lba * SEKTOR, 32)
            if b[4:12] == b"eGON.BT0":
                self.log.info(f"LBA {lba}: eGON.BT0 (boot0/SPL) — Länge {struct.unpack_from('<I', b, 16)[0]} B")
            else:
                self.log.info(f"LBA {lba}: kein eGON.BT0 ({hexdump_kurz(b, 12)})")
        # TOC1 an den bekannten LBAs und per Suche
        kandidaten = []
        for lba in (24576, 32800):
            off = lba * SEKTOR
            if off + 0x40 <= q.size and q.read(off, 13) == SunxiPackage.NAME:
                kandidaten.append((off, f"LBA {lba}"))
        self.log.info("Suche nach weiteren 'sunxi-package'-Köpfen im Dump …")
        for off in suche_sunxi_packages(q, self.log):
            if all(off != k[0] for k in kandidaten):
                kandidaten.append((off, f"Suche @{off:#x} (LBA {off // SEKTOR})"))
        if not kandidaten:
            self.log.warn("kein sunxi-package im Dump — kein scp.bin aus diesem Eingang")
        for off, wo in kandidaten:
            try:
                self.paket_aus_quelle(q, f"Dump {wo}", off)
            except Abbruch as e:
                self.log.warn(str(e))
        for n in MIPS_PART_NAMEN:
            p = gpt.partition(q, n)
            if p is None:
                s = gpt.parts.get(n)
                self.log.warn(f"{n} liegt {'bei LBA %d+%d, ' % s if s else ''}nicht (vollständig) im Dump")
                continue
            if Fat.ist_fat(p):
                self.mips_quelle(p, f"Dump: Partition {n} (LBA {gpt.parts[n][0]}, {gpt.parts[n][1]} Sektoren)")
            else:
                self.log.warn(f"{n}: kein FAT-Bootsektor ({hexdump_kurz(p.read(0, 8))}) — MIPS-Dateien nicht lesbar")
        if "private" in gpt.parts:
            s0, c0 = gpt.parts["private"]
            self.log.info(f"private@{s0}+{c0}: Secure Storage (HDCP-Keys laut doku/68) — wird nicht gelesen")
            self.beobachtungen["hdcp_hinweise_gpt"] = [f"private@{s0}+{c0} (Secure Storage, nicht gelesen)"]
        sup = gpt.partition(q, "super")
        if sup is None:
            s = gpt.parts.get("super")
            self.log.warn(f"'super' liegt {'bei LBA %d+%d, ' % s if s else ''}nicht (vollständig) im Dump — "
                          f"kein EDID/MSP/PQ aus diesem Eingang")
            self.offen.append("super nicht im Dump (EDID, MSP-Patch, PQ)")
        else:
            self.super_aus_quelle(sup)

    def eingang_teile(self):
        self.eingang["typ"] = "Einzelteile"
        self.log.kopf("Einzelne Partitions-/.fex-Dateien")
        teile = dict(self.args.part or [])
        if self.args.fex_dir:
            d = Path(self.args.fex_dir)
            for n, k in (("boot_package.fex", "boot_package"), ("super.fex", "super"), (MIPS_FEX, "boot-resource")):
                if (d / n).is_file():
                    teile.setdefault(k, str(d / n))
                else:
                    self.log.warn(f"{d / n} fehlt")
        if not teile:
            raise Abbruch("keine Eingänge (--part … / --fex-dir …)")
        self.eingang["teile"] = {}
        for k, v in teile.items():
            pv = Path(v)
            if not pv.is_file():
                raise Abbruch(f"--part {k}: Datei fehlt: {v}")
            h = None if self.args.no_hash else sha256_datei(pv)
            self.eingang["teile"][k] = {"pfad": str(pv), "groesse": pv.stat().st_size, "sha256": h}
            self.log.info(f"{k}: {pv} ({pv.stat().st_size} B) sha256 {h}")
        for k in ("boot_package", "bootloader_a", "bootloader_b", "bootloader", "boot-resource", "boot_resource",
                  "mips", "toc1"):
            if k not in teile:
                continue
            q = self.oeffne(teile[k])
            self.log.info(f"{k}: {q.pfad} ({q.size} B)")
            if k in MIPS_TEIL_SCHLUESSEL and Fat.ist_fat(q):
                # bootloader_a/_b und boot-resource.fex sind FAT16 mit mips/ — kein sunxi-package darin
                self.mips_quelle(q, f"{k} ({q.pfad.name})")
                continue
            offs = [0] if q.read(0, 13) == SunxiPackage.NAME else suche_sunxi_packages(q, self.log)
            if not offs:
                self.log.warn(f"{k}: kein sunxi-package gefunden")
            for off in offs:
                try:
                    self.paket_aus_quelle(q, f"{k} ({q.pfad.name}) @{off:#x}", off)
                except Abbruch as e:
                    self.log.warn(str(e))
        if "super" in teile:
            q = self.oeffne(teile["super"])
            self.log.info(f"super: {q.pfad} ({q.size} B)")
            self.super_aus_quelle(q)
        elif "vendor" in teile:
            q = self.oeffne(teile["vendor"])
            self.log.info(f"vendor: {q.pfad} ({q.size} B)")
            vq: Quelle = SparseQuelle(q, self.log) if SparseQuelle.ist_sparse(q) else q
            self.vendor_q = vq
        if "emmc" in teile:
            q = self.oeffne(teile["emmc"])
            if not Gpt.ist_gpt(q):
                raise Abbruch("emmc: keine GPT bei LBA 1")
            self.eingang_emmc(q)

    # ---- sunxi-package / scp --------------------------------------------------------------------

    def paket_aus_quelle(self, q: Quelle, herkunft: str, off: int = 0):
        if q.read(off, 13) != SunxiPackage.NAME:
            # boot_package.fex kann auch ein Container mit Kopf sein — suchen
            offs = suche_sunxi_packages(q, self.log, max_bytes=min(q.size, 64 << 20))
            if not offs:
                raise Abbruch(f"{herkunft}: kein sunxi-package")
            off = offs[0]
        pk = SunxiPackage(q, off, self.log, herkunft)
        self.packages.append(pk)
        if self.package is None:
            self.package = pk
            hashes = {}
            for n, (o, l) in pk.items.items():
                hashes[n] = {"offset": o, "len": l, "sha256": sha256_bytes(q.read(off + o, l))}
            self.eingang["sunxi_package"] = {"herkunft": herkunft, "offset": off, "items": hashes, "valid_len": pk.valid_len,
                                             "pruefsumme_ok": pk.summe_ok, "probleme": pk.probleme}
            # Merkmale für Erkennung und Abgleich
            self.merkmale["paket_items"] = {n: l for n, (o, l) in pk.items.items()}
            self.merkmale["paket_item_sha256"] = {n: h["sha256"] for n, h in hashes.items()}
            for item, key in (("scp", "scp_sha256"), ("u-boot", "uboot_sha256"), ("dtb", "dtb_sha256")):
                if item in hashes:
                    self.merkmale[key] = hashes[item]["sha256"]
            ub = pk.item("u-boot")
            if ub:
                k = uboot_kennung(ub)
                if k:
                    self.merkmale["uboot_version"] = k
                    self.log.info(f"U-Boot-Kennung: {k}")
            dtb = pk.item("dtb")
            if dtb:
                w = fdt_wurzel(dtb)
                if w:
                    self.merkmale["dtb_compatible"] = w.get("compatible", "")
                    self.merkmale["dtb_model"] = w.get("model", "")
                    self.log.info(f"dtb-Wurzel: model '{w.get('model', '')}', compatible '{w.get('compatible', '')}'")
            self.erkenne_geraet(herkunft)

    def extrahiere_scp(self):
        self.log.kopf("h713-arisc.bin (= scp aus dem sunxi-package)")
        if not self.packages:
            self.log.warn("kein sunxi-package — h713-arisc.bin nicht extrahiert")
            self.offen.append("h713-arisc.bin (kein sunxi-package im Eingang)")
            return
        gesehen: dict[str, list[str]] = {}
        erster = None
        for pk in self.packages:
            scp = pk.item("scp")
            if scp is None:
                self.log.warn(f"{pk.herkunft}: kein 'scp'-Item (Items: {', '.join(pk.items)})")
                continue
            gesehen.setdefault(sha256_bytes(scp), []).append(pk.herkunft)
            if erster is None:
                erster = (pk, scp)
        if erster is None:
            self.offen.append("h713-arisc.bin (kein scp-Item)")
            return
        if len(gesehen) > 1:
            self.log.warn("die gefundenen scp-Blobs unterscheiden sich: " +
                          "; ".join(f"{h[:12]}… aus {', '.join(w)}" for h, w in gesehen.items()))
        else:
            h, wo = next(iter(gesehen.items()))
            self.log.info(f"scp identisch in: {', '.join(wo)}")
        pk, scp = erster
        befunde = pruefe_scp(scp, self.log)
        for b in befunde:
            self.log.info("Struktur: " + b)
            if b.startswith("Versionsstring: '"):
                self.merkmale["arisc_version"] = b[len("Versionsstring: '"):].rstrip("'")
        if "arisc_version" in self.merkmale:
            self.erkenne_geraet("ARISC-Versionsstring")
        pruef = ["sunxi-package Prüfsumme " + ("ok" if pk.summe_ok else "FALSCH")] + [
            "Item-Tabelle ok" if not pk.probleme else "Paketprobleme: " + "; ".join(pk.probleme)] + befunde
        fehler = (not pk.summe_ok) or bool(pk.probleme) or any("kein l.j" in b or "nicht 'CPUs'" in b or "leer" in b for b in befunde)
        self.ablegen("lib/firmware/h713-arisc.bin", scp,
                     herkunft=f"{pk.herkunft}: Item 'scp' @{pk.off + pk.items['scp'][0]:#x}, {len(scp)} B "
                              f"(Paket: {', '.join(f'{n}={l}' for n, (o, l) in pk.items.items())})",
                     pruefung=pruef, fehler=fehler)

    # ---- super / vendor -------------------------------------------------------------------------

    def super_aus_quelle(self, q: Quelle):
        self.log.kopf("super → LP-Metadaten → vendor")
        if SparseQuelle.ist_sparse(q):
            sq = SparseQuelle(q, self.log)
            self.log.info(sq.beschreibung)
            self.eingang["super_sparse"] = sq.beschreibung
            q = sq
        else:
            self.log.info(f"{q.name}: kein Sparse-Kopf, wird als rohes Abbild gelesen")
        self.super_q = q
        lp = LpSuper(q, self.log)
        self.eingang["lp"] = {"version": lp.version, "lage": lp.lage,
                              "partitionen": {n: {"size": p["size"], "gruppe": p["gruppe"],
                                                  "extents": [list(e) for e in p["extents"]]} for n, p in lp.parts.items()}}
        for n in ("vendor_a", "vendor"):
            vq = lp.partition(n, self.log)
            if vq is not None:
                self.log.info(f"vendor-Partition: {n} ({vq.size} B)")
                self.eingang["vendor_partition"] = n
                self.vendor_q = vq
                self.merkmale["vendor_size"] = vq.size
                self.erkenne_geraet("LP-Partition " + n)
                return
        self.log.warn("keine Partition vendor_a/vendor in den LP-Metadaten: " + ", ".join(lp.parts))
        self.offen.append("vendor-Partition nicht gefunden (EDID, MSP-Patch, PQ)")

    def oeffne_vendor(self) -> bool:
        if self.vendor is not None:
            return True
        if self.vendor_q is None:
            return False
        self.log.kopf("vendor-Dateisystem")
        self.tmp.mkdir(parents=True, exist_ok=True)
        leser = Ext4Debugfs if getattr(self.args, "use_debugfs", False) else Ext4
        self.vendor = leser(self.vendor_q, self.tmp, "vendor", self.log)
        self.eingang["vendor_fs"] = self.vendor.beschreibung
        # Kennung der Vendor-Firmware (build.prop) — hilft bei unbekannten Images
        if self.vendor.existiert("/build.prop"):
            props = {}
            for z in self.vendor.lies("/build.prop", self.tmp).decode("utf-8", "replace").splitlines():
                if "=" in z and not z.startswith("#"):
                    k, v = z.split("=", 1)
                    if k in ("ro.vendor.build.fingerprint", "ro.vendor.build.date", "ro.product.vendor.model",
                             "ro.product.vendor.name", "ro.product.vendor.brand"):
                        props[k] = v.strip()
            self.eingang["vendor_build"] = props
            for k, v in props.items():
                self.log.info(f"build.prop {k} = {v}")
            fp = props.get("ro.vendor.build.fingerprint", "")
            if fp:
                self.merkmale["build_fingerprint"] = fp
                self.erkenne_geraet("vendor build.prop")
        return True

    def extrahiere_edid(self):
        self.log.kopf("hy310-edid.bin (= HDMI_EDID_14.bin + HDMI_EDID_20.bin)")
        if not self.oeffne_vendor():
            self.log.warn("keine vendor-Partition — hy310-edid.bin nicht extrahiert")
            self.offen.append("hy310-edid.bin (keine vendor-Partition)")
            return
        teile, pruef, fehler = [], [], False
        for pf in (EDID_14, EDID_20):
            e = self.vendor.existiert(pf)
            if not e:
                self.log.warn(f"{pf} fehlt in vendor")
                fehler = True
                continue
            b = self.vendor.lies(pf, self.tmp)
            probleme = pruefe_edid_block(b, Path(pf).name)
            if len(b) == 256:
                pruef.append(f"{Path(pf).name}: {len(b)} B, Hersteller {edid_hersteller(b)}, Name '{edid_name(b)}', "
                             f"Byte 168 {b[168]:#04x}" + (", Blockprüfsummen 0" if not probleme else ""))
            for p in probleme:
                self.log.warn(p)
                pruef.append(p)
            fehler = fehler or bool(probleme)
            teile.append(b)
        if len(teile) != 2:
            self.offen.append("hy310-edid.bin (EDID-Dateien fehlen)")
            return
        edid = teile[0] + teile[1]
        if len(edid) != 512:
            pruef.append(f"Gesamtlänge {len(edid)} statt 512")
            fehler = True
        self.ablegen("lib/firmware/hy310-edid.bin", edid,
                     herkunft=f"vendor:{EDID_14} ({len(teile[0])} B) + vendor:{EDID_20} ({len(teile[1])} B), unverändert aneinandergehängt",
                     pruefung=pruef, fehler=fehler)

    def extrahiere_msp(self):
        self.log.kopf("h713/msp-patch.bin (= Symbol patch_msp aus libmspsound.so)")
        if not self.oeffne_vendor():
            self.log.warn("keine vendor-Partition — msp-patch.bin nicht extrahiert")
            self.offen.append("msp-patch.bin (keine vendor-Partition)")
            return
        lib = None
        for k in MSP_LIB_KANDIDATEN:
            if self.vendor.existiert(k):
                lib = k
                break
        if lib is None:
            for pf, e in self.vendor.gehe("/lib", 2):
                if e["name"] == "libmspsound.so":
                    lib = pf
                    break
        if lib is None:
            self.log.warn("libmspsound.so nicht in vendor gefunden — msp-patch.bin nicht extrahiert")
            self.offen.append("msp-patch.bin (libmspsound.so fehlt)")
            return
        data = self.vendor.lies(lib, self.tmp)
        self.log.info(f"{lib}: {len(data)} B, sha256 {sha256_bytes(data)}")
        pruef = [f"libmspsound.so sha256 {sha256_bytes(data)}"]
        self.merkmale["libmspsound_sha256"] = sha256_bytes(data)
        sym = elf_symbol(data, "patch_msp")
        if sym is None:
            self.log.warn("Symbol patch_msp nicht in der Symboltabelle — Rückfall auf MSPM-Kettensuche")
            kette = suche_mspm_kette(data)
            if kette is None:
                self.offen.append("msp-patch.bin (weder Symbol noch MSPM-Kette)")
                return
            off, size = kette[0], kette[1] - kette[0]
            pruef.append(f"Herkunft per MSPM-Suche @{off:#x}, {size} B (kein Symbol!)")
            fehler = True
        else:
            off, size, sect = sym
            pruef.append(f"Symbol patch_msp: Dateioffset {off:#x}, st_size {size}, Sektion {sect}")
            fehler = False
        blob = data[off:off + size]
        bloecke, probleme = parse_mspm(blob)
        paare = sum(b["paare"] for b in bloecke)
        pruef.append(f"MSPM: {len(bloecke)} Blöcke, {paare} Paare, Ziele " +
                     "/".join(f"{b['ziel']}:{b['laenge']}" for b in bloecke))
        for p in probleme:
            self.log.warn("MSPM: " + p)
            pruef.append("MSPM: " + p)
        if len(blob) % 4:
            pruef.append(f"Länge {len(blob)} nicht durch 4 teilbar (Treiber verlangt das)")
        fehler = fehler or bool(probleme) or (len(blob) % 4 != 0)
        self.ablegen("lib/firmware/h713/msp-patch.bin", blob,
                     herkunft=f"vendor:{lib}, Symbol patch_msp (Dateioffset {off:#x}, {size} B)",
                     pruefung=pruef, fehler=fehler)

    def extrahiere_pq(self):
        self.log.kopf("PQ-Quellen (die Dateien, die h713-pq liest)")
        if not self.oeffne_vendor():
            self.log.warn("keine vendor-Partition — PQ nicht extrahiert")
            self.offen.append("PQ-Dateien (keine vendor-Partition)")
            return
        vorhanden = {e["name"]: e for e in self.vendor.ls(TVCONFIG)}
        self.beobachtungen["tvconfig_inhalt"] = sorted(f"{n} ({e['size']} B)" for n, e in vorhanden.items())
        for n in PQ_DATEIEN:
            if n not in vorhanden:
                self.log.warn(f"{TVCONFIG}/{n} fehlt")
                self.offen.append(f"pq/{n} (fehlt in vendor)")
                continue
            b = self.vendor.lies(f"{TVCONFIG}/{n}", self.tmp)
            probleme = pruefe_pq(n, b, self.tmp)
            for p in probleme:
                self.log.warn(f"{n}: {p}")
            self.ablegen(f"pq/{n}", b, herkunft=f"vendor:{TVCONFIG}/{n}",
                         pruefung=(["Pflichtschlüssel ok"] if not probleme else probleme), fehler=bool(probleme))

    def extrahiere_wlan(self):
        """Die AIC8800D80-Firmware aus vendor:/etc/firmware/aic8800d80/ uebernehmen.

        Unveraendert kopiert, Datei fuer Datei -- es wird nichts zusammengesetzt und nichts
        umbenannt. Fehlt das Verzeichnis, ist das KEIN Fehler: nicht jedes H713-Geraet hat
        diesen Funkchip. Referenzwerte gibt es bisher nur fuer das hy310-Profil; auf einem
        Geraet ohne Referenz laufen die Dateien als "nicht referenziert" durch, ohne den
        Exit-Code zu kippen (bewerte() ueberspringt Artefakte ohne Referenzeintrag).
        """
        self.log.kopf(f"WLAN-Firmware (= vendor:{AIC_FW_VERZ}/)")
        if not self.oeffne_vendor():
            self.log.warn("keine vendor-Partition — WLAN-Firmware nicht extrahiert")
            self.offen.append("WLAN-Firmware (keine vendor-Partition)")
            return
        if not self.vendor.existiert(AIC_FW_VERZ):
            self.log.info(f"{AIC_FW_VERZ} nicht vorhanden — dieses Geraet hat keine AIC8800-Firmware")
            self.beobachtungen["aic8800_firmware"] = "nicht vorhanden"
            return
        dateien = [e for e in self.vendor.ls(AIC_FW_VERZ) if e.get("typ") != "d"]
        if not dateien:
            self.log.warn(f"{AIC_FW_VERZ} ist leer")
            self.offen.append("WLAN-Firmware (Verzeichnis leer)")
            self.beobachtungen["aic8800_firmware"] = "Verzeichnis leer"
            return
        self.beobachtungen["aic8800_firmware"] = sorted(
            f"{e['name']} ({e['size']} B)" for e in dateien)
        for e in sorted(dateien, key=lambda x: x["name"]):
            b = self.vendor.lies(f"{AIC_FW_VERZ}/{e['name']}", self.tmp)
            probleme = []
            if len(b) != e["size"]:
                probleme.append(f"gelesen {len(b)} B, Verzeichniseintrag sagt {e['size']} B")
            if not b:
                probleme.append("leere Datei")
            self.ablegen(f"{AIC_FW_ZIEL}/{e['name']}", b,
                         herkunft=f"vendor:{AIC_FW_VERZ}/{e['name']}, unveraendert uebernommen",
                         pruefung=probleme or ["unveraendert uebernommen"],
                         fehler=bool(probleme))

    # ---- MIPS-/Display-Artefakte (Plan 108 §1/§4.2/§4.5) ----------------------------------------

    def mips_quelle(self, q: Quelle, herkunft: str):
        self.mips_quellen.append((herkunft, q))
        self.log.info(f"MIPS-Quelle gemerkt: {herkunft} ({q.size} B)")

    def _mips_lesen(self, herkunft: str, q: Quelle) -> dict | None:
        """Ein FAT-Abbild öffnen und daraus genau die Dateien holen, die unsere Kette nutzt."""
        try:
            fs = Fat(q, self.log, herkunft)
        except Abbruch as e:
            self.log.warn(str(e))
            return None
        eintraege = fs.verzeichnis(MIPS_QUELLVERZ)
        if eintraege is None:
            self.log.warn(f"{herkunft}: kein Verzeichnis '{MIPS_QUELLVERZ}/' im {fs.typ} "
                          f"(Wurzel: {', '.join(sorted(e['name'] for e in fs.eintraege(0))) or 'leer'})")
            return None
        dateien: dict[str, bytes] = {}
        probleme: list[str] = list(fs.probleme)
        uebrig: list[str] = []
        kurznamen: dict[str, str] = {}
        for e in sorted(eintraege, key=lambda x: x["name"]):
            if e["verzeichnis"]:
                uebrig.append(f"{MIPS_QUELLVERZ}/{e['name']}/ (Verzeichnis)")
                continue
            gewollt = e["name"] in MIPS_DATEIEN or bool(MIPS_PROJECTID.match(e["name"]))
            if not gewollt:
                uebrig.append(f"{MIPS_QUELLVERZ}/{e['name']} ({e['groesse']} B)")
                continue
            try:
                dateien[e["name"]] = fs.lies(e)
            except Abbruch as ex:
                probleme.append(str(ex))
                self.log.warn(str(ex))
                continue
            kurznamen[e["name"]] = e["kurz"]
            if not e["lang"]:
                probleme.append(f"{e['name']}: kein Langname im Verzeichnis — 8.3-Name genommen")
        # Was sonst noch in der Partition liegt (Plan 108 §1: BOOTLOGO, Fonts, BAT/, WAVEFILE/ — nicht unsere Kette)
        sonst = []
        for e in sorted(fs.eintraege(0), key=lambda x: x["name"]):
            if e["name"].lower() == MIPS_QUELLVERZ:
                continue
            sonst.append(f"{e['name']}{'/' if e['verzeichnis'] else ''} ({'Verzeichnis' if e['verzeichnis'] else str(e['groesse']) + ' B'})")
        return {"herkunft": herkunft, "fs": fs.beschreibung, "typ": fs.typ, "dateien": dateien,
                "kurznamen": kurznamen, "probleme": probleme, "uebrig": uebrig, "sonst": sonst}

    def deklarierte_projekt_id(self) -> dict:
        """panel_config.ini im Vendor-Dateisystem: wird gemeldet, aber nicht benutzt (Plan 108 §4.5 drittens)."""
        try:
            if self.vendor is None and not self.oeffne_vendor():
                return {"id": None, "quelle": None, "hinweis": "keine vendor-Partition im Eingang — nicht ermittelbar"}
        except Abbruch as e:
            return {"id": None, "quelle": None, "hinweis": f"vendor-Dateisystem nicht lesbar ({e})"}
        for pf in PANEL_CONFIG_KANDIDATEN:
            if not self.vendor.existiert(pf):
                continue
            text = self.vendor.lies(pf, self.tmp).decode("utf-8", "replace")
            pid = panel_config_id(text)
            return {"id": pid, "quelle": f"vendor:{pf}",
                    "hinweis": None if pid is not None else "ProjectID-Zeile nicht gefunden"}
        return {"id": None, "quelle": None,
                "hinweis": "panel_config.ini nicht in vendor gefunden (" + ", ".join(PANEL_CONFIG_KANDIDATEN) + ")"}

    def extrahiere_mips(self):
        self.log.kopf(f"{MIPS_AUSGABE}/… (MIPS-/Display-Artefakte aus bootloader_a/bootloader_b)")
        if not self.mips_quellen:
            self.log.warn("keine bootloader-Partition und keine boot-resource.fex im Eingang — "
                          f"{MIPS_AUSGABE}/* nicht extrahiert")
            self.offen.append(f"{MIPS_AUSGABE}/* (keine bootloader_a/_b bzw. boot-resource.fex im Eingang)")
            return
        gelesen = [r for r in (self._mips_lesen(h, q) for h, q in self.mips_quellen) if r]
        if not gelesen:
            self.offen.append(f"{MIPS_AUSGABE}/* (Quelle vorhanden, aber kein lesbares mips/ darin)")
            return
        haupt = gelesen[0]
        vergleich: list[str] = []
        for w in gelesen[1:]:
            a, b = haupt["dateien"], w["dateien"]
            unterschied = ([f"nur in {haupt['herkunft']}: {n}" for n in sorted(set(a) - set(b))] +
                           [f"nur in {w['herkunft']}: {n}" for n in sorted(set(b) - set(a))] +
                           [f"{n} unterschiedlich" for n in sorted(set(a) & set(b)) if a[n] != b[n]])
            if unterschied:
                vergleich.append(f"{w['herkunft']} weicht von {haupt['herkunft']} ab: " + "; ".join(unterschied))
                self.log.warn(vergleich[-1])
            else:
                vergleich.append(f"{w['herkunft']} ist inhaltlich gleich {haupt['herkunft']} ({len(b)} Dateien)")
                self.log.info(vergleich[-1])
        dateien = haupt["dateien"]
        # database.TSE ist die einzige MIPS-Datei, die HY310 und L018 unterscheidet (S42 §9) — damit lässt sich auch
        # eine reine bootloader-Partition einem Gerät zuordnen.
        if "database.TSE" in dateien:
            self.merkmale["mips_database_sha256"] = sha256_bytes(dateien["database.TSE"])
            self.erkenne_geraet("mips/database.TSE")
        self.log.info(f"Quelle: {haupt['herkunft']} — {haupt['fs']}")
        self.log.info(f"mips/: {len(dateien)} Dateien für unsere Kette, {len(haupt['uebrig'])} weitere darin")
        for n, k in sorted(haupt["kurznamen"].items()):
            if k.lower() != n.lower():
                self.log.info(f"  Langname '{n}' (8.3 wäre '{k}')")

        # ---- (b) die benutzte Projekt-ID: sha256 der display.bin über h713_mips_fw_revs[] ----------
        rev = None
        db = dateien.get("display.bin")
        display_pruef: list[str] = []
        display_fehler = False
        if db is None:
            self.log.warn("display.bin fehlt in mips/ — die benutzte Projekt-ID ist damit nicht bestimmbar")
        else:
            rev = fw_rev_zu(db)
            if rev:
                display_pruef.append(f"h713_mips_fw_revs[]: {rev['board']}, Projekt {rev['project_id']:#04x}, "
                                     f"Panel {rev['panel']}, Sollgröße {rev['size']} B")
                self.log.info(f"display.bin: bekannt — {rev['board']}, Projekt-ID {rev['project_id']:#04x}, Panel {rev['panel']}")
                if self.geraet and GERAETE[self.geraet]["name"].lower() not in rev["board"].lower():
                    # z. B. L018: dieselbe display.bin wie der HY310. Der Name in h713_mips_fw_revs[] sagt, *von welchem*
                    # Board die Revision gelesen wurde, nicht welches Gerät hier im Eingang liegt.
                    hinweis = (f"display.bin dieses {GERAETE[self.geraet]['name']} ist byteidentisch mit der Revision, die in "
                               f"h713_mips_fw_revs[] unter '{rev['board']}' steht — der Name dort bezeichnet die Herkunft der "
                               f"Revision, nicht das Gerät. Projekt-ID {rev['project_id']:#04x} gilt trotzdem.")
                    display_pruef.append(hinweis)
                    self.log.info(hinweis)
                if len(db) != rev["size"]:
                    display_pruef.append(f"Größe {len(db)} B statt {rev['size']} B (Revisionstabelle)")
                    self.log.warn(display_pruef[-1])
                    display_fehler = True
                else:
                    display_pruef.append(f"Größe {len(db)} B = Revisionstabelle")
            else:
                display_fehler = True
                display_pruef.append(f"sha256 {sha256_bytes(db)} steht NICHT in h713_mips_fw_revs[] — "
                                     f"Projekt-ID unbekannt")
                self.log.warn(f"display.bin ({len(db)} B, sha256 {sha256_bytes(db)}) ist keine der bekannten Revisionen "
                              f"({', '.join(r['board'] + ' ' + hex(r['project_id']) for r in H713_MIPS_FW_REVS)}) — "
                              f"die benutzte Projekt-ID lässt sich nicht bestimmen")
                self.log.warn("Ausweg: alle ProjectID-Dateien liegen in der Ausgabe; die richtige zur Laufzeit wählen "
                              "(setenv h713_project 0x…; saveenv), Plan 108 §4.5 drittens")

        # ---- (a) TSE-Köpfe prüfen, (c) Liste aller ProjectID-Dateien -------------------------------
        gefundene_ids: list[str] = []
        for n in sorted(dateien):
            m = MIPS_PROJECTID.match(n)
            if m:
                gefundene_ids.append(f"0x{int(m.group(1), 16):04x}")

        # ---- (c) die deklarierte ID: melden, nicht benutzen ---------------------------------------
        dekl = self.deklarierte_projekt_id()
        if dekl["id"] is not None:
            self.log.info(f"deklarierte Projekt-ID: {dekl['id']:#04x} ({dekl['id']} dezimal) aus {dekl['quelle']} — "
                          f"wird gemeldet, nicht benutzt (Plan 108 §4.5)")
        else:
            self.log.info(f"deklarierte Projekt-ID: {dekl['hinweis']}")
        benutzt = rev["project_id"] if rev else None
        if benutzt is not None and dekl["id"] is not None and benutzt != dekl["id"]:
            self.log.warn(f"benutzte Projekt-ID {benutzt:#04x} und deklarierte {dekl['id']:#04x} gehen auseinander — "
                          f"benutzt wird {benutzt:#04x} (aus display.bin), Plan 108 §3/§6")
        if benutzt is not None and f"0x{benutzt:04x}" not in gefundene_ids:
            self.log.warn(f"ProjectID_0x{benutzt:04x}.TSE fehlt in mips/, obwohl display.bin genau diese ID verlangt")

        self.mips = {
            "quelle": haupt["herkunft"],
            "dateisystem": haupt["fs"],
            "weitere_quellen": vergleich,
            "projekt_id_benutzt": f"{benutzt:#04x}" if benutzt is not None else None,
            "projekt_id_benutzt_woher": (f"sha256 der display.bin in h713_mips_fw_revs[] -> {rev['board']}, "
                                         f"Panel {rev['panel']}" if rev else
                                         "unbestimmbar: display.bin steht nicht in h713_mips_fw_revs[]"),
            "projekt_id_deklariert": f"{dekl['id']:#04x}" if dekl["id"] is not None else None,
            "projekt_id_deklariert_quelle": dekl["quelle"],
            "projekt_id_deklariert_hinweis": dekl["hinweis"],
            "projekt_id_deklariert_benutzt": False,
            "projekt_id_dateien": gefundene_ids,
            "display_bin_bekannt": bool(rev),
            "revisionstabelle": [f"{r['board']}: {r['project_id']:#04x}, Panel {r['panel']}, {r['size']} B, "
                                 f"sha256 {r['sha256'][:16]}…" for r in H713_MIPS_FW_REVS],
            "nicht_extrahiert_gleiche_partition": haupt["sonst"] + haupt["uebrig"],
        }
        self.beobachtungen["bootloader_partition_rest"] = haupt["sonst"] + haupt["uebrig"]
        if haupt["sonst"] or haupt["uebrig"]:
            self.log.info("in derselben Partition, von unserer Kette ungenutzt (wird nicht kopiert, Plan 108 §1): "
                          + ", ".join(haupt["sonst"] + haupt["uebrig"]))

        # ---- Ablegen ------------------------------------------------------------------------------
        for n in sorted(dateien, key=lambda x: (bool(MIPS_PROJECTID.match(x)), x)):
            d = dateien[n]
            pruef: list[str] = [f"aus {haupt['herkunft']}, {MIPS_QUELLVERZ}/{n} "
                                f"(8.3-Kurzname '{haupt['kurznamen'].get(n, '?')}')"]
            fehler = False
            if n == "display.bin":
                pruef += display_pruef
                fehler = display_fehler
            elif n == "display_cfg.xml":
                p = pruefe_display_cfg(d)
                pruef += p
                fehler = any("nicht parsebar" in x for x in p)
                if fehler:
                    self.log.warn(p[0])
            elif n.endswith(".TSE"):
                p, _id = pruefe_tse(n, d)
                pruef += p
                fehler = any("Magic fehlt" in x or "passt nicht zusammen" in x for x in p)
                for x in p:
                    if "Magic fehlt" in x or "passt nicht zusammen" in x:
                        self.log.warn(x)
            for x in haupt["probleme"]:
                if x.startswith(n + ":"):
                    pruef.append(x)
            self.ablegen(f"{MIPS_AUSGABE}/{n}", d,
                         herkunft=f"{haupt['herkunft']}: {MIPS_QUELLVERZ}/{n} ({len(d)} B, FAT-Langname)",
                         pruefung=pruef, fehler=fehler)
        for n in MIPS_DATEIEN:
            if n not in dateien:
                self.log.warn(f"{MIPS_QUELLVERZ}/{n} fehlt in der Quelle")
                self.offen.append(f"{MIPS_AUSGABE}/{n} (fehlt in {haupt['herkunft']})")
        if not gefundene_ids:
            self.log.warn("keine einzige ProjectID_0x*.TSE in mips/ gefunden")
            self.offen.append(f"{MIPS_AUSGABE}/ProjectID_0x*.TSE (keine gefunden)")

    def beobachte(self):
        """Nur feststellen, nichts kopieren: aic8800-Firmware, HDCP-Hinweise."""
        self.log.kopf("Beobachtungen (nichts davon wird extrahiert)")
        if not self.oeffne_vendor():
            self.log.info("keine vendor-Partition — keine Beobachtungen möglich")
            return
        aic, hdcp, lizenz = [], [], []
        muster_aic = re.compile(r"(aic|8800|fmacfw|lmacfw|fw_patch|fw_adid)", re.I)
        muster_hdcp = re.compile(r"hdcp", re.I)
        for pf, e in self.vendor.gehe("/", 6):
            if muster_aic.search(e["name"]):
                aic.append(f"{pf} ({e['size']} B)")
            if muster_hdcp.search(e["name"]):
                hdcp.append(f"{pf} ({e['size']} B)")
            if re.search(r"(licen[cs]e|notice|copyright)", e["name"], re.I):
                lizenz.append(f"{pf} ({e['size']} B)")
        # Modul-Lizenzstrings der aic8800-Treiber (modinfo-Sektion) — reine Beobachtung
        module = []
        for pf, e in self.vendor.gehe("/lib/modules", 3):
            if e["name"].startswith("aic") and e["name"].endswith(".ko"):
                d = self.vendor.lies(pf, self.tmp)
                infos = sorted(set(m.decode("latin1") for m in re.findall(rb"(?:license|vermagic|version|author)=[^\0]{1,80}", d)))
                module.append({"pfad": pf, "groesse": e["size"], "modinfo": infos})
        # Lizenz-/Herkunftsstrings in der aic8800-Firmware selbst
        fw_strings = {}
        for zeile in aic:
            pf = zeile.split(" (")[0]
            if "/etc/firmware/" in pf and re.search(r"(fmacfw|lmacfw|fw_patch|fw_adid)", pf):
                d = self.vendor.lies(pf, self.tmp)
                treffer = sorted(set(m.decode("latin1") for m in re.findall(rb"[ -~]{6,}", d)
                                     if re.search(rb"(?i)(licen[cs]e|copyright|\(c\)|aicsemi|rivierawaves)", m)))[:8]
                if treffer:
                    fw_strings[pf] = treffer
        # NOTICE.xml.gz des Vendor-Abbilds: steht die AIC-Firmware dort mit einer Lizenz?
        notice = None
        if self.vendor.existiert("/etc/NOTICE.xml.gz"):
            import gzip
            try:
                x = gzip.decompress(self.vendor.lies("/etc/NOTICE.xml.gz", self.tmp)).decode("utf-8", "replace")
                dateien = re.findall(r"<file-name[^>]*>([^<]*)</file-name>", x)
                aic_eintraege = [d for d in dateien if re.search(r"(?i)(aic|8800|fmacfw|lmacfw)", d)]
                notice = {"eintraege": len(dateien), "aic_eintraege": aic_eintraege}
            except Exception as e:  # noqa: BLE001
                notice = {"fehler": str(e)}
        self.beobachtungen["notice_xml"] = notice
        self.beobachtungen["aic8800_dateien"] = sorted(aic)
        self.beobachtungen["aic8800_module"] = module
        self.beobachtungen["aic8800_firmware_strings"] = fw_strings
        self.beobachtungen["hdcp_hinweise"] = sorted(hdcp)
        self.beobachtungen["lizenzdateien"] = sorted(lizenz)
        if notice is not None:
            self.log.info(f"/etc/NOTICE.xml.gz: {notice.get('eintraege')} Dateieinträge, davon zu aic8800: "
                          f"{len(notice.get('aic_eintraege', []))} — {'keine Lizenzangabe zur AIC-Firmware' if not notice.get('aic_eintraege') else notice['aic_eintraege']}")
        self.log.info(f"aic8800-bezogene Dateien: {len(aic)}")
        for z in sorted(aic):
            self.log.info("  " + z)
        for m in module:
            self.log.info(f"  Modul {m['pfad']}: " + "; ".join(m["modinfo"]))
        for pf, tr in fw_strings.items():
            self.log.info(f"  Strings in {pf}: " + " | ".join(tr))
        self.log.info(f"HDCP-Hinweise (Dateinamen, nicht angefasst): {len(hdcp)}")
        for z in sorted(hdcp):
            self.log.info("  " + z)
        self.log.info(f"Lizenz-/Notice-Dateien: {len(lizenz)}")
        for z in sorted(lizenz)[:20]:
            self.log.info("  " + z)
        if isinstance(self.vendor, Ext4):
            self.log.info("ext4-Leser: " + self.vendor.statistik())
            for pr in self.vendor.probleme:
                self.log.warn("ext4: " + pr)

    # ---- Gerät erkennen, Ausgabeverzeichnis schützen -------------------------------------------

    def lies_altes_manifest(self):
        """Liegt in <out> schon ein MANIFEST.json, merken, für welches Gerät — zwei Geräte werden nicht vermischt."""
        mp = self.out / "MANIFEST.json"
        if not mp.is_file():
            return
        try:
            alt = json.loads(mp.read_text(encoding="utf-8"))
        except Exception as e:  # noqa: BLE001
            self.log.warn(f"{mp}: vorhandenes Manifest unlesbar ({e}) — wird überschrieben")
            return
        g = alt.get("device") or (alt.get("image_typ") or "").lower() or None   # image_typ: Manifeste von Version 0.1
        self.altes_geraet = g if g in GERAETE else None
        self.log.info(f"{mp}: vorhandenes Manifest ({alt.get('werkzeug', '?')}, {alt.get('zeit', '?')}) für Gerät "
                      f"{self.altes_geraet or 'unbekannt/keins'}")

    def pruefe_ausgabeverzeichnis(self):
        if self.altes_geraet and self.geraet and self.altes_geraet != self.geraet:
            self.out_gesperrt = True
            raise Abbruch(f"Ausgabeverzeichnis {self.out} enthält schon Ergebnisse für Gerät '{self.altes_geraet}', dieser Eingang "
                          f"ist '{self.geraet}' — Ergebnisse zweier Geräte werden nicht vermischt. Anderes --out wählen "
                          f"(nichts wurde überschrieben).")

    def setze_geraet(self, gid: str | None, ueber: str, fix: bool = False, merkmale: list[str] | None = None):
        if gid == self.geraet and not fix:
            return
        self.geraet = gid
        self.geraet_fix = fix
        self.erkennung = {"ueber": ueber if gid else None, "merkmale": merkmale or [], "hinweise": self.erkennung.get("hinweise", [])}
        if gid:
            self.log.info(f"GERÄT: {gid} — {GERAETE[gid]['beschreibung']} (erkannt über {ueber}"
                          + (": " + ", ".join(merkmale) if merkmale else "") + ")")
        self.pruefe_ausgabeverzeichnis()

    def erkenne_geraet(self, anlass: str):
        """Gerät aus den bisher gesammelten Merkmalen bestimmen — nur, wenn der Image-Fingerabdruck nichts ergab.
        Ein Profil passt, wenn mindestens ein starkes Kennungsmerkmal zutrifft und keines widerspricht; passen mehrere oder
        widersprechen sich die Teile (z. B. Paket von L018, super von HY310), bleibt das Gerät unbekannt."""
        if self.geraet_fix:
            return
        stimmen = {}
        for gid, prof in GERAETE.items():
            k = kennung(prof)
            treffer = [m for m in KENNUNGS_MERKMALE if m in self.merkmale and merkmal_passt(m, self.merkmale[m], k[m])]
            wider = [m for m in KENNUNGS_MERKMALE if m in self.merkmale and not merkmal_passt(m, self.merkmale[m], k[m])]
            stimmen[gid] = (treffer, wider)
        self.erkennung["stimmen"] = {g: {"treffer": t, "widerspruch": w} for g, (t, w) in stimmen.items()}
        passend = [g for g, (t, w) in stimmen.items() if any(m in STARKE_MERKMALE for m in t) and not w]
        if len(passend) == 1:
            if passend[0] == self.geraet:
                self.erkennung["merkmale"] = stimmen[passend[0]][0]   # spätere Bestätigungen mitschreiben
            else:
                self.setze_geraet(passend[0], "Inhalt", merkmale=stimmen[passend[0]][0])
            return
        gemischt = [g for g, (t, w) in stimmen.items() if t and w]
        if gemischt:
            gesehen = self.erkennung.setdefault("_gesehen", [])
            for g in gemischt:
                t, w = stimmen[g]
                schluessel = f"{g}:{','.join(w)}"
                if schluessel in gesehen:
                    continue
                gesehen.append(schluessel)
                hinweis = (f"Merkmale widersprüchlich für {g}: passt bei {', '.join(t)}, nicht bei "
                           f"{', '.join(f'{m}={self.merkmale[m]!r}' for m in w)}")
                self.erkennung["hinweise"].append(hinweis)
                self.log.warn(hinweis + f" (nach {anlass})")
            if self.geraet is not None:
                self.log.warn(f"Gerät {self.geraet} wieder zurückgenommen — Eingangsteile passen nicht zu einem Gerät")
                self.setze_geraet(None, anlass)
        elif len(passend) > 1:
            self.log.warn(f"Merkmale passen zu mehreren Profilen ({', '.join(passend)}) — Gerät bleibt unbekannt")

    def naechstes_profil(self) -> str:
        """Bei unbekanntem Image: das Profil mit den meisten Treffern (Gleichstand/keine: hy310) für die Abweichungsliste."""
        best, best_n = "hy310", -1
        for gid, prof in GERAETE.items():
            k = kennung(prof)
            n = sum(1 for m in KENNUNGS_MERKMALE if m in self.merkmale and merkmal_passt(m, self.merkmale[m], k[m]))
            if n > best_n:
                best, best_n = gid, n
        return best

    def abweichungen_gegen(self, gid: str) -> list[str]:
        """Beobachtete Merkmale gegen die Sollwerte eines Profils — leere Liste = Stock dieses Geräts."""
        e, nm, m, out = GERAETE[gid]["erwartung"], GERAETE[gid]["name"], self.merkmale, []
        if "paket_items" in m:
            for n, soll in e["paket_items"].items():
                if n not in m["paket_items"]:
                    out.append(f"Paket-Item {n} fehlt ({nm} hat es)")
                elif m["paket_items"][n] != soll:
                    out.append(f"Paket-Item {n}: {m['paket_items'][n]} B statt {soll} B ({nm})")
            for n, sh in e["paket_item_sha256"].items():
                ist = m["paket_item_sha256"].get(n)
                if ist and ist != sh:
                    out.append(f"Paket-Item {n}: Inhalt anders als {nm} (sha256 {ist[:16]}…)")
        if "uboot_version" in m and not merkmal_passt("uboot_version", m["uboot_version"], e["uboot_version"]):
            out.append(f"U-Boot-Kennung '{m['uboot_version']}' statt '{e['uboot_version']} …' ({nm})")
        if "dtb_compatible" in m and e["dtb_compatible"] not in m["dtb_compatible"]:
            out.append(f"dtb compatible '{m['dtb_compatible']}' ohne '{e['dtb_compatible']}' — andere SoC-Familie?")
        if "arisc_version" in m and not merkmal_passt("arisc_version", m["arisc_version"], e["arisc_version"]):
            out.append(f"ARISC-Versionsstring '{m['arisc_version']}' statt '{e['arisc_version']} …' ({nm})")
        if "vendor_size" in m and m["vendor_size"] != e["vendor_size"]:
            out.append(f"vendor-Partition {m['vendor_size']} B statt {e['vendor_size']} B ({nm})")
        if "libmspsound_sha256" in m and m["libmspsound_sha256"] != e["libmspsound_sha256"]:
            out.append(f"libmspsound.so anders als {nm} (sha256 {m['libmspsound_sha256'][:16]}…) — Patchstrom prüfen")
        if "build_fingerprint" in m and m["build_fingerprint"] != e["build_fingerprint"]:
            out.append(f"Vendor-Fingerprint '{m['build_fingerprint']}' statt '{e['build_fingerprint']}' ({nm})")
        if "mips_database_sha256" in m and m["mips_database_sha256"] != e["mips_database_sha256"]:
            out.append(f"mips/database.TSE anders als {nm} (sha256 {m['mips_database_sha256'][:16]}…) — "
                       f"andere Vendor-Displaydaten")
        if "sunxi_version" in m and m["sunxi_version"] != e["sunxi_version"]:
            out.append(f"sunxi_version {m['sunxi_version']} statt {e['sunxi_version']} ({nm})")
        return out

    def bewerte(self) -> int:
        """Gerät festlegen, Artefakte gegen die Referenz des Geräts abgleichen, Abweichungen listen, Exit-Code bestimmen."""
        self.log.kopf("Gerät und Referenzabgleich")
        if self.geraet:
            self.referenzgeraet = self.geraet
            if self.geraet_fix:   # über sha256 erkannt: welche Inhaltsmerkmale das bestätigen, fürs Manifest
                k = kennung(GERAETE[self.geraet])
                self.erkennung["merkmale"] = [m for m in KENNUNGS_MERKMALE
                                              if m in self.merkmale and merkmal_passt(m, self.merkmale[m], k[m])]
            self.log.info(f"Gerät: {self.geraet} — {GERAETE[self.geraet]['beschreibung']}; erkannt über {self.erkennung['ueber']}"
                          + (f" ({'bestätigt durch' if self.geraet_fix else 'Merkmale'}: " + ", ".join(self.erkennung["merkmale"]) + ")"
                             if self.erkennung["merkmale"] else ""))
        else:
            self.referenzgeraet = self.naechstes_profil()
            self.log.warn(f"UNBEKANNTES IMAGE — kein Geräteprofil passt (bekannt: {', '.join(GERAETE)}). Best-Effort: Abgleich "
                          f"gegen das ähnlichste Profil '{self.referenzgeraet}'; jede Abweichung unten ist ein Warnzeichen")
        prof = GERAETE[self.referenzgeraet]
        for a in self.artefakte:
            ref = prof["referenz"].get(a["pfad"])
            if ref is None:
                continue
            a["referenzgeraet"] = self.referenzgeraet
            a["referenz_stimmt"] = (a["groesse"] == ref[0] and a["sha256"] == ref[1])
            if a["referenz_stimmt"]:
                a["pruefung"].append(f"Referenz {self.referenzgeraet} stimmt ({ref[1][:16]}…)")
                self.log.info(f"{a['pfad']}: Referenz {self.referenzgeraet} stimmt")
            else:
                a["pruefung"].append(f"Referenz {self.referenzgeraet} weicht ab: erwartet {ref[0]} B {ref[1][:16]}…, "
                                     f"ist {a['groesse']} B {a['sha256'][:16]}…")
                (self.log.warn if self.geraet else self.log.info)(
                    f"{a['pfad']}: weicht von der Referenz {self.referenzgeraet} ab"
                    + ("!" if self.geraet else " (unbekanntes Image — erwartbar)"))
        self.abweichungen = self.abweichungen_gegen(self.referenzgeraet)
        if self.abweichungen:
            if self.geraet:
                self.log.warn(f"Eingang weicht vom {prof['name']}-Stock ab, obwohl das Gerät erkannt wurde — Profil oder Eingang prüfen")
            self.log.kopf(f"Abweichungen vom {prof['name']}-Stock" + (" — hier drohen Probleme" if not self.geraet else ""))
            for a in self.abweichungen:
                self.log.info("- " + a)
        if self.altes_geraet and not self.geraet:
            self.log.warn(f"{self.out} enthielt ein Manifest für Gerät '{self.altes_geraet}'; dieser Lauf ist unbekannt — "
                          f"Verzeichnisinhalt ist jetzt gemischt, besser trennen")
        fehler = [a for a in self.artefakte if a["fehler"]]
        ref_nein = [a for a in self.artefakte if a["referenz_stimmt"] is False]
        fehlt = [p for p in PFLICHT if not any(a["pfad"] == p for a in self.artefakte)]
        code = 0
        if self.geraet is None or fehler or ref_nein or fehlt or self.offen or self.abweichungen:
            code = 1
        if not self.artefakte:
            code = 2
        return code

    # ---- Ablage ---------------------------------------------------------------------------------

    def ablegen(self, rel: str, data: bytes, herkunft: str, pruefung: list[str], fehler: bool):
        ziel = self.out / rel
        ziel.parent.mkdir(parents=True, exist_ok=True)
        ziel.write_bytes(data)
        h = sha256_bytes(data)
        # Referenzabgleich erst in bewerte(): das Gerät kann bei Einzelteilen erst nach der vendor-Partition feststehen
        self.artefakte.append({"pfad": rel, "groesse": len(data), "sha256": h, "md5": hashlib.md5(data).hexdigest(),
                               "herkunft": herkunft, "pruefung": pruefung, "fehler": fehler, "referenz_stimmt": None,
                               "referenzgeraet": None})
        stand = "FEHLER" if fehler else "ok"
        self.log.info(f"-> {rel}: {len(data)} B, sha256 {h}, Prüfung {stand}")

    # ---- Hauptablauf ----------------------------------------------------------------------------

    def lauf(self) -> int:
        self.out.mkdir(parents=True, exist_ok=True)
        self.tmp.mkdir(parents=True, exist_ok=True)
        try:
            self.lies_altes_manifest()
            if self.args.input:
                q = self.oeffne(self.args.input)
                self.fingerabdruck(q, "Eingang")
                if Imagewty.ist_imagewty(q):
                    self.eingang_imagewty(q)
                elif Gpt.ist_gpt(q):
                    self.eingang_emmc(q)
                elif q.read(0, 13) == SunxiPackage.NAME:
                    self.eingang["typ"] = "sunxi-package"
                    self.paket_aus_quelle(q, q.pfad.name)
                elif SparseQuelle.ist_sparse(q) or q.read(4096, 4) == b"gDla":
                    self.eingang["typ"] = "super"
                    self.super_aus_quelle(q)
                elif q.size > 0x800 and struct.unpack_from("<H", q.read(0x438, 2), 0)[0] == 0xEF53:
                    self.eingang["typ"] = "ext4 (vendor)"
                    self.vendor_q = q
                elif Fat.ist_fat(q):
                    self.eingang["typ"] = "FAT (bootloader_a/_b bzw. boot-resource.fex)"
                    self.mips_quelle(q, f"{q.pfad.name} (FAT-Abbild)")
                else:
                    raise Abbruch(f"Eingang nicht erkannt: {q.pfad} ({hexdump_kurz(q.read(0, 16))}) — "
                                  f"weder IMAGEWTY, GPT-Dump, sunxi-package, Sparse/LP-super, ext4 noch FAT")
            else:
                self.eingang_teile()
            self.extrahiere_scp()
            self.extrahiere_edid()
            self.extrahiere_msp()
            if not self.args.no_pq:
                self.extrahiere_pq()
            if not self.args.no_mips:
                self.extrahiere_mips()
            if not self.args.no_wlan:
                self.extrahiere_wlan()
            self.beobachte()
        except Abbruch as e:
            self.log.fehler(str(e))
            if self.out_gesperrt:
                self.log.kopf("Ergebnis: Exit 2 — Ausgabeverzeichnis gehört einem anderen Gerät, nichts geschrieben")
                return 2
            self.schreibe_manifest(2)
            return 2
        finally:
            self.aufraeumen()
        code = self.bewerte()
        self.schreibe_manifest(code)
        return code

    def aufraeumen(self):
        for q in self.quellen_offen:
            try:
                q.fh.close()
            except Exception:  # noqa: BLE001
                pass
        if self.args.keep_tmp:
            self.log.info(f"Zwischenstände bleiben (--keep-tmp): {self.tmp}")
            return
        if self.tmp.exists():
            groesse = sum(p.stat().st_size for p in self.tmp.rglob("*") if p.is_file())
            shutil.rmtree(self.tmp, ignore_errors=True)
            self.log.info(f"Zwischenstände gelöscht ({groesse} B in {self.tmp})")

    def schreibe_manifest(self, code: int):
        if code == 0:
            ergebnis = f"bekanntes Gerät {self.geraet}, alles geprüft und referenzgleich"
        elif code == 1:
            ergebnis = ("unbekanntes Image (kein Geräteprofil passt) — Ausgabe liegt, aber prüfen" if self.geraet is None
                        else f"Gerät {self.geraet} erkannt, aber Teile fehlen, weichen ab oder sind fehlerhaft — Ausgabe liegt, aber prüfen")
        else:
            ergebnis = "Fehler"
        man = {
            "werkzeug": f"h713-extract {VERSION}",
            "zeit": time.strftime("%Y-%m-%d %H:%M:%S"),
            "exit_code": code,
            "ergebnis": ergebnis,
            "device": self.geraet,
            "device_name": GERAETE[self.geraet]["name"] if self.geraet else None,
            "device_beschreibung": GERAETE[self.geraet]["beschreibung"] if self.geraet else None,
            "device_erkennung": {k: v for k, v in self.erkennung.items() if not k.startswith("_")},
            "referenzgeraet": self.referenzgeraet,
            "merkmale": self.merkmale,
            "eingang": self.eingang,
            "mips": self.mips,
            "artefakte": self.artefakte,
            "nicht_extrahiert": self.offen,
            "abweichungen": self.abweichungen,
            "warnungen": self.log.warnungen,
            "beobachtungen": self.beobachtungen,
            "nicht_angefasst": ["HDCP-/DRM-Schlüssel (Secure Storage, private-Partition, hdcp*-Dateien)",
                                "WLAN/BT-Firmware aic8800 (nur benannt)", "APKs, Android system/boot"],
        }
        (self.out / "MANIFEST.json").write_text(json.dumps(man, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
        # Lesbarer Bericht
        z = [f"h713-extract {VERSION} — Bericht {man['zeit']}", "",
             f"Eingang: {self.eingang.get('pfad') or self.eingang.get('teile')} ({self.eingang.get('typ')})",
             f"sha256:  {self.eingang.get('sha256')}",
             f"Bekannt: {self.eingang.get('bekannt_als') or 'kein bekannter Image-Fingerabdruck'}",
             f"Gerät:   " + (f"{self.geraet} — {GERAETE[self.geraet]['beschreibung']} (erkannt über {self.erkennung['ueber']}"
                             + ((", bestätigt durch " if self.geraet_fix else ": ") + ", ".join(self.erkennung["merkmale"])
                                if self.erkennung["merkmale"] else "") + ")"
                             if self.geraet else
                             f"UNBEKANNT — kein Profil passt (bekannt: {', '.join(GERAETE)}); Best-Effort gegen '{self.referenzgeraet}'"),
             f"Ergebnis: Exit {code} — {ergebnis}", ""]
        if self.mips:
            m = self.mips
            z += ["Projekt-ID (Plan 108 §4.5):",
                  f"  benutzt:     {m['projekt_id_benutzt'] or 'UNBESTIMMT'}  ({m['projekt_id_benutzt_woher']})",
                  f"  deklariert:  {m['projekt_id_deklariert'] or '—'}"
                  + (f"  ({m['projekt_id_deklariert_quelle']})" if m["projekt_id_deklariert_quelle"]
                     else f"  ({m['projekt_id_deklariert_hinweis']})") + "  — gemeldet, NICHT benutzt",
                  f"  vorhanden:   {len(m['projekt_id_dateien'])} ProjectID-Dateien: {', '.join(m['projekt_id_dateien'])}",
                  f"  Quelle:      {m['quelle']} ({m['dateisystem']})"]
            for v in m["weitere_quellen"]:
                z.append(f"               {v}")
            if not m["display_bin_bekannt"]:
                z += ["  ACHTUNG: display.bin ist keine bekannte Revision — die benutzte ID ist nicht bestimmbar.",
                      "           Alle ProjectID-Dateien liegen in der Ausgabe; die richtige zur Laufzeit wählen",
                      "           (setenv h713_project 0x…; saveenv). Bekannte Revisionen:"]
                z += [f"             {r}" for r in m["revisionstabelle"]]
            if m["nicht_extrahiert_gleiche_partition"]:
                z += ["  Dieselbe Partition enthält (nicht kopiert, unsere Kette nutzt es nicht):",
                      "    " + ", ".join(m["nicht_extrahiert_gleiche_partition"])]
            z.append("")
        z.append("Artefakte:")
        for a in self.artefakte:
            z.append(f"  {a['pfad']}: {a['groesse']} B sha256 {a['sha256']}")
            z.append(f"      Herkunft: {a['herkunft']}")
            for p in a["pruefung"]:
                z.append(f"      Prüfung:  {p}")
            z.append(f"      Ergebnis: {'FEHLER' if a['fehler'] else 'ok'}, Referenz "
                     f"{'stimmt' if a['referenz_stimmt'] else 'weicht ab' if a['referenz_stimmt'] is False else 'keine'}"
                     + (f" ({a['referenzgeraet']})" if a.get("referenzgeraet") else ""))
        if self.abweichungen:
            z += ["", f"Abweichungen vom {GERAETE[self.referenzgeraet]['name']}-Stock"
                  + (" — unbekanntes Image, hier drohen Probleme:" if not self.geraet else " (trotz erkanntem Gerät — prüfen!):")
                  ] + [f"  - {a}" for a in self.abweichungen]
        if self.offen:
            z += ["", "Nicht extrahiert:"] + [f"  - {o}" for o in self.offen]
        if self.log.warnungen:
            z += ["", "Warnungen:"] + [f"  - {w}" for w in self.log.warnungen]
        z += ["", "Nicht angefasst: " + "; ".join(man["nicht_angefasst"]), "", "Protokoll:"] + self.log.zeilen
        (self.out / "BERICHT.txt").write_text("\n".join(z) + "\n", encoding="utf-8")
        self.log.kopf(f"Ergebnis: Exit {code} — {ergebnis}")
        self.log.info(f"Ausgabe: {self.out}  (MANIFEST.json, BERICHT.txt)")


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="h713-extract", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("input", nargs="?", help="update.img (IMAGEWTY), roher eMMC-Dump, boot_package.fex, super.fex oder vendor-ext4")
    def part(s):
        if "=" not in s:
            raise argparse.ArgumentTypeError(f"--part erwartet NAME=DATEI, nicht '{s}'")
        return tuple(s.split("=", 1))

    ap.add_argument("--part", action="append", metavar="NAME=DATEI", type=part,
                    help="Einzelteil: boot_package=…, bootloader_a=…, bootloader_b=…, boot-resource=…, super=…, "
                         "vendor=…, emmc=… (mehrfach)")
    ap.add_argument("--fex-dir", metavar="DIR", help="Verzeichnis mit entpackten .fex (boot_package.fex, super.fex, boot-resource.fex)")
    ap.add_argument("-o", "--out", default="h713-extract-out", help="Ausgabeverzeichnis (Vorgabe: ./h713-extract-out)")
    ap.add_argument("--tmp", help="Verzeichnis für Zwischenstände (Vorgabe: <out>/tmp; wird am Ende gelöscht)")
    ap.add_argument("--keep-tmp", action="store_true", help="Zwischenstände nicht löschen")
    ap.add_argument("--no-hash", action="store_true", help="sha256 des Eingangs überspringen (Gerät wird dann nur inhaltlich erkannt)")
    ap.add_argument("--use-debugfs", action="store_true",
                    help="ext4 über debugfs (e2fsprogs) statt über den eingebauten Leser — Gegenprobe, braucht e2fsprogs")
    ap.add_argument("--no-pq", action="store_true", help="PQ-Dateien nicht kopieren")
    ap.add_argument("--no-mips", action="store_true", help="MIPS-/Display-Artefakte (boot/mips/…) nicht extrahieren")
    ap.add_argument("--no-wlan", action="store_true", help="WLAN-Firmware (lib/firmware/aic8800_fw/…) nicht extrahieren")
    ap.add_argument("-q", "--quiet", action="store_true", help="nur Ergebniszeilen")
    ap.add_argument("--version", action="version", version=f"h713-extract {VERSION}")
    args = ap.parse_args(argv)
    if not args.input and not args.part and not args.fex_dir:
        ap.error("Eingang fehlt (Datei, --part … oder --fex-dir …)")
    if args.input and (args.part or args.fex_dir):
        ap.error("entweder eine Eingangsdatei oder --part/--fex-dir")
    log = Log(args.quiet)
    log.kopf(f"h713-extract {VERSION}")
    return Lauf(args, log).lauf()


if __name__ == "__main__":
    sys.exit(main())
