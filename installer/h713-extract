def pruefe_edid_block(b: bytes, wer: str) -> list[str]:
    p = []
    if len(b) != 256:
        p.append(f"{wer}: {len(b)} B statt 256")
        return p
    if b[:8] != b"\x00\xff\xff\xff\xff\xff\xff\x00":
        p.append(f"{wer}: EDID-Kopf fehlt ({hexdump_kurz(b, 8)})")
    for i in (0, 128):
        s = sum(b[i:i + 128]) & 0xFF
        if s:
            p.append(f"{wer}: Block {i // 128} Prüfsumme {s:#04x} statt 0")
    if b[126] != 1:
        p.append(f"{wer}: Erweiterungszähler {b[126]} statt 1")
    if b[128] != 0x02:
        p.append(f"{wer}: Block 1 ist kein CEA-861 (Tag {b[128]:#04x})")
    return p


def edid_hersteller(b: bytes) -> str:
    v = struct.unpack(">H", b[8:10])[0]
    return "".join(chr(64 + ((v >> s) & 0x1F)) for s in (10, 5, 0))


def edid_name(b: bytes) -> str:
    for i in range(54, 126, 18):
        d = b[i:i + 18]
        if d[:3] == b"\0\0\0" and d[3] == 0xFC:
            return d[5:18].decode("latin1", "replace").strip("\n ")
    return ""


